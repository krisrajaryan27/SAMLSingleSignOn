div.autocomplete {
	position:absolute;
	background-color:white;
	border:1px solid #888;
	margin:0px;
	padding:0px;
	z-index:1000;
}
div.autocomplete ul {
	list-style-type:none;
	margin:0px;
	padding:0px;
}
div.autocomplete ul li.selected { background-color: #ffa; border: 1px solid #bbb;}
div.autocomplete ul li {
	list-style-type:none;
	display:block;
	margin:0;
	padding:2px;
	cursor:pointer;
	border: 1px solid #fff;
}