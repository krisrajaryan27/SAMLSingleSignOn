package com.talentPool.common.utils.Exception;

/**
 * @author Sachinm
 *
 */
public class RSADecryptionException extends Exception {

	/**
	 * 
	 */
	private static final long serialVersionUID = 1L;
	
	/**
	 * Creates a new instance of <code>RSADecryptionException</code> without detail message.
	 */
	public RSADecryptionException() {
	}

	/**
	 * Constructs an instance of <code>RSADecryptionException</code> with the specified detail message.
	 * 
	 * @param msg
	 *            the detail message.
	 */
	public RSADecryptionException(String msg) {
		super(msg);
	}

}
