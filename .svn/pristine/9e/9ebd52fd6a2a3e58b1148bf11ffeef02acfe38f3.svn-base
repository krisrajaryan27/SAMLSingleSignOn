		<dataquery name="dReportManager_GetPositionActivityData" dbquery="qReportManager_GetPositionActivityData" object="com.talentPool.reports.views.PositionActivityReportView">
			<attribute name= "candidate" column="applicant_name" type ="STRING"/>
