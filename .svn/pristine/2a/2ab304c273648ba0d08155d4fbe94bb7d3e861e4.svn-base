											</div>
										</td>
									</tr>
								</table>
							</div>
						</td>
					</tr>
					<%
							}
										}
									}
						%>
				</table>
				<br />
			</logic:equal>

			<logic:notEqual name="positionForm" property="dir"
				value="<%=PositionConstants.DIR_VIEW_POSITION%>">
				<html:hidden property="requisitionerId" name="positionForm" />
				<html:hidden property="positionOwnerId" name="positionForm" />
