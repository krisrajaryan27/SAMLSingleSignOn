			if (isMandatory && positionLevel.trim() == '') {
				errors = addError(errors, '- <bean:message key="common.position" /> <bean:message key="common.level" />');
			}			
		<%		
			}
			if(fieldId.equals(PositionConfigurationConstants.FIELD_CONTACT_PERSON_NAME)){
