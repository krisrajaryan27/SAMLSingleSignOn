												cols="60" rows="5" styleClass="Grey" /></td>
									</tr>
									<%} }
										else{							
										if(customFields!=null && customFields.size()>0){
											for(int i=0; i<customFields.size();i++){
												CustomFieldData data = (CustomFieldData)customFields.get(i);			
												if(fieldId.equals(data.getFieldName())){
									%>
