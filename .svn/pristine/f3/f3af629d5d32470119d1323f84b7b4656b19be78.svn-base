var RatingField = Class.create();
RatingField.prototype ={
	initialize: function(fieldId, fieldDescription){
		this.fieldId=fieldId;
		this.fieldDescription=fieldDescription;
	},
	
	setFieldId: function(fieldId){
		this.fieldId=fieldId;
	},
	
	getFieldId: function(){
		return this.fieldId;
	},
	
	setFieldDescription: function(fieldDescription){
		this.fieldDescription=fieldDescription;
	},
	getFieldDescription: function(){
		return this.fieldDescription;
	}	
}