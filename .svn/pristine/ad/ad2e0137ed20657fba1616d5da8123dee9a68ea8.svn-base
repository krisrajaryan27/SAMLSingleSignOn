	private static void setAvilableReports() {
		// read license information and set the reports
		if (LicenseObj.getLicenseObject().getLicenseVersion().equals(LicenseConstants.LIC_BASIC)) {
			availableReports = basicReports;
		} else if (LicenseObj.getLicenseObject().getLicenseVersion().equals(LicenseConstants.LIC_BASIC)) {
			availableReports = proReports;
		} else {
			availableReports = allReports;
		}
	}

	private static void addReportExceptions() {
		// get reports-exception bitset and add the exception no to availablereports
		BitSet reportExceptions = LicenseObj.getLicenseObject().getReportExceptions();
		for (int i = 0; i < reportExceptions.length(); i++) {
			if (reportExceptions.get(i)) {
				if (!availableReports.contains("" + i)) {
					availableReports.add("" + i);
				}
			}
		}
	}

	public static String getReportTitle(String reportId) {
		return mapReportIdName.get(reportId);
	}

	public static boolean isReportAvailable(BitSet reportBitSet, String reportId) {
		return reportBitSet.get(Integer.parseInt(reportId));
	}
	
	public static boolean isCustomReportAvailable(){
		if(CUSTOM_REPORTS_CLIENT_NAME.equals(CLIENT_NAME_CAPITA)){
			return true;
		}else{
			return false;
		}
	}
	
	public static boolean isReportInCategoryAvailable(BitSet reportBitSet, String reportCategoryId) {
		for(int i=0; i<reportDetails.size(); i++){
			if(reportDetails.get(i).getReportCategory().equals(reportCategoryId)){
				if(reportBitSet.get(Integer.parseInt(reportDetails.get(i).getReportId()))){
					return true;
				}
			}
		}
		return false;
	}
}
