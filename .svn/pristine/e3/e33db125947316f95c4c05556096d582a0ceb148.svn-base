public class HiringFunnelSummaryView extends SimpleDataObject {
	/**
	 * @return the advanced
	 */
	public int getAdvanced() {
		return getInt("advanced");
	}
	/**
	 * @param advanced the advanced to set
	 */
	public void setAdvanced(String advanced) {
		setAttribute("advanced", advanced);
	}
	/**
	 * @return the deptId
	 */
	public String getDeptId() {
		return getString("deptId");
	}
	/**
	 * @param deptId the deptId to set
	 */
	public void setDeptId(String deptId) {
		setAttribute("deptId", deptId);
	}
	/**
	 * @return the deptName
	 */
	public String getDeptName() {
		return getString("deptName");
	}
	/**
	 * @param deptName the deptName to set
	 */
	public void setDeptName(String deptName) {
		setAttribute("deptName", deptName);
	}
	/**
	 * @return the inProcess
	 */
	public int getInProcess() {
		return getInt("inProcess");
	}
	/**
	 * @param inProcess the inProcess to set
	 */
	public void setInProcess(String inProcess) {
		setAttribute("inProcess", inProcess);
	}
	/**
	 * @return the joined
	 */
	public int getJoined() {
		return getInt("joined");
	}
	/**
	 * @param joined the joined to set
	 */
	public void setJoined(String joined) {
		setAttribute("joined", joined);
	}
	/**
	 * @return the positionId
	 */
	public String getPositionId() {
		return getString("positionId");
	}
	/**
	 * @param positionId the positionId to set
	 */
	public void setPositionId(String positionId) {
		setAttribute("positionId", positionId);
	}
	/**
	 * @return the positionTitle
	 */
	public String getPositionTitle() {
		return getString("positionTitle");
	}
	/**
	 * @param positionTitle the positionTitle to set
	 */
	public void setPositionTitle(String positionTitle) {
		setAttribute("positionTitle", positionTitle);
	}
	/**
	 * @return the processed
	 */
	public int getProcessed() {
		return getInt("processed");
	}
	/**
	 * @param processed the processed to set
	 */
	public void setProcessed(String processed) {
		setAttribute("processed", processed);
	}
	/**
	 * @return the rejected
	 */
	public int getRejected() {
		return getInt("rejected");
	}
	/**
	 * @param rejected the rejected to set
	 */
	public void setRejected(String rejected) {
