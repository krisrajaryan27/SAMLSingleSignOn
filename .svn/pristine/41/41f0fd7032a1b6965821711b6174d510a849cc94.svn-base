package com.talentPool.rest.model;

import javax.xml.bind.annotation.XmlRootElement;

/**
 * @author Shantanu
 *
 */
@XmlRootElement
public class SalaryComponentDetailModel{
	
	public SalaryComponentDetailModel(){
		
	}
	
	public SalaryComponentDetailModel(String jas){
		salaryComponentId=jas;
		salaryComponentName=jas;
		salaryComponentType=jas;		
		salaryComponentValue=jas;
	}
	
	public SalaryComponentDetailModel(String salaryComponentId, String salaryComponentName, String salaryComponentType){
		this.salaryComponentId=salaryComponentId;
		this.salaryComponentName=salaryComponentName;
		this.salaryComponentType=salaryComponentType;
	}
	
	public String salaryComponentId;
	public String salaryComponentName;
	public String salaryComponentType;	
	public String salaryComponentValue;
	public String salaryComponentValueDataType;
	
}
