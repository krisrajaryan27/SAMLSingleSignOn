package com.talentPool.offerSheet.dataobject;

import com.talentPool.common.db.SimpleDataObject;

/**
 * @author PraveenK
 * @since  May 16, 2012
 */
public class ApplicantOfferSheetDetails extends SimpleDataObject {
	/**
	 * @return the offerCode
	 */
	public String getOfferCode() {
		return getString("offerCode");
	}
	/**
	 * @param templateId the templateId to set
	 */
	public void setOfferCode(String offerCode) {
		setAttribute("offerCode", offerCode);
	}
	/**
	 * @return the offerLetterDocId
	 */
	public String getOfferLetterDocId() {
		return getString("offerLetterDocId");
	}
	/**
	 * @param offerLetterDocId the offerLetterDocId to set
	 */
	public void setOfferLetterDocId(String offerLetterDocId) {
		setAttribute("offerLetterDocId", offerLetterDocId);
	}
	/**
	 * @return the offerLetterDocId
	 */
	public String getOfferSheetTemplateId() {
		return getString("offerSheetTemplateId");
	}
	/**
	 * @param offerLetterDocId the offerLetterDocId to set
	 */
	public void setOfferSheetTemplateId(String offerSheetTemplateId) {
		setAttribute("offerSheetTemplateId", offerSheetTemplateId);
	}
}
