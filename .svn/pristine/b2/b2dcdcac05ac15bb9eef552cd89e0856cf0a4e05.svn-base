package com.talentPool.common.utils.Exception;

/**
 * @author Sachinm
 *
 */
public class CaptchaException extends Exception {
	
	/**
	 * 
	 */
	private static final long serialVersionUID = 1L;
	
	/**
	 * Creates a new instance of <code>CaptchaException</code> without detail message.
	 */
	public CaptchaException() {
	}

	/**
	 * Constructs an instance of <code>CaptchaException</code> with the specified detail message.
	 * 
	 * @param msg
	 *            the detail message.
	 */
	public CaptchaException(String msg) {
		super(msg);
	}
}
