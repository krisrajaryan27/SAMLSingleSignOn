package com.talentPool.employeeservice.dataobject;

import java.util.ArrayList;


/**
 * @author Shantanu
 *
 */
public class EapplicantList {
	private ArrayList<EapplicantData> applicants;
	private Epagination pagination;
	/**
	 * @return the applicants
	 */
	public ArrayList<EapplicantData> getApplicants() {
		return applicants;
	}
	/**
	 * @param applicants 
	 *			the applicants to set
	 */
	public void setApplicants(ArrayList<EapplicantData> applicants) {
		this.applicants = applicants;
	}
	/**
	 * @return the pagination
	 */
	public Epagination getPagination() {
		return pagination;
	}
	/**
	 * @param pagination 
	 *			the pagination to set
	 */
	public void setPagination(Epagination pagination) {
		this.pagination = pagination;
	}
}
