package com.talentPool.websiteservice.dataobject;

import java.io.Serializable;
import java.util.List;

/**
 * @author SumeetS
 *
 */
public class DynamicFieldDTO extends WimportFieldData implements Serializable{
	/**
	 * 
	 */
	private static final long serialVersionUID = 1L;

	private Integer id;
	
	private FieldTypeEnum type;
	
    private String displayName;

    private String regex;

    private String regexMessage;

    private List<String> optionList;

    private String defaultValue;

    private String watermarkText;

    private String apiURL;

    private String cssClassName;

    private CustomFieldEntityTypeEnum entityType;

    private String referenceFieldId;

    private List<List<DynamicFieldDTO>> dynamicFieldDTO;

    private String selectedValue;

    private List<SelectedObjectDTO> selectedObject;

    private String propertyName;

    private Integer parentId;
    
    private String entityName;

    private int rank;

    private Byte noOfRows;

    private boolean isRequired;

    // hardcoded admin
    private String userId = "1";
    
	public String getUserId() {
		return userId;
	}

	public void setUserId(String userId) {
		this.userId = userId;
	}

	public FieldTypeEnum getType() {
		return type;
	}

	public void setType(FieldTypeEnum type) {
		this.type = type;
	}

	public Integer getId() {
		return id;
	}

	public void setId(Integer id) {
		this.id = id;
	}

	public String getDisplayName() {
		return displayName;
	}

	public void setDisplayName(String displayName) {
		this.displayName = displayName;
	}

	public String getRegex() {
		return regex;
	}

	public void setRegex(String regex) {
		this.regex = regex;
	}

	public String getRegexMessage() {
		return regexMessage;
	}

	public void setRegexMessage(String regexMessage) {
		this.regexMessage = regexMessage;
	}

	public List<String> getOptionList() {
		return optionList;
	}

	public void setOptionList(List<String> optionList) {
		this.optionList = optionList;
	}

	public String getDefaultValue() {
		return defaultValue;
	}

	public void setDefaultValue(String defaultValue) {
		this.defaultValue = defaultValue;
	}

	public String getWatermarkText() {
		return watermarkText;
	}

	public void setWatermarkText(String watermarkText) {
		this.watermarkText = watermarkText;
	}

	public String getApiURL() {
		return apiURL;
	}

	public void setApiURL(String apiURL) {
		this.apiURL = apiURL;
	}

	public String getCssClassName() {
		return cssClassName;
	}

	public void setCssClassName(String cssClassName) {
		this.cssClassName = cssClassName;
	}

	public CustomFieldEntityTypeEnum getEntityType() {
		return entityType;
	}

	public void setEntityType(CustomFieldEntityTypeEnum entityType) {
		this.entityType = entityType;
	}

	public String getReferenceFieldId() {
		return referenceFieldId;
	}

	public void setReferenceFieldId(String referenceFieldId) {
		this.referenceFieldId = referenceFieldId;
	}

	public List<List<DynamicFieldDTO>> getDynamicFieldDTO() {
		return dynamicFieldDTO;
	}

	public void setDynamicFieldDTO(
			List<List<DynamicFieldDTO>> dynamicFieldDTO) {
		this.dynamicFieldDTO = dynamicFieldDTO;
	}

	public String getSelectedValue() {
		return selectedValue;
	}

	public void setSelectedValue(String selectedValue) {
		this.selectedValue = selectedValue;
	}

	public List<SelectedObjectDTO> getSelectedObject() {
		return selectedObject;
	}

	public void setSelectedObject(List<SelectedObjectDTO> selectedObject) {
		this.selectedObject = selectedObject;
	}

	public String getPropertyName() {
		return propertyName;
	}

	public void setPropertyName(String propertyName) {
		this.propertyName = propertyName;
	}

	public Integer getParentId() {
		return parentId;
	}

	public void setParentId(Integer parentId) {
		this.parentId = parentId;
	}

	public String getEntityName() {
		return entityName;
	}

	public void setEntityName(String entityName) {
		this.entityName = entityName;
	}

	public int getRank() {
		return rank;
	}

	public void setRank(int rank) {
		this.rank = rank;
	}

	public Byte getNoOfRows() {
		return noOfRows;
	}

	public void setNoOfRows(Byte noOfRows) {
		this.noOfRows = noOfRows;
	}

	public boolean isRequired() {
		return isRequired;
	}

	public void setRequired(boolean isRequired) {
		this.isRequired = isRequired;
	}
    
    
}
