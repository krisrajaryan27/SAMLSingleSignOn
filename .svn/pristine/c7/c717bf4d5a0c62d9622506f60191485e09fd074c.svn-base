package com.talentPool.reports.views;

import com.talentPool.common.db.SimpleDataObject;

public class OfferToJoinedDetailedView extends SimpleDataObject{

	public void setOfferedMonth(String offeredMonth){
		setAttribute("offeredMonth", offeredMonth);
	}
	
	public String getOfferedMonth() {
		return getString("offeredMonth");
	}
	
	public void setApplicantName(String applicantName){
		setAttribute("applicantName", applicantName);
	}
	
	public String getApplicantName() {
		return getString("applicantName");
	}
	
	public void setRecruiter(String recruiter){
		setAttribute("recruiter", recruiter);
	}
	
	public String getRecruiter() {
		return getString("recruiter");
	}
	
	public void setStatus(String status){
		setAttribute("status", status);
	}
	
	public String getStatus() {
		return getString("status");
	}
	
	public void setLevelOffered(String levelOffered){
		setAttribute("levelOffered", levelOffered);
	}
	
	public String getLevelOffered() {
		return getString("levelOffered");
	}
	
	public void setCollege(String college){
		setAttribute("college", college);
	}
	
	public String getCollege() {
		return getString("college");
	}
	
	public void setLocation(String location){
		setAttribute("location", location);
	}
	
	public String getLocation() {
		return getString("location");
	}
	
	public void setEmployer(String employer){
		setAttribute("employer", employer);
	}
	
	public String getEmployer() {
		return getString("employer");
	}
	
	public void setSource(String source){
		setAttribute("source", source);
	}
	
	public String getSource() {
		return getString("source");
	}
	
	public void setOfferType(String offerType){
		setAttribute("source", offerType);
	}
	
	public String getOfferType() {
		return getString("offerType");
	}
	
}
