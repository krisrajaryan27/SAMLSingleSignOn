package com.talentPool.export.bo;

import java.util.ArrayList;

import com.talentPool.common.properties.TPLabels;
/**
 * @author pallavi
 *
 */
public class BranchFields extends Fields {
	public BranchFields() {
		setHeaders(new ArrayList<Field>());
		
		int counter = 0;
		getHeaders().add(new Field(("fld" + counter++), TPLabels.getLabel("exportToExcel.branch.label.name")));
		getHeaders().add(new Field(("fld" + counter++), TPLabels.getLabel("exportToExcel.branch.label.alias1")));
		getHeaders().add(new Field(("fld" + counter++), TPLabels.getLabel("exportToExcel.branch.label.alias2")));
		getHeaders().add(new Field(("fld" + counter++), TPLabels.getLabel("exportToExcel.branch.label.alias3")));
		
	}
}
