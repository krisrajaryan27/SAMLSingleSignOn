/**
 * @author pallavi
 *
 */
public class ExportAction extends TPDispatchAction {
	public ActionForward export(ActionMapping mapping, ActionForm actionForm, HttpServletRequest request, HttpServletResponse response) {
		String forward = "getDocument";
		if (!SessionManager.validateSession(mapping, actionForm, request, response, this)) {
			return null;
		}
		try {
			ExportForm exportForm = (ExportForm) actionForm;
			PermissionSet permissionSet = (PermissionSet) request.getSession(false).getAttribute("permissionSet");
			String positionId = exportForm.getPositionId();
			String rejectedBy = exportForm.getRejectedBy();
			String applicantName = exportForm.getApplicantName();
			String stepName = exportForm.getStepName();
			String fieldIds=exportForm.getSelectedFields();
			String id=exportForm.getIds();
			ExportUtils exportUtils = new ExportUtils();
			String fileName="";
			ExcelGenerator excelGenerator = new ExcelGenerator();
			ExportManagerFactory exportManagerFactory = new ExportManagerFactory();
			ExportManager exportManager = exportManagerFactory.getManager(exportForm.getEntityType());
			List<SimpleDataObject> exportData;
			/*
			 * position Id is checked for Rejected Candidates as same candidate can be rejected more than once
			 * and hence two records will be fetched while exporting such candidates if we don't use positionId.
			 */
			if(!Utils.isBlankOrNull(positionId)) {
				exportData = exportManager.getData(exportForm.getIds(), permissionSet, positionId, rejectedBy, applicantName, stepName);
			} else {
				exportData = exportManager.getData(exportForm.getIds(), permissionSet);
			}
			
			FieldsFactory fieldsFactory = new FieldsFactory();
			Fields fields = fieldsFactory.getFields(exportForm.getEntityType());
			String[] fieldss = fieldIds.split(",");
			
			ArrayList<String> fieldList = Utils.convertStringArrayIntoArrayList(fieldss);
			
			String entityType = exportForm.getEntityType();
			if(ExportConstants.ENTITY_SELECT_STAGE_APPLICANTS.equals(entityType) || ExportConstants.ENTITY_HIRE_STAGE_APPLICANTS.equals(entityType) ||
					ExportConstants.ENTITY_SELECT_STAGE_APPLICANTS.equals(entityType)) {
				LinkedHashMap<String, String> fieldsMap = ExportUtils.getAllFieldsMap(entityType);
				 fileName = exportUtils.exportToExcelApplicant(fieldList,fieldsMap,fields, exportForm.getSelectedFields(), exportData, request.getSession(false).getId());
			}
			
			else{
			
			 fileName = exportUtils.exportToExcel(fields, exportForm.getSelectedFields(), exportData, request.getSession(false).getId());
			}
			
			FileHandler fileHandler = new FileHandler();
			String contentType = fileHandler.getContentType(fileName);				
			request.setAttribute("filePath", fileName);
			request.setAttribute("contentType", contentType);
			request.setAttribute("fileName", fileName);
			request.setAttribute("contentDisposition", DocumentConstants.CONTENT_DISPOSITION_ATTACHMENT);
		} catch (Exception e) {
			TPLogger.getLogger().error(GlobalConstants.ERROR, e);
		}
		return mapping.findForward(forward);
	}
	
	public ActionForward getExportFields(ActionMapping mapping, ActionForm actionForm, HttpServletRequest request, HttpServletResponse response) {
		String forward = "xmlFile";
		String xmlFile = "";
		try {
			if (!SessionManager.isLoginFound(mapping, actionForm, request, response, this)) {
				xmlFile = Utils.getXMLForSessionExpiry();
			} else {
				ExportForm exportForm = (ExportForm) actionForm;
				FieldsFactory fieldsFactory = new FieldsFactory();
			
				
				
				String entityType = exportForm.getEntityType();
				/*
				 * If block added to remove Sr. No. from applicant type( which uses ApplicantExportManager) export to excel select fields.
				 */
				if(ExportConstants.ENTITY_SELECT_STAGE_APPLICANTS.equals(entityType) || ExportConstants.ENTITY_HIRE_STAGE_APPLICANTS.equals(entityType) ||
						ExportConstants.ENTITY_SELECT_STAGE_APPLICANTS.equals(entityType)) {
				
					LinkedHashMap<String, String> fieldsMap = ExportUtils.getAllFieldsMap(entityType);
					xmlFile = ExportUtils.getXMLforFieldsToExport(fieldsMap);
					
				}
				else{
					Fields fields = fieldsFactory.getFields(exportForm.getEntityType());
				ExportUtils exportUtils = new ExportUtils();
				xmlFile = exportUtils.getFieldsInXml(fields);
				}
			}
		} catch (Exception e) {
			TPLogger.getLogger().error(GlobalConstants.ERROR, e);
			xmlFile = Utils.getXMLForError(null);
		}
		request.setAttribute("xmlFile", xmlFile);
		return mapping.findForward(forward);
	}
	
	public ActionForward exportSelectApplicants(ActionMapping mapping, ActionForm actionForm, HttpServletRequest request, HttpServletResponse response) {
		String forward = "selectFields";
		ExportForm exportForm = (ExportForm) actionForm;
		exportForm.setEntityType(ExportConstants.ENTITY_SELECT_STAGE_APPLICANTS);
		return mapping.findForward(forward);
	}
	
	/**
	 * @param mapping
	 * @param actionForm
	 * @param request
	 * @param response
	 * @return position fields to select for export
	 */
	public ActionForward exportPositions(ActionMapping mapping, ActionForm actionForm, HttpServletRequest request, HttpServletResponse response) {
		String forward = "selectFields";
		ExportForm exportForm = (ExportForm) actionForm;
		exportForm.setEntityType(ExportConstants.ENTITY_POSITION_DETAILS);
		return mapping.findForward(forward);
	}
	
	public ActionForward exportHireApplicants(ActionMapping mapping, ActionForm actionForm, HttpServletRequest request, HttpServletResponse response) {
		String forward = "selectFields";
		ExportForm exportForm = (ExportForm) actionForm;
