		return mapping.findForward(forward);
	}
	
	public ActionForward exportPositionSummaryApplicants(ActionMapping mapping, ActionForm actionForm, HttpServletRequest request, HttpServletResponse response) {
		String forward = "selectFields";
		ExportForm exportForm = (ExportForm) actionForm;
		exportForm.setEntityType(ExportConstants.ENTITY_POSITION_SUMMARY_APPLICANTS);
		return mapping.findForward(forward);
	}
	
	public ActionForward exportRejectedApplicants(ActionMapping mapping, ActionForm actionForm, HttpServletRequest request, HttpServletResponse response) {
		String forward = "selectFields";
		String positionId=request.getParameter("positionId");
		String applicantName=request.getParameter("rejectedApplicantName");
		String stepName=request.getParameter("stepName");
		String rejectedBy=request.getParameter("rejectedBy");
		ExportForm exportForm = (ExportForm) actionForm;
		exportForm.setEntityType(ExportConstants.ENTITY_REJECTED_APPLICANTS);
		exportForm.setPositionId(positionId);
		exportForm.setApplicantName(applicantName);
		exportForm.setStepName(stepName);
		exportForm.setRejectedBy(rejectedBy);
		return mapping.findForward(forward);
	}
	
	public ActionForward exportSkills(ActionMapping mapping, ActionForm actionForm, HttpServletRequest request, HttpServletResponse response) {
		
		return null;
	}
	
	public ActionForward exportMasters(ActionMapping mapping, ActionForm actionForm, HttpServletRequest request, HttpServletResponse response){
		String forward = "selectFields";
		ExportForm exportForm = (ExportForm) actionForm;
		exportForm.setEntityType(request.getParameter("exportEntityType"));
		return mapping.findForward(forward);
	}
	
}
