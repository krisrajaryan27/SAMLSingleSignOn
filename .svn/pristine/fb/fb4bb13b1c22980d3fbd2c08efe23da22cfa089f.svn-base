package com.talentPool.masters.dataobject;

import java.util.ArrayList;

public class SkillCategoryData extends MasterData {
	
	public SkillCategoryData(){
		
	}

	public ArrayList getSkills(){
		return (ArrayList)getAttribute("skills");
	}
	
	  public void setSkills(ArrayList skills){
		  setAttribute("skills",skills);	
	  }
	  
}
