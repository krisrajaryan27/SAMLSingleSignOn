package com.talentPool.reports.views;
import com.talentPool.common.db.SimpleDataObject;

public class HiringStatusDetailView extends SimpleDataObject {
	/**
	 * @return the applicantName
	 */
	public String getApplicantName() {
		return getString("applicantName");
	}
	/**
	 * @param applicantName 
	 * 			the applicantName to set
	 */
	public void setApplicantName(String applicantName) {
		setAttribute("applicantName", applicantName);
	}
	/**
	 * @return the departmentPosition
	 */
	public String getDepartmentPosition() {
		return getString("departmentPosition");
	}
	/**
	 * @param departmentPosition 
	 * 			the departmentPosition to set
	 */
	public void setDepartmentPosition(String departmentPosition) {
		setAttribute("departmentPosition", departmentPosition);
	}
	/**
	 * @return the educationExperience
	 */
	public String getEducationExperience() {
		return getString("educationExperience");
	}
	/**
	 * @param educationExperience 
	 * 			the educationExperience to set
	 */
	public void setEducationExperience(String educationExperience) {
		setAttribute("educationExperience", educationExperience);
	}
	/**
	 * @return the stepTitle
	 */
	public String getStepTitle() {
		return getString("stepTitle");
	}
	/**
	 * @param stepTitle 
	 * 			the stepTitle to set
	 */
	public void setStepTitle(String stepTitle) {
		setAttribute("stepTitle", stepTitle);
	}
	/**
	 * @return the positionId
	 */
	public String getPositionId() {
		return getString("positionId");
	}
	/**
	 * @param positionId 
	 * 			the positionId to set
	 */
	public void setPositionId(String positionId) {
		setAttribute("positionId", positionId);
	}
}
