	    <td class="header">
	    	<b><label class="star"><bean:message key="errors.following_errors"/></b>
	    </td>
		</tr>
    <tr>
    	<td class="message"><label class="star"><html:errors/></label></td>
    </tr>
	</table>
	<br>
