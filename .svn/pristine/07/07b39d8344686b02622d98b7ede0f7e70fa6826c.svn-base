		Sourcetitle = _sourceNamesMap.get(sourceId);
		return Sourcetitle;
	}

	public static String getSourceId(String sourceName) {
		String sourceId = null;
		if (_sourceIds == null) {
			populateSources();
		}
		Iterator<String> itr = _sourceNames.iterator();
		while (itr.hasNext()) {
			String _sourceName = (String) itr.next();
			if (_sourceName.equalsIgnoreCase(sourceName)) {
				sourceId = _sourceIds.get(_sourceNames.indexOf(_sourceName));
				break;
			}
		}
		return sourceId;
	}

