	/**
	 * This method Take ArrayList as src and Populates ArrayList ids and
	 * ArrayList names with ids and names. If Map not null then also put mapping
	 * of id and name into Map map
	 * 
	 * @param src
	 * @param ids
	 * @param names
	 * @param paramId
	 *            is the name of the attribute which is used to populate ids
	 * @param paramName
	 *            is the name of the attribute which is used to populate names
	 * @param map
	 */
	public static void populateIdsAndNames(ArrayList src, ArrayList<String> ids, ArrayList<String> names,
			String paramId, String paramName, Map<String, String> map) {
		try {
			if (src != null) {
				for (int i = 0; i < src.size(); i++) {
					SimpleDataObject sdo = (SimpleDataObject) src.get(i);
					String id = sdo.getString(paramId);
					String name = sdo.getString(paramName);
					ids.add(ids.size(), id);
					names.add(names.size(), name);
					if (map != null) {
						map.put(id, name);
					}
				}
			}
		} catch (Exception e) {
			TPLogger.getLogger().error("error while populating ids and names", e);
		}
	}

	public static String getListJavaScriptArrayForFlags(List<SimpleDataObject> flags) {
		StringBuffer sb = new StringBuffer();
		try {
			if (flags != null && flags.size() > 0) {
				int totalOptions = flags.size();
				sb.append("[");
				for (int i = 0; i < totalOptions; i++) {
					SimpleDataObject sdo = (SimpleDataObject) flags.get(i);
					String id = sdo.getString("flagId").replaceAll("'", "\\\\'");
					String txt = sdo.getString("flagText").replaceAll("'", "\\\\'");
					String flagImageUrl = "docs.do?mode=getIcon&fileName=" + sdo.getString("flagImage")
							+ "&contentDisposition=" + DocumentConstants.CONTENT_DISPOSITION_INLINE;
					String img = flagImageUrl.replaceAll("'", "\\\\'");

					sb.append("new SelectOption('" + Utils.escapeJavaScript(id) + "','" + Utils.escapeJavaScript(txt)
							+ "',0,null,false,{optImage:'" + img + "'})");
					if (i < totalOptions - 1)
						sb.append(",");
				}
				sb.append("]");
			} else {
				sb.append(NEW_ARRAY);
			}
		} catch (Exception e) {
			TPLogger.getLogger().error("error while generating javascript array for flags", e);
			sb = new StringBuffer(NEW_ARRAY);
		}
		return sb.toString();
	}

	/**
	 * @param ids
	 *            ArrayList of ids
	 * @param names
	 *            ArrayList of names
	 * @param namesOnly
	 *            if true options id and name are same as names.
	 * @return
	 */
	public static String getListJavaScriptArray(ArrayList<String> ids, ArrayList<String> names) {
		StringBuffer sb = new StringBuffer();
		try {
			ArrayList<String> oIds = (ids == null) ? names : ids;
			int totalOptions = oIds.size();
			if (totalOptions > 0) {
				sb.append("[");
				for (int i = 0; i < totalOptions; i++) {
					sb.append("new SelectOption('" + Utils.escapeJavaScript(oIds.get(i)) + "','"
							+ Utils.escapeJavaScript(names.get(i)) + "')");
					if (i < totalOptions - 1)
						sb.append(",");
				}
				sb.append("]");
			} else {
				sb.append(NEW_ARRAY);
			}
		} catch (Exception e) {
			TPLogger.getLogger().error("error while generating javascript array", e);
			sb = new StringBuffer(NEW_ARRAY);
		}
		return sb.toString();
	}

	/**
	 * @param map
	 *            Map<String, Object>
	 * @return
	 */
	public static String getJSArrayForMap(Map<String, Object> map) {
		StringBuffer sb = new StringBuffer();
		try {
			if (!Utils.isMapEmptyOrNull(map)) {
				sb.append("{");
				Iterator<String> iter = map.keySet().iterator();
				while (iter.hasNext()) {
					String key = iter.next();
					sb.append("'").append(key).append("':").append(map.get(key));

					if (iter.hasNext())
						sb.append(", ");
				}
				sb.append("}");
			} else {
				sb.append("");
			}
		} catch (Exception e) {
			TPLogger.getLogger().error("error while generating javascript array", e);
			sb = new StringBuffer("");
		}
		return sb.toString();
	}

	public static String getJavaScriptArrayForRecentlyUsed() {
		ArrayList<RecentlyUsedSourceData> recentlyUsed = RecentlyUsedSources.INSTANCE.getRecentlyUsedSources();
		return getListJavaScriptArrayWithProperties(recentlyUsed, "sourceId", "sourceTitle");
	}

	/**
	 * @param src
	 *            list of SimpleDataObject
	 * @param paramId
	 * @param paramName
	 * @return
	 */
	public static String getListJavaScriptArrayWithProperties(ArrayList src, String paramId, String paramName) {
		StringBuffer sb = new StringBuffer();
		try {
			int totalOptions = src.size();
			if (totalOptions > 0) {
				sb.append("[");
				for (int i = 0; i < totalOptions; i++) {
					SimpleDataObject sdo = (SimpleDataObject) src.get(i);
					String id = sdo.getString(paramId);
					String name = sdo.getString(paramName);
					if (Utils.isBlankOrNull(name)) {
						name = StringUtils.EMPTY;
					}
					sb.append("new SelectOption('" + Utils.escapeJavaScript(id) + "','" + Utils.escapeJavaScript(name)
							+ "')");
					if (i < totalOptions - 1)
						sb.append(",");
				}
				sb.append("]");
			} else {
				sb.append(NEW_ARRAY);
			}

		} catch (Exception e) {
			TPLogger.getLogger().error("error while generating javascript array", e);
			sb = new StringBuffer(NEW_ARRAY);
		}
		return sb.toString();
	}

	/**
	 * @param arList
	 *            Arraylist containing the String Objects
	 * @return String with Array of Strings
	 */
	public static String returnArrayForJS(ArrayList<String> arList) {
		String arrayString = "";
		try {
			arrayString = "[";
			for (int i = 0; i < arList.size(); i++) {
				if (i == (arList.size() - 1)) {
					arrayString = arrayString + "'"
							+ arList.get(i).replaceAll("'", "\\\\'").replaceAll("\\\\", "\\\\\\\\") + "'";
				} else {
					arrayString = arrayString + "'"
							+ arList.get(i).replaceAll("'", "\\\\'").replaceAll("\\\\", "\\\\\\\\") + "'" + ",";
				}
			}
			arrayString = arrayString + "]";
		} catch (Exception e) {
			TPLogger.getLogger().error("failed in returnArrayForJS", e);
		}
		return arrayString;
	}

	public static String getListJavaScriptArrayForCustomFieldOptions(ArrayList<CustomFieldOption> options) {
		StringBuffer sb = new StringBuffer();
		try {
			if (options == null) {
				sb.append(NEW_ARRAY);
			} else {
				int totalOptions = options.size();
				if (totalOptions > 0) {
					sb.append("[");
					for (int i = 0; i < totalOptions; i++) {
						sb.append("new SelectOption('" + Utils.escapeJavaScript(options.get(i).getKey()) + "','"
								+ Utils.escapeJavaScript(options.get(i).getValue()) + "')");
						if (i < totalOptions - 1)
							sb.append(",");
					}
					sb.append("]");
				} else {
					sb.append(NEW_ARRAY);
				}
			}
		} catch (Exception e) {
			TPLogger.getLogger().error("error while generating javascript array", e);
			sb = new StringBuffer(NEW_ARRAY);
		}
		return sb.toString();
	}

