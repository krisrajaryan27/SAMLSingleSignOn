	private static void populateSourceCategoryTypeMap() {
		DBPreparedQuery dq = null;
		try {
			_sourceCategoryTypeMap = new HashMap<String, String>();
			dq = new DBPreparedQuery("dGetSourceCategoryTypeMap");
			dq.setString(1, AdminConstants.SYSTEM_GENERATED);
			ArrayList<SourceTypeData> sourceTypeData = dq.getResult();
			if (sourceTypeData != null) {
				for (int i = 0; i < sourceTypeData.size(); i++) {
					_sourceCategoryTypeMap.put(sourceTypeData.get(i).getSourceTypeCategory(),
							sourceTypeData.get(i).getSourceTypeId());
				}
			}
		} catch (Exception e) {
			TPLogger.getLogger().error(GlobalConstants.ERROR, e);
		} finally {
			if (dq != null) {
				dq.releaseConnection();
			}
		}
	}

