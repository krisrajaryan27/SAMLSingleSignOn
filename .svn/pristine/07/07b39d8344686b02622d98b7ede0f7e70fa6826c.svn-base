	public static void populateFlags() {
		DBPreparedQuery dq = null;
		try {
			dq = new DBPreparedQuery("dGetAllFlags");
			_flags = dq.getResult();
			_flagIdDataMap = new HashMap<String, SimpleDataObject>();
			for (int i = 0; _flags != null && i < _flags.size(); i++) {
				SimpleDataObject flg = _flags.get(i);
				String flagImageUrl = "docs.do?mode=getIcon&fileName=" + flg.getString("flagImage")
						+ "&contentDisposition=" + DocumentConstants.CONTENT_DISPOSITION_INLINE;
				flg.setAttribute("flagImage", flagImageUrl);
				_flagIdDataMap.put(flg.getString("flagId"), flg);
			}
		} catch (Exception e) {
			TPLogger.getLogger().error("Error While Populating States", e);
		} finally {
			if (dq != null) {
				dq.releaseConnection();
			}
		}
	}

	public static void resetFlags() {
		populateFlags();
	}

