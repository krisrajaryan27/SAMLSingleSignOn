	/**
	 * For given concatenated departmentIds it will return concatenated
	 * department names
	 * 
	 * @param deptIds
	 * @return
	 * @author praveenk
	 */
	public static String getDeptNames(String deptIds) {
		StringBuilder deptNames = new StringBuilder();
		if (_deptIds == null) {
			populateDept();
		}
		if (!Utils.isBlankOrNull(deptIds)) {
			boolean start = true;
			for (String deptId : deptIds.split(DEFAULT_DELIMITER)) {
				if (start) {
					deptNames.append(_deptNamesMap.get(deptId));
					start = false;
				} else {
					deptNames.append(DEFAULT_DELIMITER).append(_deptNamesMap.get(deptId));
				}
			}
		}
		return deptNames.toString();
	}

	public static String getDeptId(String deptName) {
		String id = null;
		if (_deptIds == null) {
			populateDept();
		}
		if (_deptNames.contains(deptName)) {
			id = _deptIds.get(_deptNames.indexOf(deptName));
		}
		return id;
	}

