	public static String getListJavaScriptArrayWithProperties(ArrayList src, String paramId, String paramName,
			String paramCode) {
		StringBuffer sb = new StringBuffer();
		try {
			int totalOptions = src.size();
			if (totalOptions > 0) {
				sb.append("[");
				for (int i = 0; i < totalOptions; i++) {
					SimpleDataObject sdo = (SimpleDataObject) src.get(i);
					String id = sdo.getString(paramId);
					String name = sdo.getString(paramName);
					String code = sdo.getString(paramCode);
					sb.append("new SelectOption('" + Utils.escapeJavaScript(id) + "','" + Utils.escapeJavaScript(name)
							+ "[" + (Utils.escapeJavaScript(code)) + "]" + "')");
					if (i < totalOptions - 1)
						sb.append(",");
				}
				sb.append("]");
			} else {
				sb.append(NEW_ARRAY);
			}

		} catch (Exception e) {
			TPLogger.getLogger().error("error while generating javascript array", e);
			sb = new StringBuffer(NEW_ARRAY);
		}
		return sb.toString();
	}

	// Added for Asian Paints BEGIN

	/**
	 * This method Take ArrayList as src and Populates ArrayList ids and
	 * ArrayList names with ids and names. If Map not null then also put mapping
	 * of id and name into Map map
	 * 
	 * @param src
	 * @param ids
	 * @param names
	 * @param paramId
	 *            is the name of the attribute which is used to populate ids
	 * @param paramName1
	 *            is the name of the attribute which is used to populate names
	 * @param paramName2
	 *            is the name of the attribute which is used to populate names
	 * @param map
	 */
	public static void populateIdsAndNames(ArrayList src, ArrayList<String> ids, ArrayList<String> names,
			String paramId, String paramName1, String paramName2, Map<String, String> map) {
		try {
			if (src != null) {
				for (int i = 0; i < src.size(); i++) {
					SimpleDataObject sdo = (SimpleDataObject) src.get(i);
					String id = sdo.getString(paramId);
					String name = sdo.getString(paramName1) + " (" + sdo.getString(paramName2) + ")";
					ids.add(ids.size(), id);
					names.add(names.size(), name);
					if (map != null) {
						map.put(id, name);
					}
				}
			}
		} catch (Exception e) {
			TPLogger.getLogger().error("error while populating ids and names", e);
		}
	}

	/**
	 * @param src
	 *            list of SimpleDataObject
	 * @param paramId
	 * @param paramName1
	 * @param paramName2
	 * @return
	 */
	public static String getJobCodeListJavaScriptArrayWithProperties(ArrayList src, String paramId, String paramName1,
			String paramName2) {
		StringBuffer sb = new StringBuffer();
		try {
			int totalOptions = src.size();
			if (totalOptions > 0) {
				sb.append("[");
				for (int i = 0; i < totalOptions; i++) {
					SimpleDataObject sdo = (SimpleDataObject) src.get(i);
					String id = sdo.getString(paramId);
					String name = StringUtils.EMPTY;
					if (!Utils.isBlankOrNull(sdo.getString(paramName2))) {
						String jobName = sdo.getString(paramName1);
						if (Utils.isBlankOrNull(jobName)) {
							jobName = StringUtils.EMPTY;
						}
						name = jobName + " (" + sdo.getString(paramName2) + ")";
					}
					sb.append("new SelectOption('" + Utils.escapeJavaScript(id) + "','" + Utils.escapeJavaScript(name)
							+ "')");
					if (i < totalOptions - 1)
						sb.append(",");
				}
				sb.append("]");
			} else {
				sb.append(NEW_ARRAY);
			}

		} catch (Exception e) {
			TPLogger.getLogger().error("error while generating javascript array", e);
			sb = new StringBuffer(NEW_ARRAY);
		}
		return sb.toString();
	}

	public static void populateLoc() {
		DBQuery dq = null;
		try {
			_locIds = new ArrayList<String>();
			_locNames = new ArrayList<String>();
			_locNamesMap = new HashMap<String, String>();
			dq = new DBQuery("dGetAllLoc");
			ArrayList loc = dq.getResult();
			populateIdsAndNames(loc, _locIds, _locNames, "locId", "locName","locationExternalCode", _locNamesMap);

		} catch (Exception e) {
			TPLogger.getLogger().error("Error While Populating location info", e);
		} finally {
			if (dq != null) {
				dq.releaseConnection();
			}
		}
	}

	public static ArrayList<String> getLocIds() {
		if (_locIds == null) {
			populateLoc();
		}
		return _locIds;
	}

	public static void setLocIds(ArrayList<String> locIds) {
		_locIds = locIds;
	}

	public static ArrayList<String> getLocNames() {
		if (_locNames == null) {
			populateLoc();
		}
		return _locNames;
	}

	public static void setLocNames(ArrayList<String> locNames) {
		_locNames = locNames;
	}

