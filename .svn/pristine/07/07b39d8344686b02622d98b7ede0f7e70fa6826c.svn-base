	public static ArrayList<String> getSourceIdsWithOnlyEmployeeSource() {
		ArrayList<String> sourceIdsWithoutEmployeeSource = getSourceIdsWithoutEmployeeSource();
		ArrayList<String> sourceIds = (ArrayList<String>) getSourceIds().clone();
		sourceIds.removeAll(sourceIdsWithoutEmployeeSource);
		return sourceIds;
	}

	public static ArrayList<String> getSourceNamesWithOnlyEmployeeSource() {
		ArrayList<String> sourceNamesWithoutEmployeeSource = getSourceNamesWithoutEmployeeSource();
		ArrayList<String> sourceNames = (ArrayList<String>) getSourceNames().clone();
		sourceNames.removeAll(sourceNamesWithoutEmployeeSource);
		return sourceNames;
	}

