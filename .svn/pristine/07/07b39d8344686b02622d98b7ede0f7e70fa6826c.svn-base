			_securityQuestionsMap = new HashMap<String, String>();
			populateIdsAndNames(_securityQuestions, _securityQuestionIds, _securityQuestionNames, "securityQuestionId",
					"securityQuestion", _securityQuestionsMap);
		} catch (Exception e) {
			TPLogger.getLogger().error("Error While Populating Security Qestions", e);
		}
	}

