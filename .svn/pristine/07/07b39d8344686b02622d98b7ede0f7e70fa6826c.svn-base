	private static String getFlagProperty(String flagId, String property) {
		String flagProperty = "";
		try {
			if (_flagIdDataMap == null) {
				populateFlags();
			}
			SimpleDataObject sdo = _flagIdDataMap.get(flagId);
			flagProperty = sdo.getString(property);
		} catch (Exception e) {
			TPLogger.getLogger().debug("Flag Id = " + flagId + " does not exist ", e);
			flagProperty = "";
		}
		return flagProperty;

	}

