		try {
			MastersManager masterManager = new MastersManager();
			ArrayList<SimpleDataObject> costCenter = masterManager.getAllCostCenterData();
			costCenterXML = commonUtils.getXmlForCostCenter(costCenter);
			costCenterXML = Utils.escapeJavaScript(costCenterXML);
		} catch (SQLException e) {
			TPLogger.getLogger().error(GlobalConstants.ERROR, e);
		}
		return costCenterXML;
	}

	public String getXmlForCostCenter(ArrayList<SimpleDataObject> costCenter) {
		StringWriter sWr = new StringWriter();
		XMLWriter wr = new XMLWriter(sWr);
		try {
			wr.startDocument();
			wr.startElement("rows");
			if (costCenter != null && costCenter.size() > 0) {
				for (int i = 0; i < costCenter.size(); i++) {
					SimpleDataObject costCenterData = (SimpleDataObject) costCenter.get(i);

					String costCenterId = costCenterData.getString("costCenterId");
					String costCenterName = Utils.getBlankIfNull(costCenterData.getString("costCenterName"));

					AttributesImpl atr = new AttributesImpl();
					atr.addAttribute("", "id", "", "", String.valueOf(costCenterId));
					wr.startElement("", "row", "", atr);

					atr = new AttributesImpl();
					atr.addAttribute("", "name", "", "", "costCenterName");
					wr.startElement("", "userdata", "", atr);
					wr.characters(costCenterName);
					wr.endElement("userdata");

					wr.startElement("cell");
					wr.characters(costCenterName);
					wr.endElement("cell");

					wr.endElement("row");
				}
			}
			wr.endElement("rows");
			wr.endDocument();

		} catch (SAXException e) {
			TPLogger.getLogger().error(GlobalConstants.ERROR, e);
		}
		return sWr.getBuffer().toString();
	}

