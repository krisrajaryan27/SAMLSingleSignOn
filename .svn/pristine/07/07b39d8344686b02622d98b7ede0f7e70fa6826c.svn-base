	/**
	 * Pupulate _resumeTypeIds with Ids, _resumeTypeNames with Names and
	 * _resumeTypesMap with a mapping of id to name
	 */
	public static void populateResumeTypes() {
		DBQuery dq = null;
		try {
			_resumeTypeIds = new ArrayList<String>();
			_resumeTypeNames = new ArrayList<String>();
			_resumeTypesMap = new HashMap<String, String>();
			dq = new DBQuery("dGetAllResumeTypes");
			_resumeTypes = dq.getResult();
			populateIdsAndNames(_resumeTypes, _resumeTypeIds, _resumeTypeNames, "resumeTypeId", "resumeType",
					_resumeTypesMap);
		} catch (Exception e) {
			TPLogger.getLogger().error("Error While Populating resumeType", e);
		} finally {
			if (dq != null) {
				dq.releaseConnection();
			}
		}
	}

