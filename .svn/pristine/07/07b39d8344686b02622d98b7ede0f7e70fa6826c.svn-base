	/**
	 * Pupulate _degreeIds with Ids, _degreeNames with Names and _degreeNamesMap
	 * with a mapping of id to name
	 */
	public static void populateDegrees() {
		DBQuery dq = null;
		try {
			_degreeIds = new ArrayList<String>();
			_degreeIdsForTypes = new ArrayList<String>();
			_degreeNames = new ArrayList<String>();
			_degreeNamesMap = new HashMap<String, String>();
			_degreeTypes = new ArrayList<String>();
			_degreeTypesMap = new HashMap<String, String>();
			dq = new DBQuery("dGetAllDegrees");
			_degrees = dq.getResult();
			populateIdsAndNames(_degrees, _degreeIds, _degreeNames, "degreeId", "title", _degreeNamesMap);
			populateIdsAndNames(_degrees, _degreeIdsForTypes, _degreeTypes, "degreeId", "degreeType", _degreeTypesMap);

		} catch (Exception e) {
			TPLogger.getLogger().error("Error While Populating States", e);
		} finally {
			if (dq != null) {
				dq.releaseConnection();
			}
		}

	}

