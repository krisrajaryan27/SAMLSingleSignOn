	public static String getXMLForBusinessUnit() {
		String buXML = null;
		CommonUtils commonUtils = new CommonUtils();
		try {
			MastersManager masterManager = new MastersManager();
			ArrayList<SimpleDataObject> bu = masterManager.getAllBusinessUnitData();
			buXML = commonUtils.getXmlForBusinessUnit(bu);
			buXML = Utils.escapeJavaScript(buXML);
		} catch (SQLException e) {
			TPLogger.getLogger().error(GlobalConstants.ERROR, e);
		}
		return buXML;
	}

	public String getXmlForBusinessUnit(ArrayList<SimpleDataObject> bus) {
		StringWriter sWr = new StringWriter();
		XMLWriter wr = new XMLWriter(sWr);
		try {
			wr.startDocument();
			wr.startElement("rows");
			if (bus != null && bus.size() > 0) {
				for (int i = 0; i < bus.size(); i++) {
					SimpleDataObject buData = (SimpleDataObject) bus.get(i);

					String buId = buData.getString("buId");
					String buName = Utils.getBlankIfNull(buData.getString("buName"));

					AttributesImpl atr = new AttributesImpl();
					atr.addAttribute("", "id", "", "", String.valueOf(buId));
					wr.startElement("", "row", "", atr);

					atr = new AttributesImpl();
					atr.addAttribute("", "name", "", "", "buName");
					wr.startElement("", "userdata", "", atr);
					wr.characters(buName);
					wr.endElement("userdata");

					wr.startElement("cell");
					wr.characters(buName);
					wr.endElement("cell");

					wr.endElement("row");
				}
			}
			wr.endElement("rows");
			wr.endDocument();

		} catch (SAXException e) {
			TPLogger.getLogger().error(GlobalConstants.ERROR, e);
		}
		return sWr.getBuffer().toString();
	}

