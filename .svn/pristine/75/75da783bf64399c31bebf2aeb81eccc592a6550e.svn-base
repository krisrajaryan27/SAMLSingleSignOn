package com.talentPool.offerSheet.form;

import org.apache.struts.upload.FormFile;

import com.talentPool.common.base.TPActionForm;

/**
 * @author pallavi
 *
 */
public class OfferSheetForm extends TPActionForm {
	private String templateId;
	private String templateName;
	private String templateDesc;
	private FormFile templateDocument;
	/**
	 * @return the templateId
	 */
	public String getTemplateId() {
		return templateId;
	}
	/**
	 * @param templateId the templateId to set
	 */
	public void setTemplateId(String templateId) {
		this.templateId = templateId;
	}
	/**
	 * @return the templateName
	 */
	public String getTemplateName() {
		return templateName;
	}
	/**
	 * @param templateName the templateName to set
	 */
	public void setTemplateName(String templateName) {
		this.templateName = templateName;
	}
	/**
	 * @return the templateDesc
	 */
	public String getTemplateDesc() {
		return templateDesc;
	}
	/**
	 * @param templateDesc the templateDesc to set
	 */
	public void setTemplateDesc(String templateDesc) {
		this.templateDesc = templateDesc;
	}
	/**
	 * @return the templateDocument
	 */
	public FormFile getTemplateDocument() {
		return templateDocument;
	}
	/**
	 * @param templateDocument the templateDocument to set
	 */
	public void setTemplateDocument(FormFile templateDocument) {
		this.templateDocument = templateDocument;
	}	
}
