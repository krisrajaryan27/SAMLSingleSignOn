package com.talentPool.reports.dataobject;

/**
 * @author shivprasad
 * 
 */
public class ReportIdName {
	private String reportId;
	private String reportName;
	private boolean isReportSelected;
	private String reportCategory;
	private int reportType;
		
	public ReportIdName(String reportId, String reportName, String reportCategory) {
		this.reportId = reportId;
		this.reportName = reportName;
		this.reportCategory = reportCategory;
		this.reportType = 0;
	}
	
	public ReportIdName(String reportId, String reportName, String reportCategory, int reportType) {
		this.reportId = reportId;
		this.reportName = reportName;
		this.reportCategory = reportCategory;
		this.reportType = reportType;
	}

	/**
	 * @return the reportId
	 */
	public String getReportId() {
		return reportId;
	}

	/**
	 * @param reportId
	 *            the reportId to set
	 */
	public void setReportId(String reportId) {
		this.reportId = reportId;
	}

	/**
	 * @return the reportName
	 */
	public String getReportName() {
		return reportName;
	}

	/**
	 * @param reportName
	 *            the reportName to set
	 */
	public void setReportName(String reportName) {
		this.reportName = reportName;
	}

	/**
	 * @return the isReportSelected
	 */
	public boolean getIsReportSelected() {
		return isReportSelected;
	}

	/**
	 * @param isReportSelected
	 *            the isReportSelected to set
	 */
	public void setIsReportSelected(boolean isReportSelected) {
		this.isReportSelected = isReportSelected;
	}

	/**
	 * @return the reportCategory
	 */
	public String getReportCategory() {
		return reportCategory;
	}

	/**
	 * @param reportCategory
	 *            the reportCategory to set
	 */
	public void setReportCategory(String reportCategory) {
		this.reportCategory = reportCategory;
	}

	public int getReportType() {
		return reportType;
	}

	public void setReportType(int reportType) {
		this.reportType = reportType;
	}

}
