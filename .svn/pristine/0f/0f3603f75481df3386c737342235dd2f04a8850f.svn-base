package com.talentPool.common.Logger;

import org.apache.log4j.Logger;

/**
 * @author Ajeet
 *
 */
public class TPAudit extends Logger {


	protected TPAudit(String name) {
		super(name);
	}

	/**
	 * @return static logger object which is used commonly
	 */
	public static Logger getLogger() {
		return Logger.getLogger("com.talentPool.audit");
	}

}
