package com.talentPool.reports.views;

import com.talentPool.common.db.SimpleDataObject;

/**
 * @author SumeetS
 *
 */
public class InterviewListStatusView extends SimpleDataObject {

	/**
	 * 
	 */
	private static final long serialVersionUID = 1L;

	/**
	 * @return
	 */
	public String getDate() {
		return getString("date");
	}
	
	/**
	 * @param date
	 */
	public void setDate(String date) {
		setAttribute("date", date);
	}
	
	/**
	 * @return
	 */
	public String getName() {
		return getString("name");
	}
	
	/**
	 * @param name
	 */
	public void setName(String name) {
		setAttribute("name", name);
	}
	
	/**
	 * @return
	 */
	public String getModeOfInterview() {
		return getString("modeOfInterview");
	}
	
	/**
	 * @param modeOfInterview
	 */
	public void setModeOfInterview(String modeOfInterview) {
		setAttribute("modeOfInterview", modeOfInterview);
	}
	
	/**
	 * @return
	 */
	public String getDepartment() {
		return getString("department");
	}
	
	/**
	 * @param department
	 */
	public void setDepartment(String department) {
		setAttribute("department", department);
	}
	
	/**
	 * @return
	 */
	public String getPosition() {
		return getString("position");
	}
	
	/**
	 * @param position
	 */
	public void setPosition(String position) {
		setAttribute("position", position);
	}
	
	/**
	 * @return
	 */
	public String getRecruiter() {
		return getString("recruiter");
	}
	
	/**
	 * @param recruiter
	 */
	public void setRecruiter(String recruiter) {
		setAttribute("recruiter", recruiter);
	}
	
	/**
	 * @return
	 */
	public String getStatus() {
		return getString("status");
	}
	
	/**
	 * @param status
	 */
	public void setStatus(String status) {
		setAttribute("status", status);
	}
	
	/**
	 * @return
	 */
	public String getCurrentStep() {
		return getString("currentStep");
	}
	
	/**
	 * @param currentStep
	 */
	public void setCurrentStep(String currentStep) {
		setAttribute("currentStep", currentStep);
	}
	
	/**
	 * @return
	 */
	public String getSource() {
		return getString("source");
	}
	
	/**
	 * @param source
	 */
	public void setSource(String source) {
		setAttribute("source", source);
	}
	
	/**
	 * @param interviewers
	 */
	public void setInterviewers(String interviewers) {
		setAttribute("interviewers", interviewers);
	}
	
	/**
	 * @return
	 */
	public String getInterviewers() {
		return getString("interviewers");
	}
	/**
	 * @param applicantPositionId
	 */
	public void setPositionId(int positionId) {
		setAttribute("positionId", positionId);
	}
	
	/**
	 * @return Returns the applicantId.
	 */
	public int getApplicantId() {
		return getInt("applicantId");
	}

	/**
	 * @param applicantId
	 *            The applicantId to set.
	 */
	public void setApplicantId(int applicantId) {
		setAttribute("applicantId", new Integer(applicantId));
	}
	
	/**
	 * @return
	 */
	public String getFeedback() {
		return getString("feedback");
	}
	
	/**
	 * @param feedback
	 */
	public void setFeedback(String feedback) {
		setAttribute("feedback", feedback);
	}
}
