package com.talentPool.common.utils.Exception;

/**
 * @author SiddharthK
 *
 */
public class InvalidMimeTypeException extends Exception {

	/**
	 * 
	 */
	private static final long serialVersionUID = 1L;

	/**
	 * Creates a new instance of <code>InvalidMimeTypeException</code> without detail message.
	 */
	public InvalidMimeTypeException() {
	}

	/**
	 * Constructs an instance of <code>InvalidMimeTypeException</code> with the specified detail message.
	 * 
	 * @param msg
	 *            the detail message.
	 */
	public InvalidMimeTypeException(String msg) {
		super(msg);
	}
	
}
