package com.talentPool.websiteservice.dataobject;

import java.util.Map;

/**
 * @author praveen
 *
 */
public class WpositionFilters {
	private Map<String,String> skillsMap;
	private Map<String,String> departmentsMap;
	private Map<String,String> locationsMap;

	/**
	 * @return the skillsMap
	 */
	public Map<String,String> getSkillsMap() {
		return skillsMap;
	}

	/**
	 * @param skillsMap the skillsMap to set
	 */
	public void setSkillsMap(Map<String,String> skillsMap) {
		this.skillsMap = skillsMap;
	}

	/**
	 * @return the departmentsMap
	 */
	public Map<String, String> getDepartmentsMap() {
		return departmentsMap;
	}

	/**
	 * @param departmentsMap the departmentsMap to set
	 */
	public void setDepartmentsMap(Map<String, String> departmentsMap) {
		this.departmentsMap = departmentsMap;
	}

	/**
	 * @return the locationsMap
	 */
	public Map<String, String> getLocationsMap() {
		return locationsMap;
	}

	/**
	 * @param locationsMap the locationsMap to set
	 */
	public void setLocationsMap(Map<String, String> locationsMap) {
		this.locationsMap = locationsMap;
	}

	
}
