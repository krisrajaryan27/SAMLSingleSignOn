<%@ taglib uri="/WEB-INF/tld/struts-bean.tld" prefix="bean"%>
<%@ taglib uri="/WEB-INF/tld/struts-tiles.tld" prefix="tiles"%>
<%@ taglib uri="/WEB-INF/tld/struts-logic.tld" prefix="logic" %>
<%@ taglib uri="/WEB-INF/tld/struts-html.tld" prefix="html"%>
<%@ page import="org.apache.struts.Globals" %>
<%@page import="com.talentPool.masters.constants.MastersConstants"%>

<%@page import="com.talentPool.masters.constants.DegreeConstants"%><script src="js/scripta/lib/prototype.js"></script>
<script src="js/commonFunctions.js"></script>
<script language="JavaScript">
<logic:present name="update" scope="request">
	window.top.hidePopWin(true);
</logic:present>                
</script>

<div class="contentDivPop" style="width:450px;">
	<% 
		if(request.getAttribute(Globals.ERROR_KEY)!=null){
	%>
			<table id="m_errortable" > 
				<tr>
			    <td class='header'>
		        <b><bean:message key="errors.following_errors"/></b>
			    </td>               
				</tr>
		    <tr>
	        <td class="message"><html:errors/></td>               
		    </tr>
			</table><br/><br/>
	<%
		}
	%> 
	<div class="outerDiv">
	<html:form action="/masters" onsubmit="submitForm();return false;">
  	<html:hidden property="degreeId" name="mastersForm"/>
  	<html:hidden property="mode" name="mastersForm"/>
  	<html:hidden property="subMode" name="mastersForm"/>
  	<html:hidden property="degreeType" name="mastersForm"/>
  	
	<div class="popupTop">
		<table class="tblPop">
		    <tr>
			  <td class="header">
				 <bean:message key="common.degree"/> <bean:message key="common.type"/>:&nbsp; 
			  </td>
			  <td>
			  	<logic:equal name="mastersForm" property="degreeType" value="<%=DegreeConstants.TYPE_PG%>">
				  	<img src="images/radiobutton.gif" name='imgDegree' id='img_<%=DegreeConstants.TYPE_UG%>' onclick="javascript:onRadioChange('imgDegree','<%=DegreeConstants.TYPE_UG%>');" style="margin-bottom:-1px;"/><bean:message key="common.ug"/>
					<img src="images/checkedradiobutton.gif" name='imgDegree' id='img_<%=DegreeConstants.TYPE_PG%>' onclick="javascript:onRadioChange('imgDegree','<%=DegreeConstants.TYPE_PG%>');" style="margin-bottom:-1px;"/><bean:message key="common.pg"/>
					<img src="images/radiobutton.gif" name='imgDegree' id='img_<%=DegreeConstants.TYPE_PPG%>' onclick="javascript:onRadioChange('imgDegree','<%=DegreeConstants.TYPE_PPG%>');" style="margin-bottom:-1px;"/><bean:message key="common.ppg"/>
				</logic:equal>
				<logic:equal name="mastersForm" property="degreeType" value="<%=DegreeConstants.TYPE_UG%>">
				  	<img src="images/checkedradiobutton.gif" name='imgDegree' id='img_<%=DegreeConstants.TYPE_UG%>' onclick="javascript:onRadioChange('imgDegree','<%=DegreeConstants.TYPE_UG%>');" style="margin-bottom:-1px;"/><bean:message key="common.ug"/>
					<img src="images/radiobutton.gif" name='imgDegree' id='img_<%=DegreeConstants.TYPE_PG%>' onclick="javascript:onRadioChange('imgDegree','<%=DegreeConstants.TYPE_PG%>');" style="margin-bottom:-1px;"/><bean:message key="common.pg"/>
					<img src="images/radiobutton.gif" name='imgDegree' id='img_<%=DegreeConstants.TYPE_PPG%>' onclick="javascript:onRadioChange('imgDegree','<%=DegreeConstants.TYPE_PPG%>');" style="margin-bottom:-1px;"/><bean:message key="common.ppg"/>
				</logic:equal>
				<logic:equal name="mastersForm" property="degreeType" value="<%=DegreeConstants.TYPE_PPG%>">
				  	<img src="images/radiobutton.gif" name='imgDegree' id='img_<%=DegreeConstants.TYPE_UG%>' onclick="javascript:onRadioChange('imgDegree','<%=DegreeConstants.TYPE_UG%>');" style="margin-bottom:-1px;"/><bean:message key="common.ug"/>
					<img src="images/radiobutton.gif" name='imgDegree' id='img_<%=DegreeConstants.TYPE_PG%>' onclick="javascript:onRadioChange('imgDegree','<%=DegreeConstants.TYPE_PG%>');" style="margin-bottom:-1px;"/><bean:message key="common.pg"/>
					<img src="images/checkedradiobutton.gif" name='imgDegree' id='img_<%=DegreeConstants.TYPE_PPG%>' onclick="javascript:onRadioChange('imgDegree','<%=DegreeConstants.TYPE_PPG%>');" style="margin-bottom:-1px;"/><bean:message key="common.ppg"/>
				</logic:equal>
				<logic:notEqual name="mastersForm" property="degreeType" value="<%=DegreeConstants.TYPE_PG%>">
					<logic:notEqual name="mastersForm" property="degreeType" value="<%=DegreeConstants.TYPE_PPG%>">
				  	<img src="images/checkedradiobutton.gif" name='imgDegree' id='img_<%=DegreeConstants.TYPE_UG%>' onclick="javascript:onRadioChange('imgDegree','<%=DegreeConstants.TYPE_UG%>');" style="margin-bottom:-1px;"/><bean:message key="common.ug"/>
					<img src="images/radiobutton.gif" name='imgDegree' id='img_<%=DegreeConstants.TYPE_PG%>' onclick="javascript:onRadioChange('imgDegree','<%=DegreeConstants.TYPE_PG%>');" style="margin-bottom:-1px;"/><bean:message key="common.pg"/>
					<img src="images/radiobutton.gif" name='imgDegree' id='img_<%=DegreeConstants.TYPE_PPG%>' onclick="javascript:onRadioChange('imgDegree','<%=DegreeConstants.TYPE_PPG%>');" style="margin-bottom:-1px;"/><bean:message key="common.ppg"/>
					</logic:notEqual>
				</logic:notEqual>
		     </td>
		 </tr>
		   <tr>
			  <td class="header">
				  <bean:message key="admin_master_degree_cat.label"/>
				  <span class="star">*</span>
				  :
			  </td>
			  <td>
				  <html:text property="degreeName" name="mastersForm" size="35" styleId="skillCategory"></html:text>
			  </td>
		  </tr>
		  <tr>
			  <td class="header">
				 <bean:message key="admin_master_skill.label.alias"/> 1:&nbsp; 
			  </td>
			  <td>
				 <html:text property="aliases[0]" name="mastersForm" size="35" styleId="skillCategory"></html:text>
		     </td>
		 </tr>
		 <tr>
			 <td class="header">
				<bean:message key="admin_master_skill.label.alias"/> 2:&nbsp; 
		     </td>
			 <td>
				<html:text property="aliases[1]" name="mastersForm" size="35" styleId="skillCategory"></html:text>
			 </td>
		</tr>
		<tr>
			 <td class="header">
				<bean:message key="admin_master_skill.label.alias"/> 3:&nbsp; 
			 </td>
			 <td>
				<html:text property="aliases[2]" name="mastersForm" size="35" styleId="aliases[2]"></html:text>
			</td>
		</tr>
	 </table>
	</div>
	<div class="popupBody">
		<table class="tblPop" width="100%">
		<tr>
			<td>
			<div class="navBtn" style="float: right;">
			<a href="#" style="width:60px;" class="active" onclick="javascript: submitForm();"><span class="rightC"></span><span class="leftC"></span><bean:message key="common.submit"/></a>
			<a href="#" style="width:60px; margin-left:5px;" class="active" onclick="javascript: window.top.hidePopWin(false);return false;"><span class="rightC"></span><span class="leftC"></span><bean:message key="common.cancel"/></a>
			</div>
			</td>
		</tr>
		</table>
	</div>
	</html:form>	
</div>
</div>


<script type="text/javascript">

function submitForm(){
	var Name = document.mastersForm.degreeName.value;
	if(Name.trim()==""){
		return;
	}
	document.mastersForm.submit();
}

function actionOnLoad(){
	<logic:equal name="mastersForm" property="subMode" value="<%=MastersConstants.SUB_MODE_ADD%>">
		window.top.setPopTitle('<b><bean:message key="admin_master_degree.label.add_degree"/></b>');
	</logic:equal>
	<logic:equal name="mastersForm" property="subMode" value="<%=MastersConstants.SUB_MODE_EDIT%>">
		window.top.setPopTitle('<b><bean:message key="admin_master_degree.label.edit_degree"/></b>');
	</logic:equal>
}
var chkedRadioButton='images/radiobutton.gif';
var unchkedRadioButton='images/checkedradiobutton.gif';
function onRadioChange(imgGroupName, attachmentId){
	var imgs = document.getElementsByName(imgGroupName);
	for (i = 0; i < imgs.length; i++) {
			var theImage = imgs[i];
			if (theImage.id.indexOf("img") > -1) {
				if( theImage.id == 'img_'+attachmentId){
					theImage.src = "images/checkedradiobutton.gif";
					document.mastersForm.degreeType.value=attachmentId;
				}else{
					theImage.src = "images/radiobutton.gif";
				}
			}
	}
}
window.onload=actionOnLoad;
</script>

