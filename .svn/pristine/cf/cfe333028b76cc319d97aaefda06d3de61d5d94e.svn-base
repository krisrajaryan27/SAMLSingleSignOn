package com.talentPool.scheduler.dataobject;

import com.talentPool.common.db.SimpleDataObject;

/**
 * @author Sachin
 * @since  March 13, 2012
 */
@SuppressWarnings("serial")
public class SchedulerData extends SimpleDataObject {

	public String getSchedulerStartHour() {
		return getString("schedulerStartHour");
	}
	
	public void setSchedulerStartHour(String schedulerStartHour) {
		setAttribute("schedulerStartHour", schedulerStartHour);
	}
	
	public String getSchedulerFrequency() {
		return getString("schedulerFrequency");
	}
	
	public void setSchedulerFrequency(String schedulerFrequency) {
		setAttribute("schedulerFrequency", schedulerFrequency);
	}
	
	public String getLastRunStatus() {
		return getString("lastRunStatus");
	}
	
	public void setLastRunStatus(String lastRunStatus) {
		setAttribute("lastRunStatus", lastRunStatus);
	}
	
	public String getLastRunStarttime() {
		return getString("lastRunStarttime");
	}
	
	public void setLastRunStarttime(String lastRunStarttime) {
		setAttribute("lastRunStarttime", lastRunStarttime);
	}
	
	public String getLastRunEndtime() {
		return getString("lastRunEndtime");
	}
	
	public void setLastRunEndtime(String lastRunEndtime) {
		setAttribute("lastRunEndtime", lastRunEndtime);
	}
	
	public String getLastSuccessRun() {
		return getString("lastSuccessRun");
	}
	
	public void setLastSuccessRun(String lastSuccessRun) {
		setAttribute("lastSuccessRun", lastSuccessRun);
	}
	
	public String getCurrentStatus() {
		return getString("currentStatus");
	}
	
	public void setCurrentStatus(String currentStatus) {
		setAttribute("currentStatus", currentStatus);
	}
	
}
