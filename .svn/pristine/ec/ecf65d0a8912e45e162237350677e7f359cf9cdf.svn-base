package com.talentPool.customReports.constants;

/**
 * @author PraveenK
 * @since  Feb 27, 2012
 */
public class CRColumnValueConstants {
	
	/**
	 * Empty constructor to avoid object creation as this is Constant class which does not have any object specific properties.
	 */
	private CRColumnValueConstants(){}
	
	/**
	 * Constant to indicate the field with this value type is not a grouping field
	 */
	public static final String COLUMN_VALUE_TYPE_NORMAL 	= "1";
	
	/**
	 * Constant to indicate the field with this value type is a grouping field with aggregate function SUM()
	 */
	public static final String COLUMN_VALUE_TYPE_SUM 		= "2";
	
	/**
	 * Constant to indicate the field with this value type is a grouping field with aggregate function First() (first value after grouping)
	 */
	public static final String COLUMN_VALUE_TYPE_FIRST 		= "3";
	
	/**
	 * Constant to indicate the field with this value type is a grouping field with aggregate function Last() (last value after grouping)
	 */
	public static final String COLUMN_VALUE_TYPE_LAST 		= "4";
		
	//CUSTOM FIELDS
	public static final String POSITION_CUSTOM_FIELD_PREFIX = "PCF";
	public static final String CUSTOM_FIELD_COLUMN_PREFIX= "custom_field_";
	
	/**
	 * If display name is prefixed with this constant then actual display name should be fetched 
	 * from Application Settings  
	 */
	public static final String COLUMN_DISPLAY_NAME_APPLICATION_LABEL_PREFIX= "application:";
	
	/**
	 * If display name is prefixed with this constant then actual display name should be fetched 
	 * from Resource bundle  
	 */
	public static final String COLUMN_DISPLAY_NAME_RESOURCE_BUNDLE_PREFIX= "resource_bundle:";
}
