	public String getJoiningDate() {
		String joiningDate = "";
		String jDate = getApplicantJoiningDate();
		if(!Utils.isBlankOrNull(jDate)){
			java.util.Date date = Utils.convertToDate(jDate, Utils.redYYYYMMDDFormat);
			joiningDate = Utils.getDateConvertedToString(date, Utils.regEUDateFormat);
		}
		return joiningDate;
	}
	
