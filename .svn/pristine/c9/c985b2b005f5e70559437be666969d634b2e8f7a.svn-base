package com.talentPool.websiteservice.dataobject;

/**
 * @author Ajeet
 *
 */
public class WimportFieldData {

	private String fieldId;
	private String fieldType;
	private String fieldTitle;
	private String fieldWebsiteMandatory;
	private String fieldWebsiteShow;
	
	/**
	 * @return the fieldId
	 */
	public String getFieldId() {
		return fieldId;
	}
	/**
	 * @param fieldId the fieldId to set
	 */
	public void setFieldId(String fieldId) {
		this.fieldId = fieldId;
	}
	
	/**
	 * @return the fieldTitle
	 */
	public String getFieldTitle() {
		return fieldTitle;
	}
	/**
	 * @param fieldTitle the fieldTitle to set
	 */
	public void setFieldTitle(String fieldTitle) {
		this.fieldTitle = fieldTitle;
	}
	/**
	 * @return the fieldType
	 */
	public String getFieldType() {
		return fieldType;
	}
	/**
	 * @param fieldType the fieldType to set
	 */
	public void setFieldType(String fieldType) {
		this.fieldType = fieldType;
	}
	/**
	 * @return the fieldWebsiteMandatory
	 */
	public String getFieldWebsiteMandatory() {
		return fieldWebsiteMandatory;
	}
	/**
	 * @param fieldVendorMandatory the fieldWebsiteMandatory to set
	 */
	public void setFieldWebsiteMandatory(String fieldWebsiteMandatory) {
		this.fieldWebsiteMandatory = fieldWebsiteMandatory;
	}
	/**
	 * @return the fieldWebsiteShow
	 */
	public String getFieldWebsiteShow() {
		return fieldWebsiteShow;
	}
	/**
	 * @param fieldWebsiteShow the fieldWebsiteShow to set
	 */
	public void setFieldWebsiteShow(String fieldWebsiteShow) {
		this.fieldWebsiteShow = fieldWebsiteShow;
	}

}



