package com.talentPool.employeeservice.dataobject;

/**
 * @author Shantanu
 *
 */
public class EimportFieldData {
	
	private String fieldId;
	private String fieldType;
	private String fieldTitle;
	private String fieldEmployeeMandatory;
	private String fieldEmployeeShow;
	/**
	 * @return the fieldId
	 */
	public String getFieldId() {
		return fieldId;
	}
	/**
	 * @param fieldId the fieldId to set
	 */
	public void setFieldId(String fieldId) {
		this.fieldId = fieldId;
	}
	/**
	 * @return the fieldType
	 */
	public String getFieldType() {
		return fieldType;
	}
	/**
	 * @param fieldType the fieldType to set
	 */
	public void setFieldType(String fieldType) {
		this.fieldType = fieldType;
	}
	/**
	 * @return the fieldTitle
	 */
	public String getFieldTitle() {
		return fieldTitle;
	}
	/**
	 * @param fieldTitle the fieldTitle to set
	 */
	public void setFieldTitle(String fieldTitle) {
		this.fieldTitle = fieldTitle;
	}
	/**
	 * @return the fieldEmployeeMandatory
	 */
	public String getFieldEmployeeMandatory() {
		return fieldEmployeeMandatory;
	}
	/**
	 * @param fieldEmployeeMandatory the fieldEmployeeMandatory to set
	 */
	public void setFieldEmployeeMandatory(String fieldEmployeeMandatory) {
		this.fieldEmployeeMandatory = fieldEmployeeMandatory;
	}
	/**
	 * @return the fieldEmployeeShow
	 */
	public String getFieldEmployeeShow() {
		return fieldEmployeeShow;
	}
	/**
	 * @param fieldEmployeeShow the fieldEmployeeShow to set
	 */
	public void setFieldEmployeeShow(String fieldEmployeeShow) {
		this.fieldEmployeeShow = fieldEmployeeShow;
	}

}
