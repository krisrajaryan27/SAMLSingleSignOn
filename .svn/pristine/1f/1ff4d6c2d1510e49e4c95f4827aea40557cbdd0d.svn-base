	public ActionForward getHireByDate(ActionMapping mapping, ActionForm actionForm, HttpServletRequest request,
			HttpServletResponse response) {
		String forward = "xmlFile";
		String xmlFile = "";
		try {
			if (!SessionManager.isLoginFound(mapping, actionForm, request, response, this)) {
				xmlFile = Utils.getXMLForSessionExpiry();
			} else {
				PositionForm positionForm = (PositionForm) actionForm;
				Calendar calendar = new GregorianCalendar();
				if (positionForm.getGradeId().equals("-1")) {
					calendar.set(Calendar.DATE,
							(calendar.get(Calendar.DATE) + Integer.parseInt(GlobalApplicationProperties
									.getProperty(GlobalConstants.PROPERTY_DEFAULT_HIRE_BY_DURATION_IN_DAYS))));
				} else {
					MastersManager mastersManager = new MastersManager();
					SimpleDataObject budgetGrade = mastersManager.getBudgetGrade(positionForm.getGradeId());
					String hireByDuration = budgetGrade.getString("hireByDuration");

					if (!Utils.isBlankOrNull(hireByDuration)) {
						calendar.set(Calendar.DATE, (calendar.get(Calendar.DATE) + Integer.parseInt(hireByDuration)));
					} else {
						calendar.set(Calendar.DATE,
								(calendar.get(Calendar.DATE) + Integer.parseInt(GlobalApplicationProperties
										.getProperty(GlobalConstants.PROPERTY_DEFAULT_HIRE_BY_DURATION_IN_DAYS))));
					}
				}
				xmlFile = Utils.getDateConvertedToString(calendar.getTime(), Utils.regEUDateFormat);
			}

		} catch (Exception e) {
			TPLogger.getLogger().error("Error in search screen", e);
			xmlFile = Utils.getXMLForError();
		}
		request.setAttribute("xmlFile", xmlFile);
		return mapping.findForward(forward);
	}

	public ActionForward getAllPositionsToPublish(ActionMapping mapping, ActionForm actionForm,
			HttpServletRequest request, HttpServletResponse response) {
		if (!SessionManager.validateSession(mapping, actionForm, request, response, this)) {
			return null;
		}
		String forward = "positionsToPublishForWalkIn";
		PositionForm form = (PositionForm) actionForm;
		Integer[] permissions = new Integer[2];
		permissions[0] = PermissionConstants.PERMISSION_POSITIONS;
		int module = CommonConstants.NO_MODULE;
		if (PositionConstants.PUBLISH_WALK_IN.equals(form.getPublishType())) {
			module = ModuleConstants.MODULE_WALKIN;
			permissions[1] = PermissionConstants.PERMISSION_PUBLISH_POSITION_FOR_WALK_IN;
		} else if (PositionConstants.PUBLISH_EMPLOYEE_PORTAL.equals(form.getPublishType())) {
			module = ModuleConstants.MODULE_EMPLOYEE;
			permissions[1] = PermissionConstants.PERMISSION_PUBLISH_POSITION_FOR_EMPLOYEE_PORTAL;
		}
		if (!isUserAuthorized(request, module, permissions, null, null, null)) {
			forward = getAuthorizationFailureForward();
			return mapping.findForward(forward);
		}
		try {
			String publishType = form.getPublishType();
			request.setAttribute("t", NavigationConstants.T_POSITIONS);
			if (publishType.equals(PositionConstants.PUBLISH_WALK_IN)) {
				request.setAttribute("publish", PositionConstants.WALK_INS);
			} else if (publishType.equals(PositionConstants.PUBLISH_EMPLOYEE_PORTAL)) {
				request.setAttribute("publish", PositionConstants.EMPLOYEE_PORTAL);
				forward = "positionsToPublishForEmployees";
			}
		} catch (Exception e) {
			TPLogger.getLogger().error("Error while getting all positions to publish", e);
			ActionErrors errors = new ActionErrors();
			ActionError error = new ActionError("position.publish_for_walk_in.error.get_positions",
					TPLabels.getLabel("common.positions"));
			errors.add("position.publish_for_walk_in.error.get_positions", error);
			saveErrors(request, errors);
		}
		return mapping.findForward(forward);
	}

	public ActionForward getAllPositionsToPublishToSocialMedia(ActionMapping mapping, ActionForm actionForm,
			HttpServletRequest request, HttpServletResponse response) {
		if (!SessionManager.validateSession(mapping, actionForm, request, response, this)) {
			return null;
		}
		String forward = "positionsToPublishForSocialMedia";
		PositionForm form = (PositionForm) actionForm;
		Integer[] permissions = new Integer[2];
		permissions[0] = PermissionConstants.PERMISSION_POSITIONS;
		int module = CommonConstants.NO_MODULE;
		permissions[1] = PermissionConstants.PERMISSION_POST_JOB_ON_SOCIAL_MEDIA;
		if (!isUserAuthorized(request, module, permissions, null, null, null)) {
			forward = "authorizationFailure";
			return mapping.findForward(forward);
		}
		try {
			request.setAttribute("publish", PositionConstants.SOCIAL_MEDIA);
			request.setAttribute("t", NavigationConstants.T_POSITIONS);
		} catch (Exception e) {
			TPLogger.getLogger().error("Error while getting all positions to publish", e);
