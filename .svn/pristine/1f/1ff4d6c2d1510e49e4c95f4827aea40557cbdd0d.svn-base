	public ActionForward autoGeneratePositionCode(ActionMapping mapping, ActionForm actionForm,
			HttpServletRequest request, HttpServletResponse response) {
		String forward = "xmlFile";
		String xmlFile = "";
		try {
			if (!SessionManager.isLoginFound(mapping, actionForm, request, response, this)) {
				xmlFile = Utils.getXMLForSessionExpiry();
			} else {
				PositionForm positionForm = (PositionForm) actionForm;
				String positionName = (!Utils.isBlankOrNull(positionForm.getPositionName()))
						? Utils.getFormattedRecord(positionForm.getPositionName()) : "";
				String department = (!Utils.isBlankOrNull(positionForm.getDepartment()))
						? Utils.getFormattedRecord(positionForm.getDepartment()) : "";
				String location = (!Utils.isBlankOrNull(positionForm.getLocationName()))
						? Utils.getFormattedRecord(positionForm.getLocationName()) : "";
				String positionCode = PositionUtils.generatePositionCode(positionName, department, location,
						request.getParameter("isQuickImport"), request.getParameter("positionCount"));
				xmlFile = Utils.getXMLForContent("positionCode", positionCode);
			}
		} catch (Exception e) {
			TPLogger.getLogger().error(GlobalConstants.ERROR, e);
			xmlFile = Utils.getXMLForError();
		} finally {
			request.setAttribute("xmlFile", xmlFile);
		}
		return mapping.findForward(forward);
	}

	public ActionForward getAutoCompleteList(ActionMapping mapping, ActionForm actionForm, HttpServletRequest request,
			HttpServletResponse response) {
		String forward = "xmlFile";
		PositionForm positionForm = (PositionForm) actionForm;
		try {
			String xmlFile = "";
