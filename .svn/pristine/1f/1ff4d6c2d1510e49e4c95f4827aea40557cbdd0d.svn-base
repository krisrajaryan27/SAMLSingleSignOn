		String jsArrayDegrees = CommonUtils.getListJavaScriptArray((ArrayList<String>) degreeIds,
				(ArrayList<String>) degreeNames);
		return jsArrayDegrees;
	}

	private String getJSArrayBranches() {
		List<String> branchIds = CommonUtils.getBranchIds();
		List<String> branchNames = CommonUtils.getBranchNames();
		String jsArrayBranches = CommonUtils.getListJavaScriptArray((ArrayList<String>) branchIds,
				(ArrayList<String>) branchNames);
		return jsArrayBranches;
	}

	public ActionForward saveRequirements(ActionMapping mapping, ActionForm actionForm, HttpServletRequest request,
			HttpServletResponse response) throws Exception {
		if (!SessionManager.validateSession(mapping, actionForm, request, response, this)) {
			return null;
		}

		String forward = "requirements";
		PositionForm form = (PositionForm) actionForm;
		String userId = (String) request.getSession().getAttribute("userId");
		String userRoleId = (String) request.getSession(false).getAttribute("userRoles");
		AuditAction auditAction = new AuditAction();
		ActionErrors errors = null;
		PositionManager positionManager = new PositionManager();
		Integer[] permissions = new Integer[2];
		permissions[0] = PermissionConstants.PERMISSION_POSITIONS;
		if (PositionConstants.POSITION_STATUS_TEMPLATE.equals(form.getPositionStatus())) {
			permissions[1] = PermissionConstants.PERMISSION_CREATE_POSITION_TEMPLATE;
		} else {
			permissions[1] = PermissionConstants.PERMISSION_EDIT_POSITIONS;
		}
		if (!isUserAuthorized(request, CommonConstants.NO_MODULE, permissions, null, form.getPositionId(), null)) {
			forward = getAuthorizationFailureForward();
			return mapping.findForward(forward);
		}
		try {
			errors = validateRequirements(form);
			if (errors == null || errors.size() == 0) {
				// Save position description.
				SimpleDataObject positionRequirements = new SimpleDataObject();
				populatePositionRequirementsInObject(form, positionRequirements);

				SimpleDataObject oldPosition = (SimpleDataObject) positionManager
						.getPositionRequirementsToView(form.getPositionId());
				positionManager.savePositionRequirements(positionRequirements);

				String clientIpAddr = getClientIpAddr(request);
				auditAction.insertAuditInfo(TPLabels.getLabel("common.position_requirements"),
						AuditConstants.TYPE_MODIFIED, form.getPositionId(), AuditConstants.AUDIT_POSITION, userId, null,
						null, null, true, clientIpAddr);
				if (form.getSendPositionChangeNotification().equals(GlobalConstants.ENABLED)) {
					positionManager.sendPositionChangeNotification(form.getPositionId(), null, oldPosition,
							PositionConstants.MODE_REQUIREMENTS, userId);
				}

				form.setDir(PositionConstants.DIR_VIEW_POSITION);
				form.setMode(PositionConstants.MODE_REQUIREMENTS);

				return requirements(mapping, actionForm, request, response);
			}
		} catch (Exception e) {
			TPLogger.getLogger().error("Error while saving position requirements.");
			form.setDir(PositionConstants.DIR_EDIT_POSITION);
			ActionError error = new ActionError("position.requirements.error.save_requirements",
					TPLabels.getLabel("common.position"));
			if (errors == null) {
				errors = new ActionErrors();
			}
			errors.add("position.requirements.error.save_requirements", error);
		}

		if (errors != null && errors.size() > 0) {
			saveErrors(request, errors);
		}
		SimpleDataObject sdo1 = positionManager.getPositionCodeAndName(form.getPositionId());
		request.setAttribute("positionCode", sdo1.getString("positionCode"));
		request.setAttribute("positionName", sdo1.getString("positionName"));

		populateRequirementsPage(form, userId, userRoleId, request);
		form.setStep(NavigationConstants.STEP_POSITION_REQUIREMENTS);
		form.setDir(PositionConstants.DIR_EDIT_POSITION);
		request.setAttribute("t", NavigationConstants.T_POSITIONS);
		return mapping.findForward(forward);
	}

	private void populatePositionRequirementsInObject(PositionForm form, SimpleDataObject positionRequirements) {
		positionRequirements.setAttribute("positionId", form.getPositionId());
		positionRequirements.setAttribute("degreeId", form.getDegreeId());
		positionRequirements.setAttribute("branchId", form.getBranchId());
		positionRequirements.setAttribute("minimumExperience", form.getMinimumExperience());
		positionRequirements.setAttribute("maximumExperience", form.getMaximumExperience());
		positionRequirements.setAttribute("primarySkills", form.getPrimarySkills());
		positionRequirements.setAttribute("secondarySkills", form.getSecondarySkills());
		// positionRequirements.setAttribute("requirements",
		// parseJSArray(form.getJsArrayRequirements(), "requirementId",
		// "requirementText"));
		positionRequirements.setAttribute("requirements", form.getRequirements());
	}

	private ActionErrors validateRequirements(PositionForm form) {
		ActionErrors errors = new ActionErrors();
		Float maximumExperience = null;
		Float minimumExperience = null;
		if (!form.getPositionStatus().equals(PositionConstants.POSITION_STATUS_TEMPLATE)) {
			if (Utils.isBlankOrNull(form.getDegreeId()) || form.getDegreeId().equals("-1")) {
				ActionError error = new ActionError("position.requirements.error.minimum_education");
				errors.add("position.requirements.error.minimum_education", error);
			}
			if (Utils.isBlankOrNull(form.getMinimumExperience())) {
				ActionError error = new ActionError("position.requirements.error.minimum_experience");
				errors.add("position.requirements.error.minimum_experience", error);
			}
			if (Utils.isBlankOrNull(form.getMaximumExperience())) {
				ActionError error = new ActionError("position.requirements.error.maximum_experience");
				errors.add("position.requirements.error.maximum_experience", error);
			}
			if (Utils.isBlankOrNull(form.getPrimarySkills())) {
				ActionError error = new ActionError("position.requirements.error.primary_skills");
				errors.add("position.requirements.error.primary_skills", error);
			}
		}

		if (!Utils.isBlankOrNull(form.getMinimumExperience())) {
			try {
				minimumExperience = new Float(form.getMinimumExperience());
			} catch (NumberFormatException e) {
				ActionError error = new ActionError("position.requirements.error.minimum_experience.invalid");
				errors.add("position.requirements.error.minimum_experience.invalid", error);
			}
		}
		if (!Utils.isBlankOrNull(form.getMaximumExperience())) {
			try {
				maximumExperience = new Float(form.getMaximumExperience());
			} catch (NumberFormatException e) {
				ActionError error = new ActionError("position.requirements.error.maximum_experience.invalid");
				errors.add("position.requirements.error.maximum_experience.invalid", error);
			}
		}
		if (maximumExperience != null && minimumExperience != null) {
			if (maximumExperience.floatValue() < minimumExperience.floatValue()) {
				ActionError error = new ActionError("position.requirements.error.minimum_experience.invalid");
				errors.add("position.requirements.error.minimum_experience.invalid", error);

				error = new ActionError("position.requirements.error.maximum_experience.invalid");
				errors.add("position.requirements.error.maximum_experience.invalid", error);
			}
		}
		return errors;
	}

	public ActionForward hiringProcess(ActionMapping mapping, ActionForm actionForm, HttpServletRequest request,
			HttpServletResponse response) throws Exception {
		if (!SessionManager.validateSession(mapping, actionForm, request, response, this)) {
			return null;
		}
		String forward = "hiringProcess";
		String userId = (String) request.getSession().getAttribute("userId");
		String userRoleId = (String) request.getSession().getAttribute("userRoles");
		PositionForm form = (PositionForm) actionForm;
		String positionId = form.getPositionId();
		String dir = form.getDir();

		Integer[] permissions = new Integer[2];
		permissions[0] = PermissionConstants.PERMISSION_POSITIONS;
		if (Utils.isBlankOrNull(dir) || PositionConstants.DIR_VIEW_POSITION.equalsIgnoreCase(dir)) {
			permissions[1] = PermissionConstants.PERMISSION_POSITION_DETAILS;
		} else if (PositionConstants.DIR_EDIT_POSITION.equalsIgnoreCase(dir)) {
			if (PositionConstants.POSITION_STATUS_TEMPLATE.equals(form.getPositionStatus())) {
				permissions[1] = PermissionConstants.PERMISSION_CREATE_POSITION_TEMPLATE;
			} else {
				permissions[1] = PermissionConstants.PERMISSION_EDIT_POSITIONS;
			}
		} else if (PositionConstants.DIR_ADD_POSITION.equalsIgnoreCase(dir)) {
			permissions[1] = PermissionConstants.PERMISSION_EDIT_POSITIONS;
		}
		String validPositionId = "";
		if (Utils.isBlankOrNull(dir) && !PositionConstants.DIR_ADD_POSITION.equalsIgnoreCase(dir)) {
			validPositionId = positionId;
		}
		if (!isUserAuthorized(request, CommonConstants.NO_MODULE, permissions, null, validPositionId, null)) {
			forward = getAuthorizationFailureForward();
			return mapping.findForward(forward);
		}

		try {
			PositionManager positionManager = new PositionManager();
			if (PositionConstants.DIR_ADD_POSITION.equalsIgnoreCase(dir)) {
				// Add new position.
				form.setDir(PositionConstants.DIR_ADD_POSITION);

				SimpleDataObject position = (SimpleDataObject) request.getSession(false).getAttribute(positionId);
				List steps = (List) position.getAttribute("steps");
				if (steps == null || steps.size() == 0) {
					// Get default step.
					steps = positionManager.getDefaultStepsTobeAdded();
				}
				position.setAttribute("steps", steps);
				form.setCopyFrom(PositionConstants.LIST_POSITIONS);
				populateHiringProcessPage(form, steps, userId, userRoleId);

			} else if (Utils.isBlankOrNull(dir) || PositionConstants.DIR_VIEW_POSITION.equalsIgnoreCase(dir)) {
				// View position hiring process.
				form.setDir(PositionConstants.DIR_VIEW_POSITION);

				List hiringProcess = positionManager.getPositionHiringProcessToView(positionId);
				form.setHiringProcess(hiringProcess);
			} else if (PositionConstants.DIR_EDIT_POSITION.equalsIgnoreCase(dir)) {
				// Edit position hiring process.
				form.setDir(PositionConstants.DIR_EDIT_POSITION);

				List hiringProcess = positionManager.getPositionHiringProcessToEdit(positionId);
				form.setCopyFrom(PositionConstants.LIST_POSITIONS);
				populateHiringProcessPage(form, hiringProcess, userId, userRoleId);
			}

			if (request.getSession(false).getAttribute(positionId) == null) {
				SimpleDataObject sdo1 = positionManager.getPositionCodeAndName(form.getPositionId());
				request.setAttribute("positionCode", sdo1.getString("positionCode"));
				request.setAttribute("positionName", sdo1.getString("positionName"));
			}
		} catch (Exception e) {
			TPLogger.getLogger().error("Error in hiring process", e);
		}
		form.setStep(NavigationConstants.STEP_POSITION_HIRING_PROCESS);
		request.setAttribute("t", NavigationConstants.T_POSITIONS);
		request.setAttribute("requisitionManagement", PositionConstants.REQUISITION_MANAGEMENT_ENABLED);
		setMigrationStatus(request);
		return mapping.findForward(forward);
	}

	public ActionForward showStepPopup(ActionMapping mapping, ActionForm actionForm, HttpServletRequest request,
			HttpServletResponse response) throws Exception {
		if (!SessionManager.validateSession(mapping, actionForm, request, response, this)) {
			return null;
		}
		String forward = "showStepPopup";
		String stepIndex = request.getParameter("stepIndex");
		String positionId = request.getParameter("positionId");
		request.setAttribute("stepIndex", stepIndex);
		PositionManager positionManager = new PositionManager();
		if (request.getSession(false).getAttribute(positionId) == null) {
			String positionTitle = positionManager.getPositionTitle(positionId);
			request.setAttribute("positionTitle", positionTitle);
		}

		StepManager stepManager = new StepManager();
		List<MasterStepData> steps = stepManager.getAllSteps(StepConstants.FALSE);
		Map<String, Object> schedulableMap = new LinkedHashMap<String, Object>();

		for (int i = 0; steps != null && i < steps.size(); i++) {
			MasterStepData stepData = steps.get(i);
			schedulableMap.put(stepData.getStepId(), stepData.getStepSchedulable());
		}

		String jsArrayForMap = CommonUtils.getJSArrayForMap(schedulableMap);

		request.setAttribute("map", jsArrayForMap);
		return mapping.findForward(forward);
	}

	public ActionForward getFeedbackFormsListInXML(ActionMapping mapping, ActionForm actionForm,
			HttpServletRequest request, HttpServletResponse response) {
		String forward = "xmlFile";
		String xmlFile = "";
		try {
			if (!SessionManager.isLoginFound(mapping, actionForm, request, response, this)) {
				xmlFile = Utils.getXMLForSessionExpiry();
			} else {
				FeedbackFormManager feedbackFormManager = new FeedbackFormManager();
				ArrayList<FeedbackFormData> feedbackForms = feedbackFormManager.getActiveFeedbackForms();
				ArrayList<String> feedbackFormIds = new ArrayList<String>();
				ArrayList<String> feedbackFormNames = new ArrayList<String>();
				feedbackFormIds.add("-1");
				feedbackFormNames.add(TPLabels.getLabel("position.hiring_process.label.select_feedback_form"));
				for (int i = 0; feedbackForms != null && i < feedbackForms.size(); i++) {
					FeedbackFormData feedbackFormData = feedbackForms.get(i);
					feedbackFormIds.add(feedbackFormData.getFeedbackFormId());
					feedbackFormNames.add(feedbackFormData.getFeedbackFormTitle());
				}
				String jsArray = CommonUtils.getListJavaScriptArray(feedbackFormIds, feedbackFormNames);

				xmlFile = Utils.getXMLForTagName("forms", jsArray);
			}
		} catch (Exception e) {
			xmlFile = Utils.getXMLForError(null);
		}

		request.setAttribute("xmlFile", xmlFile);
		return mapping.findForward(forward);
	}

	public ActionForward isChangeInStepRankPossible(ActionMapping mapping, ActionForm actionForm,
			HttpServletRequest request, HttpServletResponse response) {
		String forward = "xmlFile";
		String xmlFile = "";
		try {
			if (!SessionManager.isLoginFound(mapping, actionForm, request, response, this)) {
				xmlFile = Utils.getXMLForSessionExpiry();
			} else {
				String stepId1 = request.getParameter("stepId1");
				String stepId2 = request.getParameter("stepId2");

				String stepRank1 = request.getParameter("stepRank1");
				String stepRank2 = request.getParameter("stepRank2");
				PositionManager positionManager = new PositionManager();

				int inProcessCandidates1 = positionManager.getNoOfCandidatesInProcessForStep(stepId1);
				int inProcessCandidates2 = positionManager.getNoOfCandidatesInProcessForStep(stepId2);
				if (inProcessCandidates1 != 0 || inProcessCandidates2 != 0) {
					List<String> errors = new ArrayList<String>();
					errors.add(TPLabels.getLabel("position.hiring_process.step.error.change_rank"));
					xmlFile = Utils.getXMLForError(errors);
				} else {
					positionManager.changePositionStepRank(stepId1, stepRank1, stepId2, stepRank2);
				}
			}
		} catch (Exception e) {
			TPLogger.getLogger().error("Error determining whether it is possible to change step rank or not", e);
			List<String> errors = new ArrayList<String>();
			errors.add(TPLabels.getLabel("position.hiring_process.step.error.change_rank_failed"));
			xmlFile = Utils.getXMLForError(errors);
		}

		request.setAttribute("xmlFile", xmlFile);
		return mapping.findForward(forward);
	}

	public ActionForward isDeleteStepPossible(ActionMapping mapping, ActionForm actionForm, HttpServletRequest request,
			HttpServletResponse response) {
		String forward = "xmlFile";
		String xmlFile = "";
		try {
			if (!SessionManager.isLoginFound(mapping, actionForm, request, response, this)) {
				xmlFile = Utils.getXMLForSessionExpiry();
			} else {
				String userId = (String) request.getSession(false).getAttribute("userId");
				String stepId = request.getParameter("stepId");
				String stepRank = request.getParameter("stepRank");
				String positionId = request.getParameter("positionId");
				PositionManager positionManager = new PositionManager();
				Integer[] permissions = new Integer[2];
				permissions[0] = PermissionConstants.PERMISSION_POSITIONS;
				permissions[1] = PermissionConstants.PERMISSION_EDIT_POSITIONS;
				if (!isUserAuthorized(request, CommonConstants.NO_MODULE, permissions, null, positionId, null)) {
					forward = getAuthorizationFailureForward();
					return mapping.findForward(forward);
				}
				int inProcessCandidates = positionManager.getNoOfCandidatesInProcessForStep(stepId);
				if (inProcessCandidates != 0) {
					List<String> errors = new ArrayList<String>();
					errors.add(TPLabels.getLabel("position.hiring_process.step.error.can_not_delete_step"));
					xmlFile = Utils.getXMLForError(errors);
				} else {
					positionManager.deletePositionStep(stepId, stepRank, positionId);
					AuditAction auditAction = new AuditAction();
					String clientIpAddr = getClientIpAddr(request);
					auditAction.insertAuditInfo(TPLabels.getLabel("common.position"), AuditConstants.TYPE_MODIFIED,
							positionId, AuditConstants.AUDIT_POSITION, userId, null, null, null, true, clientIpAddr);
				}
			}
		} catch (Exception e) {
			TPLogger.getLogger().error(
					"Error while determining whether it is possible to change step rank or not and if possible delete the step",
					e);
			List<String> errors = new ArrayList<String>();
			errors.add(TPLabels.getLabel("position.hiring_process.step.error.delete_step"));
			xmlFile = Utils.getXMLForError(errors);
		}

		request.setAttribute("xmlFile", xmlFile);
		return mapping.findForward(forward);
	}

	public ActionForward isChangeFeedbackFormPossible(ActionMapping mapping, ActionForm actionForm,
			HttpServletRequest request, HttpServletResponse response) throws Exception {
		if (!SessionManager.validateSession(mapping, actionForm, request, response, this)) {
			return null;
		}
		String forward = "xmlFile";
		String xmlFile = "";
		try {
			if (!SessionManager.isLoginFound(mapping, actionForm, request, response, this)) {
				xmlFile = Utils.getXMLForSessionExpiry();
			} else {
				PositionForm positionForm = (PositionForm) actionForm;

				PositionManager positionManager = new PositionManager();
				boolean formHassubmittedFeedback = positionManager
						.isFeedbackFormHaveResponse(positionForm.getFeedbackFormId(), positionForm.getPositionStepId());
				if (formHassubmittedFeedback) {
					xmlFile = Utils.getXMLForError(null);
				}
			}
		} catch (Exception e) {
			TPLogger.getLogger().error("Error", e);
			xmlFile = Utils.getXMLForError(null);
		}
		request.setAttribute("xmlFile", xmlFile);
		return mapping.findForward(forward);
	}

	public ActionForward savePositionStep(ActionMapping mapping, ActionForm actionForm, HttpServletRequest request,
			HttpServletResponse response) {
		String forward = "xmlFile";
		String xmlFile = new String();
		if (!SessionManager.isLoginFound(mapping, actionForm, request, response, this)) {
			xmlFile = Utils.getXMLForSessionExpiry();
			request.setAttribute("xmlFile", xmlFile);
			return mapping.findForward(forward);
		}
		PositionForm form = (PositionForm) actionForm;
		String positionId = form.getPositionId();
		String userId = (String) request.getSession().getAttribute("userId");
		AuditAction auditAction = new AuditAction();
		Integer[] permissions = new Integer[2];
		permissions[0] = PermissionConstants.PERMISSION_POSITIONS;
		permissions[1] = PermissionConstants.PERMISSION_EDIT_POSITIONS;
		if (!isUserAuthorized(request, CommonConstants.NO_MODULE, permissions, null, positionId, null)) {
			forward = getAuthorizationFailureForward();
			return mapping.findForward(forward);
		}
		try {
			List<SimpleDataObject> steps = parseJSArraySteps(form.getJsArrayHiringProcess(), positionId);
			SimpleDataObject object = (SimpleDataObject) steps.get(0);
			PositionManager positionManager = new PositionManager();

			SimpleDataObject oldStepData = new SimpleDataObject();
			if (object.getInt("stepId") != 0) {
				List positionStepUsers = positionManager.getPositionStepUsers(object.getString("stepId"));
				for (Object object2 : positionStepUsers) {
					SimpleDataObject stepUsers = (SimpleDataObject) object2;
					if (stepUsers.getInt("isResponsibleForScheduling") == PositionConstants.STEP_NOT_SCHEDULED) {
						if (stepUsers.getInt("isAuthorizedToMove") == PositionConstants.NOT_AUTHORIZED_TO_MOVE) {
							oldStepData.setAttribute("assignedTo", stepUsers.getString("userNames"));
						} else {
							oldStepData.setAttribute("decisionMaker", stepUsers.getString("userNames"));
						}
					} else {
						oldStepData.setAttribute("scheduledBy", stepUsers.getString("userNames"));
					}
				}
			}
			positionManager.addOrUpdatePositionStep(object);
			String clientIpAddr = getClientIpAddr(request);
			auditAction.insertAuditInfo(TPLabels.getLabel("common.position"), AuditConstants.TYPE_MODIFIED, positionId,
					AuditConstants.AUDIT_POSITION, userId, null, null, null, true, clientIpAddr);
			if (GlobalConstants.ENABLED.equals(form.getSendPositionChangeNotification())) {
				positionManager.sendPositionChangeNotification(object.getString("positionId"),
						object.getString("stepId"), oldStepData, PositionConstants.MODE_HIRING_PROCESS, userId);
			}
			xmlFile = Utils.getXMLForIds(object.getString("stepId"));
		} catch (MasterExistException e) {
			TPLogger.getLogger().error(GlobalConstants.ERROR, e);
			List<String> errors = new ArrayList<String>();
			errors.add(TPLabels.getLabel("position.hiring_process.error.duplicate_step"));
			xmlFile = Utils.getXMLForError(errors);
		} catch (Exception e) {
			TPLogger.getLogger().error("Error while saving position step", e);
			List<String> errors = new ArrayList<String>();
			errors.add(TPLabels.getLabel("position.hiring_process.error.save_position_step") + " "
					+ TPLabels.getLabel("common.position_step") + " " + TPLabels.getLabel("common.please_try_again"));
			xmlFile = Utils.getXMLForError(errors);
		}
		request.setAttribute("xmlFile", xmlFile);
		return mapping.findForward(forward);
	}

	private ActionErrors validateHiringProcess(PositionForm form, List<SimpleDataObject> steps) {
		ActionErrors errors = new ActionErrors();
		if (!form.getPositionStatus().equals(PositionConstants.POSITION_STATUS_TEMPLATE)) {
			if (steps == null) {
				ActionError error = new ActionError("position.hiring_process.error.enter_process");
				errors.add("position.hiring_process.error.enter_process", error);
			} else if (steps.size() == 1) {
				ActionError error = new ActionError("position.hiring_process.error.enter_process");
				errors.add("position.hiring_process.error.enter_process", error);
			}
		}
		return errors;
	}

	private List<SimpleDataObject> parseJSArraySteps(String jsArray, String positionId) {
		List<SimpleDataObject> steps = new ArrayList<SimpleDataObject>();
		if (!Utils.isBlankOrNull(jsArray)) {
			String[] _steps = jsArray.split(",");
			if (_steps != null && _steps.length > 0) {
				for (int i = 0; i < _steps.length; i++) {
					String _step = _steps[i];
					if (!Utils.isBlankOrNull(_step)) {
						String[] attributes = _step.split("[|]");
						if (attributes != null && attributes.length > 0) {
							SimpleDataObject sDo = new SimpleDataObject();
							sDo.setAttribute("positionId", positionId);
							sDo.setAttribute("stepId", Utils.getFormattedRecord(attributes[0]).trim());
							String stepMasterId = Utils.getFormattedRecord(attributes[18]).trim();
							StepManager stepManager = new StepManager();
							String stepTitle = null;
							try {
								stepTitle = stepManager.getStepNameForStepId(stepMasterId);
							} catch (SQLException e) {
								TPLogger.getLogger().error(GlobalConstants.ERROR, e);
							}
							sDo.setAttribute("stepTitle", Utils.getFormattedRecord(stepTitle).trim());
							sDo.setAttribute("isDefault", Utils.getFormattedRecord(attributes[2]).trim());
							sDo.setAttribute("assignedTo", Utils.getFormattedRecord(attributes[3]).trim());
							sDo.setAttribute("isScheduled", Utils.getFormattedRecord(attributes[4]).trim());
							sDo.setAttribute("scheduledBy", Utils.getFormattedRecord(attributes[5]).trim());
							sDo.setAttribute("isInterviewerCanConfirm", Utils.getFormattedRecord(attributes[6]).trim());
							sDo.setAttribute("isOptional", Utils.getFormattedRecord(attributes[7]).trim());
							sDo.setAttribute("stepLevel", Utils.getFormattedRecord(attributes[8]).trim());
							sDo.setAttribute("feedbackFormId", Utils.getFormattedRecord(attributes[9]).trim());
							List<SimpleDataObject> mesages = new ArrayList<SimpleDataObject>();
							if (!Utils.isBlankOrNull(attributes[10])) {
								String[] _messages = attributes[10].split(":");
								if (_messages != null && _messages.length > 0) {
									for (int k = 0; k < _messages.length; k++) {
										if (!Utils.isBlankOrNull(_messages[k])) {
											String[] mAttributes = _messages[k].split("_");
											SimpleDataObject obj = new SimpleDataObject();
											obj.setAttribute("messageId",
													Utils.getFormattedRecord(mAttributes[0]).trim());
											obj.setAttribute("message",
													Utils.getFormattedRecord(mAttributes[1]).trim());
											obj.setAttribute("isDefault",
													Utils.getFormattedRecord(mAttributes[2]).trim());
											mesages.add(obj);
										}
									}
								}
							}
							sDo.setAttribute("messages", mesages);

							// check for correct index
							PositionManager pm = new PositionManager();
							String stepRank = null;
							try {
								stepRank = pm.getHiringProcessStepRank(positionId, stepMasterId);
							} catch (Exception e) {
								TPLogger.getLogger().error(GlobalConstants.ERROR, e);
							}

							sDo.setAttribute("stepRank", stepRank);
							sDo.setAttribute("decisionMaker", Utils.getFormattedRecord(attributes[12]).trim());
							sDo.setAttribute("isDecisionMakerSameAsAssignedTo",
									Utils.getFormattedRecord(attributes[13]).trim());
							sDo.setAttribute("isNotifyToCandidate", Utils.getFormattedRecord(attributes[14]).trim());
							sDo.setAttribute("assignedToUsers", Utils.getFormattedRecord(attributes[15]).trim());
							sDo.setAttribute("scheduledByUsers", Utils.getFormattedRecord(attributes[16]).trim());
							sDo.setAttribute("decisionMakerUsers", Utils.getFormattedRecord(attributes[17]).trim());
							sDo.setAttribute("stepMasterId", Utils.getFormattedRecord(attributes[18]).trim());
							steps.add(sDo);
						}
					}
				}
			}
		}
		return steps;
	}

	public ActionForward approval(ActionMapping mapping, ActionForm actionForm, HttpServletRequest request,
			HttpServletResponse response) throws Exception {
		if (!SessionManager.validateSession(mapping, actionForm, request, response, this)) {
			return null;
		}
		String forward = "approval";
		String userId = (String) request.getSession().getAttribute("userId");
		PositionForm form = (PositionForm) actionForm;
		String positionId = form.getPositionId();
		String dir = form.getDir();

		Integer[] permissions = new Integer[1];
		permissions[0] = PermissionConstants.PERMISSION_POSITIONS;
		String validPositionId = "";
		if (Utils.isBlankOrNull(dir) && !PositionConstants.DIR_ADD_POSITION.equalsIgnoreCase(dir)) {
			validPositionId = positionId;
		}
		if (!isUserAuthorized(request, CommonConstants.NO_MODULE, permissions, null, validPositionId, null)) {
			forward = getAuthorizationFailureForward();
			return mapping.findForward(forward);
		}

		PositionManager positionManager = new PositionManager();
		if (PositionConstants.DIR_ADD_POSITION.equalsIgnoreCase(dir)
				|| PositionConstants.DIR_COPY_POSITION.equalsIgnoreCase(dir)) {
			// Add new position.
			SimpleDataObject position = (SimpleDataObject) request.getSession(false).getAttribute(positionId);
			RequisitionManager requisitionManager = new RequisitionManager();
			boolean isRequisitionApprovalTemplateChosen = false;

			ArrayList<SimpleDataObject> requisitionApprovalTemplates = requisitionManager
					.getUserRequisitionApprovalTemplates(userId);
			String jsArrayRequisitionApprovalTemplates = CommonUtils
					.getListJavaScriptArrayWithProperties(requisitionApprovalTemplates, "templateId", "templateName");
			request.setAttribute("jsArrayRequisitionApprovalTemplates", jsArrayRequisitionApprovalTemplates);

			if (!Utils.isBlankOrNull(position.getString("notifyUserIds"))) {
				form.setNotifyUserIds(position.getString("notifyUserIds"));
			}
			if (!Utils.isBlankOrNull(position.getString("approvalUserIds"))) {
				form.setApprovalUserIds(position.getString("approvalUserIds"));
			}

			if (Utils.isBlankOrNull(position.getString("requisitionApprovalTemplateId"))) {
				if (requisitionApprovalTemplates != null) {
					if (requisitionApprovalTemplates.size() == 1) {
						isRequisitionApprovalTemplateChosen = true;
						position.setAttribute("requisitionApprovalTemplateId",
								requisitionApprovalTemplates.get(0).getString("templateId"));
						position.setAttribute("requisitionApprovalTemplateName",
								requisitionApprovalTemplates.get(0).getString("templateName"));
						request.removeAttribute("jsArrayRequisitionApprovalTemplates");
					}
				}
			} else {
				if (requisitionApprovalTemplates.size() == 1) {
					request.removeAttribute("jsArrayRequisitionApprovalTemplates");
				}
				for (SimpleDataObject template : requisitionApprovalTemplates) {
					if (position.getString("requisitionApprovalTemplateId").equals(template.getString("templateId"))) {
						position.setAttribute("requisitionApprovalTemplateName", template.getString("templateName"));
						break;
					}
				}
				isRequisitionApprovalTemplateChosen = true;
			}
			if (isRequisitionApprovalTemplateChosen) {
				RequisitionApprovalStepData requisitionApprovalFirstStepData = requisitionManager
						.getFirstRequisitionApprovalStepDataForUser(userId,
								position.getString("requisitionApprovalTemplateId"));
				int rank = 2;
				if (requisitionApprovalFirstStepData != null) {
					form.setFromApprovalStepId("" + requisitionApprovalFirstStepData.getRequisitionApprovalStepId());
					form.setToApprovalStepId("");
					rank = requisitionApprovalFirstStepData.getRequisitionApprovalStepRank();
				}
				RequisitionApprovalStepData requisitionApprovalNextStepData = null;
				// requisitionManager.getNextRequisitionApprovalStepDataForUser(userId);
				if (requisitionApprovalFirstStepData != null) {
					requisitionApprovalNextStepData = requisitionManager.getNextActiveRequisitionStepData(
							"" + requisitionApprovalFirstStepData.getRequisitionApprovalStepId(), rank,
							position.getString("requisitionApprovalTemplateId"));
				}
				if (requisitionApprovalNextStepData != null) {
					form.setToApprovalStepId("" + requisitionApprovalNextStepData.getRequisitionApprovalStepId());
					ArrayList<LoginData> users = requisitionApprovalNextStepData.getUsers();
					String jsArrayApprovers = UserUtils.getListJavaScriptArray(users);
					request.setAttribute("jsArrayApprovers", jsArrayApprovers);
				}
			}
			populatePositionApprovalOnForm(form, position);
		} else if (Utils.isBlankOrNull(dir) || PositionConstants.DIR_VIEW_POSITION.equalsIgnoreCase(dir)) {
			// View position approval history
			// Get position current status
			SimpleDataObject sdo = positionManager.getPositionActionRequired(positionId);
			String currentStatus = getPositionCurrentStatusString(sdo);
			RequisitionFeedbackManager requisitionFeedbackManager = new RequisitionFeedbackManager();
			RequisitionFeedbackData requisitionFeedbackData = requisitionFeedbackManager.isFeedbackPending(positionId,
					userId);
			request.setAttribute("currentStatus", currentStatus);
			request.setAttribute("requisitionFeedbackId",
					(requisitionFeedbackData == null) ? "" : requisitionFeedbackData.getFeedbackId());
			form.setDir(PositionConstants.DIR_VIEW_POSITION);
			forward = "approvalHistory";
		}

		if (request.getSession(false).getAttribute(positionId) == null) {
			SimpleDataObject sdo1 = positionManager.getPositionCodeAndName(form.getPositionId());
			request.setAttribute("positionCode", sdo1.getString("positionCode"));
			request.setAttribute("positionName", sdo1.getString("positionName"));
		}

		if (!Utils.isBlankOrNull(form.getApprovalUserIds())
				&& (Utils.isBlankOrNull(form.getNextUserId()) || !form.getNextUserId().equals("-1"))) {
			form.setNextUserId(form.getApprovalUserIds());
		}

		form.setStep(NavigationConstants.STEP_POSITION_APPROVAL);
		request.setAttribute("t", NavigationConstants.T_POSITIONS);
		request.setAttribute("requisitionManagement", PositionConstants.REQUISITION_MANAGEMENT_ENABLED);
		return mapping.findForward(forward);

	}

	private String getPositionCurrentStatusString(SimpleDataObject sdo) {
		String currentStatus = "";
		if (sdo != null) {
			String positionStatus = sdo.getString("positionStatus");
			String requisitionStepName = sdo.getString("requisitionStepName");
			String feedbackDecision = sdo.getString("feedbackDecision");
			if (positionStatus.equals(PositionConstants.POSITION_STATUS_INPROCESS)) {
				if (feedbackDecision.equals(RequisitionConstants.FEEDBACK_ACTION_HOLD)) {
					currentStatus = TPLabels.getLabel("position.approval.label.onhold");
				} else if (Utils.isBlankOrNull(requisitionStepName)) {
					currentStatus = TPLabels.getLabel("position.approval.label.approved");
				} else {
					currentStatus = TPLabels.getLabel("position.approval.label.awaiting") + " " + requisitionStepName;
				}
			} else if (positionStatus.equals(PositionConstants.POSITION_STATUS_REJECTED)) {
				currentStatus = TPLabels.getLabel("position.approval.label.rejected");
			} else if (positionStatus.equals(PositionConstants.POSITION_STATUS_OPENED)) {
				currentStatus = TPLabels.getLabel("position.approval.label.open");
			} else if (positionStatus.equals(PositionConstants.POSITION_STATUS_CLOSED)) {
				currentStatus = TPLabels.getLabel("position.approval.label.closed");
			}
		}
		return currentStatus;

	}

	private void populatePositionApprovalOnForm(PositionForm form, SimpleDataObject position) {
		form.setFeedbackDecision(Utils.isBlankOrNull(position.getString("approvalDecision"))
				? RequisitionConstants.FEEDBACK_ACTION_APPROVE : position.getString("approvalDecision"));
		form.setNextUserId(position.getString("nextUserId"));
		form.setFeedbackComment(position.getString("approvalComment"));
		form.setRequisitionApprovalTemplateId(position.getString("requisitionApprovalTemplateId"));
		form.setRequisitionApprovalTemplateName(position.getString("requisitionApprovalTemplateName"));
		form.setNotifyUserIds(position.getString("notifyUserIds"));
	}

	private void populatePositionApprovalInObject(PositionForm form, SimpleDataObject position) {
		position.setAttribute("approvalDecision", form.getFeedbackDecision());
		if (form.getFeedbackDecision().equals(RequisitionConstants.FEEDBACK_ACTION_APPROVE)) {
			position.setAttribute("nextUserId", form.getNextUserId());
		} else {
			position.setAttribute("nextUserId", "");
		}
		position.setAttribute("approvalComment", form.getFeedbackComment());
		position.setAttribute("fromApprovalStepId", form.getFromApprovalStepId());
		position.setAttribute("toApprovalStepId", form.getToApprovalStepId());
		position.setAttribute("requisitionApprovalTemplateId", form.getRequisitionApprovalTemplateId());
		position.setAttribute("notifyUserIds", form.getNotifyUserIds());
		position.setAttribute("approvalUserIds", form.getNextUserId());
	}

	private ActionErrors validateApproval(PositionForm form, String userId, String approvalDecision,
			String nextUserId) {
		ActionErrors errors = new ActionErrors();
		if (!form.getPositionStatus().equals(PositionConstants.POSITION_STATUS_TEMPLATE)) {
			if (Utils.isBlankOrNull(approvalDecision)) {
				errors.add("requisition_approval_feedback.error.select_action",
						new ActionError("requisition_approval_feedback.error.select_action"));
			} else if (approvalDecision.equals(RequisitionConstants.FEEDBACK_ACTION_APPROVE)) {
				if ("-1".equals(nextUserId)) {
					errors.add("requisition_approval_feedback.error.select_user",
							new ActionError("requisition_approval_feedback.error.select_user"));
				}
			}
		}
		return errors;
	}

	public ActionForward getApprovalHistory(ActionMapping mapping, ActionForm actionForm, HttpServletRequest request,
			HttpServletResponse response) throws Exception {
		String forward = "xmlFile";
		String xmlFile = "";
		try {
			if (!SessionManager.isLoginFound(mapping, actionForm, request, response, this)) {
				xmlFile = Utils.getXMLForSessionExpiry();
			} else {
				String userId = (String) request.getSession(false).getAttribute("userId");
				PermissionSet permissionSet = (PermissionSet) request.getSession(false).getAttribute("permissionSet");
				PositionForm positionForm = (PositionForm) actionForm;
				RequisitionFeedbackManager requisitionFeedbackManager = new RequisitionFeedbackManager();
				ArrayList<RequisitionFeedbackData> history = requisitionFeedbackManager
						.getPositionApprovalHistory(positionForm.getPositionId());
				PositionXMLGenerator positionXMLGenerator = new PositionXMLGenerator();
				PositionManager positionManager = new PositionManager();
				int noOfCandidates = positionManager.getNoOfCandidatesProcessed(positionForm.getPositionId());
				boolean editAllowed = (noOfCandidates > 0) ? false : true;
				xmlFile = positionXMLGenerator.getRequisitionApprovalHistoryXML(history, userId, editAllowed,
						permissionSet);
			}
		} catch (Exception e) {
			TPLogger.getLogger().error("Error in copyResponsibilities:", e);
		}
		request.setAttribute("xmlFile", xmlFile);
		return mapping.findForward(forward);
	}

	public ActionForward deleteApprovalFeedback(ActionMapping mapping, ActionForm actionForm,
			HttpServletRequest request, HttpServletResponse response) throws Exception {
		if (!SessionManager.validateSession(mapping, actionForm, request, response, this)) {
			return null;
		}
		ActionErrors errors = new ActionErrors();
		try {
			String userId = (String) request.getSession().getAttribute("userId");
			PositionForm form = (PositionForm) actionForm;
			String feedbackId = form.getFeedbackId();
			String positionId = form.getPositionId();
			Integer[] permissions = new Integer[1];
			permissions[0] = PermissionConstants.PERMISSION_POSITIONS;
			if (!isUserAuthorized(request, CommonConstants.NO_MODULE, permissions, null, positionId, null)) {
				return mapping.findForward(getAuthorizationFailureForward());
			}
			RequisitionFeedbackManager requisitionFeedbackManager = new RequisitionFeedbackManager();
			RequisitionFeedbackData requisitionFeedbackData = requisitionFeedbackManager
					.getLastRequisitionFeedbackDataForPosition(positionId);
			boolean deleteAllowed = false;
			if (requisitionFeedbackData != null) {
				if (requisitionFeedbackData.getFeedbackId().equals(feedbackId)) {
					PositionManager positionManager = new PositionManager();
					int noOfCandidates = positionManager.getNoOfCandidatesProcessed(positionId);
					if (noOfCandidates == 0) {
						deleteAllowed = true;
					}
				}
			}
			if (deleteAllowed) {
				requisitionFeedbackManager.deleteFeedback(feedbackId, positionId, userId);
				// if deleted then regenerate todo for that position
				ToDoManager toDoManager = new ToDoManager();
				toDoManager.regenerateToDo(positionId, null, null);
			} else {
				errors.add("position.approval_summary.error.delete_not_allowed",
						new ActionError("position.approval_summary.error.delete_not_allowed"));
			}

		} catch (Exception e) {
			TPLogger.getLogger().error("Error while deleting feedback");
			errors.add("position.approval_summary.error.delete_not_allowed",
					new ActionError("position.approval_summary.error.delete_not_allowed"));
		}
		saveErrors(request, errors);
		return approval(mapping, actionForm, request, response);

	}

	public ActionForward addPosition(ActionMapping mapping, ActionForm actionForm, HttpServletRequest request,
			HttpServletResponse response) throws Exception {
		String forward = "hiringProcess";

		Integer[] permissions = new Integer[1];
		permissions[0] = PermissionConstants.PERMISSION_POSITIONS;
		if (!isUserAuthorized(request, CommonConstants.NO_MODULE, permissions, null, null, null)) {
			forward = getAuthorizationFailureForward();
			return mapping.findForward(forward);
		}

		String userId = (String) request.getSession(false).getAttribute("userId");
		String userRoleId = (String) request.getSession(false).getAttribute("userRoles");

		PositionForm form = (PositionForm) actionForm;
		String positionId = form.getPositionId();
		String step = form.getStep();

		ActionErrors errors = new ActionErrors();

		PositionManager positionManager = null;
		try {
			positionManager = new PositionManager();

			if (NavigationConstants.STEP_POSITION_DESCRIPTION.equalsIgnoreCase(step)) {
				ArrayList<CustomFieldData> customFields = null;
				CustomFieldDataProcessor customFieldDataProcessor = new CustomFieldDataProcessor();
				if (CustomFieldManager.isCustomFieldsAvailable(CustomFieldConstants.ENTITY_TYPE_POSITION)) {
					CustomFieldManager customFieldManager = new CustomFieldManager();
					customFields = customFieldManager.getCustomFieldsForInputAllowed(
							CustomFieldConstants.ENTITY_TYPE_POSITION, CustomFieldConstants.INPUT_ALLOWED, true);
					customFields = customFieldDataProcessor.setCustomFieldValuesFromRequest(request, customFields);
					request.setAttribute("customFields", customFields);
				}

				errors = validateDescription(form, customFields);
				// added for duplicate position detect and send email
				String fieldValueDataString = "";
				String duplicateRecord = form.getIgnoreDuplicate();
				if (Utils.isBlankOrNull(duplicateRecord)) {
					fieldValueDataString = checkForDuplicatePositionRecord(form.getPositionId(), form.getPositionName(),
							customFields);
					if (!Utils.isBlankOrNull(fieldValueDataString)) {
						if (GlobalConstants.ENABLED.equals(GlobalApplicationProperties.getProperty(
								GlobalConstants.PROPERTY_DUPLICATE_POSITION_ALERT_NOTIFICATION_TO_ADMIN))) {
							sendEmailForDuplicatePositionsCreation(
									TemplateConstants.TEMPLATE_TYPE_POSITION_DUPLICATE_ALERT_NOTIFICATION_TO_ADMIN,
									userId, fieldValueDataString);
						}
					}
				}
				// end of duplicate position detect

				if (errors == null || errors.size() == 0) {
					// Save position description.
					SimpleDataObject position = (SimpleDataObject) request.getSession(false).getAttribute(positionId);
					populatePositionDescriptionInObject(form, position);
					if (form.getPositionStatus().equals(PositionConstants.POSITION_STATUS_TEMPLATE)) {
						position.setAttribute("hireByDate",
								Utils.getDateConvertedToString(new Date(), Utils.regEUDateFormat));
						position.setAttribute("vacancies", "0");
					}
					position.setAttribute("customFields", customFields);
					form.setDir(PositionConstants.DIR_ADD_POSITION);
					form.setMode(PositionConstants.MODE_REQUIREMENTS);
					request.setAttribute("fieldValueData", fieldValueDataString);
					return requirements(mapping, actionForm, request, response);
				}

				if (errors != null && errors.size() > 0) {
					populateDescriptionPage(form, userId, userRoleId);
					form.setStep(NavigationConstants.STEP_POSITION_DESCRIPTION);
					form.setDir(PositionConstants.DIR_ADD_POSITION);
					saveErrors(request, errors);

					forward = "description";
				}
			} else if (NavigationConstants.STEP_POSITION_REQUIREMENTS.equalsIgnoreCase(step)) {
				errors = new ActionErrors();

				if (PositionConstants.DEST_HIRING_PROCESS.equalsIgnoreCase(form.getDest())
						|| PositionConstants.DEST_APPROVAL.equalsIgnoreCase(form.getDest())) {
					errors = validateRequirements(form);
				}
				if (errors == null || errors.size() == 0) {
					// Save position requirements.
					SimpleDataObject position = (SimpleDataObject) request.getSession(false).getAttribute(positionId);
					populatePositionRequirementsInObject(form, position);

					form.setDir(PositionConstants.DIR_ADD_POSITION);
					if (PositionConstants.DEST_DESCRIPTION.equalsIgnoreCase(form.getDest())) {
						return description(mapping, actionForm, request, response);
					} else if (PositionConstants.DEST_APPROVAL.equalsIgnoreCase(form.getDest())) {
						return approval(mapping, actionForm, request, response);
					} else if (PositionConstants.DEST_HIRING_PROCESS.equalsIgnoreCase(form.getDest())) {
						return hiringProcess(mapping, actionForm, request, response);
					}
				}

				if (errors != null && errors.size() > 0) {
					populateRequirementsPage(form, userId, userRoleId, request);
					form.setDir(PositionConstants.DIR_ADD_POSITION);
					form.setStep(NavigationConstants.STEP_POSITION_REQUIREMENTS);
					saveErrors(request, errors);

					forward = "requirements";
				}
			} else if (NavigationConstants.STEP_POSITION_HIRING_PROCESS.equalsIgnoreCase(step)) {

				List<SimpleDataObject> steps = parseJSArraySteps(form.getJsArrayHiringProcess(), positionId);
				errors = new ActionErrors();

				if (!PositionConstants.DEST_REQUIREMENTS.equalsIgnoreCase(form.getDest())
						&& !PositionConstants.DEST_APPROVAL.equalsIgnoreCase(form.getDest())) {
					errors = validateHiringProcess(form, steps);
				}
				if (errors == null || errors.size() == 0) {
					// Save position hiring process.
					SimpleDataObject position = (SimpleDataObject) request.getSession(false).getAttribute(positionId);
					position.setAttribute("steps", steps);

					form.setDir(PositionConstants.DIR_ADD_POSITION);
					if (PositionConstants.DEST_REQUIREMENTS.equalsIgnoreCase(form.getDest())) {
						return requirements(mapping, actionForm, request, response);
					} else if (PositionConstants.DEST_APPROVAL.equalsIgnoreCase(form.getDest())) {
						return approval(mapping, actionForm, request, response);
					} else {
						// Save the position.
						// Goto Positions Home Page.
						String pId = positionManager.getPositionIdFromPositionCode(position.getString("positionCode"));
						if (Utils.isBlankOrNull(pId)) {

							if (form.getPositionStatus().equals(PositionConstants.POSITION_STATUS_TEMPLATE)) {
								position.setAttribute("positionStatus", PositionConstants.POSITION_STATUS_TEMPLATE);
							} else {
								position.setAttribute("positionStatus", PositionConstants.POSITION_STATUS_OPENED);
							}
							position.setAttribute("draftId", form.getDraftId());
							positionManager.addNewPosition(position, form.getTrackModeNotifications(), userId, false);

							positionId = position.getString("positionId");

							if (!Utils.isBlankOrNull(position.getString("nextUserId"))
									&& !position.getString("nextUserId").equals("-1")) {
								if (!form.getPositionStatus().equals(PositionConstants.POSITION_STATUS_TEMPLATE)) {
									RequisitionFeedbackManager requisitionFeedbackManager = new RequisitionFeedbackManager();
									requisitionFeedbackManager.addFeedback(positionId,
											position.getString("fromApprovalStepId"),
											position.getString("toApprovalStepId"), userId,
											position.getString("nextUserId"), position.getString("approvalDecision"),
											position.getString("approvalComment"), position.getString("notifyUserIds"));
								}
							}
							if (form.getPositionStatus().equals(PositionConstants.POSITION_STATUS_TEMPLATE)) {
								return mapping.findForward("positionTemplatesHome");
							} else {

								RecentViewManager recentViewManager = new RecentViewManager();
								recentViewManager.addLastViewedEntry(positionId, UserConstants.ENTITY_POSITION, userId);

								form.setShowCondition(PositionConstants.POSITION_STATUS_OPENED);

								ToDoManager toDoManager = new ToDoManager();
								toDoManager.regenerateToDo(positionId, null, null);
								return mapping.findForward("positionsHome");
							}

						} else {
							errors.add("position.add_new.error.duplicate_code",
									new ActionError("position.add_new.error.duplicate_code",
											TPLabels.getLabel("common.position_code")));
						}

					}
				}

				if (errors != null && errors.size() > 0) {
					populateHiringProcessPage(form, steps, userId, userRoleId);
					form.setDir(PositionConstants.DIR_ADD_POSITION);
					saveErrors(request, errors);
					forward = "hiringProcess";
				}
			} else if (NavigationConstants.STEP_POSITION_APPROVAL.equalsIgnoreCase(step)) {
				errors = new ActionErrors();

				AuditAction auditAction = new AuditAction();

				if (!PositionConstants.DEST_REQUIREMENTS.equalsIgnoreCase(form.getDest())) {
					errors = validateApproval(form, userId, form.getFeedbackDecision(), form.getNextUserId());
				}
				if (errors == null || errors.size() == 0) {
					SimpleDataObject position = (SimpleDataObject) request.getSession(false).getAttribute(positionId);
					populatePositionApprovalInObject(form, position);
					form.setDir(PositionConstants.DIR_ADD_POSITION);
					if (PositionConstants.DEST_REQUIREMENTS.equalsIgnoreCase(form.getDest())) {
						return requirements(mapping, actionForm, request, response);
					} else if (PositionConstants.DEST_HIRING_PROCESS.equalsIgnoreCase(form.getDest())) {
						return hiringProcess(mapping, actionForm, request, response);
					} else {
						// Save the position.
						// Goto Positions Home Page.
						forward = "approval";
						String pId = positionManager.getPositionIdFromPositionCode(position.getString("positionCode"));
						if (Utils.isBlankOrNull(pId)) {

							if (form.getPositionStatus().equals(PositionConstants.POSITION_STATUS_TEMPLATE)) {
								position.setAttribute("positionStatus", PositionConstants.POSITION_STATUS_TEMPLATE);
							} else {
								position.setAttribute("positionStatus", PositionConstants.POSITION_STATUS_INPROCESS);
							}
							position.setAttribute("draftId", form.getDraftId());
							positionManager.addNewPosition(position, form.getTrackModeNotifications(), userId, true);
							positionId = position.getString("positionId");

							String clientIpAddr = getClientIpAddr(request);
							auditAction.insertAuditInfo(TPLabels.getLabel("common.position"), AuditConstants.TYPE_ADDED,
									positionId, AuditConstants.AUDIT_POSITION, userId, null, null, null, true,
									clientIpAddr);

							RequisitionFeedbackManager requisitionFeedbackManager = new RequisitionFeedbackManager();
							requisitionFeedbackManager.addFeedback(positionId, form.getFromApprovalStepId(),
									form.getToApprovalStepId(), userId, form.getNextUserId(),
									form.getFeedbackDecision(), form.getFeedbackComment(), form.getNotifyUserIds());

							RecentViewManager recentViewManager = new RecentViewManager();
							recentViewManager.addLastViewedEntry(positionId, UserConstants.ENTITY_POSITION, userId);

							form.setShowCondition(PositionConstants.POSITION_STATUS_OPENED);

							ToDoManager toDoManager = new ToDoManager();
							toDoManager.regenerateToDo(positionId, null, null);

							return positionsHome(mapping, actionForm, request, response);
						} else {
							errors.add("position.add_new.error.duplicate_code",
									new ActionError("position.add_new.error.duplicate_code",
											TPLabels.getLabel("common.position_code")));
						}
					}
				}
				if (errors != null && errors.size() > 0) {
					saveErrors(request, errors);
					return approval(mapping, actionForm, request, response);
				}
			}
		} catch (Exception e) {
			TPLogger.getLogger().error("Error encountered while creating new position", e);
			ActionError error = new ActionError("position.add_new.error", TPLabels.getLabel("common.position"));
			errors.add("position.add_new.error", error);
			saveErrors(request, errors);
			if (forward.equals("approval")) {
				return approval(mapping, actionForm, request, response);
			}
			List steps = parseJSArraySteps(form.getJsArrayHiringProcess(), positionId);
			populateHiringProcessPage(form, steps, userId, userRoleId);
			form.setDir(PositionConstants.DIR_ADD_POSITION);
		}
		return mapping.findForward(forward);
	}

	/** Method to get responsibility text from dropdown and copy to text area */
	public ActionForward copyResponsibilities(ActionMapping mapping, ActionForm actionForm, HttpServletRequest request,
			HttpServletResponse response) throws Exception {
		if (!SessionManager.validateSession(mapping, actionForm, request, response, this)) {
			return null;
		}
		String forward = "xmlFile";
		String xmlFile = "";
		try {
			if (!SessionManager.isLoginFound(mapping, actionForm, request, response, this)) {
				xmlFile = Utils.getXMLForSessionExpiry();
			} else {
				PositionForm positionForm = (PositionForm) actionForm;
