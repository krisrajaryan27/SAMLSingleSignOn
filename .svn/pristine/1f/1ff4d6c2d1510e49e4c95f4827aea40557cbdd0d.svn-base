	public ActionForward getCompanyJSForAP(ActionMapping mapping, ActionForm actionForm, HttpServletRequest request,
			HttpServletResponse response) {
		String forward = "xmlFile";
		String xmlFile = "";
		String userRoleId = (String) request.getSession().getAttribute("userRoles");
		if (!(UserConstants.ROLE_ADMIN == Integer.parseInt(userRoleId)
				|| UserConstants.ROLE_HR_MANAGER == Integer.parseInt(userRoleId)
				|| UserConstants.ROLE_RECRUITER == Integer.parseInt(userRoleId))) {
			request.setAttribute("disableRequisitionerFlag", "1");
		}
		positionCodeForAP = StringUtils.EMPTY;
		departmentsList = null;

		try {
			if (!SessionManager.isLoginFound(mapping, actionForm, request, response, this)) {
				xmlFile = Utils.getXMLForSessionExpiry();
				forward = "xmlFile";
			} else {
				if (Utils.isBlankOrNull(positionCodeForAP)) {
					positionCodeForAP = ((PositionForm) actionForm).getPositionCodeForAP();
				}

				if (!Utils.isBlankOrNull(positionCodeForAP)) {
					int spacePos = positionCodeForAP.indexOf(" ");
					if (spacePos > 0) {
						positionCodeForAP = positionCodeForAP.substring(0, spacePos);
						departmentsList = (ArrayList<PositionDataForAP>) PositionActionForAP
								.getPositionDataForAP(positionCodeForAP);

						SimpleDataObject sdo = new SimpleDataObject();
						sdo = (SimpleDataObject) departmentsList.get(0);
						xmlFile = sdo.getString("companyId");
					}

				}

			}

		} catch (Exception e) {
			TPLogger.getLogger().error(GlobalConstants.ERROR, e);
			xmlFile = Utils.getXMLForError();
		}
		request.setAttribute("xmlFile", xmlFile);
		return mapping.findForward(forward);
	}

	public ActionForward getBusinessUnitJSForAP(ActionMapping mapping, ActionForm actionForm,
