	public ActionForward XMLActiveHRUsers(ActionMapping mapping, ActionForm actionForm, HttpServletRequest request,
			HttpServletResponse response) {
		String forward = "xmlFile";
		String xmlFile = "";
		try {
			if (!SessionManager.isLoginFound(mapping, actionForm, request, response, this)) {
				xmlFile = Utils.getXMLForSessionExpiry();
			} else {
				PositionManager positionManager = new PositionManager();
				LoginManager loginManager = new LoginManager();
				String roleIds = UserConstants.ROLE_CXO + "," + UserConstants.ROLE_INTERVIEWER + ","
						+ UserConstants.ROLE_ADMIN + "," + UserConstants.ROLE_REQUISITIONER + ","
						+ UserConstants.ROLE_HR_MANAGER + "," + UserConstants.ROLE_RECRUITER;
				List<SimpleDataObject> activeHRUsers = positionManager.getUsersForRoleForGridDisplay(roleIds);
				List<SimpleDataObject> activeUsers = new ArrayList<SimpleDataObject>();
				for (SimpleDataObject sdo : activeHRUsers) {
					BitSet permissions = loginManager.getUserPermissionsBitSet(sdo.getString("userId"));
					PermissionSet permissionSet = new PermissionSet(permissions);
					if (permissionSet.isPERMISSION_SCHEDULE_INTERVIEW()) {
						activeUsers.add(sdo);
					}
				}
				xmlFile = UserUtils.getXMLforActiveUsers(activeUsers);
				request.setAttribute("xmlFile", xmlFile);
				request.setAttribute("activeUsers", activeUsers);
			}
		} catch (Exception e) {
			TPLogger.getLogger().error("Error in getting XML:", e);
		}

		return mapping.findForward(forward);
	}

