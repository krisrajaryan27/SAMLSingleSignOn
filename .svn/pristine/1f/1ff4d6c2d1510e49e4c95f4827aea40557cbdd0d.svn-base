	public ActionForward copyHiringProcess(ActionMapping mapping, ActionForm actionForm, HttpServletRequest request,
			HttpServletResponse response) throws Exception {
		if (!SessionManager.validateSession(mapping, actionForm, request, response, this)) {
			return null;
		}
		PositionForm form = (PositionForm) actionForm;
		String _positionId = form.get_positionId();
		String positionId = form.getPositionId();
		try {
			PositionManager positionManager = new PositionManager();

			if (PositionConstants.DIR_EDIT_POSITION.equalsIgnoreCase(form.getDir())) {
				positionManager.copySteps(_positionId, positionId);
			} else {
				List<SimpleDataObject> steps = positionManager.getPositionHiringProcessToEdit(_positionId);
				if (steps != null && steps.size() > 0) {
					for (int i = 0; i < steps.size(); i++) {
						SimpleDataObject step = (SimpleDataObject) steps.get(i);
						step.setAttribute("stepId", "0");
						List<SimpleDataObject> messages = (List<SimpleDataObject>) step.getAttribute("messages");
						if (messages != null && messages.size() > 0) {
							for (int j = 0; j < messages.size(); j++) {
								SimpleDataObject message = (SimpleDataObject) messages.get(j);
								message.setAttribute("messageId", "0");
							}
						}
					}
				}
				SimpleDataObject position = (SimpleDataObject) request.getSession(false).getAttribute(positionId);
				position.setAttribute("steps", steps);
			}
		} catch (Exception e) {
			TPLogger.getLogger().error("Error in copying hiring process", e);
		}
		return hiringProcess(mapping, actionForm, request, response);
	}

