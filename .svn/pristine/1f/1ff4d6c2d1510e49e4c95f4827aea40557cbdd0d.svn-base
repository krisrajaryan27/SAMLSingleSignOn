	public ActionForward showPositionStatus(ActionMapping mapping, ActionForm actionForm, HttpServletRequest request,
			HttpServletResponse response) {
		if (!SessionManager.validateSession(mapping, actionForm, request, response, this)) {
			return null;
		}
		String forward = "positionStatus";

		Integer[] permissions = new Integer[1];
		permissions[0] = PermissionConstants.PERMISSION_POSITIONS;
		if (!isUserAuthorized(request, CommonConstants.NO_MODULE, permissions, null,
				((PositionForm) actionForm).getPositionId(), null)) {
			forward = getAuthorizationFailureForward();
			return mapping.findForward(forward);
		}

		PositionManager positionManager = new PositionManager();
		PositionForm positionForm = (PositionForm) actionForm;
		String positionId = positionForm.getPositionId();
		try {

			String positionStatus = positionForm.getShowCondition();
			String positionName = positionManager.getPositionTitle(positionId);
			if (PositionConstants.POSITION_STATUS_DROPPED.equals(positionStatus)) {
				SimpleDataObject obj = positionManager.getDropReasonAndComment(positionId);
				positionForm.setDropReason(obj.getString("dropReason"));
				positionForm.setDropComment(obj.getString("dropComment"));
			}
			request.setAttribute("PositionName", positionName);
			request.setAttribute("positionStatus", positionStatus);
		} catch (Exception e) {
			TPLogger.getLogger().error("Error while getting status for Position", e);
		}
		return mapping.findForward(forward);
	}

	public ActionForward checkForCandidatesInProcess(ActionMapping mapping, ActionForm actionForm,
			HttpServletRequest request, HttpServletResponse response) {
		String forward = "xmlFile";
		String xmlFile = "";
		ArrayList<String> errors = new ArrayList<String>();
		try {
			if (!SessionManager.isLoginFound(mapping, actionForm, request, response, this)) {
				xmlFile = Utils.getXMLForSessionExpiry();
			} else {
				PositionForm positionForm = (PositionForm) actionForm;
				String positionId = positionForm.getPositionId();
				PositionManager positionManager = new PositionManager();

				int candidatesInProcess = positionManager.getNoOfCandidatesInProcess(positionId);
				if (candidatesInProcess > 0) {
					errors.add("position.home.error.candidates_inprocess");
					xmlFile = Utils.getXMLForError(errors);
				}
			}
		} catch (Exception e) {
			TPLogger.getLogger().error("Error encountered while marking candidates and closing position", e);
			xmlFile = Utils.getXMLForError(null);
		}
		request.setAttribute("xmlFile", xmlFile);
		return mapping.findForward(forward);
	}

	public ActionForward changePositionStatus(ActionMapping mapping, ActionForm actionForm, HttpServletRequest request,
			HttpServletResponse response) {
		if (!SessionManager.validateSession(mapping, actionForm, request, response, this)) {
			return null;
		}
		ActionErrors errors = new ActionErrors();
		String forward = "positionStatus";

		Integer[] permissions = new Integer[2];
		permissions[0] = PermissionConstants.PERMISSION_POSITIONS;
		permissions[1] = PermissionConstants.PERMISSION_OPEN_CLOSE_POSITION;
		if (!isUserAuthorized(request, CommonConstants.NO_MODULE, permissions, null,
				((PositionForm) actionForm).getPositionId(), null)) {
			forward = getAuthorizationFailureForward();
			return mapping.findForward(forward);
		}

		try {
			PositionManager positionManager = new PositionManager();
			PositionForm positionForm = (PositionForm) actionForm;
			String positionId = positionForm.getPositionId();
			String positionStatus = positionForm.getShowCondition();
			String isBudgetCommitted = positionForm.getIsBudgetCommitted();
			String userId = (String) request.getSession(false).getAttribute("userId");
			AuditAction auditAction = new AuditAction();
			SimpleDataObject positionDescription = (SimpleDataObject) positionManager
					.getPositionDescriptionToEdit(positionId);
			if (!Utils.isBlankOrNull(positionId) && !Utils.isBlankOrNull(positionStatus)) {
				boolean changeStatusRequestValid = false;
				String positionStatusStr = "";
				String oldPositionStatusStr = "";
				String oldPositionStatus = positionManager.getpositionStatus(positionId);

				if (oldPositionStatus.equals(PositionConstants.POSITION_STATUS_OPENED)) {
					// int candidatesInProcess =
					// positionManager.getNoOfCandidatesInProcess(positionId);
					// if (candidatesInProcess > 0 &&
					// !positionStatus.equals(PositionConstants.POSITION_STATUS_HOLD))
					// {
					// ActionError error = new
					// ActionError("position.home.error.candidates_inprocess");
					// errors.add("position.home.error.candidates_inprocess",
					// error);
					// } else {
					// changeStatusRequestValid = true;
					// }
					oldPositionStatusStr = TPLabels.getLabel("common.open");
					changeStatusRequestValid = true;
				} else if (oldPositionStatus.equals(PositionConstants.POSITION_STATUS_CLOSED)) {
					changeStatusRequestValid = true;
					oldPositionStatusStr = TPLabels.getLabel("common.close");
				} else if (oldPositionStatus.equals(PositionConstants.POSITION_STATUS_HOLD)) {
					changeStatusRequestValid = true;
					oldPositionStatusStr = TPLabels.getLabel("common.hold");
				} else if (oldPositionStatus.equals(PositionConstants.POSITION_STATUS_DROPPED)) {
					changeStatusRequestValid = true;
					oldPositionStatusStr = TPLabels.getLabel("common.drop");
				} else if (oldPositionStatus.equals(PositionConstants.POSITION_STATUS_INPROCESS)) {
					SimpleDataObject sdo = positionManager.getPositionActionRequired(positionId);
					if (Utils.isBlankOrNull(sdo.getString("requisitionStepName"))
							&& RequisitionConstants.FEEDBACK_ACTION_APPROVE.equals(sdo.getString("feedbackDecision"))) {
						// get hiring process
						boolean isError = false;
						ArrayList<StepData> steps = positionManager.getHiringProcessStepsForPosition(positionId, null);
						if (steps == null || steps.size() <= 1) {
							ActionError error = new ActionError("position.home.error.define_hiring_process",
									TPLabels.getLabel("common.position"));
							errors.add("position.home.error.define_hiring_process", error);
							isError = true;
						}
						if (PositionScreenConfigurationManager
								.isDescriptionFieldShow(PositionConfigurationConstants.FIELD_POSITION_TYPE_EXT_INT)) {
							boolean isPositioTypeSet = PositionUtils.isPositionTypeSetForPosition(positionId);
							if (!isPositioTypeSet) {
								ActionError error = new ActionError("position.home.error.define_position_type",
										TPLabels.getLabel("common.position"));
								errors.add("position.home.error.define_position_type", error);
								isError = true;
							}
						}
						if (isError) {

						} else {
							oldPositionStatusStr = TPLabels.getLabel("common.hold");
							changeStatusRequestValid = true;
						}
					} else {
						ActionError error = new ActionError("position.home.error.noopen_inprocess_requisition");
						errors.add("position.home.error.noopen_inprocess_requisition", error);
					}
				} else if (oldPositionStatus.equals(PositionConstants.POSITION_STATUS_REJECTED)) {
					ActionError error = new ActionError("position.home.error.noopen_rejected_requisition");
					errors.add("position.home.error.noopen_rejected_requisition", error);
				}
				if (positionStatus.equals(PositionConstants.POSITION_STATUS_OPENED)) {
					if (ModuleSet.isMODULE_BUDGET() && BudgetUtils.isBudgetModuleActive()) {
						String budgetItemId = positionDescription.getString("budgetItemId");
						if (Utils.isBlankOrNull(budgetItemId)) {
							changeStatusRequestValid = false;
							errors.add("budget.position_open.error.no_budget_item",
									new ActionError("budget.position_open.error.no_budget_item",
											TPLabels.getLabel("common.position"),
											TPLabels.getLabel("common.position")));
						}
					}
				}
				if (changeStatusRequestValid) {
					if (positionStatus.equals(PositionConstants.POSITION_STATUS_CLOSED)) {
						positionStatusStr = TPLabels.getLabel("common.close");
					} else if (positionStatus.equals(PositionConstants.POSITION_STATUS_OPENED)) {
						positionStatusStr = TPLabels.getLabel("common.open");
					} else if (positionStatus.equals(PositionConstants.POSITION_STATUS_HOLD)) {
						positionStatusStr = TPLabels.getLabel("common.hold");
					} else if (positionStatus.equals(PositionConstants.POSITION_STATUS_DROPPED)) {
						positionStatusStr = TPLabels.getLabel("common.drop");
					}
					positionManager.changePositionStatus(positionId, positionStatus, userId, isBudgetCommitted, null);
					String clientIpAddr = getClientIpAddr(request);
					auditAction.insertAuditInfo(
							TPLabels.getLabel("common.status") + " " + TPLabels.getLabel("common.from") + " "
									+ oldPositionStatusStr + " " + TPLabels.getLabel("common.to") + " "
									+ positionStatusStr,
							AuditConstants.TYPE_MODIFIED, positionId, AuditConstants.AUDIT_POSITION, userId, null, null,
							null, true, clientIpAddr);

					if (positionStatus.equals(PositionConstants.POSITION_STATUS_CLOSED)) {
						positionManager.markCandidatesAndClosePosition(positionId, userId);
					}
					if (positionStatus.equals(PositionConstants.POSITION_STATUS_DROPPED)) {
						positionManager.markCandidatesAndDropPosition(positionId, userId);
						String dropReason = positionForm.getDropReason();
						String dropComment = positionForm.getDropComment();
						positionManager.savePositionDropInformation(positionId, dropReason, dropComment, userId);
						// positionManager.sendNotificationMailOnPositionDropped(positionId,
						// userId);
					}
				}

				if (PositionConstants.POSITION_STATUS_OPENED.equalsIgnoreCase(oldPositionStatus)
						|| PositionConstants.POSITION_STATUS_HOLD.equalsIgnoreCase(oldPositionStatus)) {
					ToDoManager toDoManager = new ToDoManager();
					toDoManager.regenerateToDo(positionId, null, null);
				}

				if (errors != null && errors.size() > 0) {
					request.setAttribute("PositionName", positionDescription.getString("positionName"));
					request.setAttribute("positionStatus", oldPositionStatus);
					saveErrors(request, errors);
				} else {
					request.setAttribute("update", "1");
				}
			}
		} catch (Exception e) {
			TPLogger.getLogger().error(GlobalConstants.ERROR, e);
		}
		return mapping.findForward(forward);
	}

	public ActionForward getBudgetItemJS(ActionMapping mapping, ActionForm actionForm, HttpServletRequest request,
			HttpServletResponse response) {
		String forward = "xmlFile";
		String xmlFile = "";
		try {
			if (!SessionManager.isLoginFound(mapping, actionForm, request, response, this)) {
				xmlFile = Utils.getXMLForSessionExpiry();
			} else {
				PositionForm positionForm = (PositionForm) actionForm;
				xmlFile = getJSArrayBudgetItems(positionForm.getBandId(), positionForm.getGradeId());
			}

		} catch (Exception e) {
			TPLogger.getLogger().error("Error in search screen", e);
