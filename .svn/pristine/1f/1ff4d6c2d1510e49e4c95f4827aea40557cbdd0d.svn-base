	public ActionForward publishPositionsToVendors(ActionMapping mapping, ActionForm actionForm,
			HttpServletRequest request, HttpServletResponse response) {
		if (!SessionManager.validateSession(mapping, actionForm, request, response, this)) {
			return null;
		}
		String forward = "publishPositionsToVendors";
		Integer[] permissions = new Integer[2];
		permissions[0] = PermissionConstants.PERMISSION_POSITIONS;
		int module = ModuleConstants.MODULE_VENDOR;
		permissions[1] = PermissionConstants.PERMISSION_PUBLISH_POSITION;
