	private void setDefaultPositionOwnerId(PositionForm positionForm, String userId, PermissionSet permissionSet) {
		if (PositionScreenConfigurationManager
				.isDescriptionFieldShow(PositionConfigurationConstants.FIELD_POSITION_OWNER)
				&& Utils.isBlankOrNull(positionForm.getPositionOwnerId())) {
			if (permissionSet.isPERMISSION_CAN_USER_BE_POSITION_OWNER()) {
				positionForm.setPositionOwnerId(userId);
			}
		}
	}

	/**
	 * Sets the value of PositioOwnerId in PositionForm. <br>
	 * <p>
	 * If the action is creating a position from Position Template or Copy
	 * position and if isDescriptionFieldShow is true, then method sets
	 * positionOwnerId as loggedIn userId if no positionOwnerId selected in
	 * template or source position copied from.
	 * <p>
	 * 
	 * @param positionForm
	 * @param positionDescription
	 * @param userId
	 * @param permissionSet
	 */
	private void setPositonOwnerIdOnForm(PositionForm positionForm, SimpleDataObject positionDescription, String userId,
			PermissionSet permissionSet) {
		if (PositionConstants.DIR_COPY_POSITION.equals(positionForm.getDir())
				&& (Utils.isBlankOrNull(positionDescription.getString("positionOwnerId"))
						|| "-1".equals(positionDescription.getString("positionOwnerId")))) {
			if (PositionScreenConfigurationManager
					.isDescriptionFieldShow(PositionConfigurationConstants.FIELD_POSITION_OWNER)) {
				positionForm.setPositionOwnerId(userId);
			}
		} else {
			positionForm.setPositionOwnerId(positionDescription.getString("positionOwnerId"));
		}
	}

	/**
	 * Ajax Action to check if any candidates are in process for a given
	 * position.
	 * 
	 * @param mapping
	 * @param actionForm
	 * @param request
	 * @param response
	 * @return
	 */
	public ActionForward checkCandidatesInProcess(ActionMapping mapping, ActionForm actionForm,
			HttpServletRequest request, HttpServletResponse response) {
		String forward = "xmlFile";
		String xmlFile = "";
		ArrayList<String> errors = null;
		PositionManager positionManager = null;
		if (!SessionManager.isLoginFound(mapping, actionForm, request, response, this)) {
			xmlFile = Utils.getXMLForSessionExpiry();
		} else {
			PositionForm posForm = (PositionForm) actionForm;
			Integer[] permissions = new Integer[1];
			permissions[0] = PermissionConstants.PERMISSION_POSITIONS;
			if (!isUserAuthorized(request, CommonConstants.NO_MODULE, permissions, null, posForm.getPositionId(),
					null)) {
				forward = getAuthorizationFailureForward();
				return mapping.findForward(forward);
			}
			if (!Utils.isBlankOrNull(posForm.getPositionId())) {
				positionManager = new PositionManager();
				int candidatesInProcess = positionManager.getNoOfCandidatesInProcess(posForm.getPositionId());
				if (candidatesInProcess > 0) {
					errors = new ArrayList<String>();
					errors.add(TPLabels.getLabel("common.candidates") + " " + TPLabels.getLabel("common.in_process"));
					xmlFile = Utils.getXMLForError(errors);
				}
			}
		}
		request.setAttribute("xmlFile", xmlFile);
		return mapping.findForward(forward);
	}

	private void setMigrationStatus(HttpServletRequest request) {
		try {
			StepsMigrationWizardDao stepsMigrationWizardDao = new StepsMigrationWizardDao();
			StepsMigrationWizardService stepsMigrationWizardService = new StepsMigrationWizardService();
			stepsMigrationWizardService.setStepsMigrationWizardDao(stepsMigrationWizardDao);
			Map<String, String> migrationStatusMap = stepsMigrationWizardService.getMigrationStatus();
			if (migrationStatusMap != null && !migrationStatusMap.isEmpty()) {
				if (StepsMigrationWizardConstants.MIGRATION_STATUS_PENDING.equals(migrationStatusMap.get("closed"))) {
					request.setAttribute("closedPositionsMigrationPending", true);
				}
				if (StepsMigrationWizardConstants.MIGRATION_STATUS_PENDING.equals(migrationStatusMap.get("open"))) {
					request.setAttribute("openPositionsMigrationPending", true);
				}
				if (StepsMigrationWizardConstants.MIGRATION_STATUS_PENDING
						.equals(migrationStatusMap.get("templates"))) {
					request.setAttribute("templatesMigrationPending", true);
				}
			}
		} catch (Exception e) {
			TPLogger.getLogger().error(GlobalConstants.ERROR, e);
		}
	}

	private String getCopyPositionCode(String positionCode, String positionId) {
		String copyPositionCode = "";
		PositionManager positionManager = null;
		try {
			char[] alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZ".toCharArray();
			positionManager = new PositionManager();

			for (int i = 0; i < alphabet.length; i++) {
				String tmpCode = positionCode + alphabet[i];
				if (positionManager.isPositionCodeExist(tmpCode).isEmpty()) {
					copyPositionCode = tmpCode;
					break;
				}
			}
		} catch (Exception e) {
			TPLogger.getLogger().error(GlobalConstants.ERROR, e);
		}
		return copyPositionCode;
	}

