	public ActionForward getPositionNameForAP(ActionMapping mapping, ActionForm actionForm, HttpServletRequest request,
			HttpServletResponse response) {
		String forward = "xmlFile";
		String xmlFile = "";
		try {
			if (!SessionManager.isLoginFound(mapping, actionForm, request, response, this)) {
				xmlFile = Utils.getXMLForSessionExpiry();
				forward = "xmlFile";
			} else {
				String formPositionCode = ((PositionForm) actionForm).getPositionCodeForAP();
				//Updating departmentsList as null because of AJAX Call 
				departmentsList = null;
				if (!Utils.isBlankOrNull(formPositionCode)) {
					int spacePos = formPositionCode.indexOf(" ");
					if (spacePos > 0) {
						formPositionCode = formPositionCode.substring(0, spacePos);
						if (positionCodeForAP.equals(formPositionCode) && null != departmentsList) {
							xmlFile = Utils.getNameInXML(departmentsList, "positionTitleForAP");
