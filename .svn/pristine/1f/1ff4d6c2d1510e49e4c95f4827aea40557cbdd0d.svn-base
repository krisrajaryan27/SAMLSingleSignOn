	public ActionForward uploadIndent(ActionMapping mapping, ActionForm actionForm, HttpServletRequest request,
			HttpServletResponse response) {
		if (!SessionManager.validateSession(mapping, actionForm, request, response, this)) {
			return null;
		}
		String forward = "uploadIndent";
		String userId = (String) request.getSession().getAttribute("userId");
		boolean canAddRequisition = true;
		if (PositionConstants.REQUISITION_MANAGEMENT_ENABLED) {
			RequisitionManager requisitionManager = new RequisitionManager();
			if (!requisitionManager.isRequisitionAllowed(userId)) {
				canAddRequisition = false;
			}
		}
		Integer[] permissions = new Integer[1];
		permissions[0] = PermissionConstants.PERMISSION_POSITIONS;
		if (!isUserAuthorized(request, CommonConstants.NO_MODULE, permissions, null, null, null)
				|| !canAddRequisition) {
			forward = getAuthorizationFailureForward();
			return mapping.findForward(forward);
		}

		return mapping.findForward(forward);
	}

	public ActionForward parseIndent(ActionMapping mapping, ActionForm actionForm, HttpServletRequest request,
			HttpServletResponse response) {
		if (!SessionManager.validateSession(mapping, actionForm, request, response, this)) {
			return null;
		}
		String forward = "uploadIndent";
		String userId = (String) request.getSession().getAttribute("userId");
		boolean canAddRequisition = true;
		if (PositionConstants.REQUISITION_MANAGEMENT_ENABLED) {
			RequisitionManager requisitionManager = new RequisitionManager();
			if (!requisitionManager.isRequisitionAllowed(userId)) {
				canAddRequisition = false;
			}
		}
		Integer[] permissions = new Integer[1];
		permissions[0] = PermissionConstants.PERMISSION_POSITIONS;
		if (!isUserAuthorized(request, CommonConstants.NO_MODULE, permissions, null, null, null)
				|| !canAddRequisition) {
			forward = getAuthorizationFailureForward();
			return mapping.findForward(forward);
		}
		ActionErrors actionErrors = new ActionErrors();
		try {
			PositionForm form = (PositionForm) actionForm;
			FormFile formFile = form.getAttachedFile();
			if (formFile != null) {
				FormFileData formFileData = new FormFileData(formFile.getFileName(), formFile.getFileSize(),
						formFile.getContentType(), formFile.getInputStream());
				String ext = FileHandlerUtils.getFileExtention(formFileData.getFileName(), "");
				if (PositionUtils.isValidExtension(ext)) {
					PositionManager manager = new PositionManager();
					List<DraftData> drafts = manager.parseIndents(formFileData, userId);
					if (drafts != null && drafts.size() > 0) {
						if (drafts.size() > 1) {
							request.setAttribute("drafts", drafts);
						} else {
							request.setAttribute("relativeFilePath", drafts.get(0).getRelativeFilePath());
						}
					}
					forward = "successUploadIndent";
				} else {
					actionErrors.add("position.error.ext_not_allowed",
							new ActionError("position.error.ext_not_allowed", TPLabels.getLabel("common.position"),
									TPApplicationProperties.getProperty("indent.import.ext.allowed")));
				}
			}
		} catch (PositionParserException e) {
			TPLogger.getLogger().error(GlobalConstants.ERROR, e);
			if (TPLabels.getLabel("position_parser.error.position_definition_not_found").equals(e.getMessage())) {
				actionErrors.add("position_parser.error.position_definition_not_found",
						new ActionError("position_parser.error.position_definition_not_found"));
			} else {
				actionErrors.add("position_parser.error.unknown_attributes",
						new ActionError("position_parser.error.unknown_attributes", e.getMessage()));
			}
		} catch (FileUploadException e) {
			TPLogger.getLogger().error(GlobalConstants.ERROR, e);
			actionErrors.add("position.error.upload_indent",
					new ActionError("position.error.upload_indent", TPLabels.getLabel("common.position")));
		} catch (InvalidMimeTypeException e) {
			TPLogger.getLogger().error("Error while uploading user document", e);
			actionErrors.add("upload_document.error.invalid_mime_type",
					new ActionError("upload_document.error.invalid_mime_type"));
		} catch (FileNotFoundException e) {
			TPLogger.getLogger().error(GlobalConstants.ERROR, e);
			actionErrors.add("position.error.upload_indent",
					new ActionError("position.error.upload_indent", TPLabels.getLabel("common.position")));
		} catch (IOException e) {
			TPLogger.getLogger().error(GlobalConstants.ERROR, e);
			actionErrors.add("position.error.upload_indent",
					new ActionError("position.error.upload_indent", TPLabels.getLabel("common.position")));
		} finally {
			if (actionErrors != null && actionErrors.size() > 0) {
				saveErrors(request, actionErrors);
			}
		}
		return mapping.findForward(forward);
	}

	public ActionForward loadDraft(ActionMapping mapping, ActionForm actionForm, HttpServletRequest request,
			HttpServletResponse response) throws Exception {
		if (!SessionManager.validateSession(mapping, actionForm, request, response, this)) {
			return null;
		}
		String userId = (String) request.getSession().getAttribute("userId");
		boolean canAddRequisition = true;
		if (PositionConstants.REQUISITION_MANAGEMENT_ENABLED) {
			RequisitionManager requisitionManager = new RequisitionManager();
			if (!requisitionManager.isRequisitionAllowed(userId)) {
				canAddRequisition = false;
			}
		}
		Integer[] permissions = new Integer[1];
		permissions[0] = PermissionConstants.PERMISSION_POSITIONS;
		if (!isUserAuthorized(request, CommonConstants.NO_MODULE, permissions, null, null, null)
				|| !canAddRequisition) {
			String forward = getAuthorizationFailureForward();
			return mapping.findForward(forward);
		}
		PositionForm form = (PositionForm) actionForm;
		form.setDir(PositionConstants.DIR_ADD_POSITION);
		PositionDraftsManager draftsManager = new PositionDraftsManager();
		SimpleDataObject position = new SimpleDataObject();
		if (!Utils.isBlankOrNull(form.getDraftId())) {
			position = draftsManager.getPositionBO(form.getDraftId());
		} else if (!Utils.isBlankOrNull(form.getRelativeFilePath())) {
			position = draftsManager.parsePosition(form.getRelativeFilePath());
		}

		ActionErrors actionErrors = new ActionErrors();
		if (!Utils.isBlankOrNull(position.getString(PositionParserConstants.PARSING_ERRORS))) {
			actionErrors.add("position_parser.error.unknown_attributes",
					new ActionError("position_parser.error.unknown_attributes",
							position.getString(PositionParserConstants.PARSING_ERRORS)));
		}
		List<List<String>> warnings = (List<List<String>>) position.getAttribute("warnings");
		if (warnings != null && warnings.size() > 0) {
			request.setAttribute("warnings", warnings);
			actionErrors.add("position_parser.error.unknown_attribute_vals",
					new ActionError("position_parser.error.unknown_attribute_vals"));
		}
		if (actionErrors.size() > 0) {
			saveErrors(request, actionErrors);
		}
		String positionId = position.getString("positionId");
		form.setPositionId(positionId);
		request.getSession(false).setAttribute(positionId, position);
		return description(mapping, actionForm, request, response);
	}

	public ActionForward updateDraftName(ActionMapping mapping, ActionForm actionForm, HttpServletRequest request,
			HttpServletResponse response) throws Exception {
		String forward = "savePositionAsDraft";
		if (!SessionManager.validateSession(mapping, actionForm, request, response, this)) {
			return null;
		}
		Integer[] permissions = new Integer[1];
		permissions[0] = PermissionConstants.PERMISSION_POSITIONS;
		if (!isUserAuthorized(request, CommonConstants.NO_MODULE, permissions, null, null, null)) {
			forward = getAuthorizationFailureForward();
			return mapping.findForward(forward);
		}
		PositionForm form = (PositionForm) actionForm;

		// check if draft name is already exists
		ActionErrors errors = new ActionErrors();
		PositionDraftsManager positionDraftManager = new PositionDraftsManager();
		positionDraftManager.checkDraftNameExists(errors, form.getDraftName().trim());
		if (errors != null && errors.size() > 0) {
			saveErrors(request, errors);
		} else {
			request.setAttribute("update", "1");
		}
		return mapping.findForward(forward);
	}

	public ActionForward savePositionAsDraft(ActionMapping mapping, ActionForm actionForm, HttpServletRequest request,
			HttpServletResponse response) throws Exception {
		String forward = "savePositionAsDraft";
		if (!SessionManager.validateSession(mapping, actionForm, request, response, this)) {
			return null;
		}
		String userId = (String) request.getSession().getAttribute("userId");
		boolean canAddRequisition = true;
		if (PositionConstants.REQUISITION_MANAGEMENT_ENABLED) {
			RequisitionManager requisitionManager = new RequisitionManager();
			if (!requisitionManager.isRequisitionAllowed(userId)) {
				canAddRequisition = false;
			}
		}
		Integer[] permissions = new Integer[1];
		permissions[0] = PermissionConstants.PERMISSION_POSITIONS;
		if (!isUserAuthorized(request, CommonConstants.NO_MODULE, permissions, null, null, null)
				|| !canAddRequisition) {
			forward = getAuthorizationFailureForward();
			return mapping.findForward(forward);
		}

		String userRoleId = (String) request.getSession(false).getAttribute("userRoles");
		PositionForm form = (PositionForm) actionForm;
		String draftName = form.getDraftName();
		if (!Utils.isBlankOrNull(draftName)) {
			draftName = draftName.trim();
			SimpleDataObject position = (SimpleDataObject) request.getSession(false).getAttribute(form.getPositionId());
			if (NavigationConstants.STEP_POSITION_DESCRIPTION.equalsIgnoreCase(form.getStep())) {
				populatePositionDescriptionInObject(form, position);

				ArrayList<CustomFieldData> customFields = null;
				CustomFieldDataProcessor customFieldDataProcessor = new CustomFieldDataProcessor();
				if (CustomFieldManager.isCustomFieldsAvailable(CustomFieldConstants.ENTITY_TYPE_POSITION)) {
					CustomFieldManager customFieldManager = new CustomFieldManager();
					customFields = customFieldManager.getCustomFieldsForInputAllowed(
							CustomFieldConstants.ENTITY_TYPE_POSITION, CustomFieldConstants.INPUT_ALLOWED, true);
					customFields = customFieldDataProcessor.setCustomFieldValuesFromRequest(request, customFields);
					position.setAttribute("customFields", customFields);
				}
			} else if (NavigationConstants.STEP_POSITION_REQUIREMENTS.equalsIgnoreCase(form.getStep())) {
				populatePositionRequirementsInObject(form, position);
			} else if (NavigationConstants.STEP_POSITION_APPROVAL.equalsIgnoreCase(form.getStep())) {
				populatePositionApprovalInObject(form, position);
			}

			PositionDraftsManager draftsManager = new PositionDraftsManager();
			draftsManager.savePositionAsDraft(position, draftName, userId);

			form.setDir(PositionConstants.DIR_ADD_POSITION);
			if (NavigationConstants.STEP_POSITION_DESCRIPTION.equalsIgnoreCase(form.getStep())) {
				ArrayList<CustomFieldData> customFields = null;
				if (CustomFieldManager.isCustomFieldsAvailable(CustomFieldConstants.ENTITY_TYPE_POSITION)) {
					CustomFieldManager customFieldManager = new CustomFieldManager();
					customFields = customFieldManager.getCustomFieldsForInputAllowed(
							CustomFieldConstants.ENTITY_TYPE_POSITION, CustomFieldConstants.INPUT_ALLOWED, true);
					CustomFieldDataProcessor customFieldDataProcessor = new CustomFieldDataProcessor();
					customFields = customFieldDataProcessor.setCustomFieldValuesFromRequest(request, customFields);
					request.setAttribute("customFields", customFields);
				}
				populateDescriptionPage(form, userId, userRoleId);
				form.setStep(NavigationConstants.STEP_POSITION_DESCRIPTION);
				forward = "description";
			} else if (NavigationConstants.STEP_POSITION_REQUIREMENTS.equalsIgnoreCase(form.getStep())) {
				populateRequirementsPage(form, userId, userRoleId, request);
				form.setStep(NavigationConstants.STEP_POSITION_REQUIREMENTS);
				forward = "requirements";
			} else {
				RequisitionManager requisitionManager = new RequisitionManager();
				ArrayList<SimpleDataObject> requisitionApprovalTemplates = requisitionManager
						.getUserRequisitionApprovalTemplates(userId);
				if (requisitionApprovalTemplates.size() > 1) {
					String jsArrayRequisitionApprovalTemplates = CommonUtils.getListJavaScriptArrayWithProperties(
							requisitionApprovalTemplates, "templateId", "templateName");
					request.setAttribute("jsArrayRequisitionApprovalTemplates", jsArrayRequisitionApprovalTemplates);
				}

				RequisitionApprovalStepData requisitionApprovalFirstStepData = requisitionManager
						.getFirstRequisitionApprovalStepDataForUser(userId,
								position.getString("requisitionApprovalTemplateId"));
				int rank = 2;
				if (requisitionApprovalFirstStepData != null) {
					rank = requisitionApprovalFirstStepData.getRequisitionApprovalStepRank();
				}
				RequisitionApprovalStepData requisitionApprovalNextStepData = null;
				if (requisitionApprovalFirstStepData != null) {
					requisitionApprovalNextStepData = requisitionManager.getNextActiveRequisitionStepData(
							"" + requisitionApprovalFirstStepData.getRequisitionApprovalStepId(), rank,
							position.getString("requisitionApprovalTemplateId"));
				}
				if (requisitionApprovalNextStepData != null) {
					ArrayList<LoginData> users = requisitionApprovalNextStepData.getUsers();
					ArrayList<String> userIds = new ArrayList<String>();
					ArrayList<String> userNames = new ArrayList<String>();
					for (int i = 0; users != null && i < users.size(); i++) {
						LoginData loginData = users.get(i);
						userIds.add(loginData.getUserId());
						userNames.add(loginData.getName());
					}
					request.setAttribute("userIds", userIds);
					request.setAttribute("userNames", userNames);
				}

				forward = "approval";
			}
		}
		return mapping.findForward(forward);
	}

	public ActionForward getHTMLForFilter(ActionMapping mapping, ActionForm actionForm, HttpServletRequest request,
			HttpServletResponse response) {
		String forward = "xmlFile";
		String xmlFile = "Link";
		try {
			if (!SessionManager.isLoginFound(mapping, actionForm, request, response, this)) {
				xmlFile = Utils.getXMLForSessionExpiry();
			} else {
				String userId = (String) request.getSession(false).getAttribute("userId");
				PermissionSet permissionSet = (PermissionSet) request.getSession(false).getAttribute("permissionSet");
				PositionForm positionForm = (PositionForm) actionForm;
				PositionManager positionManager = new PositionManager();
				ArrayList<SimpleDataObject> filters = null;
				filters = positionManager.getPositionFilters(permissionSet, userId, positionForm.getFilterFor(),
						positionForm.getShowCondition(), positionForm.getPositionId(),
						positionForm.getPositionOwnerId(), positionForm.getDepartmentId(),
						positionForm.getSubDepartmentId(), positionForm.getSubSubDepartmentId(),
						positionForm.getSub3DepartmentId(), positionForm.getSub4DepartmentId(),
						positionForm.getRecruiterId(), positionForm.getLocationId(),
						positionForm.getPositionTypeExtInt(), positionForm.getSkillId(),
						positionForm.getPositionName());
				String xml = PositionUtils.getXMLForFilter(filters, positionForm.getFilterFor(),
						positionForm.getPositionId(), positionForm.getPositionOwnerId(), positionForm.getDepartmentId(),
						positionForm.getSubDepartmentId(), positionForm.getSubSubDepartmentId(),
						positionForm.getSub3DepartmentId(), positionForm.getSub4DepartmentId(),
						positionForm.getRecruiterId(), positionForm.getLocationId(),
						positionForm.getPositionTypeExtInt(), positionForm.getSkillId(),
						positionForm.getPositionName());
				String selectedLink = getSelectedLink(filters, positionForm.getFilterFor(),
						positionForm.getPositionId(), positionForm.getPositionOwnerId(), positionForm.getDepartmentId(),
						positionForm.getSubDepartmentId(), positionForm.getSubSubDepartmentId(),
						positionForm.getSub3DepartmentId(), positionForm.getSub4DepartmentId(),
						positionForm.getRecruiterId(), positionForm.getLocationId(),
						positionForm.getPositionTypeExtInt(), positionForm.getSkillId(),
						positionForm.getPositionName());
				xmlFile = XSLTransformer.getTransformedXMLusingXSL(xml, XSLTransformer.XSL_SELECT_FILTER);
				xmlFile = positionForm.getFilterFor() + "|" + selectedLink + "|" + xmlFile;
				// TPLogger.getLogger().debug(xmlFile);
			}
		} catch (Exception e) {
			TPLogger.getLogger().error(GlobalConstants.ERROR, e);
			xmlFile = Utils.getXMLForError();
		}
		request.setAttribute("xmlFile", xmlFile);
		return mapping.findForward(forward);
	}

	private String getSelectedLink(ArrayList<SimpleDataObject> filters, String filterFor, String positionId,
			String positionOwnerId, String departmentId, String subDepartmentId, String subSubDepartmentId,
			String sub3DepartmentId, String sub4DepartmentId, String recruiterId, String locationId,
			String positionTypeExtInt, String skillId, String positionName) {
		String selLink = "";
		try {
			String selectedId = "";
			if (filterFor.equals(PositionConstants.FILTER_POSITION_OWNER)) {
				selectedId = positionOwnerId;
			}
			if (filterFor.equals(PositionConstants.FILTER_DEPARTMENT)) {
				selectedId = departmentId;
			} else if (filterFor.equals(PositionConstants.FILTER_SUB_DEPARTMENT)) {
				selectedId = subDepartmentId;
			} else if (filterFor.equals(PositionConstants.FILTER_SUB_SUB_DEPARTMENT)) {
				selectedId = subSubDepartmentId;
			} else if (filterFor.equals(PositionConstants.FILTER_SUB3_DEPARTMENT)) {
				selectedId = sub3DepartmentId;
			} else if (filterFor.equals(PositionConstants.FILTER_SUB4_DEPARTMENT)) {
				selectedId = sub4DepartmentId;
			} else if (filterFor.equals(PositionConstants.FILTER_POSITION)) {
				selectedId = positionId;
			} else if (filterFor.equals(PositionConstants.FILTER_RECRUITER)) {
				selectedId = recruiterId;
			} else if (filterFor.equals(PositionConstants.FILTER_LOCATION)) {
				selectedId = locationId;
			} else if (filterFor.equals(PositionConstants.FILTER_POSITION_TYPE)) {
				selectedId = positionTypeExtInt;
			} else if (filterFor.equals(PositionConstants.FILTER_PRIMARY_SKILLS)) {
				selectedId = skillId;
			}

			for (int i = 0; filters != null && i < filters.size(); i++) {
				SimpleDataObject sdo = filters.get(i);
				String filterId = sdo.getString("filterId");
				String filterShortName = sdo.getString("filterShortName");

				if (filterFor.equals(PositionConstants.FILTER_POSITION_TYPE)) {
					if (filterId.equals(PositionConstants.POSITIONS_TYPE_INTERNAL)) {
						filterShortName = TPLabels.getLabel("position.description.position_type_internal");
						// filterFullName =
						// TPLabels.getLabel("position.description.position_type_internal");
					} else if (filterId.equals(PositionConstants.POSITIONS_TYPE_EXTERNAL)) {
						filterShortName = TPLabels.getLabel("position.description.position_type_external");
						// filterFullName =
						// TPLabels.getLabel("position.description.position_type_external");
					} else {
						filterShortName = TPLabels.getLabel("position.description.position_type_not_set");
					}
				}

				if (!Utils.isBlankOrNull(filterId)) {
					if (filterId.equals(selectedId)) {
						selLink = filterShortName;
						break;
					}
				}
			}
		} catch (Exception e) {
			TPLogger.getLogger().error(GlobalConstants.ERROR, e);
		}
		return selLink;
	}

	public ActionForward copyPosition(ActionMapping mapping, ActionForm actionForm, HttpServletRequest request,
			HttpServletResponse response) throws Exception {
		if (!SessionManager.validateSession(mapping, actionForm, request, response, this)) {
			return null;
		}
		String forward = "hiringProcess";

		Integer[] permissions = new Integer[1];
		permissions[0] = PermissionConstants.PERMISSION_POSITIONS;
		if (!isUserAuthorized(request, CommonConstants.NO_MODULE, permissions, null, null, null)) {
			forward = getAuthorizationFailureForward();
			return mapping.findForward(forward);
		}

		String userId = (String) request.getSession(false).getAttribute("userId");
		String userRoleId = (String) request.getSession(false).getAttribute("userRoles");

		PositionForm form = (PositionForm) actionForm;
		String positionId = form.getPositionId();
		String step = form.getStep();

		ActionErrors errors = new ActionErrors();

		PositionManager positionManager = null;
		try {
			positionManager = new PositionManager();

			if (step == null) {
				Map attributesMap = new HashMap();
				SimpleDataObject positionDescription = (SimpleDataObject) positionManager
						.getPositionDescriptionToEdit(positionId);

				if (GlobalConstants.ENABLED.equals(
						GlobalApplicationProperties.getProperty(GlobalConstants.PROPERTY_COPY_POSITION_WITH_CODE))) {
					if (!Utils.isBlankOrNull(positionDescription.getString("positionCode"))) {
						String copyPositionCode = getCopyPositionCode(positionDescription.getString("positionCode"),
								positionId);
						positionDescription.setAttribute("positionCode", copyPositionCode);
						positionDescription.setAttribute("positionClone", PositionConstants.POSITIONS_CLONE);
					} else {
						positionDescription.setAttribute("positionCode", null);
						positionDescription.setAttribute("positionClone", PositionConstants.POSITIONS_NOT_CLONE);
					}
				} else {
					positionDescription.setAttribute("positionCode", null);
					positionDescription.setAttribute("positionClone", PositionConstants.POSITIONS_NOT_CLONE);
				}

				if (!form.getShowCondition().equals(PositionConstants.POSITION_STATUS_TEMPLATE)) {
					positionDescription.setAttribute("positionName", null);
					positionDescription.setAttribute("vacancies", null);
				}

				/**
				 * Geometric Change: if the No. of vacancy at application
				 * setting is zero or null vacancy is populated as blank, other
				 * wise with the vacancy value set at application setting.
				 */
				// positionDescription.setAttribute("vacancies", null);
				if (Utils
						.isBlankOrNull(GlobalApplicationProperties
								.getProperty(GlobalConstants.PROPERTY_DEFAULT_NUMBER_OF_VACANCY))
						| GlobalApplicationProperties.getProperty(GlobalConstants.PROPERTY_DEFAULT_NUMBER_OF_VACANCY)
								.equals("0")) {
					positionDescription.setAttribute("vacancies", null);
				} else {
					positionDescription.setAttribute("vacancies", GlobalApplicationProperties
							.getProperty(GlobalConstants.PROPERTY_DEFAULT_NUMBER_OF_VACANCY));
				}

				attributesMap.putAll(positionDescription.getAttributes());
				attributesMap.putAll(
						((SimpleDataObject) positionManager.getPositionRequirementsToEdit(positionId)).getAttributes());
				positionDescription.setAttributes(attributesMap);

				Calendar calendar = new GregorianCalendar();
				calendar.set(Calendar.DATE, (calendar.get(Calendar.DATE) + Integer.parseInt(GlobalApplicationProperties
						.getProperty(GlobalConstants.PROPERTY_DEFAULT_HIRE_BY_DURATION_IN_DAYS))));
				Date dt = calendar.getTime();
				positionDescription.setAttribute("hireByDate",
						Utils.getDateConvertedToString(dt, Utils.regEUDateFormat));

				if (!form.getPositionStatus().equals(PositionConstants.POSITION_STATUS_TEMPLATE)) {
					RequisitionFeedbackManager requisitionFeedbackManager = new RequisitionFeedbackManager();
					RequisitionFeedbackData requisitionFeedbackData = requisitionFeedbackManager
							.getFirstRequisitionFeedbackDataForPosition(positionId);

					if (requisitionFeedbackData != null) {
						positionDescription.setAttribute("approvalDecision",
								requisitionFeedbackData.getFeedbackDecision());
						positionDescription.setAttribute("nextUserId", requisitionFeedbackData.getToUserId());
						positionDescription.setAttribute("approvalComment",
								requisitionFeedbackData.getFeedbackComment());
						positionDescription.setAttribute("notifyUserIds", requisitionFeedbackData.getToUserId());
						positionDescription.setAttribute("fromApprovalStepId", requisitionFeedbackData.getFromStepId());
						positionDescription.setAttribute("toApprovalStepId", requisitionFeedbackData.getToStepId());
					}
				}
				positionDescription.setAttribute("requisitionApprovalTemplateId",
						positionManager.getRequisitionApprovalTemplateId(positionId));

				request.getSession(false).setAttribute(positionId, positionDescription);
				form.setDir(PositionConstants.DIR_COPY_POSITION);
				return description(mapping, actionForm, request, response);
			}
			String clientIpAddr = getClientIpAddr(request);
			if (NavigationConstants.STEP_POSITION_DESCRIPTION.equalsIgnoreCase(step)) {
				ArrayList<CustomFieldData> customFields = null;
				CustomFieldDataProcessor customFieldDataProcessor = new CustomFieldDataProcessor();
				if (CustomFieldManager.isCustomFieldsAvailable(CustomFieldConstants.ENTITY_TYPE_POSITION)) {
					CustomFieldManager customFieldManager = new CustomFieldManager();
					customFields = customFieldManager.getCustomFieldsForInputAllowed(
							CustomFieldConstants.ENTITY_TYPE_POSITION, CustomFieldConstants.INPUT_ALLOWED, true);
					customFields = customFieldDataProcessor.setCustomFieldValuesFromRequest(request, customFields);
					request.setAttribute("customFields", customFields);
				}

				errors = validateDescription(form, customFields);
				// added for duplicate position detect and send email
				String fieldValueDataString = "";
				String duplicateRecord = form.getIgnoreDuplicate();
				if (Utils.isBlankOrNull(duplicateRecord)) {
					fieldValueDataString = checkForDuplicatePositionRecord(form.getPositionId(), form.getPositionName(),
							customFields);
					if (!Utils.isBlankOrNull(fieldValueDataString)) {
						if (GlobalConstants.ENABLED.equals(GlobalApplicationProperties.getProperty(
								GlobalConstants.PROPERTY_DUPLICATE_POSITION_ALERT_NOTIFICATION_TO_ADMIN))) {
							sendEmailForDuplicatePositionsCreation(
									TemplateConstants.TEMPLATE_TYPE_POSITION_DUPLICATE_ALERT_NOTIFICATION_TO_ADMIN,
									userId, fieldValueDataString);
						}

					}
				}

				// end of duplicate position detect
				if (errors == null || errors.size() == 0) {
					// Save position description.
					SimpleDataObject position = (SimpleDataObject) request.getSession(false)
							.getAttribute(form.getPositionId());
					populatePositionDescriptionInObject(form, position);

					position.setAttribute("customFields", customFields);

					if (form.getFinishCopyPosition().equals("true")) {
						populatePositionRequirementsOnForm(form, position);
						errors = validateRequirements(form);
						if (errors == null || errors.size() == 0) {
							boolean isTemplateAccessible = false;
							RequisitionManager requisitionManager = new RequisitionManager();
							ArrayList<SimpleDataObject> requisitionApprovalTemplates = requisitionManager
									.getUserRequisitionApprovalTemplates(userId);
							for (SimpleDataObject requisitionApprovalTemplate : requisitionApprovalTemplates) {
								if (position.getString("requisitionApprovalTemplateId")
										.equals(requisitionApprovalTemplate.getString("templateId"))) {
									isTemplateAccessible = true;
								}
							}
							if (isTemplateAccessible) {
								populatePositionApprovalOnForm(form, position);
								errors = validateApproval(form, userId, position.getString("approvalDecision"),
										position.getString("nextUserId"));
								if (errors == null || errors.size() == 0) {
									try {
										createPositionByObject(position, form, positionId, userId, errors,
												clientIpAddr);
										return positionsHome(mapping, actionForm, request, response);
									} catch (Exception e) {

									}
								} else {
									saveErrors(request, errors);
									return approval(mapping, actionForm, request, response);
								}
							} else {
								position.setAttribute("requisitionApprovalTemplateId", "");
								return approval(mapping, actionForm, request, response);
							}

						} else {
							populateRequirementsPage(form, userId, userRoleId, request);
							form.setDir(PositionConstants.DIR_COPY_POSITION);
							form.setStep(NavigationConstants.STEP_POSITION_REQUIREMENTS);
							form.setFinishCopyPosition("false");
							saveErrors(request, errors);
							request.setAttribute("fieldValueData", fieldValueDataString);
							forward = "requirements";
						}
					} else {
						form.setDir(PositionConstants.DIR_COPY_POSITION);
						form.setMode(PositionConstants.MODE_REQUIREMENTS);
						request.setAttribute("fieldValueData", fieldValueDataString);
						return requirements(mapping, actionForm, request, response);
					}
				} else {
					populateDescriptionPage(form, userId, userRoleId);
					form.setDir(PositionConstants.DIR_COPY_POSITION);
					form.setStep(NavigationConstants.STEP_POSITION_DESCRIPTION);
					form.setFinishCopyPosition("false");
					saveErrors(request, errors);
					forward = "description";
				}
			} else if (NavigationConstants.STEP_POSITION_REQUIREMENTS.equalsIgnoreCase(step)) {
				errors = new ActionErrors();

				if (PositionConstants.DEST_HIRING_PROCESS.equalsIgnoreCase(form.getDest())
						|| PositionConstants.DEST_APPROVAL.equalsIgnoreCase(form.getDest())
						|| form.getFinishCopyPosition().equals("true")) {
					errors = validateRequirements(form);
				}
				if (errors == null || errors.size() == 0) {
					// Save position requirements.
					SimpleDataObject position = (SimpleDataObject) request.getSession(false)
							.getAttribute(form.getPositionId());
					populatePositionRequirementsInObject(form, position);

					boolean isTemplateAccessible = false;
					RequisitionManager requisitionManager = new RequisitionManager();
					ArrayList<SimpleDataObject> requisitionApprovalTemplates = requisitionManager
							.getUserRequisitionApprovalTemplates(userId);
					for (SimpleDataObject requisitionApprovalTemplate : requisitionApprovalTemplates) {
						if (position.getString("requisitionApprovalTemplateId")
								.equals(requisitionApprovalTemplate.getString("templateId"))) {
							isTemplateAccessible = true;
						}
					}

					if (form.getFinishCopyPosition().equals("true")) {

						if (isTemplateAccessible) {
							populatePositionApprovalOnForm(form, position);
							errors = validateApproval(form, userId, position.getString("approvalDecision"),
									position.getString("nextUserId"));
							if (errors == null || errors.size() == 0) {
								String pId = positionManager
										.getPositionIdFromPositionCode(position.getString("positionCode"));
								if (Utils.isBlankOrNull(pId)) {
									try {
										createPositionByObject(position, form, positionId, userId, errors,
												clientIpAddr);
										return positionsHome(mapping, actionForm, request, response);
									} catch (Exception e) {

									}
								} else {
									errors.add("position.add_new.error.duplicate_code",
											new ActionError("position.add_new.error.duplicate_code",
													TPLabels.getLabel("common.position_code") + " '"
															+ position.getString("positionCode") + "' "));
								}
								form.setDir(PositionConstants.DIR_COPY_POSITION);
							} else {
								saveErrors(request, errors);
								return approval(mapping, actionForm, request, response);
							}
						} else {
							position.setAttribute("requisitionApprovalTemplateId", "");
							return approval(mapping, actionForm, request, response);
						}
					} else {
						form.setDir(PositionConstants.DIR_COPY_POSITION);
						if (PositionConstants.DEST_DESCRIPTION.equalsIgnoreCase(form.getDest())) {
							return description(mapping, actionForm, request, response);
						} else if (PositionConstants.DEST_APPROVAL.equalsIgnoreCase(form.getDest())) {
							if (!isTemplateAccessible) {
								position.setAttribute("requisitionApprovalTemplateId", "");
							}
							return approval(mapping, actionForm, request, response);
						} else if (PositionConstants.DEST_HIRING_PROCESS.equalsIgnoreCase(form.getDest())) {
							return hiringProcess(mapping, actionForm, request, response);
						}
					}
				} else {
					populateRequirementsPage(form, userId, userRoleId, request);
					form.setDir(PositionConstants.DIR_COPY_POSITION);
					form.setStep(NavigationConstants.STEP_POSITION_REQUIREMENTS);
					form.setFinishCopyPosition("false");
					saveErrors(request, errors);
					forward = "requirements";
				}
			} else if (NavigationConstants.STEP_POSITION_APPROVAL.equalsIgnoreCase(step)) {
				errors = new ActionErrors();

				if (!PositionConstants.DEST_REQUIREMENTS.equalsIgnoreCase(form.getDest())) {
					errors = validateApproval(form, userId, form.getFeedbackDecision(), form.getNextUserId());
				}
				if (errors == null || errors.size() == 0) {
					SimpleDataObject position = (SimpleDataObject) request.getSession(false)
							.getAttribute(form.getPositionId());
					populatePositionApprovalInObject(form, position);
					form.setDir(PositionConstants.DIR_COPY_POSITION);
					if (PositionConstants.DEST_REQUIREMENTS.equalsIgnoreCase(form.getDest())) {
						return requirements(mapping, actionForm, request, response);
					} else {
						// Save the position.
						// Goto Positions Home Page.
						forward = "approval";
						String pId = positionManager.getPositionIdFromPositionCode(position.getString("positionCode"));
						if (Utils.isBlankOrNull(pId)) {
							try {
								createPositionByObject(position, form, positionId, userId, errors, clientIpAddr);
								return positionsHome(mapping, actionForm, request, response);
							} catch (Exception e) {

							}
						} else {
							errors.add("position.add_new.error.duplicate_code",
									new ActionError("position.add_new.error.duplicate_code",
											TPLabels.getLabel("common.position_code") + " '"
													+ position.getString("positionCode") + "' "));
						}
						form.setDir(PositionConstants.DIR_COPY_POSITION);
					}
				}
				if (errors != null && errors.size() > 0) {
					saveErrors(request, errors);
					return approval(mapping, actionForm, request, response);
				}
			}
		} catch (Exception e) {
			TPLogger.getLogger().error("Error encountered while creating new position", e);
			ActionError error = new ActionError("position.add_new.error", TPLabels.getLabel("common.position"));
			errors.add("position.add_new.error", error);
			saveErrors(request, errors);
			if (forward.equals("approval")) {
				return approval(mapping, actionForm, request, response);
			}
			List<SimpleDataObject> steps = parseJSArraySteps(form.getJsArrayHiringProcess(), positionId);
			populateHiringProcessPage(form, steps, userId, userRoleId);
			form.setDir(PositionConstants.DIR_COPY_POSITION);
		}
		return mapping.findForward(forward);
	}

	private void createPositionByObject(SimpleDataObject position, PositionForm form, String positionId, String userId,
			ActionErrors errors, String clientIpAddr) throws Exception {
		try {
			if (form.getPositionStatus().equals(PositionConstants.POSITION_STATUS_TEMPLATE)) {
				position.setAttribute("positionStatus", PositionConstants.POSITION_STATUS_TEMPLATE);
				position.setAttribute("hireByDate", Utils.getDateConvertedToString(new Date(), Utils.regEUDateFormat));
				position.setAttribute("vacancies", "0");
			} else {
				position.setAttribute("positionStatus", PositionConstants.POSITION_STATUS_INPROCESS);
			}
			position.setAttribute("draftId", form.getDraftId());
			PositionManager positionManager = new PositionManager();
			String newPositionId = positionManager.addNewPosition(position, form.getTrackModeNotifications(), userId,
					true);

			positionManager.copySteps(positionId, newPositionId);

			DocumentManager documentManager = new DocumentManager();
			documentManager.copyPositionDocuments(positionId, newPositionId);

			AuditAction auditAction = new AuditAction();
			auditAction.insertAuditInfo(TPLabels.getLabel("common.position"), AuditConstants.TYPE_ADDED, newPositionId,
					AuditConstants.AUDIT_POSITION, userId, null, null, null, true, clientIpAddr);

			if (!form.getPositionStatus().equals(PositionConstants.POSITION_STATUS_TEMPLATE)) {
				RecentViewManager recentViewManager = new RecentViewManager();
				recentViewManager.addLastViewedEntry(newPositionId, UserConstants.ENTITY_POSITION, userId);

				form.setShowCondition(PositionConstants.POSITION_STATUS_OPENED);

				RequisitionFeedbackManager requisitionFeedbackManager = new RequisitionFeedbackManager();

				requisitionFeedbackManager.addFeedback(newPositionId,
						(String) position.getAttribute("fromApprovalStepId"),
						(String) position.getAttribute("toApprovalStepId"), userId,
						(String) position.getAttribute("nextUserId"),
						(String) position.getAttribute("approvalDecision"),
						(String) position.getAttribute("approvalComment"),
						(String) position.getAttribute("notifyUserIds"));

				ToDoManager toDoManager = new ToDoManager();
				toDoManager.regenerateToDo(newPositionId, null, null);
			}

		} catch (SQLException sqe) {
			errors.add("position.add_new.error.duplicate_code", new ActionError("position.add_new.error.duplicate_code",
					TPLabels.getLabel("common.position_code") + " '" + position.getString("positionCode") + "' "));
			throw new Exception();
		} catch (Exception e) {
			ActionError error = new ActionError("position.add_new.error", TPLabels.getLabel("common.position"));
			errors.add("position.add_new.error", error);
			throw new Exception();
		}
	}

	public ActionForward printPosition(ActionMapping mapping, ActionForm actionForm, HttpServletRequest request,
			HttpServletResponse response) throws Exception {
		if (!SessionManager.validateSession(mapping, actionForm, request, response, this)) {
			return null;
		}
		String forward = "printPosition";

		Integer[] permissions = new Integer[1];
		permissions[0] = PermissionConstants.PERMISSION_POSITIONS;
		PositionForm form = (PositionForm) actionForm;
		String positionId = form.getPositionId();

		if (!isUserAuthorized(request, CommonConstants.NO_MODULE, permissions, null, positionId, null)) {
			forward = getAuthorizationFailureForward();
			return mapping.findForward(forward);
		}

		PositionManager positionManager = null;
		PositionData posData = null;
		ArrayList<PositionFieldData> posFieldData = null;
		ArrayList<CustomFieldData> customFields = null;
		ArrayList<CustomFieldData> customFields1 = null;
		CustomFieldManager customFieldManager = null;
		try {

			positionManager = new PositionManager();
			customFieldManager = new CustomFieldManager();

			if (!Utils.isBlankOrNull(positionId)) {
				posData = positionManager.getPositionDataForaPosition(positionId);
			} else {
				throw new Exception("positionId is null");
			}

			if (posData != null) {
				posFieldData = PositionScreenConfigurationManager.getPositionScreenFields();
				customFields1 = customFieldManager.getCustomFieldDataForEntity(positionId,
						CustomFieldConstants.ENTITY_TYPE_POSITION);
				if (CustomFieldManager.isCustomFieldsAvailable(CustomFieldConstants.ENTITY_TYPE_POSITION)) {
					customFields = customFieldManager.getCustomFieldsForInputAllowed(
							CustomFieldConstants.ENTITY_TYPE_POSITION, CustomFieldConstants.INPUT_ALLOWED, true);
					CustomFieldDataProcessor customFieldDataProcessor = new CustomFieldDataProcessor();
					customFields = customFieldDataProcessor.setCustomFieldValuesFromPreviousValues(customFields,
							customFields1);
					request.setAttribute("customFields", customFields);
				}
				request.setAttribute("posData", posData);
				request.setAttribute("posFieldData", posFieldData);
				request.setAttribute("customFields", customFields);
			} else {
				throw new Exception(
						"Invalid Position Id or Error While getting the Position Data for position Id" + positionId);
			}

		} catch (Exception e) {
			TPLogger.getLogger().error("Error encountered while Printing the Position Details", e);
		}
		return mapping.findForward(forward);
	}

	public ActionForward positionSummary(ActionMapping mapping, ActionForm actionForm, HttpServletRequest request,
			HttpServletResponse response) throws Exception {
		if (!SessionManager.validateSession(mapping, actionForm, request, response, this)) {
			return null;
		}
		String forward = "positionSummary";

		Integer[] permissions = new Integer[1];
		permissions[0] = PermissionConstants.PERMISSION_POSITIONS;

		if (!isUserAuthorized(request, CommonConstants.NO_MODULE, permissions, null,
				((PositionForm) actionForm).getPositionId(), null)) {
			forward = getAuthorizationFailureForward();
			return mapping.findForward(forward);
		}

		SimpleDataObject positionDescription = null;
		PositionManager positionManager = new PositionManager();
		PositionForm form = (PositionForm) actionForm;
		String positionId = form.getPositionId();
		String userId = (String) request.getSession().getAttribute("userId");
		PermissionSet permissionSet = (PermissionSet) request.getSession(false).getAttribute("permissionSet");
		request.setAttribute("t", NavigationConstants.T_POSITIONS);

		positionDescription = (SimpleDataObject) positionManager.getPositionSummaryDetails(positionId);
		populatePositionDescriptionOnForm(form, positionDescription, userId, permissionSet);

		request.setAttribute("daysRemaining", positionDescription.getAttribute("daysRemaining"));
		PositionUtils.setPositionSummaryLeftPanel(request, userId, permissionSet);

		RecentViewManager recentViewManager = new RecentViewManager();
		recentViewManager.addLastViewedEntry(positionId, UserConstants.ENTITY_POSITION, userId);

		return mapping.findForward(forward);
	}

	public ActionForward positionDocuments(ActionMapping mapping, ActionForm actionForm, HttpServletRequest request,
			HttpServletResponse response) throws Exception {
		if (!SessionManager.validateSession(mapping, actionForm, request, response, this)) {
			return null;
		}
		String forward = "positionDocuments";
		PositionForm form = (PositionForm) actionForm;
		String positionId = form.getPositionId();
		PositionManager positionManager = null;
		SimpleDataObject position = null;
		String positionName = null;
		String positionCode = null;

		Integer[] permissions = new Integer[1];
		permissions[0] = PermissionConstants.PERMISSION_POSITIONS;
		if (!isUserAuthorized(request, CommonConstants.NO_MODULE, permissions, null, positionId, null)) {
			forward = getAuthorizationFailureForward();
			return mapping.findForward(forward);
		}

		if (request.getSession(false).getAttribute(positionId) == null) {
			positionManager = new PositionManager();
			position = positionManager.getPositionCodeAndName(form.getPositionId());
			if (!Utils.isBlankOrNull(position.getString("positionCode"))) {
				positionCode = position.getString("positionCode");
			}

			if (!Utils.isBlankOrNull(position.getString("positionName"))) {
				positionName = position.getString("positionName");
			}
		}

		request.setAttribute("positionCode", positionCode);
		request.setAttribute("positionName", positionName);
		form.setStep(NavigationConstants.ADD_POSITION_DOCUMENTS);
		form.setDir(PositionConstants.DIR_VIEW_POSITION);
		request.setAttribute("t", NavigationConstants.T_POSITIONS);
		request.setAttribute("requisitionManagement", PositionConstants.REQUISITION_MANAGEMENT_ENABLED);
		return mapping.findForward(forward);
	}

	private void populateDescriptionPage(PositionForm form, String userId, String userRoleId) {
		DepartmentManager departmentManager = new DepartmentManager();
