	public ActionForward publishPositions(ActionMapping mapping, ActionForm actionForm, HttpServletRequest request,
			HttpServletResponse response) {
		if (!SessionManager.validateSession(mapping, actionForm, request, response, this)) {
			return null;
		}
		String forward = "positionsToPublishForWalkIn";
		PositionForm form = (PositionForm) actionForm;
		Integer[] permissions = new Integer[2];
		permissions[0] = PermissionConstants.PERMISSION_POSITIONS;
		int module = CommonConstants.NO_MODULE;
		if (PositionConstants.PUBLISH_WALK_IN.equals(form.getPublishType())) {
			module = ModuleConstants.MODULE_WALKIN;
			permissions[1] = PermissionConstants.PERMISSION_PUBLISH_POSITION_FOR_WALK_IN;
		} else if (PositionConstants.PUBLISH_EMPLOYEE_PORTAL.equals(form.getPublishType())) {
			module = ModuleConstants.MODULE_EMPLOYEE;
			permissions[1] = PermissionConstants.PERMISSION_PUBLISH_POSITION_FOR_EMPLOYEE_PORTAL;
		}
		if (!isUserAuthorized(request, module, permissions, null, null, null)) {
			forward = getAuthorizationFailureForward();
			return mapping.findForward(forward);
		}

		try {
			String userId = (String) request.getSession(false).getAttribute("userId");
			PermissionSet permissionSet = (PermissionSet) request.getSession(false).getAttribute("permissionSet");

			String selectedPositions = form.getPositionsToBePublished();
			String deselectedPositions = form.getPositionsNotToBePublished();
			PositionManager positionManager = new PositionManager();
			String publishType = form.getPublishType();
			positionManager.updatePositionsPublished(selectedPositions, deselectedPositions, publishType);
			List<PositionData> positions = positionManager.getAllPositionsToPublish(userId, permissionSet);
			for (int i = 0; i < positions.size(); i++) {
				PositionData positionData = positions.get(i);
				if (publishType.equals(PositionConstants.PUBLISH_WALK_IN)) {
					positionData.setPublishedEmployeePortal("");
				} else if (publishType.equals(PositionConstants.PUBLISH_EMPLOYEE_PORTAL)) {
					positionData.setPublishedForWalkIn("");
				}
			}
			request.setAttribute("positions", positions);
			request.setAttribute("update", "1");
			request.setAttribute("t", NavigationConstants.T_POSITIONS);
			if (publishType.equals(PositionConstants.PUBLISH_WALK_IN)) {
				request.setAttribute("publish", PositionConstants.WALK_INS);
			} else if (publishType.equals(PositionConstants.PUBLISH_EMPLOYEE_PORTAL)) {
				request.setAttribute("publish", PositionConstants.EMPLOYEE_PORTAL);
			}
		} catch (SQLException e) {
			ActionErrors errors = new ActionErrors();
			ActionError error = new ActionError("position.publish_for_walk_in.error.update_positions",
					TPLabels.getLabel("common.positions"));
			errors.add("position.publish_for_walk_in.error.update_positions", error);
			saveErrors(request, errors);
		}
		return mapping.findForward(forward);
	}

	public ActionForward XMLActiveUsers(ActionMapping mapping, ActionForm actionForm, HttpServletRequest request,
			HttpServletResponse response) {
		String forward = "xmlFile";
		String xmlFile = "";
