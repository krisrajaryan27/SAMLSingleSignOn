	public ActionForward positionsHome(ActionMapping mapping, ActionForm actionForm, HttpServletRequest request,
			HttpServletResponse response) {
		if (!SessionManager.validateSession(mapping, actionForm, request, response, this)) {
			return null;
		}
		String forward = "positionsHome";
		Integer[] permissions = new Integer[1];
		permissions[0] = PermissionConstants.PERMISSION_POSITIONS;
		if (!isUserAuthorized(request, CommonConstants.NO_MODULE, permissions, null, null, null)) {
			forward = getAuthorizationFailureForward();
			return mapping.findForward(forward);
		}
		PositionForm form = (PositionForm) actionForm;
		try {
			String userId = (String) request.getSession().getAttribute("userId");
			request.setAttribute("t", NavigationConstants.T_POSITIONS);
			String forcePositionCreationFromTemplate = GlobalApplicationProperties
					.getProperty(GlobalConstants.PROPERTY_FORCE_POSITION_CREATION_FROM_TEMPLATE);

			boolean canAddRequisition = true;
			if (PositionConstants.REQUISITION_MANAGEMENT_ENABLED) {
				RequisitionManager requisitionManager = new RequisitionManager();
				if (!requisitionManager.isRequisitionAllowedForUser(userId)) {
					canAddRequisition = false;
				}
			}
			if (Utils.isBlankOrNull(form.getShowCondition())) {
				form.setShowCondition(PositionConstants.POSITION_STATUS_OPENED);
			}
			request.setAttribute("requisitionManagement", PositionConstants.REQUISITION_MANAGEMENT_ENABLED);
			request.setAttribute("canAddRequisition", canAddRequisition);
			request.setAttribute("forcePositionCreationFromTemplate", forcePositionCreationFromTemplate);
			UUID token = UUID.randomUUID();
			request.getSession().setAttribute("deletePositionTokenId", token.toString());
			setPositionSelectCritera(request);
			setMigrationStatus(request);
		} catch (Exception e) {
			TPLogger.getLogger().error("Error in position home", e);
		}
		return mapping.findForward(forward);
	}

	private void setPositionSelectCritera(HttpServletRequest request) {
		ArrayList<String> ids = new ArrayList<String>();
		ArrayList<String> names = new ArrayList<String>();
		ids.add(PositionConstants.POSITION_STATUS_OPENED);
		ids.add(PositionConstants.POSITION_STATUS_CLOSED);
		ids.add(PositionConstants.POSITION_STATUS_HOLD);
		ids.add(PositionConstants.POSITION_STATUS_DROPPED);
		if (PositionConstants.REQUISITION_MANAGEMENT_ENABLED) {
			ids.add(PositionConstants.POSITION_STATUS_INPROCESS);
			ids.add(PositionConstants.POSITION_STATUS_MY_APPROVAL_PENDING);
			ids.add(PositionConstants.POSITION_STATUS_TO_BE_OPENED);
			ids.add(PositionConstants.POSITION_STATUS_REJECTED);
		}
		names.add(TPLabels.getLabel("positions_home.label.show_open_positions"));
		names.add(TPLabels.getLabel("positions_home.label.show_closed_positions"));
		names.add(TPLabels.getLabel("positions_home.label.show_hold_positions"));
		names.add(TPLabels.getLabel("positions_home.label.show_dropped_positions"));
		if (PositionConstants.REQUISITION_MANAGEMENT_ENABLED) {
			names.add(TPLabels.getLabel("positions_home.label.show_open_requisitions"));
			names.add(TPLabels.getLabel("positions_home.label.my_approval_pending"));
			names.add(TPLabels.getLabel("positions_home.label.show_to_be_opened"));
			names.add(TPLabels.getLabel("positions_home.label.show_rejected_requisitions"));
		}
		String JSCriteria = CommonUtils.getListJavaScriptArray(ids, names);
		request.setAttribute("JSCriteria", JSCriteria);
	}

	public ActionForward XMLforPositions(ActionMapping mapping, ActionForm actionForm, HttpServletRequest request,
			HttpServletResponse response) {
		String forward = "xmlFile";
		if (!SessionManager.isLoginFound(mapping, actionForm, request, response, this)) {
			request.setAttribute("xmlFile", Utils.getXMLForSessionExpiry());
			return mapping.findForward(forward);
		}
		Integer[] permissions = new Integer[1];
		permissions[0] = PermissionConstants.PERMISSION_POSITIONS;
		if (!isUserAuthorized(request, CommonConstants.NO_MODULE, permissions, null, null, null)) {
			forward = getAuthorizationFailureForward();
			return mapping.findForward(forward);
		}
		try {
			PositionForm positionForm = (PositionForm) actionForm;
			String userId = (String) request.getSession(false).getAttribute("userId");
			PermissionSet permissionSet = (PermissionSet) request.getSession(false).getAttribute("permissionSet");
			PositionManager positionManager = new PositionManager();
			ArrayList positions = positionManager.getAllPositions(positionForm.getPositionOwnerId(),
					positionForm.getDepartmentId(), positionForm.getSubDepartmentId(),
					positionForm.getSubSubDepartmentId(), positionForm.getSub3DepartmentId(),
					positionForm.getSub4DepartmentId(), positionForm.getRecruiterId(), positionForm.getLocationId(),
					positionForm.getPositionTypeExtInt(), positionForm.getSkillId(), positionForm.getPositionName(),
					positionForm.getShowCondition(), positionForm.getCustomFieldFilterId(),
					positionForm.getCustomFieldFilterType(), positionForm.getCustomFieldFilterValue(), userId,
					permissionSet);
			PositionXMLGenerator positionXMLGenerator = new PositionXMLGenerator();
			String xmlFile = positionXMLGenerator.getXMLforPositionsHome(positions, userId, permissionSet);
			request.setAttribute("xmlFile", xmlFile);
			request.setAttribute("positions", positions);
		} catch (Exception e) {
			TPLogger.getLogger().error("Error in getting XML:", e);
		}

		return mapping.findForward(forward);
	}

	public ActionForward deletePosfromDB(ActionMapping mapping, ActionForm actionForm, HttpServletRequest request,
			HttpServletResponse response) {
		String forward = "xmlFile";
		String xmlFile = "";
		AuditAction auditAction = new AuditAction();
		ArrayList<String> errors = new ArrayList<String>();
		Integer[] permissions = new Integer[2];
		permissions[0] = PermissionConstants.PERMISSION_POSITIONS;
		permissions[1] = PermissionConstants.PERMISSION_DELETE_POSITION;
		if (!isUserAuthorized(request, CommonConstants.NO_MODULE, permissions, null,
				((PositionForm) actionForm).getPositionId(), null)) {
			forward = getAuthorizationFailureForward();
			return mapping.findForward(forward);
		}
		try {
			if (!SessionManager.isLoginFound(mapping, actionForm, request, response, this)) {
				xmlFile = Utils.getXMLForSessionExpiry();
			} else {
				String userId = (String) request.getSession(false).getAttribute("userId");
				PositionForm positionForm = (PositionForm) actionForm;

				String deletePositionTokenId = (String) request.getSession().getAttribute("deletePositionTokenId");
				if (Utils.isBlankOrNull(deletePositionTokenId)
						|| !deletePositionTokenId.equals(positionForm.getDeletePositionTokenId())) {
					SessionManager.invalidateSession(request, response, userId);
					try {
						SessionManager.sessionExpireRedirect(mapping, actionForm, request, response, this, false);
						TPLogger.getLogger().error(
								"Invalid CSRFToken while deleting Position. Session invalidated because of suspicious activity.");
						return null;
					} catch (Exception e) {
						TPLogger.getLogger().error("Error While validating session", e);
					}
				}
				String positionId = positionForm.getPositionId();
				PositionManager positionManager = new PositionManager();
				positionManager.updatePositionNaukriStatus(positionId, true);

				if (!Utils.isBlankOrNull(positionId)) {
					PositionData positionData = positionManager.getPositionSummary(positionId);
					if (positionData.getPositionStatus().equals(PositionConstants.POSITION_STATUS_OPENED)) {
						int candidatesInProcess = positionManager.getNoOfCandidatesInProcess(positionId);
						if (candidatesInProcess > 0) {
							errors.add(TPLabels.getLabel("common.position") + " "
									+ TPLabels.getLabel("position.home.error.cannot_delete"));
							xmlFile = Utils.getXMLForError(errors);
						}
					} else if (positionData.getPositionStatus().equals(PositionConstants.POSITION_STATUS_INPROCESS)) {
						errors.add(TPLabels.getLabel("position.home.error.requisition_open_can_not_delete"));
						xmlFile = Utils.getXMLForError(errors);
					}

					if (errors.size() == 0) {
						positionManager.changePositionStatus(positionForm.getPositionId(),
								PositionConstants.POSITION_STATUS_DELETED, userId, BudgetConstants.IS_BUDGET_COMMITTED,
								null);
						String clientIpAddr = getClientIpAddr(request);
						auditAction.insertAuditInfo(TPLabels.getLabel("common.position"), AuditConstants.TYPE_DELETED,
								positionId, AuditConstants.AUDIT_POSITION, userId, null, null, null, true,
								clientIpAddr);
						xmlFile = Utils.getXMLForIds(positionForm.getPositionId());
					}
				}
			}
		} catch (Exception e) {
			TPLogger.getLogger().error("Error while deleting Position", e);
			xmlFile = Utils.getXMLForError(null);
		}

		request.setAttribute("xmlFile", xmlFile);
		return mapping.findForward(forward);
	}

	public ActionForward description(ActionMapping mapping, ActionForm actionForm, HttpServletRequest request,
			HttpServletResponse response) throws Exception {
		String forward = "description";
		if (!SessionManager.validateSession(mapping, actionForm, request, response, this)) {
			return null;
		}
		String userId = (String) request.getSession().getAttribute("userId");
		PermissionSet permissionSet = (PermissionSet) request.getSession(false).getAttribute("permissionSet");

		String userRoleId = (String) request.getSession().getAttribute("userRoles");
		if (!(UserConstants.ROLE_ADMIN == Integer.parseInt(userRoleId)
				|| UserConstants.ROLE_HR_MANAGER == Integer.parseInt(userRoleId)
				|| UserConstants.ROLE_RECRUITER == Integer.parseInt(userRoleId))) {
			request.setAttribute("disableRequisitionerFlag", "1");
		}
		PositionForm form = (PositionForm) actionForm;
		String positionId = form.getPositionId();
		String dir = form.getDir();

		Integer[] permissions = new Integer[2];
		permissions[0] = PermissionConstants.PERMISSION_POSITIONS;
		if (Utils.isBlankOrNull(dir) || PositionConstants.DIR_VIEW_POSITION.equalsIgnoreCase(dir)) {
			permissions[1] = PermissionConstants.PERMISSION_POSITION_DETAILS;
		} else if (PositionConstants.DIR_EDIT_POSITION.equalsIgnoreCase(dir)) {
			if (PositionConstants.POSITION_STATUS_TEMPLATE.equals(form.getPositionStatus())) {
				permissions[1] = PermissionConstants.PERMISSION_CREATE_POSITION_TEMPLATE;
			} else {
				permissions[1] = PermissionConstants.PERMISSION_EDIT_POSITIONS;
			}
		} else if (PositionConstants.DIR_ADD_POSITION.equalsIgnoreCase(dir)
				|| PositionConstants.DIR_COPY_POSITION.equalsIgnoreCase(dir)) {
			boolean canAddRequisition = true;
			if (PositionConstants.REQUISITION_MANAGEMENT_ENABLED) {
				RequisitionManager requisitionManager = new RequisitionManager();
				if (!requisitionManager.isRequisitionAllowed(userId)) {
					canAddRequisition = false;
				}
			}
			if (!canAddRequisition) {
				forward = getAuthorizationFailureForward();
				return mapping.findForward(forward);
			}
			permissions = new Integer[1];
			permissions[0] = PermissionConstants.PERMISSION_POSITIONS;
		}
		String validPositionId = "";
		if (Utils.isBlankOrNull(dir) && !PositionConstants.DIR_ADD_POSITION.equalsIgnoreCase(dir)) {
			validPositionId = positionId;
		}
		if (!PositionConstants.DIR_COPY_POSITION.equalsIgnoreCase(dir)
				&& !isUserAuthorized(request, CommonConstants.NO_MODULE, permissions, null, validPositionId, null)) {
			forward = getAuthorizationFailureForward();
			return mapping.findForward(forward);
		}

		PositionManager positionManager = new PositionManager();
		SimpleDataObject positionDescription = new SimpleDataObject();
		if (Utils.isBlankOrNull(positionId) || PositionConstants.DIR_ADD_POSITION.equalsIgnoreCase(dir)
				|| PositionConstants.DIR_COPY_POSITION.equalsIgnoreCase(dir)) {
			// Add new position.
			if (dir == null) {
				form.setDir(PositionConstants.DIR_ADD_POSITION);
				form.setRequisitionerId(userId);
				setDefaultPositionOwnerId(form, userId, permissionSet);

				/**
				 * Geometric Change: if the No. of vacancy at application
				 * setting is zero or null vacancy is populated as blank, other
				 * wise with the vacancy value set at application setting.
				 */
				if (!Utils.isBlankOrNull(
						GlobalApplicationProperties.getProperty(GlobalConstants.PROPERTY_DEFAULT_NUMBER_OF_VACANCY))
						| !GlobalApplicationProperties.getProperty(GlobalConstants.PROPERTY_DEFAULT_NUMBER_OF_VACANCY)
								.equals("0")) {
					form.setVacancies(GlobalApplicationProperties
							.getProperty(GlobalConstants.PROPERTY_DEFAULT_NUMBER_OF_VACANCY));
				}

			}
			if (Utils.isBlankOrNull(positionId)) {
				positionId = String.valueOf(System.currentTimeMillis());
				request.getSession(false).setAttribute(positionId, new SimpleDataObject());
				form.setPositionId(positionId);
				form.setPositionClone(PositionConstants.POSITIONS_NOT_CLONE);
				Calendar calendar = new GregorianCalendar();
				calendar.set(Calendar.DATE, (calendar.get(Calendar.DATE) + Integer.parseInt(GlobalApplicationProperties
						.getProperty(GlobalConstants.PROPERTY_DEFAULT_HIRE_BY_DURATION_IN_DAYS))));
				Date dt = calendar.getTime();

				form.setHireByDate(Utils.getDateConvertedToString(dt, Utils.regEUDateFormat));
			} else {
				positionDescription = (SimpleDataObject) request.getSession(false).getAttribute(positionId);
				populatePositionDescriptionOnForm(form, positionDescription, userId, permissionSet);
			}

			form.setCopyFrom(PositionConstants.LIST_POSITIONS);
			populateDescriptionPage(form, userId, userRoleId);
		} else if (Utils.isBlankOrNull(dir) || PositionConstants.DIR_VIEW_POSITION.equalsIgnoreCase(dir)) {
			// View position description.
			form.setDir(PositionConstants.DIR_VIEW_POSITION);

			positionDescription = (SimpleDataObject) positionManager.getPositionDescriptionToView(positionId, userId,
					permissionSet);
			populatePositionDescriptionOnForm(form, positionDescription, userId, permissionSet);
			RecentViewManager recentViewManager = new RecentViewManager();
			recentViewManager.addLastViewedEntry(positionId, UserConstants.ENTITY_POSITION, userId);
			request.setAttribute("positionName", positionDescription.getString("positionName"));
			request.setAttribute("positionCode", positionDescription.getString("positionCode"));
		} else if (PositionConstants.DIR_EDIT_POSITION.equalsIgnoreCase(dir)) {
			// Edit position description.
			form.setDir(PositionConstants.DIR_EDIT_POSITION);

			positionDescription = (SimpleDataObject) positionManager.getPositionDescriptionToEdit(positionId);
			populatePositionDescriptionOnForm(form, positionDescription, userId, permissionSet);

			form.setCopyFrom(PositionConstants.LIST_POSITIONS);
			populateDescriptionPage(form, userId, userRoleId);
			request.setAttribute("positionName", positionDescription.getString("positionName"));
			request.setAttribute("positionCode", positionDescription.getString("positionCode"));
		}

		/*
		 * ArrayList<CustomFieldData> customFields = null; if
		 * (CustomFieldManager.isCustomFieldsAvailable(CustomFieldConstants.
		 * ENTITY_TYPE_POSITION)) { customFields = (ArrayList<CustomFieldData>)
		 * positionDescription.getAttribute("customFields"); if (customFields ==
		 * null || customFields.size() == 0) { CustomFieldManager
		 * customFieldManager = new CustomFieldManager(); customFields =
		 * customFieldManager.getCustomFieldsForInputAllowed(
		 * CustomFieldConstants.ENTITY_TYPE_POSITION,
		 * CustomFieldConstants.INPUT_ALLOWED, true); }
		 * request.setAttribute("customFields", customFields); }
		 */
		ArrayList<CustomFieldData> customFields = null;
		if (CustomFieldManager.isCustomFieldsAvailable(CustomFieldConstants.ENTITY_TYPE_POSITION)) {
			CustomFieldManager customFieldManager = new CustomFieldManager();
			customFields = customFieldManager.getCustomFieldsForInputAllowed(CustomFieldConstants.ENTITY_TYPE_POSITION,
					CustomFieldConstants.INPUT_ALLOWED, true);
			CustomFieldDataProcessor customFieldDataProcessor = new CustomFieldDataProcessor();
			customFields = customFieldDataProcessor.setCustomFieldValuesFromPreviousValues(customFields,
					(ArrayList<CustomFieldData>) positionDescription.getAttribute("customFields"));
			request.setAttribute("customFields", customFields);
		}
		form.setStep(NavigationConstants.STEP_POSITION_DESCRIPTION);
		request.setAttribute("t", NavigationConstants.T_POSITIONS);
		request.setAttribute("requisitionManagement", PositionConstants.REQUISITION_MANAGEMENT_ENABLED);
		return mapping.findForward(forward);
	}

	private void populatePositionDescriptionOnForm(PositionForm form, SimpleDataObject positionDescription,
			String userId, PermissionSet permissionSet) {
		form.setPositionName(positionDescription.getString("positionName"));
		form.setPositionCode(positionDescription.getString("positionCode"));
		form.setPositionOwnerName(positionDescription.getString("positionOwnerName"));
		setPositonOwnerIdOnForm(form, positionDescription, userId, permissionSet);
		// form.setRequisitionerId(positionDescription.getString("requisitionerId"));
		if (PositionConstants.DIR_COPY_POSITION.equals(form.getDir())
				&& (Utils.isBlankOrNull(positionDescription.getString("requisitionerId"))
						|| "-1".equals(positionDescription.getString("requisitionerId")))) {
			form.setRequisitionerId(userId);
		} else {
			form.setRequisitionerId(positionDescription.getString("requisitionerId"));
		}
		form.setRequisitioner(positionDescription.getString("requisitioner"));
		form.setLocationId(positionDescription.getString("locationId"));
		form.setLocationName(positionDescription.getString("locationName"));
		form.setDepartment(positionDescription.getString("department"));
		form.setSubDepartment(positionDescription.getString("subDepartment"));
		form.setSubSubDepartment(positionDescription.getString("subSubDepartment"));
		form.setSub3Department(positionDescription.getString("sub3Department"));
		form.setSub4Department(positionDescription.getString("sub4Department"));
		form.setDepartmentId(positionDescription.getString("departmentId"));
		form.setSubDepartmentId(positionDescription.getString("subDepartmentId"));
		form.setSubSubDepartmentId(positionDescription.getString("subSubDepartmentId"));
		form.setSub3DepartmentId(positionDescription.getString("sub3DepartmentId"));
		form.setSub4DepartmentId(positionDescription.getString("sub4DepartmentId"));
		form.setVacancies(positionDescription.getString("vacancies"));
		form.setHireByDate(positionDescription.getString("hireByDate"));
		form.setPositionLevel(positionDescription.getString("positionLevel"));
		form.setPositionReferalFees(positionDescription.getString("positionReferalFees"));
		form.setNote(positionDescription.getString("note"));
		String responsibilities = positionDescription.getString("responsibilities");
		form.setResponsibilities(responsibilities == null ? "" : responsibilities);
		// Bug:-154 Position Create Date on Position Tab
		form.setPositionCreateDate(positionDescription.getString("positionCreateDate"));

		form.setBudgetItemId(positionDescription.getString("budgetItemId"));
		form.setBudgetItemName(positionDescription.getString("budgetItemName"));
		form.setGradeId(positionDescription.getString("gradeId"));
		form.setGradeName(positionDescription.getString("gradeName"));
		form.setBandId(positionDescription.getString("bandId"));
		form.setBandName(positionDescription.getString("bandName"));
		form.setCurrentNoOfOpenings((positionDescription.getString("currentNoOfOpenings")));

		form.setBuId(positionDescription.getString("buId"));
		form.setBuName(positionDescription.getString("buName"));

		form.setCostCenterId(positionDescription.getString("costCenterId"));
		form.setCostCenterName(positionDescription.getString("costCenterName"));

		form.setTypeOfVacancy(positionDescription.getString("typeOfVacancy"));
		form.setReplacementEmpCode(positionDescription.getString("replacementEmpCode"));
		form.setPositionTypeExtInt(positionDescription.getString("positionTypeExtInt"));
