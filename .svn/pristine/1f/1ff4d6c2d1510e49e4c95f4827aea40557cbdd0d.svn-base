		// Added for Asian Paints BEGIN
		String dir = form.getDir();
		if (PositionConstants.DIR_EDIT_POSITION.equalsIgnoreCase(dir)) {
			form.setDir(PositionConstants.DIR_EDIT_POSITION);
			/*
			 * form.setJsArrayLocations(locationManager.getJSArrayLocationsById(
			 * form.getpLocationId()));
			 */
			form.setJsArrayLocations(locationManager.getJSArrayLocations());
			form.setJsArraySubLocations(locationManager.getJSArrayLocationsById(form.getpSubLocationId()));
			form.setJsArraySubSubLocations(locationManager.getJSArrayLocationsById(form.getpSubSubLocationId()));

			/*
			 * form.setJsArrayDepartments(departmentManager.
			 * getJSArrayDepartmentsById(form.getDepartmentId()));
			 * form.setJsArraySubDepartments(departmentManager.
			 * getJSArrayDepartmentsById(form.getSubDepartmentId()));
			 * form.setJsArraySubSubDepartments(departmentManager.
			 * getJSArrayDepartmentsById(form.getSubSubDepartmentId()));
			 */
			form.setJsArrayDepartments(departmentManager.getJSArrayDepartments());
			form.setJsArraySubDepartments(departmentManager.getJSArraySubDepartments(form.getDepartmentId()));
			form.setJsArraySubSubDepartments(departmentManager.getJSArraySubDepartments(form.getSubDepartmentId()));
			form.setJsArraySub3Departments(departmentManager.getJSArraySubDepartments(form.getSubSubDepartmentId()));
			form.setJsArraySub4Departments(departmentManager.getJSArraySubDepartments(form.getSub3DepartmentId()));

			/*
			 * form.setJsArrayJobFunction(departmentManager.
			 * getJSArrayJobFunctionById(form.getpJobFunctionId()));
			 * form.setJsArrayJobPayGrade(departmentManager.
			 * getJSArrayJobPayGradeById(form.getpJobPayGradeId()));
			 * form.setJsArrayJobCode(departmentManager.getJSArrayJobCodeById(
			 * form.getpJobCodeId()));
			 */
			form.setJsArrayJobFunction(departmentManager.getJSArrayJobFunction());
			form.setJsArrayJobPayGrade(departmentManager.getJSArrayJobPayGrade());
			form.setJsArrayJobCode(departmentManager.getJSArrayJobCode());

			form.setJsArrayCountry(locationManager.getJSArrayCountry());
			form.setJsArrayState(locationManager.getJSArrayState(form.getCountryId()));
		} else {
			form.setJsArrayLocations(locationManager.getJSArrayLocations());
			form.setJsArraySubLocations(locationManager.getJSArrayRegions(form.getpLocationId()));
			form.setJsArraySubSubLocations(locationManager.getJSArraySubLocations(form.getpSubLocationId()));

			form.setJsArrayDepartments(departmentManager.getJSArrayDepartments());
			form.setJsArraySubDepartments(departmentManager.getJSArraySubDepartments(form.getDepartmentId()));
			form.setJsArraySubSubDepartments(departmentManager.getJSArraySubDepartments(form.getSubDepartmentId()));
			form.setJsArraySub3Departments(departmentManager.getJSArraySubDepartments(form.getSubSubDepartmentId()));
			form.setJsArraySub4Departments(departmentManager.getJSArraySubDepartments(form.getSub3DepartmentId()));

			form.setJsArrayJobFunction(departmentManager.getJSArrayJobFunction());
			form.setJsArrayJobPayGrade(departmentManager.getJSArrayJobPayGrade());
			form.setJsArrayJobCode(departmentManager.getJSArrayJobCode());

			form.setJsArrayCountry(locationManager.getJSArrayCountry());
			form.setJsArrayState(locationManager.getJSArrayState(form.getCountryId()));
		}

		// Added for Asian Paints END

