					status = positionForm.getSubMode();
				}
				ArrayList positions = positionManager.getPositionListWithStatus(status, permissionSet, userId);
				xmlFile = PositionUtils.getXmlForPosition(positions);

			}
		} catch (Exception e) {
			TPLogger.getLogger().error(GlobalConstants.ERROR, e);
			ArrayList<String> errors = new ArrayList<String>();
			errors.add("1");
			xmlFile = Utils.getXMLForError(errors);
		}
		request.setAttribute("xmlFile", xmlFile);
		return mapping.findForward(forward);
	}

