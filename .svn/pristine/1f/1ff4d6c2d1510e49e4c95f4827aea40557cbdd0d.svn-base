	public ActionForward getEmployeeAnnouncementsToPublish(ActionMapping mapping, ActionForm actionForm,
			HttpServletRequest request, HttpServletResponse response) {
		if (!SessionManager.validateSession(mapping, actionForm, request, response, this)) {
			return null;
		}
		String forward = "employeeAnnouncements";
		PositionForm form = (PositionForm) actionForm;
		Integer[] permissions = new Integer[2];
		permissions[0] = PermissionConstants.PERMISSION_POSITIONS;
		int module = ModuleConstants.MODULE_EMPLOYEE;
		permissions[1] = PermissionConstants.PERMISSION_PUBLISH_POSITION_FOR_EMPLOYEE_PORTAL;

		if (!isUserAuthorized(request, module, permissions, null, null, null)) {
			forward = getAuthorizationFailureForward();
			return mapping.findForward(forward);
		}

		try {
			PositionPublishManager positionPublishManager = new PositionPublishManager();
			String announcements = positionPublishManager
					.getAnnouncementsToPublish(PositionConstants.EMPLOYEE_ANNOUNCEMENTS);
			form.setEmployeeAnnouncements(announcements);
			request.setAttribute("t", NavigationConstants.T_POSITIONS);
			request.setAttribute("publish", PositionConstants.EMPLOYEE_ANNOUNCEMENTS);
		} catch (Exception e) {
			TPLogger.getLogger().error(GlobalConstants.ERROR, e);
			ActionErrors errors = new ActionErrors();
			ActionError error = new ActionError("position.publish_for_walk_in.error.get_announcements");
			errors.add("position.publish_for_walk_in.error.get_announcements", error);
			saveErrors(request, errors);
		}
		return mapping.findForward(forward);
	}

	public ActionForward saveEmployeeAnnouncementsToPublish(ActionMapping mapping, ActionForm actionForm,
			HttpServletRequest request, HttpServletResponse response) {
		if (!SessionManager.validateSession(mapping, actionForm, request, response, this)) {
			return null;
		}
		String forward = "employeeAnnouncements";
		PositionForm form = (PositionForm) actionForm;
		Integer[] permissions = new Integer[2];
		permissions[0] = PermissionConstants.PERMISSION_POSITIONS;
		int module = ModuleConstants.MODULE_EMPLOYEE;
		permissions[1] = PermissionConstants.PERMISSION_PUBLISH_POSITION_FOR_EMPLOYEE_PORTAL;

		if (!isUserAuthorized(request, module, permissions, null, null, null)) {
			forward = getAuthorizationFailureForward();
			return mapping.findForward(forward);
		}
		try {
			String userId = (String) request.getSession(false).getAttribute("userId");
			PositionPublishManager positionPublishManager = new PositionPublishManager();
			positionPublishManager.updateAnnouncements(PositionConstants.EMPLOYEE_ANNOUNCEMENTS,
					form.getEmployeeAnnouncements(), userId);
			form.setEmployeeAnnouncements(form.getEmployeeAnnouncements());
			request.setAttribute("t", NavigationConstants.T_POSITIONS);
			request.setAttribute("publish", PositionConstants.EMPLOYEE_ANNOUNCEMENTS);
		} catch (Exception e) {
			TPLogger.getLogger().error(GlobalConstants.ERROR, e);
			ActionErrors errors = new ActionErrors();
			ActionError error = new ActionError("position.publish_for_walk_in.error.update_announcements");
			errors.add("position.publish_for_walk_in.error.update_announcements", error);
			saveErrors(request, errors);
		}
		return mapping.findForward(forward);
	}

	public ActionForward getPositionForShortlist(ActionMapping mapping, ActionForm actionForm,
			HttpServletRequest request, HttpServletResponse response) {
		String forward = "xmlFile";
