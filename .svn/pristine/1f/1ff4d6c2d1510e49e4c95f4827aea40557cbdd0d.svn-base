			ActionError error = new ActionError("position.publish_for_walk_in.error.get_positions",
					TPLabels.getLabel("common.positions"));
			errors.add("position.publish_for_walk_in.error.get_positions", error);
			saveErrors(request, errors);
		} catch (Exception e) {
			TPLogger.getLogger().error("Error in getting XML:", e);
		}
		return mapping.findForward(forward);
	}

	public ActionForward publishPositionToEmployeeOrWalkinPortal(ActionMapping mapping, ActionForm actionForm,
			HttpServletRequest request, HttpServletResponse response) {
		if (!SessionManager.validateSession(mapping, actionForm, request, response, this)) {
			return null;
		}
		String forward = "positionsToPublishForWalkInPopUp";
		PositionForm form = (PositionForm) actionForm;
		int module = CommonConstants.NO_MODULE;
		Integer[] permissions = new Integer[2];
		permissions[0] = PermissionConstants.PERMISSION_POSITIONS;

		if (PositionConstants.PUBLISH_WALK_IN.equals(form.getPublishType())) {
			module = ModuleConstants.MODULE_WALKIN;
			permissions[1] = PermissionConstants.PERMISSION_PUBLISH_POSITION_FOR_WALK_IN;
		} else if (PositionConstants.PUBLISH_EMPLOYEE_PORTAL.equals(form.getPublishType())) {
			module = ModuleConstants.MODULE_EMPLOYEE;
			permissions[1] = PermissionConstants.PERMISSION_PUBLISH_POSITION_FOR_EMPLOYEE_PORTAL;
		} else if (PositionConstants.PUBLISH_SOCIAL_MEDIA.equals(form.getPublishType())) {
			permissions[1] = PermissionConstants.PERMISSION_POST_JOB_ON_SOCIAL_MEDIA;
		}

		if (!isUserAuthorized(request, module, permissions, null, null, null)) {
			forward = getAuthorizationFailureForward();
			return mapping.findForward(forward);
		}

		ActionErrors errors = new ActionErrors();
		try {
			String positionId = form.getPositionId();
			PositionManager positionManager = new PositionManager();
			PositionData positionData = positionManager.getPositionSummary(positionId);

			String publishOrUnPublish = request.getParameter("publishOrUnPublish");

			if (positionData.getPositionStatus().equals(PositionConstants.POSITION_STATUS_OPENED)) {

				if (!Utils.isBlankOrNull(request.getParameter("isSubmitted"))) {

					if (publishOrUnPublish.equals(PositionConstants.PUBLISHED)) {
						positionManager.updatePositionsPublished(positionId, PositionConstants.PUBLISHED,
								form.getPublishType(), form.getPublishFrom(), form.getPublishTo(),
								form.getEmployeeApplyRefer(), form.getEmployeeCanEmail());
						if (form.getPublishType().equals(PositionConstants.PUBLISH_EMPLOYEE_PORTAL)) {
							if (GlobalApplicationProperties
									.getProperty(
											GlobalConstants.PROPERTY_SEND_POSITION_PUBLISHED_NOTIFICATION_TO_EMPLOYEES)
									.equals(GlobalConstants.ENABLED)) {
								EmployeeNotificationJob job = new EmployeeNotificationJob(positionId,
										"positionPublishedNotificationToEmployees");
								job.start();
							}
						}
					} else if (publishOrUnPublish.equals(PositionConstants.UNPUBLISHED)) {
						positionManager.updatePositionsPublished(positionId, PositionConstants.UNPUBLISHED,
								form.getPublishType(), null, null, PositionConstants.POSITIONS_EMPLOYEE_APPLY_REFER,
								GlobalConstants.DISABLED);
					}
					request.setAttribute("saved", "1");
				}
				if (form.getPublishType().equals(PositionConstants.PUBLISH_EMPLOYEE_PORTAL)) {
					if (positionData.getEmployeePublishFromDate() != null) {
						form.setPublishFrom(Utils.getDateConvertedToString(positionData.getEmployeePublishFromDate(),
								Utils.regEUDateFormat));
					} else {
						form.setPublishFrom(Utils.getDateConvertedToString(new Date(), Utils.regEUDateFormat));
					}

					if (positionData.getEmployeePublishToDate() != null) {
						form.setPublishTo(Utils.getDateConvertedToString(positionData.getEmployeePublishToDate(),
								Utils.regEUDateFormat));
					} else {
						form.setPublishTo(Utils.getDateConvertedToString(positionData.getPositionExpiryDate(),
								Utils.regEUDateFormat));
					}

					form.setEmployeeApplyRefer(positionData.getEmployeeApplyRefer());
					form.setEmployeeCanEmail(positionData.getEmployeeCanEmail());

				} else if (form.getPublishType().equals(PositionConstants.PUBLISH_WALK_IN)) {
					if (positionData.getWalkInPublishFromDate() != null) {
						form.setPublishFrom(Utils.getDateConvertedToString(positionData.getWalkInPublishFromDate(),
								Utils.regEUDateFormat));
					} else {
						form.setPublishFrom(Utils.getDateConvertedToString(new Date(), Utils.regEUDateFormat));
					}

					if (positionData.getWalkInPublishToDate() != null) {
						form.setPublishTo(Utils.getDateConvertedToString(positionData.getWalkInPublishToDate(),
								Utils.regEUDateFormat));
					} else {
						form.setPublishTo(Utils.getDateConvertedToString(positionData.getPositionExpiryDate(),
								Utils.regEUDateFormat));
					}

				}
				request.setAttribute("publishOrUnPublish", publishOrUnPublish);
				request.setAttribute("vacancies", String.valueOf(positionData.getNoOfPositions()));
				request.setAttribute("positionHireByDate",
						DateUtils.getSystemDateFormat(positionData.getPositionExpiryDate()));
				if (GlobalConstants.ENABLED
						.equals(GlobalApplicationProperties.getProperty(GlobalConstants.PROPERTY_SHOW_POSITION_CODE))) {
					request.setAttribute("positionTitle", positionData.getPositionReferenceCode());
				} else {
					request.setAttribute("positionTitle", positionData.getPositionTitle());
				}

			} else {
				forward = "modalError";
				errors.add("publish_position.error.position_not_open",
						new ActionError("publish_position.error.position_not_open"));
			}
		} catch (SQLException e) {
			TPLogger.getLogger().error(GlobalConstants.ERROR, e);
			errors.add("publish_position.error.get_data", new ActionError("publish_position.error.get_data"));
		} catch (Exception e) {
			TPLogger.getLogger().error(GlobalConstants.ERROR, e);
			errors.add("publish_position.error.update_data", new ActionError("publish_position.error.update_data"));
		}
		saveErrors(request, errors);
		return mapping.findForward(forward);
	}

	public ActionForward publishPosition(ActionMapping mapping, ActionForm actionForm, HttpServletRequest request,
			HttpServletResponse response) {
		if (!SessionManager.validateSession(mapping, actionForm, request, response, this)) {
			return null;
		}
		String forward = "publishPosition";

		Integer[] permissions = new Integer[2];
		permissions[0] = PermissionConstants.PERMISSION_POSITIONS;
		permissions[1] = PermissionConstants.PERMISSION_PUBLISH_POSITION;
		if (!isUserAuthorized(request, ModuleConstants.MODULE_VENDOR, permissions, null, null, null)) {
			forward = getAuthorizationFailureForward();
			return mapping.findForward(forward);
		}

		PositionForm form = (PositionForm) actionForm;
		ActionErrors errors = new ActionErrors();
		try {
			String positionId = form.getPositionId();
			PositionManager positionManager = new PositionManager();
			PositionData positionData = positionManager.getPositionSummary(positionId);
			if (positionData.getPositionStatus().equals(PositionConstants.POSITION_STATUS_OPENED)) {
				if (!Utils.isBlankOrNull(request.getParameter("isSubmitted"))) {
					List<String> selectedSourceIds = new ArrayList<String>();
					List<String> sourceIds = CommonUtils.getSourceIds();
					Iterator<String> itr = sourceIds.iterator();
					while (itr.hasNext()) {
						String sourceId = itr.next();
						if ("1".equalsIgnoreCase(request.getParameter(sourceId + "_val"))) {
							selectedSourceIds.add(sourceId);
						}
					}
					positionManager.updatePositionVendors(positionId, selectedSourceIds);
					positionManager.updatePublishDates(positionId, form.getPublishFrom(), form.getPublishTo());
					request.setAttribute("saved", "1");
				}
				List positionVendors = positionManager.getPositionVendors(positionId);

				if (positionData.getVendorPublishFromDate() != null) {
					form.setPublishFrom(Utils.getDateConvertedToString(positionData.getVendorPublishFromDate(),
							Utils.regEUDateFormat));
				} else {
					form.setPublishFrom(Utils.getDateConvertedToString(new Date(), Utils.regEUDateFormat));
				}

				if (positionData.getVendorPublishToDate() != null) {
					form.setPublishTo(Utils.getDateConvertedToString(positionData.getVendorPublishToDate(),
							Utils.regEUDateFormat));
				} else {
					form.setPublishTo(Utils.getDateConvertedToString(positionData.getPositionExpiryDate(),
							Utils.regEUDateFormat));
				}

				request.setAttribute("positionVendors", positionVendors);

				if (GlobalConstants.ENABLED
						.equals(GlobalApplicationProperties.getProperty(GlobalConstants.PROPERTY_SHOW_POSITION_CODE))) {
					request.setAttribute("positionTitle", positionData.getPositionReferenceCode());
				} else {
					request.setAttribute("positionTitle", positionData.getPositionTitle());
				}

				request.setAttribute("vacancies", String.valueOf(positionData.getNoOfPositions()));
				request.setAttribute("positionHireByDate",
						DateUtils.getSystemDateFormat(positionData.getPositionExpiryDate()));
			} else {
				forward = "modalError";
				errors.add("publish_position.error.position_not_open", new ActionError(
						"publish_position.error.position_not_open", TPLabels.getLabel("common.position")));
			}
		} catch (SQLException e) {
			TPLogger.getLogger().error(GlobalConstants.ERROR, e);
			errors.add("publish_position.error.get_data", new ActionError("publish_position.error.get_data"));
		} catch (Exception e) {
			TPLogger.getLogger().error(GlobalConstants.ERROR, e);
			errors.add("publish_position.error.update_data", new ActionError("publish_position.error.update_data"));
		}
		saveErrors(request, errors);
		return mapping.findForward(forward);
	}

	public ActionForward publishPositionToSite(ActionMapping mapping, ActionForm actionForm, HttpServletRequest request,
			HttpServletResponse response) {
		if (!SessionManager.validateSession(mapping, actionForm, request, response, this)) {
			return null;
		}
		String forward = "publishPositionToSite";

		Integer[] permissions = new Integer[2];
		permissions[0] = PermissionConstants.PERMISSION_POSITIONS;
		permissions[1] = PermissionConstants.PERMISSION_PUBLISH_POSITION_TO_WEB_SITE;
		if (!isUserAuthorized(request, ModuleConstants.MODULE_WEB_INTEGRATION, permissions, null,
				((PositionForm) actionForm).getPositionId(), null)) {
			forward = getAuthorizationFailureForward();
			return mapping.findForward(forward);
		}

		PositionForm form = (PositionForm) actionForm;
		ActionErrors errors = new ActionErrors();
		try {
			MastersManager masterManager = new MastersManager();
			String positionId = form.getPositionId();
			PositionManager positionManager = new PositionManager();
			PositionData positionData = positionManager.getPositionSummary(positionId);
			String publishFromDate = form.getPublishFrom();
			String publishToDate = form.getPublishTo();

			form.setJsArrayDegrees(getJSArrayDegrees());
			form.setJsArrayBranches(getJSArrayBranches());

			if (positionData.getPositionStatus().equals(PositionConstants.POSITION_STATUS_OPENED)) {
				if (!Utils.isBlankOrNull(request.getParameter("isSubmitted"))) {
					ArrayList<String> instituteIds = new ArrayList<String>();
					String isPublishToSite = form.getIsPublishedToSite();
					if (isPublishToSite.equalsIgnoreCase(PositionConstants.POSITION_NOT_PUBLISHED_TO_WEBSITE)) {
						positionData.setPublishToSite(PositionConstants.POSITION_NOT_PUBLISHED_TO_WEBSITE);
						positionManager.removePositionFromSite(positionId, publishFromDate, publishToDate);
					} else {
						String ruleType = form.getRuleType();
						if (ruleType.equalsIgnoreCase(PositionConstants.RULE_GO_TO_DATABASE)) {
							form.setRuleType(PositionConstants.RULE_GO_TO_DATABASE);
							populateDefaultRuleValueToForm(form);
						} else if (ruleType.equalsIgnoreCase(PositionConstants.RULE_GO_TO_INBOX)) {
							form.setRuleType(PositionConstants.RULE_GO_TO_INBOX);
							populateDefaultRuleValueToForm(form);
						} else if (ruleType.equalsIgnoreCase(PositionConstants.RULE_MANDATORY)) {
							String[] instituteNames = null;

							form.setRuleType(PositionConstants.RULE_MANDATORY);
							if (form.getExpSelected()
									.equalsIgnoreCase(PositionConstants.RULE_MANDATORY_CHK_BOX_NOT_SELECTED)) {
								form.setMinimumExperience(null);
								form.setMaximumExperience(null);
							}
							if (form.getDegreeSelected()
									.equalsIgnoreCase(PositionConstants.RULE_MANDATORY_CHK_BOX_NOT_SELECTED)) {
								form.setDegreeId(null);
							}
							if (form.getBranchSelected()
									.equalsIgnoreCase(PositionConstants.RULE_MANDATORY_CHK_BOX_NOT_SELECTED)) {
								form.setBranchId(null);
							}
							if (form.getInstituteSelected()
									.equalsIgnoreCase(PositionConstants.RULE_MANDATORY_CHK_BOX_NOT_SELECTED)) {
								form.setInstitute(null);
								instituteIds.clear();
							} else {
								instituteNames = form.getInstitute().split(";");
								for (int i = 0; i < instituteNames.length; i++) {
									String instituteId = masterManager
											.getInstitutesWithAliasesByName(instituteNames[i]);
									if (instituteId != null) {
										instituteIds.add(instituteId);
									} else {
										String newInstitueId = masterManager.addInstituteToDB(instituteNames[i], null);
										if (!Utils.isBlankOrNull(newInstitueId)) {
											instituteIds.add(newInstitueId);
										}
									}
								}
							}
							if (form.getCurrentLocationSelected()
									.equalsIgnoreCase(PositionConstants.RULE_MANDATORY_CHK_BOX_NOT_SELECTED)) {
								form.setCurrentLocation(null);
							}
						}
						positionData.setPublishToSite(PositionConstants.POSITION_PUBLISHED_TO_WEBSITE);
						positionData.setWebSitePublishFromDate(
								Utils.convertToSQLDate(form.getPublishFrom(), Utils.regEUDateFormat));
						positionData.setWebSitePublishToDate(
								Utils.convertToSQLDate(form.getPublishTo(), Utils.regEUDateFormat));
						positionData.setStringWebSitePublishFromDate(form.getPublishFrom());
						positionData.setStringWebSitePublishToDate(form.getPublishTo());

						// To avoid form from manager layer
						PositionData formData = new PositionData();
						formData.setRuleText(form.getRuleType());
						if (Utils.isInteger(form.getDegreeId())) {
							formData.setDegreeId(Integer.parseInt(form.getDegreeId()));
						}
						if (Utils.isInteger(form.getBranchId())) {
							formData.setBranchId(Integer.parseInt(form.getBranchId()));
						}
						if (Utils.isNumeric(form.getMinimumExperience())) {
							formData.setMinExperience(Float.parseFloat(form.getMinimumExperience()));
						}
						if (Utils.isNumeric(form.getMaximumExperience())) {
							formData.setMaxExperience(Float.parseFloat(form.getMaximumExperience()));
						}
						formData.setLocationName(form.getCurrentLocation());
						positionManager.updatePositionRule(positionId, positionData, formData, instituteIds);
					}

					request.setAttribute("saved", "1");
				}
				String isPublishedToSite = positionData.getPublishToSite();
				if (!Utils.isBlankOrNull(isPublishedToSite)
						&& isPublishedToSite.equalsIgnoreCase(PositionConstants.POSITION_PUBLISHED_TO_WEBSITE)) {
					PositionRuleData ruleData = (PositionRuleData) positionManager.getPositionRule(positionId);
					ArrayList<RuleInstituteData> ruleIinstituteData = positionManager
							.getPositionRuleInstitutes(ruleData.getRuleId());
					if (ruleIinstituteData != null && ruleIinstituteData.size() > 0) {
						String instituteList = "";
						for (Iterator<RuleInstituteData> iterator = ruleIinstituteData.iterator(); iterator
								.hasNext();) {
							RuleInstituteData ruleInstituteData = iterator.next();
							InstituteData insData = (InstituteData) masterManager
									.getInstituteData(ruleInstituteData.getInstituteId());
							if (instituteList.isEmpty()) {
								instituteList += insData.getItemName();
							} else {
								instituteList += ";" + insData.getItemName();
							}
						}
						form.setInstitute(instituteList);
					}
					form.setIsPublishedToSite(positionData.getPublishToSite());
					populateRuleValueToForm(form, ruleData);
				} else {
					form.setIsPublishedToSite(positionData.getPublishToSite());
					form.setRuleType(PositionConstants.RULE_GO_TO_DATABASE);
					unCheckAllMandatoryCondition(form);
				}

				if (positionData.getWebSitePublishFromDate() != null) {
					form.setPublishFrom(Utils.getDateConvertedToString(positionData.getWebSitePublishFromDate(),
							Utils.regEUDateFormat));
				} else {
					form.setPublishFrom(Utils.getDateConvertedToString(new Date(), Utils.regEUDateFormat));
				}

				if (positionData.getWebSitePublishToDate() != null) {
					form.setPublishTo(Utils.getDateConvertedToString(positionData.getWebSitePublishToDate(),
							Utils.regEUDateFormat));
				} else {
					form.setPublishTo(Utils.getDateConvertedToString(positionData.getPositionExpiryDate(),
							Utils.regEUDateFormat));
				}

				if (GlobalConstants.ENABLED
						.equals(GlobalApplicationProperties.getProperty(GlobalConstants.PROPERTY_SHOW_POSITION_CODE))) {
					request.setAttribute("positionTitle", positionData.getPositionReferenceCode());
				} else {
					request.setAttribute("positionTitle", positionData.getPositionTitle());
				}

				request.setAttribute("vacancies", String.valueOf(positionData.getNoOfPositions()));
				request.setAttribute("positionHireByDate",
						DateUtils.getSystemDateFormat(positionData.getPositionExpiryDate()));
			} else {
				forward = "modalError";
				errors.add("publish_position.error.position_not_open",
						new ActionError("publish_position.error.position_not_open"));
			}
		} catch (SQLException e) {
			TPLogger.getLogger().error("Error while getting position to site", e);
			errors.add("publish_position.error.get_rule_data", new ActionError("publish_position.error.get_rule_data"));
		} catch (Exception e) {
			TPLogger.getLogger().error("Error while updating position to site", e);
			errors.add("publish_position.error.update_rule_data",
					new ActionError("publish_position.error.update_rule_data"));
		}
		saveErrors(request, errors);
		return mapping.findForward(forward);
	}

	public ActionForward publishPositionToNaukri(ActionMapping mapping, ActionForm actionForm,
			HttpServletRequest request, HttpServletResponse response) {
		if (!SessionManager.validateSession(mapping, actionForm, request, response, this)) {
			return null;
		}
		String forward = "publishPositionToNaukri";

		Integer[] permissions = new Integer[2];
		permissions[0] = PermissionConstants.PERMISSION_POSITIONS;
		permissions[1] = PermissionConstants.PERMISSION_PUBLISH_POSITION_TO_WEB_SITE;
		if (!isUserAuthorized(request, ModuleConstants.MODULE_WEB_INTEGRATION, permissions, null,
				((PositionForm) actionForm).getPositionId(), null)) {
			forward = getAuthorizationFailureForward();
			return mapping.findForward(forward);
		}

		PositionForm form = (PositionForm) actionForm;
		ActionErrors errors = new ActionErrors();
		try {
			MastersManager masterManager = new MastersManager();
			String positionId = form.getPositionId();
			PositionManager positionManager = new PositionManager();
			PositionData positionData = positionManager.getPositionSummary(positionId);
			form.setJsArrayDegrees(getJSArrayDegrees());
			form.setJsArrayBranches(getJSArrayBranches());
			String error = "";

			if (positionData.getPositionStatus().equals(PositionConstants.POSITION_STATUS_OPENED)) {
				if (!Utils.isBlankOrNull(request.getParameter("isSubmitted"))) {

					error = positionManager.updatePositionNaukriStatus(positionId, false);
					if (!Utils.isBlankOrNull(error)) {
						request.setAttribute("errorMsg", error);
					} else {

						request.setAttribute("saved", "1");
					}
				}

				if (GlobalConstants.ENABLED
						.equals(GlobalApplicationProperties.getProperty(GlobalConstants.PROPERTY_SHOW_POSITION_CODE))) {
					request.setAttribute("positionTitle", positionData.getPositionReferenceCode());
				} else {
					request.setAttribute("positionTitle", positionData.getPositionTitle());
				}
				request.setAttribute("isPublishedToNaukri", positionData.getIsPublishedToNaukri());
				request.setAttribute("vacancies", String.valueOf(positionData.getNoOfPositions()));
				request.setAttribute("positionHireByDate",
						DateUtils.getSystemDateFormat(positionData.getPositionExpiryDate()));
			} else {
				forward = "modalError";
				errors.add("publish_position.error.position_not_open",
						new ActionError("publish_position.error.position_not_open"));
			}
		} catch (SQLException e) {
			TPLogger.getLogger().error("Error while getting position to site", e);
			errors.add("publish_position.error.get_rule_data", new ActionError("publish_position.error.get_rule_data"));
		} catch (Exception e) {
			TPLogger.getLogger().error("Error while updating position to site", e);
			errors.add("publish_position.error.update_rule_data",
					new ActionError("publish_position.error.update_rule_data"));
		}
		saveErrors(request, errors);
		return mapping.findForward(forward);
	}

	private void populateDefaultRuleValueToForm(PositionForm form) {
		form.setMinimumExperience(null);
		form.setMaximumExperience(null);
		form.setDegreeId(null);
		form.setBranchId(null);
		form.setInstitute(null);
		form.setCurrentLocation(null);
	}

	private void populateRuleValueToForm(PositionForm form, PositionRuleData ruleData) {
		form.setRuleType(ruleData.getRuleType());
		form.setMinimumExperience(ruleData.getMinExp());
		form.setMaximumExperience(ruleData.getMaxExp());
		form.setDegreeId(ruleData.getDegreeId());
		form.setBranchId(ruleData.getBranchId());
		form.setCurrentLocation(ruleData.getCurrentLocation());

		if (ruleData.getRuleType().equalsIgnoreCase(PositionConstants.RULE_MANDATORY)) {
			if (Utils.isBlankOrNull(ruleData.getMinExp())) {
				form.setExpSelected(PositionConstants.RULE_MANDATORY_CHK_BOX_NOT_SELECTED);
			} else {
				form.setExpSelected(PositionConstants.RULE_MANDATORY_CHK_BOX_SELECTED);
			}
			if (Utils.isBlankOrNull(ruleData.getDegreeId())) {
				form.setDegreeSelected(PositionConstants.RULE_MANDATORY_CHK_BOX_NOT_SELECTED);
			} else {
				form.setDegreeSelected(PositionConstants.RULE_MANDATORY_CHK_BOX_SELECTED);
			}
			if (Utils.isBlankOrNull(ruleData.getBranchId())) {
				form.setBranchSelected(PositionConstants.RULE_MANDATORY_CHK_BOX_NOT_SELECTED);
			} else {
				form.setBranchSelected(PositionConstants.RULE_MANDATORY_CHK_BOX_SELECTED);
			}
			if (Utils.isBlankOrNull(form.getInstitute())) {
				form.setInstituteSelected(PositionConstants.RULE_MANDATORY_CHK_BOX_NOT_SELECTED);
			} else {
				form.setInstituteSelected(PositionConstants.RULE_MANDATORY_CHK_BOX_SELECTED);
			}
			if (Utils.isBlankOrNull(ruleData.getCurrentLocation())) {
				form.setCurrentLocationSelected(PositionConstants.RULE_MANDATORY_CHK_BOX_NOT_SELECTED);
			} else {
				form.setCurrentLocationSelected(PositionConstants.RULE_MANDATORY_CHK_BOX_SELECTED);
			}
		} else {
			unCheckAllMandatoryCondition(form);
		}
	}

	private void unCheckAllMandatoryCondition(PositionForm form) {
		form.setExpSelected(PositionConstants.RULE_MANDATORY_CHK_BOX_NOT_SELECTED);
		form.setDegreeSelected(PositionConstants.RULE_MANDATORY_CHK_BOX_NOT_SELECTED);
		form.setBranchSelected(PositionConstants.RULE_MANDATORY_CHK_BOX_NOT_SELECTED);
		form.setInstituteSelected(PositionConstants.RULE_MANDATORY_CHK_BOX_NOT_SELECTED);
		form.setCurrentLocationSelected(PositionConstants.RULE_MANDATORY_CHK_BOX_NOT_SELECTED);
	}

	/* Opening Position Priority */
	public ActionForward openPositionPriority(ActionMapping mapping, ActionForm actionForm, HttpServletRequest request,
			HttpServletResponse response) {
		if (!SessionManager.validateSession(mapping, actionForm, request, response, this)) {
			return null;
		}
		String forward = "positionPriority";

		Integer[] permissions = new Integer[2];
		permissions[0] = PermissionConstants.PERMISSION_POSITIONS;
		permissions[1] = PermissionConstants.PERMISSION_POSITION_PRIORITY;
		String positionId = request.getParameter("positionId");
		if (!isUserAuthorized(request, CommonConstants.NO_MODULE, permissions, null, positionId, null)) {
			forward = getAuthorizationFailureForward();
			return mapping.findForward(forward);
		}

		try {
			PositionManager positionManager = new PositionManager();
			PositionForm positionForm = (PositionForm) actionForm;
			PositionData positionData = positionManager.getPositionSummary(positionId);
			positionForm.setPositionId(positionId);
			positionForm.setPositionPriority(positionData.getPositionPriority());
			request.setAttribute("positionData", positionData);
		} catch (Exception e) {
			TPLogger.getLogger().error("Error while Getting position Priority", e);
		}
		return mapping.findForward(forward);
	}

