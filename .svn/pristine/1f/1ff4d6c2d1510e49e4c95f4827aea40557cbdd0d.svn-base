	private String getJSArrayBudgetItems(String bandId, String gradeId) {
		BudgetManager budgetManager = new BudgetManager();
		BudgetFilterData budgetFilterData = new BudgetFilterData();
		budgetFilterData.setStatus(BudgetConstants.BUDGET_ITEM_STATUS_ACTIVE);
		budgetFilterData.setGradeId(gradeId);
		budgetFilterData.setBandId(bandId);
		List<BudgetItem> budgetItems = budgetManager.searchBudgetItems(budgetFilterData);
		return CommonUtils.getListJavaScriptArrayWithProperties((ArrayList<BudgetItem>) budgetItems, "budgetItemId",
				"budgetItemName");

	}

	private ActionErrors validateDescription(PositionForm form, ArrayList<CustomFieldData> customFields) {
		ActionErrors errors = new ActionErrors();
		if (!form.getPositionStatus().equals(PositionConstants.POSITION_STATUS_TEMPLATE)) {
			if (Utils.isBlankOrNull(form.getPositionCode())) {
				ActionError error = new ActionError("common.error.required.one_param",
						TPLabels.getLabel("common.position_code"));
				errors.add("common.position_code", error);
			}
			if (PositionScreenConfigurationManager
					.isDescriptionFieldMandatory(PositionConfigurationConstants.FIELD_POSITION_OWNER)) {
				if (Utils.isBlankOrNull(form.getPositionOwnerId()) || "-1".equals(form.getPositionOwnerId())) {
					ActionError error = new ActionError("position.description.error.position_owner",
							TPLabels.getLabel("global.position_owner"));
					errors.add("position.description.error.position_owner", error);
				}
			}

			if (Utils.isBlankOrNull(form.getRequisitionerId()) || form.getRequisitionerId().equals("-1")) {
				ActionError error = new ActionError("position.description.error.requisitioner");
				errors.add("position.description.error.requisitioner", error);
			}
			if (Utils.isBlankOrNull(form.getDepartmentId()) || form.getDepartmentId().equals("-1")) {
				ActionError error = new ActionError("position.description.error.department");
				errors.add("position.description.error.department", error);
			}
			if (Utils.isBlankOrNull(form.getVacancies())) {
				ActionError error = new ActionError("common.error.required.one_param",
						TPLabels.getLabel("common.vacancies"));
				errors.add("common.vacancies", error);
			} else {
				if (!Utils.isValidPattern(form.getVacancies(), Utils.regNumberOnly)) {
					ActionError error = new ActionError("common.error.required.two_param",
							TPLabels.getLabel("common.valid"), TPLabels.getLabel("common.vacancies"));
					errors.add("common.error.required.two_param", error);
				}
			}
			if (Utils.isBlankOrNull(form.getHireByDate())) {
				ActionError error = new ActionError("position.description.error.hire_by_date",
						TPLabels.getLabel("common.position"));
				errors.add("position.description.error.hire_by_date", error);
			} else {
				Date dt = Utils.convertToDate(form.getHireByDate(), Utils.regEUDateFormat);
				if (dt == null || dt.before(Calendar.getInstance().getTime())) {
					ActionError error = new ActionError("position.description.error.hire_by_date.invalid",
							TPLabels.getLabel("common.position"));
					errors.add("position.description.error.hire_by_date.invalid", error);
				}
			}

			if (CustomFieldManager.isCustomFieldsAvailable(CustomFieldConstants.ENTITY_TYPE_POSITION)) {
				for (int i = 0; i < customFields.size(); i++) {
					CustomFieldData data = customFields.get(i);
					if (PositionScreenConfigurationManager.isDescriptionFieldMandatory(data.getFieldName())) {
						if (data.getFieldValues() == null || Utils.isBlankOrNull(data.getFieldValues()[0])) {
							errors.add("error", new ActionError("common.error.required", data.getFieldDisplayName()));
						}
					}
				}
			}

			if (ModuleSet.isMODULE_BUDGET() && BudgetUtils.isBudgetModuleActive()) {
				if (!Utils.isBlankOrNull(form.getTypeOfVacancy())
						&& form.getTypeOfVacancy().equals(PositionConstants.POSITIONS_TYPE_OF_VACANCY_REPLACEMENT)
						&& GlobalApplicationProperties.getProperty(GlobalConstants.PROPERTY_BUDGET_FOR_REPLACEMENT)
								.equals("0")) {
					// do not add errors for this condition
				} else {
					if (Utils.isBlankOrNull(form.getBudgetItemId()) || form.getBudgetItemId().equals("-1")) {
						ActionError error = new ActionError("position.description.error.budget_item");
						errors.add("position.description.error.budget_item", error);
					}
					if (GlobalApplicationProperties.getProperty(GlobalConstants.PROPERTY_BUDGET_MODE)
							.equals(BudgetConstants.BUDGET_MODE_ENFORCE)) {
						if (Utils.isBlankOrNull(form.getGradeId()) || form.getGradeId().equals("-1")) {
							ActionError error = new ActionError("position.description.error.please_select",
									GlobalApplicationProperties
											.getProperty(GlobalConstants.PROPERTY_BUDGET_ITEM_GRADE_LABEL));
							errors.add("position.description.error.please_select"
									+ GlobalConstants.PROPERTY_BUDGET_ITEM_GRADE_LABEL, error);
						}
						if (Utils.isBlankOrNull(form.getBandId()) || form.getBandId().equals("-1")) {
							ActionError error = new ActionError("position.description.error.please_select",
									GlobalApplicationProperties
											.getProperty(GlobalConstants.PROPERTY_BUDGET_ITEM_BAND_LABEL));
							errors.add("position.description.error.please_select"
									+ GlobalConstants.PROPERTY_BUDGET_ITEM_BAND_LABEL, error);
						}
					}
					validateDescriptionForEnforceMode(errors, form);
				}
			}
		}
		if (Utils.isBlankOrNull(form.getPositionName())) {
			ActionError error = new ActionError("common.error.required.one_param",
					TPLabels.getLabel("common.position_name"));
			errors.add("common.position_name", error);
		}

		return errors;
	}

	private ActionErrors validateDescriptionForEnforceMode(ActionErrors errors, PositionForm form) {
		BudgetManager budgetManager = new BudgetManager();
		BudgetFilterData budgetFilterData = new BudgetFilterData();
		budgetFilterData.setBudgetItemId(form.getBudgetItemId());
		budgetFilterData.setPositionId(form.getPositionId());
		Map restrictions = budgetManager.getForcedModeRestrictionsForBudgetItem(budgetFilterData);

		String availableHeadCount = restrictions.get(BudgetConstants.FORCED_MODE_RESTRICTION_AVAILABLE_COUNT) + "";
		Date budgetEndDate = (Date) restrictions.get(BudgetConstants.FORCED_MODE_RESTRICTION_END_DATE);

		if (Utils.isValidPattern(availableHeadCount, Utils.regNumberOnly)) {
			if (!Utils.isBlankOrNull(form.getVacancies())
					&& Utils.isValidPattern(form.getVacancies(), Utils.regNumberOnly)) {
				if (Integer.parseInt(form.getVacancies()) > Integer.parseInt(availableHeadCount)) {
					if (GlobalApplicationProperties.getProperty(GlobalConstants.PROPERTY_BUDGET_MODE)
							.equals(BudgetConstants.BUDGET_MODE_ENFORCE)) {
						ActionError error = new ActionError("position.description.error.vacancies.not_available",
								availableHeadCount);
						errors.add("position.description.error.vacancies.not_available", error);
					} else {
						form.getTrackModeNotifications()
								.add(TemplateConstants.TEMPLATE_TYPE_TRACK_MODE_VACANCY_NOTIFICATION_TO_OWNER);
					}
				}
			}
		}
		if (budgetEndDate != null) {
			Date dt = Utils.convertToDate(form.getHireByDate(), Utils.regEUDateFormat);
			if (budgetEndDate.before(dt)) {
				if (GlobalApplicationProperties.getProperty(GlobalConstants.PROPERTY_BUDGET_MODE)
						.equals(BudgetConstants.BUDGET_MODE_ENFORCE)) {
					ActionError error = new ActionError("position.description.error.hirebydate.not_acceptable",
							Utils.getDateConvertedToString(budgetEndDate, Utils.regEUDateFormat));
					errors.add("position.description.error.hirebydate.not_acceptable", error);
				} else {
					form.getTrackModeNotifications()
							.add(TemplateConstants.TEMPLATE_TYPE_TRACK_MODE_HIRE_BY_DATE_NOTIFICATION_TO_OWNER);
				}
			}
		}
		return errors;
	}

	private List parseJSArray(String jsArray, String id, String value) {
		List responsibilities = new ArrayList();
		if (!Utils.isBlankOrNull(jsArray)) {
			String[] _responsibilities = jsArray.split(",");
			if (_responsibilities != null && _responsibilities.length > 0) {
				for (int i = 0; i < _responsibilities.length; i++) {
					String _responsibility = _responsibilities[i];
					if (!Utils.isBlankOrNull(_responsibility)) {
						String[] attributes = _responsibility.split("[|]");
						if (attributes != null && attributes.length > 0) {
							SimpleDataObject sDo = new SimpleDataObject();
							sDo.setAttribute(id, Utils.getFormattedRecord(attributes[0].trim()));
							sDo.setAttribute(value, Utils.getFormattedRecord(attributes[1].trim()));
							responsibilities.add(sDo);
						}
					}
				}
			}
		}
		return responsibilities;
	}

	public ActionForward requirements(ActionMapping mapping, ActionForm actionForm, HttpServletRequest request,
			HttpServletResponse response) throws Exception {
		if (!SessionManager.validateSession(mapping, actionForm, request, response, this)) {
			return null;
		}
		String forward = "requirements";
		String userId = (String) request.getSession().getAttribute("userId");
		String userRoleId = (String) request.getSession().getAttribute("userRoles");
		PositionForm form = (PositionForm) actionForm;
		String positionId = form.getPositionId();
		String dir = form.getDir();

		Integer[] permissions = new Integer[2];
		permissions[0] = PermissionConstants.PERMISSION_POSITIONS;
		if (Utils.isBlankOrNull(dir) && PositionConstants.DIR_VIEW_POSITION.equalsIgnoreCase(dir)) {
			permissions[1] = PermissionConstants.PERMISSION_POSITION_DETAILS;
		} else if (Utils.isBlankOrNull(dir) && PositionConstants.DIR_EDIT_POSITION.equalsIgnoreCase(dir)) {
			if (PositionConstants.POSITION_STATUS_TEMPLATE.equals(form.getPositionStatus())) {
				permissions[1] = PermissionConstants.PERMISSION_CREATE_POSITION_TEMPLATE;
			} else {
				permissions[1] = PermissionConstants.PERMISSION_EDIT_POSITIONS;
			}
		} else {
			permissions[1] = PermissionConstants.PERMISSION_POSITIONS;
		}
		String validPositionId = "";
		if (Utils.isBlankOrNull(dir) && !PositionConstants.DIR_ADD_POSITION.equalsIgnoreCase(dir)) {
			validPositionId = positionId;
		}
		if (!isUserAuthorized(request, CommonConstants.NO_MODULE, permissions, null, validPositionId, null)) {
			forward = getAuthorizationFailureForward();
			return mapping.findForward(forward);
		}

		PositionManager positionManager = new PositionManager();
		if (PositionConstants.DIR_ADD_POSITION.equalsIgnoreCase(dir)
				|| PositionConstants.DIR_COPY_POSITION.equalsIgnoreCase(dir)) {
			// Add new position.
			SimpleDataObject position = (SimpleDataObject) request.getSession(false).getAttribute(positionId);
			populatePositionRequirementsOnForm(form, position);
			form.setCopyFrom(PositionConstants.LIST_POSITIONS);
			populateRequirementsPage(form, userId, userRoleId, request);
		} else if (Utils.isBlankOrNull(dir) || PositionConstants.DIR_VIEW_POSITION.equalsIgnoreCase(dir)) {
			// View position requirements.
			form.setDir(PositionConstants.DIR_VIEW_POSITION);

			SimpleDataObject positionRequirements = (SimpleDataObject) positionManager
					.getPositionRequirementsToView(positionId);
			form.setDegreeTitle(positionRequirements.getString("degreeTitle"));
			form.setBranchName(positionRequirements.getString("branchName"));
			form.setMinimumExperience(positionRequirements.getString("minimumExperience"));
			form.setMaximumExperience(positionRequirements.getString("maximumExperience"));
			form.setPrimarySkills(positionRequirements.getString("primarySkills"));
			form.setSecondarySkills(positionRequirements.getString("secondarySkills"));
			String requ = positionRequirements.getString("requirements");
			form.setRequirements(requ == null ? "" : requ);
			SimpleDataObject sdo1 = positionManager.getPositionCodeAndName(form.getPositionId());
			request.setAttribute("positionCode", sdo1.getString("positionCode"));
			request.setAttribute("positionName", sdo1.getString("positionName"));
		} else if (PositionConstants.DIR_EDIT_POSITION.equalsIgnoreCase(dir)) {
			// Edit position requirements.
			form.setDir(PositionConstants.DIR_EDIT_POSITION);

			SimpleDataObject positionRequirements = (SimpleDataObject) positionManager
					.getPositionRequirementsToEdit(positionId);
			populatePositionRequirementsOnForm(form, positionRequirements);

			form.setCopyFrom(PositionConstants.LIST_POSITIONS);
			populateRequirementsPage(form, userId, userRoleId, request);
			SimpleDataObject sdo1 = positionManager.getPositionCodeAndName(form.getPositionId());
			request.setAttribute("positionCode", sdo1.getString("positionCode"));
			request.setAttribute("positionName", sdo1.getString("positionName"));
		}
		form.setStep(NavigationConstants.STEP_POSITION_REQUIREMENTS);
		request.setAttribute("t", NavigationConstants.T_POSITIONS);
		request.setAttribute("requisitionManagement", PositionConstants.REQUISITION_MANAGEMENT_ENABLED);
		return mapping.findForward(forward);
	}

	private void populatePositionRequirementsOnForm(PositionForm form, SimpleDataObject positionRequirements) {
		form.setDegreeId(positionRequirements.getString("degreeId"));
		form.setBranchId(positionRequirements.getString("branchId"));
		form.setMinimumExperience(positionRequirements.getString("minimumExperience"));
		form.setMaximumExperience(positionRequirements.getString("maximumExperience"));
		form.setPrimarySkills(positionRequirements.getString("primarySkills"));
		form.setSecondarySkills(positionRequirements.getString("secondarySkills"));
		String requ = positionRequirements.getString("requirements");
		form.setRequirements(requ == null ? "" : requ);
	}

	private String getJSArrayDegrees() {
		List<String> degreeIds = CommonUtils.getDegreeIds();
