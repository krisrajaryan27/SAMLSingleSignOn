				xmlFile = Utils.getXMLForSessionExpiry();
			} else {
				String fld = request.getParameter("autocompleteFieldType");
				if (!Utils.isBlankOrNull(fld)) {
					PositionManager positionManager = new PositionManager();
					if (fld.equals(PositionConstants.AUTOCOMPLETE_INSTITUTE)) {
						xmlFile = positionManager.getAutoCompleteXML(positionForm.getInstitute(),
								PositionConstants.AUTOCOMPLETE_INSTITUTE);
					}
					if (fld.equals(PositionConstants.AUTOCOMPLETE_REPLACE_CODE)) {
						xmlFile = positionManager.getAutoCompleteXML(positionForm.getReplacementEmpCode(),
								PositionConstants.AUTOCOMPLETE_REPLACE_CODE);
					}
				}
			}
			request.setAttribute("xmlFile", xmlFile);
		} catch (Exception e) {
			TPLogger.getLogger().error("Error while getting institutes", e);
		}
		return mapping.findForward(forward);
	}

