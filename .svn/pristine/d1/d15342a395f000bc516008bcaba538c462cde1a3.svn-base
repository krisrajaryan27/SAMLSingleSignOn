package com.talentPool.parser.dataobject;

public class EducationParsedData extends ParsedResultData {
	private String year;
	private String institute;
	private String degree;
	private String branch;
	private String grade;
	
	/**
	 * @return the branch
	 */
	public String getBranch() {
		return branch;
	}
	
	/**
	 * @param branch the branch to set
	 */
	public void setBranch(String branch) {
		this.branch = branch;
	}
	
	/**
	 * @return the degree
	 */
	public String getDegree() {
		return degree;
	}
	
	/**
	 * @param degree the degree to set
	 */
	public void setDegree(String degree) {
		this.degree = degree;
	}
	
	/**
	 * @return the grade
	 */
	public String getGrade() {
		return grade;
	}
	
	/**
	 * @param grade the grade to set
	 */
	public void setGrade(String grade) {
		this.grade = grade;
	}
	
	/**
	 * @return the institute
	 */
	public String getInstitute() {
		return institute;
	}
	
	/**
	 * @param institute the institute to set
	 */
	public void setInstitute(String institute) {
		this.institute = institute;
	}
	
	/**
	 * @return the year
	 */
	public String getYear() {
		return year;
	}
	
	/**
	 * @param year the year to set
	 */
	public void setYear(String year) {
		this.year = year;
	}
	
	public String toString(){
		return "\n year= " + this.getYear() + " | institute= " + this.getInstitute() + " | degree= " + this.getDegree() + " | branch= " + this.getBranch() + " | grade= " + this.getGrade();
	}
}
