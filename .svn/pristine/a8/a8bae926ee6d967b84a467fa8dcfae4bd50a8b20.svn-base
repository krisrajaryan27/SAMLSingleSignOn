package com.talentPool.vendorservice.dataobject;

import java.util.ArrayList;

/**
 * @author pallavi
 *
 */
public class VapplicantList {
	private ArrayList<VapplicantData> applicants;
	private Vpagination pagination;
	/**
	 * @return the applicants
	 */
	public ArrayList<VapplicantData> getApplicants() {
		return applicants;
	}
	/**
	 * @param applicants 
	 *			the applicants to set
	 */
	public void setApplicants(ArrayList<VapplicantData> applicants) {
		this.applicants = applicants;
	}
	/**
	 * @return the pagination
	 */
	public Vpagination getPagination() {
		return pagination;
	}
	/**
	 * @param pagination 
	 *			the pagination to set
	 */
	public void setPagination(Vpagination pagination) {
		this.pagination = pagination;
	}
}
