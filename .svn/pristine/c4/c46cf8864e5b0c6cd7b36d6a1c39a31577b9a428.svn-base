		}
		return mapping.findForward(forward);
	}

	public ActionForward newEmail(ActionMapping mapping, ActionForm actionForm, HttpServletRequest request, HttpServletResponse response) {
		if (!SessionManager.validateSession(mapping, actionForm, request, response, this)) {
			return null;
		}
		String forward = "newEmail";
		InboxForm inboxForm = (InboxForm) actionForm;
		PermissionSet permissionSet = (PermissionSet) request.getSession(false).getAttribute("permissionSet");
		String userId = (String) request.getSession(false).getAttribute("userId");
		try {
			// list all positions to select information from
			PositionManager positionManager = new PositionManager();
			ArrayList positions = positionManager.getPositionListWithStatus(PositionConstants.POSITION_STATUS_OPENED, permissionSet, userId);
			ArrayList positionIds = new ArrayList();
			ArrayList positionNames = new ArrayList();
			CommonUtils.populateIdsAndNames(positions, positionIds, positionNames, "positionId", "positionTitle", null);
			inboxForm.setPositionIds(positionIds);
			inboxForm.setPositionNames(positionNames);
			// get random unique new email id
			String tmpEmailId = inboxForm.getTmpEmailId();

			InboxManager inboxManager = new InboxManager();
			ApplicantManager applicantManager = new ApplicantManager();

			if (Utils.isBlankOrNull(tmpEmailId)) {
				tmpEmailId = Utils.getRandomString(12, 0, 0, true, true, null, new Random());
				inboxForm.setTmpEmailId(tmpEmailId);
				String emailLocation = inboxForm.getEmailLocation();
				String emailType = inboxForm.getNewEmailType();

				if (InboxConstants.EMAIL_TYPE_FORWARD.equals(emailType) 
						|| InboxConstants.EMAIL_TYPE_REPLY.equals(emailType)
						|| InboxConstants.EMAIL_TYPE_SEND_DRAFT.equals(emailType)) {
					inboxManager.copyAttachmentsDataToTemp(inboxForm.getEmailId(), inboxForm.getEmailLocation(), tmpEmailId);
					MessageData messageData = inboxManager.getEmailHeader(inboxForm.getEmailId(), inboxForm.getEmailLocation(), false);
					ArrayList attachments = inboxManager.getTmpAttachments(tmpEmailId);
					if (attachments != null) {
						messageData.setAttachments(attachments);
					}
					request.setAttribute("messageData", messageData);
					String sub = messageData.getSubject();
					if (!Utils.isBlankOrNull(sub)) {
						sub = sub.replaceAll("(?mid)^(FW|RE|FWD)[\\s]?:", "");
					}
					if(InboxConstants.EMAIL_TYPE_SEND_DRAFT.equals(emailType)) {
						inboxForm.setSubject(sub);
					} else {
						inboxForm.setSubject(emailType + ": " + sub);
					}

					// get the message body
					MessageData msgData = inboxManager.getEmailBody(inboxForm.getEmailId(), emailLocation);
					if (Utils.isBlankOrNull(msgData.getHtmlBody())) {
						inboxForm.setNewEmailBody(msgData.getTextBody());
					} else {
						inboxForm.setNewEmailBody(msgData.getHtmlBody());
					}
					if(InboxConstants.EMAIL_TYPE_SEND_DRAFT.equals(emailType)) {
						inboxForm.setNewEmailBody(inboxForm.getNewEmailBody());
					} else {
						inboxForm.setNewEmailBody("<br><br><br><br><br>" + inboxForm.getNewEmailBody());
					}					
					if (emailType.equals(InboxConstants.EMAIL_TYPE_REPLY)) {
						inboxForm.setTo(messageData.getFrom());
					} else if(emailType.equals(InboxConstants.EMAIL_TYPE_SEND_DRAFT)) {
						inboxForm.setTo(messageData.getTo());
						inboxForm.setCc(messageData.getCc());
					}
				}

				if (emailLocation.equals(InboxConstants.EMAIL_LOCATION_COMMUNICATIONS)) {
					if (emailType.equals(InboxConstants.EMAIL_TYPE_NEW) || emailType.equals(InboxConstants.EMAIL_TYPE_REPLY)) {
						// get Applicants email
						ApplicantData aData = applicantManager.getApplicantEmailAddress(inboxForm.getApplicantId(), true);
						String emails = ApplicantUtils.getEmailToString(aData);
						inboxForm.setTo(emails);
					}
				}
				LoginManager loginManager = new LoginManager();
				String userId1 = (String) request.getSession().getAttribute("userId");
				LoginData userData = loginManager.getUser(userId1);
				inboxForm.setFrom(userData.getName() + " <" + userData.getEmail() + ">");

			} else {
				MessageData messageData = new MessageData();
				ArrayList attachments = inboxManager.getTmpAttachments(tmpEmailId);
				if (attachments != null) {
					messageData.setAttachments(attachments);
				}
				request.setAttribute("messageData", messageData);

			}
			
			//do not query if it is ForwardResume
			if (!Utils.isBlankOrNull(inboxForm.getApplicantId()) && !inboxForm.getApplicantId().contains(",")) {
				ApplicantData data = applicantManager.getApplicantSummaryData(inboxForm.getApplicantId());
				request.setAttribute("applicantData", data);
			}
			InboxBC inboxBC = new InboxBC();
			inboxBC.getTemplates(request);
		} catch (Exception e) {
			TPLogger.getLogger().error(GlobalConstants.ERROR, e);
		}
		return mapping.findForward(forward);
	}

	public ActionForward getTemplateXML(ActionMapping mapping, ActionForm actionForm, HttpServletRequest request, HttpServletResponse response) {
		String forward = "xmlFile";
		String xmlFile = "";
		try {
			String userId = (String) request.getSession().getAttribute("userId");
			if (!SessionManager.isLoginFound(mapping, actionForm, request, response, this)) {
				xmlFile = Utils.getXMLForSessionExpiry();
			} else {
				InboxForm inboxForm = (InboxForm) actionForm;

				if (!Utils.isBlankOrNull(inboxForm.getTemplateCode())) {
					InboxManager inboxManager = new InboxManager();
					MassEmailManager massEmailManager = new MassEmailManager();
					MessageData data = massEmailManager.getMessageData(inboxForm.getTemplateCode(), inboxForm.getApplicantId(), "", userId);
					xmlFile = inboxManager.getTemplateXml(inboxForm.getTemplateCode(), data.getSubject(), data.getHtmlBody());
				}
			}
		} catch (Exception e) {
			TPLogger.getLogger().error("Error while getting templateData in XML", e);
			xmlFile = Utils.getXMLForError(null);
		}
		request.setAttribute("xmlFile", xmlFile);
		return mapping.findForward(forward);
	}

	public ActionForward saveAttachments(ActionMapping mapping, ActionForm actionForm, HttpServletRequest request, HttpServletResponse response) {
		if (!SessionManager.validateSession(mapping, actionForm, request, response, this)) {
			return null;
		}
		String forward = "uploadSuccess";
		InboxForm inboxForm = (InboxForm) actionForm;
		String error = "";
		try {
			InboxManager inboxManager = new InboxManager();
			// get all attachments for this message
			FormFile formFile = inboxForm.getAttachedFile();
			if (formFile != null) {
				FormFileData formFileData = new FormFileData(formFile.getFileName(), formFile.getFileSize(), formFile.getContentType(), formFile.getInputStream());
				error = validateEmailAttachment(formFile, inboxForm.getTmpEmailId());
				if (Utils.isBlankOrNull(error)) {
					AttachmentData attachmentData = inboxManager.uploadAttachment(formFileData, inboxForm.getTmpEmailId(), inboxForm.getEmailLocation());
					request.setAttribute("attachmentData", attachmentData);
				}
			}
		} catch (InvalidMimeTypeException e) {
			TPLogger.getLogger().error("Error while uploading user document", e);
			error = TPLabels.getLabel("upload_document.error.invalid_mime_type");
		} catch (FileUploadException fe) {
			error = TPLabels.getLabel("attachment.error.could_not_read_file");
		} catch (Exception e) {
			TPLogger.getLogger().error("Error while saving attachment", e);
		}
		request.setAttribute("error", error);
		return mapping.findForward(forward);
	}

	public ActionForward getPositionInfo(ActionMapping mapping, ActionForm actionForm, HttpServletRequest request, HttpServletResponse response) {
		if (!SessionManager.validateSession(mapping, actionForm, request, response, this)) {
			return null;
		}
		String forward = "xmlFile";
		InboxForm inboxForm = (InboxForm) actionForm;
		String xmlFile = "";
		try {
			if (!SessionManager.isLoginFound(mapping, actionForm, request, response, this)) {
				xmlFile = Utils.getXMLForSessionExpiry();
			} else {
				if (!Utils.isBlankOrNull(inboxForm.getPositionId())) {
					PositionManager positionManager = new PositionManager();
					String requirements = positionManager.getRequirements(inboxForm.getPositionId());
					String responsibilities = positionManager.getResponisbilities(inboxForm.getPositionId());
					InboxManager inboxManager = new InboxManager();
					xmlFile = inboxManager.getPositionInfoXML(requirements, responsibilities);
				}
			}
		} catch (Exception e) {
			TPLogger.getLogger().error("Error while getting Inbox Settings", e);
		}
		request.setAttribute("xmlFile", xmlFile);

		return mapping.findForward(forward);
	}

	public ActionForward sendEmail(ActionMapping mapping, ActionForm actionForm, HttpServletRequest request, HttpServletResponse response) {
		if (!SessionManager.validateSession(mapping, actionForm, request, response, this)) {
			return null;
		}
		InboxForm inboxForm = (InboxForm) actionForm;
		ActionErrors errors = null;
		try {
			InboxManager inboxManager = new InboxManager();
			errors = (ActionErrors) (request.getAttribute(Globals.ERROR_KEY));
			if (errors == null) {
				errors = new ActionErrors();
			}
			if (Utils.isBlankOrNull(inboxForm.getTo())) {
				errors.add("new_email.error.invalid_to", new ActionError("new_email.error.invalid_to"));
			}
			if (errors.size() == 0) {
				String userId = (String) request.getSession().getAttribute("userId");

				MessageData messageData = new MessageData();
				messageData.setTo(inboxForm.getTo());
				messageData.setCc(inboxForm.getCc());
				messageData.setBcc(inboxForm.getBcc());
				InboxData iData = inboxManager.getCurrentInboxSettings();
				if (Utils.isBlankOrNull(inboxForm.getFrom())) {
					messageData.setFrom(iData.getInboxDisplayName() + " <" + iData.getInboxEmail() + ">");
				} else {
					String from = inboxForm.getFrom();
					messageData.setReplyTo(from);
					String sendFrom = Utils.replaceUserEmailWithInboxEmail(from, iData.getInboxEmail());
					messageData.setFrom(sendFrom);
				}
				messageData.setTextBody(inboxForm.getNewEmailBody());
				// Adding <pre></pre> is temporary arrangement for send email
				// Once we have an option to send HTML or TEXT email on UI,
				// remove this
				messageData.setHtmlBody(inboxForm.getNewEmailBody());
				messageData.setSubject(inboxForm.getSubject());
				ArrayList attachments = inboxManager.getTmpAttachments(inboxForm.getTmpEmailId());
				if (attachments != null) {
					messageData.setAttachments(attachments);
				}
				// Append original data
				String newEmailType = inboxForm.getNewEmailType();
				// if (!Utils.isBlankOrNull(inboxForm.getIncludeOriginal())) {
				if (newEmailType.equals(InboxConstants.EMAIL_TYPE_REPLY) || newEmailType.equals(InboxConstants.EMAIL_TYPE_FORWARD)) {
					ArrayList relatedAttachments = inboxManager.getAttachmentsOfType(inboxForm.getEmailId(), inboxForm.getEmailLocation(), InboxConstants.ATTACHMENT_TYPE_RELATED);
					if (relatedAttachments != null) {
						if (attachments != null) {
							attachments.addAll(relatedAttachments);
							messageData.setAttachments(attachments);
						} else {
							messageData.setAttachments(relatedAttachments);
						}
					}
				}
				
				// replace the path with cid and send email
				inboxManager.processAndSendEmail(messageData, inboxForm.getApplicantId());
				// delete confirmed attachments from tmp db
				inboxManager.deleteTmpAttachments(inboxForm.getTmpEmailId(), null, InboxConstants.ATTACHMENT_CONFIRMED);

				// make email sent entry into DB
				Calendar cal = new GregorianCalendar();
				messageData.setSendDate(new java.sql.Date(new Timestamp(cal.getTime().getTime()).getTime()));
				if (inboxForm.getEmailLocation().equals(InboxConstants.EMAIL_LOCATION_COMMUNICATIONS)) {
					//do not save if it is ForwardResume
					if(!inboxForm.getApplicantId().contains(",")){
						messageData.setApplicantId(inboxForm.getApplicantId());
						inboxManager.saveCommunicationMessage(messageData, ApplicantConstants.APPLICANT_EMAIL_FOLDER_SENT, userId,ApplicantConstants.EMAIL_NOT_IMPORTED);
					}
				} else {
					inboxManager.saveMessage(messageData, InboxConstants.INBOX_FOLDER_SENT, userId);
					if(InboxConstants.EMAIL_TYPE_SEND_DRAFT.equals(newEmailType)) {
						inboxManager.deleteInboxEmail(inboxForm.getEmailId(), true, null);
					}
				}
				
				request.setAttribute("update", "1");
			}
		} catch (Exception e) {
			TPLogger.getLogger().error("Error while getting Inbox Settings", e);
			errors.add("new_email.error.unspecified", new ActionError("new_email.error.unspecified"));
		}
		saveErrors(request, errors);
		return newEmail(mapping, actionForm, request, response);
	}

