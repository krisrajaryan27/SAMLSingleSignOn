	public ActionForward inbox(ActionMapping mapping, ActionForm actionForm, HttpServletRequest request, HttpServletResponse response) {
		if (!SessionManager.validateSession(mapping, actionForm, request, response, this)) {
			return null;
		}

		String forward = "inbox";
		Integer[] permissions = new Integer[1];
		permissions[0] = PermissionConstants.PERMISSION_IMPORT;
		if(!isUserAuthorized(request, CommonConstants.NO_MODULE, permissions,null,null,null)) {
			forward = "authorizationFailure";			
			return mapping.findForward(forward);
		}
		try {
			InboxManager inboxManager = new InboxManager();
			ArrayList inboxList = inboxManager.getActiveInboxForUser();
			request.setAttribute("inboxList", inboxList);
			request.setAttribute("t", NavigationConstants.T_IMPORT);
			String userId = (String) request.getSession(false).getAttribute("userId");
			PermissionSet permissionSet = (PermissionSet) request.getSession(false).getAttribute("permissionSet");
			
			List<InboxFolderData> systemFolders = inboxManager.getInboxFolders(MastersConstants.SYSTEM_FOLDER, permissionSet, userId);
			List<InboxFolderData> drafts = inboxManager.getInboxFolders(MastersConstants.DRAFT, permissionSet, userId);
			List<InboxFolderData> userFolders = inboxManager.getInboxFolders(MastersConstants.NON_SYSTEM_FOLDER, permissionSet, userId);
			request.setAttribute("systemFolders", systemFolders);
			request.setAttribute("drafts", drafts);
			request.setAttribute("userFolders", userFolders);
		} catch (Exception e) {
			TPLogger.getLogger().error("Error while getting Inbox Settings", e);
		}
		return mapping.findForward(forward);
	}

	public ActionForward getMessages(ActionMapping mapping, ActionForm actionForm, HttpServletRequest request, HttpServletResponse response) {
		String forward = "xmlFile";
		String xmlFile = "";
		try {
			Integer[] permissions = new Integer[1];
			permissions[0] = PermissionConstants.PERMISSION_IMPORT;
			
			if (!SessionManager.isLoginFound(mapping, actionForm, request, response, this)) {
				xmlFile = Utils.getXMLForSessionExpiry();
			} else if(!isUserAuthorized(request, CommonConstants.NO_MODULE, permissions,null,null,null)) {
				forward = "authorizationFailure";			
				return mapping.findForward(forward);
			} else {
				String userId = (String) request.getSession(false).getAttribute("userId");
				PermissionSet permissionSet = (PermissionSet) request.getSession(false).getAttribute("permissionSet");
				InboxForm inboxForm = (InboxForm) actionForm;
				String folderId = inboxForm.getFolderId();
				if (Utils.isBlankOrNull(folderId)) {
					folderId = InboxConstants.INBOX_FOLDER_INBOX;
				}
				String sortBy = inboxForm.getSortBy();
				if (Utils.isBlankOrNull(sortBy)) {
					sortBy = InboxConstants.SORT_BY_DATE;
				}
				String sortDir = inboxForm.getSortDir();
				if (Utils.isBlankOrNull(sortDir)) {
					sortDir = CommonConstants.SORT_DIR_DESC;
				}
				InboxManager inboxManager = new InboxManager();
				ArrayList emails = null;
				if (!folderId.equalsIgnoreCase(InboxConstants.INBOX_FOLDER_SENT)) {
					int draftsFolderId = inboxManager.getFolderIdForSystemFolderDrafts();
					boolean isDrafts = folderId.equals(String.valueOf(draftsFolderId));
					emails = inboxManager.getAllEmails(folderId, sortBy, sortDir, isDrafts, permissionSet, userId);
					xmlFile = inboxManager.getXMLForEmails(emails);
				} else {
					emails = inboxManager.getSentEmails(sortBy, sortDir);
					xmlFile = inboxManager.getXMLForSentEmails(emails);
				}

			}
		} catch (Exception e) {
			TPLogger.getLogger().error("Error while getting Inbox Settings", e);
		}
		request.setAttribute("xmlFile", xmlFile);
		return mapping.findForward(forward);
	}

	public ActionForward getEmailBody(ActionMapping mapping, ActionForm actionForm, HttpServletRequest request, HttpServletResponse response) {
		if (!SessionManager.validateSession(mapping, actionForm, request, response, this)) {
			return null;
		}
		String forward = "messageBody";
		Integer[] permissions = new Integer[1];
		permissions[0] = PermissionConstants.PERMISSION_IMPORT;
		if(!isUserAuthorized(request, CommonConstants.NO_MODULE, permissions,null,null,null)) {
			forward = "authorizationFailure";			
			return mapping.findForward(forward);
