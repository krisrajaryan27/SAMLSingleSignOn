	public ActionForward forwardToCandidateRecord(ActionMapping mapping, ActionForm actionForm, HttpServletRequest request, HttpServletResponse response) {
		String forward = "xmlFile";
		String xmlFile = "";
		try {
			if (!SessionManager.isLoginFound(mapping, actionForm, request, response, this)) {
				xmlFile = Utils.getXMLForSessionExpiry();
			} else {
				InboxForm inboxForm = (InboxForm) actionForm;
				String userId = (String) request.getSession().getAttribute("userId");
				// Check if original resume needs to be replaced.
				String updateResume = inboxForm.getUpdateResume();
				InboxManager inboxManager = new InboxManager();
				if (!Utils.isBlankOrNull(updateResume) && updateResume.equals("1")) {
					// Convert the resume to html format if word or doc

					// if (inboxForm.getSelAttachment() != null &&
					// !inboxForm.getSelAttachment().equals("0")) {
					// AttachmentData aData =
					// inboxManager.getAttachmentData(inboxForm.getSelAttachment());
					// String filePath = Utils.concatFilePath(DocumentConstants.documentsPath,
					// aData.getAttachmentFilePath());
					// DocumentUploader documentUploader = new DocumentUploader();
					// String htmlFilePath = documentUploader.getHtmlFilePathIfExist(filePath);
					// if (!Utils.isBlankOrNull(htmlFilePath)) {
					// filePath = htmlFilePath;
					// }
					// }

					ApplicantManager applicantManager = new ApplicantManager();
					String applicantOriginalDocPath = applicantManager.saveOriginalResume(inboxForm.getSelAttachment(), inboxForm.getEmailId(), null);
					DocumentUploader documentUploader = new DocumentUploader();
					String applicantOriginalResumePath = documentUploader.getHtmlFilePathIfExist(Utils.concatFilePath(DocumentConstants.documentsPath, applicantOriginalDocPath));

					applicantOriginalDocPath = (applicantOriginalDocPath == null) ? "" : applicantOriginalDocPath;
					applicantOriginalResumePath = (applicantOriginalResumePath == null) ? "" : applicantOriginalResumePath;

					if (applicantOriginalResumePath.length() > DocumentConstants.documentsPath.length()) {
						applicantOriginalResumePath = applicantOriginalResumePath.substring(DocumentConstants.documentsPath.length() + 1);
					}

					String filePath = Utils.concatFilePath(DocumentConstants.documentsPath, applicantOriginalResumePath);
					GenericConverter conv = new GenericConverter();
					String fileContent = conv.convert(filePath);
					applicantManager.updateOriginalResume(inboxForm.getApplicantId(),inboxForm.getPositionId(), applicantOriginalResumePath, applicantOriginalDocPath, fileContent);

				}
				inboxManager.attachEmailToApplicantRecord(inboxForm.getApplicantId(), inboxForm.getEmailId(), userId);
				// Create deleted xml
				xmlFile = Utils.getXMLForIds(inboxForm.getEmailId());
			}
		} catch (Exception e) {
			TPLogger.getLogger().error("Error in forward to candidate record", e);
			xmlFile = Utils.getXMLForError(null);
		}
		request.setAttribute("xmlFile", xmlFile);
		return mapping.findForward(forward);
	}

	public ActionForward viewEmail(ActionMapping mapping, ActionForm actionForm, HttpServletRequest request, HttpServletResponse response) {
		if (!SessionManager.validateSession(mapping, actionForm, request, response, this)) {
