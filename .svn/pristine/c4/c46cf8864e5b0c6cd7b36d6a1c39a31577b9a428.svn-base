	public ActionForward viewCSVImportData(ActionMapping mapping, ActionForm actionForm, HttpServletRequest request, HttpServletResponse response) {
		String forward = "xmlFile";
		String xmlFile = "";
		try {
			if (!SessionManager.isLoginFound(mapping, actionForm, request, response, this)) {
				xmlFile = Utils.getXMLForSessionExpiry();
			} else {
				InboxForm inboxForm = (InboxForm) actionForm;
				String sessionId = inboxForm.getSessionId();
				String mappings = inboxForm.getMappings();
				String lastRowId = inboxForm.getLastRowId();
				CSVUploadManager csvUploadManager = new CSVUploadManager();
				ArrayList<ImportData> excelList = csvUploadManager.getExcelImportData(sessionId, lastRowId);

				for (int i = 0; i < excelList.size(); i++) {
					ImportData iData = (ImportData) excelList.get(i);
					CustomFieldManager customFieldManager = new CustomFieldManager();
					CustomFieldDataProcessor customFieldDataProcessor = new CustomFieldDataProcessor();

					ArrayList customFields = customFieldManager.getCustomFieldsForInputAllowed(CustomFieldConstants.ENTITY_TYPE_APPLICANT, CustomFieldConstants.INPUT_ALLOWED, true);
					ArrayList<CustomFieldData> customFieldsValues = customFieldManager.getCustomFieldDataForEntity(iData.getSessionId() + iData.getRowNumber(),
							CustomFieldConstants.ENTITY_TYPE_EXCEL_IMPORT);
					customFieldDataProcessor.setCustomFieldValuesFromPreviousValues(customFields, customFieldsValues);
					iData.setCustomFields(customFields);
				}

				CSVImportUtils csvImportUtils = new CSVImportUtils();
				xmlFile = csvImportUtils.getXMLViewCSVImport(excelList, mappings);
			}
		} catch (Exception e) {
			TPLogger.getLogger().error(GlobalConstants.ERROR, e);
		}
		request.setAttribute("xmlFile", xmlFile);
		return mapping.findForward(forward);
	}
	
