	public ActionForward viewAttachment(ActionMapping mapping, ActionForm actionForm, HttpServletRequest request, HttpServletResponse response) {
		String forward = "getDocument";
		if (!SessionManager.validateSession(mapping, actionForm, request, response, this)) {
			return null;
		}
		InboxForm inboxForm = (InboxForm) actionForm;
		try {			
			InboxManager inboxManager = new InboxManager();
			AttachmentData data = inboxManager.getTmpAttachment(inboxForm.getTmpAttachmentId());
			FileHandler fileHandler = new FileHandler();
			String contentType = fileHandler.getContentType(data.getContentType());				
			request.setAttribute("filePath", Utils.concatFilePath(DocumentConstants.documentsPath, data.getAttachmentFilePath()));
			request.setAttribute("contentType", contentType);
			request.setAttribute("fileName", data.getOriginalFileName());
			request.setAttribute("contentDisposition", DocumentConstants.CONTENT_DISPOSITION_ATTACHMENT);
		}catch (Exception e) {			
			TPLogger.getLogger().error(GlobalConstants.ERROR, e);
		}
		return mapping.findForward(forward);
	}
	
	private String validateEmailAttachment(FormFile formFile, String tmpEmailId){
		InboxManager inboxManager = null;
		FileHandler fh 	= new FileHandler();
		String error 	= "";
		String fileName = formFile.getFileName();
		if (formFile.getFileSize() <= 0) {
			error = TPLabels.getLabel("attachment.error.could_not_read_file");
		} else {
			inboxManager = new InboxManager();
			long totalSize = formFile.getFileSize() + inboxManager.getTmpAttachmentSize(tmpEmailId);
			double maxSizeInBytes = new Double(GlobalApplicationProperties.getProperty(GlobalConstants.PROPERTY_MAX_ATTACHMENT_SIZE_IN_MB)).doubleValue() * 1000 * 1024;
			if (totalSize > maxSizeInBytes) {
				error = TPLabels.getLabel("attachment.error.size_exceeded_max");
			}
		}
		error+=fh.isValidEmailAttachment(fileName);
		return error;
	} 
}