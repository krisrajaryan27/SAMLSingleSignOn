	public ActionForward forwardResumes(ActionMapping mapping, ActionForm actionForm, HttpServletRequest request, HttpServletResponse response) {
		if (!SessionManager.validateSession(mapping, actionForm, request, response, this)) {
			return null;
		}
		String forward = "newEmail";
		InboxForm inboxForm = (InboxForm) actionForm;
		try {
			String userId = (String) request.getSession().getAttribute("userId");
			String applicants = inboxForm.getApplicantId();

			// get random unique new email id
			String tmpEmailId = inboxForm.getTmpEmailId();

			if (Utils.isBlankOrNull(tmpEmailId)) {
				tmpEmailId = Utils.getRandomString(12, 0, 0, true, true, null, new Random());
				inboxForm.setTmpEmailId(tmpEmailId);

				LoginManager loginManager = new LoginManager();
				LoginData userData = loginManager.getUser(userId);
				inboxForm.setFrom(userData.getName() + " <" + userData.getEmail() + ">");
			}
			

			InboxManager inboxManager = new InboxManager();

			if (Utils.isBlankOrNull(tmpEmailId)) {
				tmpEmailId = Utils.getRandomString(12, 0, 0, true, true, null, new Random());
				inboxForm.setTmpEmailId(tmpEmailId);
				String emailLocation = inboxForm.getEmailLocation();

				if (emailLocation.equals(InboxConstants.EMAIL_LOCATION_COMMUNICATIONS)) {
//					if (emailType.equals(InboxConstants.EMAIL_TYPE_NEW) || emailType.equals(InboxConstants.EMAIL_TYPE_REPLY)) {
//						ApplicantData aData = applicantManager.getApplicantEmailAddress(inboxForm.getApplicantId(), true);
//						String emails = ApplicantUtils.getEmailToString(aData);
//						inboxForm.setTo(emails);
//					}
				}
				LoginManager loginManager = new LoginManager();
				
				LoginData userData = loginManager.getUser(userId);
				inboxForm.setFrom(userData.getName() + " <" + userData.getEmail() + ">");

			} else {
				MessageData messageData = new MessageData();
				ArrayList attachments = inboxManager.getTmpAttachments(tmpEmailId);
				if (attachments != null) {
					messageData.setAttachments(attachments);
				}
				request.setAttribute("messageData", messageData);

			}
			
			MassEmailManager emailManager = new MassEmailManager();
			MessageData msgData = emailManager.getMessageData("forwardResumes", applicants, "", userId);
			inboxForm.setNewEmailBody(msgData.getHtmlBody());
			inboxForm.setSubject(msgData.getSubject());
			inboxForm.setTemplateCode("forwardResumes");

			InboxBC inboxBC = new InboxBC();
			inboxBC.getTemplates(request);
			
		} catch (Exception e) {
			TPLogger.getLogger().error(GlobalConstants.ERROR, e);
		}
		return mapping.findForward(forward);
	}

	public ActionForward attachResumes(ActionMapping mapping, ActionForm actionForm, HttpServletRequest request, HttpServletResponse response) {
		if (!SessionManager.validateSession(mapping, actionForm, request, response, this)) {
			return null;
		}
		String forward = "attachResumes";
		ArrayList<AttachmentData> dataList = new ArrayList<AttachmentData>();
		InboxForm inboxForm = (InboxForm) actionForm;
		String error = "";
		try {
			InboxManager inboxManager = new InboxManager();
			String applicantIds = inboxForm.getApplicantId();
			String [] applicantStr = applicantIds.split(",");
			
			ApplicantManager applicantManager = new ApplicantManager();
			AttachmentData aData = null;
			long totalSize = 0;
			long fileSize = 0;
			File file = null;
			for (int i = 0; i < applicantStr.length; i++) {
				String id = applicantStr[i];
				ApplicantData applicantData = applicantManager.getApplicantSummaryData(id);
				String originalDocPath = applicantData.getApplicantOriginalDocPath();
				String fullPath = Utils.concatFilePath(DocumentConstants.documentsPath, originalDocPath);
				file = new File(fullPath);
				if(file.exists()){
					fileSize=file.length();
					totalSize += fileSize;
				}else {
					fileSize = 0;
				}
				String fileName = applicantData.getApplicantName()+FileHandlerUtils.getFileExtention(originalDocPath);
				String attachmentId =  inboxManager.getAbsoluteAttachmentPath(fileName, "application/msword", fileSize, originalDocPath, inboxForm.getTmpEmailId(), inboxForm.getEmailLocation());
				aData = new AttachmentData();
				aData.setAttachmentId(attachmentId);
				aData.setOriginalFileName(fileName);
				aData.setAttachmentSize(fileSize);
				dataList.add(aData);
			}
			
			//check for max size
			double maxSizeInBytes = new Double(GlobalApplicationProperties.getProperty(GlobalConstants.PROPERTY_MAX_ATTACHMENT_SIZE_IN_MB)).doubleValue() * 1000 * 1024;
			if (totalSize > maxSizeInBytes) {
				error = TPLabels.getLabel("attachment.error.size_exceeded_max");
			}
			if (Utils.isBlankOrNull(error)) {
				request.setAttribute("dataList", dataList);
			}

			
		} catch (FileUploadException fe) {
			error = TPLabels.getLabel("attachment.error.could_not_read_file");
		} catch (Exception e) {
			TPLogger.getLogger().error(GlobalConstants.ERROR, e);
		}
		request.setAttribute("error", error);
		return mapping.findForward(forward);
	}
