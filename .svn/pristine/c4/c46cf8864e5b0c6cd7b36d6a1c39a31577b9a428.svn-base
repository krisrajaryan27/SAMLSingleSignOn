	}

	public ActionForward changeReadStatus(ActionMapping mapping, ActionForm actionForm, HttpServletRequest request, HttpServletResponse response) {
		String forward = "xmlFile";
		String xmlFile = "";
		try {
			if (!SessionManager.isLoginFound(mapping, actionForm, request, response, this)) {
				xmlFile = Utils.getXMLForSessionExpiry();
			} else {
				InboxForm inboxForm = (InboxForm) actionForm;
				String userId = (String) request.getSession().getAttribute("userId");
				InboxManager inboxManager = new InboxManager();
				inboxManager.changeEmailReadStatus(inboxForm.getEmailId(), userId, InboxConstants.INBOX_EMAIL_STATUS_UNREAD);
				// Create changed email status
				xmlFile = Utils.getXMLForIds(inboxForm.getEmailId());
			}
		} catch (Exception e) {
			TPLogger.getLogger().error("Error while getting Inbox Settings", e);
			xmlFile = Utils.getXMLForError(null);
		}
		request.setAttribute("xmlFile", xmlFile);
		return mapping.findForward(forward);
	}

	public ActionForward getEmailHeader(ActionMapping mapping, ActionForm actionForm, HttpServletRequest request, HttpServletResponse response) {
		String forward = "xmlFile";
		String xmlFile = "";
		try {
			Integer[] permissions = new Integer[1];
			permissions[0] = PermissionConstants.PERMISSION_IMPORT;
			
			if (!SessionManager.isLoginFound(mapping, actionForm, request, response, this)) {
				xmlFile = Utils.getXMLForSessionExpiry();
			} else if(!isUserAuthorized(request, CommonConstants.NO_MODULE, permissions,null,null,null)) {
				forward = "authorizationFailure";			
				return mapping.findForward(forward);
			} else {
				InboxForm inboxForm = (InboxForm) actionForm;
				String userId = (String) request.getSession().getAttribute("userId");
				InboxManager inboxManager = new InboxManager();
				MessageData mData = inboxManager.getEmailHeader(inboxForm.getEmailId(), inboxForm.getEmailLocation(), true);
				if (mData != null) {
					inboxManager.changeEmailReadStatus(inboxForm.getEmailId(), userId, InboxConstants.INBOX_EMAIL_STATUS_READ);
					xmlFile = inboxManager.getXMLForEmailHeader(mData, inboxForm.getEmailLocation());
				}
			}
		} catch (Exception e) {
			TPLogger.getLogger().error("Error while getting Inbox Settings", e);
			xmlFile = Utils.getXMLForError(null);
		}
		request.setAttribute("xmlFile", xmlFile);
		return mapping.findForward(forward);
	}

