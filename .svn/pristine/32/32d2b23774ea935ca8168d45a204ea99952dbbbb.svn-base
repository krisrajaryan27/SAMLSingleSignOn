package com.talentPool.dynamicReports.data;

import com.talentPool.common.db.SimpleDataObject;

/**
 * @author SumeetS
 *
 */
public class JoinerReportData extends SimpleDataObject {
	
	/**
	 * 
	 */
	private static final long serialVersionUID = 1L;

	/**
	 * @return srNo
	 */
	public String getSrNo(){
		return getString("srNo");
	}
	
	/**
	 * @param srNo
	 */
	public void setSrNo(String srNo){
		setAttribute("srNo", srNo);
	}
	
	/**
	 * @return dateOfJoining
	 */
	public String getDateOfJoining(){
		return getString("dateOfJoining");
	}
	
	/**
	 * @param dateOfJoining
	 */
	public void setDateOfJoining(String dateOfJoining){
		setAttribute("dateOfJoining",dateOfJoining);
	}
	
	/**
	 * @return name
	 */
	public String getName(){
		return getString("name");
	}
	
	/**
	 * @param name
	 */
	public void setName(String name){
		setAttribute("name", name);
	}
	
	/**
	 * @return designation
	 */
	public String getDesignation(){
		return getString("designation");
	}
	
	/**
	 * @param designation
	 */
	public void setDesignation(String designation){
		setAttribute("designation", designation);
	}
	
	/**
	 * @return status
	 */
	public String getStatus(){
		return getString("status");
	}
	
	/**
	 * @param status
	 */
	public void setStatus(String status){
		setAttribute("status", status);
	}
	
	/**
	 * @return team
	 */
	public String getTeam(){
		return getString("team");
	}
	
	/**
	 * @param team
	 */
	public void setTeam(String team){
		setAttribute("team", team);
	}
	
	/**
	 * @return requisitioner
	 */
	public String getRequisitioner(){
		return getString("requisitioner");
	}
	
	/**
	 * @param requisitioner
	 */
	public void setRequisitioner(String requisitioner){
		setAttribute("requisitioner", requisitioner);
	}
}
