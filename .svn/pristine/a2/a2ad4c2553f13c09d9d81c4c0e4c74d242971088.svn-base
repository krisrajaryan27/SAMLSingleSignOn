package com.talentPool.positions.dataobject;

import com.talentPool.common.db.SimpleDataObject;

/**
 * @author pallavi
 *
 */
public class DraftData extends SimpleDataObject {	
	/**
	 * @return the draftId
	 */
	public String getDraftId() {
		return getString("draftId");
	}
	/**
	 * @param draftId the draftId to set
	 */
	public void setDraftId(String draftId) {
		setAttribute("draftId", draftId);
	}
	/**
	 * @return the originalFileName
	 */
	public String getOriginalFileName() {
		return getString("originalFileName");
	}
	/**
	 * @param originalFileName the originalFileName to set
	 */
	public void setOriginalFileName(String originalFileName) {
		setAttribute("originalFileName", originalFileName);
	}
	/**
	 * @return the relativeFilePath
	 */
	public String getRelativeFilePath() {
		return getString("relativeFilePath");
	}
	/**
	 * @param relativeFilePath the relativeFilePath to set
	 */
	public void setRelativeFilePath(String relativeFilePath) {
		setAttribute("relativeFilePath", relativeFilePath);
	}
	/**
	 * @return the errors
	 */
	public String getErrors() {
		return getString("errors");
	}
	/**
	 * @param errors the errors to set
	 */
	public void setErrors(String errors) {
		setAttribute("errors", errors);
	}
}
