package com.talentPool.reports.views;

import com.talentPool.common.db.SimpleDataObject;

public class sourceWiseHiringView extends SimpleDataObject {
	
	public sourceWiseHiringView(){
		super();
	}
    
	public String getSourceName() {
		return getString("sourceName");
	}
	
	public String getSourceCategory() {
		return getString("sourceCategory");
	}
	
	public int getNoOfJoined() {
		return getInt("noOfJoined");
	}
}
