<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE web-app PUBLIC "-//Sun Microsystems, Inc.//DTD Web Application 2.3//EN" "http://java.sun.com/j2ee/dtds/web-app_2_3.dtd">

<web-app>
	<display-name>TalentPool</display-name>
	<filter>
		<filter-name>LogRequestFilter</filter-name>
		<filter-class>com.talentPool.common.filters.LogRequestFilter
		</filter-class>
	</filter>
	<filter-mapping>
		<filter-name>LogRequestFilter</filter-name>
		<url-pattern>*.do</url-pattern>
	</filter-mapping>
	<filter-mapping>
		<filter-name>LogRequestFilter</filter-name>
		<url-pattern>*.action</url-pattern>
	</filter-mapping>
	<filter>
		<filter-name>RequestMethodFilter</filter-name>
		<filter-class>com.talentPool.common.filters.RequestMethodFilter
		</filter-class>
	</filter>
	<filter-mapping>
		<filter-name>RequestMethodFilter</filter-name>
		<url-pattern>/*</url-pattern>
	</filter-mapping>
	<servlet>
		<servlet-name>action</servlet-name>
		<servlet-class>org.apache.struts.action.ActionServlet</servlet-class>
		<init-param>
			<param-name>config</param-name>
			<param-value>/WEB-INF/struts-config.xml</param-value>
		</init-param>
		<init-param>
			<param-name>application</param-name>
			<param-value>talentpoollabels</param-value>
		</init-param>
		<init-param>
			<param-name>debug</param-name>
			<param-value>2</param-value>
		</init-param>
		<init-param>
			<param-name>detail</param-name>
			<param-value>2</param-value>
		</init-param>
		<load-on-startup>2</load-on-startup>
	</servlet>
	<servlet-mapping>
		<servlet-name>action</servlet-name>
		<url-pattern>*.do</url-pattern>
	</servlet-mapping>
	<servlet>
		<servlet-name>AxisServlet</servlet-name>
		<display-name>Apache-Axis Servlet</display-name>
		<!-- servlet-class>org.apache.axis.transport.http.AxisServlet</servlet-class -->
		<servlet-class>com.talentPool.services.filter.AxisFilterServlet
		</servlet-class>
	</servlet>
	<servlet>
		<servlet-name>AdminServlet</servlet-name>
		<display-name>Axis Admin Servlet</display-name>
		<servlet-class>
			org.apache.axis.transport.http.AdminServlet
		</servlet-class>
		<load-on-startup>100</load-on-startup>
	</servlet>
	<servlet>
		<servlet-name>importServlet</servlet-name>
		<servlet-class>com.talentPool.ie.servlets.ImportServlet
		</servlet-class>
	</servlet>
	<servlet>
		<servlet-name>importServletHelper</servlet-name>
		<servlet-class>com.talentPool.ie.servlets.ImportServletHelper
		</servlet-class>
	</servlet>
	<servlet>
		<servlet-name>EncryptionServlet</servlet-name>
		<servlet-class>com.talentPool.encryption.EncryptionServlet
		</servlet-class>
	</servlet>
	<servlet>
		<servlet-name>loginServlet</servlet-name>
		<servlet-class>com.talentPool.desktop.servlets.LoginServlet
		</servlet-class>
	</servlet>
	<servlet>
		<servlet-name>dbPoolServlet</servlet-name>
		<servlet-class>com.talentPool.common.db.servlet.DBPoolServlet
		</servlet-class>
	</servlet>
	<servlet>
		<servlet-name>uploadEmailServlet</servlet-name>
		<servlet-class>com.talentPool.desktop.servlets.UploadEmailServlet
		</servlet-class>
	</servlet>
	<servlet>
		<servlet-name>importSingleEmailServlet</servlet-name>
		<servlet-class>com.talentPool.desktop.servlets.ImportSingleEmailServlet
		</servlet-class>
	</servlet>
	<servlet>
		<servlet-name>bulkImportServlet</servlet-name>
		<servlet-class>com.talentPool.desktop.servlets.BulkImportServlet
		</servlet-class>
	</servlet>
	<servlet>
		<servlet-name>lookupTPShortlistCompareServlet</servlet-name>
		<servlet-class>com.talentPool.lookupTalentpool.servlets.LookupTPShortlistCompareServlet
		</servlet-class>
	</servlet>
	<servlet>
		<servlet-name>authentication</servlet-name>
		<servlet-class>com.talentPool.desktop.saml.Authentication
		</servlet-class>
	</servlet>
	<servlet>
		<servlet-name>consumer</servlet-name>
		<servlet-class>com.talentPool.desktop.saml.Consumer</servlet-class>
	</servlet>
	<servlet>
		<servlet-name>metadata</servlet-name>
		<servlet-class>com.talentPool.desktop.saml.Metadata</servlet-class>
	</servlet>
	<servlet-mapping>
		<servlet-name>authentication</servlet-name>
		<url-pattern>/SPInitiator</url-pattern>
	</servlet-mapping>
	<servlet-mapping>
		<servlet-name>consumer</servlet-name>
		<url-pattern>/assertion-consumer-service</url-pattern>
	</servlet-mapping>
	<servlet-mapping>
		<servlet-name>metadata</servlet-name>
		<url-pattern>/metadata</url-pattern>
	</servlet-mapping>
	<servlet-mapping>
		<servlet-name>EncryptionServlet</servlet-name>
		<url-pattern>/EncryptionServlet</url-pattern>
	</servlet-mapping>
	<servlet-mapping>
		<servlet-name>AxisServlet</servlet-name>
		<url-pattern>*.jws</url-pattern>
	</servlet-mapping>
	<servlet-mapping>
		<servlet-name>AxisServlet</servlet-name>
		<url-pattern>/servlet/AxisServlet</url-pattern>
	</servlet-mapping>
	<servlet-mapping>
		<servlet-name>AxisServlet</servlet-name>
		<url-pattern>/services/*</url-pattern>
	</servlet-mapping>
	<servlet-mapping>
		<servlet-name>AdminServlet</servlet-name>
		<url-pattern>/servlet/AdminServlet</url-pattern>
	</servlet-mapping>
	<servlet-mapping>
		<servlet-name>importServlet</servlet-name>
		<url-pattern>/importServlet.servlet</url-pattern>
	</servlet-mapping>
	<servlet-mapping>
		<servlet-name>importServletHelper</servlet-name>
		<url-pattern>/importServletHelper.servlet</url-pattern>
	</servlet-mapping>
	<servlet-mapping>
		<servlet-name>loginServlet</servlet-name>
		<url-pattern>/loginServlet.servlet</url-pattern>
	</servlet-mapping>
	<servlet-mapping>
		<servlet-name>dbPoolServlet</servlet-name>
		<url-pattern>/dbPoolServlet.servlet</url-pattern>
	</servlet-mapping>
	<servlet-mapping>
		<servlet-name>uploadEmailServlet</servlet-name>
		<url-pattern>/uploadEmailServlet.servlet</url-pattern>
	</servlet-mapping>
	<servlet-mapping>
		<servlet-name>importSingleEmailServlet</servlet-name>
		<url-pattern>/importSingleEmailServlet.servlet</url-pattern>
	</servlet-mapping>
	<servlet-mapping>
		<servlet-name>bulkImportServlet</servlet-name>
		<url-pattern>/bulkImportServlet.servlet</url-pattern>
	</servlet-mapping>
	<servlet-mapping>
		<servlet-name>lookupTPShortlistCompareServlet</servlet-name>
		<url-pattern>/lookupTPShortlistCompareServlet.servlet</url-pattern>
	</servlet-mapping>
	<servlet>
		<servlet-name>listing</servlet-name>
		<servlet-class>org.apache.catalina.servlets.DefaultServlet
		</servlet-class>
		<init-param>
			<param-name>debug</param-name>
			<param-value>0</param-value>
		</init-param>
		<init-param>
			<param-name>listings</param-name>
			<param-value>false</param-value>
		</init-param>
		<load-on-startup>1</load-on-startup>
	</servlet>
	<servlet-mapping>
		<servlet-name>listing</servlet-name>
		<url-pattern>/</url-pattern>
	</servlet-mapping>
	<servlet>
		<servlet-name>Log4JInitServlet</servlet-name>
		<servlet-class>com.talentPool.common.Logger.TPLog4JInitServlet
		</servlet-class>
		<init-param>
			<param-name>log4j-properties-location</param-name>
			<param-value>WEB-INF/classes/log4j.properties</param-value>
		</init-param>
		<load-on-startup>3</load-on-startup>
	</servlet>
	<servlet>
		<servlet-name>Jersey Rest Web-Service</servlet-name>
		<servlet-class>com.sun.jersey.spi.container.servlet.ServletContainer
		</servlet-class>
		<init-param>
			<param-name>com.sun.jersey.config.property.packages</param-name>
			<param-value>com.talentPool.rest</param-value>
		</init-param>
		<load-on-startup>101</load-on-startup>
	</servlet>
	<servlet-mapping>
		<servlet-name>Jersey Rest Web-Service</servlet-name>
		<url-pattern>/rest/*</url-pattern>
	</servlet-mapping>
	<filter>
		<filter-name>ReportsResponseHeaderFilter</filter-name>
		<filter-class>com.talentPool.common.filters.ReportsResponseHeaderFilter
		</filter-class>
	</filter>
	<filter-mapping>
		<filter-name>ReportsResponseHeaderFilter</filter-name>
		<url-pattern>/reportsout/*</url-pattern>
	</filter-mapping>
	<filter>
		<filter-name>URLSessionFilter</filter-name>
		<filter-class>com.talentPool.common.filters.URLSessionFilter
		</filter-class>
	</filter>
	<filter-mapping>
		<filter-name>URLSessionFilter</filter-name>
		<url-pattern>/*</url-pattern>
	</filter-mapping>
	<context-param>
		<param-name>org.apache.tiles.impl.BasicTilesContainer.DEFINITIONS_CONFIG
		</param-name>
		<param-value>/WEB-INF/tiles.xml</param-value>
	</context-param>
	<listener>
		<listener-class>
			com.talentPool.desktop.saml.context.SPContextListener
		</listener-class>
	</listener>
	<listener>
		<listener-class>org.apache.struts2.tiles.StrutsTilesListener
		</listener-class>
	</listener>
	<filter>
		<filter-name>struts2</filter-name>
		<filter-class>org.apache.struts2.dispatcher.ng.filter.StrutsPrepareAndExecuteFilter
		</filter-class>
	</filter>
	<filter-mapping>
		<filter-name>struts2</filter-name>
		<url-pattern>*.action</url-pattern>
	</filter-mapping>
	<listener>
		<listener-class>
			org.springframework.web.context.ContextLoaderListener
		</listener-class>
	</listener>
	<welcome-file-list>
		<welcome-file>index.jsp</welcome-file>
	</welcome-file-list>
	<!-- Struts Tag Library Descriptors -->
	<taglib>
		<taglib-uri>/tags/struts-bean</taglib-uri>
		<taglib-location>/WEB-INF/tld/struts-bean.tld</taglib-location>
	</taglib>
	<taglib>
		<taglib-uri>/tags/struts-html</taglib-uri>
		<taglib-location>/WEB-INF/tld/struts-html.tld</taglib-location>
	</taglib>
	<taglib>
		<taglib-uri>/tags/struts-logic</taglib-uri>
		<taglib-location>/WEB-INF/tld/struts-logic.tld</taglib-location>
	</taglib>
	<taglib>
		<taglib-uri>/tags/struts-nested</taglib-uri>
		<taglib-location>/WEB-INF/tld/struts-nested.tld</taglib-location>
	</taglib>
	<taglib>
		<taglib-uri>/tags/struts-tiles</taglib-uri>
		<taglib-location>/WEB-INF/tld/struts-tiles.tld</taglib-location>
	</taglib>
	<listener>
		<listener-class>com.talentPool.initialLoader.Loader</listener-class>
	</listener>
	<session-config>
		<session-timeout>30</session-timeout>
	</session-config>
	<error-page>
		<error-code>400</error-code>
		<location>/common/httpError.jsp</location>
	</error-page>
	<error-page>
		<error-code>404</error-code>
		<location>/common/httpError.jsp</location>
	</error-page>
	<error-page>
		<error-code>500</error-code>
		<location>/common/httpError.jsp</location>
	</error-page>
	<error-page>
		<exception-type>java.lang.Exception</exception-type>
		<location>/common/exception.jsp</location>
	</error-page>
</web-app>