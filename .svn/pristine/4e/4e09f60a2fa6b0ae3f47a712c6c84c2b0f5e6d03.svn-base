package com.talentPool.admin.dataobject;

import com.talentPool.common.db.SimpleDataObject;

/**
 * @author Shantanu
 * 
 */
public class ReportLevelData extends SimpleDataObject {
	/**
	 * @return the levelId
	 */
	public int getLevelId() {
		return getInt("levelId");
	}

	/**
	 * @param levelId
	 *            the levelId to set
	 */
	public void setLevelId(int levelId) {
		setAttribute("levelId",levelId);
	}
	
	/**
	 * @return the levelName
	 */
	public String getLevelName() {
		return getString("levelName");
	}

	/**
	 * @param levelName
	 *            the levelName to set
	 */
	public void setLevelName(String levelName) {
		setAttribute("levelName", levelName);
	}
		
	/**
	 * @param levelIsSelected
	 * @return
	 */
	public String getLevelIsSelected() {
		return getString("levelIsSelected");
	}
	
	public String getName() {
		return getString("name");
	}
	
	public void setName(String name) {
		setAttribute("name", name);
	}
	
	public String getUserId() {
		return getString("userId");
	}
	
	public void setUserId(String userId) {
		setAttribute("userId", userId);
	}
	
	
}
