	public void updateTemplatesForDisabledStep(String stepMasterId, DBTransaction tran) {
		DBPreparedQuery dq = null;
		try {
			dq = new DBPreparedQuery("dPositionManager_DeletePositionStepByStepMasterId", tran);
			dq.setString(1, PositionConstants.STEP_DELETED);
			dq.setString(2, PositionConstants.POSITION_STATUS_TEMPLATE);
			dq.setString(3, stepMasterId);
			dq.execute();

			dq = new DBPreparedQuery("dPositionManager_GetPositionTemplatesForStep", tran);
			dq.setString(1, PositionConstants.POSITION_STATUS_TEMPLATE);
			dq.setString(2, stepMasterId);
			List<StepData> tempList = dq.getResult();
			for (StepData step : tempList) {
				decreamentTemplateStepRank(step.getStepRank(), step.getPositionId(), tran);
			}

		} catch (Exception e) {
			TPLogger.getLogger().error(e);
		} finally {
			if (dq != null) {
				dq.closeOpenCursors();
			}
		}
	}

	public void decreamentTemplateStepRank(int stepRank, String positionId, DBTransaction tran) throws Exception {
		DBPreparedQuery dq = null;
		try {
			dq = new DBPreparedQuery("dPositionManager_2_AlterPositionStepRank", tran);
			dq.setString(1, positionId);
			dq.setInt(2, stepRank);
			dq.setString(3, PositionConstants.STEP_ACTIVE);
			dq.setInt(4, PositionConstants.STEP_NOT_DEFAULT);
			dq.execute();

			// TODO:
			// Not re-generation TO-DOs as this method is used for templates
			// If used for positions other than templates, need to re-generate
			// TO-DOs.

		} finally {
			if (dq != null) {
				dq.closeOpenCursors();
			}
		}
	}

	/**
	 * @param positionId
	 * @param positionStepId
	 * @param oldObject
	 * @param mode
	 * @param userId
	 */
	public void sendPositionChangeNotification(String positionId, String positionStepId, SimpleDataObject oldObject,
			String mode, String userId) {
		if (GlobalApplicationProperties.getProperty(GlobalConstants.PROPERTY_SEND_POSITION_CHANGE_NOTIFICATION)
				.equals(GlobalConstants.ENABLED)) {
			PositionManager positionManager = new PositionManager();
			String positionStatus = positionManager.getpositionStatus(positionId);
			if (!positionStatus.equals(PositionConstants.POSITION_STATUS_TEMPLATE)) {

				ArrayList<String[]> changeFields = new ArrayList<String[]>();
				if (mode.equals(PositionConstants.MODE_DESCRIPTION)) {

					SimpleDataObject newPosition = (SimpleDataObject) positionManager
							.getPositionDescriptionToView(positionId);

					PositionUtils.checkIfFieldValueChanged(oldObject, newPosition, changeFields);

				} else if (mode.equals(PositionConstants.MODE_REQUIREMENTS)) {

					SimpleDataObject newPosition = (SimpleDataObject) positionManager
							.getPositionRequirementsToView(positionId);

					PositionUtils.checkIfFieldValueChanged(oldObject, newPosition, changeFields);

				} else if (mode.equals(PositionConstants.MODE_HIRING_PROCESS)) {
					SimpleDataObject newStepData = new SimpleDataObject();
					List positionStepUsers = positionManager.getPositionStepUsers(positionStepId);
					for (Object object2 : positionStepUsers) {
						SimpleDataObject stepUsers = (SimpleDataObject) object2;
						if (stepUsers.getInt("isResponsibleForScheduling") == PositionConstants.STEP_NOT_SCHEDULED) {
							if (stepUsers.getInt("isAuthorizedToMove") == PositionConstants.NOT_AUTHORIZED_TO_MOVE) {
								newStepData.setAttribute("assignedTo", stepUsers.getString("userNames"));
							} else {
								newStepData.setAttribute("decisionMaker", stepUsers.getString("userNames"));
							}
						} else {
							newStepData.setAttribute("scheduledBy", stepUsers.getString("userNames"));
						}
					}
					PositionUtils.checkIfFieldValueChanged(oldObject, newStepData, changeFields);
				}
				if (changeFields.size() > 0) {
					TemplateManager templateManager = new TemplateManager();
					TemplateData templateData;
					try {
						templateData = templateManager.getTemplateDataByTemplateTypeId(
								TemplateConstants.TEMPLATE_TYPE_POSITION_CHANGE_NOTIFICATION);

						String contentVM = templateData.getTemplateContentFile();
						String subjectVM = templateData.getTemplateSubjectFile();
						String keyMap = templateData.getTemplateVariables();
						LoginManager loginManager = new LoginManager();

						InboxManager inboxManager = new InboxManager();
						InboxData inboxData = inboxManager.getCurrentInboxSettings();
						String contentStr = TemplateUtils.getConvertedGlobalVars(inboxData);

						PositionData positionData = positionManager.getPositionSummary(positionId);
						String positionStr = TemplateUtils.getConvertedPositionDescriptionData(positionData);
						contentStr = TemplateUtils.appndToToken(contentStr, positionStr);

						if (TemplateUtils.isTypeExist(templateData.getTemplateVariableIds(),
								TemplateConstants.TEMPLATE_VAR_TYPE_POSITIONS)) {
							String customFiledsStr = templateManager.getCustomFieldStr(positionId,
									CustomFieldConstants.ENTITY_TYPE_POSITION);
							contentStr = TemplateUtils.appndToToken(contentStr, customFiledsStr);
						}

						LoginData userData = loginManager.getUser(userId);
						String userStr = TemplateUtils.getConvertedUserData(userData);
						contentStr = TemplateUtils.appndToToken(contentStr, userStr);

						HashMap<String, String> keyValMap = TemplateUtils.getKeyValueMap(keyMap, contentStr);
						StringBuffer buffer = new StringBuffer("");
						buffer.append("<table>");
						buffer.append(
								"<tr><td style=\"width:150; padding-right:5;\"><b>Field Name</b></td><td style=\"width:120; padding-right:5;\"><b>Old Value</b></td><td style=\"width:120;\"><b>New Value</b></td></tr>");
						for (String[] strings : changeFields) {
							buffer.append("<tr><td><b>" + strings[0] + "</b></td><td>" + strings[1] + "</td><td>"
									+ strings[2] + "</td></tr>");
						}
						buffer.append("</table>");
						keyValMap.put("FIELD_CHANGE_DETAILS", buffer.toString());
						VelocityManager velocityManager = new VelocityManager();
						String subject = velocityManager.handle(subjectVM, keyValMap);
						String content = velocityManager.handle(contentVM, keyValMap);

						MessageData messageData = new MessageData();
						messageData.setFrom(inboxData.getInboxDisplayName() + " <" + inboxData.getInboxEmail() + ">");
						messageData.setReadStatus(InboxConstants.INBOX_EMAIL_STATUS_UNREAD);
						messageData.setHtmlBody(content);
						messageData.setSubject(subject);

						TPMailSender sender = new TPMailSender();
						LoginData requestorData = loginManager.getUser(positionData.getRequestedById());
						messageData.setTo(requestorData.getEmail());
						try {
							sender.send(messageData, InboxConstants.EMAIL_BODY_HTML, null);
						} catch (Exception e) {
							TPLogger.getLogger().error(
									"Failed to send position change notification email to " + requestorData.getEmail(),
									e);
						}

						String[] roles = new String[2];
						roles[0] = "" + UserConstants.ROLE_HR_MANAGER;
						roles[1] = "" + UserConstants.ROLE_RECRUITER;

						ArrayList<com.talentPool.positions.dataobject.UserData> users = getUsersForPosition(positionId,
								roles);
						for (com.talentPool.positions.dataobject.UserData userData2 : users) {
							if (!positionData.getRequestedById().equals(userData2.getUserId() + "")) {
								messageData.setTo(userData2.getUserEmail());
								try {
									sender.send(messageData, InboxConstants.EMAIL_BODY_HTML, null);
								} catch (Exception e) {
									TPLogger.getLogger().error("Failed to send position change notification email to "
											+ userData2.getUserEmail(), e);
								}
							}
						}
					} catch (Exception e) {
						e.printStackTrace();
					}
				}
			}
		}
	}

