	private String getNaukriDegree(String loc, String degType) {
		String result = "-1";
		DBPreparedQuery dq = null;
		try {
			switch (degType) {
			case DegreeConstants.TYPE_UG:
				dq = new DBPreparedQuery("dMastersManager_GetNaukriUGDegreeByName");
				break;
			case DegreeConstants.TYPE_PG:
				dq = new DBPreparedQuery("dMastersManager_GetNaukriPGDegreeByName");
				break;
			case DegreeConstants.TYPE_PPG:
				dq = new DBPreparedQuery("dMastersManager_GetNaukriPPGDegreeByName");
				break;
			default:
				dq = null;
				break;
			}

			dq.setString(1, loc);
			String l = dq.getStringResult();
			if (!Utils.isBlankOrNull(l)) {
				result = l;
			}
		} catch (Exception e) {
			TPLogger.getLogger().error("Error while getting Naukri Location", e);
		} finally {
			if (dq != null) {
				dq.closeOpenCursors();
			}
		}

		return result;
	}

	private void updatePublishToWebsite(String positionId, String isPublishToSite, DBTransaction tran,
			String publishFromDate, String publishToDate) throws Exception {
		DBPreparedQuery dq = null;
		try {
			// update is_published to web site flag
			dq = new DBPreparedQuery("dPositionManager_UpdatePositionRule", tran);
			dq.setString(1, isPublishToSite);

			dq.setTimestamp(2, new Timestamp(
					Utils.convertToDate(publishFromDate + " 00:00:00", Utils.regDDMMYYYYHHMMSSFromat).getTime()));
			dq.setTimestamp(3, new Timestamp(
					Utils.convertToDate(publishToDate + " 23:59:59", Utils.regDDMMYYYYHHMMSSFromat).getTime()));

			dq.setString(4, positionId);
			dq.execute();
		} catch (Exception e) {
			TPLogger.getLogger().error("Error while updating the position publish to website flag", e);
			tran.rollback();
			throw e;
		} finally {
			if (dq != null) {
				dq.closeOpenCursors();
			}
		}
	}

