	private void addSteps(String positionId, List steps, DBTransaction tran) throws Exception {
		DBPreparedQuery dq = null;
		try {
			if (steps != null && steps.size() > 0) {

				for (int i = 0; i < steps.size(); i++) {
					SimpleDataObject object = (SimpleDataObject) steps.get(i);

					dq = new DBPreparedQuery("dPositionManager_AddPositionStep", tran);
					dq.setString(1, positionId);
					dq.setString(2, object.getString("stepTitle"));
					dq.setInt(3, (i + 1));
					dq.setString(4, PositionConstants.STEP_ACTIVE);
					dq.setString(5, object.getString("isOptional"));
					dq.setString(6, object.getString("isDefault"));
					dq.setString(7, object.getString("isScheduled"));
					dq.setString(8, String.valueOf(PositionConstants.STEP_INTERVIEWER_CANNOT_CONFIRM));
					dq.setString(9, object.getString("stepLevel"));
					if (object.getString("feedbackFormId") == null
							|| object.getString("feedbackFormId").equals("null")) {
						dq.setNull(10, Types.NULL);
					} else {
						dq.setString(10, object.getString("feedbackFormId"));
					}
					dq.setString(11, String.valueOf(PositionConstants.STEP_DECISION_MAKER_NOT_SAMEAS_ASSIGNED_TO));
					dq.setString(12, object.getString("isNotifyToCandidate"));
					dq.setString(13, object.getString("stepMasterId"));
					dq.setString(14, object.getString("applicantFeedbackFormId"));
					dq.execute();

					dq = new DBPreparedQuery("dFetchLastInsertID", tran);
					String stepId = dq.getIdResult();
					object.setAttribute("stepId", stepId);
					object.setAttribute("positionId", positionId);

					// addOrUpdateStepTraits(tran, object);
					addOrUpdateStatusMessages(tran, object);
					addOrUpdateStepUsers(tran, object);

					// Insert System Genarated Trait.
					// dq = new
					// DBPreparedQuery("dPositionManager_InsertPositionStepTraits",
					// tran);
					// dq.setString(1, object.getString("stepId"));
					// dq.setString(2,
					// PositionConstants.SYSTEM_GENERAED_TRAIT_TITLE);
					// dq.setInt(3, (i + 1));
					// dq.setInt(4,
					// PositionConstants.STEP_TRAIT_SYSTEM_GENERATED);
					// dq.execute();
				}
			}
		} finally {
			if (dq != null) {
				dq.closeOpenCursors();
			}

		}
	}

