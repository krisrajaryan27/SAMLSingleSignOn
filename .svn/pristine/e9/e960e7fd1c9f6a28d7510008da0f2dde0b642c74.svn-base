			String minimumSalary = Utils.isBlankOrNullOrDefault(position.getString("minimumSalary"), "-1") ? null
					: position.getString("minimumSalary");
			String maximumSalary = Utils.isBlankOrNullOrDefault(position.getString("maximumSalary"), "-1") ? null
					: position.getString("maximumSalary");
			String benefitsDescription = Utils.isBlankOrNullOrDefault(position.getString("benefitsDescription"), "-1")
					? null : position.getString("benefitsDescription");
			String displaySalary = Utils.isBlankOrNullOrDefault(position.getString("displaySalary"), "-1") ? null
					: position.getString("displaySalary");
			String desiredCandidateSummaryText = Utils
					.isBlankOrNullOrDefault(position.getString("desiredCandidateSummaryText"), "-1") ? null
							: position.getString("desiredCandidateSummaryText");

			String contactPersonEmail = Utils.isBlankOrNullOrDefault(position.getString("contactPersonEmail"), "-1")
					? null : position.getString("contactPersonEmail");
			String applyByWebURL = Utils.isBlankOrNullOrDefault(position.getString("applyByWebURL"), "-1") ? null
					: position.getString("applyByWebURL");
			String jobFeedResponseEmail = Utils.isBlankOrNullOrDefault(position.getString("jobFeedResponseEmail"), "-1")
					? null : position.getString("jobFeedResponseEmail");
			String salaryCurrency = Utils.isBlankOrNullOrDefault(position.getString("salaryCurrency"), "-1") ? null
					: position.getString("salaryCurrency");

			dq = new DBPreparedQuery("dPositionManager_AddNaukriPositionFields", tran);
			dq.setString(1, positionId);
			dq.setString(2, contactPersonName);
			dq.setString(3, position.getString("jobIndustryCode"));
			dq.setString(4, position.getString("jobFunctionCode"));
			dq.setString(5, position.getString("jobRoleCode"));
			dq.setString(6, jobKeywords);
			dq.setString(7, position.getString("country"));
			dq.setString(8, minimumSalary);
			dq.setString(9, maximumSalary);
			dq.setString(10, benefitsDescription);
			dq.setString(11, displaySalary);
			dq.setString(12, desiredCandidateSummaryText);
			dq.setString(13, contactPersonEmail);
			dq.setString(14, applyByWebURL);
			dq.setString(15, jobFeedResponseEmail);
			dq.setString(16, salaryCurrency);
			dq.execute();
		} finally {
			if (dq != null) {
				dq.closeOpenCursors();
			}
			if (dbq != null) {
				dbq.closeOpenCursors();
			}
		}
	}

