	/**
	 * @param userId
	 * @param permissionSet
	 * @return list of open positions to be published to social media
	 * @throws SQLException
	 */
	@SuppressWarnings("unchecked")
	public List<PositionData> getAllPositionsToPublishToSocial(String userId, PermissionSet permissionSet)
			throws SQLException {
		DBPreparedQuery dq = null;
		String[] dynParams = new String[1];
		ArrayList<String> dynamicContent = new ArrayList<String>();
		List<PositionData> positions = null;

		try {
			dynParams[0] = PositionWithRightsClause.getClauseForStepUserAndRequestedByAndRequisitionApproval(userId,
					"tp.position_id", dynamicContent, permissionSet);

			dq = new DBPreparedQuery("dPositionManager_GetAllPositionsToPublishForSocial", dynParams);
			int cnt = 1;
			dq.setString(cnt++, PositionConstants.POSITION_STATUS_OPENED);
			for (int i = 0; i < dynamicContent.size(); i++) {
				dq.setString(cnt++, dynamicContent.get(i));
			}
			positions = (List<PositionData>) dq.getResult();
		} catch (SQLException e) {
			TPLogger.getLogger().error("Error while getting all positions to publish for walk in", e);
			throw e;
		} finally {
			if (dq != null) {
				dq.releaseTransaction(null);
			}
		}
		return positions;
	}

	/**
	 * @param positionId
	 * @return map of source-ids and their latest posted date for given position
	 * @throws SQLException
	 */
	@SuppressWarnings("unchecked")
	public HashMap<String, String> getSourcesWithLastPostedDetails(String positionId) throws SQLException {
		HashMap<String, String> sourcePostedDateMap = null;
		DBPreparedQuery dq = null;
		ArrayList<SimpleDataObject> list = null;
		try {
			dq = new DBPreparedQuery("dPositionManager_GetAllSourcesAndLastPostedDatesForPosition");
			dq.setString(1, positionId);
			list = dq.getResult();

			sourcePostedDateMap = new HashMap<String, String>();
			for (SimpleDataObject sdo : list) {
				sourcePostedDateMap.put(sdo.getString("sourceId"), sdo.getString("lastPostedDate"));
			}
		} catch (SQLException e) {
			TPLogger.getLogger().error("Error while getting all sources and their last posted dates for position", e);
			throw e;
		} finally {
			if (dq != null) {
				dq.closeOpenCursors();
			}
		}
		return sourcePostedDateMap;
	}

