	/**
	 * returns xml required for autocomplete
	 * 
	 * @param search
	 * @param searchType
	 * @return
	 */
	public String getAutoCompleteXML(String search, String searchType) {
		DBPreparedQuery dq = null;
		String xml = "";
		String dynaQuery = "";
		String dqName = "";
		String fieldToFetch = "";
		try {
			if (searchType.equals(PositionConstants.AUTOCOMPLETE_INSTITUTE)) {
				dynaQuery = "institute_name like '" + search + "%'";
				dqName = "dGetInstituteNames";
				fieldToFetch = "instituteName";
			} else if (searchType.equals(PositionConstants.AUTOCOMPLETE_REPLACE_CODE)) {
				dynaQuery = "employee_code like '" + search + "%'";
				dqName = "dGetEmployeeCode";
				fieldToFetch = "employeeCode";
			}
			// execute query and build xml
			String[] dynParam = new String[2];
			dynParam[0] = dynaQuery;
			int noOfRecords = 10;
			dynParam[1] = " LIMIT ?, ?";

			dq = new DBPreparedQuery(dqName, dynParam);
			dq.setInt(1, 0);
			dq.setInt(2, noOfRecords);
			ArrayList result = dq.getResult();
			xml = Utils.getListInXML(result, fieldToFetch);
		} catch (Exception e) {
			TPLogger.getLogger().error("Error while getting list of Institutes", e);
		} finally {
			if (dq != null) {
				dq.releaseConnection();
			}
		}
		return xml;
	}

