	public List<DraftData> parseIndents(FormFileData formFileData, String userId)
			throws FileUploadException, PositionParserException, InvalidMimeTypeException {
		List<DraftData> drafts = null;
		DocumentUploader documentUploader = new DocumentUploader();
		DocumentData data = documentUploader.saveFormFile(formFileData);
		String fileContents = getContents(data);
		PositionParser parser = new PositionParser();
		if (!parser.isSinglePositionDef(fileContents)) {
			List<CustomFieldData> customFields = null;
			if (CustomFieldManager.isCustomFieldsAvailable(CustomFieldConstants.ENTITY_TYPE_POSITION)) {
				CustomFieldManager customFieldManager = new CustomFieldManager();
				customFields = customFieldManager.getCustomFieldsForInputAllowed(
						CustomFieldConstants.ENTITY_TYPE_POSITION, CustomFieldConstants.INPUT_ALLOWED, true);
			}

			List<Map<String, String>> parsedPositions = parser.parse(fileContents, customFields);
			if (parsedPositions != null && parsedPositions.size() > 0) {
				/**
				 * Check for errors
				 */
				checkParsingErrors(parsedPositions);
				/**
				 * Save position to a text file. Add entry into drafts table.
				 */
				drafts = createDrafts(formFileData.getFileName(), parsedPositions, userId);
			} else {
				throw new PositionParserException(
						TPLabels.getLabel("position_parser.error.position_definition_not_found"));
			}
		} else {
			drafts = new ArrayList<DraftData>();
			DraftData draftData = getDraftData(data, null);
			drafts.add(draftData);
		}
		return drafts;
	}

	private void checkParsingErrors(List<Map<String, String>> parsedPositions) throws PositionParserException {
		StringBuffer errors = new StringBuffer();
		if (parsedPositions != null && parsedPositions.size() > 0) {
			for (int i = 0; i < parsedPositions.size(); i++) {
				Map<String, String> parsedPosition = parsedPositions.get(i);
				String parsingErrors = parsedPosition.get(PositionParserConstants.PARSING_ERRORS);
				if (!Utils.isBlankOrNull(parsingErrors)) {
					errors.append(parsingErrors);
				}
			}
		}
		if (errors.length() > 0) {
			throw new PositionParserException(errors.toString());
		}
	}

	private List<DraftData> createDrafts(String originalFileName, List<Map<String, String>> parsedPositions,
			String userId) throws FileUploadException {
		List<DraftData> drafts = new ArrayList<DraftData>();
		PositionParserUtils parserUtils = new PositionParserUtils();
		if (parsedPositions != null && parsedPositions.size() > 0) {
			DocumentUploader documentUploader = new DocumentUploader();
			for (int i = 0; i < parsedPositions.size(); i++) {
				String positionDef = parserUtils.getFormattedPositionText(parsedPositions.get(i));
				DocumentData documentData = documentUploader.saveTextAsDocument(positionDef, ".txt");
				DraftData draftData = getDraftData(documentData, parsedPositions.get(i));
				drafts.add(draftData);
			}
		}
		if (drafts != null && drafts.size() > 0) {
			PositionDraftsManager draftsManager = new PositionDraftsManager();
			for (int i = 0; i < drafts.size(); i++) {
				String draftId = draftsManager.createPositionDraft(drafts.get(i), userId);
				drafts.get(i).setDraftId(draftId);
			}
		}
		return drafts;
	}

	private DraftData getDraftData(DocumentData documentData, Map<String, String> parsedPosition) {
		DraftData draftData = new DraftData();
		draftData.setRelativeFilePath(documentData.getRelativeFilePath());
		if (parsedPosition != null
				&& !Utils.isBlankOrNull(parsedPosition.get(PositionParserConstants.PARSING_ERRORS))) {
			draftData.setErrors(parsedPosition.get(PositionParserConstants.PARSING_ERRORS));
		}
		return draftData;
	}

	private String getContents(DocumentData data) {
		String fileContents = "";
		try {
			DocumentUploader documentUploader = new DocumentUploader();
			GenericConverter converter = new GenericConverter();
			fileContents = converter.convert(data.getAbsoluteFilePath());
			FileHandler fileHandler = new FileHandler();
			String ext = FileHandlerUtils.getFileExtention(data.getAbsoluteFilePath(), ".txt");
			if (!".txt".equals(ext)) {
				DocumentData documentData = documentUploader.saveTextAsDocument(fileContents, ".txt");
				fileContents = fileHandler.getTextFileContent(documentData.getAbsoluteFilePath(), null);

				data.setRelativeFilePath((documentData.getRelativeFilePath()));
				data.setAbsoluteFilePath(documentData.getAbsoluteFilePath());
			}
		} catch (Exception e) {
			TPLogger.getLogger().error(GlobalConstants.ERROR, e);
		}
		return fileContents;

	}

