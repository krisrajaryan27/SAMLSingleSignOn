	}

	/**
	 * Changes the status of the position to given positionStatus all position
	 * status can be found in PositionConstants.
	 * 
	 * @param positionId
	 *            The identifier of the position.
	 * @param positionStatus
	 *            The current status of position to set.
	 * @param userId
	 *            The identifier of the logged-in user.
	 * @param tran
	 *            The DB transaction.
	 */
	public void changePositionStatus(String positionId, String positionStatus, String userId, String isBudgetCommitted,
			DBTransaction tran) {
		DBPreparedQuery dq = null;
		try {
			String[] dynParam = new String[1];
			ArrayList<String> dynamicContent = new ArrayList<String>();
			if (PositionConstants.POSITION_STATUS_CLOSED.equalsIgnoreCase(positionStatus)) {
				dynParam[0] = ", position_date_closed = now(),  position_closed_by = ? ";
				dynamicContent.add(userId);
			} else if (PositionConstants.POSITION_STATUS_OPENED.equalsIgnoreCase(positionStatus)) {
				// dynParam[0] = ", position_date_closed = null,
				// position_closed_by = null";
				dynParam[0] = ", position_date_opend = now(),  position_closed_by = null";
			} else if (PositionConstants.POSITION_STATUS_DELETED.equalsIgnoreCase(positionStatus)) {
				dynParam[0] = ", position_date_deleted = now(),  position_deleted_by = ? ";
				dynamicContent.add(userId);
			} else {
				dynParam[0] = "";
			}
			int budgetCommitted = 1;
			if (!Utils.isBlankOrNull(isBudgetCommitted)) {
				budgetCommitted = Integer.parseInt(isBudgetCommitted);
			}
			if (tran != null) {
				dq = new DBPreparedQuery("dUpdatePositionStatus", dynParam, tran);
			} else {
				dq = new DBPreparedQuery("dUpdatePositionStatus", dynParam);
			}
			dq.setString(1, positionStatus);
			dq.setInt(2, budgetCommitted);
			int cnt = 3;
			for (int i = 0; i < dynamicContent.size(); i++) {
				dq.setString(cnt++, dynamicContent.get(i));
			}
			dq.setId(cnt, positionId);
			dq.execute();
			// added to send mail to requested by for position change
			// notification
			if (GlobalApplicationProperties
					.getProperty(GlobalConstants.PROPERTY_ENABLE_CC_HR_MANAGER_FOR_ALL_POSITION_APPROVAL)
					.equals(GlobalConstants.ENABLED)) {

				sendEmailForPositionStatus(
						TemplateConstants.TEMPLATE_TYPE_REQUISITION_APPROVAL_NOTIFICATION_TO_REQUESTED_BY, positionId,
						positionStatus);
			}
			// end
			if (PositionConstants.POSITION_STATUS_DELETED.equalsIgnoreCase(positionStatus)
					|| PositionConstants.POSITION_STATUS_CLOSED.equalsIgnoreCase(positionStatus)) {
				ApplicantJobPortalManager applicantJobPortalManager = new ApplicantJobPortalManager();
				applicantJobPortalManager.deleteApplicantPositionMappingByPosition(positionId, tran);
			}
		} catch (Exception e) {
			TPLogger.getLogger().error("Error While Updating  Position Status", e);
		} finally {
			if (dq != null) {
				if (tran == null) {
					dq.releaseConnection();
				} else {
					dq.closeOpenCursors();
				}
			}
		}
	}

	// tp send mail for position status
	public void sendEmailForPositionStatus(String templateTypeId, String positionId, String positionStatus)
			throws Exception {
		TemplateManager templateManager = new TemplateManager();
		TemplateData templateData = templateManager.getTemplateDataByTemplateTypeId(templateTypeId);
		String contentVM = templateData.getTemplateContentFile();
		String subjectVM = templateData.getTemplateSubjectFile();
		String keyMap = templateData.getTemplateVariables();

		String employeeStr = "";
		String globalVar = "";

		try {

			PositionManager positionManager = new PositionManager();
			PositionData pData = positionManager.getPositionSummary(positionId);

			LoginManager loginManager = new LoginManager();
			LoginData userData = loginManager.getUser(pData.getRequestedById());
			String contentStr = TemplateUtils.getConvertedUserData(userData);
			String positionTitle = TemplateUtils.getConstructedToken("REQUISITION_TITLE", pData.getPositionTitle());
			contentStr = TemplateUtils.appndToToken(contentStr, positionTitle);

			String positionStatusStr = "";
			if (positionStatus.equals(PositionConstants.POSITION_STATUS_CLOSED)) {
				positionStatusStr = TPLabels.getLabel("common.close");
			} else if (positionStatus.equals(PositionConstants.POSITION_STATUS_OPENED)) {
				positionStatusStr = TPLabels.getLabel("common.open");
			} else if (positionStatus.equals(PositionConstants.POSITION_STATUS_HOLD)) {
				positionStatusStr = TPLabels.getLabel("common.hold");
			} else if (positionStatus.equals(PositionConstants.POSITION_STATUS_DROPPED)) {
				positionStatusStr = TPLabels.getLabel("common.drop");
			}
			String PositionCurrentStatus = TemplateUtils.getConstructedToken("REQUISITION_STEP_TITLE",
					positionStatusStr);
			contentStr = TemplateUtils.appndToToken(contentStr, PositionCurrentStatus);
			InboxManager inboxManager = new InboxManager();
			InboxData inboxData = inboxManager.getCurrentInboxSettings();

			if (inboxData != null && !Utils.isBlankOrNull(inboxData.getInboxDisplayName())) {
				globalVar = TemplateUtils.getConvertedGlobalVars(inboxData);
				contentStr = TemplateUtils.appndToToken(contentStr, globalVar);
			}

			HashMap<String, String> keyValMap = TemplateUtils.getKeyValueMap(keyMap, contentStr);
			VelocityManager velocityManager = new VelocityManager();
			String subject = velocityManager.handle(subjectVM, keyValMap);
			String content = velocityManager.handle(contentVM, keyValMap);

			MessageData messageData = new MessageData();
			messageData.setFrom(inboxData.getInboxDisplayName() + " <" + inboxData.getInboxEmail() + ">");
			messageData.setReadStatus(InboxConstants.INBOX_EMAIL_STATUS_UNREAD);
			messageData.setHtmlBody(content);
			messageData.setSubject(subject);
			messageData.setTo(userData.getEmail());
			TPMailSender sender = new TPMailSender();

			try {
				sender.send(messageData, InboxConstants.EMAIL_BODY_HTML, null);
			} catch (Exception e) {
				TPLogger.getLogger()
						.error("Failed to send position dropped notification email to " + userData.getEmail(), e);
			}
		} catch (Exception e) {
			TPLogger.getLogger().error("Failed to send position dropped notification email to ", e);
		}
	}

	/**
	 * @param positionId
	 * @return
	 */
	public Object getPositionDescriptionToView(String positionId) {
		return getPositionDescriptionToView(positionId, null, null);
	}

	/**
	 * @param positionId
	 * @param userId
	 * @param permissionSet
	 * @return
	 */
	public Object getPositionDescriptionToView(String positionId, String userId, PermissionSet permissionSet) {
		DBPreparedQuery dq = null;
		SimpleDataObject sDo = new SimpleDataObject();
		try {
			ArrayList<String> dynamicContentForDynParam = new ArrayList<String>();
			String[] dynParam = { "" };
			if (!Utils.isBlankOrNull(userId) && permissionSet != null) {
				dynParam[0] = PositionWithRightsClause.getClauseForStepUserAndRequestedByAndRequisitionApproval(userId,
						"tp.position_id", dynamicContentForDynParam, permissionSet);
			}
			dq = new DBPreparedQuery("dPositionManager_ViewPositionDescription", dynParam);
			dq.setString(1, positionId);
			dq.setString(2, PositionConstants.POSITION_STATUS_DELETED);
			int cnt = 3;
			for (int i = 0; i < dynamicContentForDynParam.size(); i++) {
				dq.setString(cnt++, dynamicContentForDynParam.get(i));
			}
			List resultSet = dq.getResult();
			if (resultSet != null && resultSet.size() > 0) {
				for (int i = 0; i < resultSet.size(); i++) {
					SimpleDataObject obj = (SimpleDataObject) resultSet.get(i);
					if (i == 0) {
						sDo.setAttribute("positionName", obj.getString("positionTitle"));
						sDo.setAttribute("positionCode", obj.getString("positionCode"));
						sDo.setAttribute("positionOwnerName", obj.getString("positionOwnerName"));
						sDo.setAttribute("requisitioner", obj.getString("requestedByUserName"));
						sDo.setAttribute("vacancies", obj.getString("noOfOpenings"));
