			dq = new DBPreparedQuery("dPositionManager_InsertPositionLocations", tran);
			dq.setString(1, positionId);
			dq.setString(2, locationId);
			dq.execute();
		} catch (Exception e) {
			TPLogger.getLogger().error(e);
		} finally {
			if (dq != null) {
				dq.closeOpenCursors();
			}
		}

	}

