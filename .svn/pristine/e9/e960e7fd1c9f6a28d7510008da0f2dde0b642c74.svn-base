	/**
	 * Returns all positions with passed status
	 * 
	 * @param permissionSet
	 * @param userId
	 * @param positionId
	 * @return
	 */
	public ArrayList getPositionListWithStatus(String positionStatus, PermissionSet permissionSet, String userId) {
		DBPreparedQuery dq = null;
		ArrayList positions = null;
		String[] dynParams = new String[2];
		ArrayList<String> dynamicContent = new ArrayList<String>();
		ArrayList<String> dynamicContent2 = new ArrayList<String>();
		try {

			String qMarks = Utils.setDynamicParamsAndReturnQmarks(positionStatus, dynamicContent);
			dynParams[0] = " tp.position_status IN (" + qMarks + ")";
			dynParams[1] = "";

			if (!positionStatus.equals(PositionConstants.POSITION_STATUS_TEMPLATE)) {
				dynParams[1] = PositionWithRightsClause
						.getClauseForStepUserAndRequestedByAndRequisitionApprovalForUserOnly(userId, "tp.position_id",
								dynamicContent2, permissionSet);
			}

			dq = new DBPreparedQuery("dGetPositionListWithStatus", dynParams);
			int cnt = 1;
			for (int i = 0; i < dynamicContent.size(); i++) {
				dq.setString(cnt++, dynamicContent.get(i));
			}
			for (int i = 0; i < dynamicContent2.size(); i++) {
				dq.setString(cnt++, dynamicContent2.get(i));
			}
			positions = dq.getResult();
		} catch (SQLException e) {
			TPLogger.getLogger().error(GlobalConstants.ERROR, e);
		} finally {
			if (dq != null) {
				dq.releaseConnection();
			}
		}
		return positions;
	}

	public ArrayList getPositionListWithStatusNDepartmenNLocation(String positionStatus, String departmentId,
			String locationId, PermissionSet permissionSet, String userId) {
		DBPreparedQuery dq = null;
		ArrayList positions = null;
		ArrayList<String> dynamicContent = new ArrayList<String>();
		try {
			String[] dynParam = new String[1];
			dynParam[0] = " ";

			if (!Utils.isBlankOrNull(departmentId)) {
				dynParam[0] += " AND tp.dept_id = ? ";
				dynamicContent.add(departmentId);
			}
			if (!Utils.isBlankOrNull(locationId)) {
				dynParam[0] += " AND tpl.location_id = ? ";
				dynamicContent.add(locationId);
			}
			dynParam[0] += PositionWithRightsClause.getClauseForStepUserAndRequestedByAndRequisitionApprovalForUserOnly(
					userId, "tp.position_id", dynamicContent, permissionSet);

			dq = new DBPreparedQuery("dGetPositionListWithStatusDepartmentNLocation", dynParam);
			int cnt = 1;
			dq.setString(cnt, positionStatus);
			cnt = 2;
			for (int i = 0; i < dynamicContent.size(); i++) {
				dq.setString(cnt++, dynamicContent.get(i));
			}

			positions = dq.getResult();
		} catch (SQLException e) {
			TPLogger.getLogger()
					.error("Error While Retreiving getPositionListWithStatus for selected department and location", e);
		} finally {
			if (dq != null) {
				dq.releaseConnection();
			}
		}
		return positions;
	}

