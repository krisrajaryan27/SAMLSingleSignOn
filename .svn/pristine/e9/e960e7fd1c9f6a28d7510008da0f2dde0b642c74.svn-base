	public ArrayList<SimpleDataObject> getPositionFilters(PermissionSet permissionSet, String userId, String filterFor,
			String positionStatus, String positionId, String positionOwnerId, String departmentId,
			String subDepartmentId, String subSubDepartmentId, String sub3DepartmentId, String sub4DepartmentId,
			String recruiterId, String locationId, String positionTypeExtInt, String skillId, String positionName) {
		ArrayList<SimpleDataObject> filters = null;
		DBPreparedQuery dq = null;
		try {
			String[] dynParams = new String[3];
			dynParams[0] = "";
			dynParams[1] = "";
			dynParams[2] = "";
			// first dynamic part
			if (filterFor.equals(PositionConstants.FILTER_POSITION_OWNER)) {
				dynParams[0] = " tp.position_owner_id AS filter_id, CONCAT(tupo.user_fname, ' ', tupo.user_lname) AS filter_short_name, CONCAT(tupo.user_fname, ' ', tupo.user_lname) AS filter_full_name ";
			} else if (filterFor.equals(PositionConstants.FILTER_DEPARTMENT)) {
				dynParams[0] = " td.dept_id AS filter_id, td.dept_name AS filter_short_name, td.dept_name AS filter_full_name ";
			} else if (filterFor.equals(PositionConstants.FILTER_SUB_DEPARTMENT)) {
				dynParams[0] = " tds.dept_id AS filter_id, tds.dept_name AS filter_short_name, tds.dept_name AS filter_full_name ";
			} else if (filterFor.equals(PositionConstants.FILTER_SUB_SUB_DEPARTMENT)) {
				dynParams[0] = " tdss.dept_id AS filter_id, tdss.dept_name AS filter_short_name, tdss.dept_name AS filter_full_name ";
			} else if (filterFor.equals(PositionConstants.FILTER_SUB3_DEPARTMENT)) {
				dynParams[0] = " tdsss.dept_id AS filter_id, tdsss.dept_name AS filter_short_name, tdsss.dept_name AS filter_full_name ";
			} else if (filterFor.equals(PositionConstants.FILTER_SUB4_DEPARTMENT)) {
				dynParams[0] = " tdssss.dept_id AS filter_id, tdssss.dept_name AS filter_short_name, tdssss.dept_name AS filter_full_name ";
			} else if (filterFor.equals(PositionConstants.FILTER_POSITION)) {
				dynParams[0] = " tp.position_id AS filter_id, tp.position_code AS filter_short_name, tp.position_title AS filter_full_name ";
			} else if (filterFor.equals(PositionConstants.FILTER_RECRUITER)) {
				dynParams[0] = " tu.user_id AS filter_id, CONCAT(tu.user_fname, ' ', tu.user_lname) AS filter_short_name, CONCAT(tu.user_fname, ' ', tu.user_lname) AS filter_full_name ";
			} else if (filterFor.equals(PositionConstants.FILTER_LOCATION)) {
				dynParams[0] = " tl.location_id AS filter_id, tl.location_name AS filter_short_name, tl.location_name AS filter_full_name ";
			} else if (filterFor.equals(PositionConstants.FILTER_POSITION_TYPE)) {
				dynParams[0] = " tp.position_type_ext_int AS filter_id, tp.position_type_ext_int AS filter_short_name, tp.position_type_ext_int AS filter_full_name ";
			} else if (filterFor.equals(PositionConstants.FILTER_PRIMARY_SKILLS)) {
				dynParams[0] = " tsk.skill_id AS filter_id, tsk.skill AS filter_short_name, tsk.skill AS filter_full_name ";
			}

			ArrayList<String> dynamicContent = new ArrayList<String>();

			if (!positionStatus.equals(PositionConstants.POSITION_STATUS_TEMPLATE)) {
				// second dynamic part
				dynParams[2] += PositionWithRightsClause.getClauseForUserInList(userId, "tpsu.user_id", dynamicContent,
						permissionSet);
			}
			// third dynamic part
			if (!Utils.isBlankOrNull(positionId)) {
				dynParams[2] += " AND tp.position_id=? ";
				dynamicContent.add(positionId);
			}
			if (!Utils.isBlankOrNull(positionOwnerId)) {
				dynParams[2] += " AND tp.position_owner_id=? ";
				dynamicContent.add(positionOwnerId);
			}
			if (!Utils.isBlankOrNull(departmentId)) {
				dynParams[2] += " AND td.dept_id=? ";
				dynamicContent.add(departmentId);
			}
			if (!Utils.isBlankOrNull(subDepartmentId)) {
				dynParams[2] += " AND tds.dept_id=? ";
				dynamicContent.add(subDepartmentId);
			}
			if (!Utils.isBlankOrNull(subSubDepartmentId)) {
				dynParams[2] += " AND tdss.dept_id=? ";
				dynamicContent.add(subSubDepartmentId);
			}
			if (!Utils.isBlankOrNull(sub3DepartmentId)) {
				dynParams[2] += " AND tdsss.dept_id=? ";
				dynamicContent.add(sub3DepartmentId);
			}
			if (!Utils.isBlankOrNull(sub4DepartmentId)) {
				dynParams[2] += " AND tdssss.dept_id=? ";
				dynamicContent.add(sub4DepartmentId);
			}

			if (!Utils.isBlankOrNull(recruiterId)) {
				dynParams[2] += " AND tu.user_id=? ";
				dynamicContent.add(recruiterId);
			}
			if (!Utils.isBlankOrNull(locationId)) {
				dynParams[2] += " AND tl.location_id=? ";
				dynamicContent.add(locationId);
			}
			if (!Utils.isBlankOrNull(positionTypeExtInt)) {
				dynParams[2] += " AND tp.position_type_ext_int=? ";
				dynamicContent.add(positionTypeExtInt);
			}
			if (!Utils.isBlankOrNull(skillId)) {
				dynParams[2] += " AND tsk.skill_id=? ";
				dynamicContent.add(skillId);
			}
			if (!Utils.isBlankOrNull(positionName)) {
				dynParams[2] += " AND tp.position_title like ? ";
				dynamicContent.add(positionName + "%");
			}

			/*
			 * if (!Utils.isBlankOrNull(positionStatus)) { String qMarks =
			 * Utils.setDynamicParamsAndReturnQmarks(positionStatus,
			 * dynamicContent); dynParams[2] += " AND tp.position_status IN (" +
			 * qMarks + ")"; }
			 */

			if (!Utils.isBlankOrNull(positionStatus)) {
				String qMarks = "";
				dynParams[2] += " AND (";
				if (positionStatus.contains(PositionConstants.POSITION_STATUS_INPROCESS)) {
					positionStatus = positionStatus.replace(PositionConstants.POSITION_STATUS_INPROCESS + ",", "");
					positionStatus = positionStatus.replace(PositionConstants.POSITION_STATUS_INPROCESS, "");
					dynParams[2] += " ( tp.position_status=? AND tp.position_date_approved is NULL ) OR ";
					dynamicContent.add(PositionConstants.POSITION_STATUS_INPROCESS);
				}
				if (positionStatus.contains(PositionConstants.POSITION_STATUS_TO_BE_OPENED)) {
					positionStatus = positionStatus.replace(PositionConstants.POSITION_STATUS_TO_BE_OPENED + ",", "");
					positionStatus = positionStatus.replace(PositionConstants.POSITION_STATUS_TO_BE_OPENED, "");
					dynParams[2] += " ( tp.position_status=? AND tp.position_date_approved is NOT NULL ) OR ";
					dynamicContent.add(PositionConstants.POSITION_STATUS_INPROCESS);
				}
				if (positionStatus.contains(PositionConstants.POSITION_STATUS_MY_APPROVAL_PENDING)) {
					positionStatus = positionStatus.replace(PositionConstants.POSITION_STATUS_MY_APPROVAL_PENDING + ",",
							"");
					positionStatus = positionStatus.replace(PositionConstants.POSITION_STATUS_MY_APPROVAL_PENDING, "");
					// dynParams[1] = " ,(SELECT * FROM (SELECT * FROM
					// tp_requisition_approval_feedback ORDER BY feedback_id
					// desc) AS traf GROUP by traf.position_id) AS traf ";
					dynParams[1] = "LEFT JOIN tp_requisition_approval_feedback traf ON (traf.position_id = tp.position_id)";
					// dynParams[2] += " (tp.position_status = ? AND
					// traf.position_id=tp.position_id AND (traf.to_user_id=? OR
					// (traf.to_user_id is null AND traf.by_user_id=? AND
					// tp.position_date_approved IS NULL))) OR ";
					dynParams[2] += " (tp.position_status = ? AND (traf.to_user_id=? OR "
							+ "(traf.to_user_id is null AND traf.by_user_id=? AND tp.position_date_approved IS NULL))) OR ";
					dynamicContent.add(PositionConstants.POSITION_STATUS_INPROCESS);
					dynamicContent.add(userId);
					dynamicContent.add(userId);
				}
				qMarks = Utils.setDynamicParamsAndReturnQmarks(positionStatus, dynamicContent);
				dynParams[2] += " tp.position_status IN (" + qMarks + ")";
				dynParams[2] += " ) ";
			}

			if (filterFor.equals(PositionConstants.FILTER_POSITION_OWNER)) {
				dynParams[2] += " GROUP BY tp.position_owner_id ";
				dynParams[2] += " ORDER BY tupo.user_fname, tupo.user_lname ";
			} else if (filterFor.equals(PositionConstants.FILTER_DEPARTMENT)) {
				dynParams[2] += " GROUP BY td.dept_id ";
				dynParams[2] += " ORDER BY td.dept_name ";
			} else if (filterFor.equals(PositionConstants.FILTER_SUB_DEPARTMENT)) {
				dynParams[2] += " AND tds.dept_id is not null ";
				dynParams[2] += " GROUP BY tds.dept_id ";
				dynParams[2] += " ORDER BY tds.dept_name ";
			} else if (filterFor.equals(PositionConstants.FILTER_SUB_SUB_DEPARTMENT)) {
				dynParams[2] += " AND tdss.dept_id is not null ";
				dynParams[2] += " GROUP BY tdss.dept_id ";
				dynParams[2] += " ORDER BY tdss.dept_name ";
			} else if (filterFor.equals(PositionConstants.FILTER_SUB3_DEPARTMENT)) {
				dynParams[2] += " AND tdsss.dept_id is not null ";
				dynParams[2] += " GROUP BY tdsss.dept_id ";
				dynParams[2] += " ORDER BY tdsss.dept_name ";
			} else if (filterFor.equals(PositionConstants.FILTER_SUB4_DEPARTMENT)) {
				dynParams[2] += " AND tdssss.dept_id is not null ";
				dynParams[2] += " GROUP BY tdssss.dept_id ";
				dynParams[2] += " ORDER BY tdssss.dept_name ";
			} else if (filterFor.equals(PositionConstants.FILTER_POSITION)) {
				dynParams[2] += " GROUP BY tp.position_id ";
				dynParams[2] += " ORDER BY tp.position_code ";
			} else if (filterFor.equals(PositionConstants.FILTER_RECRUITER)) {
				dynParams[2] += " AND tu.user_id is not null ";
				dynParams[2] += " GROUP BY tu.user_id ";
				dynParams[2] += " ORDER BY tu.user_fname, tu.user_lname ";
			} else if (filterFor.equals(PositionConstants.FILTER_LOCATION)) {
				dynParams[2] += " GROUP BY tl.location_id ";
				dynParams[2] += " ORDER BY tl.location_name ";
			} else if (filterFor.equals(PositionConstants.FILTER_POSITION_TYPE)) {
				dynParams[2] += " GROUP BY tp.position_type_ext_int ";
				dynParams[2] += " ORDER BY tp.position_type_ext_int ";
			} else if (filterFor.equals(PositionConstants.FILTER_PRIMARY_SKILLS)) {
				dynParams[2] += " AND tsk.skill_id is not null ";
				dynParams[2] += " GROUP BY tsk.skill_id ";
				dynParams[2] += " ORDER BY tsk.skill ";
			}

			dq = new DBPreparedQuery("dPositionManager_GetPositionFilters", dynParams);
			int cnt = 1;
			dq.setString(cnt++, PositionConstants.POSITION_SKILL_PRIMARY);
			for (int i = 0; i < dynamicContent.size(); i++) {
				dq.setString(cnt++, dynamicContent.get(i));
			}
			filters = dq.getResult();
		} catch (Exception e) {
			TPLogger.getLogger().error(GlobalConstants.ERROR, e);
		} finally {
			if (dq != null) {
				dq.releaseConnection();
			}
		}
		return filters;
	}

