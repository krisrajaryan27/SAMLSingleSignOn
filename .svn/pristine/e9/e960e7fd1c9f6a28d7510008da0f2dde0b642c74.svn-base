	/**
	 * returns list of all positions
	 * 
	 * @param positionStatus
	 * @return
	 */

	private static List<SkillData> skills;
	private static String skillsXML;

	static {
		if (Utils.isListEmptyOrNull(skills)) {
			new PositionManager().updateSkillList();
		}
		if (Utils.isBlankOrNull(skillsXML)) {
			skillsXML = new PositionManager().getSkillsXML();
		}
	}

	public void updateSkillList() {
		new PositionManager().getSkillsMasterList();
	}

	public List<SkillData> getSkills() {
		if (Utils.isListEmptyOrNull(skills)) {
			updateSkillList();
		}
		return skills;
	}

	public String getSkillsXML() {
		if (!Utils.isBlankOrNull(skillsXML)) {
			return skillsXML;
		}
		return SkillsUtils.getXmlForSkillsMaster(skills);
	}

	public ArrayList getAllPositions(String positionOwnerId, String departmentId, String subDepartmentId,
			String subSubDepartmentId, String sub3DepartmentId, String sub4DepartmentId, String recruiterId,
			String locationId, String positionTypeExtInt, String skillId, String positionName, String positionStatus,
			String customFieldFilterId, String customFieldFilterType, String customFieldFilterValue, String userId,
			PermissionSet permissionSet) {
		DBPreparedQuery dq = null;
		ArrayList positions = null;
		try {
			String[] dynParam = new String[5];
			ArrayList<String> dynamicContentForDynParam2 = new ArrayList<String>();
			ArrayList<String> dynamicContentForDynParam3 = new ArrayList<String>();
			dynParam[0] = " ";
			dynParam[1] = " ";
			dynParam[2] = " ";
			dynParam[3] = " ";
			dynParam[4] = " ";

			if (!Utils.isBlankOrNull(positionOwnerId)) {
				dynParam[3] += " AND tp.position_owner_id=? ";
				dynamicContentForDynParam2.add(positionOwnerId);
			}
			if (!Utils.isBlankOrNull(departmentId)) {
				dynParam[3] += " AND tp.dept_id=? ";
				dynamicContentForDynParam2.add(departmentId);
			}
			if (!Utils.isBlankOrNull(subDepartmentId)) {
				dynParam[3] += " AND tp.sub_dept_id=? ";
				dynamicContentForDynParam2.add(subDepartmentId);
			}
			if (!Utils.isBlankOrNull(subSubDepartmentId)) {
				dynParam[3] += " AND tp.sub_sub_dept_id=? ";
				dynamicContentForDynParam2.add(subSubDepartmentId);
			}
			if (!Utils.isBlankOrNull(sub3DepartmentId)) {
				dynParam[3] += " AND tp.sub3_dept_id=? ";
				dynamicContentForDynParam2.add(sub3DepartmentId);
			}
			if (!Utils.isBlankOrNull(sub4DepartmentId)) {
				dynParam[3] += " AND tp.sub4_dept_id=? ";
				dynamicContentForDynParam2.add(sub4DepartmentId);
			}

			if (!Utils.isBlankOrNull(locationId)) {
				dynParam[3] += " AND tpl.location_id=? ";
				dynamicContentForDynParam2.add(locationId);
			}

			if (!Utils.isBlankOrNull(positionTypeExtInt)) {
				dynParam[3] += " AND tp.position_type_ext_int=? ";
				dynamicContentForDynParam2.add(positionTypeExtInt);
			}

			if (!Utils.isBlankOrNull(recruiterId)) {
				dynParam[2] += " , tp_position_step_users tpsu ";
				dynParam[3] += " AND tpsu.position_id = tp.position_id ";
				dynParam[3] += " AND tpsu.user_id = ? ";
				dynamicContentForDynParam2.add(recruiterId);
			}

			if (!Utils.isBlankOrNull(skillId)) {
				dynParam[2] += " , tp_position_skills tps ";
				dynParam[3] += " AND tps.position_id = tp.position_id ";
				dynParam[3] += " AND tps.skill_id = ? ";
				dynamicContentForDynParam2.add(skillId);
			}

			if (!Utils.isBlankOrNull(positionName)) {
				String showPositionCode = GlobalApplicationProperties
						.getProperty(GlobalConstants.PROPERTY_SHOW_POSITION_CODE);
				if (showPositionCode.equals(GlobalConstants.DISABLED)) {
					dynParam[3] += " AND tp.position_title LIKE ? ";
				} else {
					dynParam[3] += " AND tp.position_code LIKE ? ";
				}
				dynamicContentForDynParam2.add("%" + positionName + "%");
			}

			if (!Utils.isBlankOrNull(positionStatus)) {
				String qMarks = "";
				dynParam[3] += " AND (";
				if (positionStatus.contains(PositionConstants.POSITION_STATUS_INPROCESS)) {
					positionStatus = positionStatus.replace(PositionConstants.POSITION_STATUS_INPROCESS + ",", "");
					positionStatus = positionStatus.replace(PositionConstants.POSITION_STATUS_INPROCESS, "");
					dynParam[3] += " ( tp.position_status=? AND tp.position_date_approved is NULL ) OR ";
					dynamicContentForDynParam2.add(PositionConstants.POSITION_STATUS_INPROCESS);
				}
				if (positionStatus.contains(PositionConstants.POSITION_STATUS_HOLD)) {
					positionStatus = positionStatus.replace(PositionConstants.POSITION_STATUS_HOLD + ",", "");
					positionStatus = positionStatus.replace(PositionConstants.POSITION_STATUS_HOLD, "");
					dynParam[3] += " ( tp.position_status=?  ) OR ";
					dynamicContentForDynParam2.add(PositionConstants.POSITION_STATUS_HOLD);
				}
				if (positionStatus.contains(PositionConstants.POSITION_STATUS_TO_BE_OPENED)) {
					positionStatus = positionStatus.replace(PositionConstants.POSITION_STATUS_TO_BE_OPENED + ",", "");
					positionStatus = positionStatus.replace(PositionConstants.POSITION_STATUS_TO_BE_OPENED, "");
					dynParam[3] += " ( tp.position_status=? AND tp.position_date_approved is NOT NULL ) OR ";
					dynamicContentForDynParam2.add(PositionConstants.POSITION_STATUS_INPROCESS);
				}
				if (positionStatus.contains(PositionConstants.POSITION_STATUS_MY_APPROVAL_PENDING)) {
					positionStatus = positionStatus.replace(PositionConstants.POSITION_STATUS_MY_APPROVAL_PENDING + ",",
							"");
					positionStatus = positionStatus.replace(PositionConstants.POSITION_STATUS_MY_APPROVAL_PENDING, "");
					// dynParam[1] = " ,(SELECT * FROM (SELECT * FROM
					// tp_requisition_approval_feedback ORDER BY feedback_id
					// desc) AS traf GROUP by traf.position_id) AS traf ";
					// dynParam[1] = "LEFT JOIN tp_requisition_approval_feedback
					// traf ON (traf.position_id = tp.position_id)";
					dynParam[1] = "LEFT JOIN tp_todo tpt ON(tpt.position_id=tp.position_id)";
					// dynParam[3] += " (tp.position_status = ? AND
					// traf.position_id=tp.position_id AND (traf.to_user_id=? OR
					// (traf.to_user_id is null AND traf.by_user_id=? AND
					// tp.position_date_approved IS NULL))) OR ";
					// dynParam[3] += " (tp.position_status = ? AND
					// (traf.to_user_id=? OR "
					// + "(traf.to_user_id is null AND traf.by_user_id=? AND
					// tp.position_date_approved IS NULL))) OR ";
					dynParam[3] += " (tp.position_status = ? AND (tpt.user_id=? " + ")) OR ";
					dynamicContentForDynParam2.add(PositionConstants.POSITION_STATUS_INPROCESS);
					dynamicContentForDynParam2.add(userId);
					// dynamicContentForDynParam2.add(userId);
				}
				qMarks = Utils.setDynamicParamsAndReturnQmarks(positionStatus, dynamicContentForDynParam2);
				dynParam[3] += " tp.position_status IN (" + qMarks + ")";
				dynParam[3] += " ) ";
			}

			if (!Utils.isBlankOrNull(customFieldFilterId)) {
				dynParam[0] += " ,group_concat(DISTINCT ifnull(tvp.string_value,ifnull(tvp.number_value,tvp.date_value))  order by ifnull(tvp.string_value,ifnull(tvp.number_value,tvp.date_value)) separator '|' ) as customVal ";
				dynParam[3] += " AND tvp.custom_field_id = ? ";
				dynamicContentForDynParam2.add(customFieldFilterId);

				dynParam[4] = " WHERE customVal=?";
				try {
					if (CustomFieldConstants.TYPE_DATE.equals(customFieldFilterType))
						dynamicContentForDynParam3.add(Utils.getDateStringConvertedToOtherDateFormat(
								customFieldFilterValue, Utils.regEUDateFormat, Utils.redYYYYMMDDFormat));
					else
						dynamicContentForDynParam3.add(customFieldFilterValue);
				} catch (Exception e) {
					dynamicContentForDynParam3.add("");
				}
			}

			dynParam[3] += PositionWithRightsClause.getClauseForStepUserAndRequestedByAndRequisitionApproval(userId,
					"tp.position_id", dynamicContentForDynParam2, permissionSet);

			dq = new DBPreparedQuery("dGetAllPositions", dynParam);
			dq.setString(1, PositionConstants.STEP_LEVEL_SHORTLIST);
			dq.setString(2, PositionConstants.STEP_LEVEL_SELECT);
			dq.setString(3, PositionConstants.STEP_LEVEL_ACCEPT);
			dq.setString(4, PositionConstants.POSITION_STATUS_DELETED);
			int cnt = 5;
			for (int i = 0; i < dynamicContentForDynParam2.size(); i++) {
				dq.setString(cnt++, dynamicContentForDynParam2.get(i));
			}
			for (int j = 0; j < dynamicContentForDynParam3.size(); j++) {
				dq.setString(cnt++, dynamicContentForDynParam3.get(j));
			}
			positions = dq.getResult();
		} catch (Exception exep) {
			TPLogger.getLogger().error(GlobalConstants.ERROR, exep);
		} finally {
			if (dq != null) {
				dq.releaseConnection();
			}
		}
		return positions;
	}

	/**
	 * get no of candidates in process for this position
	 * 
	 * @param positionId
	 */
	public int getNoOfCandidatesInProcess(String positionId) {
		DBPreparedQuery dq = null;
		int noOfCandidates = 0;
		try {
			dq = new DBPreparedQuery("dGetNoOfCandidatesInProcess");
			dq.setString(1, positionId);
			dq.setString(2, SelectionProcessConstants.APPLICANT_NOT_JOINED);
			noOfCandidates = dq.getIntResult();
		} catch (Exception e) {
			TPLogger.getLogger().error("Error while getting no of candidates in process", e);
		} finally {
			if (dq != null) {
				dq.releaseConnection();
			}
		}
		return noOfCandidates;
	}

