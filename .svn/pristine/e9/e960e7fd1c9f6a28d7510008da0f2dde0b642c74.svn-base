				dq.releaseConnection();
			}
		}
		return steps;
	}

	public String addNewPosition(SimpleDataObject position, List<String> trackModeNotifications, String userId,
			boolean isRequisition) throws SQLException, Exception {
		DBTransaction tran = null;
		String positionId = "";
		try {
			tran = new DBTransaction();
			// Create Position.
			createPosition(position, userId, tran);
			positionId = position.getString("positionId");

			addNaukriPositionFields(position, positionId, tran);

			// Add Hiring Process only if it is not requisition
			if (!isRequisition) {
				List steps = (List) position.getAttribute("steps");
				addSteps(positionId, steps, tran);
			} else {
				List steps = getDefaultStepsTobeAdded();
				addSteps(positionId, steps, tran);
			}
			// Add Primary Skills
			if (!Utils.isBlankOrNull(position.getString("primarySkills"))) {
				String[] primarySkills = position.getString("primarySkills").split(",");
				for (int i = 0; i < primarySkills.length; i++) {
					insertPositionSkills(primarySkills[i].trim(), position.getString("positionId"),
							PositionConstants.POSITION_SKILL_PRIMARY, tran);
				}
			}

			// Add Secondary Skills
			if (!Utils.isBlankOrNull(position.getString("secondarySkills"))) {
				String[] secondarySkills = position.getString("secondarySkills").split(",");
				for (int i = 0; i < secondarySkills.length; i++) {
					insertPositionSkills(secondarySkills[i].trim(), position.getString("positionId"),
							PositionConstants.POSITION_SKILL_SECONDARY, tran);
				}
			}

			// Add Degrees
			if (!Utils.isBlankOrNull(position.getString("degreeId"))) {
				String[] degreeIds = position.getString("degreeId").split(",");
				for (int i = 0; i < degreeIds.length; i++) {
					insertPositionDegrees(degreeIds[i].trim(), position.getString("positionId"), tran);
				}
			}

			// Add Branches
			if (!Utils.isBlankOrNull(position.getString("branchId"))) {
				String[] branchIds = position.getString("branchId").split(",");
				for (int i = 0; i < branchIds.length; i++) {
					insertPositionBranches(branchIds[i].trim(), position.getString("positionId"), tran);
				}
			}

			CustomFieldManager customFieldManager = new CustomFieldManager();
			ArrayList<CustomFieldData> customFields = (ArrayList<CustomFieldData>) position
					.getAttribute("customFields");
			customFieldManager.deleteCustomFieldValuesForEntity(positionId, CustomFieldConstants.ENTITY_TYPE_POSITION,
					tran);
			customFieldManager.insertCustomFieldValues(customFields, positionId,
					CustomFieldConstants.ENTITY_TYPE_POSITION, tran);

			if (!Utils.isBlankOrNull(position.getString("draftId"))) {
				String draftId = position.getString("draftId");
				PositionDraftsManager draftsManager = new PositionDraftsManager();
				draftsManager.deleteDraft(draftId, tran);
			}

			tran.commit();
			sendTrackModeNotifications(position, trackModeNotifications, userId);

		} catch (SQLException e) {
			TPLogger.getLogger().error(GlobalConstants.ERROR, e);
			try {
				tran.rollback();
			} catch (SQLException ex) {
				TPLogger.getLogger()
						.error("Error encountered while rolling back the transaction while creating new position.", e);
			}
			throw new SQLException("Error encountered while creating new position.", e);
		} catch (Exception e) {
			TPLogger.getLogger().error(GlobalConstants.ERROR, e);
			try {
				tran.rollback();
			} catch (SQLException ex) {
				TPLogger.getLogger()
						.error("Error encountered while rolling back the transaction while creating new position.", e);
			}
			throw new Exception("Error encountered while creating new position.", e);
		} finally {
			if (tran != null) {
				tran.release();
			}
		}
		return positionId;
	}

	private void createPosition(SimpleDataObject position, String userId, DBTransaction tran) throws SQLException {
		DBPreparedQuery dq = null;
		DBQuery dbq = null;
		String positionId = null;
		try {
			String departmentId = Utils.isBlankOrNullOrDefault(position.getString("departmentId"), "-1") ? null
					: position.getString("departmentId");
			String subDepartmentId = Utils.isBlankOrNullOrDefault(position.getString("subDepartmentId"), "-1") ? null
					: position.getString("subDepartmentId");
			String subSubDepartmentId = Utils.isBlankOrNullOrDefault(position.getString("subSubDepartmentId"), "-1")
					? null : position.getString("subSubDepartmentId");
			String sub3DepartmentId = Utils.isBlankOrNullOrDefault(position.getString("sub3DepartmentId"), "-1") ? null
					: position.getString("sub3DepartmentId");
			String sub4DepartmentId = Utils.isBlankOrNullOrDefault(position.getString("sub4DepartmentId"), "-1") ? null
					: position.getString("sub4DepartmentId");
			String gradeId = Utils.isBlankOrNullOrDefault(position.getString("gradeId"), "-1") ? null
					: position.getString("gradeId");
			String bandId = Utils.isBlankOrNullOrDefault(position.getString("bandId"), "-1") ? null
					: position.getString("bandId");

			// Added for Asian Paints BEGIN
			String pLocationId = Utils.isBlankOrNullOrDefault(position.getString("pLocationId"), "-1") ? null
					: position.getString("pLocationId");
			String pSubLocationId = Utils.isBlankOrNullOrDefault(position.getString("pSubLocationId"), "-1") ? null
					: position.getString("pSubLocationId");
			String pSubSubLocationId = Utils.isBlankOrNullOrDefault(position.getString("pSubSubLocationId"), "-1")
					? null : position.getString("pSubSubLocationId");
			String sf_position_code = StringUtils.EMPTY;
			String pJobFunctionId = Utils.isBlankOrNullOrDefault(position.getString("pJobFunctionId"), "-1") ? null
					: position.getString("pJobFunctionId");
			String pJobPayGradeId = Utils.isBlankOrNullOrDefault(position.getString("pJobPayGradeId"), "-1") ? null
					: position.getString("pJobPayGradeId");
			String pJobCodeId = Utils.isBlankOrNullOrDefault(position.getString("pJobCodeId"), "-1") ? null
					: position.getString("pJobCodeId");

			String countryId = Utils.isBlankOrNullOrDefault(position.getString("countryId"), "-1") ? null
					: position.getString("countryId");
			String stateId = Utils.isBlankOrNullOrDefault(position.getString("stateId"), "-1") ? null
					: position.getString("stateId");
			// Added for Asian Paints END

			dq = new DBPreparedQuery("dPositionManager_AddNewPosition", tran);
			dq.setString(1, position.getString("positionCode"));
			dq.setString(2, position.getString("positionName"));
			dq.setString(3, position.getString("minimumExperience"));
			dq.setString(4, position.getString("maximumExperience"));
			dq.setString(5, position.getString("vacancies"));
			dq.setString(6, position.getString("vacancies"));
			dq.setTimestamp(7, new Timestamp(
					Utils.convertToDate(position.getString("hireByDate") + " 23:59:59", Utils.regDDMMYYYYHHMMSSFromat)
							.getTime()));
			dq.setString(8, userId);
			dq.setString(9, position.getString("note"));
			dq.setString(10, departmentId);
			dq.setString(11, position.getString("positionStatus"));
			if (Utils.isBlankOrNull(position.getString("positionOwnerId"))
					|| "-1".equals(position.getString("positionOwnerId"))) {
				dq.setNull(12, Types.NULL);
			} else {
				dq.setString(12, position.getString("positionOwnerId"));
			}

			dq.setString(13, position.getString("requisitionerId"));
			dq.setString(14, subDepartmentId);
			dq.setString(15, subSubDepartmentId);
			dq.setString(16, sub3DepartmentId);
			dq.setString(17, sub4DepartmentId);
			dq.setString(18, position.getString("positionLevel"));
			dq.setString(19, position.getString("positionReferalFees"));
			dq.setString(20, position.getString("requisitionApprovalTemplateId"));
			String responsibilities = position.getString("responsibilities");
			if (!Utils.isBlankOrNull(responsibilities) && responsibilities.length() > 65535) {
				responsibilities = responsibilities.substring(0, 65535);
			}
			dq.setString(21, responsibilities);
			String requirements = position.getString("requirements");
			if (!Utils.isBlankOrNull(requirements) && requirements.length() > 65535) {
				requirements = requirements.substring(0, 65535);
			}
			dq.setString(22, requirements);
			dq.setString(23, gradeId);
			dq.setString(24, bandId);
			if (!Utils.isBlankOrNull(position.getString("budgetItemId"))) {
				dq.setString(25, position.getString("budgetItemId"));
			} else {
				dq.setNull(25, Types.NULL);
			}
			dq.setString(26, position.getString("typeOfVacancy"));
			dq.setString(27, position.getString("replacementEmpCode"));
			dq.setString(28, position.getString("positionTypeExtInt"));
			dq.setString(29, position.getString("positionClone"));
			dq.setString(30, position.getString("notifyUserIds"));
			dq.setString(31, position.getString("approvalUserIds"));

			// Added for Asian Paints
			dq.setString(32, pLocationId);
			dq.setString(33, pSubLocationId);
			dq.setString(34, pSubSubLocationId);

			sf_position_code = position.getString("positionCodeForAP");
			if (!Utils.isBlankOrNull(sf_position_code)) {
				int spacePos = sf_position_code.indexOf(" ");
				if (spacePos > 0) {
					sf_position_code = sf_position_code.substring(0, spacePos);
					dq.setString(35, sf_position_code);
				} else {
					dq.setString(35, sf_position_code);

				}
			}
			dq.setString(36, pJobFunctionId);
			dq.setString(37, pJobPayGradeId);
			dq.setString(38, pJobCodeId);
			dq.setString(39, countryId);
			dq.setString(40, stateId);

			dq.execute();

			dbq = new DBQuery("dFetchLastInsertID", tran);
			positionId = dbq.getIdResult();
			position.setAttribute("positionId", positionId);

			// Add Locations
			if (!Utils.isBlankOrNull(position.getString("locationId"))) {
				String[] locationIds = position.getString("locationId").split(",");
				for (int i = 0; i < locationIds.length; i++) {
					insertPositionLocations(locationIds[i].trim(), position.getString("positionId"), tran);
				}
			}

			// Add BU
			if (!Utils.isBlankOrNull(position.getString("buId"))) {
				String[] buIds = position.getString("buId").split(",");
				for (int i = 0; i < buIds.length; i++) {
					insertPositionBU(buIds[i].trim(), position.getString("positionId"), tran);
				}
			}

			// Add Cost Center
			if (!Utils.isBlankOrNull(position.getString("costCenterId"))) {
				String[] costCenterIds = position.getString("costCenterId").split(",");
				for (int i = 0; i < costCenterIds.length; i++) {
					insertPositionCostCenter(costCenterIds[i].trim(), position.getString("positionId"), tran);
				}
			}

		} finally {
			if (dq != null) {
				dq.closeOpenCursors();
			}
			if (dbq != null) {
				dbq.closeOpenCursors();
			}
		}
	}

	private void addNaukriPositionFields(SimpleDataObject position, String positionId, DBTransaction tran)
			throws SQLException {
		DBPreparedQuery dq = null;
