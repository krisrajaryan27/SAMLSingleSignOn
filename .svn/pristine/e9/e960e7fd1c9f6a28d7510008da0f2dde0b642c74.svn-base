		try {
			dq = new DBPreparedQuery("dGetDefaultSteps");
			dq.setString(1, StepConstants.SYSTEM_STEP);
			dq.setString(2, StepConstants.STEP_STAGE_SHORTLIST);
			steps = dq.getResult();
		} catch (Exception e) {
			TPLogger.getLogger().error("Error while getting default steps", e);
		} finally {
