	public void markCandidatesAndDropPosition(String positionId, String userId) throws Exception {
		DBTransaction tran = null;
		SelectionProcessManager selectionProcessManager = new SelectionProcessManager();
		try {
			tran = new DBTransaction();
			List candidates = getCandidatesInProcessForPosition(positionId);
			Iterator<SimpleDataObject> itr = candidates.iterator();
			List<String> appointmentIds = new ArrayList<String>();
			ToDoManager toDoManager = new ToDoManager();
			while (itr.hasNext()) {
				SimpleDataObject candidate = itr.next();
				SimpleDataObject feedback = selectionProcessManager
						.getLatestFeedback(candidate.getString("applicantId"));
				if (feedback != null && !Utils.isBlankOrNull(feedback.getString("communicationId"))) {
					// Edit Feedback
					editFeedback(feedback.getString("communicationId"), candidate.getString("stepId"),
							SelectionProcessConstants.STEP_POSITION_CLOSED_REJECT, userId, tran);
				} /*
					 * else { // Add New Feedback
					 * addFeedback(candidate.getString("applicantId"),
					 * candidate.getString("positionId"),
					 * candidate.getString("stepId"),
					 * SelectionProcessConstants.STEP_POSITION_CLOSED_REJECT,
					 * userId, tran); }
					 */
				// Delete future appointments.
				List appointments = selectionProcessManager.getAppointmentsInFuture(candidate.getString("applicantId"));
				if (appointments != null && appointments.size() > 0) {
					for (int i = 0; i < appointments.size(); i++) {
						SimpleDataObject appointment = (SimpleDataObject) appointments.get(i);
						deleteAppointment(appointment.getString("appointmentId"), CalendarConstants.SEND_EMAIL_YES,
								tran);
						appointmentIds.add(appointment.getString("appointmentId"));

						toDoManager.deleteToDoForAppointment(appointment.getString("appointmentId"), tran);
					}
				}

				// mark ALL past appointment to NoShow
				appointments = selectionProcessManager
						.getAllAtiveAppointmentsInPast(candidate.getString("applicantId"));
				if (appointments != null && appointments.size() > 0) {
					for (int i = 0; i < appointments.size(); i++) {
						SimpleDataObject appointment = (SimpleDataObject) appointments.get(i);
						selectionProcessManager.updateAppointmentStatus(
								"" + CalendarConstants.APPOINTMENT_STATUS_NOSHOW,
								appointment.getString("appointmentId"), tran);
					}
				}

				selectionProcessManager.updateApplicantPositionStatus(candidate.getString("applicantId"), null, null,
						SelectionProcessConstants.APPLICANT_NOT_JOINED, null, null, null, null, null, null, null, tran,
						null, null);
			}
			// Close Position
			changePositionStatus(positionId, PositionConstants.POSITION_STATUS_DROPPED, userId,
					BudgetConstants.IS_BUDGET_COMMITTED, tran);

			tran.commit();

			Iterator<SimpleDataObject> itr2 = candidates.iterator();
			while (itr2.hasNext()) {
				SimpleDataObject candidate = itr2.next();
				TPIndexEventQueue.push(new TPIndexEvent(TPIndexEvent.TYPE_UPDATE_APPLICANT,
						candidate.getString("applicantId"), TPIndexEvent.PRIORITY_HIGH));
			}
			for (int i = 0; i < appointmentIds.size(); i++) {
				CalendarScheduler.deleteTrigger((String) appointmentIds.get(i));
				SMSScheduler.deleteTrigger((String) appointmentIds.get(i));
			}

		} catch (Exception e) {
			TPLogger.getLogger().error(GlobalConstants.ERROR, e);
			try {
				tran.rollback();
			} catch (Exception e1) {
				TPLogger.getLogger().error(GlobalConstants.ERROR, e);
			}
			throw new Exception();
		} finally {
			if (tran != null) {
				tran.release();
			}
		}
	}

	public void markCandidatesAndClosePosition(String positionId, String userId) throws Exception {
		DBTransaction tran = null;
		SelectionProcessManager selectionProcessManager = new SelectionProcessManager();
		try {
			tran = new DBTransaction();
			List candidates = getCandidatesInProcessForPosition(positionId);
			Iterator<SimpleDataObject> itr = candidates.iterator();
			List<String> appointmentIds = new ArrayList<String>();
			ToDoManager toDoManager = new ToDoManager();
			while (itr.hasNext()) {
				SimpleDataObject candidate = itr.next();
				SimpleDataObject feedback = selectionProcessManager
						.getLatestFeedback(candidate.getString("applicantId"));
				if (feedback != null && !Utils.isBlankOrNull(feedback.getString("communicationId"))) {
					// Edit Feedback
					editFeedback(feedback.getString("communicationId"), candidate.getString("stepId"),
							SelectionProcessConstants.STEP_POSITION_CLOSED_REJECT, userId, tran);
				} else {
					// Add New Feedback
					addFeedback(candidate.getString("applicantId"), candidate.getString("positionId"),
							candidate.getString("stepId"), SelectionProcessConstants.STEP_POSITION_CLOSED_REJECT,
							userId, tran);
				}
				// Delete future appointments.
				List appointments = selectionProcessManager.getAppointmentsInFuture(candidate.getString("applicantId"));
				if (appointments != null && appointments.size() > 0) {
					for (int i = 0; i < appointments.size(); i++) {
						SimpleDataObject appointment = (SimpleDataObject) appointments.get(i);
						deleteAppointment(appointment.getString("appointmentId"), CalendarConstants.SEND_EMAIL_YES,
								tran);
						appointmentIds.add(appointment.getString("appointmentId"));

						toDoManager.deleteToDoForAppointment(appointment.getString("appointmentId"), tran);
					}
				}

				// mark ALL past appointment to NoShow
				appointments = selectionProcessManager
						.getAllAtiveAppointmentsInPast(candidate.getString("applicantId"));
				if (appointments != null && appointments.size() > 0) {
					for (int i = 0; i < appointments.size(); i++) {
						SimpleDataObject appointment = (SimpleDataObject) appointments.get(i);
						selectionProcessManager.updateAppointmentStatus(
								"" + CalendarConstants.APPOINTMENT_STATUS_NOSHOW,
								appointment.getString("appointmentId"), tran);
					}
				}

				selectionProcessManager.updateApplicantPositionStatus(candidate.getString("applicantId"), null, null,
						SelectionProcessConstants.APPLICANT_NOT_JOINED, null, null, null, null, null, null, null, tran,
						null, null);
			}
			// Close Position
			changePositionStatus(positionId, PositionConstants.POSITION_STATUS_CLOSED, userId,
					BudgetConstants.IS_BUDGET_COMMITTED, tran);

			tran.commit();

			Iterator<SimpleDataObject> itr2 = candidates.iterator();
			while (itr2.hasNext()) {
				SimpleDataObject candidate = itr2.next();
				TPIndexEventQueue.push(new TPIndexEvent(TPIndexEvent.TYPE_UPDATE_APPLICANT,
						candidate.getString("applicantId"), TPIndexEvent.PRIORITY_HIGH));
			}
			for (int i = 0; i < appointmentIds.size(); i++) {
				CalendarScheduler.deleteTrigger((String) appointmentIds.get(i));
				SMSScheduler.deleteTrigger((String) appointmentIds.get(i));
			}

		} catch (Exception e) {
			TPLogger.getLogger().error(GlobalConstants.ERROR, e);
			try {
				tran.rollback();
			} catch (Exception e1) {
				TPLogger.getLogger().error(GlobalConstants.ERROR, e);
			}
			throw new Exception();
		} finally {
			if (tran != null) {
				tran.release();
			}
		}
	}

	private void deleteAppointment(String appointmentId, int doSendEmail, DBTransaction tran) {
		DBPreparedQuery dq = null;
		try {
			CalendarManager calendarManager = new CalendarManager();
			// first add entry to notification and then delete
			AppointmentData aDataOld = calendarManager.getAppointmentDataToEdit(appointmentId);
			List attendeesOld = calendarManager.getAppointmentAttendees(appointmentId);
			String oldAttendees = "";
			if (attendeesOld != null) {
				for (int i = 0; i < attendeesOld.size(); i++) {
					UserData uData = (UserData) attendeesOld.get(i);
					oldAttendees += uData.getUserId();
					if (i < attendeesOld.size() - 1) {
						oldAttendees = oldAttendees + ",";
					}
				}
			}
			if (doSendEmail == CalendarConstants.SEND_EMAIL_YES) {
				AppointmentNotificationManager appointmentNotificationManager = new AppointmentNotificationManager();
				appointmentNotificationManager.insertNotification(appointmentId, aDataOld.getAppointmentSubject(),
						aDataOld.getAppointmentFromDate(), aDataOld.getAppointmentToDate(),
						aDataOld.getAppointmentCreatedBy(), "" + aDataOld.getApplicantId(),
						"" + aDataOld.getApplicantPositionId(), "" + aDataOld.getApplicantStepId(), oldAttendees, null,
						null, null, CalendarConstants.NOTIFY_DELETE, CalendarConstants.NOTIFICATION_NOT_PROCESSED,
						aDataOld.getAppointmentDateCreated(), aDataOld.getAppointmentDateModified(),
						aDataOld.getRemindMe(), aDataOld.getRemindInterviewer(), aDataOld.getInterviewMode(),
						aDataOld.getDetailsInterviewMode(), tran);
			}
			dq = new DBPreparedQuery("dDeleteAppointment", tran);
			dq.setString(1, appointmentId);
			dq.execute();
		} catch (Exception e) {
			TPLogger.getLogger().error("Error while deleting the appointment", e);
		} finally {
			if (dq != null) {
				if (tran == null) {
					dq.releaseConnection();
				} else {
					dq.closeOpenCursors();
				}
			}
		}
	}

