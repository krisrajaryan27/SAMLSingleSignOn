	public Object getPositionRequirementsToView(String positionId) {
		DBPreparedQuery dq = null;
		SimpleDataObject sDo = new SimpleDataObject();
		try {
			dq = new DBPreparedQuery("dPositionManager_ViewPositionRequirements");
			dq.setString(1, PositionConstants.POSITION_SKILL_PRIMARY);
			dq.setString(2, PositionConstants.POSITION_SKILL_SECONDARY);
			dq.setString(3, positionId);
			List resultSet = dq.getResult();
			if (resultSet != null && resultSet.size() > 0) {
				for (int i = 0; i < resultSet.size(); i++) {
					SimpleDataObject obj = (SimpleDataObject) resultSet.get(i);
					if (i == 0) {
						sDo.setAttribute("degreeTitle", obj.getString("degreeTitle"));
						sDo.setAttribute("branchName", obj.getString("branchName"));
						sDo.setAttribute("minimumExperience", obj.getString("minimumExperience"));
						sDo.setAttribute("maximumExperience", obj.getString("maximumExperience"));
						sDo.setAttribute("primarySkills", obj.getString("primarySkills"));
						sDo.setAttribute("secondarySkills", obj.getString("secondarySkills"));
						sDo.setAttribute("requirements", obj.getString("requirements"));
					}
				}
			}
		} catch (Exception e) {
			TPLogger.getLogger().error("Error while getting position description.", e);
		} finally {
			if (dq != null) {
				dq.releaseConnection();
			}
		}
		return sDo;
	}

	public Object getPositionRequirementsToEdit(String positionId) {
		DBPreparedQuery dq = null;
		SimpleDataObject sDo = new SimpleDataObject();
		try {
			dq = new DBPreparedQuery("dPositionManager_EditPositionRequirements");
			dq.setString(1, positionId);
			List resultSet = dq.getResult();
			if (resultSet != null && resultSet.size() > 0) {
				for (int i = 0; i < resultSet.size(); i++) {
					SimpleDataObject obj = (SimpleDataObject) resultSet.get(i);
					if (i == 0) {
						sDo.setAttribute("degreeId", obj.getString("degreeId"));
						sDo.setAttribute("branchId", obj.getString("branchId"));
						sDo.setAttribute("minimumExperience", obj.getString("minimumExperience"));
						sDo.setAttribute("maximumExperience", obj.getString("maximumExperience"));
						sDo.setAttribute("requirements", obj.getString("requirements"));

						dq = new DBPreparedQuery("dPositionManager_GetSkillsForPosition");
						dq.setString(1, PositionConstants.POSITION_SKILL_PRIMARY);
						dq.setString(2, positionId);
						SimpleDataObject primarySkillData = (SimpleDataObject) dq.getSingleObjectResult();
						sDo.setAttribute("primarySkills", primarySkillData.getString("skills"));

						dq = new DBPreparedQuery("dPositionManager_GetSkillsForPosition");
						dq.setString(1, PositionConstants.POSITION_SKILL_SECONDARY);
						dq.setString(2, positionId);
						SimpleDataObject secondarySkillData = (SimpleDataObject) dq.getSingleObjectResult();
						sDo.setAttribute("secondarySkills", secondarySkillData.getString("skills"));
					}
				}
			}
		} catch (Exception e) {
			TPLogger.getLogger().error("Error while getting position description.", e);
		} finally {
			if (dq != null) {
				dq.releaseConnection();
			}
		}
		return sDo;
	}

	private void appendStrings(StringBuffer buffer, String value) {
		if (buffer == null) {
			buffer = new StringBuffer();
		}
		if (!Utils.isBlankOrNull(value)) {
			if (buffer.length() > 0) {
				buffer.append(", ");
			}
			buffer.append(value.trim());
		}
	}

	public List<String> getPositionRequestedByIds() {
		List<String> ids = new ArrayList<String>();
		String roleIds = getRolesAuthorizedToRequestPosition();
		List<LoginData> users = getUsersForRole(roleIds);
		if (users != null && users.size() > 0) {
			for (LoginData data : users) {
				ids.add(data.getUserId());
			}
		}
		return ids;
	}

	public List<String> getPositionRequestedByNames() {
		List<String> names = new ArrayList<String>();
		String roleIds = getRolesAuthorizedToRequestPosition();
		List<LoginData> users = getUsersForRole(roleIds);
		if (users != null && users.size() > 0) {
			for (LoginData data : users) {
				names.add(data.getName());
			}
		}
		return names;
	}

	/**
	 * return users list for given role
	 * 
	 * @param roleId
	 * @return
	 */
	public ArrayList<LoginData> getUsersForRole(String roleIds) {
		ArrayList<LoginData> users = null;
		String[] dynParam = new String[1];
		dynParam[0] = " ";
		DBPreparedQuery dq = null;
		try {
			ArrayList<String> dynamicContent = new ArrayList<String>();
			// if rolesIds is null then populate all users
			if (Utils.isBlankOrNull(roleIds)) {
				dynParam[0] = "";
			} /*
				 * else { dynParam[0] = " and tur.role_id in (" + roleIds + ")";
				 * }
				 */
			else {
				String qMarks = Utils.setDynamicParamsAndReturnQmarks(roleIds, dynamicContent);
				dynParam[0] += " and tur.role_id in (" + qMarks + ") ";
			}
			dq = new DBPreparedQuery("dGetUsersForRole", dynParam);
			int cnt = 1;
			for (int i = 0; i < dynamicContent.size(); i++) {
				dq.setString(cnt++, dynamicContent.get(i));
			}
			dq.setInt(cnt++, UserConstants.ACTIVE);
			users = dq.getResult();
		} catch (Exception e) {
			TPLogger.getLogger().error("Error while getting users of role", e);
		} finally {
			if (dq != null) {
				dq.releaseConnection();
			}
		}
		return users;
	}

	public String getRolesAuthorizedToRequestPosition() {
		StringBuffer buffer = new StringBuffer();
		buffer.append(UserConstants.ROLE_ADMIN);
		buffer.append(",");
		buffer.append(UserConstants.ROLE_HR_MANAGER);
		buffer.append(",");
		buffer.append(UserConstants.ROLE_REQUISITIONER);
		buffer.append(",");
		buffer.append(UserConstants.ROLE_CXO);
		return buffer.toString();
	}

