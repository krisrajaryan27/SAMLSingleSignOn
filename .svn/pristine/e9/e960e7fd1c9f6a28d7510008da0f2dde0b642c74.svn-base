	public void savePositionDescription(SimpleDataObject positionDescription, List<String> trackModeNotifications,
			String userId) throws Exception {
		DBPreparedQuery dq = null;
		DBQuery dbq = null;
		DBTransaction tran = null;
		try {
			tran = new DBTransaction();
			String departmentId = Utils.isBlankOrNullOrDefault(positionDescription.getString("departmentId"), "-1")
					? null : positionDescription.getString("departmentId");
			String subDepartmentId = Utils.isBlankOrNullOrDefault(positionDescription.getString("subDepartmentId"),
					"-1") ? null : positionDescription.getString("subDepartmentId");
			String subSubDepartmentId = Utils
					.isBlankOrNullOrDefault(positionDescription.getString("subSubDepartmentId"), "-1") ? null
							: positionDescription.getString("subSubDepartmentId");
			String sub3DepartmentId = Utils.isBlankOrNullOrDefault(positionDescription.getString("sub3DepartmentId"),
					"-1") ? null : positionDescription.getString("sub3DepartmentId");
			String sub4DepartmentId = Utils.isBlankOrNullOrDefault(positionDescription.getString("sub4DepartmentId"),
					"-1") ? null : positionDescription.getString("sub4DepartmentId");
			String gradeId = Utils.isBlankOrNullOrDefault(positionDescription.getString("gradeId"), "-1") ? null
					: positionDescription.getString("gradeId");
			String bandId = Utils.isBlankOrNullOrDefault(positionDescription.getString("bandId"), "-1") ? null
					: positionDescription.getString("bandId");

			// Added for Asian Paints BEGIN
			String pLocationId = Utils.isBlankOrNullOrDefault(positionDescription.getString("pLocationId"), "-1") ? null
					: positionDescription.getString("pLocationId");
			String pSubLocationId = Utils.isBlankOrNullOrDefault(positionDescription.getString("pSubLocationId"), "-1")
					? null : positionDescription.getString("pSubLocationId");
			String pSubSubLocationId = Utils.isBlankOrNullOrDefault(positionDescription.getString("pSubSubLocationId"),
					"-1") ? null : positionDescription.getString("pSubSubLocationId");

			String pJobFunctionId = Utils.isBlankOrNullOrDefault(positionDescription.getString("pJobFunctionId"), "-1")
					? null : positionDescription.getString("pJobFunctionId");
			String pJobPayGradeId = Utils.isBlankOrNullOrDefault(positionDescription.getString("pJobPayGradeId"), "-1")
					? null : positionDescription.getString("pJobPayGradeId");
			String pJobCodeId = Utils.isBlankOrNullOrDefault(positionDescription.getString("pJobCodeId"), "-1") ? null
					: positionDescription.getString("pJobCodeId");

			String countryId = Utils.isBlankOrNullOrDefault(positionDescription.getString("countryId"), "-1") ? null
					: positionDescription.getString("countryId");
			String stateId = Utils.isBlankOrNullOrDefault(positionDescription.getString("stateId"), "-1") ? null
					: positionDescription.getString("stateId");
			// Added for Asian Paints END

			dq = new DBPreparedQuery("dPositionManager_UpdatePositionDescription", tran);
			dq.setString(1, positionDescription.getString("positionName"));
			dq.setString(2, positionDescription.getString("positionCode"));

			if (Utils.isBlankOrNull(positionDescription.getString("positionOwnerId"))
					|| "-1".equals(positionDescription.getString("positionOwnerId"))) {
				dq.setNull(3, Types.NULL);
			} else {
				dq.setString(3, positionDescription.getString("positionOwnerId"));
			}

			dq.setString(4, positionDescription.getString("requisitionerId"));
			dq.setString(5, departmentId);
			dq.setString(6, positionDescription.getString("vacancies"));
			dq.setDate(7, Utils.convertToSQLDate(positionDescription.getString("hireByDate"), Utils.regEUDateFormat));
			dq.setString(8, positionDescription.getString("note"));
			dq.setString(9, subDepartmentId);
			dq.setString(10, subSubDepartmentId);
			dq.setString(11, sub3DepartmentId);
			dq.setString(12, sub4DepartmentId);
			dq.setString(13, positionDescription.getString("positionLevel"));
			dq.setString(14, positionDescription.getString("positionReferalFees"));

			String responsibilities = positionDescription.getString("responsibilities");
			if (!Utils.isBlankOrNull(responsibilities) && responsibilities.length() > 65535) {
				responsibilities = responsibilities.substring(0, 65535);
			}
			dq.setString(15, responsibilities);
			dq.setString(16, gradeId);
			dq.setString(17, bandId);
			if (!Utils.isBlankOrNull(positionDescription.getString("budgetItemId"))) {
				dq.setString(18, positionDescription.getString("budgetItemId"));
			} else {
				dq.setNull(18, Types.NULL);
			}
			dq.setString(19, positionDescription.getString("typeOfVacancy"));
			dq.setString(20, positionDescription.getString("replacementEmpCode"));
			dq.setString(21, positionDescription.getString("positionTypeExtInt"));
			// Added for Asian Paints BEGIN
			dq.setString(22, pLocationId);
			dq.setString(23, pSubLocationId);
			dq.setString(24, pSubSubLocationId);

			String positionCodeForAP = positionDescription.getString("positionCodeForAP");
			if (!Utils.isBlankOrNull(positionCodeForAP)) {
				int spacePos = positionCodeForAP.indexOf(" ");
				if (spacePos > 0) {
					positionCodeForAP = positionCodeForAP.substring(0, spacePos);
					dq.setString(25, positionCodeForAP);
				} else {
					dq.setString(25, positionCodeForAP);
				}

			}
			dq.setString(26, pJobFunctionId);
			dq.setString(27, pJobPayGradeId);
			dq.setString(28, pJobCodeId);
			dq.setString(29, countryId);
			dq.setString(30, stateId);
			// Added for Asian Paints END

			dq.setString(31, positionDescription.getString("positionId"));

			dq.execute();

			dq = new DBPreparedQuery("dPositionManager_UpdatePositionNaukriDescription", tran);

			dq.setString(1, positionDescription.getString("contactPersonName"));
			dq.setString(2, positionDescription.getString("jobIndustryCode"));
			dq.setString(3, positionDescription.getString("jobFunctionCode"));
			dq.setString(4, positionDescription.getString("jobRoleCode"));
			dq.setString(5, positionDescription.getString("jobKeywords"));
			dq.setString(6, positionDescription.getString("country"));
			dq.setString(7, positionDescription.getString("minimumSalary"));

			dq.setString(8, positionDescription.getString("maximumSalary"));
			dq.setString(9, positionDescription.getString("benefitsDescription"));
			dq.setString(10, positionDescription.getString("displaySalary"));
			if (!Utils.isBlankOrNull(positionDescription.getString("desiredCandidateSummaryText"))) {
				dq.setString(11, positionDescription.getString("desiredCandidateSummaryText"));
			} else {
				dq.setNull(11, Types.NULL);
			}
			dq.setString(12, positionDescription.getString("contactPersonEmail"));
			dq.setString(13, positionDescription.getString("applyByWebURL"));
			dq.setString(14, positionDescription.getString("jobFeedResponseEmail"));
			dq.setString(15, positionDescription.getString("salaryCurrency"));
			dq.setString(16, positionDescription.getString("positionId"));
			dq.execute();

			upodateNaukriPositionFields(positionDescription, positionDescription.getString("positionId"), tran);
			// insert branches
			deletePositionLocations(positionDescription.getString("positionId"), tran);
			if (!Utils.isBlankOrNull(positionDescription.getString("locationId"))) {
				String[] locationIds = positionDescription.getString("locationId").split(",");
				for (int i = 0; i < locationIds.length; i++) {
					insertPositionLocations(locationIds[i].trim(), positionDescription.getString("positionId"), tran);
				}
			}

			// insert LOB
			deletePositionBU(positionDescription.getString("positionId"), tran);
			if (!Utils.isBlankOrNull(positionDescription.getString("buId"))) {
				String[] buIds = positionDescription.getString("buId").split(",");
				for (int i = 0; i < buIds.length; i++) {
					insertPositionBU(buIds[i].trim(), positionDescription.getString("positionId"), tran);
				}
			}
			// insert Cost Center
			deletePositionCostCenter(positionDescription.getString("positionId"), tran);
			if (!Utils.isBlankOrNull(positionDescription.getString("costCenterId"))) {
				String[] costCenterIds = positionDescription.getString("costCenterId").split(",");
				for (int i = 0; i < costCenterIds.length; i++) {
					insertPositionCostCenter(costCenterIds[i].trim(), positionDescription.getString("positionId"),
							tran);
				}
			}

			CustomFieldManager customFieldManager = new CustomFieldManager();
			ArrayList<CustomFieldData> customFields = (ArrayList<CustomFieldData>) positionDescription
					.getAttribute("customFields");
			customFieldManager.deleteCustomFieldValuesForEntity(positionDescription.getString("positionId"),
					CustomFieldConstants.ENTITY_TYPE_POSITION, tran);
			customFieldManager.insertCustomFieldValues(customFields, positionDescription.getString("positionId"),
					CustomFieldConstants.ENTITY_TYPE_POSITION, tran);

			tran.commit();

			sendTrackModeNotifications(positionDescription, trackModeNotifications, userId);
		} catch (Exception e) {
			TPLogger.getLogger().error("Error while saving the position description", e);
			try {
				tran.rollback();
			} catch (SQLException sq) {
				TPLogger.getLogger().error("Error while rolling back transaction while saving the position description",
						e);
			}
			throw new Exception();
		} finally {
			if (dq != null) {
				dq.releaseTransaction(tran);
			}
			if (dbq != null) {
				dbq.releaseTransaction(tran);
			}
		}
	}

	public void savePositionRequirements(SimpleDataObject positionRequirements) throws Exception {
		DBPreparedQuery dq = null;
		DBQuery dbq = null;
		DBTransaction tran = null;
		try {
			tran = new DBTransaction();
			dq = new DBPreparedQuery("dPositionManager_UpdatePositionRequirements", tran);
			dq.setString(1, positionRequirements.getString("minimumExperience"));
			dq.setString(2, positionRequirements.getString("maximumExperience"));
			String requirements = positionRequirements.getString("requirements");
			if (!Utils.isBlankOrNull(requirements) && requirements.length() > 65535) {
				requirements = requirements.substring(0, 65535);
			}
			dq.setString(3, requirements);
			dq.setString(4, positionRequirements.getString("positionId"));
			dq.execute();

			// delete position skills
			deletePositionSkills(positionRequirements.getString("positionId"), tran);

			// insert primary skills
			if (!Utils.isBlankOrNull(positionRequirements.getString("primarySkills"))) {
				String[] primarySkills = positionRequirements.getString("primarySkills").split(",");
				for (int i = 0; i < primarySkills.length; i++) {
					insertPositionSkills(primarySkills[i].trim(), positionRequirements.getString("positionId"),
							PositionConstants.POSITION_SKILL_PRIMARY, tran);
				}
			}

			// insert secondary skills
			if (!Utils.isBlankOrNull(positionRequirements.getString("secondarySkills"))) {
				String[] secondarySkills = positionRequirements.getString("secondarySkills").split(",");
				for (int i = 0; i < secondarySkills.length; i++) {
					insertPositionSkills(secondarySkills[i].trim(), positionRequirements.getString("positionId"),
							PositionConstants.POSITION_SKILL_SECONDARY, tran);
				}
			}

			// insert degree
			deletePositionDegrees(positionRequirements.getString("positionId"), tran);
			if (!Utils.isBlankOrNull(positionRequirements.getString("degreeId"))) {
				String[] degreeIds = positionRequirements.getString("degreeId").split(",");
				for (int i = 0; i < degreeIds.length; i++) {
					insertPositionDegrees(degreeIds[i].trim(), positionRequirements.getString("positionId"), tran);
				}
			}

			// insert branches
			deletePositionBranches(positionRequirements.getString("positionId"), tran);
			if (!Utils.isBlankOrNull(positionRequirements.getString("branchId"))) {
				String[] branchIds = positionRequirements.getString("branchId").split(",");
				for (int i = 0; i < branchIds.length; i++) {
					insertPositionBranches(branchIds[i].trim(), positionRequirements.getString("positionId"), tran);
				}
			}

			tran.commit();
		} catch (Exception e) {
			TPLogger.getLogger().error(GlobalConstants.ERROR, e);
			try {
				tran.rollback();
			} catch (SQLException sq) {
				TPLogger.getLogger().error(GlobalConstants.ERROR, e);
			}
			throw new Exception();
		} finally {
			if (dq != null) {
				dq.releaseTransaction(tran);
			}
			if (dbq != null) {
				dbq.releaseTransaction(tran);
			}
		}
	}

	private void insertPositionBranches(String branchId, String positionId, DBTransaction tran) {
		DBPreparedQuery dq = null;
		try {
			dq = new DBPreparedQuery("dPositionManager_InsertPositionBranch", tran);
			dq.setString(1, positionId);
			dq.setString(2, branchId);
			dq.execute();
		} catch (Exception e) {
			TPLogger.getLogger().error(e);
		} finally {
			if (dq != null) {
				dq.closeOpenCursors();
			}
		}

	}

	private void insertPositionDegrees(String degreeId, String positionId, DBTransaction tran) {
		DBPreparedQuery dq = null;
		try {
			dq = new DBPreparedQuery("dPositionManager_InsertPositionDegree", tran);
			dq.setString(1, positionId);
			dq.setString(2, degreeId);
			dq.execute();
		} catch (Exception e) {
			TPLogger.getLogger().error(e);
		} finally {
			if (dq != null) {
				dq.closeOpenCursors();
			}
		}
	}

	private void insertPositionLocations(String locationId, String positionId, DBTransaction tran) {
		DBPreparedQuery dq = null;
