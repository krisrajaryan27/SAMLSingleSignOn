	/**
	 * @param positionId
	 * @param roles
	 * @return all users for given positions
	 */
	public ArrayList<com.talentPool.positions.dataobject.UserData> getUsersForPosition(String positionId,
			String[] roles) {
		ArrayList<com.talentPool.positions.dataobject.UserData> users = null;
		DBPreparedQuery dq = null;
		try {
			String[] dynParam = new String[1];
			dynParam[0] = " ";
			String roleIds = Utils.convertArrayIntoCommaSptdString(roles);
			if (!Utils.isBlankOrNull(roleIds)) {
				dynParam[0] = " AND tur.role_id in (" + roleIds + ")";
			}
			dq = new DBPreparedQuery("dPositionManager_GetUsersForPosition", dynParam);
			dq.setId(1, positionId);
			dq.setId(2, positionId);
			users = dq.getResult();
		} catch (Exception e) {
			TPLogger.getLogger().error(e);
		} finally {
			if (dq != null) {
				dq.releaseConnection();
			}
		}
		return users;

	}

	/**
	 * @param positionId
	 * @param roles
	 * @return all users for given positions
	 */
	public ArrayList<com.talentPool.positions.dataobject.UserData> getRecruiterForPosition(String positionId,
			String[] roles) {
		ArrayList<com.talentPool.positions.dataobject.UserData> users = null;
		DBPreparedQuery dq = null;
		try {
			String[] dynParam = new String[1];
			dynParam[0] = " ";
			String roleIds = Utils.convertArrayIntoCommaSptdString(roles);
			if (!Utils.isBlankOrNull(roleIds)) {
				dynParam[0] = " AND tur.role_id in (" + roleIds + ")";
			}
			dq = new DBPreparedQuery("dPositionManager_GetRecruiterForPosition", dynParam);
			dq.setId(1, positionId);

			users = dq.getResult();
		} catch (Exception e) {
			TPLogger.getLogger().error(e);
		} finally {
			if (dq != null) {
