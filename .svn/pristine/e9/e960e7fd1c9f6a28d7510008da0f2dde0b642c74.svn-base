	public void updatePositionVendors(String positionId, List<String> sourceIds) throws Exception {
		DBTransaction tran = null;
		try {
			tran = new DBTransaction();
			// Delete position vendors if any.
			deletePositionVendor(positionId, tran);
			// Insert position vendors
			if (sourceIds != null && sourceIds.size() > 0) {
				Iterator<String> itr = sourceIds.iterator();
				while (itr.hasNext()) {
					String sourceId = itr.next();
					insertPositionVendor(positionId, sourceId, tran);
				}
			}
			tran.commit();
		} catch (Exception e) {
			TPLogger.getLogger().error("Error while updating the position vendors", e);
			tran.rollback();
			throw e;
		} finally {
			if (tran != null) {
				tran.release();
			}
		}
	}

	public void updatePublishDates(String positionId, String publishFrom, String publishTo) {
		DBPreparedQuery dq = null;
		try {
			dq = new DBPreparedQuery("dPositionManager_updatePublishDates");
			dq.setTimestamp(1, new Timestamp(
					Utils.convertToDate(publishFrom + " 00:00:00", Utils.regDDMMYYYYHHMMSSFromat).getTime()));
			dq.setTimestamp(2, new Timestamp(
					Utils.convertToDate(publishTo + " 23:59:59", Utils.regDDMMYYYYHHMMSSFromat).getTime()));
			dq.setId(3, positionId);
			dq.execute();
		} catch (Exception e) {
			TPLogger.getLogger().error("Error while Update Publish From and To Dates", e);
		} finally {
			if (dq != null) {
				dq.releaseConnection();
			}
		}
	}

	public void removePositionFromSite(String positionId, String publishFromDate, String publishToDate)
			throws Exception {
		DBTransaction tran = null;
