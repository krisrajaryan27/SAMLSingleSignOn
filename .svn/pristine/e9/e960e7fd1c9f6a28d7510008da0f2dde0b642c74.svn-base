	private void sendTrackModeNotifications(SimpleDataObject positionDescription, List<String> trackModeNotifications,
			String userId) {
		if (GlobalApplicationProperties.getProperty(GlobalConstants.PROPERTY_BUDGET_MODE)
				.equals(BudgetConstants.BUDGET_MODE_TRACK)) {
			if (trackModeNotifications != null && trackModeNotifications.size() > 0) {
				for (String trackModeNotification : trackModeNotifications) {
					BudgetOwnerNotificationScheduler.addTrigger(
							(String) positionDescription.getAttribute("budgetItemId"), trackModeNotification, userId,
							null, positionDescription.getString("positionId"));
				}
			}
		}
	}

	public Object getPositionSummaryDetails(String positionId) {
		DBPreparedQuery dq = null;
		SimpleDataObject sDo = new SimpleDataObject();
		try {
			dq = new DBPreparedQuery("dPositionManager_PositionSummaryDetails");
			dq.setString(1, positionId);
			List resultSet = dq.getResult();
			if (resultSet != null && resultSet.size() > 0) {
				for (int i = 0; i < resultSet.size(); i++) {
					SimpleDataObject obj = (SimpleDataObject) resultSet.get(i);
					if (i == 0) {
						sDo.setAttribute("positionName", obj.getString("positionTitle"));
						sDo.setAttribute("positionCode", obj.getString("positionCode"));
						sDo.setAttribute("positionOwnerName", obj.getString("positionOwnerName"));
						sDo.setAttribute("requisitioner", obj.getString("requestedByUserName"));
						sDo.setAttribute("positionStatus", obj.getString("positionStatus"));
						sDo.setAttribute("currentNoOfOpenings", obj.getString("currentNoOfOpenings"));
						sDo.setAttribute("vacancies", obj.getString("noOfOpenings"));
						sDo.setAttribute("hireByDate",
								Utils.getDateConvertedToString(obj.getDate("hireByDate"), Utils.regDDMMMYYYYFormat));
						sDo.setAttribute("note", obj.getString("note"));
						sDo.setAttribute("responsibilities", obj.getString("responsibilities"));
						sDo.setAttribute("positionCreateDate", obj.getString("positionCreateDate"));
						sDo.setAttribute("department", obj.getString("departmentName"));
						sDo.setAttribute("subDepartment", obj.getString("subDepartmentName"));
						sDo.setAttribute("subSubDepartment", obj.getString("subSubDepartmentName"));
						sDo.setAttribute("positionLevel", obj.getString("positionLevel"));
						sDo.setAttribute("positionReferalFees", obj.getString("positionReferalFees"));
						sDo.setAttribute("locationName", obj.getString("locationName"));
						sDo.setAttribute("budgetItemName", obj.getString("budgetItemName"));
						sDo.setAttribute("gradeName", obj.getString("gradeName"));
						sDo.setAttribute("bandName", obj.getString("bandName"));
						sDo.setAttribute("daysRemaining",
								Utils.getDateDiffenenceIncludeLastDay(new Date(), obj.getDate("hireByDate")));
					}
				}
				CustomFieldManager customFieldManager = new CustomFieldManager();
				ArrayList<CustomFieldData> customFields = customFieldManager.getCustomFieldDataForEntity(positionId,
						CustomFieldConstants.ENTITY_TYPE_POSITION);
				sDo.setAttribute("customFields", customFields);
			}
		} catch (Exception e) {
			TPLogger.getLogger().error("Error while getting position description.", e);
		} finally {
			if (dq != null) {
				dq.releaseConnection();
			}
		}
		return sDo;
	}

	public ArrayList<SimpleDataObject> getUsersForRoleForGridDisplay(String roleIds) {
		ArrayList<SimpleDataObject> users = null;
		String[] dynParam = new String[1];
		dynParam[0] = " ";
		DBPreparedQuery dq = null;
		try {
			ArrayList<String> dynamicContent = new ArrayList<String>();
			// if rolesIds is null then populate all users
			if (Utils.isBlankOrNull(roleIds)) {
				dynParam[0] = "";
			} /*
				 * else { dynParam[0] = " and tur.role_id in (" + roleIds + ")";
				 * }
				 */
			else {
				String qMarks = Utils.setDynamicParamsAndReturnQmarks(roleIds, dynamicContent);
				dynParam[0] += " and tur.role_id in (" + qMarks + ") ";
			}
			dq = new DBPreparedQuery("dGetUsersForRoleForGridDisplay", dynParam);
			int cnt = 1;
			for (int i = 0; i < dynamicContent.size(); i++) {
				dq.setString(cnt++, dynamicContent.get(i));
			}
			dq.setInt(cnt++, UserConstants.ACTIVE);
			users = dq.getResult();
		} catch (Exception e) {
			TPLogger.getLogger().error("Error while getting users of role", e);
		} finally {
			if (dq != null) {
				dq.releaseConnection();
			}
		}
		return users;
	}

	public void deleteAllPositionSteps(String positionId, DBTransaction tran) throws Exception {
		DBPreparedQuery dq = null;
		try {
			ArrayList<StepData> hiringSteps = getHiringProcessStepsForPosition(positionId, tran);

			for (StepData stepData : hiringSteps) {
				dq = new DBPreparedQuery("dPositionManager_DeletePositionStep", tran);
				dq.setString(1, PositionConstants.STEP_DELETED);
				dq.setString(2, stepData.getStepId() + "");
				dq.execute();
			}

		} finally {
			if (dq != null) {
				if (tran == null) {
					dq.releaseConnection();
				} else {
					dq.closeOpenCursors();
				}
			}
		}
	}

	public List<SimpleDataObject> getDistinctPositionSteps(FilterData filterData, String userId,
			PermissionSet permissionSet) throws Exception {
		DBPreparedQuery dq = null;
		List<SimpleDataObject> sdoList = null;
		try {
			String[] dynParam = new String[1];
			ArrayList<String> dynamicContent = new ArrayList<String>();
			dynParam[0] = " ";

			dynParam[0] = PositionWithRightsClause.getClauseForStepUserAndRequestedByAndRequisitionApproval(userId,
					"tp.position_id", dynamicContent, permissionSet);
			if (filterData != null) {
				if (filterData.getFilterId().equals(ReportConstants.FILTER_OPEN_POSITIONS)) {
					dynParam[0] += " AND tp.position_status = ? ";
					dynamicContent.add(PositionConstants.POSITION_STATUS_OPENED);
				} else if (filterData.getFilterId().equals(ReportConstants.FILTER_SPECIFIC_POSITION)) {
					dynParam[0] += " AND tp.position_id = ? ";
					dynamicContent.add(filterData.getPositionId());
				} else if (filterData.getFilterId().equals(ReportConstants.FILTER_SPECIFIC_DEPARTMENT)) {
					dynParam[0] += " AND tp.dept_id = ? ";
					dynamicContent.add(filterData.getDepartmentId());
					if (!Utils.isBlankOrNull(filterData.getSubDepartmentId())) {
						dynParam[0] += " AND tp.sub_dept_id = ? ";
						dynamicContent.add(filterData.getSubDepartmentId());
						if (!Utils.isBlankOrNull(filterData.getSubSubDepartmentId())) {
							dynParam[0] += " AND tp.sub_sub_dept_id = ? ";
							dynamicContent.add(filterData.getSubSubDepartmentId());
						}
					}
				}
			} else {
				dynParam[0] += " AND tp.position_status = ? ";
				dynamicContent.add(PositionConstants.POSITION_STATUS_OPENED);
			}

			dq = new DBPreparedQuery("dPositionManager_getDistinctPositionSteps", dynParam);
			int cnt = 1;
			dq.setString(cnt++, "Shortlist");
			dq.setId(cnt++, PositionConstants.STEP_ACTIVE);
			for (int i = 0; i < dynamicContent.size(); i++) {
				dq.setString(cnt++, dynamicContent.get(i));
			}

			dq.setString(cnt++, SelectionProcessConstants.STEP_TITLE_ON_HOLD);
			dq.setString(cnt++, PositionConstants.STEP_LEVEL_JOIN);
			dq.setInt(cnt++, 0);

			dq.setString(cnt++, SelectionProcessConstants.STEP_TITLE_JOINED);
			dq.setString(cnt++, PositionConstants.STEP_LEVEL_JOIN);
			dq.setInt(cnt++, 0);

			dq.setString(cnt++, SelectionProcessConstants.STEP_TITLE_RESCHEDULE);
			dq.setString(cnt++, PositionConstants.STEP_LEVEL_JOIN);
			dq.setInt(cnt++, 0);

			dq.setString(cnt++, SelectionProcessConstants.STEP_TITLE_ATTENDED);
			dq.setString(cnt++, PositionConstants.STEP_LEVEL_JOIN);
			dq.setInt(cnt++, 0);

			dq.setString(cnt++, SelectionProcessConstants.STEP_TITLE_POSITION_CLOSED_REJECT);
			dq.setString(cnt++, PositionConstants.STEP_LEVEL_JOIN);
			dq.setInt(cnt++, 0);

			dq.setString(cnt++, SelectionProcessConstants.STEP_TITLE_BACK_OUT);
			dq.setString(cnt++, PositionConstants.STEP_LEVEL_JOIN);
			dq.setInt(cnt++, 0);

			dq.setString(cnt++, SelectionProcessConstants.STEP_TITLE_REJECT);
			dq.setString(cnt++, PositionConstants.STEP_LEVEL_JOIN);
			dq.setInt(cnt++, 0);

			sdoList = dq.getResult();
		} finally {
			if (dq != null) {
				dq.releaseConnection();
			}
		}
		return sdoList;
	}

