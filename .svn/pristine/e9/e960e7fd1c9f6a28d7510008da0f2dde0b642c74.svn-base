	public void addOrUpdatePositionStep(SimpleDataObject object) throws SQLException, MasterExistException, Exception {
		DBPreparedQuery dq = null;
		DBQuery dbq = null;
		DBTransaction tran = null;
		try {
			if (object.getInt("stepId") != 0) {
				tran = new DBTransaction();
				dq = new DBPreparedQuery("dPositionManager_UpdatePositionStep", tran);

				dq.setString(1, object.getString("stepTitle"));
				dq.setInt(2, object.getInt("stepRank"));
				dq.setString(3, PositionConstants.STEP_ACTIVE);
				dq.setString(4, object.getString("isOptional"));
				dq.setString(5, object.getString("isDefault"));
				dq.setString(6, object.getString("isScheduled"));
				dq.setString(7, object.getString("isInterviewerCanConfirm"));
				dq.setString(8, object.getString("stepLevel"));
				dq.setString(9, object.getString("feedbackFormId"));
				dq.setString(10, object.getString("isDecisionMakerSameAsAssignedTo"));
				dq.setString(11, object.getString("isNotifyToCandidate"));
				if (Utils.isBlankOrNull(object.getString("applicantFeedbackFormId"))) {
					dq.setString(12, null);
				} else {
					dq.setString(12, object.getString("applicantFeedbackFormId"));
				}
				dq.setString(13, object.getString("stepId"));
				dq.execute();
			} else {

				String positionId = object.getString("positionId");
				String stepMasterId = object.getString("stepMasterId");
				if (checkIfStepExists(positionId, stepMasterId)) {
					throw new MasterExistException();
				}

				tran = new DBTransaction();
				dq = new DBPreparedQuery("dPositionManager_AlterPositionStepRank", tran);
				dq.setString(1, object.getString("positionId"));
				dq.setInt(2, object.getInt("stepRank"));
				dq.setString(3, PositionConstants.STEP_ACTIVE);
				dq.setInt(4, PositionConstants.STEP_NOT_DEFAULT);
				dq.execute();

				dq = new DBPreparedQuery("dPositionManager_AddPositionStep", tran);
				dq.setString(1, object.getString("positionId"));
				dq.setString(2, object.getString("stepTitle"));
				dq.setInt(3, object.getInt("stepRank"));
				dq.setString(4, PositionConstants.STEP_ACTIVE);
				dq.setString(5, object.getString("isOptional"));
				dq.setString(6, object.getString("isDefault"));
				dq.setString(7, object.getString("isScheduled"));
				dq.setString(8, object.getString("isInterviewerCanConfirm"));
				dq.setString(9, object.getString("stepLevel"));
				dq.setString(10, object.getString("feedbackFormId"));
				dq.setString(11, object.getString("isDecisionMakerSameAsAssignedTo"));
				dq.setString(12, object.getString("isNotifyToCandidate"));
				dq.setString(13, object.getString("stepMasterId"));
				if (Utils.isBlankOrNull(object.getString("applicantFeedbackFormId"))) {
					dq.setString(14, null);
				} else {
					dq.setString(14, object.getString("applicantFeedbackFormId"));
				}
				dq.execute();

				dbq = new DBQuery("dFetchLastInsertID", tran);

				String stepId = dbq.getIdResult();
				object.setAttribute("stepId", stepId);
			}

			// addOrUpdateStepTraits(tran, object);
			addOrUpdateStatusMessages(tran, object);
			addOrUpdateStepUsers(tran, object);

			ToDoManager toDoManager = new ToDoManager();
			toDoManager.regenerateToDo(object.getString("positionId"), null, tran);

			tran.commit();
		} catch (SQLException e) {
			TPLogger.getLogger().error(GlobalConstants.ERROR, e);
			tran.rollback();
			throw e;
		} catch (MasterExistException e) {
			TPLogger.getLogger().error(GlobalConstants.ERROR, e);
			throw e;
		} finally {
			if (dq != null) {
				dq.releaseTransaction(tran);
			}
			if (dbq != null) {
				dbq.releaseTransaction(tran);
			}
		}
	}

	public boolean checkIfStepExists(String positionId, String stepMasterId) {
		DBPreparedQuery dq = null;
		try {
			dq = new DBPreparedQuery("dPositionManager_CheckDuplicateSteps");
			dq.setString(1, positionId);
			dq.setString(2, stepMasterId);
			dq.setString(3, PositionConstants.STEP_ACTIVE);
			int count = dq.getIntResult();
			if (count > 0) {
				return true;
			}
		} catch (Exception e) {
			TPLogger.getLogger().error("Error While Checking duplicate step", e);
		} finally {
			if (dq != null) {
				dq.releaseConnection();
			}
		}
		return false;
	}

	public void deletePositionStep(String stepId, String stepRank, String positionId) throws Exception {
		DBPreparedQuery dq = null;
		try {
			dq = new DBPreparedQuery("dPositionManager_DeletePositionStep");
			dq.setString(1, PositionConstants.STEP_DELETED);
			dq.setString(2, stepId);
			dq.execute();

			dq = new DBPreparedQuery("dPositionManager_2_AlterPositionStepRank");
			dq.setString(1, positionId);
			dq.setString(2, stepRank);
			dq.setString(3, PositionConstants.STEP_ACTIVE);
			dq.setInt(4, PositionConstants.STEP_NOT_DEFAULT);
			dq.execute();

			ToDoManager toDoManager = new ToDoManager();
			toDoManager.regenerateToDo(positionId, null, null);

		} finally {
			if (dq != null) {
				dq.releaseConnection();
			}
		}
	}

	public void changePositionStepRank(String stepId1, String stepRank1, String stepId2, String stepRank2)
			throws SQLException {
		DBPreparedQuery dq = null;
		DBTransaction tran = null;
		try {
			tran = new DBTransaction();

			dq = new DBPreparedQuery("dPositionManager_ChangeStepRank", tran);
			dq.setString(1, stepRank2);
			dq.setString(2, stepId1);
			dq.execute();

			dq = new DBPreparedQuery("dPositionManager_ChangeStepRank", tran);
			dq.setString(1, stepRank1);
			dq.setString(2, stepId2);
			dq.execute();

			tran.commit();
		} catch (Exception e) {
			TPLogger.getLogger().error(GlobalConstants.ERROR, e);
			tran.rollback();
		} finally {
			if (dq != null) {
				dq.releaseTransaction(tran);
			}
		}
	}

	private void addOrUpdateStatusMessages(DBTransaction tran, SimpleDataObject step) throws SQLException {
		DBPreparedQuery dq = null;
		DBQuery dbq = null;
		try {
			if (step != null) {
				List messages = (List) step.getAttribute("messages");
				if (messages != null && messages.size() > 0) {
					StringBuffer messageIds = new StringBuffer();
					for (int i = 0; i < messages.size(); i++) {
						SimpleDataObject message = (SimpleDataObject) messages.get(i);
						if (message.getInt("messageId") != 0) {
							dq = new DBPreparedQuery("dPositionManager_UpdateStatusMessages", tran);
							dq.setString(1, message.getString("message"));
							dq.setString(2, message.getString("isDefault"));
							dq.setInt(3, (i + 1));
							dq.setString(4, message.getString("messageId"));
							dq.execute();

							appendStrings(messageIds, message.getString("messageId"));
						} else {
							dq = new DBPreparedQuery("dPositionManager_InsertStatusMessages", tran);
							dq.setString(1, step.getString("stepId"));
							dq.setString(2, message.getString("message"));
							dq.setString(3, message.getString("isDefault"));
							dq.setInt(4, (i + 1));
							dq.execute();

							dbq = new DBQuery("dFetchLastInsertID", tran);
							appendStrings(messageIds, dbq.getIdResult());
						}
					}
					String[] dynParam = new String[1];
					dynParam[0] = messageIds.toString();
					dq = new DBPreparedQuery("dPositionManager_DeleteStatusMessages", dynParam, tran);
					dq.setString(1, step.getString("stepId"));
					dq.execute();
				}
			}
		} finally {
			if (dq != null) {
				dq.closeOpenCursors();
			}
			if (dbq != null) {
				dbq.closeOpenCursors();
			}
		}
	}

	/**
	 * Method to update the step users either responsible to carry out the step
	 * or to schedule.
	 * 
	 * @param object
	 *            The object of type StepData.
	 * @throws SQLException
	 */
	private void addOrUpdateStepUsers(DBTransaction tran, SimpleDataObject object) throws Exception {
		// Delete deselected users
		deleteDeselectedUsers(object.getString("positionId"), object.getString("stepId"),
				PositionConstants.STEP_NOT_SCHEDULED, PositionConstants.NOT_AUTHORIZED_TO_MOVE,
				object.getString("assignedTo"), tran);

		deleteDeselectedUsers(object.getString("positionId"), object.getString("stepId"),
				PositionConstants.STEP_SCHEDULED, PositionConstants.NOT_AUTHORIZED_TO_MOVE,
				object.getString("scheduledBy"), tran);

		deleteDeselectedUsers(object.getString("positionId"), object.getString("stepId"),
				PositionConstants.STEP_NOT_SCHEDULED, PositionConstants.AUTHORIZED_TO_MOVE,
				object.getString("decisionMaker"), tran);

		// Update assignedTo users.
		String assignedTo = object.getString("assignedTo");
		updateSelectedUsers(object.getString("positionId"), object.getString("stepId"),
				PositionConstants.STEP_NOT_SCHEDULED, PositionConstants.NOT_AUTHORIZED_TO_MOVE, assignedTo, tran);

		// Update scheduledBy users.
		String scheduledBy = object.getString("scheduledBy");
		updateSelectedUsers(object.getString("positionId"), object.getString("stepId"),
				PositionConstants.STEP_SCHEDULED, PositionConstants.NOT_AUTHORIZED_TO_MOVE, scheduledBy, tran);

		// Update decision maker users.
		String decisionMaker = object.getString("decisionMaker");
		updateSelectedUsers(object.getString("positionId"), object.getString("stepId"),
				PositionConstants.STEP_NOT_SCHEDULED, PositionConstants.AUTHORIZED_TO_MOVE, decisionMaker, tran);

		ToDoManager toDoManager = new ToDoManager();
		toDoManager.regenerateToDo(object.getString("positionId"), null, tran);
	}

	private void deleteDeselectedUsers(String positionId, String stepId, int isScheduled, int isAuthorizedToMove,
			String userIds, DBTransaction tran) throws SQLException {
		DBPreparedQuery dq = null;
		try {
			dq = new DBPreparedQuery("dPositionManager_DeletePositionStepUsers", tran);
			dq.setString(1, positionId);
			dq.setString(2, stepId);
			dq.setInt(3, isScheduled);
			dq.setInt(4, isAuthorizedToMove);
			dq.setString(5, userIds);
			dq.execute();
		} finally {
			if (dq != null) {
				dq.closeOpenCursors();
			}
		}
	}

	private void updateSelectedUsers(String positionId, String stepId, int isScheduled, int isAuthorizedToMove,
			String userIds, DBTransaction tran) throws SQLException {
		DBPreparedQuery dq = null;
		try {
			if (userIds != null && userIds.length() > 0 && !userIds.equalsIgnoreCase("null")) {
				String[] users = userIds.split(",");
				for (int i = 0; i < users.length; i++) {
					dq = new DBPreparedQuery("dPositionManager_AddOrUpdatePositionStepUsers", tran);
					dq.setString(1, positionId);
					dq.setString(2, stepId);
					dq.setString(3, users[i]);
					dq.setInt(4, isScheduled);
					dq.setInt(5, isAuthorizedToMove);
					dq.execute();
				}
			}
		} finally {
			if (dq != null) {
				dq.closeOpenCursors();
			}
		}
	}

