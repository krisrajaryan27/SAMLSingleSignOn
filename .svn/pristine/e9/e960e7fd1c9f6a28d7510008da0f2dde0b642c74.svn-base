	/**
	 * returns list of responsibilities for given positionId
	 * 
	 * @param positionId
	 * @return
	 */
	public String getResponisbilities(String positionId) {
		DBPreparedQuery dq = null;
		// ArrayList respons = null;
		String responsibilities = "";
		try {
			dq = new DBPreparedQuery("dGetResp");
			dq.setId(1, positionId);
			responsibilities = dq.getStringResult();
		} catch (SQLException e) {
			TPLogger.getLogger().error("Error While Getting Responsibilities ", e);
		} finally {
			if (dq != null) {
				dq.releaseConnection();
			}
		}
		return responsibilities;

	}

	/**
	 * Construct and return XML string for responsibilities Method to get Resp
	 * in XML format(Ajax)
	 * 
	 * @param respons
	 * @return
	 */
	public String getXMLforResp(String respons) {
		StringWriter sWr = new StringWriter();
		XMLWriter wr = new XMLWriter(sWr);

		try {
			wr.startDocument();
			wr.startElement("Responsibilities");

			if (Utils.isBlankOrNull(respons)) {
				respons = "&nbsp;";
			}
			wr.characters(respons);

			wr.endElement("Responsibilities");
			wr.endDocument();

		} catch (SAXException e) {
			TPLogger.getLogger().error("error while creating xml file for responsibilities", e);
		}
		return sWr.getBuffer().toString();
	}

