	/**
	 * copy all steps excluding default step from srcPositionId to
	 * destPositionId
	 * 
	 * @param srcPositionId
	 * @param destPositionId
	 */
	public void copySteps(String srcPositionId, String destPositionId) {
		DBPreparedQuery dq = null;
		DBTransaction tran = null;
		try {
			tran = new DBTransaction();

			deleteAllPositionSteps(destPositionId, tran);

			ArrayList<StepData> steps = getHiringProcessStepsForPosition(srcPositionId, tran);
			for (int i = 0; steps != null && i < steps.size(); i++) {
				StepData stepData = steps.get(i);
				dq = new DBPreparedQuery("dPositionManager_CopyPositionStep", tran);
				dq.setId(1, destPositionId);
				dq.setInt(2, stepData.getStepId());
				dq.execute();
				dq = new DBPreparedQuery("dFetchLastInsertID", tran);
				String stepId = dq.getIdResult();

				dq = new DBPreparedQuery("dPositionManager_CopyPositionStepUsers", tran);
				dq.setId(1, destPositionId);
				dq.setId(2, stepId);
				dq.setInt(3, stepData.getStepId());
				dq.execute();

				dq = new DBPreparedQuery("dPositionManager_CopyPositionStepStatusMessages", tran);
				dq.setId(1, stepId);
				dq.setInt(2, stepData.getStepId());
				dq.execute();
			}
			tran.commit();
		} catch (Exception e) {
			TPLogger.getLogger().error(GlobalConstants.ERROR, e);
			try {
				tran.rollback();
			} catch (Exception re) {
				TPLogger.getLogger().error(GlobalConstants.ERROR, e);
			}
		} finally {
			if (dq != null) {
				dq.releaseTransaction(tran);
			}
		}
	}

	public ArrayList<StepData> getHiringProcessStepsForPosition(String positionId, DBTransaction tran)
			throws Exception {
		DBPreparedQuery dq = null;
		ArrayList<StepData> steps = null;
		try {
			if (tran != null) {
				dq = new DBPreparedQuery("dPositionManager_GetStepsForPosition", tran);
			} else {
				dq = new DBPreparedQuery("dPositionManager_GetStepsForPosition");
			}
			dq.setString(1, "" + PositionConstants.STEP_NOT_DEFAULT);
			dq.setId(2, PositionConstants.STEP_ACTIVE);
			dq.setString(3, positionId);
			steps = dq.getResult();

		} catch (Exception e) {
			TPLogger.getLogger().error("Error in copying position steps", e);
			throw e;
		} finally {
			if (dq != null) {
				if (tran == null) {
					dq.releaseConnection();
				} else {
					dq.closeOpenCursors();
				}
			}
		}
		return steps;
	}

