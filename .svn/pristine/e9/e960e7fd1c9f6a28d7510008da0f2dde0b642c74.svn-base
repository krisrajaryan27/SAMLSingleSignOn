		return maxExp;
	}

	private String getNaukriLocation(String loc) {
		String location = "-1";
		DBPreparedQuery dq = null;
		try {
			dq = new DBPreparedQuery("dMastersManager_GetNaukriLocationByName");
			dq.setString(1, loc);
			String l = dq.getStringResult();
			if (!Utils.isBlankOrNull(l)) {
				location = l;
			}
		} catch (Exception e) {
			TPLogger.getLogger().error("Error while getting Naukri Location", e);
		} finally {
			if (dq != null) {
				dq.closeOpenCursors();
			}
		}

		return location;
	}

	private String getNaukriUGBranch(String specializationName, String ugDegrees) {
		String result = "-1";
		DBPreparedQuery dq = null;
		try {
			String[] dynParams = new String[4];
			for (int i = 0; i < 4; i++) {
				dynParams[i] = ugDegrees;
			}

			int cnt = 1;
			dq = new DBPreparedQuery("dMastersManager_GetNaukriUGDBranchByName", dynParams);
			dq.setString(cnt++, specializationName);
			dq.setString(cnt++, specializationName);
			dq.setString(cnt++, specializationName);
			String l = dq.getStringResult();
			if (!Utils.isBlankOrNull(l)) {
				result = l;
			}
		} catch (Exception e) {
			TPLogger.getLogger().error("Error while getting Naukri Location", e);
		} finally {
			if (dq != null) {
				dq.closeOpenCursors();
			}
		}
		return result;
	}

