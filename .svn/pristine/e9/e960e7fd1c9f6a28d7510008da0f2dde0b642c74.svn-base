	public void updatePositionsPublished(String selectedPositions, String deselectedPositions, String publishType)
			throws SQLException {
		DBPreparedQuery dq1 = null;
		DBPreparedQuery dq2 = null;
		DBTransaction tran = null;
		String[] dynParam1 = new String[2];
		String[] dynParam2 = new String[2];

		try {
			tran = new DBTransaction();

			if (publishType.equals(PositionConstants.PUBLISH_WALK_IN)) {
				dynParam1[0] = " is_published_for_walk_in = " + PositionConstants.POSITION_PUBLISHED_FOR_WALK_IN;
			} else if (publishType.equals(PositionConstants.PUBLISH_EMPLOYEE_PORTAL)) {
				dynParam1[0] = " is_published_for_emp_portal = "
						+ PositionConstants.POSITION_PUBLISHED_FOR_EMPLOYEE_PORTAL + ",position_publish_date = now()";
			}

			if (!Utils.isBlankOrNull(selectedPositions)) {
				dynParam1[1] = selectedPositions;
			} else {
				dynParam1[1] = "0";
			}

			dq1 = new DBPreparedQuery("dPositionManager_UpdatePositionPublishedForWalkInField", dynParam1, tran);
			dq1.execute();

			if (publishType.equals(PositionConstants.PUBLISH_WALK_IN)) {
				dynParam2[0] = " is_published_for_walk_in = " + PositionConstants.POSITION_NOT_PUBLISHED_FOR_WALK_IN;
			} else if (publishType.equals(PositionConstants.PUBLISH_EMPLOYEE_PORTAL)) {
				dynParam2[0] = " is_published_for_emp_portal = "
						+ PositionConstants.POSITION_NOT_PUBLISHED_FOR_EMPLOYEE_PORTAL
						+ ",position_publish_date = now()";
			}
			if (!Utils.isBlankOrNull(deselectedPositions)) {
				dynParam2[1] = deselectedPositions;
			} else {
				dynParam2[1] = "0";
			}
			dq2 = new DBPreparedQuery("dPositionManager_UpdatePositionPublishedForWalkInField", dynParam2, tran);
			dq2.execute();
		} catch (SQLException e) {
			TPLogger.getLogger().error("Error while updating flag for positions published for walk in", e);
			try {
				tran.rollback();
			} catch (SQLException ex) {
				TPLogger.getLogger().error(
						"Error while rolling back transaction for updating flag for positions published for walk in",
						ex);
			}
			throw e;
		} finally {
			if (dq1 != null) {
				dq1.releaseTransaction(tran);
			}
			if (dq2 != null) {
				dq2.releaseTransaction(tran);
			}
		}
	}

	public void updatePositionsPublished(String positionId, String publishOrUnpublish, String publishType,
			String publishFromDate, String publishToDate, String employeeApplyRefer, String employeeCanEmail)
			throws SQLException {

		DBPreparedQuery dq = null;
		String[] dynParam = new String[1];
		StringBuffer sb = new StringBuffer();
		int cnt = 1;
		try {

			if (publishType.equals(PositionConstants.PUBLISH_WALK_IN)) {
				sb.append(" is_published_for_walk_in = ?").append(",walk_in_publish_from_date = ?")
						.append(",walk_in_publish_to_date = ?");
			} else if (publishType.equals(PositionConstants.PUBLISH_EMPLOYEE_PORTAL)) {
				sb.append(" is_published_for_emp_portal = ?").append(",employee_publish_from_date = ?")
						.append(",employee_publish_to_date = ?").append(",position_publish_date = now()")
						.append(",employee_apply_refer = ?").append(",employee_can_email = ?");
			} else if (publishType.equals(PositionConstants.NAUKRI_PORTAL)) {
				sb.append("is_published_to_naukri = ?");
			}

			dynParam[0] = sb.toString();

			dq = new DBPreparedQuery("dPositionManager_UpdatePositionPublishDetails", dynParam);

			dq.setId(cnt++, publishOrUnpublish);

			if (!Utils.isBlankOrNull(publishFromDate))
				dq.setTimestamp(cnt++, new Timestamp(
						Utils.convertToDate(publishFromDate + " 00:00:00", Utils.regDDMMYYYYHHMMSSFromat).getTime()));
			else if (!publishType.equals(PositionConstants.NAUKRI_PORTAL))
				dq.setDate(cnt++, null);

			if (!Utils.isBlankOrNull(publishToDate))
				dq.setTimestamp(cnt++, new Timestamp(
						Utils.convertToDate(publishToDate + " 23:59:59", Utils.regDDMMYYYYHHMMSSFromat).getTime()));
			else if (!publishType.equals(PositionConstants.NAUKRI_PORTAL))
				dq.setDate(cnt++, null);

			if (publishType.equals(PositionConstants.PUBLISH_EMPLOYEE_PORTAL)) {
				if (!(GlobalApplicationProperties.getProperty(GlobalConstants.PROPERTY_EMPLOYEE_CAN_APPLY_FOR_JOB))
						.equals("1")) {
					employeeApplyRefer = PositionConstants.POSITIONS_EMPLOYEE_APPLY_REFER;
				}
				dq.setId(cnt++, employeeApplyRefer);
				dq.setId(cnt++, employeeCanEmail);
			}

			dq.setId(cnt++, positionId);

			dq.execute();

		} catch (SQLException e) {
			TPLogger.getLogger().error("Error while updating publishing detials for a position", e);
			throw e;
		} finally {
			if (dq != null) {
				dq.releaseTransaction(null);
			}
		}
	}

