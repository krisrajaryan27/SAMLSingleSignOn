			deleteRuleInstitutes(positionId, tran);
			deletePositionRule(positionId, tran);
			updatePublishToWebsite(positionId, PositionConstants.POSITION_NOT_PUBLISHED_TO_WEBSITE, tran,
					publishFromDate, publishToDate);
			tran.commit();
		} catch (Exception e) {
			TPLogger.getLogger().error("Error while updating the position is publishe to site flag", e);
			tran.rollback();
			throw e;
		} finally {
			if (tran != null) {
				tran.release();
			}
		}
	}

	public void updatePositionRule(String positionId, PositionData data, PositionData formData,
			ArrayList<String> instituteIds) throws Exception {
		DBTransaction tran = null;
		DBPreparedQuery dq = null;
		String ruleId = null;
		try {
			tran = new DBTransaction();
			// Delete position vendors if any.

			deleteRuleInstitutes(positionId, tran);

			deletePositionRule(positionId, tran);
			// insert publish rule to site
			dq = new DBPreparedQuery("dPositionManager_InsertPositionRule", tran);
			dq.setString(1, formData.getRuleText());
			dq.setId(2, positionId);
			if (formData.getDegreeId() > 0) {
				dq.setId(3, "" + formData.getDegreeId());
			} else {
				dq.setId(3, null);
			}
			if (formData.getBranchId() > 0) {
				dq.setId(4, "" + formData.getBranchId());
			} else {
				dq.setId(4, null);
			}
			if (formData.getMinExperience() >= 0) {
				dq.setString(5, "" + formData.getMinExperience());
			} else {
				dq.setString(5, null);
			}
			if (formData.getMaxExperience() > 0) {
				dq.setString(6, "" + formData.getMaxExperience());
			} else {
				dq.setString(6, null);
			}

			// dq.setId(7, form.getInstituteId());
			dq.setString(7, formData.getLocationName());
			dq.execute();

			// insert multiple institutes in rule
			dq = new DBPreparedQuery("dFetchLastInsertID", tran);
			ruleId = dq.getIdResult();

			if (instituteIds != null && instituteIds.size() > 0) {
				Object[] array = instituteIds.toArray();
				for (int i = 0; i < array.length; i++) {
					dq = new DBPreparedQuery("dPositionManager_InsertdPositionRuleInstitutes", tran);
					dq.setId(1, ruleId);
					dq.setId(2, array[i].toString());
					dq.execute();
				}
			}

			updatePublishToWebsite(positionId, data.getPublishToSite(), tran, data.getStringWebSitePublishFromDate(),
					data.geStringWebSitePublishToDate());
			tran.commit();
		} catch (Exception e) {
			TPLogger.getLogger().error("Error while updating the position rule", e);
			tran.rollback();
			throw e;
		} finally {
			if (tran != null) {
				tran.release();
			}
		}
	}

	public String updatePositionNaukriStatus(String positionId, boolean positionDeletionFlag) throws Exception {
		String error = "";
		DBPreparedQuery dq = null;
		try {
			// String positionId = form.getPositionId();
			// API calls
			SimpleDataObject sdo = (SimpleDataObject) getPositionDescriptionToEdit(positionId);
			SimpleDataObject requirements = (SimpleDataObject) getPositionRequirementsToEdit(positionId);

			JobPositionPostings jobPositionPostings = new JobPositionPostings();

			jobPositionPostings.setJobFeedResponseEmail(sdo.getString("jobFeedResponseEmail"));

			JobPositionPosting jobPositionPosting = new JobPositionPosting();

			if ("1".equals(sdo.getString("isNaukriPublished"))) {
				jobPositionPosting.setJobAction("DELETE");
				updatePositionsPublished(positionId, PositionConstants.UNPUBLISHED, PositionConstants.NAUKRI_PORTAL,
						null, null, PositionConstants.POSITIONS_EMPLOYEE_APPLY_REFER, GlobalConstants.DISABLED);
			} else {
				if (positionDeletionFlag) {
					throw new Exception("Skipping to delete position info from naukri as its already removed");
				}
				jobPositionPosting.setJobAction("ADD");
			}
			jobPositionPosting.setJobType("h");
			jobPositionPosting.setJobPositionPostingID(positionId);

			HiringOrg hiringOrg = new HiringOrg();
			hiringOrg.setWebSite(GlobalApplicationProperties.getProperty(GlobalConstants.PROPERTY_HIRING_ORG_WEBSITE));
			hiringOrg.setHiringOrgName(
					GlobalApplicationProperties.getProperty(GlobalConstants.PROPERTY_HIRING_ORG_NAME));

			Industry industry = new Industry();
			industry.setSummaryText(GlobalApplicationProperties.getProperty(GlobalConstants.PROPERTY_ORG_DESCRIPTION));

			Contact contact = new Contact();

			PersonName pname = new PersonName();
			contact.setPersonName(pname);
			pname.setFormattedName(sdo.getString("contactPersonName"));
			contact.setPersonName(pname);

			hiringOrg.setIndustry(industry);
			hiringOrg.setContact(contact);

			jobPositionPosting.setHiringOrg(hiringOrg);

			JobDisplayOptions options = new JobDisplayOptions();
			options.setMicrositeName(GlobalApplicationProperties.getProperty(GlobalConstants.PROPERTY_MICROSITE_NAME));
			options.setTemplateName(GlobalApplicationProperties.getProperty(GlobalConstants.PROPERTY_TEMPLATE_NAME));

			jobPositionPosting.setJobDisplayOptions(options);

			JobPositionInformation jobPositionInformation = new JobPositionInformation();
			jobPositionInformation.setJobPositionTitle(sdo.getString("positionName"));

			JobClassifications jobClassifications = new JobClassifications();

			PrimaryJobCategory primaryJobCategory = new PrimaryJobCategory();
			primaryJobCategory.setJobIndustryCode(sdo.getString("jobIndustryCode"));
			primaryJobCategory.setJobFunctionCode(sdo.getString("jobFunctionCode"));
			primaryJobCategory.setJobRoleCode(sdo.getString("jobRoleCode"));

			jobClassifications.setPrimaryJobCategory(primaryJobCategory);
			jobPositionInformation.setJobClassifications(jobClassifications);

			JobPositionDescription jobPositionDescription = new JobPositionDescription();
			jobPositionDescription.setJobKeywords(sdo.getString("jobKeywords"));

			JobPositionLocation jobPositionLocation = new JobPositionLocation();

			if ("-1".equals(sdo.getString("country")) || Utils.isBlankOrNull(sdo.getString("country"))) {
				String locationId = sdo.getString("locationId");
				String[] locations = locationId.split(",");
				String knownLocations = "";
				String otherLocations = "";
				for (int i = 0; i < locations.length; i++) {
					LocationManager locationManager = new LocationManager();
					String locationName = locationManager.getLocationByLocationId(locations[i]).getLocationName();
					String location = getNaukriLocation(locationName);
					if ("-1".equals(location)) {
						if (Utils.isBlankOrNull(otherLocations)) {
							otherLocations = locationName;
						} else {
							otherLocations = otherLocations + "," + locationName;
						}
					} else {
						if (Utils.isBlankOrNull(otherLocations)) {
							knownLocations = location;
						} else {
							knownLocations = knownLocations + "," + location;
						}
					}
				}
				if (Utils.isBlankOrNull(knownLocations)) {
					jobPositionLocation.setIndianLoc("50.50.50");
					jobPositionLocation.setIndianLocOther(otherLocations);
				} else {
					jobPositionLocation.setIndianLoc(knownLocations);
					jobPositionLocation.setIndianLocOther(otherLocations);
				}
			} else {
				jobPositionLocation.setInterNationalLoc(sdo.getString("country"));
			}

			jobPositionDescription.setJobPositionLocation(jobPositionLocation);

			CompensationDescription compensationDescription = new CompensationDescription();
			compensationDescription.setBenifitsDescription(sdo.getString("benefitsDescription"));

			Pay pay = new Pay();
			pay.setDisplaySalary(sdo.getString("displaySalary"));
			pay.setMaximumSalary(sdo.getString("maximumSalary"));
			pay.setMinimumSalary(sdo.getString("minimumSalary"));
			pay.setSalaryCurrency(sdo.getString("salaryCurrency"));

			compensationDescription.setPay(pay);
			jobPositionDescription.setCompensationDescription(compensationDescription);
			jobPositionDescription.setSummaryText(Utils.getTextContentFromHTML(sdo.getString("responsibilities")));

			jobPositionInformation.setJobPositionDescription(jobPositionDescription);

			JobPositionRequirements jobPositionRequirements = new JobPositionRequirements();
			jobPositionRequirements
					.setSummaryText(Utils.getTextContentFromHTML(sdo.getString("desiredCandidateSummaryText")));

			JobExperience jobExperience = new JobExperience();
			String maxExp = getMaxExperienceForMinExpForNaukri(requirements.getString("minimumExperience"));
			String minExp = "" + (int) Float.parseFloat(requirements.getString("minimumExperience"));
			String requirementMaxExp = "" + (int) Float.parseFloat(requirements.getString("maximumExperience"));
			int maxExpRange = (int) Float.parseFloat(maxExp);
			int originalMaxExp = (int) Float.parseFloat(requirements.getString("maximumExperience"));
			if (maxExpRange >= originalMaxExp) {
				jobExperience.setMaximumExperience(requirementMaxExp);
			} else {
				jobExperience.setMaximumExperience(maxExp);
			}

			jobExperience.setMinimumExperience(minExp);

			jobPositionRequirements.setJobExperience(jobExperience);

			String qualifications = requirements.getString("degreeId");
			String branches = requirements.getString("branchId");

			String ugQualifications = "";
			String pgQualifications = "";
			String ugBranches = "";
			String pgBranches = "";

			if (!Utils.isBlankOrNull(qualifications)) {
				String[] degrees = qualifications.split(",");

				for (int i = 0; i < degrees.length; i++) {
					MastersManager mastersManager = new MastersManager();
					ArrayList source = mastersManager.getDegreesWithAliases(degrees[i]);
					for (int j = 0; j < source.size(); j++) {
						DegreeData data = (DegreeData) source.get(j);
						String degType = data.getDegreeType();
						String degreeName = data.getItemName();

						String naukriDegreeId = getNaukriDegree(degreeName, degType);

						if ("-1".equals(naukriDegreeId)) {
							ArrayList aliases = data.getAliases();
							if (aliases != null && aliases.size() > 0) {
								for (int k = 0; k < aliases.size(); k++) {
									AliasData aliasData = (AliasData) aliases.get(k);
									naukriDegreeId = getNaukriDegree(aliasData.getAlias(), degType);
									if (!"-1".equals(naukriDegreeId)) {
										break;
									}
								}
							}
						}

						if (!"-1".equals(naukriDegreeId)) {
							if (DegreeConstants.TYPE_UG.equals(degType)) {
								if (Utils.isBlankOrNull(ugQualifications)) {
									ugQualifications = naukriDegreeId;
								} else {
									ugQualifications = ugQualifications + "," + naukriDegreeId;
								}
							}
							if (DegreeConstants.TYPE_PG.equals(degType)) {
								if (Utils.isBlankOrNull(pgQualifications)) {
									pgQualifications = naukriDegreeId;
								} else {
									pgQualifications = pgQualifications + "," + naukriDegreeId;
								}

							}
						}
					}
				}
			}

			if (!Utils.isBlankOrNull(branches)) {
				String[] specializations = branches.split(",");
				for (int i = 0; i < specializations.length; i++) {
					MastersManager mastersManager = new MastersManager();
					ArrayList source = mastersManager.getBranchesWithAliases(specializations[i]);
					for (int j = 0; j < source.size(); j++) {
						BranchesData data = (BranchesData) source.get(j);
						String degreeName = data.getItemName();

						String naukriUGBranchId = getNaukriUGBranch(degreeName, ugQualifications);
						String naukriPGBranchId = getNaukriUGBranch(degreeName, ugQualifications);
						// String naukriPPGBranchId =
						// getNaukriPPGBranch(degreeName, ppgQualifications);

						if ("-1".equals(naukriUGBranchId)) {
							ArrayList aliases = data.getAliases();
							if (aliases != null && aliases.size() > 0) {
								for (int k = 0; k < aliases.size(); k++) {
									AliasData aliasData = (AliasData) aliases.get(k);
									naukriUGBranchId = getNaukriUGBranch(aliasData.getAlias(), ugQualifications);
									if (!"-1".equals(naukriUGBranchId)) {
										break;
									}
								}
							}
						}
						if ("-1".equals(naukriPGBranchId)) {
							ArrayList aliases = data.getAliases();
							if (aliases != null && aliases.size() > 0) {
								for (int k = 0; k < aliases.size(); k++) {
									AliasData aliasData = (AliasData) aliases.get(k);
									naukriPGBranchId = getNaukriPGBranch(aliasData.getAlias(), ugQualifications);
									if (!"-1".equals(naukriPGBranchId)) {
										break;
									}
								}
							}
						}

						if (!"-1".equals(naukriUGBranchId)) {
							if (Utils.isBlankOrNull(ugBranches)) {
								ugBranches = naukriUGBranchId;
							} else {
								ugBranches = ugBranches + "," + naukriUGBranchId;
							}
						}
						if (!"-1".equals(naukriPGBranchId)) {
							if (Utils.isBlankOrNull(pgBranches)) {
								pgBranches = naukriPGBranchId;
							} else {
								pgBranches = pgBranches + "," + naukriPGBranchId;
							}

						}
					}
				}
			}

			JobQualifications jobQualifications = new JobQualifications();
			jobQualifications.setUGQualifications("");
			jobQualifications.setUGSpecializations("");
			jobQualifications.setPGQualifications("15");
			jobQualifications.setPGSpecializations("119");
			jobPositionRequirements.setJobQualifications(jobQualifications);

			jobPositionInformation.setJobPositionRequirements(jobPositionRequirements);

			jobPositionPosting.setJobPositionInformation(jobPositionInformation);

			HowToApply howToApply = new HowToApply();
			ApplicationMethods applicationMethods = new ApplicationMethods();
			ByEmail byEmail = new ByEmail();
			byEmail.setEMail(sdo.getString("contactPersonEmail"));
			ByWeb byWeb = new ByWeb();
			byWeb.setURL(TPApplicationProperties.getProperty("naukri.positionposting.url") + positionId);
			byWeb.setAPPLYINTEGRATION("1");
			applicationMethods.setByEmail(byEmail);
			applicationMethods.setByWeb(byWeb);
			howToApply.setApplicationMethods(applicationMethods);
			jobPositionPosting.setHowToApply(howToApply);

			jobPositionPostings.setJobPositionPosting(jobPositionPosting);
			String result = PositionJobPortalUtils.postOnNaukri(jobPositionPostings);

			if (!result.contains("Error code")) {

				dq = new DBPreparedQuery("dPositionManager_UpdatePositionNaukriStatus");
				if ("1".equals(sdo.getString("isNaukriPublished"))) {
					dq.setString(1, "0");
				} else {
					dq.setString(1, "1");
				}
				dq.setString(2, positionId);
				dq.execute();
			} else {
				error = result.substring(result.indexOf("<Error code"), result.lastIndexOf("</Error>"));
			}
		} catch (Exception e) {
			TPLogger.getLogger().error("Error while updating the position rule", e);
			// throw e;
		} finally {
			if (dq != null) {
				dq.closeOpenCursors();
			}
		}
		return error;
	}

