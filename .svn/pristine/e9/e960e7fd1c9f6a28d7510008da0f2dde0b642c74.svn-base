	// TODO : While publishing a position to any social network -
	// 1. We can first check if that position is already published on TW
	// 2. If already published, then no action needed
	// 3. If not published, we need to show a confirmation message to user
	// stating that
	// the position needs to be published on TW first if they need to give
	// 'Apply' option
	// else position can be published without the link to apply
	// 4. If user doesn't accept for auto-publish to TW, publish to social
	// without apply-link
	// 5. If user accepts, need to call PositionAction::publishPositionToSite()

	/**
	 * @param userId
	 * @param permissionSet
	 * @param positionId
	 * @return
	 */
	public boolean isPositionPublishedToWebsite(String userId, PermissionSet permissionSet, String positionId) {
		boolean isPositionPublishedToSite = false;
		try {
			ArrayList<PositionData> positionDatas = (ArrayList<PositionData>) getAllPositionsToPublishToSite(userId,
					permissionSet);
			for (PositionData positionData : positionDatas) {
				if (positionData.getPositionId().equals(positionId)) {
					if (PositionConstants.POSITION_PUBLISHED_TO_WEBSITE.equals(positionData.getPublishToSite())) {
						isPositionPublishedToSite = true;
					}
					break;
				}
			}
		} catch (SQLException e) {
			e.printStackTrace();
		}
		return isPositionPublishedToSite;
	}

