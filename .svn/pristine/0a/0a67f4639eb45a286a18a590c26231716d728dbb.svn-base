	public Date getConvertedFromDate() {
		return Utils.convertToSQLDate(fromDate, Utils.regEUDateFormat);
	}

	public Date getConvertedToDate() {
		return Utils.convertToSQLDate(toDate, Utils.regEUDateFormat);
	}

	public Date getConvertedFromDateMonthly() {
		String fDate = "01/" + getFromMonth() + "/" + getFromYear();
		return Utils.convertToSQLDate(fDate, Utils.regEUDateFormat);
	}

	public Date getConvertedToDateMonthly() {
		
		Calendar calendar = Calendar.getInstance();
		calendar.set(Integer.parseInt(getToYear()), Integer.parseInt(getToMonth())-1, 1);
		String tDate = calendar.getActualMaximum(Calendar.DAY_OF_MONTH)+"/" + getToMonth()+ "/" + getToYear();
		return Utils.convertToSQLDate(tDate, Utils.regEUDateFormat);
	}

