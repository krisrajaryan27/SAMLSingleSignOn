	/**
	 * @return the stagesText.
	 */
	public String getStagesText() {
		StringBuffer stagesText = new StringBuffer();
		if (Utils.isBlankOrNull(getStages())) {
			stagesText.append("All");
		} else {
			String[] parts = getStages().split(",");
			for (int i = 0; i < parts.length; i++) {
				if (stagesText.length() > 0) {
					stagesText.append(", ");
				}
				if (PositionConstants.STEP_LEVEL_SELECT.equalsIgnoreCase(parts[i].trim())) {
					stagesText.append("Select");
				} else if (PositionConstants.STEP_LEVEL_ACCEPT.equalsIgnoreCase(parts[i].trim())) {
					stagesText.append("Hire");
				} else if (PositionConstants.STEP_LEVEL_IMPORT.equalsIgnoreCase(parts[i].trim())) {
					stagesText.append("Import");
				}
			}
		}
		return stagesText.toString();
	}
	
	/**
	 * @return the searchInText
	 */
	public String getSearchInText() {
		StringBuffer searchInText = new StringBuffer();
		PositionManager positionManager = new PositionManager();
		searchInText.append("Positions: ");
		if(Utils.isBlankOrNull(getPositionFilter())){
			if (ReportConstants.FILTER_ALL_POSITIONS.equalsIgnoreCase(getFilterId())) {
				searchInText.append("All Positions");
			} else if (ReportConstants.FILTER_OPEN_POSITIONS.equalsIgnoreCase(getFilterId())) {
				searchInText.append("Open Positions");
			} else if (ReportConstants.FILTER_OPEN_AND_ONHOLD_POSITIONS.equalsIgnoreCase(getFilterId())) {
				searchInText.append("Open and Onhold Positions");
			} else if (ReportConstants.FILTER_SPECIFIC_POSITION.equalsIgnoreCase(getFilterId())) { 
				searchInText.append(positionManager.getPositionName(getPositionId()));
			} 
		}else {
			if (ReportConstants.FILTER_ALL_POSITIONS.equalsIgnoreCase(getPositionFilter())) {
				searchInText.append("All Positions");
			} else if (ReportConstants.FILTER_OPEN_POSITIONS.equalsIgnoreCase(getPositionFilter())) {
				searchInText.append("Open Positions");
			} else if (ReportConstants.FILTER_OPEN_AND_ONHOLD_POSITIONS.equalsIgnoreCase(getPositionFilter())) {
				searchInText.append("Open and Onhold Positions");
			} else if (ReportConstants.FILTER_SPECIFIC_POSITION.equalsIgnoreCase(getPositionFilter())) {
				String[] positionIds = getPositionId().split(",");
				for(String positionId : positionIds) {
					if(!Utils.isBlankOrNull(searchInText.toString())) {
						searchInText.append(",");
					}
					searchInText.append(positionManager.getPositionName(positionId));
				}	
			}
		}
		searchInText.append("  |  ");
		
		if(Utils.isBlankOrNull(getDepartmentFilter())){
			if (ReportConstants.FILTER_SPECIFIC_DEPARTMENT.equalsIgnoreCase(getFilterId()) && !Utils.isBlankOrNull(getDepartmentId())) {
				searchInText.append("Departments:");
				searchInText.append(positionManager.getDeptName(getDepartmentId()));
				if(!Utils.isBlankOrNull(getSubDepartmentId())){
					searchInText.append(", " + positionManager.getDeptName(getSubDepartmentId()));
					if(!Utils.isBlankOrNull(getSubSubDepartmentId())){
						searchInText.append(", " + positionManager.getDeptName(getSubSubDepartmentId()));
					}
				}
			}
		}else{
			if (ReportConstants.FILTER_ALL_DEPARTMENTS.equalsIgnoreCase(getDepartmentFilter())) {
				searchInText.append("All Departments");
			} else if (ReportConstants.FILTER_SPECIFIC_DEPARTMENT.equalsIgnoreCase(getDepartmentFilter())) {
				String[] departmentIds = getDepartmentId().split(",");
				searchInText.append("Departments:");				
				for(String departmentId : departmentIds) {
					String [] temp = searchInText.toString().split("\\|");
					if(!temp[1].trim().equalsIgnoreCase("Departments:")) {
						searchInText.append(",");
					}				
					searchInText.append(positionManager.getDeptName(departmentId));
				}			
			}				
		}
		searchInText.append("\\n");
		return searchInText.toString();
	}

