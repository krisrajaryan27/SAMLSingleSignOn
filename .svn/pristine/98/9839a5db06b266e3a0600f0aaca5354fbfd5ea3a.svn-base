package com.talentPool.positions.dataobject;

import com.talentPool.common.db.SimpleDataObject;

/**
 * @author pallavi
 * @date Dec 18, 2006
 */
public class StatusMessage extends SimpleDataObject {

	/**
	 * 
	 */
	public StatusMessage() {
		
	}

	/**
	 * @return Returns the messageId.
	 */
	public String getMessageId() {
		return getString("messageId");
	}
	
	/**
	 * @param messageId
	 * 			The messageId to set.
	 */
	public void setMessageId(String messageId) {
		setAttribute("messageId", messageId);
	}
	
	/**
	 * @return Returns the message.
	 */
	public String getMessage() {
		return getString("message");
	}
	
	/**
	 * @param message
	 * 			The message to set.
	 */
	public void setMessage(String message) {
		setAttribute("message", message);
	}
	
	/**
	 * @return Returns the stepId.
	 */
	public String getStepId() {
		return getString("stepId");
	}
	
	/**
	 * @param stepId
	 * 			The stepId to set.
	 */
	public void setStepId(String stepId) {
		setAttribute("stepId", stepId);
	}

	/**
	 * @return Returns the isDefault.
	 */
	public String getIsDefault() {
		return getString("isDefault");
	}

	/**
	 * @param isDefault 
	 * 			The isDefault to set.
	 */
	public void setIsDefault(String isDefault) {
		setAttribute("isDefault", isDefault);
	}
}
