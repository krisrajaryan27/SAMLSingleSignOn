public class WebsiteUnMarshaller extends CastorUnMarshaller {
	public WidsNames unmarshallIdNames(String xmlFile) {
		WidsNames widsNames = null;
		try {
			widsNames = (WidsNames) unmarshall(WebsiteServiceConstants.WIDSNAMES_MAPPING, xmlFile, WidsNames.class);
		} catch (Exception e) {
			TPLogger.getLogger().error(e);
		}
		return widsNames;
	}
	
