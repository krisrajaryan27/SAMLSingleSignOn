package com.talentPool.offerSheet.constants;

/**
 * Offer Sheet Generation Constants
 * @author PraveenK
 * @since  Sep 22, 2011
 */
public interface OfferSheetConstants {
	
	/**
	 *Applicant Related Fields used in offer sheet generation. 
	 *Value should be the same which is used in DB retrieval in XML  
	 */	
	public static final String APPLICANT_ID = "applicant_id";
	public static final String APPLICANT_NAME = "applicant_name";
	public static final String APPLICANT_CITY = "applicant_city";
	public static final String APPLICANT_EMAIL1 = "applicant_email1";
	public static final String APPLICANT_EMAIL2 = "applicant_email2";
	public static final String APPLICANT_HOME_PHONE = "applicant_home_phone";
	public static final String APPLICANT_CELL_PHONE = "applicant_cell_phone";
	public static final String APPLICANT_WORK_PHONE = "applicant_work_phone";
	public static final String APPLICANT_SKILLS = "applicant_skills";
	public static final String APPLICANT_YOP = "yearOfPassing";
	public static final String APPLICANT_INSTITUTE =  "institute";
	public static final String APPLICANT_DEGREE_TITLE =  "degreeTitle";
	public static final String APPLICANT_BRANCH =  "major";
	public static final String APPLICANT_CLASS =  "grade";
	public static final String APPLICANT_WORKING_SINCE = "applicant_working_since";
	public static final String APPLICANT_EXPERIENCE = "applicant_experience";
	public static final String APPLICANT_CURRENT_EMPLOYER = "applicant_current_employer";
	public static final String APPLICANT_CURRENT_CTC ="current_ctc";
	public static final String APPLICANT_EXPECTED_CTC ="expected_ctc";
	public static final String APPLICANT_SOURCE ="source_title";
	public static final String APPLICANT_DATE_JOINED ="applicant_date_joined";
	public static final String APPLICANT_LEVEL_OFFERED ="applicant_level_offered";
	public static final String APPLICANT_DESIGNATION_OFFERED ="applicant_designation_offered";
	public static final String OFFERED_CTC="offered_ctc";
	public static final String INPUT_SALARY_VARIABLE="input_salary_variable";
	public static final String OFFERED_BASIC="offered_basic";
	public static final String EMPLOYEE_CODE="employee_code";
	

	/**
	 *Position Related Fields used in offer sheet generation. 
	 *Value should be the same which is used in DB retrieval in XML  
	 */	
	public static final String POSITION_CODE = "position_code";
	public static final String POSITION_TITLE = "position_title";
	public static final String LOCATION_NAME = "location_name";
	public static final String DEPT_NAME = "dept_name";
	public static final String SUB_DEPT_NAME = "sub_dept_name";
	public static final String SUB_SUB_DEPT_NAME = "sub_sub_dept_name";
	public static final String POSITION_GRADE_NAME = "grade_name";
	public static final String POSITION_BAND_NAME = "band_name";
	public static final String POSITION_LEVEL = "position_level";
	public static final String POSITION_NOTE = "position_note";
	

	/**
	 *General Fields used in offer sheet generation. 
	 *Value should be the same which is used in DB retrieval in XML  
	 */	
	public static final String COMPANY_NAME = "company_name";
	public static final String TODAY_DATE 	= "today_date";
	
	
	/**
	 * Auto generated Offer code based on the template define in Application settings 
	 */
	public static final String OFFER_CODE 	= "offer_code";
}
