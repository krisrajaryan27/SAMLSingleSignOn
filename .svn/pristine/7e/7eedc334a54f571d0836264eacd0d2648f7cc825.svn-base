package com.talentPool.inbox.dataobject;

import com.talentPool.common.db.SimpleDataObject;

/**
 * @author shivprasad
 * 
 */
public class InboxData extends SimpleDataObject {

	public InboxData() {
		setThreadState(0);
	}

	public int getInboxId() {
		return getInt("inboxId");
	}

	public void setInboxId(int inboxId) {
		setAttribute("inboxId", new Integer(inboxId));
	}

	public String getInboxEmail() {
		return getString("inboxEmail");
	}

	public void setInboxEmail(String inboxEmail) {
		setAttribute("inboxEmail", inboxEmail);
	}

	public String getSmtpHost() {
		return getString("smtpHost");
	}

	public void setSmtpHost(String smtpHost) {
		setAttribute("smtpHost", smtpHost);
	}

	public String getPopHost() {
		return getString("popHost");
	}

	public void setPopHost(String popHost) {
		setAttribute("popHost", popHost);
	}

	public String getUserName() {
		return getString("userName");
	}

	public void setUserName(String userName) {
		setAttribute("userName", userName);
	}

	public String getPassword() {
		return getString("password");
	}

	public void setPassword(String password) {
		setAttribute("password", password);
	}

	public int getPollingDuration() {
		return getInt("pollingDuration");
	}

	public void setPollingDuration(int pollingDuration) {
		setAttribute("pollingDuration", new Integer(pollingDuration));
	}

	public void setThreadState(int threadState) {
		setAttribute("threadState", new Integer(threadState));
	}

	public int getThreadState() {
		return getInt("threadState");
	}

	public String getInboxDisplayName() {
		return getString("inboxDisplayName");
	}

	public void setInboxDisplayName(String inboxDisplayName) {
		setAttribute("inboxDisplayName", inboxDisplayName);
	}

	public int getInboxServerType() {
		return getInt("inboxServerType");
	}

	public void setInboxServerType(int inboxServerType) {
		setAttribute("inboxServerType", new Integer(inboxServerType));
	}

	public int getInboxSmtpAuthRequired() {
		return getInt("inboxSmtpAuthRequired");
	}

	public void setInboxSmtpAuthRequired(int inboxSmtpAuthRequired) {
		setAttribute("inboxSmtpAuthRequired", new Integer(inboxSmtpAuthRequired));
	}

	public int getInboxSmtpAuthSame() {
		return getInt("inboxSmtpAuthSame");
	}

	public void setInboxSmtpAuthSame(int inboxSmtpAuthSame) {
		setAttribute("inboxSmtpAuthSame", new Integer(inboxSmtpAuthSame));
	}

	public String getInboxSmtpUserName() {
		return getString("inboxSmtpUserName");
	}

	public void setInboxSmtpUserName(String inboxSmtpUserName) {
		setAttribute("inboxSmtpUserName", inboxSmtpUserName);
	}

	public String getInboxSmtpPassword() {
		return getString("inboxSmtpPassword");
	}

	public void setInboxSmtpPassword(String inboxSmtpPassword) {
		setAttribute("inboxSmtpPassword", inboxSmtpPassword);
	}

	public String getInboxOutgoingPort() {
		return getString("inboxOutgoingPort");
	}

	public void setInboxOutgoingPort(String inboxOutgoingPort) {
		setAttribute("inboxOutgoingPort", inboxOutgoingPort);
	}

	public int getInboxOutgoingSSLEnabled() {
		return getInt("inboxOutgoingSSLEnabled");
	}

	public void setInboxOutgoingSSLEnabled(int inboxOutgoingSSLEnabled) {
		setAttribute("inboxOutgoingSSLEnabled", new Integer(inboxOutgoingSSLEnabled));
	}

	public String getInboxIncomingPort() {
		return getString("inboxIncomingPort");
	}

	public void setInboxIncomingPort(String inboxIncomingPort) {
		setAttribute("inboxIncomingPort", inboxIncomingPort);
	}

	public int getInboxIncomingSSLEnabled() {
		return getInt("inboxIncomingSSLEnabled");
	}

	public void setInboxIncomingSSLEnabled(int inboxIncomingSSLEnabled) {
		setAttribute("inboxIncomingSSLEnabled", new Integer(inboxIncomingSSLEnabled));
	}
	
	public int getInboxOutgoingTLSEnabled() {
		return getInt("inboxOutgoingTLSEnabled");
	}
	
	public void setInboxOutgoingTLSEnabled(int inboxOutgoingTLSEnabled) {
		setAttribute("inboxOutgoingTLSEnabled", new Integer(inboxOutgoingTLSEnabled));
	}
	
	public String getDomainName() {
		return getString("domainName");
	}

	public void setDomainName(String domainName) {
		setAttribute("domainName", domainName);
	}
	
	public String getExchangeServerVersion() {
		return getString("exchangeServerVersion");
	}

	public void setExchangeServerVersion(String exchangeServerVersion) {
		setAttribute("exchangeServerVersion", exchangeServerVersion);
	}
	
	public String getExchangeServerName() {
		return getString("exchangeServerName");
	}

	public void setExchangeServerName(String exchangeServerName) {
		setAttribute("exchangeServerName", exchangeServerName);
	}
	
	public String getExchangeSmtp() {
		return getString("exchangeSmtp");
	}

	public void setExchangeSmtp(String exchangeSmtp) {
		setAttribute("exchangeSmtp", exchangeSmtp);
	}
	
