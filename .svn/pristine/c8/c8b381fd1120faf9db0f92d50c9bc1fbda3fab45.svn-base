package com.talentPool.search.dataobjects;

import com.talentPool.common.db.SimpleDataObject;


/**
 * @author Ajeet
 *
 */
public class SavedSearchData extends SimpleDataObject {
	
	public String getSearchId() {
		return getString("searchId");
	}

	public void setSearchId(String searchId) {
		setAttribute("searchId", searchId);
	}
	
	public String getSearchName() {
		return getString("searchName");
	}

	public void setSearchName(String searchName) {
		setAttribute("searchName", searchName);
	}
	
	public String getShared() {
		return getString("shared");
	}

	public void setShared(String shared) {
		setAttribute("shared", shared);
	}
	
	public void setOwner(String owner) 
	{
		setAttribute("owner", owner);
	}
	
	public String getOwner() 
	{
		return getString("owner");
	}
	
	public void setUserId(String userId) 
	{
		setAttribute("userId",userId);
	}
	
	public String getUserID() 
	{
		return getString("userId");
	}
}
