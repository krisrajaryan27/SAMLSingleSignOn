 * 
 */
package com.talentPool.customReports.dataobject;

import com.talentPool.customReports.jaxb.CandNamesSpecifications;
import com.talentPool.customReports.jaxb.Filters;
import com.talentPool.user.manager.PermissionSet;

/**
 * Data bean that carries all the data required to run a report like
 * Query file path, report template file path, report output stream/fileName, filters to be applied etc. 
 * @author praveenk
 * @since  Feb 28, 2012
 */
public class RunCustomReportModel {
	
	private String templateFilePath;
	private String queryFilePath;
	private String inactivePositionsQueryFilePath;
	private Filters filters;
	private CandNamesSpecifications candNamesSpecifications;
	private String userId;
	private PermissionSet permissionSet;
	private boolean showInactivePositions;
	private boolean checkPositionPermission;
	
	/**
	 * @return the templateFilePath
	 */
	public String getTemplateFilePath() {
		return templateFilePath;
	}
	/**
	 * @param templateFilePath the templateFilePath to set
	 */
	public void setTemplateFilePath(String templateFilePath) {
		this.templateFilePath = templateFilePath;
	}
	/**
	 * @return the queryFilePath
	 */
	public String getQueryFilePath() {
		return queryFilePath;
	}
	/**
	 * @param queryFilePath the queryFilePath to set
	 */
	public void setQueryFilePath(String queryFilePath) {
		this.queryFilePath = queryFilePath;
	}
	
	/**
	 * @return the filters
	 */
	public Filters getFilters() {
		return filters;
	}
	/**
	 * @param filters the filters to set
	 */
	public void setFilters(Filters filters) {
		this.filters = filters;
	}
	/**
	 * @return the userId
	 */
	public String getUserId() {
		return userId;
	}
	/**
	 * @param userId the userId to set
	 */
	public void setUserId(String userId) {
		this.userId = userId;
	}
	/**
	 * @return the permissionSet
	 */
	public PermissionSet getPermissionSet() {
		return permissionSet;
	}
	/**
	 * @param permissionSet the permissionSet to set
	 */
	public void setPermissionSet(PermissionSet permissionSet) {
		this.permissionSet = permissionSet;
	}
	/**
	 * @return the candNamesSpecifications
	 */
	public CandNamesSpecifications getCandNamesSpecifications() {
		return candNamesSpecifications;
	}
	/**
	 * @param candNamesSpecifications the candNamesSpecifications to set
	 */
	public void setCandNamesSpecifications(
			CandNamesSpecifications candNamesSpecifications) {
		this.candNamesSpecifications = candNamesSpecifications;
	}
	/**
	 * @return the inactivePositionsQueryFilePath
	 */
	public String getInactivePositionsQueryFilePath() {
		return inactivePositionsQueryFilePath;
	}
	/**
	 * @param inactivePositionsQueryFilePath the inactivePositionsQueryFilePath to set
	 */
	public void setInactivePositionsQueryFilePath(
			String inactivePositionsQueryFilePath) {
		this.inactivePositionsQueryFilePath = inactivePositionsQueryFilePath;
	}
	/**
	 * @return the showInactivePositions
	 */
	public boolean isShowInactivePositions() {
		return showInactivePositions;
	}
	/**
	 * @param showInactivePositions the showInactivePositions to set
	 */
	public void setShowInactivePositions(boolean showInactivePositions) {
		this.showInactivePositions = showInactivePositions;
	}
	/**
	 * @return the checkPositionPermission
	 */
	public boolean isCheckPositionPermission() {
		return checkPositionPermission;
	}
	/**
	 * @param checkPositionPermission the checkPositionPermission to set
	 */
	public void setCheckPositionPermission(boolean checkPositionPermission) {
		this.checkPositionPermission = checkPositionPermission;
	}

}
