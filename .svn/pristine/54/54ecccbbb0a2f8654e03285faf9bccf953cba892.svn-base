package com.talentPool.offerSheet.model;

import com.talentPool.salaryStructure.databject.ApplicantOfferDetails;

/**
 * @author praveenk
 * @since  May 13, 2012
 */
public class ApplicantOfferModel {

	private String applicantId;
	private boolean modifyOffer;
	private String offerSheetTemplateId;
	private ApplicantOfferDetails appOfferDetails;
	private String offerCode;
	private int offerFormat;
	
	/**
	 * @return the modifyOffer
	 */
	public boolean isModifyOffer() {
		return modifyOffer;
	}
	/**
	 * @param modifyOffer the modifyOffer to set
	 */
	public void setModifyOffer(boolean modifyOffer) {
		this.modifyOffer = modifyOffer;
	}
	/**
	 * @return the appOfferDetails
	 */
	public ApplicantOfferDetails getAppOfferDetails() {
		return appOfferDetails;
	}
	/**
	 * @param appOfferDetails the appOfferDetails to set
	 */
	public void setAppOfferDetails(ApplicantOfferDetails appOfferDetails) {
		this.appOfferDetails = appOfferDetails;
	}
	/**
	 * @return the applicantId
	 */
	public String getApplicantId() {
		return applicantId;
	}
	/**
	 * @param applicantId the applicantId to set
	 */
	public void setApplicantId(String applicantId) {
		this.applicantId = applicantId;
	}
	/**
	 * @return the offerSheetTemplateId
	 */
	public String getOfferSheetTemplateId() {
		return offerSheetTemplateId;
	}
	/**
	 * @param offerSheetTemplateId the offerSheetTemplateId to set
	 */
	public void setOfferSheetTemplateId(String offerSheetTemplateId) {
		this.offerSheetTemplateId = offerSheetTemplateId;
	}
	/**
	 * @return the offerCode
	 */
	public String getOfferCode() {
		return offerCode;
	}
	/**
	 * @param offerCode the offerCode to set
	 */
	public void setOfferCode(String offerCode) {
		this.offerCode = offerCode;
	}
	/**
	 * @return the offerFormat
	 */
	public int getOfferFormat() {
		return offerFormat;
	}
	/**
	 * @param offerFormat the offerFormat to set
	 */
	public void setOfferFormat(int offerFormat) {
		this.offerFormat = offerFormat;
	}
}
