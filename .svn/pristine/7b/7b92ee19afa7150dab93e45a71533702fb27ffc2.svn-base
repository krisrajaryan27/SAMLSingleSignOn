package com.talentPool.socialNetwork.ITransferObjectImpl;

import java.io.Serializable;

import javax.xml.bind.annotation.XmlRootElement;

import com.talentPool.socialNetwork.ITransferObject.IPostOn;

/**
 * @author SumeetS
 *
 */
@XmlRootElement
public final class PostOnPage implements IPostOn,Serializable{

	/**
	 * 
	 */
	private static final long serialVersionUID =  -6469241949557946137L;
	private final String id;
	
	/**
	 * @param id
	 */
	public PostOnPage(String id){
		this.id = id;
	}
	
	
	@Override
	public String getId() {
		return id;
	}

}
