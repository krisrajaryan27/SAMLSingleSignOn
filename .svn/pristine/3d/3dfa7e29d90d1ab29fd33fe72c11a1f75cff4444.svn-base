	public static String getExperienceConstructed(java.util.Date workingSince) {
		String exp = "";
		if (workingSince != null) {
			Calendar cal1 = Calendar.getInstance();
			Calendar cal2 = Calendar.getInstance();
			cal1.setTime(workingSince);
			int yearDiff = cal2.get(Calendar.YEAR) - cal1.get(Calendar.YEAR);
			int monthDiff = yearDiff * 12 + cal2.get(Calendar.MONTH) - cal1.get(Calendar.MONTH);
			int yrs = 0;
			if (monthDiff != 0) {
				yrs = monthDiff / 12;
				if (yrs > 0) {
					exp = yrs + " " + EXP_YRS;
				}
			}
			int mos = monthDiff % 12;
			if (mos > 0) {
				if (yrs > 0) {
					exp += " ";
				}
				exp += mos + " " + EXP_MOS;
			}
		}
		if (exp.length() <= 0) {
			exp = EXP_FRESHER;
		}
		return exp;
	}
	
	public static double getExperienceInNumberFormat(java.util.Date workingSince) {
		double exp = 0;
		if (workingSince != null) {
			Calendar cal1 = Calendar.getInstance();
			Calendar cal2 = Calendar.getInstance();
			cal1.setTime(workingSince);
			int yearDiff = cal2.get(Calendar.YEAR) - cal1.get(Calendar.YEAR);
			int monthDiff = yearDiff * 12 + cal2.get(Calendar.MONTH) - cal1.get(Calendar.MONTH);
			int yrs = 0;
			if (monthDiff != 0) {
				yrs = monthDiff / 12;
				if(yrs >0){
					exp = yrs;
				}
			}
			int mos = monthDiff % 12;
			if (mos > 0) {
				exp = yrs+(mos/365);
			}
		}
		return exp;
	}

