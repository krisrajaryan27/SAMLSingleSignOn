	public static String getDateDiffenence(java.util.Date Date1, java.util.Date Date2) {
		String exp = "";
		if (Date1 != null) {
			exp = String.valueOf(getDateDiffenenceInLong(Date1,Date2));
		}
		return exp;
	}
	public static String getDateDiffenenceIncludeLastDay(java.util.Date Date1, java.util.Date Date2) {
		if (Date1 != null) {
			if(Date1.after(Date2)){
				return String.valueOf(getDateDiffenenceInLong(Date1,Date2));
			}else if(Date1.before(Date2)){
				return String.valueOf(getDateDiffenenceInLong(Date1,Date2)+1);
			}else if(Date1.equals(Date2)) {
				return "0";
			}
		}
		return "";
	}
	private static long getDateDiffenenceInLong(java.util.Date Date1, java.util.Date Date2) {
		long days = 0;
		Calendar cal1 = Calendar.getInstance();
		Calendar cal2 = Calendar.getInstance();
		cal1.setTime(Date1);
		cal2.setTime(Date2);
		days = cal2.getTimeInMillis() - cal1.getTimeInMillis();
		days = days / (1000 * 60 * 60 * 24);
		return days;
	}
	
	public static String replaceUserEmailWithInboxEmail(String userEmailId, String inboxEmailId) {
		int indx = userEmailId.indexOf("<");
		String returnString = userEmailId.substring(0, indx) + " <" + inboxEmailId + ">";
		return returnString;
	}

	public static Properties loadAppliocationLabels(String fileName) {
		Properties properties = new Properties();
		try {
			if (Utils.isBlankOrNull(fileName)) {
				fileName = "talentpoollabels.properties";
			}
			String labelsFolder = Utils.concatFilePath(Utils.concatFilePath(TPApplicationProperties.getProperty("application.path"), TPApplicationProperties.getProperty("ui.dir")),
					TPApplicationProperties.getProperty("label.folder.relative"));
			String labelFileName = Utils.concatFilePath(labelsFolder, fileName);
			properties.load(new FileInputStream(labelFileName));
		} catch (FileNotFoundException e) {
			TPLogger.getLogger().error("Error while loading application labels", e);
		} catch (IOException e) {
			TPLogger.getLogger().error("Error while loading application labels", e);
		}
		return properties;
	}

	public static void saveAppliocationLabels(Properties properties) {
		try {
			if (properties != null) {
				String labelsFolder = Utils.concatFilePath(Utils.concatFilePath(TPApplicationProperties.getProperty("application.path"), TPApplicationProperties.getProperty("ui.dir")),
						TPApplicationProperties.getProperty("label.folder.relative"));
				String labelFileName = Utils.concatFilePath(labelsFolder, "talentpoollabels.properties");
				properties.store(new FileOutputStream(labelFileName), null);
			}
		} catch (FileNotFoundException e) {
			TPLogger.getLogger().error("Error while saving application labels", e);
		} catch (IOException e) {
			TPLogger.getLogger().error("Error while saving application labels", e);
		}
	}

	public static String getEmailAddress(String emailAddress) {
		if (emailAddress != null && emailAddress.indexOf("<") > 0) {
			emailAddress = emailAddress.substring(emailAddress.indexOf("<") + 1, emailAddress.length() - 1);
		}
		return emailAddress;
	}

	public static String removeExtendedAsciiChars(String input) {
		for(int i = 128; i <= 255; i++) {
			input = input.replaceAll(""+(char) i, "");
		}
		return input;
	}
	
	public static String getXMLForContent(String tagName, String content) {
		StringWriter sWr = new StringWriter();
		XMLWriter wr = new XMLWriter(sWr);
		try {
			wr.startDocument();
			wr.startElement(tagName);
			wr.characters(wr.doubleEscape(content));
			wr.endElement(tagName);
			wr.endDocument();
		} catch (Exception e) {
			TPLogger.getLogger().error(GlobalConstants.ERROR, e);
		}
		return sWr.toString();
	}

	public static String getXMLForMap(Map<String, Object> map) {
		StringWriter sWr = new StringWriter();
		XMLWriter wr = new XMLWriter(sWr);
		try {
			wr.startDocument();
			wr.startElement("content");
			for (String key : map.keySet()) {
				wr.startElement(key);
				wr.characters(wr.doubleEscape(map.get(key)+""));
				wr.endElement(key);
			}			
			wr.endElement("content");
			wr.endDocument();
		} catch (Exception e) {
			TPLogger.getLogger().error(GlobalConstants.ERROR, e);
		}
		return sWr.toString();
	}
	
	public static String getXMLForMapForDHTMLGrid(Map<String, Object> map){
		StringWriter sWr = new StringWriter();
		XMLWriter wr = new XMLWriter(sWr);
		try {
			int cnt=0;
			wr.startDocument();
			wr.startElement("rows");
			for (String key : map.keySet()) {
				AttributesImpl atr = new AttributesImpl();
				atr.addAttribute("", "id", "", "",""+cnt++);
				wr.startElement("", "row", "", atr);

				AttributesImpl atr1 = new AttributesImpl();
				atr1.addAttribute("", "name", "", "", "key");
				wr.startElement("", "userdata", "", atr1);
				wr.characters(key);
				wr.endElement("userdata");
				
				wr.startElement("cell");
				wr.characters(wr.doubleEscape(map.get(key)+""));
				wr.endElement("cell");
				wr.endElement("row");
			}			
			wr.endElement("rows");
			wr.endDocument();
		} catch (Exception e) {
			TPLogger.getLogger().error(GlobalConstants.ERROR, e);
		}
		return sWr.toString();
	}

