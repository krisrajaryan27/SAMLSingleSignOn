	/**
	 * Converts Comma delimited String to Distinct Collection 
	 * @param groupBy
	 * @param drb
	 * @param reportType
	 */
	public static List<String> convertCommaSepStringToDistinctList(String commaDelimitedStr){
		return convertStringToDistinctList(commaDelimitedStr, CommonConstants.DEFAULT_DELIMITER);
	}
	
	/**
	 * Converts delimited String to Distinct Collection 
	 * @param groupBy
	 * @param drb
	 * @param reportType
	 */
	public static List<String> convertStringToDistinctList(String delimitedStr,String delimiter){
		String[] entities = delimitedStr.split(delimiter);
		List<String> lst = new  ArrayList<String>();
		for (String entity : entities) {
			if(!Utils.isBlankOrNull(entity) && !lst.contains(entity)){
				lst.add(entity);
			}
		}
		return lst;
	}

	public static boolean isListEmptyOrNull(List list) {
		return (list == null || list.isEmpty());
	}
	
	public static boolean isMapEmptyOrNull(Map map) {
		return (map == null || map.isEmpty());
	}
	
	/**
	 * This is valid for maps with one to one key-value relation
	 * @param map
	 * @param value
	 * @return
	 */
	public static <T, E> T getKeyByValue(Map<T, E> map, E value) {
	    for (Entry<T, E> entry : map.entrySet()) {
	        if (value.equals(entry.getValue())) {
	            return entry.getKey();
	        }
	    }
	    return null;
	}

	public static String replaceQMarksWithDynamicContent(String dynaParam,
			ArrayList<String> dynamicContent) {
		while(dynamicContent.size() > 0) {
			dynaParam = dynaParam.replaceFirst("\\?", "'"+dynamicContent.remove(0)+"'");
		}
		
		return dynaParam;
	}

	public static boolean searchInFile(File f, String searchString) {
        boolean result = false;
        Scanner in = null;
        try {
            in = new Scanner(new FileReader(f));
            while(in.hasNextLine() && !result) {
                result = in.nextLine().indexOf(searchString) >= 0;
            }
        }
        catch(IOException e) {
            e.printStackTrace();      
        }
        finally {
            try { 
            	in.close() ; 
            } catch(Exception e) {
            }  
        }
        return result;
    }

	public static boolean hasValidCharacter(String input) {
		Pattern p = Pattern.compile(excludeSpecialChararacters);
		Matcher m = p.matcher(input);
		return (m.matches());
	}
	
	public static boolean isInteger(String str){
		try {
			Integer.parseInt(str);
			return true;
		} catch (NumberFormatException nfe) {
			return false;
		}
	}
	
	public static boolean isNumeric(String str){
		if(!Utils.isBlankOrNull(str)){
			return str.matches("\\d+(\\.\\d+)?");
		}
		return false;
	}

	/**
	 * The method will return the difference between two dates. in string format like 4.11 years.
	 * @param fromDate
	 * @param toDate
	 * @return
	 */
	public static Integer getDateDifferenceInMonths(java.util.Date fromDate, java.util.Date toDate){
		Integer diff = 0;
		try{
			Calendar calendar = Calendar.getInstance();			
			calendar.setTime(fromDate);
			int fromYear=calendar.get(Calendar.YEAR);
			int fromMonth=calendar.get(Calendar.MONTH);			
			calendar.setTime(toDate);
			int toYear=calendar.get(Calendar.YEAR);
			int toMonth=calendar.get(Calendar.MONTH);						
			//diff=Math.abs((toYear-fromYear)*calendar.getMaximum(Calendar.MONTH)+(calendar.getMaximum(Calendar.MONTH)+(toMonth-calendar.getMaximum(Calendar.MONTH))-(fromMonth-1)));
			diff=Math.abs((toYear-fromYear)*12+(12+(toMonth-12)-(fromMonth-1)));					
		}catch (Exception e) {
			TPLogger.getLogger().debug(GlobalConstants.ERROR,e);
		}		
		return diff;		
	}
	
	public static String getDateDifferenceInYearMonthString(java.util.Date fromDate, java.util.Date toDate, Integer numOfMonths){
		String yrMonStr="";
		Integer monDiff=0;
		try{
			if(numOfMonths==null && fromDate!=null && toDate!=null){
				monDiff=getDateDifferenceInMonths(fromDate,toDate);
			}else if(numOfMonths!=null && fromDate==null && toDate==null){
				monDiff =numOfMonths;
			}
			Integer year = monDiff/12;
			Integer month = monDiff%12;
			if(month>0){
			yrMonStr = year+"yrs "+month+"months"; 
			} else {
				yrMonStr = year+"yrs ";
			}
			
		}catch (Exception e) {
			TPLogger.getLogger().debug(GlobalConstants.ERROR,e);
		}
		return yrMonStr;
	}	
	
	public static String getExperienceInDecimalFormat(java.util.Date workingSince) {
		String yrMonStr = "";
		Integer monDiff=0;
		try{
			monDiff = getDateDifferenceInMonths(workingSince,Calendar.getInstance().getTime());
			Integer year = monDiff/12;
			Integer month = monDiff%12-1;
			yrMonStr = year+"."+month; 
			
		}catch (Exception e) {
			TPLogger.getLogger().debug(GlobalConstants.ERROR,e);
		}
		return yrMonStr;
	}
	
	/**
	 * Converts Comma delimited String to Distinct Collection 
	 */
	public static List<String> convertCommaSepStringToList(String commaDelimitedStr){
		return convertStringToList(commaDelimitedStr, CommonConstants.DEFAULT_DELIMITER);
	}
	
	/**
	 * Converts delimited String to Distinct Collection 
	 */
	public static List<String> convertStringToList(String delimitedStr,String delimiter){
		List<String> lst = new  ArrayList<String>();
		if(delimitedStr!=null){
			String[] entities = delimitedStr.split(delimiter);
			for (String entity : entities) {
				if(!Utils.isBlankOrNull(entity) && !lst.contains(entity)){
					lst.add(entity);
				}
			}			
		}
		return lst;
	}
	public static ArrayList<String> convertStringArrayIntoArrayList(String[] strArray) {
		ArrayList<String> arList = new ArrayList<String>();
		try {
			if (strArray != null) {
				for (int i = 0; i < strArray.length; i++) {
					arList.add(strArray[i]);
				}
			}
		} catch (Exception e) {
			TPLogger.getLogger().error(GlobalConstants.ERROR, e);
		}
		return arList;
	}
	/**
	 * @param inputArray
	 * @return
	 */
	public static String[] getArrayCopy(String[] inputArray) {
		if (inputArray == null) {
			return null;
		} else {
			return Arrays.copyOf(inputArray, inputArray.length);
		}
	}

	public static String getTextContentFromHTML(String inptStr) {
		String result=null;
		if(Utils.isBlankOrNull(inptStr)){
			result = "";
		}else{
			inptStr= inptStr.replaceAll("&nbsp;"," ");
			String htmlString = Jsoup.clean(inptStr, "", Whitelist.none().addTags("br", "p"), new OutputSettings().prettyPrint(true));
			result = Jsoup.clean(htmlString, "", Whitelist.none(), new OutputSettings().prettyPrint(false));
		}
		return result;
	}

	/**
	 * @param dt
	 * @param dateFormat
	 * @param timezone
	 * @return
	 * 
	 * to convert with rest to a given timezone
	 */
	public static String getDateConvertedToStringWithTimezone(java.util.Date dt,
			String dateFormat, String timezone) {
		try {
			DateFormat format = new SimpleDateFormat(dateFormat);
			format.setTimeZone(TimeZone.getTimeZone(timezone));
			return format.format(dt);
		} catch (Exception e) {
			TPLogger.getLogger().debug("Error While parsing send date: setting send date to null", e);
		}
		return "";
	}

	
	/**
	 * @param request
	 * @return
	 * 
	 * to form url from the incoming request
	 */
	public static String buildTalentPoolURLFromIncomingRequestObject(HttpServletRequest request){
		String tmp = request.getRequestURI();
		String requestUrl =request.getScheme()+"://"+request.getServerName()+":"+request.getServerPort()+tmp.substring(0,StringUtils.ordinalIndexOf(tmp, "/", 2));
		return requestUrl;
	}
	
	public static double getExperienceInNumber(java.util.Date workingSince) {
		double exp = 0;
		if (workingSince != null) {
			Calendar cal1 = Calendar.getInstance();
			Calendar cal2 = Calendar.getInstance();
			cal1.setTime(workingSince);
			int yearDiff = cal2.get(Calendar.YEAR) - cal1.get(Calendar.YEAR);
			int monthDiff = yearDiff * 12 + cal2.get(Calendar.MONTH) - cal1.get(Calendar.MONTH);
			int yrs = 0;
			if (monthDiff != 0) {
				yrs = monthDiff / 12;
				if(yrs >0){
					exp = yrs;
				}
			}
			int mos = monthDiff % 12;
			if (mos > 0) {
				double mos1=0.0;
				if(mos<10){
					mos1=mos*.1;
				
				}
				else{
					if(mos==10){
						mos1=0.10;
					}
					else{
						mos1=mos/100;
					}
					
				}
				exp = yrs+mos1;
			}
		}
		return exp;
	}
	
	public static void resetSettingsOnCandidatePortal(){
		Client client = Client.create();
		WebResource webResource = client.resource(TPApplicationProperties.getProperty("candidate.portal.reset.appFields.url"));
		ClientResponse response = webResource.type("text/plain").get(ClientResponse.class);
		String res = response.getEntity(String.class);
		TPLogger.getLogger().debug("candidate portal applicant fields reset " + res);
		response.close();
	}
}