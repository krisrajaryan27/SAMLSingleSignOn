	public static boolean isDateInFuture(java.util.Date d) {
		try {
			java.util.Date now = Calendar.getInstance().getTime();
			if (d.after(now)) {
				return true;
			}
		} catch (Exception e) {
			TPLogger.getLogger().debug(GlobalConstants.ERROR, e);
		}
		return false;
	}
	
	public static String stopBOTS(String email) {
		if(!isBlankOrNull(email) && GlobalConstants.ENABLED.equals(GlobalApplicationProperties.getProperty(GlobalConstants.PROPERTY_SHOW_BOT_RESISTANT_EMAIL_ID))) {
			email = email.replace("@", " at ").replace(".", " dot ");
		}
		return email;
	}
	
	
	/**
	 * This method loads instance variables (static and non final) of objClass from the varMap 
	 * @param objClass
	 * @param varMap
	 */
	public static void loadStaticVariables(Class objClass,Map varMap) {
		Field[] fldClass = null;
		fldClass = objClass.getDeclaredFields();
		int modifierVal = 0;
		try {
			for (int i = 0; i < fldClass.length; i++){
				fldClass[i].setAccessible(true);
				modifierVal = fldClass[i].getModifiers();
				if(!Modifier.isFinal(modifierVal) && Modifier.isStatic(modifierVal))
					if(varMap.containsKey(fldClass[i].getName()))
						fldClass[i].set(null,varMap.get(fldClass[i].getName()));
			}
		} catch (Exception e) {
			TPLogger.getLogger().error("Error in loading Static Variables", e);
		}
	}

