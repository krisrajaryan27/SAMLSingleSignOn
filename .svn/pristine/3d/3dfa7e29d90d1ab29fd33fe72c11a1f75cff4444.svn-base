	/**
	 * Returns a URL built using the method parameters
	 * Eg:
	 * <code>http://hostanem:port/alias
	 * </code>
	 * @param hostName
	 * @param port
	 * @param alias
	 * @return
	 */
	public static String buildURL(String protocol,String hostName, String port, String alias, String queryString){
		StringBuilder path = new StringBuilder();
		protocol = Utils.isBlankOrNull(protocol)?"http":protocol;
		if(!Utils.isBlankOrNull(port))
			path.append(protocol).append("://"+hostName).append(":").append(port).append("/").append(alias).append("/").append(queryString);
		else
			path.append(protocol).append("://").append(hostName).append("/").append(alias).append("/").append(queryString);
		return path.toString();
	}
	
	public static String buildTalentPoolURL(String queryString){
		String externalLink = TPApplicationProperties.getProperty("application.external_IP");
		String url = "", systemName = "";
		if(!Utils.isBlankOrNull(externalLink)) {
			systemName = externalLink;			
		} else {
			systemName = TPApplicationProperties.getProperty("system.name");			
		}
		url = Utils.buildURL(TPApplicationProperties.getProperty("application.protocol"),
				systemName, 
				TPApplicationProperties.getProperty("application.port"), 
				TPApplicationProperties.getProperty("application.alias"),queryString);
		
		return url;
	}
	
