	/**
	 * @param root
	 * @param path
	 * @return the concatenated file path.
	 * 
	 * while appennding it automatically checks for "\" or "/" at the end of the root and at the
	 * start of the path
	 */
	public static String concatFilePath(String root, String path) {
		if (root == null)
			return path;
		else if (path == null)
			return root;
		StringBuffer sb = new StringBuffer();
		boolean isEnded = false;
		if (root.endsWith("/") || root.endsWith("\\")) {
			isEnded = true;
		}
		sb.append(root);
		if (path.startsWith("/") || path.startsWith("\\")) {
			if (isEnded) {
				sb.append(path.substring(1));
			} else {
				sb.append(path);
			}
		} else {
			if (isEnded) {
				sb.append(path);
			} else {
				sb.append("/");
				sb.append(path);
			}
		}
		return sb.toString();
	}

	/**
	 * Removes tabs, newlines and redundant spaces from a string Basically for building a single
	 * line query from one that was broken across multiple lines.
	 * 
	 * @param inputStr
	 * @return
	 */
	public static String removeExtraWhiteSpace(String inputStr) {
		StringBuffer newSb = new StringBuffer();
		int size = inputStr.length();
		char prevC = 'a';
		for (int i = 0; i < size; i++) {
			char c = inputStr.charAt(i);
			if (c == '\n' || c == '\t' || c == '\r') {
				c = ' ';
			}
			if (c == ' ') {
				if (prevC == ' ') {
					// skip
				} else {
					newSb.append(c);
				}
			} else {
				newSb.append(c);
			}
			prevC = c;
		}
		return newSb.toString().trim();
	}

	public static boolean isBlankOrNull(String s) {
		return (s == null || "".equals(s.trim()) || "null".equals(s.trim()));
	}

	public static boolean isBlankOrNullOrDefault(String s, String defaultValue){
		return isBlankOrNull(s)|| s.equals(defaultValue);
	}
	
	/**
	 * Checks whether the given string is null or blank or -1 (default value) 
	 * @param str
	 * @return true if str is NULL or "" or "-1"
	 * <br> else false
	 * @see Utils#isBlankOrNull(String)
	 * @see Utils#isBlankOrNullOrDefault(String, String)
	 */
	public static boolean isBlankOrNullOrDefault(String str){
		return isBlankOrNullOrDefault(str, CommonConstants.DEFAULT_SELECT_VALUE);
	}
	
	/**
	 * @param count
	 *            length of random String
	 * @param start
	 *            lower limit of range
	 * @param end
	 *            upper limit of range
	 * @param letters
	 *            true - letters are allowed
	 * @param numbers
	 *            true - numbers are allowed
	 * @param chars
	 *            set of characters to be used
	 * @param random
	 *            object of java.util.Random classs
	 * @return
	 */
	public static String getRandomString(int count, int start, int end, boolean letters, boolean numbers, char[] chars, Random random) {
		if (count == 0) {
			return "";
		} else if (count < 0) {
			throw new IllegalArgumentException("Requested random string length " + count + " is less than 0.");
		}
		if ((start == 0) && (end == 0)) {
			end = 'z' + 1;
			start = ' ';
			if (!letters && !numbers) {
				start = 0;
				end = Integer.MAX_VALUE;
			}
		}

		StringBuffer buffer = new StringBuffer();
		int gap = end - start;

		while (count-- != 0) {
			char ch;
			if (chars == null) {
				ch = (char) (random.nextInt(gap) + start);
			} else {
				ch = chars[random.nextInt(gap) + start];
			}
			if ((letters && numbers && Character.isLetterOrDigit(ch)) || (letters && Character.isLetter(ch)) || (numbers && Character.isDigit(ch)) || (!letters && !numbers)) {
				buffer.append(ch);
			} else {
				count++;
			}
		}
		return buffer.toString();
	}

	/**
	 * 
	 * @param input
	 *            String to be validated
	 * @param pattern
	 *            Pattern to be matched
	 * @return true if pattern is matched else return false
	 */
	public static boolean isValidPattern(String input, String pattern) {
		Pattern p = Pattern.compile(pattern, Pattern.CASE_INSENSITIVE | Pattern.UNICODE_CASE | Pattern.MULTILINE);
		Matcher m = p.matcher(input);
		return (m.matches());

	}

	public static java.util.Date convertToDate(String input, String dateFormat) {
		java.util.Date dt = null;
		try {
			if (!isBlankOrNull(input)) {
				SimpleDateFormat sdfInput = new SimpleDateFormat(dateFormat);
				dt = sdfInput.parse(input);
			}
		} catch (Exception e) {
			TPLogger.getLogger().debug("Error While converting to util date", e);
			dt = null;
		}
		return dt;
	}
	
	public static java.util.Date convertHoursToDateWithTimeZone(String input, String dateFormat) {
		java.util.Date dt = null;
		try {
				Date startTime = new Date(System.currentTimeMillis());
				GregorianCalendar cal = new GregorianCalendar();
				cal.setTime(startTime);
				cal.set(java.util.Calendar.HOUR_OF_DAY, Integer.parseInt(input.substring(0, input.indexOf(":"))));
				cal.set(java.util.Calendar.MINUTE, Integer.parseInt(input.substring(input.indexOf(":")+1, input.length())));
				dt = cal.getTime();
		} catch (Exception e) {
			TPLogger.getLogger().debug("Error While converting to util date", e);
			dt = null;
		}
		return dt;
	}
	
	public static String getDateStringConvertedToOtherDateFormat(String dateString , String srcDateFormat, String destDateFormat){
		java.util.Date date = convertToDate(dateString, srcDateFormat);
		return getDateConvertedToString(date, destDateFormat);
	}
	

	public static java.util.Date adjustDateBy(java.util.Date d, int unit, int numberOfUnits) {
		java.util.GregorianCalendar cal = new java.util.GregorianCalendar();
		cal.setTime(d);
		cal.add(unit, numberOfUnits);
		return cal.getTime();
	}
	
	/**
	 * @author PraveenK 
	 * Increments date by one day 
	 * @param date
	 * @return
	 */
	public static java.util.Date datePlusPlus(java.util.Date date) {
		return Utils.adjustDateBy(date, Calendar.DATE, +1);
	}

	public static java.sql.Date convertToSQLDate(String input, String dateFormat) {
		java.sql.Date dt = null;
		try {
			dt = new Date(convertToDate(input, dateFormat).getTime());
		} catch (Exception e) {
			TPLogger.getLogger().debug("Error While converting to sql date", e);
			dt = null;
		}
		return dt;
	}

	public static java.sql.Date convertDateToSQLDate(java.util.Date input) {
		java.sql.Date dt = null;
		try {
			if (input != null) {
				dt = new Date(input.getTime());
			}
		} catch (Exception e) {
			TPLogger.getLogger().debug("Error While converting to sql date", e);
			dt = null;
		}
		return dt;
	}

	public static String getDateConvertedToString(java.util.Date dt, String dateFormat) {
		try {
			DateFormat format = new SimpleDateFormat(dateFormat);
			return format.format(dt);
		} catch (Exception e) {
			TPLogger.getLogger().debug("Error While parsing send date: setting send date to null", e);
		}
		return "";
	}
	
	public static String getCurrentTimeStamp() {
		try {
			DateFormat format = new SimpleDateFormat("HH:mm:ss");
			return format.format(new java.util.Date());
		} catch (Exception e) {
			TPLogger.getLogger().debug("Error While parsing send date: setting send date to null", e);
		}
		return "";
	}

	public static String getFormattedRecord(String input) {
		try {
			input = input.replaceAll("&#44;", ",");
			input = input.replaceAll("&#124;", "|");
			input = input.replaceAll("&#58;", ":");
			input = input.replaceAll("&#95;", "_");
		} catch (Exception e) {
		}
		return input;
	}

	/*
	 * Added by Shivprasad : Reference can be found at
	 * http://www.koders.com/java/fid469723E78254774BEC5E0E17D580B2DA38BA3658.aspx
	 */
	/**
	 * <p>
	 * Creates a random string based on a variety of options, using default source of randomness.
	 * </p>
	 * 
	 * <p>
	 * This method has exactly the same semantics as
	 * {@link #random(int,int,int,boolean,boolean,char[],Random)}, but instead of using an
	 * externally supplied source of randomness, it uses the internal static {@link Random}
	 * instance.
	 * </p>
	 * 
	 * @param count
	 *            the length of random string to create
	 * @param start
	 *            the position in set of chars to start at
	 * @param end
	 *            the position in set of chars to end before
	 * @param letters
	 *            only allow letters?
	 * @param numbers
	 *            only allow numbers?
	 * @param chars
	 *            the set of chars to choose randoms from. If <code>null</code>, then it will use
	 *            the set of all chars.
	 * @return the random string
	 * @throws ArrayIndexOutOfBoundsException
	 *             if there are not <code>(end - start) + 1</code> characters in the set array.
	 */
	public static String random(int count, int start, int end, boolean letters, boolean numbers, char[] chars, Random random) {
		if (count == 0) {
			return "";
		} else if (count < 0) {
			throw new IllegalArgumentException("Requested random string length " + count + " is less than 0.");
		}
		if ((start == 0) && (end == 0)) {
			end = 'z' + 1;
			start = ' ';
			if (!letters && !numbers) {
				start = 0;
				end = Integer.MAX_VALUE;
			}
		}

		StringBuffer buffer = new StringBuffer();
		int gap = end - start;

		while (count-- != 0) {
			char ch;
			if (chars == null) {
				ch = (char) (random.nextInt(gap) + start);
			} else {
				ch = chars[random.nextInt(gap) + start];
			}
			if ((letters && numbers && Character.isLetterOrDigit(ch)) || (letters && Character.isLetter(ch)) || (numbers && Character.isDigit(ch)) || (!letters && !numbers)) {
				buffer.append(ch);
			} else {
				count++;
			}
		}
		return buffer.toString();
	}

	/**
	 * 
	 * @param data
	 * @param separator
	 * @return arraylist of keys separated by separator passed
	 */
	public static List<String> getKeys(String data, String separator) {
		List<String> list = new ArrayList<String>();
		if (isBlankOrNull(data))
			return list;
		StringTokenizer st = new StringTokenizer(data, separator);
		while (st.hasMoreTokens()) {
			String token = st.nextToken();
			list.add(token);
		}
		return list;
	}

	public static String convertArrayListIntoCommaSptdString(ArrayList arrayList) {
		String commaSptdString = "";
		try {
			for (int i = 0; i < arrayList.size(); i++) {
				if (i != (arrayList.size() - 1)) {
					commaSptdString = commaSptdString + arrayList.get(i) + ", ";
				} else {
					commaSptdString = commaSptdString + arrayList.get(i);
				}
			}
		} catch (Exception e) {
			TPLogger.getLogger().error("error while converting String array into String", e);
		}
		return commaSptdString;
	}

	public static String convertArrayIntoCommaSptdString(String[] arr) {
		String commaSptdString = "";
		try {
			for (int i = 0; arr != null && i < arr.length; i++) {
				
				if (i != (arr.length - 1)) {
					commaSptdString += arr[i]==null?"": arr[i]+ ", ";
				} else {
					commaSptdString += arr[i]==null?"": arr[i];
				}
			}
		} catch (Exception e) {
			TPLogger.getLogger().error("error while converting String array into String", e);
		}
		return commaSptdString;
	}

	public static String getXMLForSessionExpiry() {
		return "<?xml version=\"1.0\" standalone=\"yes\"?><session-expired>1</session-expired>";
	}

	public static String getXMLForError() {
		ArrayList<String> errors = new ArrayList<String>();
		errors.add("Error");
		return getXMLForError(errors);
	}

	public static String getXMLForError(List errors) {
		StringWriter sWr = new StringWriter();
		XMLWriter wr = new XMLWriter(sWr);
		try {
			wr.startDocument();
			wr.startElement("errors");
			if (errors != null && errors.size() > 0) {
				for (int indx = 0; indx < errors.size(); indx++) {
					wr.startElement("error");
					wr.characters((String) errors.get(indx));
					wr.endElement("error");
				}
			}
			wr.endElement("errors");
			wr.endDocument();
		} catch (Exception e) {
			TPLogger.getLogger().error("Error while creating error xml", e);
		}
		return sWr.toString();
	}

	public static String getXMLForIds(String commaSepids) {
		StringWriter sWr = new StringWriter();
		XMLWriter wr = new XMLWriter(sWr);
		String[] ids = commaSepids.split(",");
		try {
			wr.startDocument();
			wr.startElement("ids");
			for (int i = 0; i < ids.length; i++) {
				wr.startElement("id");
				wr.characters(ids[i]);
				wr.endElement("id");
			}
			wr.endElement("ids");
			wr.endDocument();
		} catch (Exception e) {
			TPLogger.getLogger().error("Error while getting XML content for Delete Email", e);
		}
		return sWr.getBuffer().toString();
	}

	public static String getXMLForTagName(String tagName, String jsArray) {
		StringWriter sWr = new StringWriter();
		XMLWriter wr = new XMLWriter(sWr);
		try {
			wr.startDocument();
			wr.startElement(tagName);
			wr.characters(isBlankOrNull(jsArray) ? "" : jsArray);
			wr.endElement(tagName);
			wr.endDocument();
		} catch (Exception e) {
			TPLogger.getLogger().error("Error", e);
		}
		return sWr.toString();
	}

	public static String getHostName() throws UnknownHostException {
		java.net.InetAddress i = java.net.InetAddress.getLocalHost();
		return i.getHostName();
	}

	/**
	 * Method to build the search filter string.
	 * 
	 * @param cData
	 *            The search criteria data.
	 * @return The search filter string.
	 */
	public static String getSearchFilterString(SearchCriteriaData cData) {
		StringBuffer sb = new StringBuffer();
		if (!Utils.isBlankOrNull(cData.getDegree())) {
			if (cData.getDegreeCriteria().equals(SearchConstants.OR)) {
				sb.append("Any ");
			} else {
				sb.append("All ");
			}
			String[] arrDegreeIds = cData.getDegree().split(",");
			for (int i = 0; arrDegreeIds != null && i < arrDegreeIds.length; i++) {
				String degreeId = arrDegreeIds[i].trim();
				if (i > 0) {
					sb.append(", ");
				}
				sb.append(CommonUtils.getDegreeName(degreeId));
			}
			sb.append(" | ");
		}
		if (!Utils.isBlankOrNull(cData.getBranch())) {
			String[] arrDegreeIds = cData.getBranch().split(",");
			for (int i = 0; arrDegreeIds != null && i < arrDegreeIds.length; i++) {
				String branchId = arrDegreeIds[i].trim();
				if (i > 0) {
					sb.append(", ");
				}
				sb.append(CommonUtils.getBranchName(branchId));
			}
			sb.append(" | ");
		}
		if (!Utils.isBlankOrNull(cData.getSourceTypeId())) {
			sb.append(CommonUtils.getSourceTypeName(cData.getSourceTypeId()) + " | ");
		}

		if (!Utils.isBlankOrNull(cData.getResumeTypeId())) {
			sb.append(CommonUtils.getResumeTypeName(cData.getResumeTypeId()) + " | ");
		}

		if (!Utils.isBlankOrNull(cData.getSource())) {
			sb.append(cData.getSource() + " | ");
		}
		if (!Utils.isBlankOrNull(cData.getCurrentEmployer())) {
			sb.append(cData.getCurrentEmployer() + " | ");
		}
		if (!Utils.isBlankOrNull(cData.getPassport())) {
			sb.append(cData.getPassport() + " | ");
		}
		if (!Utils.isBlankOrNull(cData.getCurrentLocation())) {
			sb.append(cData.getCurrentLocation() + " | ");
		}
		if (!Utils.isBlankOrNull(cData.getImportDaysFilter()) && !"-1".equals(cData.getImportDaysFilter())) {
			sb.append(TPLabels.getLabel("search_applicant.home.label.import_date") + " " + getFilterString(cData.getImportDaysFilter(), cData.getImportDaysFromDate(), cData.getImportDaysToDate()));
		}
		if (!Utils.isBlankOrNull(cData.getBirthDayFilter()) && !"-1".equals(cData.getBirthDayFilter())) {
			sb.append(TPLabels.getLabel("search_applicant.home.label.date_of_birth") + " " + getFilterString(cData.getBirthDayFilter(), cData.getBirthDaysFromDate(), cData.getBirthDaysToDate()));
		}
		if (!Utils.isBlankOrNull(cData.getLastInteractionFilter()) && !"-1".equals(cData.getLastInteractionFilter())) {
			sb.append(TPLabels.getLabel("search_applicant.home.label.last_interaction") + " " + getFilterString(cData.getLastInteractionFilter(), cData.getLastInteractionFromDate(), cData.getLastInteractionToDate()));
		}
		if (cData.getExcludeInprocess().equals(SearchConstants.SEARCH_NOT_INPROCESS)) {
			sb.append(TPLabels.getLabel("search_applicant.home.label.exclude_candidates_in_process"));
			if (!isBlankOrNull(cData.getExcludeRejectedInPast())) {
				sb.append(", " + TPLabels.getLabel("search_applicant.home.label.exclude_rejected"));
			}
			sb.append(" | ");
		} else if (cData.getExcludeInprocess().equals(SearchConstants.SEARCH_INPROCESS)) {
			sb.append(TPLabels.getLabel("search_applicant.home.label.candidates_in_process") + " | ");
		}else if(SearchConstants.SEARCH_BLACKLISTED.equals(cData.getExcludeInprocess())){
			sb.append(TPLabels.getLabel("black_list.label.blackListed") + " | ");
		}else if(SearchConstants.SEARCH_APPLIED_STAGE.equals(cData.getExcludeInprocess())){
			sb.append(TPLabels.getLabel("search_applicant.home.label.candidates_in_applied") + " | ");
		}
		if (!Utils.isBlankOrNull(cData.getRejectReason())) {
			sb.append(TPLabels.getLabel("search_applicant.home.label.include_rejected") + " ");
			String[] arrDegreeIds = cData.getRejectReason().split(",");
			for (int i = 0; arrDegreeIds != null && i < arrDegreeIds.length; i++) {
				String rejectId = arrDegreeIds[i].trim();
				if (i > 0) {
					sb.append(", ");
				}
				if (rejectId.equals(SearchConstants.REJECTED_IN_SHORTLIST)) {
					sb.append(TPLabels.getLabel("search_applicant.home.label.rejected_in_shortlist"));
				} else if (rejectId.equals(SearchConstants.REJECTED_IN_SELECTION)) {
					sb.append(TPLabels.getLabel("search_applicant.home.label.rejected_in_selection"));
				} else if (rejectId.equals(SearchConstants.REJECTED_IN_HIRE)) {
					sb.append(TPLabels.getLabel("search_applicant.home.label.rejected_in_hire"));
				} else if (rejectId.equals(SearchConstants.REJECTED_POSITION_CLOSED)) {
					sb.append(TPLabels.getLabel("common.due_to")+" "+TPLabels.getLabel("common.position")+" "+TPLabels.getLabel("common.closed"));
				}
			}
			sb.append(" | ");
		}
		if (!Utils.isBlankOrNull(cData.getFlag())) {
			String[] arrDegreeIds = cData.getFlag().split(",");
			for (int i = 0; arrDegreeIds != null && i < arrDegreeIds.length; i++) {
				String flagId = arrDegreeIds[i].trim();
				if (i > 0) {
					sb.append(", ");
				}
				sb.append(CommonUtils.getFlagText(flagId));
			}
			sb.append(" | ");
		}

		ArrayList<CustomFieldData> customFields = cData.getCustomFields();
		if (customFields != null) {
			for (int i = 0; i < customFields.size(); i++) {
				CustomFieldData customFieldData = customFields.get(i);
				String vals = convertArrayIntoCommaSptdString(customFieldData.getFieldValues());

				if (!isBlankOrNull(vals)) {
					if (customFieldData.getFieldType().equals(CustomFieldConstants.TYPE_NUMBER) || customFieldData.getFieldType().equals(CustomFieldConstants.TYPE_DATE)) {
						if (!isBlankOrNull(customFieldData.getRangeCriteria())) {
							if (customFieldData.getRangeCriteria().equals(SearchConstants.CRITERIA_EQUAL_TO)) {
								sb.append("Equals to " + vals + " | ");
							} else if (customFieldData.getRangeCriteria().equals(SearchConstants.CRITERIA_GREATER_THAN)) {
								sb.append("Greater than " + vals + " | ");
							} else if (customFieldData.getRangeCriteria().equals(SearchConstants.CRITERIA_LESS_THAN)) {
								sb.append("Less than " + vals + " | ");
							} else if (customFieldData.getRangeCriteria().equals(SearchConstants.CRITERIA_BETWEEN)) {
								String[] valsto = customFieldData.getToValues();
								sb.append("Between " + vals + " and " + valsto[0] + " | ");
							} else if (customFieldData.getRangeCriteria().equals(SearchConstants.CRITERIA_NOT_SPECIFIED)) {
								sb.append(SearchConstants.CRITERIA_NOT_SPECIFIED + " | ");
							}
						}
					} else {
						sb.append(vals + " | ");
					}

				}
			}
		}
		String filterStr = sb.toString();
		if (filterStr.length() > 0) {
			filterStr = filterStr.substring(0, filterStr.length() - 2);
		}
		return filterStr;
	}

	private static String getFilterString(String range, java.util.Date fromVal, java.util.Date toVal) {
		StringBuffer sb = new StringBuffer();
		String toValString = DateUtils.getSystemDateFormat(toVal);
		String fromValString = DateUtils.getSystemDateFormat(fromVal);
		if (SearchConstants.CRITERIA_EQUAL_TO.equals(range)) {
			sb.append("Equals to " + fromValString + " | ");
		} else if (SearchConstants.CRITERIA_GREATER_THAN.equals(range)) {
			sb.append("Greater than " + fromValString + " | ");
		} else if (SearchConstants.CRITERIA_LESS_THAN.equals(range)) {
			sb.append("Less than " + fromValString + " | ");
		} else if (SearchConstants.CRITERIA_BETWEEN.equals(range)) {			
			sb.append("Between " + fromValString + " and " + toValString + " | ");
		} else if (SearchConstants.CRITERIA_NOT_SPECIFIED.equals(range)) {
			sb.append(SearchConstants.CRITERIA_NOT_SPECIFIED + " | ");
		}
		return sb.toString();
	}
	/**
	 * Creates list from passed arrayList of SimpleDO using property param This is used for
	 * autocompleter code
	 * 
	 * @param lst
	 * @param param
	 * @return
	 */
	public static String getListInXML(ArrayList lst, String param) {
		StringWriter sWr = new StringWriter();
		try {
			if (lst != null) {
				XMLWriter wr = new XMLWriter(sWr);
				wr.startDocument();
				wr.startElement("ul");
				for (int i = 0; i < lst.size(); i++) {
					SimpleDataObject sdo = (SimpleDataObject) lst.get(i);
					String name = sdo.getString(param);
					wr.startElement("li");
					wr.characters(name);
					wr.endElement("li");
				}
				wr.endElement("ul");
				wr.endDocument();
			}
		} catch (SAXException e) {
			TPLogger.getLogger().error("Error while getting xml from list", e);
		}
		return sWr.getBuffer().toString();
	}	
	
	
