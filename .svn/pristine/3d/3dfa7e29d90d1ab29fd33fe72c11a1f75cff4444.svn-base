	@SuppressWarnings("unchecked")
	public static void escapeJavaScript(SimpleDataObject sdo) {
		Map sdoMap =  sdo.getAttributes();
		Iterator  objMapIterator =  sdoMap.entrySet().iterator();
		Map.Entry pairs = null;
		while (objMapIterator.hasNext()) {
	        pairs = (Map.Entry)objMapIterator.next();
	        if(pairs.getValue()instanceof java.lang.String){
	        	sdoMap.put(pairs.getKey(), Utils.escapeJavaScript(pairs.getValue().toString()));
	        }
	    }
	}
	
