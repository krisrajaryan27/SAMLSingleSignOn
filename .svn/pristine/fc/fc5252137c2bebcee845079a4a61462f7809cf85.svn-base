package com.talentPool.salaryStructure.databject;

import com.talentPool.common.db.SimpleDataObject;

/**
 * @author praveen
 * 
 */
public class SalaryComponentsData extends SimpleDataObject {

	public String getSalaryComponentId() {
		return getString("salaryComponentId");
	}
	
	public void setSalaryComponentId(String salaryComponentId) {
		setAttribute("salaryComponentId", salaryComponentId);
	}
	
	public String getSalaryComponentName() {
		return getString("salaryComponentName");
	}
	
	public void setSalaryComponentName(String salaryComponentName) {
		setAttribute("salaryComponentName", salaryComponentName);
	}
	
	public String getSalaryComponentDescription() {
		return getString("salaryComponentDescription");
	}
	
	public void setSalaryComponentDescription(String salaryComponentDescription) {
		setAttribute("salaryComponentDescription", salaryComponentDescription);
	}
	
	public String getSalaryComponentType() {
		return getString("salaryComponentType");
	}
	
	public void setSalaryComponentType(String salaryComponentType) {
		setAttribute("salaryComponentType", salaryComponentType);
	}
	
	public String getSalaryComponentCategoryName() {
		return getString("salaryComponentCategoryName");
	}
	
	public void setSalaryComponentCategoryName(String salaryComponentCategoryName) {
		setAttribute("salaryComponentCategoryName", salaryComponentCategoryName);
	}
	
	public String getSalaryComponentCategoryId() {
		return getString("salaryComponentCategoryId");
	}
	
	public void setSalaryComponentCategoryId(String salaryComponentCategoryId) {
		setAttribute("salaryComponentCategoryId", salaryComponentCategoryId);
	}
	
	public String getSystemDefined() {
		return getString("systemDefined");
	}
	
	public void setSystemDefined(String systemDefined) {
		setAttribute("systemDefined", systemDefined);
	}
	
}