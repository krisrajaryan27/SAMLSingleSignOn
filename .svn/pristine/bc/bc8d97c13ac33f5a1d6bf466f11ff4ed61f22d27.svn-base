package com.talentPool.customReports.dataobject;

import com.talentPool.common.db.SimpleDataObject;

public class PositionSummaryData extends SimpleDataObject{

	public String getPositionId() {
		return getString("positionId");
	}
	
	public void setPositionId(String positionId) {
		setAttribute("positionId", positionId);
	}
	
	public String getUserId() {
		return getString("userId");
	}
	
	public void setUserId(String userId) {
		setAttribute("userId", userId);
	}
	
	public String getshortlist() {
		return getString("shortlist");
	}
	
	public void setshortlist(String shortlist) {
		setAttribute("shortlist", shortlist);
	}
	
	public String getSelection() {
		return getString("selection");
	}
	
	public void setselection(String selection) {
		setAttribute("selection", selection);
	}
	
	public String getOffer() {
		return getString("offer");
	}
	
	public void setOffer(String offer) {
		setAttribute("offer", offer);
	}
	
	public String getJoined() {
		return getString("joined");
	}
	
	public void setJoined(String joined) {
		setAttribute("joined", joined);
	}
	
	public String getReject() {
		return getString("reject");
	}
	
	public void setReject(String reject) {
		setAttribute("reject", reject);
	}
}
