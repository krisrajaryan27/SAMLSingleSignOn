package com.talentPool.salaryStructure.databject;

/**
 * @author PraveenK
 * @since  Apr 25, 2012
 */
public class SalaryCategoriesComparisonData {
	
	private String categoryId;
	private String categoryName;
	private Integer existingVal;
	private Integer proposedVal;
	/**
	 * @return the categoryId
	 */
	public String getCategoryId() {
		return categoryId;
	}
	/**
	 * @param categoryId the categoryId to set
	 */
	public void setCategoryId(String categoryId) {
		this.categoryId = categoryId;
	}
	/**
	 * @return the categoryName
	 */
	public String getCategoryName() {
		return categoryName;
	}
	/**
	 * @param categoryName the categoryName to set
	 */
	public void setCategoryName(String categoryName) {
		this.categoryName = categoryName;
	}
	/**
	 * @return the existingVal
	 */
	public Integer getExistingVal() {
		return existingVal;
	}
	/**
	 * @param existingVal the existingVal to set
	 */
	public void setExistingVal(Integer existingVal) {
		this.existingVal = existingVal;
	}
	/**
	 * @return the proposedVal
	 */
	public Integer getProposedVal() {
		return proposedVal;
	}
	/**
	 * @param proposedVal the proposedVal to set
	 */
	public void setProposedVal(Integer proposedVal) {
		this.proposedVal = proposedVal;
	}
	
}
