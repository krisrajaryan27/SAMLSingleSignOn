package com.talentPool.positions.form;

import org.apache.struts.upload.FormFile;

import com.talentPool.common.base.TPActionForm;

public class PositionDraftForm extends TPActionForm{
	private String draftId;
	private String fileName;
	private String showStatus;
	private FormFile attachedFile;
	private String filePath;
	private String listById;
	private String draftName;
	private String positionId;
	/**
	 * @return the draftId
	 */
	public String getDraftId() {
		return draftId;
	}
	/**
	 * @param draftId the draftId to set
	 */
	public void setDraftId(String draftId) {
		this.draftId = draftId;
	}
	/**
	 * @return the fileName
	 */
	public String getFileName() {
		return fileName;
	}
	/**
	 * @param fileName the fileName to set
	 */
	public void setFileName(String fileName) {
		this.fileName = fileName;
	}
	/**
	 * @return the showStatus
	 */
	public String getShowStatus() {
		return showStatus;
	}
	/**
	 * @param showStatus the showStatus to set
	 */
	public void setShowStatus(String showStatus) {
		this.showStatus = showStatus;
	}
	/**
	 * @return the attachedFile
	 */
	public FormFile getAttachedFile() {
		return attachedFile;
	}
	/**
	 * @param attachedFile the attachedFile to set
	 */
	public void setAttachedFile(FormFile attachedFile) {
		this.attachedFile = attachedFile;
	}
	/**
	 * @return the filePath
	 */
	public String getFilePath() {
		return filePath;
	}
	/**
	 * @param filePath the filePath to set
	 */
	public void setFilePath(String filePath) {
		this.filePath = filePath;
	}
	/**
	 * @return the listById
	 */
	public String getListById() {
		return listById;
	}
	/**
	 * @param listById the listById to set
	 */
	public void setListById(String listById) {
		this.listById = listById;
	}
	/**
	 * @return the draftName
	 */
	public String getDraftName() {
		return draftName;
	}
	/**
	 * @param draftName the draftName to set
	 */
	public void setDraftName(String draftName) {
		this.draftName = draftName;
	}
	/**
	 * @return the positionId
	 */
	public String getPositionId() {
		return positionId;
	}
	/**
	 * @param positionId the positionId to set
	 */
	public void setPositionId(String positionId) {
		this.positionId = positionId;
	}
}
