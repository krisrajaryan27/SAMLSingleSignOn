package com.talentPool.common.dataobject;

/**
 * @author PraveenK
 * @since  Nov 15, 2011
 */
public class DHTMLXUserData {
	
	private String userDataName;
	private String userDataValue;
	
	
	/**
	 * @param userDataName
	 * @param userDataValue
	 */
	public DHTMLXUserData(String userDataName, String userDataValue){
		this.userDataName=userDataName;
		this.userDataValue=userDataValue;
	}
	
	/**
	 * @return the userDataName
	 */
	public String getUserDataName() {
		return userDataName;
	}
	/**
	 * @param userDataName the userDataName to set
	 */
	public void setUserDataName(String userDataName) {
		this.userDataName = userDataName;
	}
	/**
	 * @return the userDataValue
	 */
	public String getUserDataValue() {
		return userDataValue;
	}
	/**
	 * @param userDataValue the userDataValue to set
	 */
	public void setUserDataValue(String userDataValue) {
		this.userDataValue = userDataValue;
	}

}
