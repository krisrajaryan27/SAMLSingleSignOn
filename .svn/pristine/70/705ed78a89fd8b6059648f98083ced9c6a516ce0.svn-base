package com.talentPool.positions.dataobject;

import com.talentPool.common.db.SimpleDataObject;

public class PositionRespData extends SimpleDataObject {

	public PositionRespData() {

	}
	public String getPositionId() {
		return getId("positionId");
	}

	public void setPositionId(String positionId) {
		setAttribute("positionId", positionId);
	}

	public int getResponsibilityId() {
		return getInt("responsibilityId");
	}

	public void setResponsibilityId(String responsibilityId) {
		setAttribute("responsibilityId", responsibilityId);
	}

	public String getResponsibilityText() {
		return getString("responsibilityText");
	}

	public void setResponsibilityText(String responsibilityText) {
		setAttribute("responsibilityText", responsibilityText);
	}

	public void setResponsibilityRank(int responsibilityRank) {
		setAttribute("responsibilityRank", new Integer(responsibilityRank));
	}

	public int getResponsibilityRank() {
		return getInt("responsibilityRank");
	}
}
