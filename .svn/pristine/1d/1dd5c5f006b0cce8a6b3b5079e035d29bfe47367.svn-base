									</td>									
									<td>										
										<input type="text" name="employmentEmployerId" size="13" maxlength="100" value="<%=(employmentEmployerId[i]==null)?"":employmentEmployerId[i]%>" id="employmentEmployerId[<%= i %>]" class="Grey" />
										<script	language="JavaScript">
											new Ajax.Autocompleter("employmentEmployerId[<%=i%>]", "autocomplete", "importResume.do?mode=getAutoCompleteList&fld=<%=ApplicantConstants.AUTOCOMPLETE_EMPLOYMENT_EMPLOYER%>", {frequency: 0.001});
										</script>
									</td>									
									<td>
										<input type="text" name="employmentDesignationId" size="13" maxlength="100" value="<%=(employmentDesignationId[i]==null)?"":employmentDesignationId[i]%>" id="employmentDesignationId[<%= i %>]" class="Grey" />
										<script	language="JavaScript">
											new Ajax.Autocompleter("employmentDesignationId[<%=i%>]", "autocomplete", "importResume.do?mode=getAutoCompleteList&fld=<%=ApplicantConstants.AUTOCOMPLETE_EMPLOYMENT_DESIGNATION%>", {frequency: 0.001});
										</script>											
									</td>									
									<td>
