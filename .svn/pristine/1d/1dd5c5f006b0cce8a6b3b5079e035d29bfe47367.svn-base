function onBlurYop(event){
	var el =Event.element(event);
	getFormattedYear(el);
}
function onEduOptClick(event){
	var el =Event.element(event); 
	var level = el.id.substring(4, el.id.length);
	onOptionChange("edu",level);
}

function onEmpHistoryOptClick(event){
	var el =Event.element(event); 
	var level = el.id.substring(4, el.id.length);
	onOptionChange("empHistory",level);
}

function onBlurEmpHistoryFromDate(event,level){
	var el=Event.element(event);
	getFormattedDateRelevance(el,level);	
}

function onBlurEmpHistoryToDate(event,elFrom,level){
	var el=Event.element(event);
	getFormattedDateRelevance(el,level);			
}

function onBlurEmpHistoryExpr(event,from,to,level){	
	onBlurEmpHistoryExperience(event,from.value,to.value,level);					
}

function onBlurEmpHistoryExperience(event,fromDate,toDate,level){
	var from = $("employmentFromDate["+level+"]").value;
	var to = $("employmentToDate["+level+"]").value;
	if(yrf.getDateObject(to)>=yrf.getDateObject(from)){
		var pars = "mode=getEmployerExperience&fromDt="+from+"&toDt="+to+"&emplevel="+level;
		var myAjax = ajaxCall("importResume.do",'post',pars,setExtractedEmpExp, reportError);
	}	
}

function setExtractedEmpExp(request){
	xmlFile = request.responseXML;
	var empExp = xmlFile.getElementsByTagName("ids")[0];	
	if(empExp!=null){		
		var emex = empExp.getElementsByTagName('id')[0].firstChild.nodeValue;		
		var mon = emex.split("_");
		$("employmentExperience["+mon[1]+"]").value=mon[0];		
	}
}




function onDateBlur(e){
	getFormattedDate(this);
}
function onYearBlur(e){
	getFormattedYear(this);
}
function onCalClick(e){
	cal.showCalender(this.id.substr(2,this.id.length),this.id.substr(2,this.id.length));
}

