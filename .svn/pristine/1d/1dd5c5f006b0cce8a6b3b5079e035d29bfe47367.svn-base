<DIV id="calDiv" style="position:absolute;background:#FFFFFF;z-index:1000;" ></DIV>
<script>

function escapeHtml(unsafe) {
    return unsafe
         .replace(/&/g, "&amp;")
         .replace(/</g, "&lt;")
         .replace(/>/g, "&gt;")
         .replace(/"/g, "&quot;")
         .replace(/'/g, "&#039;");
 }

var popUpCal = new CalendarPopup("calDiv"); 
popUpCal.showNavigationDropdowns();
function getFNumber(obj){
	if(obj.value.trim()!=''){
		if(isNaN(obj.value)){
			alert('<bean:message key="common.please_enter_valid_number" />');
			obj.focus();
			return false;
		}
	}
}
var frm = document.applicantForm;

var empHistoryCount=<%=totalEmpHistRows%>;
var empHistoryTable = $('tableEmpHistory');
var empHistorySelected = -1;


var eduCount=<%=totalEduRows%>;
var eduTable = $('tblEdu');
var eduSelected = -1;

function registerListener(target,fieldType){
	var tbl = $(target);	
	for(i=0;i<tbl.rows.length;i++){
		if(tbl.rows[i].id !=""){
			addListener(tbl.rows[i],fieldType);
		}
	}
}
function addListener(row,fieldType){
	Event.observe(row, "click", onRowClick.bindAsEventListener(this,fieldType));
	Event.observe(row, "keydown", onRowKeyDown.bindAsEventListener(this,fieldType));
	Event.observe(row, "keyup", onRowKeyUp.bindAsEventListener(this,fieldType));
}


function onRowClick(event,fieldType){
	var row = Event.findElement(event, 'tr');
	onOptionChange(fieldType,row.id);
}
function onRowKeyDown(event,fieldType){
	onRowClick(event,fieldType);
}
function onRowKeyUp(event,fieldType){
	onRowClick(event,fieldType);
}

