//CODE TO EXTRACT SKILLS FROM RAW SKILLS ENTERED
function getExtractedSkills(){
	var rawSkills = frm.rawPrimarySkills.value;
	//rawSkills = rawSkills.replace(/\r/g ," ");
	//rawSkills =rawSkills.replace(/%/g ,"%25").replace(/\+/g, '%2B').replace(/\"/g,'%22').replace(/\'/g, '%27').replace(/\//g,'%2F');
	rawSkills =encodeURIComponent(rawSkills);//.replace(/\&/g, '%26');
	//rawSkills =rawSkills.replace(/\+/g, '%2B');
	
	var pars = "mode=getExtractedSkills&rawPrimarySkills="+rawSkills;
	var myAjax = ajaxCall("importResume.do",'post',pars,setExtractedSkills, reportError);
	
}
function setExtractedSkills(request){
	xmlFile = request.responseXML;
	if(!isValidSession(xmlFile,'')){
		redirectUser('<%=TPApplicationProperties.getProperty("redirect_on_session_expired")%>');
	}
	//frm.primarySkills.value='';
	var skills = xmlFile.getElementsByTagName('skills');
	var skillIds = frm.primarySkillIds.value;
	var skillNames=$("divPrimarySkills").innerHTML;
	if(skills!=null ){
		if(skills[0]!=null){
			var skill = skills[0].getElementsByTagName('skill');
			for(i=0;i<skill.length;i++){
				var id =skill[i].getElementsByTagName('id')[0].firstChild.nodeValue;
				var name = skill[i].getElementsByTagName('name')[0].firstChild.nodeValue;

				var arrIds = skillIds.split(',');
				var exist=0;
				for(k=0;k<arrIds.length;k++){
					if(arrIds[k]==id){
						exist=1;
						break;
					}
				}
				if(exist==0){
					if(skillIds.length>0){
						skillIds = skillIds + ',' + id;
						skillNames = skillNames + ', '+name;
					}else{
						skillIds = id;
						skillNames = name;
					}
				}
			}
		}
	}
	frm.primarySkillIds.value = skillIds;
	$("divPrimarySkills").innerHTML=skillNames;
	frm.primarySkills.value=skillNames;

}

function clearExtractedSkills(){
	frm.primarySkillIds.value = '';
	$("divPrimarySkills").innerHTML='';
}


function getExtractedEmploymentHistory(rawEmploymentHistory,level){
	rawEmploymentHistory =encodeURIComponent(rawEmploymentHistory);
	if(empHistorySelected > -1){
		level = empHistorySelected;
		var pars = "mode=getExtractedEmploymentHistory&rawEmploymentHistory="+rawEmploymentHistory+"&emplevel="+level;
		var myAjax = ajaxCall("importResume.do",'post',pars,setExtractedEmploymentHistory, reportError);
	}else{
		alert('Please select row to auto fill');
	}	
}

function setExtractedEmploymentHistory(request){
	xmlFile = request.responseXML;	
	if(!isValidSession(xmlFile,'')){
		redirectUser('<%=TPApplicationProperties.getProperty("redirect_on_session_expired")%>');
	}
	var employmentHistory = xmlFile.getElementsByTagName('EmploymentHistory');
	if(employmentHistory!=null ){
		if(employmentHistory[0]!=null){
			var eLevel = employmentHistory[0].getElementsByTagName('level')[0].firstChild.nodeValue;

			var empHistFromDate="";
			if(employmentHistory[0].getElementsByTagName('empHistFromDate')[0].firstChild!=null){
				empHistFromDate =employmentHistory[0].getElementsByTagName('empHistFromDate')[0].firstChild.nodeValue;
			}
			if(empHistFromDate!=""){
				$("employmentFromDate["+eLevel+"]").value=empHistFromDate;
			}

			var empHistToDate="";
			if(employmentHistory[0].getElementsByTagName('empHistToDate')[0].firstChild!=null){
				empHistToDate =employmentHistory[0].getElementsByTagName('empHistToDate')[0].firstChild.nodeValue;
			}
			if(empHistToDate!=""){
				$("employmentToDate["+eLevel+"]").value=empHistToDate;
			}

			var empName="";
			if(employmentHistory[0].getElementsByTagName('employerName')[0].firstChild!=null){
				empName =employmentHistory[0].getElementsByTagName('employerName')[0].firstChild.nodeValue;
			}
			if(empName!=""){
				$("employmentEmployerId["+eLevel+"]").value=empName;
			}

			var desigName="";
			if(employmentHistory[0].getElementsByTagName('designationName')[0].firstChild!=null){
				desigName =employmentHistory[0].getElementsByTagName('designationName')[0].firstChild.nodeValue;
			}
			if(desigName!=""){
				$("employmentDesignationId["+eLevel+"]").value=desigName;
			}
			
		}
	}		
}

function getExtractedEducation(rawEducation,level){
	rawEducation =encodeURIComponent(rawEducation);//.replace(/\&/g, '%26');
	if(eduSelected > -1){
		level = eduSelected;
		var pars = "mode=getExtractedEducation&rawEducation="+rawEducation+"&educationLevel="+level;
		var myAjax = ajaxCall("importResume.do",'post',pars,setExtractedEducation, reportError);
	}else{
		alert('Please select row to auto fill');
	}
	
}

function setExtractedEducation(request){
	xmlFile = request.responseXML;	
	if(!isValidSession(xmlFile,'')){
		redirectUser('<%=TPApplicationProperties.getProperty("redirect_on_session_expired")%>');
	}
	var educations = xmlFile.getElementsByTagName('education');
	if(educations!=null ){
		if(educations[0]!=null){
			var eLevel = educations[0].getElementsByTagName('level')[0].firstChild.nodeValue;
			var degreeId =educations[0].getElementsByTagName('degreeId')[0].firstChild.nodeValue;
			
			var branchId =educations[0].getElementsByTagName('branchId')[0].firstChild.nodeValue;
			var institute="";
			if(educations[0].getElementsByTagName('institute')[0].firstChild!=null){
				institute =educations[0].getElementsByTagName('institute')[0].firstChild.nodeValue;
			}
			var yop ="";
			if(educations[0].getElementsByTagName('year')[0].firstChild!=null){
				yop =educations[0].getElementsByTagName('year')[0].firstChild.nodeValue;
			}
			
			
			if(yop != ""){
				$("educationYearOfPassing["+eLevel+"]").value=yop;
			}
			if(institute!=""){
				$("educationInstitute["+eLevel+"]").value=institute;
			}
			if(degreeId>0){
				for(var i=0; i<degreeControls.length; i++){
					if(degreeControls[i][0]==eLevel){
						var cbo = degreeControls[i][1];
						cbo.setSelected(cbo.getIndexWithId(degreeId));
					}
				}
			}
			if(branchId>0){
				for(var i=0; i<branchControls.length; i++){
					if(branchControls[i][0]==eLevel){
						var cbo = branchControls[i][1];
						cbo.setSelected(cbo.getIndexWithId(branchId));
					}
				}
			}
		}
	}	
}

function onClickTotalExperience(obj){
	var totalExp="";
	var years = 0;	
	var months = 0;
	var valCurr = $("applicantWorkingSince").value;
	if(valCurr == "" || valCurr == 0){
		for(var i=0;i<empHistoryCount;i++){
			if($("employmentExperience["+i+"]") != null && $("employmentExperience["+i+"]").value!='' && $("employmentExperience["+i+"]").value!=null){
				totalExp=$("employmentExperience["+i+"]").value.split(" ");
				if(totalExp[0]!=null && totalExp[0]!=''){		
					years = years + parseInt(totalExp[0].replace("yrs",""));
				}
				if(totalExp[1]!=null && totalExp[1]!=''){
					months = months + parseInt(totalExp[1].replace("months",""));
				}
			}		
		}
		if(months>11){
			years = years+Math.floor(months/12);
			months = months%12;
		}
		$('applicantWorkingSince').value=years+"."+months;	
	}
}
function getFormattedExperience(obj){
	if(obj.value.trim()!=''){
		if(isNaN(obj.value)){
			obj.select();			
			alert("Experience should be number");
			obj.focus();
			return false;
		}else {
			var yrmn= obj.value.split(".");
			if(yrmn[1]>11){
				obj.select();
				alert("Months should be less than 12");
				obj.focus();
				return false;
			}
			return true;
		}
	}
	return true;
}



//CALENDER CONTROL CODE AND FUNCTIONS
var cal = new MonthYearCalender('divCalender');
cal.setDisplayFormat('MMM-YYYY');
cal.setDateStyle('EU');

//DATE FORMATTER CODE AND FUNCTIONS
var dtfo = new DateFormatter();
function getFDate(obj,format){
	dtfo.setDisplayFormat(format);
	if(obj.value.trim()!=''){
	if(!dtfo.checkDate(obj)){
		obj.select();
		alert("Please enter date in " + format + " format");
		obj.focus();
		return false;
	}else {
		return true;
	}
	}
	return true;
}
var dtf = new DateFormatter();
dtf.setDisplayFormat('MMM-YYYY');
function getFormattedDate(obj){
	if(obj.value.trim()!=''){
	if(!dtf.checkDate(obj)){
		obj.select();
		alert("<bean:message key="add_applicant.errors.working_since_invalid_format"/>");
		obj.focus();
		return false;
	}else {
		return true;
	}
	}
	return true;
}

var yrf= new DateFormatter();
yrf.setDisplayFormat('MMM-YYYY');

function getFormattedYear(obj){
	if(obj.value.trim()!=''){
		if(yrf.getDateObject(obj.value)){
			obj.value=yrf.getDateObject(obj.value).getFullYear();
		}else if(yrf.getDateObject('01-'+obj.value)){
			obj.value=yrf.getDateObject('01-'+obj.value).getFullYear();
		}else{
			alert('<bean:message key="add_applicant.errors.yearofoassing_invalid_format"/>');
			obj.focus();
			return false;
		}
	}
	return true;
}
var toFromValid=false;
function getFormattedDateRelevance(obj,level){
	var from = $("employmentFromDate["+level+"]").value;
	var to = $("employmentToDate["+level+"]").value;
	if(from.trim()!='' && to.trim()!=''){
		if(yrf.getDateObject(from)>yrf.getDateObject(to) && !toFromValid){			
			obj.select();
			obj.focus();
			alert('from date '+from+' cannot be higher than to date '+to);
			toFromValid=true;
			return false;						
		}else{
			toFromValid=false;
		}
	}		
	getFormattedDate(obj);
	toFromValid=false;			
}

function setSourceId(){
	window.setTimeout("checkSourceId()", 500);
}
function checkSourceId(){
	var pars = "mode=getSourceId&source=" + document.applicantForm.source.value;
	var myAjax = ajaxCall("importResume.do",'get',pars,updateSourceId, reportError);
}
function updateSourceId(request){
 	xmlFile = request.responseXML;
	if(!isValidSession(xmlFile,'<%=TPApplicationProperties.getProperty("redirect_on_session_expired")%>'))return;
	if(!isErrorXml(xmlFile)){
		var op = xmlFile.getElementsByTagName("ids")[0];
		document.applicantForm.sourceId.value = op.childNodes[0].childNodes[0].nodeValue;
	}else{
		if(document.applicantForm.source.value !=''){
			alert(document.applicantForm.source.value + " is not a registered source");
			frm.source.focus();
		}
	}	
}

function onChangeSelectBoxSource(){
	var sourceVendor = $("employeeSourceAndVendorUser");
	var sourceEmpl = $('employeeSourceDiv');
	var srcId = selectBoxSource.getSelectedId();
	if(srcId=='0'){
		if(sourceEmpl){
	    	sourceEmpl.style.display = 'block';
	    	sourceVendor.style.display = 'none';
	    }
	}else if(srcId=='-2'){
		Element.hide("employeeSourceAndVendorUser");
		Element.hide("employeeSourceDiv");
		requestReloadSources();
	}else {    
		//sourceVendor.style.display = 'block';
		sourceEmpl.style.display = 'none';
	    showVendoruser(srcId);
	}
}
function requestReloadSources(){
    var pars = "mode=getAllSourcesWithoutEmployee";
	var myAjax = ajaxCall("importResume.do",'get',pars,reloadSources, reportError);
}
function reloadSources(request){
 	xmlFile = request.responseXML;
	if(!isValidSession(xmlFile,'<%=TPApplicationProperties.getProperty("redirect_on_session_expired")%>'))return;
	if(!isErrorXml(xmlFile)){
		var op = request.responseText;
		var opts = eval(op);
		var m = [new SelectOption('-1','<bean:message key="add_applicant.label.select_source"/>')];
		var n = [new SelectOption('0','<bean:write name="applicantForm" property="employeeSourceName" filter="false"/>',0,null,false,{cs:'mnuGreen'})];
		opts = m.concat(opts);
		opts = opts.concat(n);
		selectBoxSource.reInitialize(opts, '-1');
	}	
 
}

function showVendoruser(srcId){
    var pars = "mode=getVendorUserJS&sourceId=" + srcId;
	var myAjax = ajaxCall("importResume.do",'get',pars,updateVendoruser, reportError);
}

function updateVendoruser(request){
 	xmlFile = request.responseXML;
	if(!isValidSession(xmlFile,'<%=TPApplicationProperties.getProperty("redirect_on_session_expired")%>'))return;
	if(!isErrorXml(xmlFile)){
		var sourceEmpl = document.getElementById("employeeSourceAndVendorUser");
		var op = request.responseText;
		var opts = eval(op);
		if(opts==""){
    		sourceEmpl.style.display = 'none';
	    }else{
	    	sourceEmpl.style.display = 'block';
	    }
		selectBoxEmployeeSource.reInitialize(opts, '<bean:write name="applicantForm" property="vendorId"/>');
	}	
 
}

function onOptionChange(imgGroupName, attachmentId){	
	var imgs = getElementsByName_iefix("img",imgGroupName);
	for (i = 0; i < imgs.length; i++) {
		var theImage = imgs[i];
		if (theImage.id.indexOf("img") > -1) {
			if( theImage.id == 'img_'+attachmentId){
				if(imgGroupName=="empHistory"){
					empHistorySelected = attachmentId;
				}else{
					eduSelected = attachmentId;
				}
				theImage.src = "images/checkedradiobutton.gif";
			}else{
				theImage.src = "images/radiobutton.gif";
			}
		}
	}
}
function getElementsByName_iefix(tag, name) {
     var elem = document.getElementsByTagName(tag);
     var arr = new Array();
     for(i = 0,iarr = 0; i < elem.length; i++) {
          att = elem[i].getAttribute("name");
          if(att == name) {
               arr[iarr] = elem[i];
               iarr++;
          }
     }
     return arr;
}	
function onRadioChange(imgGroupName, attachmentId){
	<logic:empty name="applicantForm" property="sessionId">	
	var prevId = document.applicantForm.selAttachment.value;
	var imgs = document.getElementsByName(imgGroupName);
	
	for (i = 0; i < imgs.length; i++) {
			var theImage = imgs[i];
			if (theImage.id.indexOf("img") > -1) {
				if( theImage.id == 'img_'+attachmentId){
					document.applicantForm.selAttachment.value = attachmentId;
					theImage.src = "images/checkedradiobutton.gif";
				}else{
					theImage.src = "images/radiobutton.gif";
				}
			}
	}
	if(prevId != document.applicantForm.selAttachment.value){		
		var emailId = document.applicantForm.emailId.value;
		document.applicantForm.mode.value='importResume';
		if(confirm('<bean:message key="search_applicant.home.label.switch_resume"/>')){
			document.applicantForm.parse.value='1';
		}else{
			document.applicantForm.parse.value='2';
		}
		document.applicantForm.emailId.value=emailId;
		document.applicantForm.selAttachment.value=attachmentId;
		document.applicantForm.submit();
		//window.location= "importResume.do?mode=importResume&parse=1&subMode=<bean:write property="subMode" name="applicantForm"/>&emailId="+emailId+"&selAttachment="+attachmentId;
	}
	</logic:empty>
	<logic:notEmpty name="applicantForm" property="sessionId">	
	var prevId = document.applicantForm.uploadedFilePath.value;
	var imgs = document.getElementsByName(imgGroupName);
	for (i = 0; i < imgs.length; i++) {
			var theImage = imgs[i];
			if (theImage.id.indexOf("img") > -1) {
				if( theImage.id == 'img_'+attachmentId){
					document.applicantForm.uploadedFilePath.value = attachmentId;
					theImage.src = "images/checkedradiobutton.gif";
				}else{
					theImage.src = "images/radiobutton.gif";
				}
			}
	}
	if(prevId != document.applicantForm.uploadedFilePath.value){
		document.applicantForm.mode.value='importResume';
		if(confirm('<bean:message key="search_applicant.home.label.switch_resume"/>')){
			document.applicantForm.parse.value='1';
		}else{
			document.applicantForm.parse.value='2';
		}
		document.applicantForm.submit();				
	}
	</logic:notEmpty>
}
var fresher = "<bean:write  name="applicantForm" property="fresher"/>";
function checkFresher(){
	if(fresher=="" || fresher=="0"){
		$('cboFresher').src="images/checkboxunchecked.gif";
		document.applicantForm.fresher.value="0";
	}else{
		$('cboFresher').src="images/checkboxchecked.gif";
		document.applicantForm.fresher.value="1";
	}
	
}
function toggleFresher(){
	if(fresher=="" || fresher=="0"){
		fresher="1";
	}else{
		fresher="0";
	}
	checkFresher();
}

function toggleEmployeeApply(){
	var isEmpApply = document.applicantForm.isEmpApply.value;
	if(isEmpApply=="" || isEmpApply=="0"){
		$('cboIsEmpApply').src="images/checkboxchecked.gif";
		document.applicantForm.isEmpApply.value="1";
		toggleDiv('empCodeDiv');
	}else{
		$('cboIsEmpApply').src="images/checkboxunchecked.gif";
		document.applicantForm.isEmpApply.value="0";
		toggleDiv('empCodeDiv');
	}
}

function toggleConfidential(){
	var confidential = document.applicantForm.confidential.value;
	if(confidential=="" || confidential=="0"){
		$('cboConfidential').src="images/checkboxchecked.gif";
		document.applicantForm.confidential.value="1";
	}else{
		$('cboConfidential').src="images/checkboxunchecked.gif";
		document.applicantForm.confidential.value="0";
	}
}

function toggleDiv(divId){
	if($(divId).style.display=="block"){
		$(divId).style.display="none";
	}else{
		$(divId).style.display="block";
	}
}

function showEmployeeSource(){
	selectBoxSource.setSelected(selectBoxSource.getIndexWithId('0'));
	if($("employeeSource")){
		$("employeeSource").style.display="block";
	}
}
function setSourceOfIframe() {	
	var url = 'importResume.do?mode=getResumeToImport&ieImport=<%=request.getParameter("ieImport")%>&applicantId=<bean:write name="applicantForm" property="applicantId" />&originalResumePath=<bean:write name="applicantForm" property="originalResumePath" />&emailId=<bean:write name="applicantForm" property="emailId"/>&hilite=' +
		formatString('<bean:write name="applicantForm" property="applicantName"/>') + '|hl1' + ',' +
		formatString(selectBoxSource.getText(selectBoxSource.getIndexWithId(selectBoxSource.getSelectedId()))) + '|hl2' + ',' +
		formatString('<bean:write name="applicantForm" property="applicantCity"/>') + '|hl3' + ',' +
		formatString('<bean:write name="applicantForm" property="applicantHomePhone"/>') + '|hl4' + ',' +
		formatString('<bean:write name="applicantForm" property="applicantWorkPhone"/>') + '|hl5' + ',' +
		formatString('<bean:write name="applicantForm" property="applicantCellPhone"/>') + '|hl1' + ',' +
		formatString('<bean:write name="applicantForm" property="applicantEmail1"/>') + '|hl2' + ',' +
		formatString('<bean:write name="applicantForm" property="applicantEmail2"/>') + '|hl3';
	var skills = '<bean:write name="applicantForm" property="primarySkills" />';
	if(skills != null && skills != '') {
		parts = skills.split(',');
		for(var i = 0; i < parts.length; i++) {
			url += ',' + formatString(parts[i]) + '|hl4';
		}
	}	
	url += eduStr;
	url += ',' + formatString('<bean:write name="applicantForm" property="applicantWorkingSince"/>') + '|hl1';	
	url += ',' + formatString('<bean:write name="applicantForm" property="currentCTC"/>') + '|hl3';
	url += ',' + formatString('<bean:write name="applicantForm" property="expectedCTC"/>') + '|hl4';
	url += ',' + formatString('<bean:write name="applicantForm" property="noticePeriod"/>') + '|hl5';		
	window.frames['viewPort'].location.href = uncache(url);
}
	
function onWindowLoad(){
	setSourceOfIframe();
	<logic:equal property="saveNcontinue" name="applicantForm" value="2">
	<logic:equal name="noDuplicateFound" scope="request" value="1">
		alert('<bean:message key="inbox.message.no_duplicate_found"/>');
	</logic:equal>
	</logic:equal>
	<logic:notEmpty name="duplicates" scope="request">
		alert('<bean:message key="inbox.message.duplicate_found"/>');
	</logic:notEmpty>
	<logic:notEmpty name="fieldValueData" scope="request">
		var msg = '<bean:write name="fieldValueData" scope="request"/>';
		msg = msg.replace(/:::/g, "\n");
		//msg = "Based on \n" + msg + "\nduplicate record(s) found.\nDo you want to see duplicate record(s)?"
		msg = '<bean:message key="create_applicant.label.based_on"/>' + msg + '<bean:message key="create_applicant.label.duplicate_records_found"/>';
		var retVal = confirm(msg);
		if(retVal) {
			checkForDuplicates();
			return;
		}
	</logic:notEmpty>	
	
	<logic:equal property="subMode" name="applicantForm" value="edit">
	<%if(ImportConfigurationManager.isEditFieldShow(ImportConfigurationConstants.FIELD_EDUCATION)){ %>
		registerListener(eduTable,"edu");		
	<%}%>	
	<%if(ImportConfigurationManager.isEditFieldShow(ImportConfigurationConstants.FIELD_EXPERIENCE)){ %>
		checkFresher();
	<%}%>
	<%if(ImportConfigurationManager.isEditFieldShow(ImportConfigurationConstants.FIELD_EMPLOYMENT_HISTORY)){ %>
		registerListener(empHistoryTable,"empHistory");		
	<%}%>			
	</logic:equal>
	
	<logic:equal property="subMode" name="applicantForm" value="add">
	<%if(ImportConfigurationManager.isImportFieldShow(ImportConfigurationConstants.FIELD_EDUCATION)){ %>
		registerListener(eduTable,"edu");		
	<%}if(ImportConfigurationManager.isImportFieldShow(ImportConfigurationConstants.FIELD_EXPERIENCE)){ %>
		checkFresher();
	<%}if(ImportConfigurationManager.isImportFieldShow(ImportConfigurationConstants.FIELD_EMPLOYMENT_HISTORY)){ %>
		registerListener(empHistoryTable,"empHistory");		
	<%}%>
				
	</logic:equal>
	<logic:empty name="applicantForm" property="sessionId">	
	onRadioChange('rdo',document.applicantForm.selAttachment.value);
	</logic:empty>

	onOptionChange("edu",0);	
	onOptionChange("empHistory",0);
	
	<logic:notEmpty property="applicantId" name="applicantForm" >
	var isEmployeeSource = '<bean:write name="applicantForm" property="isEmployeeSource"/>';
	if(isEmployeeSource==1){
		showEmployeeSource();
	}else{
		showVendoruser('<%=applicantForm.getSourceId()%>');
	}
	</logic:notEmpty>	
	var workSince= '<bean:write name="applicantForm" property="applicantWorkingSince"/>';
	if(workSince==""){
		$("applicantWorkingSince").value="0.0";
	}
	//employee source autocomplete
	new Ajax.Autocompleter("source", "autocomplete", "importResume.do?mode=getAutoCompleteList&fld=<%=ApplicantConstants.AUTOCOMPLETE_SOURCE%>", {frequency: 0.001, callback: getAutocompleteQry});
		
}
function getAutocompleteQry(){
	var selId=selectBoxSource.getSelectedId();
	if(selId=="-1"){
		selId="";
	}
	return uncache("sourceTypeId="+selId+"&source="+document.applicantForm.source.value);
}	
window.onload=onWindowLoad;
</script>