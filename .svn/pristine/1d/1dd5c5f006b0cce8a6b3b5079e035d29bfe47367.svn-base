<% ArrayList customFields = (ArrayList)request.getAttribute("customFields"); %>
<% ArrayList customTables = (ArrayList)request.getAttribute("customTables"); %>
<script>
<%=CustomFieldUtils.getArrayForCustomFields(customFields)%>
</script>
<%
	ApplicantForm applicantForm = (ApplicantForm) request.getAttribute("applicantForm");

	PermissionSet permissionSet 		= (PermissionSet)request.getSession(false).getAttribute("permissionSet");
	boolean currentCTCViewable 			= true;
	boolean expectedCTCViewable 		= true;
	
	if("add".equals(applicantForm.getSubMode())){
		currentCTCViewable  = true;
		expectedCTCViewable = true;
	}else if("edit".equals(applicantForm.getSubMode())){
		currentCTCViewable  = ImportConfigurationManager.isCurrentCTCViewable(permissionSet);
		expectedCTCViewable = ImportConfigurationManager.isExpectedCTCViewable(permissionSet);
	}
	
	pageContext.setAttribute("currentCTCViewable",currentCTCViewable);
	pageContext.setAttribute("expectedCTCViewable",expectedCTCViewable);
	
	int totalEduRows = 0;
	int totalEmpHistRows = 0;
	ArrayList importFields = ImportConfigurationManager.getImportFields();
	ArrayList degreeIds = applicantForm.getDegreeIds();
	ArrayList degreeNames = applicantForm.getDegreeNames();
	ArrayList branchIds = CommonUtils.getBranchIds();
	ArrayList branchNames = CommonUtils.getBranchNames();
	
		
%>
<script language="JavaScript">
var selectBoxSource=null;
var selectBoxDegree=null;
var selectBoxBranch=null;
var selectBoxResumeType=null;
var selectBoxEmployeeSource=null;

var degreeControls = new Array();
var degreeOptions = <%=CommonUtils.getListJavaScriptArray(degreeIds,degreeNames)%>;
var m = [new SelectOption('-1','')];
degreeOptions = m.concat(degreeOptions);

var branchControls = new Array();
var branchOptions = <%=CommonUtils.getListJavaScriptArray(branchIds,branchNames)%>;
m = [new SelectOption('-1','')];

var frm = document.applicantForm;
branchOptions = m.concat(branchOptions);

function submitForm(saveAndContinue){
	if(validateForm()){
		setFormFields(saveAndContinue);
		showUpdater('submit',{setHeight: false, setWidth: false, offsetLeft: -50});
		if($('saveandcontinue')){
			Element.hide('saveandcontinue');					
		}
		if($('checkForDuplicates')){
			Element.hide('checkForDuplicates');					
		}
		frm.submit();
	}
	return;
}

function setFormFields(saveAndContinue) {
		if(degreeControls.length>1){
			for(var i=0; i<degreeControls.length; i++){
				frm.educationDegreeId[i].value=degreeControls[i][1].getSelectedId();
				frm.educationMajorId[i].value=branchControls[i][1].getSelectedId();
			}
		}else{
			if(degreeControls[0]!=null){
			frm.educationDegreeId.value=degreeControls[0][1].getSelectedId();
			frm.educationMajorId.value=branchControls[0][1].getSelectedId();
			}
		}
		
		<logic:equal property="subMode" name="applicantForm" value="add">
		<%if(ImportConfigurationManager.isImportFieldShow(ImportConfigurationConstants.FIELD_SOURCE)){%>
			var srcId = selectBoxSource.getSelectedId();
			if(srcId=='0'){
				srcId = frm.sourceId.value;
				frm.isEmployeeSource.value='1';
				frm.vendorId.value='';
			}else{
				if(selectBoxEmployeeSource.getSelectedId() &&  selectBoxEmployeeSource.getSelectedId()!='-1'){
					frm.vendorId.value=selectBoxEmployeeSource.getSelectedId();
				}else{
					frm.vendorId.value='';
				}
			}
			frm.sourceId.value=srcId;
		<%}%>
		<%if(ImportConfigurationManager.isImportFieldShow(ImportConfigurationConstants.FIELD_RESUME_TYPE)){%>
			if(selectBoxResumeType.getSelectedId()!='-1'){
				frm.resumeTypeId.value = selectBoxResumeType.getSelectedId();
			}
		<%}%>
		</logic:equal>
		
		<logic:equal property="subMode" name="applicantForm" value="edit">
		<%if(ImportConfigurationManager.isEditFieldShow(ImportConfigurationConstants.FIELD_SOURCE)){%>
			var srcId = selectBoxSource.getSelectedId();
			if(srcId=='0'){
				srcId = frm.sourceId.value;
				frm.isEmployeeSource.value='1';
				frm.vendorId.value='';
			}else{
				if(selectBoxEmployeeSource.getSelectedId() &&  selectBoxEmployeeSource.getSelectedId()!='-1'){
					frm.vendorId.value=selectBoxEmployeeSource.getSelectedId();
				}else{
					frm.vendorId.value='';
				}
			}
			frm.sourceId.value=srcId;
		<%}%>
		<%if(ImportConfigurationManager.isImportFieldShow(ImportConfigurationConstants.FIELD_RESUME_TYPE)){%>
			if(selectBoxResumeType.getSelectedId()!='-1'){
				frm.resumeTypeId.value = selectBoxResumeType.getSelectedId();
			}
		<%}%>
		</logic:equal>
	frm.saveNcontinue.value=saveAndContinue;
}

function checkForDuplicates() {
	validCustomfields('<%=CustomFieldConstants.DEFAULT_SELECT_OPTION%>', '<%=CustomFieldConstants.TYPE_DROPDOWN%>', '<%=CustomFieldConstants.TYPE_LISTBOX%>', '<%=CustomFieldConstants.TYPE_CHECKBOX%>', '<%=CustomFieldConstants.TYPE_RADIO%>', false);
	setFormFields('2');
	frm.mode.value='checkForDuplicates';
	showUpdater('submit',{setHeight: false, setWidth: false, offsetLeft: -50});
	if($('saveandcontinue')){
		Element.hide('saveandcontinue');					
	}
	if($('checkForDuplicates')){
		Element.hide('checkForDuplicates');					
	}
	frm.submit();
	return true;
}

function validateForm(){
	validCustomfields('<%=CustomFieldConstants.DEFAULT_SELECT_OPTION%>', '<%=CustomFieldConstants.TYPE_DROPDOWN%>', '<%=CustomFieldConstants.TYPE_LISTBOX%>', '<%=CustomFieldConstants.TYPE_CHECKBOX%>', '<%=CustomFieldConstants.TYPE_RADIO%>', false);
	if(document.applicantForm.isEmpApply.value == "1" && $("employeeCode") && $("employeeCode").value.trim() == "") {
		alert("<bean:message key="common.please_enter" /> <bean:message key="common.emp_code" />");
		return false;
	}
	if(!validateFieldLengths()){
		return false;
	}
	var matchedPositionPhone = frm.applicantHomePhone.value.trim().search(/[a-z]/i);
	
	if(matchedPositionPhone != -1) {
	    alert("<bean:message key="common.please_enter" /> correct <bean:message key="common.phone1" />");
	    frm.applicantHomePhone.focus();
		return false;
	}
	
	matchedPositionPhone = frm.applicantWorkPhone.value.trim().search(/[a-z]/i);
	
	if(matchedPositionPhone != -1) {
	    alert("<bean:message key="common.please_enter" /> correct <bean:message key="common.phone2" />");
	    frm.applicantHomePhone.focus();
		return false;
	}
	
	matchedPositionPhone = frm.applicantCellPhone.value.trim().search(/[a-z]/i);
	
	if(matchedPositionPhone != -1) {
	    alert("<bean:message key="common.please_enter" /> correct <bean:message key="common.mobile" />");
	    frm.applicantHomePhone.focus();
		return false;
	}
	<%
	for(int j=0; j<importFields.size();j++){
		ImportFieldData fieldData = (ImportFieldData)importFields.get(j);
		String fieldId = fieldData.getFieldId();
		String fieldType = fieldData.getFieldType();
		String showValue = fieldData.getFieldImportShow();
		String mandatory = fieldData.getFieldImportMandatory();
		%>
		<logic:equal property="subMode" name="applicantForm" value="edit">
		<% showValue = fieldData.getFieldEditShow(); %>
		</logic:equal>
		<%
		if(showValue.equals(ImportConfigurationConstants.FIELD_SHOW) && mandatory.equals(ImportConfigurationConstants.FIELD_MANDATORY)){						
			if(fieldType.equals(ImportConfigurationConstants.FIELD_TYPE_NORMAL)){
				if(fieldId.equals(ImportConfigurationConstants.FIELD_NAME)){
					%>
					if(frm.applicantName.value.trim()==""){
						alert("<bean:message key="common.please_enter" /> <bean:message key="common.name" />");
						frm.applicantName.focus();
						return false;
					}
					<%
				}
				if(fieldId.equals(ImportConfigurationConstants.FIELD_EMAIL1)){
					%>
					if(frm.applicantEmail1.value.trim()==""){
						alert("<bean:message key="common.please_enter" /> <bean:message key="common.email1" />");
						frm.applicantEmail1.focus();
						return false;
					}
					<%
				}
				if(fieldId.equals(ImportConfigurationConstants.FIELD_EMAIL2)){
					%>
					if(frm.applicantEmail2.value.trim()==""){
						alert("<bean:message key="common.please_enter" /> <bean:message key="common.email2" />");
						frm.applicantEmail2.focus();
						return false;
					}
					<%
				}
				if(fieldId.equals(ImportConfigurationConstants.FIELD_PHONE1)){
					%>
				
					if(frm.applicantHomePhone.value.trim()==""){
						alert("<bean:message key="common.please_enter" /> <bean:message key="common.phone1" />");
						frm.applicantHomePhone.focus();
						return false;
					}
					var matchedPosition = frm.applicantHomePhone.value.trim().search(/[a-z]/i);
		
					if(matchedPosition != -1) {
					    alert("<bean:message key="common.please_enter" /> correct <bean:message key="common.phone1" />");
					    frm.applicantHomePhone.focus();
						return false;
					}
					<%
				}
				if(fieldId.equals(ImportConfigurationConstants.FIELD_PHONE2)){
					%>
					if(frm.applicantWorkPhone.value.trim()==""){
						alert("<bean:message key="common.please_enter" /> <bean:message key="common.phone2" />");
						frm.applicantWorkPhone.focus();
						return false;
					}
					var matchedPosition = frm.applicantWorkPhone.value.trim().search(/[a-z]/i);
					
					if(matchedPosition != -1) {
					    alert("<bean:message key="common.please_enter" /> correct <bean:message key="common.phone2" />");
					    frm.applicantHomePhone.focus();
						return false;
					}
					<%
				}
				if(fieldId.equals(ImportConfigurationConstants.FIELD_MOBILE)){
					%>
					if(frm.applicantCellPhone.value.trim()==""){
						alert("<bean:message key="common.please_enter" /> <bean:message key="common.mobile" />");
						frm.applicantCellPhone.focus();
						return false;
					}
					var matchedPosition = frm.applicantCellPhone.value.trim().search(/[a-z]/i);
					
					if(matchedPosition != -1) {
					    alert("<bean:message key="common.please_enter" /> correct <bean:message key="common.mobile" />");
					    frm.applicantHomePhone.focus();
						return false;
					}
					<%
				}
				if(fieldId.equals(ImportConfigurationConstants.FIELD_SOURCE)){
					%>
					if(selectBoxSource.getSelectedId()=="-1"){
						alert('<bean:message key="common.please_select" /> <bean:message key="common.source" />');
						selectBoxSource.setFocus();
						return false;
					}
					if(selectBoxSource.getSelectedId()=="0"){
						if(frm.sourceId.value==""){
							alert('<bean:message key="create_applicant.error.select_employee_referrals" />');
							return false;
						}
					}
	
					<%
				}
				if(fieldId.equals(ImportConfigurationConstants.FIELD_CURRENT_LOCATION)){
					%>
					if(frm.applicantCity.value.trim()==""){
						alert("<bean:message key="common.please_enter" /> <bean:message key="common.current_location" />");
						frm.applicantCity.focus();
						return false;
					}
					<%
				}
				if(fieldId.equals(ImportConfigurationConstants.FIELD_SKILLS)){
					%>
					if(frm.primarySkillIds.value.trim()==""){
						alert("<bean:message key="common.please_enter" /> <bean:message key="common.skills" />");
						frm.rawPrimarySkills.focus();
						return false;
					}
					<%
				}
				if(fieldId.equals(ImportConfigurationConstants.FIELD_EDUCATION)){
					%>
					var rowPresent = false;
					ctlcnt=0;
					for(var z=0; z<=eduCount; z++){
						if($('educationYearOfPassing['+z+']')){
							if($('educationYearOfPassing['+z+']').value.trim()!='' || 
								$('educationInstitute['+z+']').value.trim()!='' ||
								degreeControls[ctlcnt][1].getSelectedId()!='-1' ||
								branchControls[ctlcnt][1].getSelectedId()!='-1' ||
								$('educationalGrade['+z+']').value.trim()!='' ||
								$('fromYear['+z+']').value.trim()!='' /* ||
								$('remarks['+z+']').value.trim()!='' */){
								ctlcnt++;
								rowPresent = true;
							}
						}
					}
					if(!rowPresent){
						alert("<bean:message key="common.please_enter" /> <bean:message key="common.education" />");
						return false;
					}
					<%
				}
				if(fieldId.equals(ImportConfigurationConstants.FIELD_EXPERIENCE)){
					%>
					if(document.applicantForm.fresher.value!="1"){
						if(document.applicantForm.applicantWorkingSince.value==""){
							//alert("<bean:message key="common.please_enter" /> <bean:message key="common.working_since" /> <bean:message key="common.date" /> ");
							alert("<bean:message key="common.please_enter" /> <bean:message key="common.total_experience" /> in yy.mm years");
							document.applicantForm.applicantWorkingSince.focus();
							return false;
						}
					}
					<%
				}				
				if(fieldId.equals(ImportConfigurationConstants.FIELD_CURRENT_CTC)){
					%>
					if(frm.currentCTC && frm.currentCTC.value.trim()==""){
						alert("<bean:message key="common.please_enter" /> <bean:message key="common.current_ctc" />");
						frm.currentCTC.focus();
						return false;
					}
					<%
				}
				if(fieldId.equals(ImportConfigurationConstants.FIELD_EXPECTED_CTC)){
					%>
					if(frm.expectedCTC && frm.expectedCTC.value.trim()==""){
						alert("<bean:message key="common.please_enter" /> <bean:message key="common.expected_ctc" />");
						frm.expectedCTC.focus();
						return false;
					}
					<%
				}
				if(fieldId.equals(ImportConfigurationConstants.FIELD_NOTICE_PERIOD)){
					%>
					if(frm.timeToJoin.value.trim()==""){
						alert("<bean:message key="common.please_enter" /> <bean:message key="common.notice_period" />");
						frm.timeToJoin.focus();
						return false;
					}
					<%
				}
				
				if(fieldId.equals(ImportConfigurationConstants.FIELD_DATE_OF_BIRTH)){
					%>
					if(frm.dateOfBirth.value.trim()==""){
						alert("<bean:message key="common.please_enter" /> <bean:message key="common.date_of_birth" />");
						frm.dateOfBirth.focus();
						return false;
					}
					<%
				}
				
				if(fieldId.equals(ImportConfigurationConstants.FIELD_PASSPORT_NUMBER)){
					%>
					if(frm.passportNumber.value.trim()==""){
						alert("<bean:message key="common.please_enter" /> <bean:message key="common.passport_number" />");
						frm.passportNumber.focus();
						return false;
					}
					<%
				}
				
				if(fieldId.equals(ImportConfigurationConstants.FIELD_RESUME_TYPE)){
					%>
					if(selectBoxResumeType.getSelectedId()=="-1"){
						alert('<bean:message key="common.please_select" /> <bean:message key="common.resume_type" />');
						selectBoxResumeType.setFocus();
						return false;
					}
					<%
				}
				
				if(fieldId.equals(ImportConfigurationConstants.FIELD_NOTE)){
					%>
					<logic:equal property="subMode" name="applicantForm" value="add">
					if(frm.applicantNote.value.trim()==""){
						alert("<bean:message key="common.please_enter" /> <bean:message key="common.note" />");
						frm.applicantNote.focus();
						return false;
					}
					</logic:equal>
					<%
				}
				
				if(fieldId.equals(ImportConfigurationConstants.FIELD_EMPLOYMENT_HISTORY)){
					%>
					var rowPresent = false;
					ctlcnt=0;
					for(var k=0; k<=empHistoryCount; k++){
						if($('employmentFromDate['+k+']')){
							if($('employmentToDate['+k+']').value.trim()!='' || 
								$('employmentEmployerId['+k+']').value.trim()!='' ||
								$('employmentDesignationId['+k+']').value.trim()!='' ||
								$('employmentExperience['+k+']').value.trim()!='' ||
							/* 	$('grossSalary['+k+']').value.trim()!='' ||
								$('allowance['+k+']').value.trim()!='' || */
								/* $('reasonForLeaving['+k+']').value.trim()!=''||
								$('dutiesInvolved['+k+']').value.trim()!=''|| */
							){
								ctlcnt++;
								rowPresent = true;
							}
						}
					}
					if(!rowPresent){
						alert("<bean:message key="common.please_enter" /> <bean:message key="common.employer" />");
						return false;
					}
					<%
				}
			}else {
				//validate custom fields			
				for (int c = 0; customFields != null && c < customFields.size(); c++) {
					CustomFieldData data = (CustomFieldData)customFields.get(c);
					if (fieldId.equals(data.getFieldName()) && showValue.equals(ImportConfigurationConstants.FIELD_SHOW) && mandatory.equalsIgnoreCase(ImportConfigurationConstants.FIELD_MANDATORY)) {						
						%>
						if($('<%=data.getFieldName()%>').value == '') {
							alert("<bean:message key="common.please_enter" /> <%=data.getFieldDisplayName()%>");
							return false;
						}		
						<%
					}
				}
			}
		}
	}
	%>	
	for(var z=0;z<=eduCount;z++){
		if($('fromYear['+z+']')!=null && $('educationYearOfPassing['+z+']') != null &&  $('fromYear['+z+']').value.trim()!='' && $('educationYearOfPassing['+z+']').value.trim()!='' && $('fromYear['+z+']').value > $('educationYearOfPassing['+z+']').value){
			alert("from year should be less than year of passing");
			$('fromYear['+z+']').focus();
			return false;
		}	
	}
	return true;	
}

function validateFieldLengths(){
	var errors = '';
	errors = validateFieldLength(100,frm.applicantName,'<bean:message key="common.name" />',errors);
	errors =validateFieldLength(50,frm.applicantEmail1,'<bean:message key="common.email1" />',errors);
	errors =validateFieldLength(50,frm.applicantEmail2,'<bean:message key="common.email2" />',errors);
	errors =validateFieldLength(25,frm.applicantHomePhone,'<bean:message key="common.phone1" />',errors);
	errors =validateFieldLength(25,frm.applicantWorkPhone,'<bean:message key="common.phone2" />',errors);
	errors =validateFieldLength(25,frm.applicantCellPhone,'<bean:message key="common.mobile" />',errors);
	errors =validateFieldLength(50,frm.applicantCity,'<bean:message key="common.current_location" />',errors);	
	errors =validateFieldLength(10,frm.currentCTC,'<bean:message key="common.current_ctc" />',errors);
	errors =validateFieldLength(10,frm.expectedCTC,'<bean:message key="common.expected_ctc" />',errors);
	errors =validateFieldLength(10,frm.passportNumber,'<bean:message key="common.passport_number" />',errors);
	if(errors.length>0){
		alert(errors);
		return false;
	}
	else{
		return true;
	}	
}
function validateFieldData(){
	
}
function addError(errors, error) {
	if (errors.length > 0) {
		errors += '\n';
	}
	errors += error;
	return errors;
}

function validateFieldLength(length, field,fieldLabel,errors){
	if(field != undefined && field.value.length > length){
			errors = addError(errors, '- '+'<bean:message key="add_applicant.errors.max_characters_allowed" /> '+fieldLabel+" is equal to "+length);
			field.focus();
	}
	return errors;
}

function cancelForm(){
	window.close();
}

var eduStr = '';
var empHistoryStr = '';
</script>

	<div class="contentDiv" style="margin: 20px 0px 0px 10px;">
	<%
	if (request.getAttribute(Globals.ERROR_KEY) != null) {
		System.out.println(request.getAttribute(Globals.ERROR_KEY));
	%>
	<table id="m_errortable">
		<tr>
			<td class="header"><b><bean:message
				key="errors.following_errors" /></b></td>
		</tr>
		<tr>
			<td><html:errors /></td>
		</tr>
	</table>
	<br/>
	<%
	}
	%>
	<%
	if (request.getAttribute("parsingError") != null) {
		System.out.println(request.getAttribute(Globals.ERROR_KEY));
	%>
	<table id="m_errortable">
		<tr>
			<td class="header"><b><bean:message
				key="errors.following_errors" /></b></td>
		</tr>
		<tr>
			<td></br></br><%=(String)request.getAttribute("parsingError") %></td>
		</tr>
	</table>
	<br/>
	<%
	}
	%>
	<table border="0" cellspacing="0" cellpadding="0">
		<tr>
			<td>
			<div style="width:140px;" class="boxTab"><span class="rightC"></span><span
				class="leftC"></span>&nbsp;<strong><bean:message
				key="add_applicant.label.import" /></strong></div>
			</td>
			<td style="padding-left:10px;" valign="top">
				<logic:present name="messageData" scope="request">
				<strong>
					<bean:message key="create_applicant.label.use_as_resume" />				
				</strong>
				<img src="images/checkedradiobutton.gif" name="rdo" id="img_0" onclick="onRadioChange('rdo',0)" />&nbsp;
					<bean:message key="inbox.import.content1" />&nbsp;&nbsp;
				<logic:iterate id="att" name="messageData" property="attachments" scope="request">
					<img src="images/radiobutton.gif" name="rdo" id='img_<bean:write name="att" property="attachmentId"/>' onclick="onRadioChange('rdo','<bean:write name="att" property="attachmentId"/>');"/>&nbsp;
					<bean:write name="att" property="originalFileName" />&nbsp;&nbsp;
				</logic:iterate>
				</logic:present>
				<logic:present name="documents" scope="request">
					<strong>Use as resume : </strong>
					<logic:iterate id="document" name="documents" scope="request" indexId="cnt" type="SimpleDataObject">					
						<img 
							<logic:equal name="applicantForm" property="originalResumePath" value='<%=document.getString("documentPath").substring(0, document.getString("documentPath").lastIndexOf(".")) + ".html"%>'>
							src="images/checkedradiobutton.gif" 
							</logic:equal>
							<logic:notEqual name="applicantForm" property="originalResumePath" value='<%=document.getString("documentPath")%>'>
							src="images/radiobutton.gif" 
							</logic:notEqual>
						name="rdo" id='img_<%=document.getString("documentPath")%>' onclick="onRadioChange('rdo','<%=document.getString("documentPath")%>');"/>&nbsp;
						<logic:equal name="cnt" value="0">
							<bean:message key="inbox.import.content3" />&nbsp;&nbsp;		
						</logic:equal>
						<logic:notEqual name="cnt" value="0">
							<bean:message key="inbox.import.content4" />&nbsp;&nbsp;	
						</logic:notEqual>
					</logic:iterate>
				</logic:present>
			</td>
		</tr>
	</table>
	<table cellspacing="0" cellpadding="0" border="0">
		<tr>
			<td>
			<html:form action="/importResume" focus="sourceId">
				<div class="bottomDiv">
				<div class="outerDiv" style="width:500px;height:620px; overflow: auto; ">

				<div id="divCalender" class="myCalender"></div>
				<div id="autocomplete" class="autocomplete"></div>

			<html:hidden property="mode" value="addApplicant" /> 
			<html:hidden property="t" name="applicantForm" /> 
			<html:hidden property="selAttachment" name="applicantForm" /> 
			<html:hidden property="emailId" name="applicantForm" /> 
			<html:hidden property="applicantId" name="applicantForm" /> 
			<html:hidden property="cancelled" name="applicantForm" /> 
			<html:hidden property="sourceId" name="applicantForm" />
			<html:hidden property="resumeTypeId" name="applicantForm" /> 
			<html:hidden property="primarySkillIds" name="applicantForm" /> 
			<html:hidden property="primarySkills" name="applicantForm" /> 
			<html:hidden property="originalResumePath" name="applicantForm" /> 
			<html:hidden property="fresher" name="applicantForm" />
			<html:hidden property="confidential" name="applicantForm" /> 
			<html:hidden property="subMode" name="applicantForm" /> 
			<html:hidden property="saveNcontinue" name="applicantForm" value="0" />
			<html:hidden property="uploadedFilePath" name="applicantForm"/>
			<html:hidden property="vendorId" name="applicantForm" />
			<html:hidden property="isEmployeeSource" name="applicantForm" />
			<html:hidden property="parse" name="applicantForm" value=""/>
			<html:hidden property="requestSource" name="applicantForm"/>
			<html:hidden property="resultId" name="applicantForm"/>
			<html:hidden property="sessionId" name="applicantForm"/>
			<html:hidden property="ieImport" name="applicantForm"/>
			<html:hidden property="isEmpApply" name="applicantForm"/>
			<html:hidden property="uuid" name="applicantForm"/>
			<html:hidden property="applicantTextResume" name="applicantForm"/>
		
			<logic:equal property="subMode" name="applicantForm" value="edit">
				<%

					for(int j=0; j<importFields.size();j++){
						ImportFieldData fieldData = (ImportFieldData)importFields.get(j);
						String fieldId = fieldData.getFieldId();
						String fieldType = fieldData.getFieldType();
						String showValue = fieldData.getFieldImportShow();
						String editValue = fieldData.getFieldEditShow();
						if(showValue.equals(ImportConfigurationConstants.FIELD_SHOW) && editValue.equals(ImportConfigurationConstants.FIELD_NOT_EDIT)){
							if(fieldId.equals(ImportConfigurationConstants.FIELD_CURRENT_LOCATION)){
							%>
								<html:hidden property="applicantCity" name="applicantForm"/>				
							<%
							}							
							if(fieldId.equals(ImportConfigurationConstants.FIELD_CURRENT_CTC)){
							%>
								<html:hidden property="currentCTC" name="applicantForm"/>				
							<%
							}
							if(fieldId.equals(ImportConfigurationConstants.FIELD_EXPECTED_CTC)){
							%>
								<html:hidden property="expectedCTC" name="applicantForm"/>				
							<%
							}
							if(fieldId.equals(ImportConfigurationConstants.FIELD_NOTICE_PERIOD)){
							%>
								<html:hidden property="noticePeriod" name="applicantForm"/>				
							<%
							}
							if(fieldId.equals(ImportConfigurationConstants.FIELD_EDUCATION)){
								String[] educationYearOfPassing = applicantForm.getEducationYearOfPassing();
								String[] educationInstitute = applicantForm.getEducationInstitute();
								String[] educationDegreeId = applicantForm.getEducationDegreeId();
								String[] educationMajorId = applicantForm.getEducationMajorId();
								String[] educationalGrade = applicantForm.getEducationalGrade();
								/* String[] fromYear = applicantForm.getFromYear(); */
								/* String[] remarks = applicantForm.getRemarks(); */
								for (int i = 0; educationYearOfPassing != null && i < educationYearOfPassing.length; i++) {
									%>
									<%-- <input type="hidden" name="fromYear"
										value="<%=fromYear[i] %>" /> --%>
									<input type="hidden" name="educationYearOfPassing"
										value="<%=educationYearOfPassing[i] %>" />
									<input type="hidden" name="educationInstitute"
										value="<%=educationInstitute[i] %>" />
									<input type="hidden" name="educationDegreeId"
										value="<%=educationDegreeId[i] %>" />
									<input type="hidden" name="educationMajorId"
										value="<%=educationMajorId[i] %>" />
									<input type="hidden" name="educationalGrade"
										value="<%=educationalGrade[i] %>" />
									<%-- <input type="hidden" name="remarks"
										value="<%=remarks[i] %>" /> --%>
									<%}}
								if(fieldId.equals(ImportConfigurationConstants.FIELD_EMPLOYMENT_HISTORY)){								
									String[] employmentFromDate = applicantForm.getEmploymentFromDate();
								 	String[] employmentToDate = applicantForm.getEmploymentToDate();
								 	String[] employmentEmployerId = applicantForm.getEmploymentEmployerId();
								 	String[] employmentDesignationId = applicantForm.getEmploymentDesignationId();
								 	String[] employmentExperience = applicantForm.getEmploymentExperience();
								 /* 	String[] allowance = applicantForm.getAllowance(); */
								 	/* String[] reasonForLeaving = applicantForm.getReasonForLeaving(); */
								 	/* String[] grossSalary = applicantForm.getGrossSalary(); */
								 	/* String[] dutiesInvolved = applicantForm.getDutiesInvolved(); */
								 	for (int i = 0; employmentFromDate != null && i < employmentFromDate.length; i++){
								%>
							 		<input type="hidden" name="employmentFromDate" value="<%=employmentFromDate[i]%>" />
							 		<input type="hidden" name="employmentToDate" value="<%=employmentToDate[i]%>" />
							 		<input type="hidden" name="employmentEmployerId" value="<%=employmentEmployerId[i]%>" />
							 		<input type="hidden" name="employmentDesignationId" value="<%=employmentDesignationId[i]%>" />
							 		<input type="hidden" name="employmentExperience" value="<%=employmentExperience[i]%>" />
							 		<%-- <input type="hidden" name="grossSalary" value="<%=grossSalary[i]%>" />
							 		<input type="hidden" name="allowance" value="<%=allowance[i]%>" /> --%>
							 		<%-- <input type="hidden" name="dutiesInvolved" value="<%=dutiesInvolved[i]%>" />
							 		<input type="hidden" name="reasonForLeaving" value="<%=reasonForLeaving[i]%>" /> --%>
							 	<% }
								}
							}
						}	%>
				</logic:equal>
				
			<br />
			<%
				if(GlobalApplicationProperties.getProperty(GlobalConstants.PROPERTY_EMPLOYEE_CAN_APPLY_FOR_JOB).equalsIgnoreCase(GlobalConstants.ENABLED)) {
			%>
			<table class="tabinput">
				<tr>
					<td class="label" style="width: 130px;height:20px;" >
						<bean:message key="common.is_emp_apply" />
						:
					</td>
					<td width="250px;">
						<img src="images/checkboxunchecked.gif" id="cboIsEmpApply" onclick="toggleEmployeeApply()" style="margin-bottom: -2px;" />						
					</td>
				</tr>
				<tr id="empCodeDiv" style="display:none;">	
					<td class="label" style="width: 130px;" >
						<bean:message key="common.emp_code" />
						:
					</td>
					<td width="250px;">
						<html:text property="employeeCode" styleId="employeeCode" name="applicantForm" size="5" styleClass="Grey" maxlength="100" />
					</td>
				</tr>
			</table>
			<%
				}
			%>
			<%
				for(int j=0; j<importFields.size();j++){
					ImportFieldData fieldData = (ImportFieldData)importFields.get(j);
					String fieldId = fieldData.getFieldId();
					String fieldType = fieldData.getFieldType();
					String showValue = fieldData.getFieldImportShow();
					String isMandatory = fieldData.getFieldImportMandatory();
			%>
						<logic:equal property="subMode" name="applicantForm" value="edit">
						<%
							showValue = fieldData.getFieldEditShow();
						%>
						</logic:equal>
						<%if(showValue.equals(ImportConfigurationConstants.FIELD_SHOW)){						
							if(fieldType.equals(ImportConfigurationConstants.FIELD_TYPE_NORMAL)){
								if(fieldId.equals(ImportConfigurationConstants.FIELD_NAME)){
						%>
								<table class="tabinput">
								<tr>
									<td	style="width: 130px;" <html:errormap property="name_required" errorStyleClass="labelError" styleClass="label"/>>
											<bean:message key="common.name" />
											<span class="star">*</span>
											:
									</td>
									<td>
										<html:text property="applicantName" name="applicantForm" size="25" styleClass="Grey" maxlength="100"/>
									</td>
								</tr>
								</table>
								<%}if(fieldId.equals(ImportConfigurationConstants.FIELD_EMAIL1)){	%>
								<table class="tabinput">
								<tr>
									<td	style="width: 130px;" <html:errormap property="email_required|email1_not_valid" errorStyleClass="labelError" styleClass="label"/>>
										<bean:message key="common.email1" />
										<%
											if(isMandatory.equalsIgnoreCase(ImportConfigurationConstants.FIELD_MANDATORY)){
										%>
										<span class="star">*</span>
										<%
											}
										%>
										:
									</td>
									<td>
										<html:text property="applicantEmail1" name="applicantForm" size="35" styleClass="Grey" maxlength="50"></html:text>							
									</td>
								</tr>
								</table>
								<%	}if(fieldId.equals(ImportConfigurationConstants.FIELD_EMAIL2)){	%>
								<table class="tabinput">
								<tr>
									<td	style="width: 130px;" <html:errormap property="email_required|email2_not_valid" errorStyleClass="labelError" styleClass="label"/>>
										<bean:message key="common.email2" />
										<%
											if(isMandatory.equalsIgnoreCase(ImportConfigurationConstants.FIELD_MANDATORY)){
										%>
										<span class="star">*</span>
										<% } %>
										:
									</td>
									<td>
										<html:text property="applicantEmail2" name="applicantForm" size="35" styleClass="Grey" maxlength="50"></html:text>
									</td>
								</tr>
								</table>
								<%}	if(fieldId.equals(ImportConfigurationConstants.FIELD_PHONE1)){	%>
								<table class="tabinput">
								<tr>
									<td class="label" style="width: 130px;"><bean:message key="common.phone1" />
									<%if(isMandatory.equalsIgnoreCase(ImportConfigurationConstants.FIELD_MANDATORY)){%>
										<span class="star">*</span>
									<%	}%>
										:</td>
									<td class="label">
										<html:text property="applicantHomePhone" name="applicantForm" size="22" maxlength="25" styleClass="Grey" />
									</td>
								</tr>
								</table>
								<%}	if(fieldId.equals(ImportConfigurationConstants.FIELD_PHONE2)){%>
								<table class="tabinput">
								<tr>
									<td class="label" style="width: 130px;"><bean:message key="common.phone2" />
									<%
										if(isMandatory.equalsIgnoreCase(ImportConfigurationConstants.FIELD_MANDATORY)){
									%>
										<span class="star">*</span>
										<%
											}
										%>
									:</td>
									<td class="label">
										<html:text property="applicantWorkPhone" name="applicantForm" size="22" maxlength="25" styleClass="Grey" />
									</td>
								</tr>
								</table>
								<%}if(fieldId.equals(ImportConfigurationConstants.FIELD_MOBILE)){%>
								<table class="tabinput">
								<tr>
									<td class="label" style="width: 130px;"><bean:message key="common.mobile" />
									<%
										if(isMandatory.equalsIgnoreCase(ImportConfigurationConstants.FIELD_MANDATORY)){
									%>
										<span class="star">*</span>
									<%
										}
									%>
									:</td>
									<td class="label">
										<html:text property="applicantCellPhone" name="applicantForm" size="22" maxlength="25" styleClass="Grey" />
									</td>
								</tr>
								</table>
								<%}if(fieldId.equals(ImportConfigurationConstants.FIELD_SOURCE)){%>
								<table class="tabinput">
								<tr>
									<td	style="width: 130px;" <html:errormap property="add_applicant.errors.source_required" errorStyleClass="labelError" styleClass="label"/>>
										<bean:message key="common.source" />
										<span class="star">*</span>
										:</td>
									<td>
										<script type="text/javascript">
											var opts = <%=CommonUtils.getJavaScriptArrayForRecentlyUsed()%>;
											var m = [new SelectOption('-1','<bean:message key="add_applicant.label.select_source"/>')];
												var n = [new SelectOption('0','<bean:write name="applicantForm" property="employeeSourceName" filter="false"/>',0,null,false,{cs:'mnuGreen'})];
												
												opts = m.concat(opts);
												opts = opts.concat(n);
												if(opts.length ><%=RecentlyUsedSourceConstants.noOfRecentlyUsedSources%>){
												var o = [new SelectOption('-2','More Sources>>',0,null,false,{cs:'mnuRed'})];
												opts = opts.concat(o);
												}
												selectBoxSource = new SelectBox(opts,'<%=applicantForm.getSourceId()%>','images/btn_dropdown.gif',{namesonly:false, width:'140px', size:25, textboxclass:'Grey'});
												selectBoxSource.setOnChangeHandler('onChangeSelectBoxSource');
												document.write(selectBoxSource.getHtml());
												selectBoxSource.init();
											</script>
										</td>
										<td>
											<div id="employeeSourceAndVendorUser" style="display: none;">
												<script>
													var opts = [new SelectOption('-1','<bean:message key="common.selectlist.default"/>')];
													selectBoxEmployeeSource = new SelectBox(opts,'<%=applicantForm.getSourceId()%>','images/btn_dropdown.gif',{namesonly:false, width:'152px', size:20, textboxclass:'Grey'});
													document.write(selectBoxEmployeeSource.getHtml());
													selectBoxEmployeeSource.init();
												</script>
											</div>
											<div id="employeeSourceDiv" style="display: none;">
					 			               <html:text property="source" name="applicantForm" size="28" styleId="source" onblur="setSourceId();"></html:text>
						   					</div>
										</td>
									</tr>
								</table>
								<%}	if(fieldId.equals(ImportConfigurationConstants.FIELD_CATEGORY)){%>
								<table class="tabinput">
								<tr>
									<td class="label" style="width: 130px;"><bean:message key="common.employee.category" />
								
									:</td>					
									<td class="label">
										<html:text property="category"	name="applicantForm" size="35" styleId="category" styleClass="Grey" maxlength="50" />
										
									</td>
									</tr>
								</table>
								<%}if(fieldId.equals(ImportConfigurationConstants.FIELD_SUB_CATEGORY)){%>
									<table class="tabinput">
								<tr>
									<td class="label" style="width: 130px;"><bean:message key="common.employee.subCategory" />
								
									:</td>					
									<td class="label">
										<html:text property="subCategory"	name="applicantForm" size="35" styleId="subCategory" styleClass="Grey" maxlength="50" />
										
									</td>
									</tr>
								</table>
								<%}
								
								if(fieldId.equals(ImportConfigurationConstants.FIELD_CURRENT_LOCATION)){%>
								<table class="tabinput">
								<tr>
									<td class="label" style="width: 130px;"><bean:message key="common.current_location" />
									<%
										if(isMandatory.equalsIgnoreCase(ImportConfigurationConstants.FIELD_MANDATORY)){
									%>
										<span class="star">*</span>
									<%
										}
									%>
									:</td>					
									<td class="label">
										<html:text property="applicantCity"	name="applicantForm" size="35" styleId="applicantCity" styleClass="Grey" maxlength="50" />
										<script>
											new Ajax.Autocompleter("applicantCity", "autocomplete", "importResume.do?mode=getAutoCompleteList&fld=<%=ApplicantConstants.AUTOCOMPLETE_CURRENT_LOCATION %>", {frequency: 0.001});
										</script>
									</td>
									</tr>
								</table>
								<%}if(fieldId.equals(ImportConfigurationConstants.FIELD_SKILLS)){%>
								<span class="heading">
									<bean:message key="common.skills" />
									<%if(isMandatory.equalsIgnoreCase(ImportConfigurationConstants.FIELD_MANDATORY)){%>
										<span class="star">*</span>
									<%}%>
									</span>
								<table class="tabinput">
								<tr>
									<td valign="top">
										<html:textarea property="rawPrimarySkills" name="applicantForm" rows="3" cols="36" onfocus="javascript:getExtractedSkills();" onkeyup="javascript:getExtractedSkills();" styleClass="Grey"></html:textarea>
									</td>
									<td class="hgap"></td>
									<td valign="top">
										<table class="tabinput">
										<tr>
											<td id="divPrimarySkills" style="font-weight:bold; height: 38px;vertical-align: top;">
												<bean:write	name="applicantForm" property="primarySkills" />
											</td>
										</tr>
										<tr>
											<td valign="bottom">
												<a href="#" class="green" onclick="JavaScript:clearExtractedSkills();return false;"><bean:message key="create_applicant.label.clear_extracted_skills" /></a>
											</td>
										</tr>
										</table>
									</td>
								</tr>
								</table>
								<%}if(fieldId.equals(ImportConfigurationConstants.FIELD_EDUCATION)){%>
								<span class="heading">
									<bean:message key="common.education" />
									<%
										if(isMandatory.equalsIgnoreCase(ImportConfigurationConstants.FIELD_MANDATORY)){
									%>
										<span class="star">*</span>
									<%
										}
									%> </span>
								<%
									/* String[] fromYear = applicantForm.getFromYear(); */
									String[] educationYearOfPassing = applicantForm.getEducationYearOfPassing();
								 	String[] educationInstitute = applicantForm.getEducationInstitute();
								 	String[] educationDegreeId = applicantForm.getEducationDegreeId();
								 	String[] educationMajorId = applicantForm.getEducationMajorId();
								 	String[] educationalGrade = applicantForm.getEducationalGrade();
								 	/* String[] remarks = applicantForm.getRemarks(); */
								%>
								<table class="tabinput">
								<tr>
									<td>
										<html:textarea property="rawEducationText"	styleId="rawEducationText[0]" name="applicantForm" rows="3"	cols="66" onfocus="JavaScript:getExtractedEducation(this.value,0);"	onkeyup="JavaScript:getExtractedEducation(this.value,0);" styleClass="Grey"></html:textarea>
									</td>
								</tr>
								</table>
								<table class="educationT" id="tblEdu" width="503">
								<tbody>
								<tr>
									<td class="header"></td>
									<%-- <td class="header"><bean:message key="common.fromYear" /></td> --%>
									<td class="header"><bean:message key="common.year" /></td>
									<td class="header"><bean:message key="common.institute" /></td>
									<td class="header"><bean:message key="common.degree" /></td>
									<td class="header"><bean:message key="common.branch" /></td>
									<td class="header"><bean:message key="common.class" /></td>
									<%-- <td class="header"><bean:message key="common.Remarks" /></td> --%>
								</tr>
								
								<%for (int i = 0; educationYearOfPassing!=null && i < educationYearOfPassing.length; i++) {
									totalEduRows++;
								%>
								<tr id="<%=i%>">
									<td><img src="images/radiobutton.gif" name="edu" id='img_<%=i%>' onclick="onOptionChange('edu','<%=i%>');" />
									</td>
									<%-- <td>
									<input type="text" name="fromYear" size="4"  id="fromYear[<%=i%>]" class="Grey" value="<%=(fromYear[i]==null)?"":fromYear[i]%>"  onblur="getFormattedYear(this);"/>
									</td> --%>
									<td><input type="text" name="educationYearOfPassing" size="4" value="<%=(educationYearOfPassing[i]==null)?"":educationYearOfPassing[i]%>" onblur="getFormattedYear(this);" id="educationYearOfPassing[<%=i%>]" class="Grey" />
									</td>
									<td><input type="text" name="educationInstitute" size="27" maxlength="150" value="<%=(educationInstitute[i]==null)?"":educationInstitute[i]%>" id="educationInstitute[<%=i%>]" class="Grey" /> 
										<script	language="JavaScript">
											new Ajax.Autocompleter("educationInstitute[<%=i%>]", "autocomplete", "importResume.do?mode=getAutoCompleteList&fld=<%=ApplicantConstants.AUTOCOMPLETE_INSTITUTE%>", {frequency: 0.001});
										</script>
									</td>
									<td><input type="hidden" name="educationDegreeId" /> 
										<script type="text/javascript">
										selectBoxDegree = new SelectBox(degreeOptions,'<%=educationDegreeId[i]%>','images/btn_dropdown.gif',{namesonly:false, width:'75px', size:10, textboxclass:'Grey'});
										document.write(selectBoxDegree.getHtml());
										selectBoxDegree.init();
										degreeControls[degreeControls.length]=[<%=i%>,selectBoxDegree];															
										</script>
									</td>
									<td><input type="hidden" name="educationMajorId" /> 
										<script language="JavaScript">
										selectBoxBranch = new SelectBox(branchOptions,'<%=educationMajorId[i]%>','images/btn_dropdown.gif',{namesonly:false, width:'120px', size:10, textboxclass:'Grey'});
										document.write(selectBoxBranch.getHtml());
