package com.talentPool.dynamicReports.data;

import com.talentPool.common.db.SimpleDataObject;

/**
 * @author Ajeet
 *
 */
public class HiringActivityReportData extends SimpleDataObject{
	
	/**
	 * @return the positionTitle
	 */
	public String getpositionTitle() {
		return getString("positionTitle");
	}
	/**
	 * @param positionTitle the positionTitle to set
	 */
	public void setPositionTitle(String positionTitle) {
		setAttribute("positionTitle",positionTitle);
	}
	
	/**
	 * @return the stepTitle
	 */
	public String getStepTitle() {
		return getString("stepTitle");
	}
	/**
	 * @param stepTitle the stepTitle to set
	 */
	public void setStepTitle(String stepTitle) {
		setAttribute("stepTitle",stepTitle);
	}
	
	/**
	 * @return the count
	 */
	public int getCount() {
		return getInt("count");
	}
	/**
	 * @param count the count to set
	 */
	public void setCount(int count) {
		setAttribute("count",count);
	}
	
	/**
	 * @return the positionId
	 */
	public String getPositionId() {
		return getString("positionId");
	}
	/**
	 * @param positionId the positionId to set
	 */
	public void setPositionId(String positionId) {
		setAttribute("positionId",positionId);
	}
	
	/**
	 * @return the deptName
	 */
	public String getDeptName() {
		return getString("deptName");
	}
	/**
	 * @param deptName the deptName to set
	 */
	public void setDeptName(String deptName) {
		setAttribute("deptName",deptName);
	}
	
	/**
	 * @return the posCustomFieldValues
	 */
	public String getPosCustomFieldValues() {
		return getString("posCustomFieldValues");
	}
	/**
	 * @param posCustomFieldValues the posCustomFieldValues to set
	 */
	public void setPosCustomFieldValues(String posCustomFieldValues) {
		setAttribute("posCustomFieldValues",posCustomFieldValues);
	}
	
	/**
	 * @return the appliedCount
	 */
	public String getAppliedCount() {
		return getString("appliedCount");
	}
	/**
	 * @param appliedCount the appliedCount to set
	 */
	public void setAppliedCount(String appliedCount) {
		setAttribute("appliedCount",appliedCount);
	}
}
