	/**
	 * @param applicantId
	 * @return all positions applied by a candidate
	 */
	public ArrayList<PositionData> getPositionsAndResumesAppliedByCandidate(String applicantId,boolean indexFlag) {
		DBPreparedQuery dq = null;
		ArrayList<PositionData> list = null;
		try{
			String[] dynParams = new String[1];
			if(indexFlag){
				dynParams[0] = "and not isnull(taprm.position_id) and taprm.applied_status ='1'";
			}else{
				dynParams[0] = "";
			}
			dq = new DBPreparedQuery("dApplicantManager_GetPositionAppliedForByCandidate",dynParams);
			dq.setString(1, applicantId);
//			dq.setString(2, applicantId);
			list = dq.getResult();
		} catch (Exception e) {
			TPLogger.getLogger().error("Error while getting all positions applied by candidate", e);
		} finally {
			if(dq != null) {
				dq.closeOpenCursors();
			}
		}
		return list;
	}
	
	
