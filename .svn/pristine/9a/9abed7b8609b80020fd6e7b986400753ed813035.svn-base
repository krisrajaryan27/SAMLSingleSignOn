	/**
	 * Generate commaseparated list of skills in XML
	 * 
	 * @param skills
	 * @return
	 */
	public String getExtractedSkillXml(ArrayList<SkillData> skills) {
		StringWriter sWr = new StringWriter();
		try {
			if (skills != null && skills.size() > 0) {
				XMLWriter wr = new XMLWriter(sWr);
				wr.startDocument();
				wr.startElement("skills");
				for (int i = 0; i < skills.size(); i++) {
					SkillData sdo = skills.get(i);
					String name = sdo.getItemName();
					String id = "" + sdo.getItemId();
					wr.startElement("skill");
					wr.startElement("id");
					wr.characters(id);
					wr.endElement("id");
					wr.startElement("name");
					wr.characters(name);
					wr.endElement("name");
					wr.endElement("skill");
				}
				wr.endElement("skills");
				wr.endDocument();
			}
		} catch (SAXException e) {
			TPLogger.getLogger().error("Error while getting xml from list", e);
		}
		return sWr.getBuffer().toString();
	}

	public String getExtractedEducationXml(EducationalData eData, int level) {
		StringWriter sWr = new StringWriter();
		try {
			XMLWriter wr = new XMLWriter(sWr);
			wr.startDocument();
			wr.startElement("education");

			wr.startElement("level");
			wr.characters("" + level);
			wr.endElement("level");

			wr.startElement("degreeId");
			wr.characters("" + eData.getDegreeId());
			wr.endElement("degreeId");

			wr.startElement("branchId");
			wr.characters("" + eData.getMajorId());
			wr.endElement("branchId");

			wr.startElement("institute");
			wr.characters((Utils.isBlankOrNull(eData.getInstitute())) ? "" : eData.getInstitute());
			wr.endElement("institute");

			Date yearOfPassing = eData.getYearOfPassing();
			String yop = "";
			if (yearOfPassing != null) {
				yop = Utils.getDateConvertedToString(yearOfPassing, "yyyy");
			}
			wr.startElement("year");
			wr.characters(yop);
			wr.endElement("year");

			wr.endElement("education");
			wr.endDocument();
		} catch (SAXException e) {
			TPLogger.getLogger().error("Error while getting xml from list", e);
		}
		return sWr.getBuffer().toString();
	}

	/**
	 * copy html generated files from source to destination
	 * 
	 * @param srcFileAbsolutePath
	 * @param destFolderAbsolutePath
	 * @return the absolute path of html file, on error return blank string
	 */
	public String copyHtmlFiles(String srcFileAbsolutePath, String destFolderAbsolutePath) {
		String destHtmlAbsolutePath = "";
		try {
			FileHandler fileHandler = new FileHandler();
			String ext = FileHandlerUtils.getFileExtention(srcFileAbsolutePath, ".html");
			if (!ext.equalsIgnoreCase(".htm") && !ext.equalsIgnoreCase(".html")) {
				String srcHtmlAbsoluteFile = srcFileAbsolutePath.substring(0, srcFileAbsolutePath.lastIndexOf(".")) + ".html";
				File f = new File(srcHtmlAbsoluteFile);
				if (f.exists()) {
					String fileName = f.getName();
					destHtmlAbsolutePath = Utils.concatFilePath(destFolderAbsolutePath, fileName);
					fileHandler.copyFile(srcHtmlAbsoluteFile, destHtmlAbsolutePath);
					String srcFolder = srcHtmlAbsoluteFile.substring(0, srcHtmlAbsoluteFile.lastIndexOf(".")) + "_files";
					String destFolder = destHtmlAbsolutePath.substring(0, destHtmlAbsolutePath.lastIndexOf(".")) + "_files";
					// COPY FOLDER
					fileHandler.copyFolder(srcFolder, destFolder);

				}
			}
		} catch (Exception e) {
			TPLogger.getLogger().error("Error while copying html ");
			destHtmlAbsolutePath = "";
		}
		return destHtmlAbsolutePath;
	}

	/**
	 * returns original documents relative path to document folder. If original resume is extracted
	 * from email then saves email body as html document and return the relative path
	 * 
	 * @param attachmentId
	 * @param emailId
	 * @return
	 * @throws Exception
	 */
	public String saveOriginalResume(String attachmentId, String emailId, String uploadedFilePath) throws Exception {
		String resumeBody = "";
		String originalResumePath = "";
		InboxManager inboxManager = new InboxManager();
		if (!Utils.isBlankOrNull(attachmentId) && !attachmentId.equals("0")) {
			AttachmentData mData = inboxManager.getAttachmentData(attachmentId);
			originalResumePath = mData.getAttachmentFilePath();
		} else if (!Utils.isBlankOrNull(emailId)) {
			// The resume will be saved as .html file, the relative path
			MessageData messageData = inboxManager.getEmailBody(emailId, InboxConstants.EMAIL_LOCATION_INBOX);
			if (!Utils.isBlankOrNull(messageData.getHtmlBody())) {
				resumeBody = messageData.getHtmlBody();
			} else if (!Utils.isBlankOrNull(messageData.getTextBody())) {
				resumeBody = messageData.getTextBody();
			}
			DocumentUploader documentUploader = new DocumentUploader();
			DocumentData documentData = documentUploader.saveTextAsDocument(resumeBody, ".html");
			if (documentData != null) {
				originalResumePath = documentData.getRelativeFilePath();
			}
		} else if (!Utils.isBlankOrNull(uploadedFilePath)) {
			originalResumePath = uploadedFilePath;
		}
		return originalResumePath;
	}

	public void updateOriginalResume(String applicantId, String positionId,String applicantOriginalResumePath, String applicantOriginalDocPath, String textResume) throws Exception {
		DBPreparedQuery dq = null;
		DBTransaction tran = null;
		try {
			tran= new DBTransaction();
			String[] dynParams1 = new String[1];
			//wont update resume if applicant is shortlisted under any position
			if(Utils.isBlankOrNull(positionId)){
				dq = new DBPreparedQuery("dUpdateOriginalResume",tran);
				dq.setString(1, applicantOriginalResumePath);
				dq.setString(2, applicantOriginalDocPath);
				dq.setString(3, applicantId);
				dq.execute();
				dynParams1[0]= "isnull(position_id)";
			}else{
				dynParams1[0] = "position_id = ?"; 
			}
			dq = new DBPreparedQuery("dUpdateOriginalResumeMappingTable",dynParams1,tran);
			dq.setString(1, applicantOriginalResumePath);
			dq.setString(2, applicantOriginalDocPath);
			dq.setString(3, applicantId);
			if(!Utils.isBlankOrNull(positionId)){
				dq.setString(4, positionId);
			}
			dq.execute();
			
			String[] dynParams = new String[1];
			if(Utils.isBlankOrNull(positionId)){
				dynParams[0]= "isnull(applied_position_id)";
			}else{
				dynParams[0]= "applied_position_id = ?";
			}
			dq = new DBPreparedQuery("dUpdateTextResume",dynParams,tran);
			dq.setString(1, textResume);
			dq.setString(2, applicantId);
			if(!Utils.isBlankOrNull(positionId)){
				dq.setString(3, positionId);
			}
			dq.execute();
			
			tran.commit();

			// index the resume
			pushIntoEventQueueOnTalentPool(new TPIndexEvent(TPIndexEvent.TYPE_UPDATE_APPLICANT, applicantId, TPIndexEvent.PRIORITY_HIGH));

		} catch (SQLException e) {
			TPLogger.getLogger().error(GlobalConstants.ERROR, e);
			tran.rollback();
			throw e;
		} finally {
			if (dq != null) {
				dq.releaseTransaction(tran);
			}
		}
	}	

	private void pushIntoEventQueueOnTalentPool(TPIndexEvent indexEvent){
		Client client = Client.create();
		String params = "eventType=" + indexEvent.getEventType() + "&eventTypeId=" + indexEvent.getEventTypeId() + "&priority="+indexEvent.getPriority();
		WebResource webResource = client.resource(Utils.buildTalentPoolURL("rest/index/push?"+params));
		ClientResponse response = webResource.type("text/plain").get(ClientResponse.class);
		String res = response.getEntity(String.class);
		TPLogger.getLogger().debug("Applicant add index event push status : " + res);
		response.close();
	}
	
	public String getApplicantTitleConstructed(String applicantId, PermissionSet permissionSet){
		String applciantTitle = "";
		String[] aData = getApplicantNameandSource(applicantId);
		if(ImportConfigurationManager.isApplicantFieldViewable(ImportConfigurationConstants.FIELD_SOURCE ,permissionSet.isSHOW_CONFIDENTIAL_DATA())){
			String source = TPLabels.getLabel("common.openingRoundBracket")+TPLabels.getLabel("common.source")+" "+aData[1]+TPLabels.getLabel("common.closingRoundBracket");
			applciantTitle = aData[0]+" "+source;
		}else{
			applciantTitle = aData[0];
		}
		return applciantTitle;
	}
	
