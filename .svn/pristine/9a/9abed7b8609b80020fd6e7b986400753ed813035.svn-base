	/**
	 * use this to insert into sched table for new talentpool app
	 * @param applicantId
	 * @param indexStatus
	 */
	private void insertApplicantEventIntoEventSchedTable(String applicantId,String indexStatus){
		DBPreparedQuery dq = null;
		try{
			dq = new DBPreparedQuery("dApplicantManager_InsertIntoEventSched");
			dq.setString(1, applicantId);
			dq.setString(2, indexStatus);
			dq.setString(3, indexStatus);
			dq.execute();
		}catch(Exception e){
			TPLogger.getLogger().error("Error while inserting into event sched table", e);
		}finally {
			if(dq != null) {
				dq.closeOpenCursors();
			}
		}
	}
	
	/**
	 * @param candidateId
	 * @param applicantId
	 * @return inserted applicantid from the candidate applicant relation
	 */
	public void insertIntoCandidateApplicantMapping(String candidateId, String applicantId,DBTransaction tran){
		DBPreparedQuery dq = null;
		try{
			int cnt =1;
			dq = new DBPreparedQuery("dApplicantManager_InsertCandidateApplicantMapping",tran);
			dq.setString(cnt++,candidateId);
			dq.setString(cnt++,applicantId);
			dq.execute();
		}catch(Exception e){
			TPLogger.getLogger().error("Error inserting candidate applicant mapping", e);
		}finally {
			if(dq != null) {
				dq.closeOpenCursors();
			}
		}
	}
