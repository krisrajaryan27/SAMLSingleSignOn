	public String addApplicant(ApplicantData aData, String skillIds) throws Exception {
		return addApplicant(aData, skillIds, null);
	}
	
	public void updateApplicant(ApplicantData aData, String skillIds) throws Exception {
		 updateApplicant(aData, skillIds, null);
	}
	/**
	 * add applicant to DB
	 * 
	 * @param aData
	 * @return
	 * @throws Exception
	 */
	public String addApplicant(ApplicantData aData, String skillIds, String clientIpAddr) throws Exception {
		DBPreparedQuery dq = null;
		String applicantId = null;
		DBTransaction tran = null;
		try {
			tran = new DBTransaction();

			// Insert Applicant Summary
			dq = new DBPreparedQuery("dAddApplicantSummary", tran);
			dq.setString(1, aData.getApplicantName());
			dq.setString(2, Utils.isBlankOrNull(aData.getApplicantCity()) ? null : aData.getApplicantCity());
			dq.setString(3, Utils.isBlankOrNull(aData.getApplicantEmail1()) ? null : aData.getApplicantEmail1());
			dq.setString(4, Utils.isBlankOrNull(aData.getApplicantEmail2()) ? null : aData.getApplicantEmail2());
			dq.setString(5, Utils.isBlankOrNull(aData.getApplicantHomePhone()) ? null : aData.getApplicantHomePhone());
			dq.setString(6, Utils.isBlankOrNull(aData.getApplicantCellPhone()) ? null : aData.getApplicantCellPhone());
			dq.setString(7, Utils.isBlankOrNull(aData.getApplicantWorkPhone()) ? null : aData.getApplicantWorkPhone());
			dq.setDate(8, aData.getApplicantWorkingSince());
			if (aData.getApplicantDateImported() == null) {
				dq.setTimestamp(9, new Timestamp(new Date().getTime()));
			} else {
				dq.setDate(9, aData.getApplicantDateImported());
			}
			dq.setInt(10, aData.getApplicantSourceId());
			dq.setString(11, aData.getApplicantOriginalResumePath());
			dq.setString(12, aData.getApplicantOriginalDocPath());
//			dq.setString(13, aData.getApplicantTextResume());
			dq.setString(13, Utils.isBlankOrNull(aData.getApplicantCurrentEmployer()) ? null : aData.getApplicantCurrentEmployer());
			dq.setId(14, aData.getUserId());
			dq.setString(15, Utils.isBlankOrNull(aData.getCurrentCTC()) ? null : aData.getCurrentCTC());
			dq.setString(16, Utils.isBlankOrNull(aData.getExpectedCTC()) ? null : aData.getExpectedCTC());
			dq.setInt(17, aData.getApplicantSourceId());
			dq.setString(18, aData.getNoticePeriod());			
			dq.setDate(19, aData.getDateOfBirth());
			dq.setString(20, aData.getPassportNumber());
			dq.setString(21, Utils.isBlankOrNullOrDefault(aData.getResumeTypeId()) ? null : aData.getResumeTypeId());
			dq.setId(22, Utils.isBlankOrNull(aData.getVendorId()) ? null : aData.getVendorId());
			if(Utils.isBlankOrNull(aData.getIsConfidential())) {
				dq.setString(23, ApplicantConstants.APPLICANT_NOT_CONFIDENTIAL);
			} else {
				dq.setString(23, aData.getIsConfidential());
			}			
			dq.setString(24, Utils.isBlankOrNull(aData.getEmployeeCode()) ? null : aData.getEmployeeCode());
			
			dq.setString(25, Utils.isBlankOrNull(aData.getIsEmployeeApply()) ? null : aData.getIsEmployeeApply());
			dq.setString(26, Utils.isBlankOrNull(aData.getCategory()) ? null : aData.getCategory());
			dq.setString(27, Utils.isBlankOrNull(aData.getSubCategory()) ? null : aData.getSubCategory());
			dq.setString(28, Utils.isBlankOrNull(aData.getApplicantDeclaration()) ? "0" : aData.getApplicantDeclaration());
			dq.execute();

			dq = new DBPreparedQuery("dFetchLastInsertID", tran);

			applicantId = dq.getIdResult();
			aData.setApplicantId(applicantId);
			
			String positionId = aData.getApplicantPositionId();
			ApplicantJobPortalManager applicantJobPortalManager = new ApplicantJobPortalManager();
			if (!Utils.isBlankOrNull(positionId)) {
				String[] positionIds = positionId.split(",");
				for(int i=0; i<positionIds.length; i++){
					// Add Applicant Text Resume
					addApplicantTextResume(applicantId, aData.getApplicantTextResume(), positionIds[i], tran);
					applicantJobPortalManager.addApplicantPositionMapping(applicantId, positionIds[i], tran);
					dq = new DBPreparedQuery("dAddResumeApplicantPositionMapping", tran);
					dq.setString(1, aData.getApplicantOriginalResumePath());
					dq.setString(2, aData.getApplicantOriginalDocPath());
					dq.setString(3, applicantId);
					dq.setString(4, positionIds[i]);
					dq.execute();
				}
			}else{
				addApplicantTextResume(applicantId, aData.getApplicantTextResume(),null, tran);
				applicantJobPortalManager.addApplicantPositionMapping(applicantId, positionId, tran);
				dq = new DBPreparedQuery("dAddResumeApplicantPositionMapping1", tran);
				dq.setString(1, aData.getApplicantOriginalResumePath());
				dq.setString(2, aData.getApplicantOriginalDocPath());
				dq.setString(3, applicantId);
				dq.execute();
			}
			
			dq = new DBPreparedQuery("dFetchLastInsertID", tran);
			dq.getIdResult();
			//Scheduler for uploading applicant to graph database : START
			if(!Utils.isBlankOrNull(applicantId)){
				String uuid = (String) aData.getAttribute("uuid");
				if(!Utils.isBlankOrNull(uuid)) {
					addApplicantToken(applicantId, uuid, tran);
				}
				uploadApplicantDetailIntoGraphScheduler(applicantId);				
			}
			//Scheuler for uploading applicant to graph database : END
			
			// Add Applicant Text Resume
//			addApplicantTextResume(applicantId, aData.getApplicantTextResume(), tran);
			
			// Add Educational Qualifications
			ArrayList<EducationalData> eduDetails = aData.getEducationalDetails();
			addEducationDetails(eduDetails, applicantId, tran);

			// Add Applicant Skills
			if (!Utils.isBlankOrNull(skillIds)) {
				addApplicantSkills(skillIds, applicantId, tran);
			}
			
			// Add Employment History
			ArrayList<EmploymentHistoryData> empHistoryDetails = aData.getEmploymentHistoryDetails();
			addEmploymentHistoryDetails(empHistoryDetails, applicantId, tran);
						
			// add custom field values
			CustomFieldManager customFieldManager = new CustomFieldManager();
			customFieldManager.insertCustomFieldValues(aData.getCustomFields(), applicantId, CustomFieldConstants.ENTITY_TYPE_APPLICANT, tran);

			// add source id to recently used sources
			RecentlyUsedSources.INSTANCE.addSourceToRecentlyUsed("" + aData.getApplicantSourceId());
			
			LatestActivityManager activityManager = new LatestActivityManager(); 
			activityManager.addUserActivity("Imported", applicantId, SelectionProcessConstants.INTERACTION_IMPORT, null, applicantId, aData.getUserId());
	
			//add to candidate applicant mapping if applicable\
			AdminManager adminManager = new AdminManager();
			SourceData srcData= adminManager.getCandidatePortalSource();
			if(Integer.parseInt(srcData.getSourceId())== aData.getApplicantSourceId()){
				insertIntoCandidateApplicantMapping(aData.getCandidatePortalId(), applicantId,tran);
			}
			
			tran.commit();
			insertApplicantEventIntoEventSchedTable(applicantId,ApplicantConstants.APPLICANT_INDEX_PENDING);
			if (Utils.isBlankOrNull(aData.getApplicantPositionId())){
			AuditAction auditAction = new AuditAction();
			auditAction.insertAuditInfo(TPLabels.getLabel("common.applicant"), AuditConstants.TYPE_ADDED, applicantId,
					AuditConstants.AUDIT_CANDIDATE, aData.getUserId(), null, null, null, true, clientIpAddr);
			}
		} catch (SQLException e) {
			TPLogger.getLogger().error(GlobalConstants.ERROR, e);
			tran.rollback();
			throw e;
		} finally {
			if (dq != null) {
				dq.releaseTransaction(tran);
			}
		}
		return applicantId;
	}

	public void updateApplicant(ApplicantData aData, String skillIds, String clientIpAddr) throws Exception {
		DBPreparedQuery dq = null;
		String applicantId = "" + aData.getApplicantId();
		DBTransaction tran = null;
		try {
			ApplicantData oldApplicantData = getApplicantSummaryData(aData.getApplicantId());

			tran = new DBTransaction();
			Integer sourceId= (aData.getApplicantSourceId()==-1)?oldApplicantData.getApplicantSourceId():aData.getApplicantSourceId(); 
			// Insert Applicant Summary
			dq = new DBPreparedQuery("dUpdateApplicantSummary", tran);
			dq.setString(1, aData.getApplicantName());
			dq.setString(2, Utils.isBlankOrNull(aData.getApplicantCity()) ? null : aData.getApplicantCity());
			dq.setString(3, Utils.isBlankOrNull(aData.getApplicantEmail1()) ? null : aData.getApplicantEmail1());
			dq.setString(4, Utils.isBlankOrNull(aData.getApplicantEmail2()) ? null : aData.getApplicantEmail2());
			dq.setString(5, Utils.isBlankOrNull(aData.getApplicantHomePhone()) ? null : aData.getApplicantHomePhone());
			dq.setString(6, Utils.isBlankOrNull(aData.getApplicantCellPhone()) ? null : aData.getApplicantCellPhone());
			dq.setString(7, Utils.isBlankOrNull(aData.getApplicantWorkPhone()) ? null : aData.getApplicantWorkPhone());
			dq.setDate(8, aData.getApplicantWorkingSince());
			dq.setInt(9, sourceId);
			dq.setString(10, Utils.isBlankOrNull(aData.getApplicantCurrentEmployer()) ? null : aData.getApplicantCurrentEmployer());
			dq.setString(11, aData.getNoticePeriod());
			dq.setDate(12, aData.getDateOfBirth());
			dq.setString(13, aData.getPassportNumber());
			dq.setString(14, Utils.isBlankOrNull(aData.getResumeTypeId()) ? null : aData.getResumeTypeId());
			dq.setId(15, Utils.isBlankOrNull(aData.getVendorId()) ? null : aData.getVendorId());
			dq.setId(16, Utils.isBlankOrNull(aData.getEmployeeCode()) ? null : aData.getEmployeeCode());
			dq.setString(17,Utils.isBlankOrNull(aData.getProfilePicPath()) ? null : aData.getProfilePicPath());
			dq.setString(18, aData.getApplicantDeclaration());
			dq.setId(19, applicantId);
			dq.execute();

			// update Educational Qualifications
			dq = new DBPreparedQuery("dDeleteApplicantEducationInfo", tran);
			dq.setId(1, applicantId);
			dq.execute();
			
			String positionId = aData.getApplicantPositionId();
			if (!Utils.isBlankOrNull(positionId)) {
				String[] positionIds = positionId.split(",");
				ApplicantJobPortalManager applicantJobPortalManager = new ApplicantJobPortalManager();
				for(int i=0; i<positionIds.length; i++){
					// Add Applicant Text Resume
					addApplicantTextResume(applicantId, aData.getApplicantTextResume(), positionIds[i], tran);
					applicantJobPortalManager.addApplicantPositionMapping(applicantId, positionIds[i], tran);
					dq = new DBPreparedQuery("dAddResumeApplicantPositionMapping", tran);
					dq.setString(1, aData.getApplicantOriginalResumePath());
					dq.setString(2, aData.getApplicantOriginalDocPath());
					dq.setString(3, applicantId);
					dq.setString(4, positionIds[i]);
					dq.execute();
				}
			}

			ArrayList<EducationalData> eduDetails = aData.getEducationalDetails();
			addEducationDetails(eduDetails, applicantId, tran);

			// update Applicant Skills
			dq = new DBPreparedQuery("dDeleteApplicantSkills", tran);
			dq.setId(1, applicantId);
			dq.execute();

			if (!Utils.isBlankOrNull(skillIds)) {
				addApplicantSkills(skillIds, applicantId, tran);
			}
			
			// update Employment History
			dq = new DBPreparedQuery("dEmploymentHistory_DeleteEmploymentHistory", tran);
			dq.setId(1, applicantId);
			dq.execute();
			ArrayList<EmploymentHistoryData> empHistoryDetails = aData.getEmploymentHistoryDetails();
			addEmploymentHistoryDetails(empHistoryDetails, applicantId, tran);


			// update custom fields
			CustomFieldManager customFieldManager = new CustomFieldManager();
			customFieldManager.deleteCustomFieldValuesForEntity(applicantId, CustomFieldConstants.ENTITY_TYPE_APPLICANT, tran);
			customFieldManager.deleteCustomFieldValuesForEntity(applicantId, CustomFieldConstants.ENTITY_TYPE_APPLICANT_TABLE_FIELD, tran);
			customFieldManager.insertCustomFieldValues(aData.getCustomFields(), applicantId, CustomFieldConstants.ENTITY_TYPE_APPLICANT, tran);

			updateApplicantCTC(applicantId, aData.getCurrentCTC(), aData.getExpectedCTC(), oldApplicantData.getCurrentCTC(), oldApplicantData.getExpectedCTC(), tran);
			updateSourceLockinDate(applicantId, aData.getApplicantSourceId(), oldApplicantData.getApplicantSourceId(), tran);
			//add to candidate applicant mapping if applicable\
			AdminManager adminManager = new AdminManager();
			SourceData srcData= adminManager.getCandidatePortalSource();
			if(Integer.parseInt(srcData.getSourceId())== aData.getApplicantSourceId()){
				insertIntoCandidateApplicantMapping(aData.getCandidatePortalId(), applicantId,tran);
			}
			tran.commit();
			uploadApplicantDetailIntoGraphScheduler(applicantId);
			insertApplicantEventIntoEventSchedTable(applicantId,ApplicantConstants.APPLICANT_INDEX_PENDING);
			if (Utils.isBlankOrNull(aData.getApplicantPositionId())){
			AuditAction auditAction = new AuditAction();
			auditAction.insertAuditInfo(TPLabels.getLabel("common.applicant"), AuditConstants.TYPE_MODIFIED, applicantId,
					AuditConstants.AUDIT_CANDIDATE, aData.getUserId(), null, null, null, true, clientIpAddr);
			}
	
		} catch (SQLException e) {
			TPLogger.getLogger().error(GlobalConstants.ERROR, e);
			tran.rollback();
			throw e;
		} finally {
			if (dq != null) {
				dq.releaseTransaction(tran);
			}
		}

	}

	public void addEducationDetails(ArrayList<EducationalData> eduDetails, String applicantId, DBTransaction tran) throws Exception {
		DBPreparedQuery dq = null;
		try {
			if (eduDetails != null) {
				for (int i = 0; i < eduDetails.size(); i++) {
					EducationalData eData = eduDetails.get(i);
					if (!Utils.isBlankOrNull(eData.getInstitute()) && eData.getInstitute().length()<150) {
						String instituteId = autoUpdateInstitute(eData.getInstitute().trim(), tran);
						eData.setInstituteId(instituteId);
					}
					dq = new DBPreparedQuery("dAddEducationInfo", tran);
					dq.setId(1, applicantId);
					dq.setId(2, eData.getDegreeId() <= 0 ? null : "" + eData.getDegreeId());
					dq.setString(3, eData.getMajorId() <= 0 ? null : "" + eData.getMajorId());
					dq.setString(4, Utils.isBlankOrNull(eData.getInstituteId()) ? null : eData.getInstituteId());
					dq.setDate(5, eData.getYearOfPassing());
					dq.setString(6, eData.getGrade());
					dq.setDate(7,eData.getFromYear());
					dq.setString(8, eData.getRemarks());
					dq.setDate(9, eData.getStartDate());
					dq.setDate(10,eData.getEndDate());
					dq.setString(11, eData.getUniversity());
					dq.setString(12, eData.getTypeOfProgram());
					dq.execute();
				}
			}
		} catch (Exception e) {
			throw e;
		} finally {
			if (dq != null) {
				if (tran == null) {
					dq.releaseConnection();
				} else {
					dq.closeOpenCursors();
				}
			}
		}
	}
	
	public void addApplicantTextResume(String applicantId, String applicantTextResume, String positionId, DBTransaction tran) throws Exception {
		DBPreparedQuery dq = null;
		try {
			dq = new DBPreparedQuery("dAddApplicantTextResume", tran);
			dq.setId(1, applicantId);
			dq.setString(2, applicantTextResume);
			dq.setString(3, Utils.isBlankOrNull(positionId) ? null : positionId);
			dq.execute();
		} catch (Exception e) {
			throw e;
		} finally {
			if (dq != null) {
				if (tran == null) {
					dq.releaseConnection();
				} else {
					dq.closeOpenCursors();
				}
			}
		}
	}

	/**
	 * auto updates the institute table, if institute does not exist and return new institute id
	 * 
	 * @param instituteName
	 * @param tran
	 * @return
	 * @throws Exception
	 */
	public String autoUpdateInstitute(String instituteName, DBTransaction tran) throws Exception {
		DBPreparedQuery dq = null;
		String instituteId;
		
		if(instituteName.length()>150){
			instituteName = instituteName.substring(0,145);
		}
		
		try {
			dq = new DBPreparedQuery("dGetInstituteId", tran);
			dq.setString(1, instituteName);
			dq.setString(2, instituteName);
			instituteId = dq.getIdResult();

			if (Utils.isBlankOrNull(instituteId)) {
				dq = new DBPreparedQuery("dInsertInstitute", tran);
				dq.setString(1, instituteName);
				dq.execute();
				dq = new DBPreparedQuery("dFetchLastInsertID", tran);
				instituteId = dq.getIdResult();
			}

		} catch (Exception e) {
			throw e;
		} finally {
			if (dq != null) {
				if (tran == null) {
					dq.releaseConnection();
				} else {
					dq.closeOpenCursors();
				}
			}
		}
		return instituteId;
	}

	public void addApplicantSkills(String skillIds, String applicantId, DBTransaction tran) throws Exception {
		DBPreparedQuery dq = null;
		try {
			String[] skills = skillIds.split(",");
			if (skills != null) {
				for (int i = 0; i < skills.length; i++) {
					dq = new DBPreparedQuery("dAddApplicantSkills", tran);
					dq.setId(1, applicantId);
					dq.setInt(2, Integer.parseInt(skills[i].trim()));
					dq.execute();
				}
			}
		} catch (Exception e) {
			throw e;
		} finally {
			if (dq != null) {
				if (tran == null) {
					dq.releaseConnection();
				} else {
					dq.closeOpenCursors();
				}
			}
		}
	}

	/**
	 * Update current CTC and expected CTC with the date if new Expected CTC and new Current CTC are
	 * diffrent that old
	 * 
	 * @param applicantId
	 * @param cCTC
	 * @param eCTC
	 * @param pcCTC
	 * @param peCTC
	 * @param tran
	 * @throws Exception
	 */
	public void updateApplicantCTC(String applicantId, String cCTC, String eCTC, String pcCTC, String peCTC, DBTransaction tran) throws Exception {
		DBPreparedQuery dq = null;
		try {
			cCTC = Utils.isBlankOrNull(cCTC) ? "" : cCTC;
			eCTC = Utils.isBlankOrNull(eCTC) ? "" : eCTC;
			pcCTC = Utils.isBlankOrNull(pcCTC) ? "" : pcCTC;
			peCTC = Utils.isBlankOrNull(peCTC) ? "" : peCTC;
			if (!cCTC.equals(pcCTC)) {
				dq = new DBPreparedQuery("dUpdateCurrentCTC", tran);
				dq.setString(1, Utils.isBlankOrNull(cCTC) ? null : cCTC);
				dq.setId(2, applicantId);
				dq.execute();
			}
			if (!eCTC.equals(peCTC)) {
				dq = new DBPreparedQuery("dUpdateExpectedCTC", tran);
				dq.setString(1, Utils.isBlankOrNull(eCTC) ? null : eCTC);
				dq.setId(2, applicantId);
				dq.execute();
			}
		} catch (Exception e) {
			TPLogger.getLogger().error("Error while setting CTC", e);
			throw e;
		} finally {
			if (dq != null) {
				if (tran == null) {
					dq.releaseConnection();
				} else {
					dq.closeOpenCursors();
				}
			}
		}

	}

	/**
	 * Update original source id and lock in date if new source id is different than previous source
	 * id
	 * 
	 * @param applicantId
	 * @param currentSourceId
	 * @param oldSourceId
	 * @param tran
	 * @throws Exception
	 */
	public void updateSourceLockinDate(String applicantId, int currentSourceId, int oldSourceId, DBTransaction tran) throws Exception {
		DBPreparedQuery dq = null;
		boolean commit = false;
		try {
			if (currentSourceId != oldSourceId) {
				if (tran == null) {
					tran = new DBTransaction();
					commit = true;
				}
				dq = new DBPreparedQuery("dUpdateApplicantLockinDate", tran);
				dq.setInt(1, oldSourceId);
				dq.setId(2, applicantId);
				dq.execute();
				if (commit) {
					tran.commit();
				}
			}
		} catch (Exception e) {
			TPLogger.getLogger().error("Error while setting lockin date", e);
			if (commit) {
				tran.rollback();
			}
			throw e;
		} finally {
			if (dq != null) {
				if (commit) {
					dq.releaseTransaction(tran);
				} else {
					dq.closeOpenCursors();
				}
			}
		}

	}

