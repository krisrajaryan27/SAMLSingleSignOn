	/**
	 * delete applicant from repository as well as DB and deletes all files in a thread
	 * 
	 * @param applicantIds
	 * @throws Exception
	 */
	public void deleteApplicant(String applicantIds) throws Exception {
		DBTransaction tran = null;
		DBPreparedQuery dq = null;
		String[] dynParams = null;
		try {
			tran = new DBTransaction();
			
			dynParams = new String[1];
			dynParams[0] = applicantIds;
			
			dq = new DBPreparedQuery("dApplicantManager_DeleteOutbounds", dynParams, tran);
			dq.setString(1, OutBoundConstants.ENTITY_TYPE_APPLICANTS);
			dq.execute();

			dq = new DBPreparedQuery("dApplicantManager_DeleteCommunications", dynParams, tran);
			dq.execute();

			dq = new DBPreparedQuery("dApplicantManager_DeleteMessagesTo", dynParams, tran);
			dq.execute();

			dq = new DBPreparedQuery("dApplicantManager_DeleteMessages", dynParams, tran);
			dq.execute();

			dq = new DBPreparedQuery("dApplicantManager_DeleteAppointmentAttendees", dynParams, tran);
			dq.execute();

			dq = new DBPreparedQuery("dApplicantManager_DeleteAppointments", dynParams, tran);
			dq.execute();

			dq = new DBPreparedQuery("dApplicantManager_DeleteAppointmentNotifications", dynParams, tran);
			dq.execute();

			dq = new DBPreparedQuery("dApplicantManager_DeleteApplicantStatusMessages", dynParams, tran);
			dq.execute();

			dq = new DBPreparedQuery("dApplicantManager_DeleteApplicantSkills", dynParams, tran);
			dq.execute();

			dq = new DBPreparedQuery("dApplicantManager_DeleteApplicantSelectionProcessTraits", dynParams, tran);
			dq.execute();

			// first check if the applicantId is present in event log
			// table, then only regenerate summary report tables
			dq = new DBPreparedQuery("dApplicantManager_GetApplicantsInSummaryReport", dynParams, tran);
			int count = dq.getIntResult(0);
						
			dq = new DBPreparedQuery("dApplicantManager_DeleteApplicantSelectionProcess", dynParams, tran);
			dq.execute();

			dq = new DBPreparedQuery("dApplicantManager_GetApplicantEmailAttachments", dynParams, tran);
			ArrayList attachments = dq.getResult();
			// generate files list
			ArrayList<String> files = new ArrayList<String>();
			if (attachments != null && attachments.size() > 0) {
				for (int i = 0; i < attachments.size(); i++) {
					AttachmentData aData = (AttachmentData) attachments.get(i);
					files.add(aData.getAttachmentFilePath());
				}
			}

			dq = new DBPreparedQuery("dApplicantManager_DeleteApplicantEmailAttachments", dynParams, tran);
			dq.execute();

			dq = new DBPreparedQuery("dApplicantManager_DeleteApplicantEmails", dynParams, tran);
			dq.execute();
			
			dq = new DBPreparedQuery("dApplicantManager_DeleteInboxEmailsForApplicant", dynParams, tran);
			dq.execute();			

			dq = new DBPreparedQuery("dApplicantManager_DeleteApplicantEducationalInfo", dynParams, tran);
			dq.execute();

			dq = new DBPreparedQuery("dApplicantManager_DeleteFlags", dynParams, tran);
			dq.execute();

			dq = new DBPreparedQuery("dApplicantManager_DeleteCustomFieldsValues", dynParams, tran);
			dq.execute();

			dq = new DBPreparedQuery("dApplicantManager_DeleteLastViewed", dynParams, tran);
			dq.setString(1, UserConstants.ENTITY_CANDIDATE);
			dq.execute();

			if (count > 0) {
				// summary report effect
				dq = new DBPreparedQuery("dApplicantManager_GetMinApplicantDateCreated", dynParams, tran);
				String applicantDateCreatedStr = dq.getStringResult();

				// applicant created date should not be less than last run time of summary report scheduler,
				//		else take that date.
				Date applicantDateCreated = DateUtils.convertToDate(applicantDateCreatedStr, DateConstants.DB_DATE_TIME_PATTERN);
				Date lastRunDate = (new MasterTablesManager()).getLastRunDate(tran);
				if(applicantDateCreated.before(lastRunDate)) {
					lastRunDate = applicantDateCreated;
				}
				
				new MasterTablesManager().updateSchedulerLastRunDate(lastRunDate, tran);
				UpdateMasterTablesScheduler.resetRegenerateMasterTableTrigger();
			}
			
			/* delete document from repository */
			String[] applicants = applicantIds.split(",");
			ApplicantJobPortalManager applicantJobPortalManager = new ApplicantJobPortalManager();
			
			for(int i = 0; i < applicants.length; i++) {
				applicantJobPortalManager.deleteApplicantPositionMappingByApplicant(applicants[i].trim(), tran);
				TPIndexEventQueue.push(new TPIndexEvent(TPIndexEvent.TYPE_DELETE_APPLICANT, applicants[i].trim(), TPIndexEvent.PRIORITY_HIGH));
			}			

			DocumentManager documentManager = new DocumentManager();
			ArrayList<DocumentData> docs = documentManager.getApplicantDocuments(applicantIds);
			if (docs != null) {
				for (int i = 0; i < docs.size(); i++) {
					DocumentData data = docs.get(i);
					files.add(data.getRelativeFilePath());
				}
			}

			dq = new DBPreparedQuery("dApplicantManager_DeleteApplicantDocuments", dynParams, tran);
			dq.execute();

			dq = new DBPreparedQuery("dApplicantManager_DeleteApplicantTextResume", dynParams, tran);
			dq.execute();
			
			
			
			dq = new DBPreparedQuery("dApplicantManager_DeleteApplicant", dynParams, tran);
			dq.execute();
			
			dq = new DBPreparedQuery("dApplicantManager_DeleteApplicantCandidateMapping",dynParams,tran);
			dq.execute();

			tran.commit();
			for(String applicant:applicants){
				insertApplicantEventIntoEventSchedTable(applicant.trim(),ApplicantConstants.APPLICANT_INDEX_DELETE);
			}
			// start thread to delete attachments files.
			new DeleteFilesThread(files, true);
		} catch (Exception e) {
			tran.rollback();
			TPLogger.getLogger().error("Error while deleting the applicant with id " + applicantIds, e);
			throw e;
		} finally {
			if (dq != null) {
				dq.releaseTransaction(tran);
			}
		}
	}

	public void setApplicantFlags(String applicantId, String flagIds, String userId) {
		DBPreparedQuery dq = null;
		DBTransaction tran = null;
		String[] dynParams = new String[2];
		try {
			tran = new DBTransaction();
			if (!Utils.isBlankOrNull(flagIds)) {
				String[] temp = flagIds.split(",");
				for (int i = 0; i < temp.length; i++) {
					dq = new DBPreparedQuery("dApplicantManager_InsertOrUpdateApplicantFlag", tran);
					dq.setString(1, applicantId);
					dq.setString(2, temp[i]);
					dq.setString(3, temp[i]);
					dq.execute();
				}
			} else {
				flagIds = "-1";
			}
			dynParams[0] = flagIds;
			dynParams[1] = applicantId;
			dq = new DBPreparedQuery("dApplicantManager_DeleteDeselectedFlags", dynParams, tran);
			dq.setString(1, MastersConstants.FLAG_TYPE_PUBLIC);
			dq.setString(2, userId);
			dq.execute();
			tran.commit();
		} catch (Exception e) {
			try {
				tran.rollback();
			} catch (Exception ex) {
				TPLogger.getLogger().error("Error while rolling back the transaction", ex);
			}
			TPLogger.getLogger().error("Error while setting applicant flag " + applicantId, e);
		} finally {
			if (tran != null) {
				tran.release();
			}
		}
	}

	public void setApplicantFlags(String applicantId, String selectedIds, String tristateIds, String userId) throws Exception {
		DBPreparedQuery dq = null;
		DBTransaction tran = null;
		try {
			tran = new DBTransaction();

			if (!Utils.isBlankOrNull(selectedIds) && !Utils.isBlankOrNull(applicantId)) {
				String[] selectedCats = selectedIds.split(",");
				String[] applicantIds = applicantId.split(",");
				for (int c = 0; c < selectedCats.length; c++) {
					for (int i = 0; i < applicantIds.length; i++) {
						dq = new DBPreparedQuery("dApplicantManager_InsertOrUpdateApplicantFlag", tran);
						dq.setId(1, applicantIds[i]);
						dq.setId(2, selectedCats[c]);
						dq.setId(3, selectedCats[c]);
						dq.execute();
					}
				}
			}

			String[] dynParams = new String[2];
			dynParams[0] = "";
			if (!Utils.isBlankOrNull(selectedIds)) {
				dynParams[0] = selectedIds;
			}
			if (!Utils.isBlankOrNull(tristateIds)) {
				if (!Utils.isBlankOrNull(dynParams[0])) {
					dynParams[0] += ",";
				}
				dynParams[0] += tristateIds;
			}
			if (Utils.isBlankOrNull(dynParams[0])) {
				dynParams[0] = "-1";
			}
			dynParams[1] = applicantId;
			dq = new DBPreparedQuery("dApplicantManager_DeleteDeselectedFlags", dynParams, tran);
			dq.setString(1, MastersConstants.FLAG_TYPE_PUBLIC);
			dq.setString(2, userId);
			dq.execute();

			tran.commit();
		} catch (Exception e) {
			TPLogger.getLogger().error("Error saving applicant flags", e);
			tran.rollback();
			throw e;
		} finally {
			if (dq != null) {
				dq.releaseTransaction(tran);
			}
		}

	}

	/**
	 * Uploads file to attachments folder according to month day folder
	 * 
	 * @param formFile
	 * @return
	 * @throws FileUploadException
	 * @throws InvalidMimeTypeException 
	 */
	public AttachmentData uploadResumeTmp(FormFileData formFileData) throws FileUploadException, InvalidMimeTypeException {
		AttachmentData aData = null;
		DocumentData documentData = null;
		try {
			// First upload the attachment
			// get absolute attachment path

			// now get the folder structure
			DocumentUploader documentUploader = new DocumentUploader();
			documentData = documentUploader.saveFormFile(formFileData);

			aData = new AttachmentData();
			aData.setAttachmentFilePath(documentData.getRelativeFilePath());
			aData.setOriginalFileName(formFileData.getFileName());
			aData.setAttachmentSize(formFileData.getFileSize());

		} catch (InvalidMimeTypeException e) {
			throw e;
		} catch (Exception e) {
			TPLogger.getLogger().error("Error while uploading resume file to destination ", e);
			try {
				if (documentData != null) {
					File f = new File(documentData.getAbsoluteFilePath());
					if (f.exists()) {
						f.delete();
					}
				}
			} catch (Exception fe) {
				TPLogger.getLogger().debug("Unable to delete file", fe);
			}
			throw new FileUploadException("Unable to upload file");
		}

		return aData;
	}

