	public SimpleDataObject getApplicantDetails(String applicantId) throws SQLException {
		SimpleDataObject sDo = null;
		DBPreparedQuery dq = null;
		try {
			dq = new DBPreparedQuery("dApplicantManager_GetApplicantData");
			dq.setString(1, applicantId);
			sDo = (SimpleDataObject) dq.getSingleObjectResult();
			
			CustomFieldData data = null;
			CustomFieldManager customFieldManager = new CustomFieldManager();
			ArrayList<CustomFieldData> customFields = customFieldManager.getCustomFieldDataForEntity(applicantId, CustomFieldConstants.ENTITY_TYPE_APPLICANT);
			if(customFields != null && customFields.size() > 0) {
				for(int i = 0; i < customFields.size(); i++) {
					data = customFields.get(i);
					sDo.setAttribute(data.getFieldName(), data.getDisplayValue());
				}
			}
			
			CustomFieldManager positionCustomFieldManager = new CustomFieldManager();
			ArrayList<CustomFieldData> positionCustomFields = positionCustomFieldManager.getCustomFieldDataForEntity(""+(Long)sDo.getAttribute("applicant_position_id"), CustomFieldConstants.ENTITY_TYPE_POSITION);
			if(positionCustomFields != null && positionCustomFields.size() > 0) {
				for(int i = 0; i < positionCustomFields.size(); i++) {
					data = positionCustomFields.get(i);
					sDo.setAttribute(data.getFieldName(), data.getDisplayValue());
				}
			}
			
		} finally {
			if(dq != null) {
				dq.releaseConnection();
			}
		}
		return sDo;
	}
	
