	/**
	 * Updates all the applicantFields present in applicantFieldMap.
	 * <p>Values for Custom Field which are present in <code>applicantFieldMap</code> are deleted and then re-inserted.</p>
	 * @param applicantId
	 * @param applicantFieldMap
	 * @param tran
	 * @param dbq
	 * @throws SQLException,Exception 
	 */
	public void updateApplicantFields(String applicantId,Map<String,String> applicantFieldMap, DBTransaction tran, DBPreparedQuery dbq) throws SQLException,Exception {
		String[] dynParam = {""}; 
		List<String> dynamicContent = null;
		ArrayList<CustomFieldData> custFldLst = new ArrayList<CustomFieldData>();
		CustomFieldManager cFieldManager = null;
		int cnt = 1;
		try{
			if (applicantFieldMap!=null && applicantFieldMap.size()>0) {
				
					//tran = new DBTransaction();
				dynamicContent = new ArrayList<String>();
				dynParam[0] = buildApplicantFieldsUpdateQuery(applicantFieldMap,dynamicContent,custFldLst);
				
				if(!Utils.isBlankOrNull(dynParam[0])){
					if(tran==null)
						dbq = new DBPreparedQuery("dUpdateApplicantFields", dynParam);
					else
						dbq = new DBPreparedQuery("dUpdateApplicantFields", dynParam,tran);
						
					for (String dynParamVal : dynamicContent) {
						dbq.setString(cnt++, dynParamVal);
					}
					dbq.setString(cnt++, applicantId);
					dbq.execute();
				}
				
				if(custFldLst.size()>0){
					cFieldManager = new CustomFieldManager();
					String custFldIds = null;
					for (CustomFieldData customFieldData : custFldLst) {
						if(custFldIds!=null)
							custFldIds+=","+customFieldData.getFieldId();
						else
							custFldIds=customFieldData.getFieldId();
					}
					cFieldManager.deleteCustomFieldValuesForEntity(custFldIds,applicantId, CustomFieldConstants.ENTITY_TYPE_APPLICANT, tran);
					cFieldManager.insertCustomFieldValues(custFldLst, applicantId, CustomFieldConstants.ENTITY_TYPE_APPLICANT, tran);
				}
			}	
		}finally {
			if (dbq != null) {
				if (tran == null) {
					dbq.releaseConnection();
				} else {
					dbq.closeOpenCursors();
				}
			}
		}
	}
	
	/**
	 * Update query for Applicant fields is built and returned as String and if the fields map contains custom fields then,
	 * corresponding CustomFieldData objects are prepared and added to the custFldLst.  
	 * @param applicantFieldMap
	 * @param dynamicContent
	 * @return
	 */
	private String buildApplicantFieldsUpdateQuery(Map<String,String> applicantFieldMap,List<String> dynamicContent,List<CustomFieldData> custFldLst) throws SQLException {
		StringBuffer sb = new StringBuffer();
		String appFieldId = null;
		String appFieldValue = null;
		String appFieldDbMapping = null;
		CustomFieldData cData = null;
	    for (Map.Entry<String, String> entry: applicantFieldMap.entrySet()) {
	    	appFieldId = entry.getKey();
	    	appFieldValue = entry.getValue();
	    	if(ImportConfigurationManager.isApplicantCustomField(appFieldId)) {
	    		cData  = setCustomFieldVal(appFieldId,appFieldValue);
	    		custFldLst.add(cData);
	    	}else {
	    		if(ImportConfigurationConstants.FIELD_EXPERIENCE.equals(appFieldId)){
	    			if(!Utils.isBlankOrNull(appFieldValue))
	    				appFieldValue = Utils.convertToSQLDate("1" + Utils.dateDescSeparator + appFieldValue, Utils.regDDMMMYYYYFormat).toString();
	    		}
	    		appFieldDbMapping = ImportConfigurationManager.getImportFieldDbMapping(appFieldId);
		    	if(!Utils.isBlankOrNull(appFieldDbMapping)){
		    		sb.append(appFieldDbMapping);
			    	sb.append(" = ?").append(CommonConstants.DEFAULT_DELIMITER);
			    	dynamicContent.add(appFieldValue);
		    	}
	    	}
	    }
	    if(applicantFieldMap.containsKey(ImportConfigurationConstants.FIELD_CURRENT_CTC)){
	    	sb.append("current_ctc_date");
	    	sb.append(" = now()").append(CommonConstants.DEFAULT_DELIMITER);
	    }
	    if(applicantFieldMap.containsKey(ImportConfigurationConstants.FIELD_EXPECTED_CTC)){
	    	sb.append("expected_ctc_date");
	    	sb.append(" = now()").append(CommonConstants.DEFAULT_DELIMITER);
	    }
	    
	    if(sb.lastIndexOf(CommonConstants.DEFAULT_DELIMITER)!=-1){
	    	sb.deleteCharAt(sb.lastIndexOf(CommonConstants.DEFAULT_DELIMITER));
	    }
	    	
		return sb.toString();
	}
	
	private CustomFieldData setCustomFieldVal(String cusFieldName,String values) {
		CustomFieldDataProcessor customFieldDataProcessor = new CustomFieldDataProcessor();
		CustomFieldManager  customFieldManager = new CustomFieldManager();
		CustomFieldData cData = customFieldManager.getCustomFieldByName(cusFieldName, true);
		customFieldDataProcessor.setCustomFieldValues(values, cData);
		return cData;
	}
	
	public void addEmploymentHistoryDetails(ArrayList<EmploymentHistoryData> employmentHistoryDetails, String applicantId, DBTransaction tran) throws Exception {
		DBPreparedQuery dq = null;
		try {
			if (employmentHistoryDetails != null) {
				for (int i = 0; i < employmentHistoryDetails.size(); i++) {
					EmploymentHistoryData empHistoryData = employmentHistoryDetails.get(i);
					if(!Utils.isBlankOrNull(empHistoryData.getEmployerName()) && empHistoryData.getEmployerName().length()<150){
						String employerId = autoUpdateEmployer(empHistoryData.getEmployerName(),tran);
						if(!Utils.isBlankOrNull(employerId)){
							empHistoryData.setEmployerId(Integer.parseInt(employerId));
						}else{
							empHistoryData.setEmployerId(-1);
						}
					}else{
						if(empHistoryData.getEmployerId()!=null&&empHistoryData.getEmployerId()!=-1){
							
						}else{
							empHistoryData.setEmployerId(-1);
						}
						
					}
					if(!Utils.isBlankOrNull(empHistoryData.getDesignationName()) && empHistoryData.getDesignationName().length()<150){
						String designationId = autoUpdateDesignation(empHistoryData.getDesignationName(),tran);
						if(!Utils.isBlankOrNull(designationId)){
							empHistoryData.setDesignationId(Integer.parseInt(designationId));
						}else{
							empHistoryData.setDesignationId(-1);
						}
					}else{
						empHistoryData.setDesignationId(-1);
					}
					dq = new DBPreparedQuery("dEmploymentHistory_addEmploymentHistory", tran);
					
					dq.setId(1, applicantId);
					dq.setDate(2, empHistoryData.getEmployerFromDate());
					dq.setDate(3, empHistoryData.getEmployerToDate());
					dq.setId(4, empHistoryData.getEmployerId()<= 0 ? null : ""+empHistoryData.getEmployerId());
					dq.setId(5, empHistoryData.getDesignationId() <= 0 ? null : ""+empHistoryData.getDesignationId());					
					dq.setDouble(6, Utils.isBlankOrNull(empHistoryData.getEmployerExperience())? 0.0: Float.parseFloat(empHistoryData.getEmployerExperience()));
					dq.setString(7,empHistoryData.getGrossSalary());
					dq.setString(8, empHistoryData.getAllowance());
					dq.setString(9, empHistoryData.getReasonForLeaving());
					dq.setString(10, empHistoryData.getDutiesInvolved());
					dq.setString(11, Utils.isBlankOrNull(empHistoryData.getEmpType())?"":empHistoryData.getEmpType());
					dq.setString(12, Utils.isBlankOrNull(empHistoryData.getCountry())?"-1":empHistoryData.getCountry());
					dq.setString(13, Utils.isBlankOrNull(empHistoryData.getLocation())?"":empHistoryData.getLocation());
					dq.setString(14, Utils.isBlankOrNull(empHistoryData.getLastCtc())?"0":empHistoryData.getLastCtc());
					dq.execute();
				}
			}
		} catch (Exception e) {
			throw e;
		} finally {
			if (dq != null) {
				if (tran == null) {
					dq.releaseConnection();
				} else {
					dq.closeOpenCursors();
				}
			}
		}
	}
	
	private String autoUpdateEmployer(String employerName,DBTransaction tran){
		String employerId="";
		IMasterDAO _masterDao = new MasterDAO();
		String[] employerNames={employerName};
		try{
			List<EmployersData> listEmpData =_masterDao.getEmployersIds(employerNames);			
			List<EmployerAliasesData> listEmpAlData =_masterDao.getEmployerAliasesIds(employerNames);
			if(!listEmpData.isEmpty()){
				for(EmployersData empData:listEmpData){
					employerId=""+empData.getEmployerId();
				}
			}else if(!listEmpAlData.isEmpty()){	
				for(EmployerAliasesData empAlData:listEmpAlData){
					employerId=""+empAlData.getId().getEmployerId();
				}
			}else{
				EmployersData empData = new EmployersData();
				empData.setEmployerName(employerName);
				employerId = ""+_masterDao.saveEmployer(empData);
								
			}
		}catch (Exception e) {
			TPLogger.getLogger().error(GlobalConstants.ERROR, e);
		}
		return employerId;
	}
	
	private String autoUpdateDesignation(String designationName,DBTransaction tran){		
		String designationId="";
		IMasterDAO _masterDao = new MasterDAO();
		String[] designationNames={designationName};
		try{
			List<DesignationsData> listDesignationData = _masterDao.getDesignationsIds(designationNames);
			List<DesignationAliasesData> listDesignationAlData = _masterDao.getDesignationAliasesIds(designationNames);
			if(!listDesignationData.isEmpty()){
				for(DesignationsData dData:listDesignationData){
					designationId=""+dData.getDesignationId();
				}
			}else if(!listDesignationAlData.isEmpty()){
				for(DesignationAliasesData dAlData:listDesignationAlData){
					designationId=""+dAlData.getId().getDesignationId();
				}
			}else{				
				DesignationsData designationData = new DesignationsData();
				designationData.setDesignationName(designationName);
				designationId=""+_masterDao.saveDesignation(designationData);
			}
		}catch (Exception e) {
			TPLogger.getLogger().error(GlobalConstants.ERROR, e);
		}
		return designationId;
	}
	
	public ArrayList<EmploymentHistoryData> getEmploymentHistoryInfo(String applicantId) {
		DBPreparedQuery dq = null;
		ArrayList<EmploymentHistoryData> employmentHistoryInfo = null;
		try {
			dq = new DBPreparedQuery("dEmploymentHistory_getEmploymentHistory");
			dq.setId(1, applicantId);
			employmentHistoryInfo = dq.getResult();
		} catch (Exception e) {
			TPLogger.getLogger().error(GlobalConstants.ERROR, e);
		} finally {
			if (dq != null) {
				dq.releaseConnection();
			}
		}
		return employmentHistoryInfo;
	}
	
	public String getExtractedEmploymentHistoryXml(EmploymentHistoryData empHisData, String level) {
		StringWriter sWr = new StringWriter();
		try {
			XMLWriter wr = new XMLWriter(sWr);
			wr.startDocument();
			wr.startElement("EmploymentHistory");

			wr.startElement("level");
			wr.characters("" + level);
			wr.endElement("level");
			
			Date employerFromDate = empHisData.getEmployerFromDate();
			String empHistFromDate = "";
			if (employerFromDate != null) {
				empHistFromDate = Utils.getDateConvertedToString(employerFromDate, Utils.regDDMMMYYYYFormat);
			}
			wr.startElement("empHistFromDate");
			wr.characters(empHistFromDate);
			wr.endElement("empHistFromDate");
			
			Date employerToDate = empHisData.getEmployerToDate();
			String empHistToDate = "";
			if (employerToDate != null) {
				empHistToDate = Utils.getDateConvertedToString(employerToDate, Utils.regDDMMMYYYYFormat);
			}
			wr.startElement("empHistToDate");
			wr.characters(empHistToDate);
			wr.endElement("empHistToDate");
			
			wr.startElement("employerName");
			wr.characters((Utils.isBlankOrNull(empHisData.getEmployerName())) ? "" : empHisData.getEmployerName());
			wr.endElement("employerName");
			
			wr.startElement("designationName");
			wr.characters((Utils.isBlankOrNull(empHisData.getDesignationName())) ? "" : empHisData.getDesignationName());
			wr.endElement("designationName");
			
			wr.endElement("EmploymentHistory");
			wr.endDocument();
		} catch (SAXException e) {
			TPLogger.getLogger().error("Error while getting xml from list", e);
		}
		return sWr.getBuffer().toString();
	}
	
	/**
	 * applicant upload scheduler by Sumeet
	 * :TODO handlign for user type applicants
	 */
	private void uploadApplicantDetailIntoGraphScheduler(String applicantId){
		SchedulerFactory factory = new StdSchedulerFactory();
		Scheduler scheduler;
		try {
			scheduler = factory.getScheduler();
		
		JobDetail jobDetail = new JobDetail();
		jobDetail.setName("Upload Applicant Job");
		jobDetail.setJobClass(ApplicantNodeUploadJob.class);
		jobDetail.getJobDataMap().put("applicantId", applicantId);
		
		SimpleTrigger simpleTrigger = new SimpleTrigger();
		simpleTrigger.setStartTime(new Date(System.currentTimeMillis() + 3000));
		simpleTrigger.setName("Uploading Trigger");
		
		scheduler.start();
		scheduler.scheduleJob(jobDetail, simpleTrigger);
		} catch (SchedulerException e) {
			TPLogger.getLogger().error("Error uploading Applicant into Graph Database",e);
		}
	}
	
	/**
	 * @param applicantId
	 * @param uuid
	 * @param tran
	 */
	private void addApplicantToken(String applicantId, String uuid, DBTransaction tran) {
		DBPreparedQuery dq = null;
		try {
			dq = new DBPreparedQuery("dApplicantManager_insertApplicantToken", tran);
			dq.setString(1, applicantId);
			dq.setString(2, uuid);
			dq.execute();
		} catch (Exception e) {
			TPLogger.getLogger().error(GlobalConstants.ERROR, e);
		} finally {
			if (dq != null) {
				if (tran == null) {
					dq.releaseConnection();
				} else {
					dq.closeOpenCursors();
				}
			}
		}
	}
	
