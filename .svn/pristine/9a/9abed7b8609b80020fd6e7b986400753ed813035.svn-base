	public String getCandidateInterviewFeedback(String applicantId, String positionId, String stepId) {		
		StringBuffer feedback = new StringBuffer();
		DBPreparedQuery dq = null;
		try {
			dq = new DBPreparedQuery("dApplicantManager_GetCandidateLastStepFeedback");
			dq.setString(1, applicantId);
			dq.setString(2, stepId);
			dq.setString(3, positionId);
			dq.setString(4, applicantId);
			List<SimpleDataObject> rs = dq.getResult();
			if(rs != null && rs.size() > 0) {
				for(int i = 0; i < rs.size(); i++) {
					SimpleDataObject obj = rs.get(i);
					if(feedback.length() > 0) {
						feedback.append("<br/>");
					}
					feedback.append(obj.getString("userName"));
					feedback.append("<br/>");
					feedback.append(obj.getString("feedback"));					
				}
			}
		} catch (SQLException e) {
			TPLogger.getLogger().error(GlobalConstants.ERROR, e);
		} finally {
			if(dq != null) {
				dq.releaseConnection();
			}
		}
		return feedback.toString();
	}
	

	public void changeConfidentiality(String applicantId, String confidentiality) {
		DBPreparedQuery dq = null;
		try {
			dq = new DBPreparedQuery("dApplicantManager_ChangeConfidentiality");
			dq.setString(1, confidentiality);
			dq.setString(2, applicantId);
			dq.execute();
		} catch (Exception e) {
			TPLogger.getLogger().error(GlobalConstants.ERROR, e);
		} finally {
