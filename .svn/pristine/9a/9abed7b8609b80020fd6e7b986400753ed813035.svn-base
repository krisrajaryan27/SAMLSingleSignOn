	public MessageData getMessageDataForBrowserImportSession(ApplicantData aData, List<SimpleDataObject> documents) throws Exception {
		MessageData messageData = new MessageData();
		
		messageData.setTo("");
		messageData.setCc("");
		messageData.setFrom("");
		messageData.setFromAddress("");
		messageData.setTextBody(aData.getApplicantTextResume());
		if(documents != null && documents.size() > 0) {
			FileHandler fileHandler = new FileHandler();
			String filePath = Utils.concatFilePath(DocumentConstants.documentsPath, documents.get(0).getString("documentPath"));
			String htmlBody = fileHandler.getTextFileContent(filePath, null);
					if(htmlBody.contains("dice"))	{
						
					}
					else{
			ApplicantUtils applicantUtils = new ApplicantUtils();
			htmlBody = applicantUtils.getImagePathReplaced(htmlBody, documents.get(0).getString("documentPath"));
			// inserted for firefox plugin
			htmlBody = applicantUtils.getJsPathReplaced(htmlBody, documents.get(0).getString("documentPath"), "script", "src"); // for JS
			htmlBody = applicantUtils.getJsPathReplaced(htmlBody, documents.get(0).getString("documentPath"), "link", "href"); // for CSS
					}
			messageData.setHtmlBody(htmlBody);
		} else {
			messageData.setHtmlBody("");
		}
		
		messageData.setSubject(aData.getApplicantName());						
		messageData.setReceivedDate(Utils.convertDateToSQLDate(new Date()));
		messageData.setApplicantId(aData.getApplicantId());
		
		if(documents != null && documents.size() > 1) {
			AttachmentData attachmentData = new AttachmentData();
			attachmentData.setAttachmentFilePath(documents.get(1).getString("documentPath"));
			attachmentData.setOriginalFileName(documents.get(1).getString("fileName"));
			attachmentData.setContentType("");
			attachmentData.setContentId("");
			attachmentData.setAttachmentType(InboxConstants.ATTACHMENT_TYPE_NOTRELATED);
			
			File file = new File(Utils.concatFilePath(DocumentConstants.documentsPath, documents.get(1).getString("documentPath")));
			attachmentData.setAttachmentSize(file.getTotalSpace());
			
			ArrayList<AttachmentData> attachments = new ArrayList<AttachmentData>();
			attachments.add(attachmentData);
			messageData.setAttachments(attachments);
		}
		
		return messageData;
	}
	
