	public void addNote(String applicantId, String userId, String note) {
		try {
			Calendar cal = new GregorianCalendar();
			Date dtLogDate = cal.getTime();
			CommunicationData cData = new CommunicationData();
			cData.setApplicantId(applicantId);
			cData.setUserId(userId);
			cData.setCommunicationType(SelectionProcessConstants.INTERACTION_NOTE);
			cData.setCommunicationDate(new java.sql.Timestamp(dtLogDate.getTime()));			
			cData.setCommunicationText(note);
			SelectionProcessManager communicationManager = new SelectionProcessManager();
			communicationManager.addPhoneLog(cData);		
			
		} catch (Exception e) {
			TPLogger.getLogger().error(GlobalConstants.ERROR, e);
		}
	}
	
	public void addOriginalResumeToDocument(String applicantId, String applicantOriginalDocPath, String userId) throws Exception {
		DBPreparedQuery dq = null;
		try {
