	/**
	 * returns xml required for autocomplete
	 * 
	 * @param search
	 * @param searchType
	 * @return
	 */
	public String getAutoCompleteXML(String search, String searchType) {
		DBPreparedQuery dq = null;
		String xml = "";
		String dynaQuery = "";
		String dqName = "";
		String fieldToFetch = "";
		IMasterDAO _masterDAO = new MasterDAO();
		ArrayList<SimpleDataObject> result = new ArrayList<SimpleDataObject>();
		try {
			if (searchType.equals(ApplicantConstants.AUTOCOMPLETE_BRANCH)) {
				dynaQuery = "branch_name like ? ";
				dqName = "dGetBranchNames";
				fieldToFetch = "branchName";
			} else if (searchType.equals(ApplicantConstants.AUTOCOMPLETE_CURRENT_LOCATION)) {
				dynaQuery = "city_name like ? ";
				dqName = "dGetCitiesNames";
				fieldToFetch = "cityName";
			} else if (searchType.equals(ApplicantConstants.AUTOCOMPLETE_EMPLOYER)) {
				dynaQuery = "applicant_current_employer like ? ";
				dqName = "dGetEmployerNames";
				fieldToFetch = "currentEmployer";
			} else if (searchType.equals(ApplicantConstants.AUTOCOMPLETE_INSTITUTE)) {
				dynaQuery = "institute_name like ? ";
				dqName = "dGetInstituteNames";
				fieldToFetch = "instituteName";
			} else if(searchType.equals(ApplicantConstants.AUTOCOMPLETE_EMPLOYMENT_EMPLOYER)){
				List<EmployersData> likes = _masterDAO.getLikeEmployers(search);
				fieldToFetch ="employerName";				
				for(EmployersData empdt:likes){
					SimpleDataObject sdo = new SimpleDataObject();
					sdo.setAttribute(fieldToFetch, empdt.getEmployerName());
					result.add(sdo);
				}
				xml = Utils.getListInXML(result, fieldToFetch);
				return xml;
			} else if(searchType.equals(ApplicantConstants.AUTOCOMPLETE_EMPLOYMENT_DESIGNATION)){				
				List<DesignationsData> likes= _masterDAO.getDesignations();
				fieldToFetch ="designationName";
				for(DesignationsData dsgnDat:likes){
					SimpleDataObject sdo = new SimpleDataObject();
					sdo.setAttribute(fieldToFetch, dsgnDat.getDesignationName());
					result.add(sdo);
				}
				xml = Utils.getListInXML(result, fieldToFetch);
				return xml;
			}

			// execute query and build xml
			String[] dynParam = new String[2];
			dynParam[0] = dynaQuery;
			int noOfRecords = 10;
			dynParam[1] = " LIMIT ?, ?";
			if (searchType.equals(ApplicantConstants.AUTOCOMPLETE_EMPLOYER)) {
				noOfRecords = 5;
			}
			
			dq = new DBPreparedQuery(dqName, dynParam);
			int cnt = 1;
			dq.setString(cnt++, search + "%");
			dq.setInt(cnt++, 0);
			dq.setInt(cnt++, noOfRecords);
			result = dq.getResult();
			xml = Utils.getListInXML(result, fieldToFetch);
		} catch (Exception e) {
			TPLogger.getLogger().error(GlobalConstants.ERROR, e);
		} finally {
			if (dq != null) {
				dq.releaseConnection();
			}
		}
		return xml;
	}

	public String getAutoCompleteXMLForSource(String source, String sourceTypeId) {
		DBPreparedQuery dq = null;
		String xml = "";
		try {

			String[] dynParam = new String[2];
			dynParam[0] = " source_title like ? ";

			if (!Utils.isBlankOrNull(sourceTypeId)) {
				dynParam[0] += " AND source_type_id=? ";
			}

			int noOfRecords = 10;
			dynParam[1] = " LIMIT ?, ?";

			dq = new DBPreparedQuery("dGetSourceNames", dynParam);
			int cnt = 1;
			dq.setString(cnt++, source + "%");
			if (!Utils.isBlankOrNull(sourceTypeId)) {
				dq.setId(cnt++, sourceTypeId);
			}
			dq.setInt(cnt++, 0);
			dq.setInt(cnt++, noOfRecords);
			ArrayList result = dq.getResult();
			xml = Utils.getListInXML(result, "sourceTitle");
		} catch (Exception e) {
			TPLogger.getLogger().error(GlobalConstants.ERROR, e);
		} finally {
			if (dq != null) {
				dq.releaseConnection();
			}
		}
		return xml;
	}

