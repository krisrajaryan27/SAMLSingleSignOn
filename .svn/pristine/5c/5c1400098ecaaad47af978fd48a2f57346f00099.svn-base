		return getInt("gradeId");
	}
	
	public void setGradeId(int gradeId) {
		setAttribute("gradeId", gradeId);
	}
	
	public String getGradeName() {
		return getString("gradeName");
	}
	
	public int getSalaryComponentId() {
		return getInt("salaryComponentId");
	}
	
	public void setSalaryComponentId(int salaryComponentId) {
		setAttribute("salaryComponentId", salaryComponentId);
	}
	
	public String getSalaryComponentName() {
		return getString("salaryComponentName");
	}
	
	public String getSalaryComponentType() {
		return getString("salaryComponentType");
	}
	
	public void setSalaryComponentType(String salaryComponentType) {
		setAttribute("salaryComponentType", salaryComponentType);
	}
	
	public int getMaxLimit() {
		return getInt("maxLimit");
	}
	
	public void setMaxLimit(int maxLimit) {
		setAttribute("maxLimit", maxLimit);
	}
	
	public int getVariable1() {
		return getInt("variable1");
	}
	
