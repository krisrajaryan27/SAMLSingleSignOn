package com.talentPool.websiteservice.dataobject;

import java.sql.Date;

import com.talentPool.common.utils.Utils;

/**
 * @author shivprasad
 *
 */
public class WcustomFieldData {
	private String fieldName;
	private String fieldDisplayName;
	private int fieldRequired;
	private String[] fieldValues;
	private String[] toValues;
	private String fieldAttributes;
	private int fieldEntityType;
	private String fieldOtherAttributes;
	private String fieldId;
	private int fieldInputAllowed;
	private String fieldOptions;
	private int fieldRank;
	private int fieldSearchable;
	private String fieldType;
	private String fieldDefaultValue;
	private String fieldStringValue;
	private double fieldNumberValue;
	private Date fieldDateValue;
	/**
	 * @return the fieldAttributes
	 */
	public String getFieldAttributes() {
		return fieldAttributes;
	}
	/**
	 * @param fieldAttributes the fieldAttributes to set
	 */
	public void setFieldAttributes(String fieldAttributes) {
		this.fieldAttributes = fieldAttributes;
	}
	/**
	 * @return the fieldDefaultValue
	 */
	public String getFieldDefaultValue() {
		return fieldDefaultValue;
	}
	/**
	 * @param fieldDefaultValue the fieldDefaultValue to set
	 */
	public void setFieldDefaultValue(String fieldDefaultValue) {
		this.fieldDefaultValue = fieldDefaultValue;
	}
	/**
	 * @return the fieldDisplayName
	 */
	public String getFieldDisplayName() {
		return fieldDisplayName;
	}
	/**
	 * @param fieldDisplayName the fieldDisplayName to set
	 */
	public void setFieldDisplayName(String fieldDisplayName) {
		this.fieldDisplayName = fieldDisplayName;
	}
	/**
	 * @return the fieldEntityType
	 */
	public int getFieldEntityType() {
		return fieldEntityType;
	}
	/**
	 * @param fieldEntityType the fieldEntityType to set
	 */
	public void setFieldEntityType(int fieldEntityType) {
		this.fieldEntityType = fieldEntityType;
	}
	/**
	 * @return the fieldId
	 */
	public String getFieldId() {
		return fieldId;
	}
	/**
	 * @param fieldId the fieldId to set
	 */
	public void setFieldId(String fieldId) {
		this.fieldId = fieldId;
	}
	/**
	 * @return the fieldInputAllowed
	 */
	public int getFieldInputAllowed() {
		return fieldInputAllowed;
	}
	/**
	 * @param fieldInputAllowed the fieldInputAllowed to set
	 */
	public void setFieldInputAllowed(int fieldInputAllowed) {
		this.fieldInputAllowed = fieldInputAllowed;
	}
	/**
	 * @return the fieldName
	 */
	public String getFieldName() {
		return fieldName;
	}
	/**
	 * @param fieldName the fieldName to set
	 */
	public void setFieldName(String fieldName) {
		this.fieldName = fieldName;
	}
	/**
	 * @return the fieldOptions
	 */
	public String getFieldOptions() {
		return fieldOptions;
	}
	/**
	 * @param fieldOptions the fieldOptions to set
	 */
	public void setFieldOptions(String fieldOptions) {
		this.fieldOptions = fieldOptions;
	}
	/**
	 * @return the fieldOtherAttributes
	 */
	public String getFieldOtherAttributes() {
		return fieldOtherAttributes;
	}
	/**
	 * @param fieldOtherAttributes the fieldOtherAttributes to set
	 */
	public void setFieldOtherAttributes(String fieldOtherAttributes) {
		this.fieldOtherAttributes = fieldOtherAttributes;
	}
	/**
	 * @return the fieldRank
	 */
	public int getFieldRank() {
		return fieldRank;
	}
	/**
	 * @param fieldRank the fieldRank to set
	 */
	public void setFieldRank(int fieldRank) {
		this.fieldRank = fieldRank;
	}
	/**
	 * @return the fieldRequired
	 */
	public int getFieldRequired() {
		return fieldRequired;
	}
	/**
	 * @param fieldRequired the fieldRequired to set
	 */
	public void setFieldRequired(int fieldRequired) {
		this.fieldRequired = fieldRequired;
	}
	/**
	 * @return the fieldSearchable
	 */
	public int getFieldSearchable() {
		return fieldSearchable;
	}
	/**
	 * @param fieldSearchable the fieldSearchable to set
	 */
	public void setFieldSearchable(int fieldSearchable) {
		this.fieldSearchable = fieldSearchable;
	}
	/**
	 * @return the fieldType
	 */
	public String getFieldType() {
		return fieldType;
	}
	/**
	 * @param fieldType the fieldType to set
	 */
	public void setFieldType(String fieldType) {
		this.fieldType = fieldType;
	}


	public String getFieldStringValue() {
		return fieldStringValue;
	}

	public void setFieldStringValue(String fieldStringValue) {
		this.fieldStringValue = fieldStringValue;
	}
	
	public double getFieldNumberValue() {
		return fieldNumberValue;
	}

	public void setFieldNumberValue(double fieldNumberValue) {
		this.fieldNumberValue = fieldNumberValue;
	}

	public Date getFieldDateValue() {
		return fieldDateValue;
	}

	public void setFieldDateValue(Date fieldDateValue) {
		this.fieldDateValue = fieldDateValue;
	}
	/**
	 * @return the fieldValues
	 */
	public String[] getFieldValues() {
		return fieldValues;
	}
	/**
	 * @param fieldValues the fieldValues to set
	 */
	public void setFieldValues(String[] fieldValues) {
		this.fieldValues = Utils.getArrayCopy(fieldValues);
	}
	/**
	 * @return the toValues
	 */
	public String[] getToValues() {
		return toValues;
	}
	/**
	 * @param toValues the toValues to set
	 */
	public void setToValues(String[] toValues) {
		this.toValues = Utils.getArrayCopy(toValues);
	}
}
