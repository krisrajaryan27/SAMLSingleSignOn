package com.talentPool.masters.dataobject;

import com.talentPool.common.db.SimpleDataObject;

public class ReportTemplateData  extends SimpleDataObject {
	
	/**
	 * @return the reportTemplateType
	 */
	public String getReportId() {
		return getString("reportId");
	}
	/**
	 * @param reportTemplateType the reportTemplateType to set
	 */
	public void setReportId(String reportId) {
		setAttribute("reportId", reportId);
	}
	
	/**
	 * @return the templateName
	 */
	public String getTemplateName() {
		return getString("templateName");
	}
	/**
	 * @param reportName the reportName to set
	 */
	public void setTemplateName(String templateName) {
		setAttribute("templateName", templateName);
	}
	
	
	public String getRowIndex() {
		return getString("rowIndex");
	}
	
	public void setRowIndex(String rowIndex) {
		setAttribute("rowIndex", rowIndex);
	}
	
	public String getSheetIndex() {
		return getString("sheetIndex");
	}
	public void setSheetIndex(String sheetIndex) {
		setAttribute("sheetIndex", sheetIndex);
	}
	
	public String getReportFilePath() {
		return getString("reportFilePath");
	}
	public void setReportFilePath(String reportFilePath) {
		setAttribute("reportFilePath", reportFilePath);
	}
	
	public String getReportTemplateId() {
		return getString("reportTemplateId");
	}
	public void setReportTemplateId(String reportTemplateId) {
		setAttribute("reportTemplateId", reportTemplateId);
	}
	
	public String getTemplateColumns() {
		return getString("templateColumns");
	}
	public void setTemplateColumns(String templateColumns) {
		setAttribute("templateColumns", templateColumns);
	}
	
	public String getUserId() {
		return getString("userId");
	}
	public void setUserId(String userId) {
		setAttribute("userId", userId);
	}
	
	public String getOriginalFileName() {
		return getString("originalFileName");
	}
	public void setOriginalFileName(String originalFileName) {
		setAttribute("originalFileName", originalFileName);
	}
	
}
