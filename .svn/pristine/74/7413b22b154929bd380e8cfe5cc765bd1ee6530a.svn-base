package com.talentPool.websiteservice.dataobject;


/**
 * @author praveen
 *
 */
public class WebsiteSettingsData {
	private String filtersAvailable;
	private String filtersHeaderText;
	/**
	 * @return the filtersAvailable
	 */
	public String getFiltersAvailable() {
		return filtersAvailable;
	}
	/**
	 * @param filtersAvailable the filtersAvailable to set
	 */
	public void setFiltersAvailable(String filtersAvailable) {
		this.filtersAvailable = filtersAvailable;
	}
	/**
	 * @return the filtersHeaderText
	 */
	public String getFiltersHeaderText() {
		return filtersHeaderText;
	}
	/**
	 * @param filtersHeaderText the filtersHeaderText to set
	 */
	public void setFiltersHeaderText(String filtersHeaderText) {
		this.filtersHeaderText = filtersHeaderText;
	}

}
