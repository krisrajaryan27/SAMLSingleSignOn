		return mapping.findForward(forward);
	}
	
	public ActionForward saveThisSearch(ActionMapping mapping, ActionForm actionForm, HttpServletRequest request, HttpServletResponse response) {
		if (!SessionManager.validateSession(mapping, actionForm, request, response, this)) {
			return null;
		}
		String forward = "closeModalCall";
		try {
			SearchForm searchForm = (SearchForm) actionForm;
			request.setAttribute("t", NavigationConstants.T_SEARCH);
			String userId = (String) request.getSession(false).getAttribute("userId");
			String searchName = searchForm.getSearchName();
			String shared = searchForm.getShared();			
			SearchCriteriaData cData = (SearchCriteriaData) request.getSession().getAttribute("searchCriteria");

			if (CustomFieldManager.isCustomFieldsAvailable(CustomFieldConstants.ENTITY_TYPE_APPLICANT) && cData.getCustomFields() == null) {
				CustomFieldManager customFieldManager = new CustomFieldManager();
				ArrayList<CustomFieldData> customFields = customFieldManager.getCustomFieldsForSearch(CustomFieldConstants.ENTITY_TYPE_APPLICANT);
				CustomFieldDataProcessor customFieldDataProcessor = new CustomFieldDataProcessor();
				customFields = customFieldDataProcessor.setCustomFieldValuesFromRequestForSearch(request, customFields);
				cData.setCustomFields(customFields);
			}

			SavedSearchManager savedSearchManager = new SavedSearchManager();
			//using same table of saved searches thus a new constant(Flag) while saving the data
			savedSearchManager.saveSearch(searchName, shared, userId, cData, SearchConstants.SEARCH_ID_SAVED_SEARCHES);

		} catch (Exception e) {
			TPLogger.getLogger().error(GlobalConstants.ERROR, e);
		}
		return mapping.findForward(forward);
	}
	
	public ActionForward showSavedSearches(ActionMapping mapping, ActionForm actionForm, HttpServletRequest request, HttpServletResponse response) {
		if (!SessionManager.validateSession(mapping, actionForm, request, response, this)) {
			return null;
		}
		String forward = "showSavedSearches";
		SearchForm searchForm = (SearchForm) actionForm;
		try {
			
			String userId = (String) request.getSession(false).getAttribute("userId");
			SavedSearchManager savedSearchManager = new SavedSearchManager();
			ArrayList<SavedSearchData> savedSearchList = savedSearchManager.getAllSavedSearches(userId,SearchConstants.SEARCH_ID_SAVED_SEARCHES,searchForm.getShowShared());
			request.setAttribute("savedSearchList", savedSearchList);
		} catch (Exception e) {
			TPLogger.getLogger().error(GlobalConstants.ERROR, e);
		}
		return mapping.findForward(forward);
	}
	
	public ActionForward doSavedSearch(ActionMapping mapping, ActionForm actionForm, HttpServletRequest request, HttpServletResponse response) {
		if (!SessionManager.validateSession(mapping, actionForm, request, response, this)) {
			return null;
		}
		SearchForm searchForm = (SearchForm) actionForm;
		try {
			String searchId = searchForm.getSearchId();
			SavedSearchManager savedSearchManager = new SavedSearchManager();
			SearchCriteriaData cData = savedSearchManager.getSavedSearchCriteriaData(searchId);
			searchForm.setSearchCriteriaData(cData);
			searchForm.populateSearchForm(cData);
			searchForm.setPageNo("1");

		} catch (Exception e) {
			TPLogger.getLogger().error("Error while searching", e);
		}
		return doSearch(mapping, actionForm, request, response);
	}
	
	public ActionForward deleteSavedSearch(ActionMapping mapping, ActionForm actionForm, HttpServletRequest request, HttpServletResponse response) {
		if (!SessionManager.validateSession(mapping, actionForm, request, response, this)) {
			return null;
		}
		String forward = "xmlFile";
		String xmlFile = "";
		try {
			SearchForm searchForm = (SearchForm) actionForm;
			String searchId = searchForm.getSearchId();
			SavedSearchManager savedSearchManager = new SavedSearchManager();
			savedSearchManager.deleteSavedSearch(searchId);
			xmlFile = Utils.getXMLForIds(searchId);
		} catch (Exception e) {
			TPLogger.getLogger().error(GlobalConstants.ERROR, e);
		}
		request.setAttribute("xmlFile", xmlFile);
		return mapping.findForward(forward);
	}
	
	public ActionForward getAutoCompleteList(ActionMapping mapping, ActionForm actionForm, HttpServletRequest request, HttpServletResponse response) {
		String forward = "xmlFile";
		
		try {
			SearchForm searchForm = (SearchForm) actionForm;
			String xmlFile = "";
			String searchText = searchForm.getSearchText();
			SearchManager searchManager = new SearchManager();
			ArrayList<SimpleDataObject> result =  null;
			if (!Utils.isBlankOrNull(searchText)){
				try{
					Long.parseLong(searchText);
					result = searchManager.getApplicantNumbers(searchText);
					xmlFile = Utils.getListInXML(result, "applicantNumber");
				} catch (NumberFormatException nfe){
					result = searchManager.getApplicantNames(searchText);
					xmlFile = Utils.getListInXML(result, "applicantName");
				}
			}
			request.setAttribute("xmlFile", xmlFile);
		} catch (Exception e) {
			TPLogger.getLogger().error(GlobalConstants.ERROR, e);
		}
		return mapping.findForward(forward);
	}
}
