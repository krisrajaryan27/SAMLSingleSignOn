package com.talentPool.custom.dataobject;

import com.talentPool.common.db.SimpleDataObject;

/**
 * @author sachin
 *
 */
@SuppressWarnings("serial")
public class CRColumnCustomFieldMapData extends SimpleDataObject{
	public String getColumnProperty(){
		return getString("columnProperty");
	}
	
	public void setColumnProperty(String columnProperty){
		setAttribute("columnProperty", columnProperty);
	}
	
	public String getColumnDisplayName(){
		return getString("columnDisplayName");
	}
	
	public void setColumnDisplayName(String columnDisplayName){
		setAttribute("columnDisplayName", columnDisplayName);
	}
	
	public String getCustomFieldId(){
		return getString("customFieldId");
	}
	
	public void setCustomFieldId(String customFieldId){
		setAttribute("customFieldId", customFieldId);
	}
	
	public String getEntityType(){
		return getString("entityType");
	}
	
	public void setEntityType(String entityType){
		setAttribute("entityType", entityType);
	}
	
	public String getCustomFieldDisplayName(){
		return getString("customFieldDisplayName");
	}
	
	public void setCustomFieldDisplayName(String customFieldDisplayName){
		setAttribute("customFieldDisplayName", customFieldDisplayName);
	}
	
	public String getCustomFieldType(){
		return getString("customFieldType");
	}
	
	public void setCustomFieldType(String customFieldType){
		setAttribute("customFieldType", customFieldType);
	}
	
}
