.noprint {
	display:none;
}

.prntOnly
{
    display: block;
}
.printTable{ }

.printTable TD{
	font-weigth:normal;
	font-size:12px;
	color: #000000;
	line-height:170%;
	font-family: verdana,arial,helvetica,sans-serif;
}

.printDataTable{
	border:1px outset #000000; 
	border-collapse: collapse;
}
.printDataTable TD{
	padding:4px; 
	border:1px outset #000000; 
	border-collapse: separate; 
	border-spacing: 0px;
	text-align:left;
	margin:0;
	font-weigth:normal;
	font-size:11px;
	color: #000000;
	line-height:170%;
	font-family: verdana,arial,helvetica,sans-serif;
}

.MSGBODY
{
    BORDER-RIGHT: 0px;
    BORDER-TOP: 0px;
    MARGIN-TOP: 1em;
    OVERFLOW: visible;
    BORDER-LEFT: 0px;
    WIDTH: 100%;
    BORDER-BOTTOM: 0px;
    HEIGHT: auto
}

.vpTop{
	border-width:0px;
	background-color: #ffffff;
	border-bottom: 2px solid #000;
}
.popupTop{
	border-width:0px;
	background-color: #ffffff;
	border-bottom: 1px solid #000;
}
.popupBody{
	border-width:0px;
	background-color: #ffffff;
}
.contentDivPop{
	margin:0px;
}
.outerDiv{
	border-width:0px;
}
.Grey{
	color:#000;
}
.tblPop TD.header{
	color:#000;
}

