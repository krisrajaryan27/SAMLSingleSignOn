 SELECT trpm.position_title AS P02, tsl.step_level_name AS S11, trsm.step_name AS S09, tres.received AS S13, tres.cleared AS S14, tres.rejected AS S16, tsl.step_level AS S11_ORDER_BY, trsm.step_rank AS S09_ORDER_BY FROM tp_cr_position_hiring_summary AS tres JOIN tp_step_level AS tsl ON (tres.step_level = tsl.step_level)  JOIN tp_step_master AS trsm ON (tres.step_id = trsm.step_id)  JOIN tp_cr_position_master AS trpm ON (tres.position_id = trpm.position_id)  WHERE 1 @@  ORDER BY trpm.position_title, tsl.step_level, trsm.step_rank