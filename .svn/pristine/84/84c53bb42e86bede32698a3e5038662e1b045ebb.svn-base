package com.talentPool.common.exception;

/**
 * @author shivprasad
 *
 * This Exception is thrown when record is associated with one or
 * more records as foreign key and can not be deleted
 */
public class DeleteException extends Exception{
	/** Creates a new instance of InvalidLoginException */
	public DeleteException() {
	}

	public DeleteException(String msg) {
		super(msg);
	}
}
