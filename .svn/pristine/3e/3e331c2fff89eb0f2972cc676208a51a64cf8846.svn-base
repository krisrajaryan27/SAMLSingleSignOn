package com.talentPool.masters.dataobject;

import com.talentPool.common.db.SimpleDataObject;

/**
 * @author shivprasad
 * 
 */
public class AliasData extends SimpleDataObject {
	public AliasData() {
	}
	public AliasData(String aliasId, String alias) {
		setAttribute("aliasId", aliasId);
		setAttribute("alias", alias);
	}

	public String getAliasId() {
		return getId("aliasId");
	}

	public void setAliasId(String aliasId) {
		setAttribute("aliasId", aliasId);
	}

	public String getAlias() {
		return getId("alias");
	}

	public void setAlias(String alias) {
		setAttribute("alias", alias);
	}

}