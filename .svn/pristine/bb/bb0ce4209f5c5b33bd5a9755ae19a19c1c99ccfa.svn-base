package com.talentPool.customReports.dataobject;

import java.io.Serializable;
import java.sql.Timestamp;

public class CustomReportDetails implements Serializable{

	private Long reportId;
	private String reportName;
	private String reportDesc;
	private String createdBy;
	private Timestamp dateCreated;
	private String modifiedBy;
	private Timestamp dateModified;
	private String xmlFilePath;
	private String templateFilePath;
	private String queryFilePath;
	private String reportTypeId;
	private String inactivePositionsQueryFilePath;
	/**
	 * @return the reportName
	 */
	public String getReportName() {
		return reportName;
	}
	/**
	 * @param reportName the reportName to set
	 */
	public void setReportName(String reportName) {
		this.reportName = reportName;
	}
	/**
	 * @return the reportDesc
	 */
	public String getReportDesc() {
		return reportDesc;
	}
	/**
	 * @param reportDesc the reportDesc to set
	 */
	public void setReportDesc(String reportDesc) {
		this.reportDesc = reportDesc;
	}
	/**
	 * @return the createdBy
	 */
	public String getCreatedBy() {
		return createdBy;
	}
	/**
	 * @param createdBy the createdBy to set
	 */
	public void setCreatedBy(String createdBy) {
		this.createdBy = createdBy;
	}
	
	/**
	 * @return the modifiedBy
	 */
	public String getModifiedBy() {
		return modifiedBy;
	}
	/**
	 * @param modifiedBy the modifiedBy to set
	 */
	public void setModifiedBy(String modifiedBy) {
		this.modifiedBy = modifiedBy;
	}
	
	/**
	 * @return the reportFilePath
	 */
	public String getXmlFilePath() {
		return xmlFilePath;
	}
	/**
	 * @param reportFilePath the reportFilePath to set
	 */
	public void setXmlFilePath(String reportFilePath) {
		this.xmlFilePath = reportFilePath;
	}
	/**
	 * @return the dateCreated
	 */
	public Timestamp getDateCreated() {
		return dateCreated;
	}
	/**
	 * @param dateCreated the dateCreated to set
	 */
	public void setDateCreated(Timestamp dateCreated) {
		this.dateCreated = dateCreated;
	}
	/**
	 * @return the dateModified
	 */
	public Timestamp getDateModified() {
		return dateModified;
	}
	/**
	 * @param dateModified the dateModified to set
	 */
	public void setDateModified(Timestamp dateModified) {
		this.dateModified = dateModified;
	}
	
	/**
	 * @return the reportId
	 */
	public Long getReportId() {
		return reportId;
	}
	/**
	 * @param reportId the reportId to set
	 */
	public void setReportId(Long reportId) {
		this.reportId = reportId;
	}
	/**
	 * @return the templateFilePath
	 */
	public String getTemplateFilePath() {
		return templateFilePath;
	}
	/**
	 * @param templateFilePath the templateFilePath to set
	 */
	public void setTemplateFilePath(String templateFilePath) {
		this.templateFilePath = templateFilePath;
	}
	/**
	 * @return the queryFilePath
	 */
	public String getQueryFilePath() {
		return queryFilePath;
	}
	/**
	 * @param queryFilePath the queryFilePath to set
	 */
	public void setQueryFilePath(String queryFilePath) {
		this.queryFilePath = queryFilePath;
	}
	/**
	 * @return the reportTypeId
	 */
	public String getReportTypeId() {
		return reportTypeId;
	}
	/**
	 * @param reportTypeId the reportTypeId to set
	 */
	public void setReportTypeId(String reportTypeId) {
		this.reportTypeId = reportTypeId;
	}
	/**
	 * @return the inactivePositionsQueryFilePath
	 */
	public String getInactivePositionsQueryFilePath() {
		return inactivePositionsQueryFilePath;
	}
	/**
	 * @param inactivePositionsQueryFilePath the inactivePositionsQueryFilePath to set
	 */
	public void setInactivePositionsQueryFilePath(
			String inactivePositionsQueryFilePath) {
		this.inactivePositionsQueryFilePath = inactivePositionsQueryFilePath;
	}
	
	
}
