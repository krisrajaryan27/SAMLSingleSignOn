<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN"
"http://www.w3.org/TR/html4/loose.dtd">
<html>
<head>
<title>Untitled Document</title>
<meta http-equiv="Content-Type" content="text/html; charset=iso-8859-1">
<script type="text/javascript" src="prototype.js"></script>
<script type="text/javascript" src="checkboxradiogroup.js"></script>
<script type="text/javascript" src="../selectoption.js"></script>


<style>
body,input, div,a{
font-family:Verdana, Arial, Helvetica, sans-serif;
font-size:10px;
}

.checkboxradiogroupdiv{
	overflow:visible;
	border:1px solid #9EAC64;

}
.checkboxradiogroupdiv td {
	padding: 0px 10px 2px 0px;
	
}
.chkboxgroupclass{
	padding:0px 3px 0px 0px;
	border:0px;
	margin:0px;
	margin-bottom:-2px;
}
.contentImgClass{
	margin-bottom:-2px;
	padding:0px 5px 0px 5px;
}
</style>
</head>
<body style="margin:10px; ">
<b>TalentPool Controls: Checkbox and radio button groups</b><br><br>
<script type="text/javascript">
var opts = new Array();
opts[0] = new SelectOption('1','Electronics And Telecommunication Engineering',0,null,false,{optImage: 'flag_yellow.gif'});
opts[1] = new SelectOption('2','Mechanical Engineering',0,null,false,{optImage: 'flag_red.gif'});
opts[2] = new SelectOption('3','Computer Science');
opts[3] = new SelectOption('4','Electrical Engineering');
opts[4] = new SelectOption('5','Electronics" Engineering');
opts[5] = new SelectOption('6','Metallurgy');
opts[6] = new SelectOption('7','Civil',null,null,'1');
opts[7] = new SelectOption('8','Production');
opts[8] = new SelectOption('9','Instrumentation');
var x=null;
</script>
<b>Checkbox groups with multiselect:</b><br>
<br>
<script type="text/javascript">
var x = new CheckBoxRadioGroup(opts,'1,4,5',{namesonly:false, layerclass:'checkboxradiogroupdiv', size:15, imageclass:'chkboxgroupclass', contentImgClass:'contentImgClass', controlsperline:0});
//x.setOnChangeHandler('onChange');
document.write(x.getHtml());
x.init();
x.setOnChangeHandler("onChange");


function onChange(objX){
	alert(objX.getSelectedIds());
}
function reinitialize(){
	var optz = new Array();
	optz[0] = new SelectOption('1','Electronics And Telecommunication Engineering',0,null,false,{optImage: 'flag_yellow.gif'});
	optz[1] = new SelectOption('2','Mechanical Engineering',0,null,false,{optImage: 'flag_red.gif'});
	optz[2] = new SelectOption('3','Computer Science');
	optz[3] = new SelectOption('4','Electrical Engineering');
	optz[4] = new SelectOption('5','Electronics" Engineering');
	
	x.reInitialize(optz, '',{tristateids:'2,3'});
}
</script>
<br>
<b>Radio button group with single select:</b><br><br>
<script type="text/javascript">
var optz = new Array();
optz[0] = new SelectOption('1','Electronics And Telecommunication Engineering',0,null,false,{optImage: 'flag_yellow.gif'});
optz[1] = new SelectOption('2','Mechanical Engineering',0,null,false,{optImage: 'flag_red.gif'});
optz[2] = new SelectOption('3','Computer Science');
optz[3] = new SelectOption('4','Electrical Engineering');
optz[4] = new SelectOption('5','Electronics" Engineering');
var y = new CheckBoxRadioGroup(optz,'1,3',{namesonly:'true', layerclass:'checkboxradiogroupdiv',  imageclass:'chkboxgroupclass', uncheckedimg:'radiobutton.gif', checkedimg:'checkedradiobutton.gif', tristatecheckedimg:'checkboxtristate.gif', contentImgClass:'contentImgClass',controlsperline:'3', singleselect:'true'});
//x.setOnChangeHandler('onChange');
document.write(y.getHtml());
y.init();
</script>

<br><br>
<a href="#" onClick="javascript: alert(x.getSelectedIds());">show selected</a>
<br><br>
<a href="#" onClick="javascript: reinitialize();">reinitialize</a>
<br><br>
<a href="#" onClick="javascript: x.hideMe();">hide me</a>
<br><br>
<a href="#" onClick="javascript: x.showMe();">show me</a>
<br><br>
<a href="#" onClick="javascript: x.resetSelected();">reset selected</a>
<br><br>
<a href="#" onClick="javascript: x.selectAll(true);">Select all</a>
<br><br>
<a href="#" onClick="javascript: x.selectAll(false);">Unselect all</a>
<br><br>

</body>
</html>