package com.talentPool.positions.dataobject;

import com.talentPool.common.db.SimpleDataObject;

public class RuleInstituteData extends SimpleDataObject{

	public RuleInstituteData(){
		
	}

	public String getRuleId() {
		return getId("ruleId");
	}
	
	public void setRuleId(String ruleId) {
		setAttribute("instituteId",ruleId);
	}

	public String getInstituteId() {
		return getId("instituteId");
	}
	
	public void setInstituteId(String instituteId) {
		setAttribute("instituteId",instituteId);
	}

}
