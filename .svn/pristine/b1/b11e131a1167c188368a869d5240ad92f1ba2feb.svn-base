package com.talentPool.search.dataobjects;

import java.util.ArrayList;

import com.talentPool.common.Pagination;

/**
 * @author shivprasad
 * 
 */
public class SearchResultData {
	ArrayList records;
	long recordCount = 0;
	Pagination pager;

	/**
	 * @return Returns the records.
	 */
	public ArrayList getRecords() {
		return records;
	}

	/**
	 * @param records
	 *            The records to set.
	 */
	public void setRecords(ArrayList records) {
		this.records = records;
	}

	/**
	 * @return Returns the recordCount.
	 */
	public long getRecordCount() {
		return recordCount;
	}

	/**
	 * @param recordCount
	 *            The recordCount to set.
	 */
	public void setRecordCount(long recordCount) {
		this.recordCount = recordCount;
	}

	/**
	 * @return Returns the pager.
	 */
	public Pagination getPager() {
		return pager;
	}

	/**
	 * @param pager
	 *            The pager to set.
	 */
	public void setPager(Pagination pager) {
		this.pager = pager;
	}

}
