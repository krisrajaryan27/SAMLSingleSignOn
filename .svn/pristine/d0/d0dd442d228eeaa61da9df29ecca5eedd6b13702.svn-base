package com.talentPool.costs.form;

import com.talentPool.common.base.TPActionForm;

public class CostTypeForm extends TPActionForm {
	private String subMode;
	private String costTypeId;
	private String costType;
	/**
	 * @return the costTypeId
	 */
	public String getCostTypeId() {
		return costTypeId;
	}

	/**
	 * @param costTypeId
	 *            the costTypeId to set
	 */
	public void setCostTypeId(String costTypeId) {
		this.costTypeId = costTypeId;
	}

	/**
	 * @return the subMode
	 */
	public String getSubMode() {
		return subMode;
	}

	/**
	 * @param subMode
	 *            the subMode to set
	 */
	public void setSubMode(String subMode) {
		this.subMode = subMode;
	}

	/**
	 * @return the costType
	 */
	public String getCostType() {
		return costType;
	}

	/**
	 * @param costType the costType to set
	 */
	public void setCostType(String costType) {
		this.costType = costType;
	}
}
