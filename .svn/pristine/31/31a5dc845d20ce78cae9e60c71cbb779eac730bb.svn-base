package com.talentPool.common.utils.Exception;

/**
 * @author shivprasad
 * 
 */
public class FileUploadException extends Exception {
	/**
	 * Creates a new instance of <code>FileUploadException</code> without detail message.
	 */
	public FileUploadException() {
	}

	/**
	 * Constructs an instance of <code>FileUploadException</code> with the specified detail message.
	 * 
	 * @param msg
	 *            the detail message.
	 */
	public FileUploadException(String msg) {
		super(msg);
	}
}
