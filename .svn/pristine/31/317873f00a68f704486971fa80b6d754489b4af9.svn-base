package com.talentPool.admin.dataobject;

import com.talentPool.common.db.SimpleDataObject;

/*
 * @Author Ajeet
 */

public class PermissionData extends SimpleDataObject {
	

	public PermissionData(){
	}
		
	public String getModuleId() {
		return getString("moduleId");
	}

	public void setModuleId(String moduleId) {
		setAttribute("moduleId",moduleId);
	}
	
    public void setPermissionId(String permissionId){
        setAttribute("permissionId",permissionId);
    }
    
    public String getPermissionId(){
        return getString("permissionId");
    }
    
    public void setPermissionRank(String permissionRank){
        setAttribute("permissionRank",permissionRank);
    }
    
    public String getPermissionRank(){
        return getString("permissionRank");
    }
    
    public void setPermissionDesc(String permissionDesc){
        setAttribute("permissionDesc",permissionDesc);
    }
    
    public String getPermissionDesc(){
        return getString("permissionDesc");
    }
    
    public void setParentId(String parentId){
        setAttribute("parentId",parentId);
    }
    
    public String getParentId(){
        return getString("parentId");
    }
    
    public void setIsPermission(String isPermission){
        setAttribute("isPermission",isPermission);
    }
    
    public String getIsPermission(){
        return getString("isPermission");
    }
    
    public String getPermissionValue(){
        return getString("permissionValue");
    }

	/**
	 * @return the allPermissions
	 */
	public String getAllPermissions() {
		return getString("AllPermissions");
	}

	/**
	 * @param allPermissions the allPermissions to set
	 */
	public void setAllPermissions(String allPermissions) {
		setAttribute("allPermissions",allPermissions);
	}
	
    public void setName(String name){
        setAttribute("name",name);
    }
    
    public String getName(){
        return getString("name");
    }
   
    public void setUserId(String userId){
        setAttribute("userId",userId);
    }
    
    public String getUserId(){
        return getString("userId");
    }
}