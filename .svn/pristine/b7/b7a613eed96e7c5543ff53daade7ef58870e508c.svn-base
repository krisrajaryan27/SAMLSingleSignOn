package com.talentPool.websiteservice.dataobject;

/**
 * @author SumeetS
 *
 */
public class BaseDTO {
    private Integer id;

    private String name;

    /*
     * Constructor
     */
    public BaseDTO() {
    }

    public BaseDTO(Integer id, String name) {
	this.id = id;
	this.name = name;
    }

    public Integer getId() {
	return id;
    }

    public void setId(Integer id) {
	this.id = id;
    }

    public String getName() {
	return name;
    }

    public void setName(String name) {
	this.name = name;
    }
}
