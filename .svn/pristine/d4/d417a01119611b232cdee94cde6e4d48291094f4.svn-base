package com.talentPool.websiteservice.dataobject;

import java.util.ArrayList;

public class WsocialMediaSourceList {
	
	private ArrayList<WsocialMediaSource> sources;

	/**
	 * @return the sources
	 */
	public ArrayList<WsocialMediaSource> getSources() {
		return sources;
	}

	/**
	 * @param sources 
	 * 			the sources to set
	 */
	public void setSources(ArrayList<WsocialMediaSource> sources) {
		this.sources = sources;
	}

}
