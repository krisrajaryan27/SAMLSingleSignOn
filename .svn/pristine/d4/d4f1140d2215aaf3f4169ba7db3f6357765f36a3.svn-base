package com.talentPool.customReports.dataobject;

import java.io.Serializable;


/**
 * @author PraveenK
 * @since  Nov 9, 2011
 */
public class CustomReportModel implements Serializable {
	
	private static final long serialVersionUID = 1L;
	
	private String reportId;
	private String reportTitle;
	private String reportDesc;
	private String columnIds;
	private String rowIds;
	private String measureIds;	 
	private String createdBy;
	private String filtersJSON;
	private boolean showCandidateNames;
	private boolean showInactivePositions;
	private String extraCandidateAttributes;
	private String stepsToShowNames;
	private String stepsToShowNamesAndAttributes;
	private String reportLevelIds;
	private boolean showRowGrandTotal;
	private String showRowSubTotalsFor;
	private String reportTypeId;
	private String reportTypeName;
	private String addEditMode;
	private String reportTypeKindId;
	
	
	/**
	 * @return the addEditMode
	 */
	public String getAddEditMode() {
		return addEditMode;
	}
	/**
	 * @param addEditMode the addEditMode to set
	 */
	public void setAddEditMode(String addEditMode) {
		this.addEditMode = addEditMode;
	}
	/**
	 * @return the reportId
	 */
	public String getReportId() {
		return reportId;
	}
	/**
	 * @param reportId the reportId to set
	 */
	public void setReportId(String reportId) {
		this.reportId = reportId;
	}
	/**
	 * @return the reportTitle
	 */
	public String getReportTitle() {
		return reportTitle;
	}
	/**
	 * @param reportTitle the reportTitle to set
	 */
	public void setReportTitle(String reportTitle) {
		this.reportTitle = reportTitle;
	}
	/**
	 * @return the reportDesc
	 */
	public String getReportDesc() {
		return reportDesc;
	}
	/**
	 * @param reportDesc the reportDesc to set
	 */
	public void setReportDesc(String reportDesc) {
		this.reportDesc = reportDesc;
	}
	
	/**
	 * @return the createdBy
	 */
	public String getCreatedBy() {
		return createdBy;
	}
	/**
	 * @param createdBy the createdBy to set
	 */
	public void setCreatedBy(String createdBy) {
		this.createdBy = createdBy;
	}
	/**
	 * @return the filtersJSON
	 */
	public String getFiltersJSON() {
		return filtersJSON;
	}
	/**
	 * @param filtersJSON the filtersJSON to set
	 */
	public void setFiltersJSON(String filterJSON) {
		this.filtersJSON = filterJSON;
	}
	
	/**
	 * @return the columnIds
	 */
	public String getColumnIds() {
		return columnIds;
	}
	/**
	 * @param columnIds the columnIds to set
	 */
	public void setColumnIds(String columnIds) {
		this.columnIds = columnIds;
	}
	/**
	 * @return the rowIds
	 */
	public String getRowIds() {
		return rowIds;
	}
	/**
	 * @param rowIds the rowIds to set
	 */
	public void setRowIds(String rowIds) {
		this.rowIds = rowIds;
	}
	/**
	 * @return the valueIds
	 */
	public String getMeasureIds() {
		return measureIds;
	}
	/**
	 * @param valueIds the valueIds to set
	 */
	public void setMeasureIds(String measureIds) {
		this.measureIds = measureIds;
	}
	/**
	 * @return the reportLevelIds
	 */
	public String getReportLevelIds() {
		return reportLevelIds;
	}
	/**
	 * @param reportLevelIds the reportLevelIds to set
	 */
	public void setReportLevelIds(String reportLevelIds) {
		this.reportLevelIds = reportLevelIds;
	}
	/**
	 * @return the showCandidateNames
	 */
	public boolean isShowCandidateNames() {
		return showCandidateNames;
	}
	/**
	 * @param showCandidateNames the showCandidateNames to set
	 */
	public void setShowCandidateNames(boolean showCandidateNames) {
		this.showCandidateNames = showCandidateNames;
	}
	/**
	 * @return the extraCandidateAttributes
	 */
	public String getExtraCandidateAttributes() {
		return extraCandidateAttributes;
	}
	/**
	 * @param extraCandidateAttributes the extraCandidateAttributes to set
	 */
	public void setExtraCandidateAttributes(String extraCandidateAttributes) {
		this.extraCandidateAttributes = extraCandidateAttributes;
	}
	/**
	 * @return the stepsToShowNames
	 */
	public String getStepsToShowNames() {
		return stepsToShowNames;
	}
	/**
	 * @param stepsToShowNames the stepsToShowNames to set
	 */
	public void setStepsToShowNames(String stepsToShowNames) {
		this.stepsToShowNames = stepsToShowNames;
	}
	/**
	 * @return the stepsToShowNamesAndAttributes
	 */
	public String getStepsToShowNamesAndAttributes() {
		return stepsToShowNamesAndAttributes;
	}
	/**
	 * @param stepsToShowNamesAndAttributes the stepsToShowNamesAndAttributes to set
	 */
	public void setStepsToShowNamesAndAttributes(
			String stepsToShowNamesAndAttributes) {
		this.stepsToShowNamesAndAttributes = stepsToShowNamesAndAttributes;
	}
	/**
	 * @return the showRowGrandTotal
	 */
	public boolean isShowRowGrandTotal() {
		return showRowGrandTotal;
	}
	/**
	 * @param showRowGrandTotal the showRowGrandTotal to set
	 */
	public void setShowRowGrandTotal(boolean showRowGrandTotal) {
		this.showRowGrandTotal = showRowGrandTotal;
	}
	/**
	 * @return the showRowSubTotalsFor
	 */
	public String getShowRowSubTotalsFor() {
		return showRowSubTotalsFor;
	}
	/**
	 * @param showRowSubTotalsFor the showRowSubTotalsFor to set
	 */
	public void setShowRowSubTotalsFor(String showRowSubTotalsFor) {
		this.showRowSubTotalsFor = showRowSubTotalsFor;
	}
	/**
	 * @return the serialversionuid
	 */
	public static long getSerialversionuid() {
		return serialVersionUID;
	}
	/**
	 * @return the reportTypeId
	 */
	public String getReportTypeId() {
		return reportTypeId;
	}
	/**
	 * @param reportTypeId the reportTypeId to set
	 */
	public void setReportTypeId(String reportTypeId) {
		this.reportTypeId = reportTypeId;
	}
	/**
	 * @return the reportTypeName
	 */
	public String getReportTypeName() {
		return reportTypeName;
	}
	/**
	 * @param reportTypeName the reportTypeName to set
	 */
	public void setReportTypeName(String reportTypeName) {
		this.reportTypeName = reportTypeName;
	}
	/**
	 * @return the reportTypeKindId
	 */
	public String getReportTypeKindId() {
		return reportTypeKindId;
	}
	/**
	 * @param reportTypeKindId the reportTypeKindId to set
	 */
	public void setReportTypeKindId(String reportTypeKindId) {
		this.reportTypeKindId = reportTypeKindId;
	}
	/**
	 * @return the showInactivePositions
	 */
	public boolean isShowInactivePositions() {
		return showInactivePositions;
	}
	/**
	 * @param showInactivePositions the showInactivePositions to set
	 */
	public void setShowInactivePositions(boolean showInactivePositions) {
		this.showInactivePositions = showInactivePositions;
	}
	
}