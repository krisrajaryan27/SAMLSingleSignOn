var MultipleSelectData = Class.create();
MultipleSelectData.prototype ={
	initialize: function(selectId, selectTitle, multipleSelectFields){
		this.selectId=selectId;
		this.selectTitle=selectTitle;
		this.multipleSelectFields=multipleSelectFields;
	},
	
	setSelectId: function(selectId){
		this.selectId=selectId;
	},
	
	getSelectId: function(){
		return this.selectId;
	},
	
	setSelectTitle: function(selectTitle){
		this.selectTitle=selectTitle;
	},
	getSelectTitle: function(){
		return this.selectTitle;
	},
	
	setMultipleSelectFields: function(multipleSelectFields){
		this.multipleSelectFields=multipleSelectFields;
	},
	getMultipleSelectFields: function(){
		return this.multipleSelectFields;
	}
}