package com.talentPool.stepsMigration.data;

/**
 * @author PraveenK
 * @since  Jan 5, 2012
 */
public class StepLevel {
	private String stepLevelId;
	private String stepLevelName;
	/**
	 * @return the stepLevelName
	 */
	public String getStepLevelName() {
		return stepLevelName;
	}
	/**
	 * @param stepLevelName the stepLevelName to set
	 */
	public void setStepLevelName(String stepLevelName) {
		this.stepLevelName = stepLevelName;
	}
	/**
	 * @return the stepLevelId
	 */
	public String getStepLevelId() {
		return stepLevelId;
	}
	/**
	 * @param stepLevelId the stepLevelId to set
	 */
	public void setStepLevelId(String stepLevelId) {
		this.stepLevelId = stepLevelId;
	}
}
