package com.talentPool.positions.dataobject;

import com.talentPool.common.db.SimpleDataObject;

public class PositionReqData extends SimpleDataObject {
	
	public PositionReqData() {

	}

	public String getPositionId() {
		return getId("positionId");
	}

	public void setPositionId(String positionId) {
		setAttribute("positionId", positionId);
	}

	public int getRequirementId() {
		return getInt("requirementId");
	}

	public void setRequirementId(String requirementId) {
		setAttribute("requirementId", requirementId);
	}

	public String getRequirementText() {
		return getString("requirementText");
	}

	public void setRequirementText(String requirementText) {
		setAttribute("requirementText", requirementText);
	}

	public void setRequirementRank(int requirementRank) {
		setAttribute("requirementRank", new Integer(requirementRank));
	}

	public int getRequirementRank() {
		return getInt("requirementRank");
	}
}


