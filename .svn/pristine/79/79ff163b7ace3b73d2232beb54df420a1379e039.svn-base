NULL,'0','1',1,NULL,'<OL><LI>Design and development of .Net based applications</LI><BR/><LI>Liasoning with onsite coordinator to accomplish tasks</LI></OL>','<OL><LI>Experience in developing applications using C#.Net</LI><BR/><LI>Hands on experience in SQL Server</LI><BR/><LI>Knowledge of Nunit is a must</LI><BR/><LI>Exposure to VB, VC++ would be preferred</LI><BR/><LI>Good communication skills</LI><OL>','0'),(9,'TL - DotNet','Dot-Net Team Leader','5.00','8.00',2,2,'2010-08-16 00:00:00','2010-06-13 11:22:55',3,NULL,NULL,NULL,NULL,'',3,12,NULL,NULL,'1',3,'1',NULL,NULL,NULL,NULL,'0','1',1,NULL,'<OL><LI>Lead a team of 3-5 developers for development of .Net based applications</LI><BR/><LI>Direct interaction with customer</LI></OL>','<OL><LI>Must have led development teams in the past</LI><BR/><LI>Experience in developing applications using C#.Net</LI><BR/><LI>Hands on experience in SQL Server</LI><BR/><LI>Knowledge of Nunit is a must</LI><BR/><LI>Exposure to VB, VC++ would be preferred</LI><BR/><LI>Good communication skills</LI><OL>','0'),(10,'SE - VC','C++ Developer','2.00','5.00',10,10,'2010-07-13 00:00:00','2010-06-13 11:27:35',2,NULL,NULL,NULL,NULL,'',2,12,NULL,NULL,'1',2,'1',NULL,NULL,NULL,NULL,'0','1',1,NULL,'<OL><LI>Design and development of C++ based applications</LI><BR/><LI>Liasoning with onsite coordinator to accomplish tasks</LI></OL>','<OL><LI>Experience in developing applications using Visual C++</LI><BR/><LI>Hands on experience in SQL Server</LI><BR/><LI>Knowledge of Nunit is a must</LI><BR/><LI>Good communication skills</LI><OL>','0'),(11,'QA','Quality Analyst','2.00','4.00',3,3,'2010-08-07 00:00:00','2010-06-30 17:33:25',4,NULL,NULL,NULL,NULL,'',2,12,3,NULL,'3',4,'1',NULL,NULL,NULL,NULL,'0','1',1,NULL,'<OL><LI>Design and development of Java based applications</LI><BR/><LI>Liasoning with onsite coordinator to accomplish tasks</LI></OL>','<OL><LI>Experience in Java &amp;amp; J2EE, particularly JSP, Struts and JSTL</LI><BR/><LI>Hands on experience in Oracle &amp;amp; PL/SQL</LI><BR/><LI>Knowledge of Hibernate and Junit is a must</LI><BR/><LI>Exposure to Jboss, Tomcat preferred</LI><BR/><LI>Good communication skills</LI><OL>','0');
