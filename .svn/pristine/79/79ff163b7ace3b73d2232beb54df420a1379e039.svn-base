--
-- Table structure for table `tp_appointment_status`
--

DROP TABLE IF EXISTS `tp_appointment_status`;
CREATE TABLE `tp_appointment_status` (
  `appointment_status_id` tinyint(4) NOT NULL,
  `appointment_status_text` varchar(40) NOT NULL,
  PRIMARY KEY  (`appointment_status_id`)
) ENGINE=InnoDB DEFAULT CHARSET=latin1;

--
-- Dumping data for table `tp_appointment_status`
--


/*!40000 ALTER TABLE `tp_appointment_status` DISABLE KEYS */;
LOCK TABLES `tp_appointment_status` WRITE;
INSERT INTO `tp_appointment_status` VALUES (1,'Tentative Interview Schedule'),(2,'Confirm Interview Schedule'),(3,'Reschedule Interview'),(4,'No Show');
UNLOCK TABLES;
/*!40000 ALTER TABLE `tp_appointment_status` ENABLE KEYS */;

--
-- Table structure for table `tp_appointments`
--

DROP TABLE IF EXISTS `tp_appointments`;
CREATE TABLE `tp_appointments` (
  `appointment_id` bigint(20) NOT NULL auto_increment,
  `appointment_subject` varchar(250) default NULL,
  `appointment_from_date` datetime NOT NULL,
  `appointment_to_date` datetime NOT NULL,
  `appointment_date_created` datetime NOT NULL,
  `appointment_created_by` bigint(20) NOT NULL,
  `applicant_id` bigint(20) NOT NULL,
  `position_id` bigint(20) default NULL,
  `position_step_id` int(11) default NULL,
  `remind_me` int(11) NOT NULL,
  `remind_me_template_code` varchar(100) NOT NULL,
  `remind_attendee` int(11) NOT NULL,
  `remind_attendee_template_code` varchar(100) NOT NULL,
  `remind_applicant` int(11) NOT NULL,
  `remind_applicant_template_code` varchar(100) NOT NULL,
  `sms_remind_me` int(11) NOT NULL default '0',
  `sms_remind_me_template_code` varchar(100) NOT NULL,
  `sms_remind_attendee` int(11) NOT NULL default '0',
  `sms_remind_attendee_template_code` varchar(100) NOT NULL,
  `sms_remind_applicant` int(11) NOT NULL default '0',
  `sms_remind_applicant_template_code` varchar(100) NOT NULL,
  `appointment_status_id` tinyint(4) NOT NULL default '1',
  `appointment_modified_by` bigint(20) default NULL,
  `appointment_date_modified` datetime default NULL,
  PRIMARY KEY  (`appointment_id`),
  KEY `applicant_id` (`applicant_id`),
  KEY `position_id` (`position_id`),
  KEY `position_step_id` (`position_step_id`),
  KEY `tp_appointments_ibfk_4` (`appointment_status_id`),
  CONSTRAINT `tp_appointments_ibfk_5` FOREIGN KEY (`position_id`) REFERENCES `tp_positions` (`position_id`),
  CONSTRAINT `tp_appointments_ibfk_1` FOREIGN KEY (`applicant_id`) REFERENCES `tp_applicants` (`applicant_id`),
  CONSTRAINT `tp_appointments_ibfk_3` FOREIGN KEY (`position_step_id`) REFERENCES `tp_position_steps` (`position_step_id`),
  CONSTRAINT `tp_appointments_ibfk_4` FOREIGN KEY (`appointment_status_id`) REFERENCES `tp_appointment_status` (`appointment_status_id`)
) ENGINE=InnoDB DEFAULT CHARSET=latin1;

--
-- Dumping data for table `tp_appointments`
--


/*!40000 ALTER TABLE `tp_appointments` DISABLE KEYS */;
LOCK TABLES `tp_appointments` WRITE;
