--
-- Table structure for table `tp_applicant_selection_process`
--

DROP TABLE IF EXISTS `tp_applicant_selection_process`;
CREATE TABLE `tp_applicant_selection_process` (
  `process_id` bigint(20) NOT NULL auto_increment,
  `applicant_id` bigint(20) NOT NULL,
  `position_step_id_from` int(11) NOT NULL,
  `position_step_id_to` int(11) NOT NULL,
  `user_id` bigint(20) NOT NULL,
  `process_date_created` datetime default NULL,
  `process_moved_date` datetime NOT NULL,
  `position_id` bigint(20) NOT NULL,
  `selection_process_is_hidden` char(1) NOT NULL default '0',
  PRIMARY KEY  (`process_id`),
  KEY `user_id` (`user_id`),
  KEY `applicant_id` (`applicant_id`),
  KEY `FK_tp_applicant_selection_process` (`position_id`),
  CONSTRAINT `tp_applicant_selection_process_ibfk_3` FOREIGN KEY (`position_id`) REFERENCES `tp_positions` (`position_id`),
  CONSTRAINT `tp_applicant_selection_process_ibfk_1` FOREIGN KEY (`user_id`) REFERENCES `tp_users` (`USER_ID`),
  CONSTRAINT `tp_applicant_selection_process_ibfk_2` FOREIGN KEY (`applicant_id`) REFERENCES `tp_applicants` (`applicant_id`)
) ENGINE=InnoDB DEFAULT CHARSET=latin1;

--
-- Dumping data for table `tp_applicant_selection_process`
--


/*!40000 ALTER TABLE `tp_applicant_selection_process` DISABLE KEYS */;
