DROP TABLE IF EXISTS `tp_flags`;
CREATE TABLE `tp_flags` (
  `flag_id` smallint(6) NOT NULL auto_increment,
  `flag_image` varchar(50) NOT NULL,
  `flag_text` varchar(100) NOT NULL,
  `flag_type` char(1) NOT NULL default '0',
  `flag_status` char(1) NOT NULL default '1',
  `user_id` bigint(20) NOT NULL default '1',
  `date_created` datetime NOT NULL,
  PRIMARY KEY  (`flag_id`)
) ENGINE=InnoDB DEFAULT CHARSET=latin1;

