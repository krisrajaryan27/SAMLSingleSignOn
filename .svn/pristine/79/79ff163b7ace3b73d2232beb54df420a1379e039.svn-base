UNLOCK TABLES;
/*!40000 ALTER TABLE `tp_applicant_status_messages` ENABLE KEYS */;

--
-- Table structure for table `tp_applicants`
--

DROP TABLE IF EXISTS `tp_applicants`;
CREATE TABLE `tp_applicants` (
  `applicant_id` bigint(20) NOT NULL auto_increment,
  `applicant_name` varchar(100) NOT NULL,
  `applicant_address` text,
  `applicant_address_type` char(1) default NULL,
  `applicant_city` varchar(50) default NULL,
  `applicant_email1` varchar(50) default NULL,
  `applicant_email2` varchar(50) default NULL,
  `applicant_home_phone` varchar(25) default NULL,
  `applicant_home_phone_is_invalid` char(1) NOT NULL default '0',
  `applicant_cell_phone` varchar(25) default NULL,
  `applicant_cell_phone_is_invalid` char(1) NOT NULL default '0',
  `applicant_work_phone` varchar(25) default NULL,
  `applicant_work_phone_is_invalid` char(1) NOT NULL default '0',
  `applicant_working_since` date default NULL,
  `applicant_position_id` bigint(20) default NULL,
  `applicant_step_id` int(11) default NULL,
  `applicant_date_created` datetime NOT NULL,
  `source_id` int(11) NOT NULL,
  `applicant_joined` char(1) NOT NULL default '0',
  `applicant_date_joined` date default NULL,
  `applicant_original_resume_path` varchar(100) NOT NULL,
  `applicant_original_doc_path` varchar(100) default NULL,
  `applicant_text_resume` longtext,
  `applicant_current_employer` varchar(250) default NULL,
  `user_id` bigint(20) NOT NULL,
  `current_ctc` varchar(10) default NULL,
  `current_ctc_date` date default NULL,
  `expected_ctc` varchar(10) default NULL,
  `expected_ctc_date` date default NULL,
  `resume_updated_date` datetime NOT NULL,
  `resume_locked_date` date NOT NULL,
  `source_id_original` int(11) NOT NULL,
  `applicant_notice_period` varchar(25) default NULL,
  `applicant_level_offered` varchar(20) default NULL,
  `applicant_designation_offered` varchar(50) default NULL,
  `offered_ctc` varchar(10) default NULL,
  `vendor_id` bigint(20) default NULL,
  `is_confidential` char(1) default '0',
  `employee_code` varchar(100) default NULL,
  PRIMARY KEY  (`applicant_id`),
  KEY `applicant_step_id` (`applicant_step_id`),
  KEY `source_id` (`source_id`),
  KEY `applicant_position_id` (`applicant_position_id`),
  KEY `tp_applicants_ibfk_4` (`user_id`),
  KEY `FK_tp_applicants_4` (`source_id_original`),
  KEY `FK_tp_applicants_6` (`vendor_id`),
  KEY `applicant_email1` (`applicant_email1`,`applicant_email2`),
  CONSTRAINT `tp_applicants_ibfk_1` FOREIGN KEY (`applicant_step_id`) REFERENCES `tp_position_steps` (`position_step_id`),
  CONSTRAINT `tp_applicants_ibfk_2` FOREIGN KEY (`source_id`) REFERENCES `tp_sources` (`source_id`),
  CONSTRAINT `tp_applicants_ibfk_4` FOREIGN KEY (`user_id`) REFERENCES `tp_users` (`USER_ID`),
  CONSTRAINT `tp_applicants_ibfk_5` FOREIGN KEY (`source_id_original`) REFERENCES `tp_sources` (`source_id`),
  CONSTRAINT `tp_applicants_ibfk_6` FOREIGN KEY (`user_id`) REFERENCES `tp_users` (`USER_ID`),
  CONSTRAINT `tp_applicants_ibfk_7` FOREIGN KEY (`vendor_id`) REFERENCES `tp_users` (`USER_ID`),
  CONSTRAINT `tp_applicants_ibfk_8` FOREIGN KEY (`applicant_position_id`) REFERENCES `tp_positions` (`position_id`)
) ENGINE=InnoDB DEFAULT CHARSET=latin1;

--
-- Dumping data for table `tp_applicants`
--


/*!40000 ALTER TABLE `tp_applicants` DISABLE KEYS */;
LOCK TABLES `tp_applicants` WRITE;
INSERT INTO `tp_applicants` VALUES (1,'Ajit Kumar',NULL,NULL,NULL,NULL,NULL,NULL,'0',NULL,'0',NULL,'0','2008-04-29',NULL,NULL,'2010-06-08 12:13:25',10,'0',NULL,'200710/15/ATT61732.html','200710/15/DOC8039.doc','Career Summary\nCareer Summary\n\n\n      \nAround 2+ years \nof\n IT experience in implementation and design of web based and client/server application.\n\n      \nExtensive work experience in core java and server side technologies like \nJAVA, JSP, Servlets, Struts1.2, JDBC, JNDI, J2EE Design Patterns \nand well versed with \nRDBMS\n like Oracle.\n\n      \nClient/server applications using \nJava, J2EE, Struts \nand\nOracle. \n\n      \nExperience in developing applications in \nJ2EE \nusing\n MVC Architecture\n and good exposure using \nStruts Framework\n\n\n\nPersonal Skills\n\n\n      \nExcellent written, oral and interpersonal communication skills.\n\n      \nZeal to learn new Technologies.\n\n      \nGood communication and presentation skills\n\n      \nHands on in J2EE /Java Web-Services.\n\n      \nGot several Appreciations from clients and my superiors for outstanding performance which is reflected in continuous high rating that I got in my appraisal. \n\n      \nCurrently leading a team of 7 and hence taking up the responsibility that starts from Product design till implementation\n\nSoftware Skills\n\n          \nLanguages\n              \n\n        \nJava 1.4,PL/SQL, C, C++\n          \nData Bases\n              \n\n\n       \nOracle 8.x.\n          \nWeb Technologies \n   \n\n        \nJava Scripts, HTML, XML Technologies\n          \nJ2EE Technologies \n   \n\n        \nJava Web-Service, JSP, Servlets, JDBC.\n\n         \nOpen Source\n\n          \n\n        \nStruts 1.1\n          \nApplication servers \n\n\n        \nWeblogic, WebSphere, JBoss\n          \nWeb Servers\n            \n\n        \nTomcat\n          \nOperating Systems\n   \n\n        \nMS-Windows XP/2000\n          \nIDES\n                       \n\n        \nEclipse, iReport\n          \nBuild tool\n                \n\n        \nANT\n              \nMerge tool\n                \n\n          \nAraxis \n\n\nEducational \nQualifications\n\n\n\n      \nM.C.A from BITs Mesra, \nRanchi\n Jharkhand.\n\n\nProfessional Experiences\n\n      \n  \nCurrently working as a Software Engineer with \nComputer Sciences Corporation India, \nChennai since Feb?2007\n\n      \nWorking as a \nSoftware Engineer\n\nin \nAdroit Claretdene Infotech Pvt Ltd\n\nBangalore\n from \nMay\n 2005\n to\n\nJANUARY 2007\n\nPROJECTS\n\n\n\nPROJECT #1:\n\nProject Title\n\n     \n\n    \n   \nStrategic Account Management 3.0\n   \n           \nFeb 07 to till Date\nOrganization\n      \n\n     \nComputer Sciences and Corporation (\nthrough\n Datacore Technologies \n  \nPvt. Ltd)\nClient\n                \n\n\n     \n\nGE Finance\n           \nTeam Size\n   \n     \n\n   \n\n\n\n20\n\nEnvironment\n      \n\n    \n     \nJava5.0,Struts1.2,JSP1.2,iReport1.3.0,Jasper,Oracle10g, \n   \nJBoss4.0,Eclipse, Windows XP.\nRole\n                  \n\n    \n     \nTeam Lead\n\n\n\nDescription\n                  \n\n            \n       \nSAM is a secure, web-based account management and reporting system that provides\n     \naccess to more than 140 standard reports including purchasing and travel card management, cardholder activity, and merchant activity.\n\nUsing SAM we can produce transaction-level reporting that includes line-item detail. The system allows us to build virtually any report we need with its robust query wizard (ad-hoc) functionality. SAM batch processes all transaction data and makes it available 24-48 hours after merchant posting. SAM is a powerful relational database that offers extensive reporting capabilities and serves to automate transactions with default accounting. The mapping (electronic file transfer) feature offers us the ability to feed our general ledger with transaction data. SAM contains tables of records, including cardholder records, merchant records, transaction records, our chart of accounts, and an organizational hierarchy. SAM then allows us to manipulate, analyze, and search for data based on the relationships between these records. \n\n\nResponsibilities\n\n\n      \nPopulating Reports in three different formats (PDF\n\n RTF & XLS).\n\n      \nFront-end design is completely achieved with the \niReport\n\n      \nEstablished the Data source between \niReport\n and \nOracle\n\n      \nImplementation of \njrxml\n with the SQL\n\n      \nGenerated a \nScriptlet\n class which supplies formatting functions to the jrxml\n\n      \nTesting the reports.\n\n\n\n\n                          \n                                  \n     \n   \n            \n     \n   \nPROJECT #2:\n\nProject Title\n            \n         \n\n        \nTravel Planner\n\n      \n          \nFeb 2006 to Jan 2007\nClient\n                     \n\n        \nOAG Worldwide Ltd.\nRole\n                       \n\n       \n\nTeam Member.\nTeam Size\n              \n\n        \n\nEnvironment\n      \n     \n\n          \nWin2K, JSP, Struts, Eclipse and Oracle\nApp Server\n             \n\n          \nWeb Logic \n\nDescription:\n                     \nThe Travel Planner product/site range is one of key products, delivering its data and associated functionality to subscribers either through the Extranet, Intranet or ?single user? version. Customers are both travelers and travel arrangers, who use the product to plan travel arrangements for multiple people. This project is a major initiative to re-engineer the Travel Planner Product based on Java/ J2EE, Web Logic, Oracle and other related technologies.\n\nResponsibilities \n\n\n      \nInvolved in writing Action Classes, Form Beans.\n\n      \nUsed Struts Tiles and Validation Framework.\n\n      \nDesigned JSPs as per the requirements.\n\n      \nImplemented Business Delegates.\n\n      \nResponsible for writing DAO?s.\n\n\nPROJECT #3:\n\nProject Title\n          \n\n\n   \nHealthCare Information System.\n   \n                 \nJuly2005\n\nto Jan 2006\nClient\n             \n      \n\n   \nSmart Systems, \nUSA\n\n        \nRole\n               \n      \n\nTeam Member.\n       \nTeam Size\n       \n      \n\n\n\n        \nEnvironment\n           \n\n         \n  \nWin2k ,Java, Jdbc, JSP, Servlets, Struts and Oracle\n\nDescription\n\n\nHealth Highway seeks to provide infrastructure for practitioners in the medical industry to interact with patients using the Internet. The infrastructure will comprise a patient portal and a Practitioner portal. Health care practitioners as well as patients will have the facility to register themselves in the system. The Practitioner portal will permit physicians to accept patients, schedule appointments and interact with them online. Patient portal gives the ability for patients to search for physicians based on their need and request for appointments based on physicians ability and visit their Website to view the provider\'s profile, education & training, office hours, policy, hospital and providers group affiliations and meet their staff. Health Highway allows all practitioners to have a web presence by simply registering themselves in the practitioner\'s portal.\n\n          \n          \nResponsibilities \n\n\n   \nInvolved in writing Action Classes, Form Beans.\n\n   \nDesigned JSPs as per the requirements.\n\n   \nResponsible for implementing delegate classes.\n\n\nPROJECT #4:\n\nProject Title\n              \n\n       \nOpen house\n            \n                   \nMay 2005 to July 2005\n\nClient\n               \n           \n     \n\n       \nOpen \nWindsor\n\nCanada\n\nRole\n                       \n\n       \nTeam Member.\nTeam Size\n              \n\n        \n\nEnvironment\n      \n     \n\n     \n  \nWin2k ,Java, Jdbc, JSP, Servlets, and Oracle\nWeb Server\n            \n\n          \nTomcat\n\nDescription:\n          \nOpen house \nWindsor\n is a comprehensive and concerted effort to put the Real estate and building industry in online. It covers every aspect of the industry to cater the needs of everyone concerned with it: real estate institutions, builders, building material agents, architects, engineers, contractors, consultants etc. Open \nWindsor\n provides the complete\n    \nA-Z information of all the properties like individual houses, residential and commercial complexes, and flats. Users can registers themselves as agents and agents can register their properties in to site to sell.\n\nResponsibilities:\n\n\n      \nResponsible for writing Servlets and JSP\n\n      \nResponsible for writing JDBC Connections.',NULL,9,NULL,'2007-10-15',NULL,'2007-10-15','2010-06-08 12:13:25','2010-06-08',10,NULL,NULL,NULL,NULL,9,'0',NULL),(2,'Amit Jai',NULL,NULL,NULL,'Jaiswal25567@yahoo.co.in',NULL,'91 9886098399','0','9986092205','0',NULL,'0','2007-02-28',NULL,NULL,'2010-06-08 12:13:25',3,'0',NULL,'200710/15/ATT61733.html','200710/15/DOC8040.doc','A1/2 Shankar Rao More\n\nAmit Jai\n503,8\nth\n\nMain\n, 4\nth\n Block\nKoramangala, Bangalore\nPin: 78\nJaiswal25567@yahoo.co.in\nCell:\n\n+91-9886098399, +91-9986092205\nExperience Summary\n\n3.2\n years of Exp.\n\nin IT, based on\n Java/J2EE Technology.\n\n         \nExpertise in Core JAVA\n\n\n         \nExpertise in Servlet \n\n         \nExpertise in JSP\n\n         \nGood knowledge of JDBC & XML.\n\n         \nExposure of Design Patterns.\n\nSkills\n\n\n         \nOperating System\n                \nWindows 2000 Professional, Win 9x, DOS\n\n         \nTools\n                      \n            \nEclipse 3.1, Edit plus\n\n         \nDomains\n                 \n    \n        \nRetail, Application Programming\n\n         \nProgramming Languages\n    \nCore Java, JSP, Servlet, JDBC \n\n         \nWeb Server\n    \n                      \nTomcat 5x\n\n         \nApplication Server\n               \nWeb sphere Commerce Server 6\n\nEducation\n\n         \nMSC with Computer Science from\n\nBU, \nBhopal\n (2002)\n\n\n         \nBSC with Computer Science from \nBU, \nBhopal\n (2000).\n\n\nWorking Experience \nValtech India Pvt. Ltd., \nBangalore\n                                                     \nFeb?07 to Till Date\nSoftware Engineer\nwww.valtech.co.in\nValtech is a pioneer and a thought leader in the field of Agile software development. They have developed their own unique Agile adoption \nmethodology\n by building on the extensive experience. They have accrued over the past 11 years. This approach provides the momentum and ready-to-use structure needed to ?go Agile\n\n Valtech receives CMMI-5 certification for its global sourcing operations.\nAgile software development\n is a conceptual framework for undertaking \nsoftware engineering\n projects. There are a number of agile \nsoftware\n development methods, such as those espoused by \nThe Agile Alliance\n. Most agile methods attempt to minimize risk by developing software in short \ntimeboxes\n, called iterations, which typically last one to four weeks. \nEach iteration is like a miniature software project of its own, and includes all of the tasks necessary to release the mini-increment of new functionality: planning, \nrequirements analysis\n, design, coding, \ntesting\n, and documentation. While an iteration may not add enough functionality to warrant releasing the product, an agile software project intends to be capable of releasing new software at the end of every iteration.\n                    \nProject: Innovente [Darty (France)]\nDarty\n, founded in 1957 by the Darty Family in \nFrance\n, is now a wholly owned subsidiary of \nKESA\n Electricals \nPlc\n specialising in Electrical retailing. The company has different operations across \nEurope\n, the original being in \nFrance\n and now in three other countries (in conjunction with \nKESA\n), \nTurkey\n\nItaly\n and \nSwitzerland\n\n            \nIn \nFrance\n and \nLuxembourg\n Darty owns 209 stores making it the second largest retailer of the \nKESA\n Group (First being \nComet\n with 248 stores), which overall equals up to 274,400 square metres of selling space. Darty is the leader of specialized distribution of electronic products for the general public in France.They has headquarters in France and Paris.\nThis project is divided into two main modules; Catalog & Sales.It?s a development of Billing System by EAN Bar Code/Codic.\n Global Trade Item Number\n (GTIN) is an identifier for \ntrade items\n developed by \nGS1\n (comprising the former \nEAN International\n and \nUniform Code Council\n), and it also maintains the data information i.e. products & sales.\nGTIN\n is an ?umbrella? term used to describe the entire family of GS1 data structures for \ntrade items\n (products and services) identification. GTINs may be 8, 12, 13 or 14 digits long, and can be constructed using any of four numbering structures, depending upon the exact application.\nEnvironment:\n\nCore Java, J2EE, EJB, SWT, Web Sphere Commerce Server, Agile Development\nResponsibilities: \nAs a Team Member responsible for the Sales related module, Developing Core \nConcepts on client side modules using web sphere commerce server.\n\nAmiga Development India Pvt. Ltd. (formerly Ruksun), Pune\n\nSoftware Engineer\n                                             \n                                                \nOct?06 to Jan?07\n\n                                \n      \n\n\n                    \nProject: \nIMPS Gateway (\nEricsson\n\nChina\n\n\nIt?s a development of an IMPS Gateway with support for MSN Protocol for Ericsson. The development of an IMPS Gateway to allow existing OMA-IMPS users subscribed to Ericsson?s services to talk to users of proprietary IM service users like Yahoo, MSN, and AOL etc.\nThis project itself has two components to it.\nA)\n    \nIMPS Gateway development.\nB)\n     \nDevelopment of the IM protocol library.\nThe proposed solution aims to achieve inter-network interoperability through the usage of WV IMPS gateways that convert the application service element messages between the proprietary protocol and the WV server-to-server protocol, which can be understood by the IMPS servers.\n\nEnvironment:\n\nWEB-Based Application - JSP, Servlet, Core Java, and Tomcat 5.0\nResponsibilities: \nAs a Team Member responsible for the middleware application, handled JSP, Servlet, and Core Java related tasks.\n\nNetwork for Information & Computer Technology (NICT), \nIndore\n             \n                                                \n                                    \n             \n                    \nProject:\n\nFile Tracking System (FTS)\n                                           \n\nJun?04-Oct?06\n                                    \nProject Detail:\n            \nIt is a Web base Intranet File Tracking System. This System is specially designed for District Collectorate, Panna. This system is used to handle movements of files from one table to another table and one Department to other. It maintains track record of files movement in office.\n\nEnvironment:\n\nWEB-Based Application - JSP, Servlet, Core Java, and Oracle 8.0\n\nResponsibilities: \nRequirement gathering,\n worked as a developer used JSP, Servlet, and Core Java.\n                                                                        \n           \n                    \nProject:\n\nWebsite for AD-Agency\n\nProject Detail:\nPortal for online booking for launching of advertisements on hoardings with complete details like format of advertisement, spot of hoardings, ratings of the spots according public exposure, demographical information of the city to assist the user in placing his advertisements.\n\nEnvironment:\n\nWEB-Based Application - JSP, Servlet, Core Java, Oracle 8.0 and Tomcat 5.0\nResponsibilities: \nRequirement gathering,\n worked as a developer, used JSP, Servlet, Core Java.\n                                                \n                    \nProject:\n\nHuman Resource Management\n\nProject Detail:\nThe HRMS module looks into the staffing needs of an organization, employee recruitment & training, employee performance related issues, personnel and management practices, and \nEmployee benefits and compensation. The main objective of this module is to look after the Human Resource activities of an organization. The activities comprise Recruitment, Induction, Training, Appraisal, and Employee Separation. Sub-modules in HRMS. Functionality wise, HRMS can be further divided into the following sub modules: Recruitment, Training, and Appraisal.\n\nEnvironment:\n\nWEB-Based Application - JSP, Servlet, Core Java, Oracle 8.0 and Tomcat 5.0\nResponsibilities:\n\n\nWorked on Servlet, Core Java.',NULL,1,NULL,'2007-10-15',NULL,'2007-10-15','2010-06-08 12:13:25','2010-06-08',3,NULL,NULL,NULL,NULL,NULL,'0',NULL),(3,'Anil   ',NULL,NULL,NULL,'aniL12345@gmail.com',NULL,NULL,'0','91 9886486302','0',NULL,'0','2007-06-30',NULL,NULL,'2010-06-08 12:13:25',11,'0',NULL,'200710/15/ATT61734.html','200710/15/DOC8041.doc','nFlux? is a proprietary methodology, developed and trademarked by Infosys Technologies Limited\n\n\nAnil\n                                      \n                                                                                                \n            \n                                                \n   \n                     \n      \n                             \n             \n        \nEmail:\n aniL12345@gmail.com\n\n       \nPhone\n: +91 ? 9886486302\n          \n\n      \n\nProfessional Summary\n\n\n\n        \nOver\n 3+ Years \nof Experience in Software Development.\n\n        \nExperience in \nJava, JSP, Struts, EJB and Oracle.\n\n        \nPresently working as a Software Engineer at \nMphasiS (EDS), \nBangalore\n\n\n        \nPreviously worked as a Junior Software Engineer for \n\nPristine Communications Pvt Ltd. Bangalore.\n\nAcademic Profile\n\n\n        \nM.C.A \nfrom \nSri\nVenkateswara\nUniversity\n, Tirupati.\n\n\nDomain: \n\n\n   \nBanking / Financial / CRM.\n\nIT Exposure\n\nTechnical Profile\n\nOperating Systems\nWindows 2000/XP, Unix\n\nTechnologies\nJava, JDBC, JSP, JSTL, Struts, EJB, Hibernate\nTools\nEclipse, Edit Plus\nApplication & Web Server\nWebLogic, Tomcat\nRDBMS\nOracle, SQL Server\n\n\n\n\n\nProject Summary:\n\n\nProject Name\n\nSEI Desktop\n\nCMP Media\n\nMiniCRM\n\nSyntera\n\n\n\n\n\n\nProject Profile\n\n\n\n#4. SEI Desktop \n\nEnvironment\n   \n                        \n\n           \nJava, JSP, Struts, EJB, Oracle, Weblogic\nOrganization\n   \n                        \n\n\n          \nMPhasiS.\nBangalore\n\n\nClient\n                                      \n\n           \nSEI Investments, Oaks, USA.\n\nRole\n                \n                        \n\n           \nDeveloper\n\nDescription \n    \n                        \n\n\n          \nSEI Desktop is a Global Wealth Management System. The main Objective of the project is the managing of the wealth globally irrespective of the location of the Investor. It?s a wealth management System. This Product has Account Open, Relationship Management, and currency Flow, Fees, Edit Holdings, Statements and Reports modules. Account Open module deals with the opening of new Account, creation of sub Portfolios. Adding the Beneficiaries, Maintaining the relationships of the account and the clients.\n\nResponsibilities\n\n\n\n        \nCoding the server pages using JSP, Action and Helper classes.\n\n        \nWriting EJB and Delegator classes.\n\n        \nWriting PL/SQL for the Program Units\n\n        \n\nUnit Testing.\n\n\n#3. CMP Media \n\nEnvironment\n               \n\n    \n  \nJava, JSP, Hibernate, Oracle, Tomcat\n\nOrganization\n               \n\n   \n    \nDataCard Software Services, \nBangalore\n\n\nClient \n                         \n\n      \nCMP, \nNew York\n\nUSA\n\n\nRole \n                           \n\n      \nDeveloper\n\nDescription\n                 \n\n       \n\nhis project is Content Management System which is of Media Domain where we create the necessary Contents like News, Articles, and Slideshows which are going to display in the websites. CMP Media project has two modules. WEB 2.0 and the CMS Modules.CMS is a content generation and Management System where the job is to create the Article, Web casts, Slideshows and others contents which are going to get placed over the various websites like eetimes and information week.\n\nResponsibilities:\n\n        \nDeveloping the JSP and the Business layer Code.\n\n        \nJunit Testing.\n\n\n\n\n\n\n\n\n\n\n#2. MiniCRM \n\nEnvironment\n               \n\n      \nJava, JSP, Struts, SQL Server, Web Logic\n\nOrganization\n   \n            \n\n      \nPristine Communications Pvt Ltd., \nBangalore\n\n\nClient \n                         \n\n      \nFedEx\n\nUSA\n\nRole \n                           \n\n      \nDeveloper\n\nDescription\n                 \n\n   \n\nhis project is sales force automation for FedEx. Fedex project has MiniCRM, BCT, EMEA and GAM Scorecard modules. MiniCRM is a customer relationship management tool which deals with the customer relationships like getting the leads, accepting the leads and converting the leads of the customers into opportunities. It maintains the contact information of the customer and call details etc. And this module also have reports for all the transactions made by the salespersons like collecting the contact data and lead data from the customer and getting it approved by the manager and giving the customer an opportunity.\n\nResponsibilities:\n\n        \nDeveloping the JSP Screens\n\n        \nWriting the Java Classes and SQL Queries.\n\n        \nJunit Testing.\n\n\n# 1. Syntera\n                                                                              \n\nEnvironment\n   \n                        \n\n           \nJava, CORBA, Oracle\nOrganization\n   \n                        \n\n\n          \nPristine Communications Pvt Ltd., \nBangalore\n\nClient\n                                      \n\n           \nCardiant Group, Minneapolis, USA. \nRole\n                \n                        \n\n           \nProgrammer\nDescription \n    \n                        \n\n\n          \nSyntera is Printing Efficiency Software. The Syntera Personalization module deals with the Personalization activity of the card production environment. The Workflow module deals with the sequence of steps required to move the job thru the entire Production Process. The Grouping/Scheduling module offers the card issuers to automatically create an efficient schedule for the Day?s Work.\n\nResponsibilities\n\n\n\n         \nCoding the Production Overview and Production Dashboard Features.\n\n         \nCoding the Java classes and JDBC.\n\n         \nUnit Testing.',NULL,1,NULL,'2007-10-15',NULL,'2007-10-15','2010-06-08 12:13:25','2010-06-08',11,NULL,NULL,NULL,NULL,NULL,'0',NULL),(4,'Snehal  Patel',NULL,NULL,'Pune','snehsfasdfal0dffd0itfsa071@yahoo.com','snehal00it071@yahoo.com','02637 248321','0','9371299596','0',NULL,'0','2006-11-12',7,18,'2010-06-08 12:13:25',10,'0',NULL,'200710/15/ATT8038.html','200710/15/DOC8042.doc','CURRICULUM VITAE\nCURRICULUM VITAE\n\nSnehal \n\nPatel\n\n                          \nsnehsfasdfal0dffd0itfsa071@yahoo.com\n\nPersonal Details:\nDate Of Birth\n13\nth\n March 1983\nLanguage known\nGujarati, Hindi, English\nGender\nMale\nMarital Status\nUnmarried\nNationality\nIndian\nE-mail ID\nsnehal00it071@yahoo.com,\n\nsnehal4it@gmail.com\n\nContact Details: (Mobile: 9371299596)\nPresent Address\nPermanent Address\nB-24 Satyamev Appt.\nNDA Road\n\nNear Maratha Mandir,\nBawdhan-411021\nPune, \nMaharashtra\n\nIndia\nMobile\n: 9371299596\nB-36, Vishal Nagar,\nAt & Po: Italva,\nTa & Dist: Navsari,\nPin: 396445\nGujarat\n\nIndia\nPhone:(02637) 248321\n\nCertification: \nSun Certified Programmer for java 2 Platform, Standard Edition 5.0 (310-055)\nDate: \n\nst\n September 2007\nScore: 91%\n\nSkills:\nLanguages\nJava Swing, J2EE (JSP, Servlet, Struts/tiles, EJB), Hibernate 3.0, PHP 4/5, Tcl, SQL, c, c++, Shell Scripts, HTML, XHTML, XML\nDatabase\nMySQL4.0/5.0, Oracle9i/10g\nOperating System\nRed Hat Linux9, Windows 98/2000/XP, uClinux\nWebServer/Application Server\nApache, Tomcat 4.1, JBoss4.0, Oracle Application Server10g\nGroupware\nVSS, CVS, Rational Rose, Clear Case\nOthers\nAnt, JUnit, DBUnit, XDoclet, Eclipse, Smarty, \nAJAX\n, DOM, \nLog4j\n\nExperience Details:\nTotal Experience\n3.25 years\nDesignation\nSoftware Engineer\nLast Employer\nPersistent Systems Pvt. Ltd. Pune\nSalary\n420000 Rs (p.a.)\n\nTechnology\nExperience (months)\nJava Swing, JAXP, DOM\n11\nJ2EE (JSP, Servlet, Struts/tiles, JDBC, EJB, Java Mail, JNDI), Hibernate\n21\nPHP, \nAJAX\n\n MySQL, Apache\n7 (+4 months as training)\nProject Details: \nPosition/Title\n            \nLast \nEmployer Name\n           \n      \n          \nStart Date to Present\nSoftware Engineer\n    \nPersistent Systems Pvt. Ltd.\n       \n     \nJuly 2006 to July 2007\n\nProject: \nJ2EE project (Under NDA)\nClient: \nUS based client\nDescription: \nProject is for one of the \nwell known Cancer Research Institute of \nUSA\n\nResearchers perform experiments which generates huge amount of data. Project includes several modules which processes the outcome of experiments and stored the result in organized form in oracle database, and then web-based interface which is based on struts framework (with tiles) allows researcher to analyze the data in various forms like various search options, SVG graph displays, bar-graph in applet, downloading of search results and so on.\nResponsibilities: \nTake the requirements from client, design and provide the implementations.\nResponsible for application bugs, enhancements, tracking and fixing. \nPlatform & Skills:\nJSP, Servlet, \nStruts\n\nTiles\n, Applets, Tomcat4.1, Oracle10g, CVS, webservice (Axis runtime), Hibernate, log4j, JUnit, Eclipse, Windows\n\nPosition/Title\n                        \nPrevious Employer\n\n          \n\n    \nStart Date to End Date\nSenior Software Engineer\n   \nGateway Technolabs Pvt. Ltd\n\n\nMay 2004 to June 2006\n\nProject: \nJ2EE project (Under NDA)\nClient: \nUS based company\nDescription: \nMulti-tier web application, For Music Company automates the process of issuing the music licenses, managing the digital assets and provides the music search facility. It uses the EJB, hibernate based back-end components to interact with the oracle database. Web-based interface is developed in the struts framework which interacts with the EJB components to serve the requests.\nResponsibilities: \nUnderstand the requirements by studying functional specification, sequence diagrams and class diagram and provide implementation of Back-end for the web application using Hibernate (ORM), along with JUnit test cases.\nInteraction with client. (Worked as a part of global team spreading across various continents)\nPlatform & Skills:\nJSP, Servlet, Struts, EJB, Hibernate, Ant, JUnit, DBUnit, XDoclet, Eclipse, JBoss4.0, Oracle, Rational rose, clear case, Log4j, windows\n\n\nProject: \nPoker\nClient: \nUS based client\nDescription: \nOnline\nGame\nthat\ncan\nbe\nplayed\nfrom\nboth\ndesktop\nclient\nand\nweb\n browser.\nResponsibilities: \nDeveloping\n EGD \n(Entropy\ngathering\ndemon)\n\nfor\nmaintaining\nthe\nentropy\npool\nfor\nPoker\nserver\nwhich\nis\nresponsible\nfor\nseeding\n Random Number \nGenerator\nfor\nunbiased\nshuffling\nof\n Deck.\nPlatform & Skills:\nJava\n\nShell\n Scripts, \njava\n logging, windows\n\nProject: \nSoftware Agent.\nClient: \nUS based client\nDescription: \nSoftware\nagent\nthat\ncan\nprogrammed\nto\nextract\ndata\nfrom\nsemi\n structured/ \nstructured\n website. \nOnce\ncreated\n\nit\ncan\nperform\nextraction\n task (e.g. retrieving the list of books with author, price and other required details from some book site like Amazon.com) from webpages \nautomatically\nwithout\nuser?s\ninteraction\n\ncan\nalso\nmodified\nif\n desired.\nResponsibilities:\nAnalysis, \nDesign\n\nand\n Development of application.\nPlatform & Skills:\nJava\n(Swing)\n, XML \nparser\n\nDOM\n\nresource\n bundle, Windows\n\n\nProject: \nWeb Application in PHP.\nClient: \nUS based client\nDescription: \nProvides\ninterface\nfor\nmodels\n\nagencies\nand\nother\nusers\nfor\n offering/getting \nassignment\n\nsearching\n\ncommunicating\n (Gmail \nlike\nconversation\nmanagement)\nand\nsharing\n photos.\nResponsibilities: \nMain\ntask\nassigned\nis\ndeveloping\n Gmail \nlike\nconversation\n management in PHP for application.\nPlatform & Skills:\nPHP5, MySQL4, XHTML, \nAJAX\n, Apache, Windows\n\nProject: \nUtilities\nfor\n ISP \n(Internet\nService\n Provider)\nClient: \nUS based client\nDescription: \nProject can be divided into modules like front-end developed in PHP, backend-components developed in TCL scripts that make use of various networking utilities. \nProject \nprovides\nvarious\nfeatures\nfor\nInternet\nservice\n provider like \nbandwidth\nmanagement\n\nmaintaining\nuser\naccounts\n\nassign\ntasks\nto\ntechnical\npersons\nand\nmany\nmore\n\nwhich\nhelps\n ISP \nto\nmanage\n customers.\nResponsibilities: \nDeveloper for PHP front-end, \nTester\nalso\ninvolved\nin\nCustomer\n Support.\nPlatform & Skills:\nPHP4 TCL, MySQL4 \nApache\n\nfirewall\n\ntraffic\ncontrolling\nutilities\n\nvarious\nnetworking\nutilities\non\n Linux, \nand\nembedded\ndevice\nspecific\n utilities, Red Hat Linux8/9, uClinux \n(for\nembedded\n device).\n\n\nAcademic Qualification:\nDiscipline/Standard\nPercentage\nUniversity/Board\nYear of Passing\nBE (Information Technology)\n63.53\n\n\nGujarat\nUniversity\nCollege:\n Nirma Institute Of Technology, Ahmedabad, \nGujarat\nJune 2004\n12 (HSC)\n80.62\nGujarat\n Secondary Education Board,\nGandhinagar\nMarch 2000\n10 (SSC)\n\n81.71\nGujarat\n Secondary Education Board,\nGandhinagar\nMarch 1998\n\nArea of Interest:\n   \nOperating System, Computer Network, Computer Architecture\n\nHobbies:\nCricket, Chess, Badminton, \nReading\n, Playing computer games.\n\nThe details given above are correct to best of my knowledge.\n                                                                                        \nSign:','Persistent Systems Pvt. Ltd. Pune',9,NULL,'2007-10-15',NULL,'2007-10-15','2010-06-08 12:13:25','2010-06-08',10,NULL,NULL,NULL,NULL,9,'0',NULL),(5,'Srinivas',NULL,NULL,NULL,'srinscscscccuvas45@gmail.com','srinuvas45@gmail.com',NULL,'0','9884519388','0',NULL,'0','2010-02-27',NULL,NULL,'2010-06-08 12:13:25',2,'0',NULL,'200710/15/ATT8036.html','200710/15/DOC8043.doc','Resdex @ naukri.com\nsrinivas\nsrinuvas shastri nagar chennai Chennai - 600086 \nsrinscscscccuvas45@gmail.com\n\nTelephone: 9884519388\n(M)\n\nD.O.B\n - 06 Jul 1976 \nModified on\n - 25 Sep 2007 \nAnnual Salary\n - INR 6 Lac(s) 50 Thousand \nTotal Years of Experience\n - 5 Year(s) 0 Month(s) \nCurrent Location\n - Chennai \nPreferred Location\n - Anywhere in India \n5 yrs experence in java,j2ee technologies\n\nTEXT RESUME \n\nRESUME\nSRINIVAS\nE-mail:srinuvas45@gmail.com\nContact no: +91 9884519388\nObjective:\nInterested in pursuing a career in the information technology industry through challenging Jobs in web development and client/server technologies.\nProfessional Summary:\n· 5 years of IT experience in Development and Deployment of the various projects, applications in client/server architecture and web technologies.\n· Extensive application development experience on Internet, business application using JAVA, JDBC, Servlets, JSP, Oracle, STRUTS.\n· Main area of expertise on web server like Apache\n?s To\nmcat web server and Application Server like BEA\n?s WebLogic.\n· A versatile team player with good communication and interpersonal skills.\nProfessional Experience:\n· Currently working as a AssociateConsultant with Polaris Software Labs Pvt.Ltd, Chennai from June 2007 to tilldate.\n· worked as a Software Engineer with Accenture Bangalore from Oct\n?2005 to May 2007 on Contract Basis.\n· Worked as a Programmer with JasperItSolutions Hyderabad from Sep 2002 to June 2005.\n· Worked as a LabFaculty with Satya Technologies \nHyderabad\n From June 2001 to Aug 2002.\nEducational qualifications :\n· Bachelor of Engineering in Electrical & Electronics Engineering from \nAndhra\nUniversity\n during 1996-2001.\nCertifications:\n· Undergone extensive training in core java and advanced java at NetGSC from July 2000 to Feb 2001.\n· Completed diploma in information and systems management at APTECH from Feb 1997 to Dec 1998.\nTechnical skills:\nOperating Systems : Windows 98/2000\nLanguages : Java.\nDatabase : Oracle .\nWeb/Middleware Technologies : Servlets,Jsp,\nFrameWork : Struts\nIDE Tools : Eclipse, Intellij.\nWebServer : Apache TomcatServer.\nApplication Servers : Websphere Application Server,\nWeblogic Application Server,WSAD.\nProfessional experience:\nProject#1\nTitle : Account Receivable Management System (ARMS)\nEmployee : Polaris Software Lab Ltd.\nClient : \nCitibank\n\nIndia\n\nDuration : June\n?2007 to Till Date.\nEnvironmet :Struts, JSP, Servlets, Oracle, HTML, Windows98/2000, Eclipse, WeblogicApplicationServer\nTeam Size : 5\nSummary :\nARM is a receivable management system which is used by simplify the interaction between supplier and dealers through the help of an intermediatery, in this case Citibank. Whenever a supplier supplies some goods, the related invoices are uploaded into ARM after making the required checks. The dealer is then informed of the invoice details so that he can check these at his ends. Once the dealer gives his approval, then the invoice details are considered as final. Follow-ups are generated and sent to dealers at periodic intervals as per supplier requirement. Payments from dealers are processed through CPC, TBMS and the payment details are matched off against the specific invoices.\nResponsibilities:\n· Developed Online Feature for Inventory Module as per client\n?s requirement\ns and issue fixing process.\n· Coding and Unit testing of the individual module/feature.\n· Prepared Unit Test plans and Minor Development Documents for feature.\nPROJECT # 2\nTitle: BIOINFORMATICS.\nClient: Wyeth.\nDuration: Oct 2005 to May 2007.\nEnvironment: Java, Struts,Jsp, JDBC, Oracle, HTML, Windows 98/2000, Eclipse and WebLogic Application server.\nTeam Size: 6\nSummary\nThis project is an WebasedProject using java, struts,jsp and jsp. Analyze and modify different objects to create enhancement for BioInformatics, jsp for the front-end. Responsible for the development of Search Criteria of agency\n?s RequirementIt is the application of ComputerTechnology to the Management\n&Biological Information.computers are used together store analyze and regenerate Biological and genetic information which can then be applied to Drug discovery &Development. This project also includes development and extension of Business Objects. Depending on the specifications of the user and agents developed and extended various Servlets and corresponding JSP\n?s\nResponsibilities:\n· Maintenance & Enhancement of code.\n· Written Java docs for the Updated Functionality.\n· Written components according to the Requirement.\n· J unit testing.\n· Developed the various functionalities for the server side validations.\nProject #3\nTitle: Online Insurance.\nClient: Life insurance corporation.\nDuration: Oct\n?2004 to June 2005.\nEnvironment: Java, Struts,Jsp, JDBC, Oracle, HTML, Windows 98/2000, Eclipse and WebLogic Application server.\nTeam Size : 6\nSummary:\nThis project is an e-commerce project using java, struts, and jsp and java beans. Analyze and modify different objects to create enhancement for online insurance. Designing the beans, jsp for the front-end. Responsible for the development of Search Criteria of agency\n?s Online. This enables them to get the agents who belong with in their region. Also responsible for developments of servlets to update the send mail online to customer depending upon their requirement. This project also includes development \nand extension of Business Objects. Depending on the specifications of the user and agents developed and extended various Servlets and corresponding JSP\n?s\nResponsibilities:\n· Developing and extending the business objects and corresponding load files.\n· Registering Servlets on the WebLogic Application server.\n· Extending and developing Servlets that handle the database updates.\n· Developing Java server pages, Beans for displaying the front-end screens.\n· Developed the various functions for the client side validations using Javascript.\nProject #4\nTitle: Assessing Market Stream\nClient: FoodWorld , \nHyderabad\n\nDuration: Oct\n?2003 to Sep?2004\nEnvironment: Java, BDK, Servlets, Java Beans, JSP, HTML, Windows 98/2000, WebLogic Application server, Eclipse and Oracle.\nTeam Size : 6\nSummary\nWorking on an E-Commerce Project using Java, Servlets and Java Beans. Analyze and modify MarketStream 2.0 to create enhancements for vertical industry mark place. Assess marketstream 2.0 data model design, develop and test servlets, beans and jsp programs. Responsible for the development of \n?special contract role? between buyers and suppliers. This enables them to create contracts on the online system. Also responsible for the development of servlets to update the orders, spec\nial prices and backorders this project also includes development and extension of business objects. Depending on the specifications of the buyers and suppliers developed and extended various servlets and corresponding JSP\n?s. The development processes also \nincludes updating the front-endcomponents.\nResponsibilities:\n· Registered servlets and deployed on the Weblogic Application Server.\n· Extended and developed servlets that handle the database updates.\n· Implemented java server pages for displaying the front-end screens.\n· Developed the various functions for client side validation using Javascript.\nProject #5\nTitle: School Management System\nClient: C.R.R Jr college. Eluru.\nDuration: Sep\n?2002 to Aug?2003\nEnvironment: Java, servlets, jsp, JDBC, Oracle, HTML, Windows 98/2000, Eclipse and Apache Tomcat Server.\nTeam size 6\nSummary:\nThis System was developed for C.R.R Educational Society, Eluru.C.R.R Educational Acadamy was established in 1997 and conducts various intermediate courses under the Aegis of Board of Intermediate.\nResponsibilities:\n\n Student History, Admissons,Transfers,Cancellation and Course Completion.\n\n Staff Recruitment,Disbursement of Salaries,Advances and Recoveries.\n\n Receipts and Payments, Day Book Maintanance and Accounting.\n\n Hostel allotments and fee payments and Hostel Related Accounting.\nDeclaration:\nI here by confirm that the information given above is true to the best of my knowledge.\nDate:\nPlace: SRINIVAS',NULL,1,NULL,'2007-10-15',NULL,'2007-10-15','2010-06-08 12:13:25','2010-06-08',2,NULL,NULL,NULL,NULL,NULL,'0',NULL),(6,'Venkatarami  ',NULL,NULL,NULL,'venvkatdsdvaram.addvdlla@gmail.com',NULL,NULL,'0','9900942345','0',NULL,'0','2010-02-27',NULL,NULL,'2010-06-08 12:13:25',12,'0',NULL,'200710/15/ATT8035.html','200710/15/DOC8044.doc','Swamy csevrsec@gmail\n\nVenkataRami\n              \n                                \n\nvenvkatdsdvaram.addvdlla@gmail.com\n                               \n\n                                       \n                       \n                         \n+91-9900942345\n\nSummary\nHaving \n\n Years of IT experience in software development.\nHaving experience in J2EE Technologies (\nJDBC, \nServlets, JSP and EJB). \nHaving experience in \nStruts\n Framework.\nHave significant experience in \nOracle \nwith web applications.\nHaving experience with \nWeblogic\n and \nTomcat\n servers.\nHaving Experience\n\nin\n Design patterns\n\nKnowledge on \nHibernate\n\n\n\nExperience\nWorking as a Software Engineer in \nHewlett-packard\n\nBangalore\n from Nov 2006 to till date.\nWorked as a Software Engineer in \nJK Technosoft\n\nBangalore\n from Aug 2004 to Oct 2006.\n\n\nEducational Qualification\n\nB.Sc\n   \n(2001-2004)\n   \nfrom \nSri\nPrathibha\nCollege\n (A.N.U), Ongole.\n\nSkills\nLanguages\n                        \n   \n   \n\n\n           \nJava \nJ2EE Technologies\n              \n   \n  \n\n\n           \nJDBC, Struts and EJB, Design patterns\nWeb Technologies\n              \n   \n    \n\n           \nServlets, JSP \nDatabases\n                         \n   \n   \n\n           \nOracle9i\nApplication/Web Servers\n      \n   \n    \n\n           \nWeblogic8.0 and Tomcat5.0\nORM Tool\n                              \n\n   \n\n\n           \nHibernate\nConfiguration Management Tools \n\n\n          \nCVS\nIDE\n                                    \n\n  \n  \n  \n\n           \nEclipse, Jdeveloper\nTools\n                  \n                  \n\n\n\n\n\n\n            \nANT\n\n\n\nProject #1\nTitle\n             \n\n  \nDigital Media solution\n\nClient\n            \n\n   \nHP\nDuration\n        \n\n   \nNov 2006 to till date \nSoftware\n       \n\n   \nCore Java, Struts, EJB, Weblogic8.0\n                                             \nRole\n              \n\n   \nDeveloper\nDescription\n   \n\n   \nDigital Media Solution provides the necessary specialized tools and technologies, enabling content and service providers to capitalize on the transition of media content from the analog to digital worlds. The Digital Media Solution provides multiple services for building Media Applications. Applications may be built by orchestrating together a set of services provided by the System. The HP DMS System consists of the following key modules as -- Project Management, Syndication, Workflow Management, Security, Media Management, Tape Ingest Application Digital Media Solution streamlines every aspect of the digital media workflow, from ingestion or creation of new content, through editing, processing, storage, archiving and retrieval, as well as enabling existing digital content to be reformatted, repackaged and redistributed in new ways and over new distribution channels. Digital Media Solution is offered in application-specific editions that help simplify the automation and integration of multiple digital content applications and tools. \n\nResponsibilities:\n\n       \nDeveloped user interfaces using JSP.\n\n       \nDeveloped Action classes and form beans using Struts Framework.\n\n       \nCoded business logic using Session Beans.\n\n       \nDeveloped RoleActionDelegate,PermissionActionDelegete using Business Delegate design pattern\n\n       \nDeveloped\n\nDMSServiceLocator using ServiceLocator and singleton design pattern\n\nProject #2\nTitle\n                \n\n\nHospital Management Systems\nClient\n            \n\n\nJKT\nDuration\n        \n\n\nFeb 2006 to Oct 2006 \nSoftware\n       \n\n\nCore Java, Jsp, Servlets, Struts, Weblogic8.0\n                                             \nRole\n              \n\n\nDeveloper\nDescription\n   \n\n Is a generic application, which addresses all the major functional areas of hospitals. HMS provides the benefits of streamlined operations, enhanced administration control, improved response to patient care, cost control and improved profitability. It reduces patient?s waiting time by smooth flow of information and provides house keeping of medical records such as patient?s history, diagnostic details, and prescriptions ordered by doctors.\n It contains Patient Registration\n\nPatient \nAppointment, OPD Management,\n IP?Patient Management\n\nDiagnostics Management\n, Billing,\nHospital Information System,\n Blood Bank Services\n\n Pharmacy\n\n and System Administration\n\n\n\nResponsibilities:\n\n       \nDeveloped user interfaces using JSP.\n\n       \nDeveloped Action classes and form beans using Struts Framework.\n\n       \nDeveloped business logic.\nProject #3\nTitle\n          \n   \n\n\n   \nBankruptcy\nClient\n\n          \n\n\nIRA\n\nUS\nDuration\n        \n\n\nMay 2005 to Jan 2006\nSoftware\n       \n\n\nCore Java, Servelts, JSP\nRole\n              \n\n\nDeveloper\nDescription\n\n\nAtomized Banking is a comprehensive integrated application software solution, which has been developed to extend the facility of banking right into the consumer?s Desk. The System consists of two modules one with security i.e. the user has to login with a password before he can use the services of the bank and the other is without security available to all. The unsecured module consists of advertisement of bank?s products and services like Investment schemes, Loan schemes, Credit Card information, and Application forms. The secured module consists of Fund transfers, Balance Enquiries, Statement of Account.\n\nResponsibilities:\n\n       \nCoded User Interface using JSP and HTML.\n\n       \nCoded business logic using Servlets in the modules.\nProject #4\nTitle\n                \n\n\nGMTS \nClient\n            \n\n\nBits Infotech, \nLondon\nDuration\n        \n\n\nAug 2004 to Apr 2005 \nSoftware\n       \n\n\nCore Java, Servelts, JSP \nRole\n              \n\n\nDeveloper\nDescription\n    \n\n\nGMTS\n is a money transfer service provider with operations mainly in the \nEurope\n continent.\n\nGMTS helps its customer to transfer money or make payments using its Pay Point available around the Globe. GMTS franchises its activities to agencies, their agencies are called Agents and agents operate on behalf of GMTS. The project contains seven modules as Customer registration process, customer order making process, order processing, Fund Distributor, marketing survey, Agent process, security.\n The customer registration process will be tightly integrated with the order making process. The customer details has multiple components the first component is the basic customer details, identification information, money laundering documents, bank details, second component is the beneficiary details like basic details, bank details, identification details, money laundering documents, and the third component is the pay point details that are associated with customer beneficiary.\n   \n\n\nResponsibilities:\n\n       \nCoded User Interface using JSP and HTML.\n\n       \nCoded business logic using Servlets in the modules.',NULL,1,NULL,'2007-10-15',NULL,'2007-10-15','2010-06-08 12:13:25','2010-06-08',12,NULL,NULL,NULL,NULL,NULL,'0',NULL),(7,'Yatish',NULL,NULL,'Pune','yatishdvdsvsdvdvdkamat@gmail.com',NULL,NULL,'0','919822987913','0',NULL,'0','2008-02-12',10,34,'2010-06-08 12:13:25',2,'0',NULL,'200710/15/ATT8034.html','200710/15/DOC8045.doc','Resdex @ naukri.com\nYatish \nyatishdvdsvsdvdvdkamat@gmail.com\n\nTelephone: 919822987913\n(M)\n\nD.O.B\n - 27 Nov 1981 \nModified on\n - 25 Sep 2007 \nAnnual Salary\n - INR 5 Lac(s) 0 Thousand \nTotal Years of Experience\n - 2 Year(s) 3 Month(s) \nCurrent Location\n - Pune \nPreferred Location\n - Anywhere in India, Australia, United States \n2 years C++ experience. Looking for career in Windows/.NET development',NULL,1,NULL,'2007-10-15',NULL,'2007-10-15','2010-06-08 12:13:25','2010-06-08',2,NULL,NULL,NULL,NULL,NULL,'0',NULL),(8,'Shagil P',NULL,NULL,'Chennai','shcvcscagiscl_tsc@yahoo.com',NULL,'91 9940675225','0','9895472426','0',NULL,'0','2006-10-13',7,18,'2010-06-08 12:13:25',12,'0',NULL,'200710/15/ATT8033.html','200710/15/DOC8046.doc','Sajith Thovarayi\nSHAGIL P.\n                                                                                                \nB1, Harsha Block,\n                                                                     \nSarayu Falts,\n                                                                  \n\n\n    \n\nDasaradapuram, \n                                            \n                      \n\nSaligramam,\nMobile\n\n+91-9940675225\n\n                                                                     \nChennai \nEmail\n   \n\nshcvcscagiscl_tsc@yahoo.com\n                                                      \nIndia\n\n\n\nEXPERIENCE SUMMARY\n\n\n                    \nTotal 3+ years of experience in Software Industry.\n\n                    \n2+ Year\n experience in \ndevelopment on NMS software\n\n\n                    \nExtremely conversant with \nOOPS Concepts\n\n\n                    \nStrong in \nCORE JAVA, SERVLETS, RFT, SNMP and QoS\n\n\n                    \nSCJP/SCWCD\n Certified programmer.\n\nOBJECTIVE\n\nSeeking a position to utilize my skills\n and abilities in the Information Technology \nIndustry that offers security and professional growth while being resourceful, innovative and flexible.\nTECHNICAL SKILLS\n\nOperating System\n                  \n\nWindows 9x/NT/2000.\n\nProgramming Languages\n       \n: Java \n\n\nRDBMS\n                                 \n: Oracle\n\n\nMS Access.\n\nInternet Technologies\n            \n: JavaServlets\n, JSP, \nHTML\n, ASP, JavaScript, \nJDBC\n\n\nProtocols\n                                 \n\n\nSNMP.\n\nTesting tools\n                           \n\n\nIBM RFT.\n\nEDUCATION\n     \n\n       \nMCA \nwith \n72\n%.\nMarch 2004.\n      \nPeriyar\nUniversity\n, Tamil Nadu.\n\n\n      \nB.Sc. Mathematics\nApril 2000.\nSree\nNarayana\nCollege\n\nKannur\nUniversity\n, Kerala.\n\n\n      \nPre Degree\nMarch 1997.\nSree\nNarayana\nCollege\n\nCalicut\nUniversity\n, Kerala.\n\nEMPLOYMENT HISTORY\n\n\n      \nOrganization\n               \n              \n: Undisclosed\n            \nPosition\n                      \n               \n: Lead Engineer\n            \nDuration\n      \n      \n                         \n\n\nJune 2005\n to till date\n\n\n      \nOrganization\n               \n              \n: Transcom System, \nBangalore\n\n            \nPosition\n                      \n               \n: Software Engineer\n            \nDuration\n      \n      \n                         \n\n\nApril\n 2004 to May 2005\n\nCURRENT JOB PROFILE\n\n      \nCurrently working as a development engineer on QoS Application\n\n      \nCore team member in NMS development team.\n\n      \nContributing for new features and other enhancement activities\nPROJECT EXPERIENCE\n\nProject # 1\n               \n               \nProject\n                   \n\nQoS Application\n               \nOrganization\n            \n: undisclosed\n               \nDuration\n\n              \n: Jan 2006 to till date\n               \nTeam Size\n               \n: 10.\n\nDescription\n            \nThis application analyze traffic throughput by application or service class, and then leverage that information to configure QoS policies to differentiate traffic and to define the QoS functions to be applied to each type of traffic flow\n            \nThe product main functionality is to deploy and upload QoS configuration to the network devices. Also it will monitor the network flow.\n            \nI own Command Service module that includes Device discovery, Command generation for each device, deploy the Commands to the device and Upload the QoS Commands from device.\n            \nI was also contributing for training new hire to the team, Customer training and other team related activities.\n\nTechnologies used:\n Java, JSP, Servlet, EJB, \nAJAX\n, QoS and SNMP \n\n\nProject # 2\n               \n               \nProject\n                   \n\nNMS- Fault Management System\n               \nOrganization\n            \n: Undisclosed\n               \nDuration\n\n              \n: June 2005 to Dec 2005\n               \nTeam Size\n               \n: 6.\n\nDescription\n            \n\nHave experience on writing automation scripts using Java and SNMP.\n            \nAlso I was being contributed to test plan, test set up and other dev-test related activities.\n\nTechnologies used:\n Java and SNMP\n\nProject # 3\n               \n               \nProject\n                   \n\nONLINE BUSINESS SERVICE ENGINE\n               \nOrganization\n            \n: Transcom System, \nBangalore\n\n               \nDuration\n\n              \n: July 2004 to till Apr 2005\n               \nEnvironment\n            \n: J2EE platform, BEA Weblogic Server.\n               \nTeam Size\n               \n: 13.\n\nDescription\nMain Objective of this Application is to solve customer-billing problems efficiently so that the relationship between customer and organization grows.\n            \nIn this application customer goes through FAQs to get solution for his problems (or) he logins by entering his/her username and password and posts his/her problems online. Customer will get a problem Id through which he/she knows the status of the problem.\nProblems posted by Customers are solved by Customer Support Representatives (CSRs). Distribution Engine is responsible for distributing problems to CSRs in such a way that none the complaints are sent to CSRs twice. CSRs will have all the information to solve the problems and solves the problems based on certain constraints.\nTeam leaders go through the solved problems and provide marks based on the constraints. If the customer support representatives get more than a specified failure percentage the customer support representative will be taken out from the company.\nReport generation is done by Administrator and also responsible for providing access rights to customers and Team leaders (Q/A)\n\n\nProject #4\n\nProject\n           \n\nFTP NAVIGATOR\nOrganization\n     \n: Softex Digital, \nTrivandrum\n Technopark, Kerala.\nDuration\n           \n: From Dec 2003 to March 2004.\nEnvironment\n     \n: C#.NET.\n\nDescription\n                        \nThis System deals with transfer of Files and Folders through Internet. The User selects necessary Files/Folders and can do any FTP Operations. If any user wants to use the traditional System then the user should know all the FTP Commands. But this System uses a menu driven interface in which the User just has to select necessary operations.\n\nSummer Project\nProject\n           \n\nOnline chatting using rmi\nOrganization\n     \n: STG, Kannur, Kerala.\nDuration\n           \n: From Apr 2003 to June 2003.\nEnvironment\n     \n: Java.\n\n\n            \n\nPERSONAL DEATAILS\n\n          \nFather\'s name\n                      \n\n        \nM Balan.\n\n        \nDate of Birth\n                        \n\n       \n14 March 1980\n\n        \nSex\n                                       \n\n       \nMale\n\n        \nMarital Status\n                     \n  \n\n       \nSingle\n\n        \nNationality\n                        \n     \n\n       \nIndian\n\n        \nLanguage Known\n                 \n\n       \nEnglish, Tamil, Malayalam\n        \n        \nPermanent Address\n              \n\n       \n?Shyju Nivas?\n                                                     \n          \nKizhuthally,\n   \nP.O\n\nT Chovva,\n                                                            \n                                                \n               \nKannur Dt,\n                                                               \nKerala 670018.\n\n                                                            \n   \nPhone : 9895472426\n\n\n      \n                                                                                                          \n  \n                                               \nDECLARATION\n\nI hereby declare that all the information given above is true to best of my knowledge.\n\n                                                                                                                        \nSHAGIL T.\n\n                                         ','Undisclosed',1,NULL,'2007-10-15',NULL,'2007-10-15','2010-06-08 12:13:25','2010-06-08',12,NULL,NULL,NULL,NULL,NULL,'0',NULL),(9,'T sreedharan',NULL,NULL,'Chennai ','sescscnd2scsrsceedharan@yahoo.com',NULL,NULL,'0','91 9840068007','0',NULL,'0','2004-05-14',10,34,'2010-06-08 12:13:25',3,'0',NULL,'200710/15/ATT8028.html','200710/15/DOC15852.doc','Sreedharan\nSreedharan.T\n                                                                          \nNo 16, First Floor, \nFirst Street\n\n                                                                                                   \nEx-Service man Colony,\nEmail\n    \n: sescscnd2scsrsceedharan@yahoo.com\n                                    \nAdambakkam\n\nMobile\n   \n: (91) 9840068007\n                                                             \nChennai - 88\n\nSummary of Experience\n          \n\n           \n4+ \nyears of experience in \nJ2EE, Java, JDBC, EJB, JSP\n                        \n1+\n year of experience in Java Native Interface with Microsoft \n                        \nVC++ Compiler.\n                                                            \n                                                            \nOver all \n5+\n years of Total Experience in extensive IT Industry \nProficiency in J2EE, Java, JDBC, EJB, JSP, Struts and VC++.\n\nStrong object oriented principals and implementation. \n\n\nCareer Objective\n                     \n\n           \nTo be successful software professional by acquiring software\n\n                                                            \ndevelopment\n skills and challenging opportunities to combine\n       \n                                                            \nmultidisciplinary\n technical skills.\n\nEducation\n                                \n\n           \nMaster of Computer Applications\n with \nFirst class\n from \n                                                            \nThanthai\nHans\nRoever\nCollege\n\nBharathidasan\nUniversity\n\n                                                            \nTrichy, TamilNadu, (1998-2001)\n\nBachelor Degree in Physics\n with \nFirst class\n, H. H. The \nRajah?s\n\nCollege\n\nBharathidasan\nUniversity\n, Trichy, TamilNadu, \n(1995-1998)\n\nStrength\n                                   \n\n           \nSelf-motivated, team player\n                                                            \nStrong leadership and communication skills\n                                                            \nAnalytical thinker, very fast learner\n                                                            \nCan set, meet, and exceed goals\n\nTECHNICAL SKILLS \n\nProgramming Languages\n            \n\n           \nJava, C, C++ and VC++.\nOperating Systems\n                    \n\n           \nLinux, Solaris, Windows 2k, Windows 2000, \nVista\n\nVersion Control System\n              \n\n           \nVisual Source Safe 6.0\nDatabases\n                                 \n\n           \nOracle, \nMS Sql Server\nWeb/App Servers\n                       \n\n           \nApache Tomcat, Web Sphere5.1, WebLogic8.1, JBoss 4.0\nWeb Technology\n                        \n\n           \nJSP, Servlets, RMI, JMX, JDBC, EJB, Struts\nDatabase Framework\n                 \n\n           \nHibernate.\nJava Editors\n                               \n\n           \nEclipse, NetBeans, Edit Plus, Netterm (Linux / Solaris).\n\nEXPERIENCE HIGHLIGHTS \n            \n\n         \nWorking as a Project Lead in\n\neG\n Innovations \nPvt\n Ltd \nNungambakam, Chennai from April 2004.\n\n\n         \nWorked as a Software Engineer, in \nLS Technologies \nPvt\n Ltd\n., \nNandanam, Chennai from November 2001 to March 2004\n\n\n\n\n\n\n\nDETAILS OF PROJECT EXPERIENCE:\nProduct :\n\nIT Infrastructure monitoring solution\n\nSoftwares\n used\n                          \n\n\n          \nJava, JSP, Servlets, JMX, C++, VC++, Unixscripting,\n                    \n                \n    \n                    \nJavaScript, Sql Server, Oracle, Tomcat, IIS, Ant, XML.\n            \nClients :\nJP Morgan Chase, \nMediaRing\n, T-Mobile, \nAlverno\n Healthcare and etc.,\n\nThe \neG\n suite is a 100% web-based monitoring solution that offers integrated monitoring of all the infrastructure components (network, system, and application) that are involved in delivering a business service. The eG suite follows the traditional manager-agent architecture: while the eG manager controls what infrastructure elements are to be monitored and how frequently they are to be monitored, the eG agents are software components that perform the monitoring functions and report metrics in real-time to the management console. The eG manager takes care of storing the data reported by the agents, correlating between data from different agents to perform root-cause analysis. \neG\n manager is supported in Solaris, Linux and windows operating systems. \neG\n Agent is supported in \nSolaris, Linux, HP UX, AIX, windows \noperating systems.\n\nRoles and Responsibilities:\n\n\n         \nDeveloping tests for \neG\n Agent\n\n         \nReviewing code\n\n         \nFixing bugs for Various versions\n\n         \nIntegrating files into Product. \n\n         \nChecking files into VSS (Visual Source Safe) version controller.\n\n         \nPreparation of technical design specification (Architecture)\n\nVMWare\n Monitoring\nAmong the many virtualization solutions available, \nVMware?s\n Virtual Infrastructure solutions are one of the most popular. At the heart of this virtualization solution is the \nVMware\n ESX server.\n\nIt allows multiple operating systems and their applications \nvirtual machines that share physical resources. The operating system running on the ESX server is referred to as the \nvirtual host\n, and the individual operating systems hosted by the ESX server as \nguests/virtual machines\n\n\nRoles and Responsibilities:\n\n         \nCreating a framework for monitoring VM Guests.\n\n         \nReviewing code.\n\nMonitoring Solaris Zones\n            \nSolaris Zones is newly introduced in Solaris 10. It allows users to create multiple zones under global zones. Each zones running under global zone referred as separate Solaris box with own directory structure. It is mainly used for testing a product with new Solaris environment. \neG\n focused to monitor each zone without deploying agent on each zone.\n\nRoles and Responsibilities:\n\n         \nCreating a small framework for monitoring Zones.\n\n         \nReviewing code.\n\n\n\n\n\n\n\n\nIntegration Console \n\nThe \neG\n Integration Console allows users to extend the capabilities of the eG suite ? to add\n     \nnew component types (e.g., new network devices, custom applications, etc.) that are not supported out-of-the-box by the eG suite for monitoring. Using the Integration Console, administrators can also add new monitoring capabilities for existing component types. The Integration Console also allows the entire eG layer model for any of the currently supported component types to be modified/customized to meet the specific needs of customers. The \nIntegration Console \noption in the eG license has to be enabled for this component to function.\n\nRoles and Responsibilities:\n\n\n         \nReviewing code\n\n         \nCustomization and enhancement \n\nConfiguration Management\n            \n            \neG\n Configuration Management \nprovides the scalable approach to collecting configuration of servers and hardware across the enterprise IT infrastructure. It uses managed objects to collect information. \nThe object is only active when it is called upon by the server to manage a requested \ninformation .\n After the initial \"full\" collection, the remote object calculates and reports only changes back to the central database for all subsequent data collections. It also provides the facility to search configuration data under required criteria and \nIt\n triggers the configuration changes on specified duration. \n\nRoles and Responsibilities:\n\n\n         \nDevelopment and enhancement of web pages, Coding and quality checking \n\n         \nCode optimization \nDesktop Agent for \neG\n            \nSoftwares\n used\n                          \n\n           \nJava, \nServlets\n, Tomcat and \nWinpcap\n tool. \n            \nThe role of desktop agent is collecting the information from desktop machines. It can be installed only workstations to monitor client activities such that TCP Connection time, response time of the server. And it gives alert as Critical/Major/Minor on respective threshold. \neG\n Manager sends the mail and \nsms\n to the user who configured as administrator, at the time of corresponding alerts. It also gives the details of \nurl\n requested by the workstation machine. \n\nManager Redundancy \n\nIn the default deployment, the eG suite has a single central manager that receives performance metrics from the agents, detects anomalies, and sends email and SMS alerts to administrators regarding a probable problem condition. In this scenario, if for some reason the eG manager is rendered inaccessible, critical issues in the target infrastructure will go unnoticed and therefore, unattended. To ensure high availability of the eG monitoring solution, the eG suite offers a redundant manager option wherein a secondary manager can act as an active or passive standby for the primary manager. This capability, together with the ability to deploy redundant external agents in multiple locations, ensures that there is no single point of failure for the monitoring solution\n\nRoles and Responsibilities:\n\n         \nCode optimization\n\n         \nCustomization and enhancement \n\n\n\nEntry Level Test \nOrganizer(\nELTO)\n\nSoftwares used\n                          \n\n\n          \nJava, JSP, Servlets, Struts, \nJavaScript, Sqlserver Ant, XML\n\n          \n\nELTO\n is an Intranet based online test handling application for the Entry Level. Designed for any company particularly software company for conducting the first screening test in an online basis. An authorized person feeds the Questions into the data store. Test can be taken up by the candidate at any of the authorized centers of the company and result is generated immediately after the test is completed.\n\nRoles and Responsibilities:\n\n         \nDeveloper- Analysis, Coding & Maintenance.\n\nNetCafe Manager\n\nSoftwares used\n                          \n\n\n          \nJava, JSP, Servlets, \nJavaScript, Sql Server, Ant, XML\n\n       \n\nIt deals with managing the entire operation of an Internet browsing center. It works as an offline program that deals with the networking of all the systems in operation. One system will act as the server and the rest of the systems will work as client systems. The project operation is done using a very systematic approach and manually nothing takes place. It also includes the administration in which the collection details are noted and the accounts of all users are maintained.\n\nRoles and Responsibilities:\n\n         \nDeveloper- Coding & Maintenance.\n\n\n\n\n\nInternet Manager\n\nSoftwares\n used\n              \n\n           \nVC++ 6.0, VB 6.0, \nInternet Information Server,\n\nIt\n is one of the \nmodule\n in the project ?Institution Productivity?. It facilitates institutions to modern management rather than the traditional way of using paper documents. An exotic feature about ?Institution Productivity? is its ability to bring the entire control of institutions to the desktop of the Vice Chancellor/Chairman/Principal/ other managerial heads thereby assisting the management to take decisions faster than ever before. The major role of the Internet Manager is to upload institution?s data to \nwebserver\n in appropriate time, so that Parents can view the status (mark, fees, leave etc.,) of student in a particular institution. The process of uploading is on either manual or automatic. It has also the provision to send mail, \nsms\n to parents, students or management.\n\nRoles and Responsibilities:\n\n         \nDeveloper- Coding & Maintenance.\n\n\n\n\n\n\n\n\n\n\n\nExponential Key Exchange\n\nSoftwares\n used\n              \n\n           \nVC++ 6.0\n\nThe main idea of this project is to propose new security mechanisms and protocols that are computationally efficient and minimize the consumption of memory and band with. The main advantage of the exponential exchange methods is that they use only a small password for authentication and key establishment over an insecure network. The three methods that can be used for exponential key exchange methods are: SPEKE (Simple Password EKE), DHEKE (\nDiffie-Hellman\n EKE) and ECEKE (Elliptic Curve EKE). Each method is unique in its two \nway\n, but the concept remains the same. Since it\'s the same key, which has to be used for a longer period of time, there is a scope for hackers to crack the code. In this new method the EKE, there is no key generated before hand. Before every transaction a new key is DERIVED by both users and then used.\n\nRoles and Responsibilities:\n\n         \nDeveloper- Coding & Maintenance.\n\n\n\nPersonal Details:\n\n            \nDate \nof\n\nBirth\n                             \n\n           \n04-06-1978\n\n            \nFather?s Name\n                           \n\n           \nR. Subramanian.\n            \nSex\n                                          \n\n           \nMale.\n            \nMarital Status\n                            \n\n           \nSingle.\n            \nLanguages Known\n                      \n\n           \nEnglish, Tamil.\n            \nPermanent Address\n                   \n\n           \nParamanagar\n\n                                                                                        \n                                    \nVadakadu\n - 622304,\n                                                                        \nPudukkottai\n District,\n                                                                        \nTamilNadu\n\nIndia\n\n            \nPassport No.\n                             \n\n           \nE2342288\n\n\n\n\n\nYours truly,\n                                                                                                                        \n             \n\n   \n                                                                                                                     \n                                                                                                      \nS. SREEDHARAN','eG Innovations Pvt Ltd ',1,NULL,'2007-10-15',NULL,'2007-10-15','2010-06-08 12:13:25','2010-06-08',3,NULL,NULL,NULL,NULL,NULL,'0',NULL),(10,'Shaik Kareemulla',NULL,NULL,NULL,'karecsccemasccroshan@gmail.com',NULL,NULL,'0','9949804289','0',NULL,'0','2008-04-29',NULL,NULL,'2010-06-08 12:13:25',2,'0',NULL,'200710/15/ATT8027.html','200710/15/DOC15853.doc','Resdex @ naukri.com\nshaik kareemulla\nkarecsccemasccroshan@gmail.com\n\nTelescphone: 9949804289\n(M)\n\nD.O.B\n - Not Specified \nModified on\n - 25 Sep 2007 \nAnnual Salary\n - INR 3 Lac(s) 20 Thousand \nTotal Years of Experience\n - 2 Year(s) 0 Month(s) \nCurrent Location\n - Hyderabad \nB.Tech with 2 years of experience as Application programmer in java',NULL,1,NULL,'2007-10-15',NULL,'2007-10-15','2010-06-08 12:13:25','2010-06-08',2,NULL,NULL,NULL,NULL,NULL,'0',NULL),(11,'Suprakash K',NULL,NULL,'Banglore','suprakscscashscsackhuntia@yahoo.com',NULL,'0000000000','0',NULL,'0',NULL,'0','2007-04-14',7,18,'2010-06-08 12:13:25',2,'0',NULL,'200710/15/ATT8025.html','200710/15/DOC15854.doc','Resdex @ naukri.com\nSuprakash K\nBangalore - 560068 \nsuprakscscashscsackhuntia@yahoo.com\n\nTelephone: 0000000000\n(M)\n\nD.O.B\n - 26 Dec 1974 \nModified on\n - 25 Sep 2007 \nAnnual Salary\n - INR 4 Lac(s) 0 Thousand \nTotal Years of Experience\n - 3 Year(s) 8 Month(s) \nCurrent Location\n\nBangalore\n\nPreferred Location\n - Anywhere in \nIndia\n\nBangalore\nCore Java, Jsp, Servlets, Struts, HTML, Javascript',NULL,1,NULL,'2007-10-15',NULL,'2007-10-15','2010-06-08 12:13:25','2010-06-08',2,NULL,NULL,NULL,NULL,NULL,'0',NULL),(12,'J sudhakar',NULL,NULL,'Chennai','sudhsdcvsdacsdcfakar_it2003@yahoo.co.in','sudhakar_it2003@yahoo.co.in',NULL,'0','9884844209','0',NULL,'0','2007-06-14',7,19,'2010-06-08 12:13:25',2,'0',NULL,'200710/15/ATT8024.html','200710/15/DOC15855.doc','Resdex @ naukri.com\nsudhakar\nNo:4B,F1 First Floor, Fernentoo Street, Radha Nagar,Cronpett, Chennai-44. Chennai - 6000044 \nsudhsdcvsdacsdcfakar_it2003@yahoo.co.in\n\nTelephone: 098ssd84844209\n(M)\n\nD.O.B\n - 03 Jun 1983 \nModified on\n - 25 Sep 2007 \nAnnual Salary\n - INR 2 Lac(s) 0 Thousand \nTotal Years of Experience\n - 2 Year(s) 7 Month(s) \nCurrent Location\n - Chennai \nPreferred Location\n - Anywhere in India \n2+ Years-JAVA/J2EE-BE(IT)\n\nTEXT RESUME \n\nJ. SUDHAKAR\nsudhakar_it2003@yahoo.co.in No:4B, F1 First Floor,\nMobile: 9884844209 Fernentoo Street, Radha Nagar,\nCrompett, Chennai-44.\nSummary:\nHaving 2+ years of experience involving in developing Enterprise Applications using JAVA and J2EE.\nExcellent Knowledge in Java, JSP, Servlet and JDBC.\nExcellent commitment, dedication and planning towards goal oriented tasks.\nIndustry Experience:\nWorking as Promise kept business Solutions from Dec \n?04 to till date.\nScholastic Profile:\nB.E., in Information Technology (2000-2004).\n\n A.V.C College of Engineering,\n\n Mannampandal, Tamil Nadu, INDIA.\n\n Affiliated to Bharathidasan University.\n\n Attained an aggregate of 71.45 %.\nHigher Secondary (1999-2000).\n\n T.N.Higher Secondary School,\n\n Porayar, Nagpatinam, Tamil Nadu, INDIA.\n\n Attained an aggregate of 84.9%.\nSecondary School (1997-1998).\n\n T.N.Higher Secondary School,\n\n Porayar, Nagapatinam, Tamil Nadu, INDIA.\n\n Attained an aggregate of 81.8%.\nTechnical Skills:\nDescription Software Tools/Technologies\nLanguages : Java\n\n Web Technologies : HTML, JavaScript\n\n Java Technologies : JDBC, JSP, Servlet\nDatabases : Oracle, SQL\nWeb Servers : Apache Web Server 5.5.3, Web Logic 8.1(App Server)\nExposure to : EJB, XML\n1. Gaffe Refinement System\nClient : Smart Systems Pvt Ltd.\nRole : Team Member(6)\nDescription:\nThis software provides a two-fold view. One view is for the users of the local intranet to lodge the various complaints/ suggestions that have regarding the intranet facilities. The other view is that of the network operations group who view the complaints and respond to the complaints accordingly. The software was designed and developed in J2EE with oracle, as the back end and it as launched on Web Logic due to voluminous amount of data to be handled by the software.\nEnvironment:\nJDBC, JSP, Oracle 8.0.5 on Windows 2000.\nResponsibilities:\n\n Developed web pages using JSP and HTML to provide the user interface for the application.\n\n Involved in coding of Action.\n\n Database programming was done using JDBC.\n2. Project Tracking System\nClient : C Informatics (India) pvt. Ltd.\nRole : Team Member(5)\nDescription:\nPTS aims to tracking the status of the projects. The application maintains the employee details of the organization. The timesheet is used to enter the hours worked per day by each employee with the type of work done and other details for each project. PTS provides that clients with a transparent and dynamic interface to track the status of their projects. Reports are generated based on the timesheet entries.\nResponsibilities:\n¬¬¬¬¬¬¬¬¬¬¬¬¬¬¬\n\n Designed User Interface for web pages using JSP.\n\n Involved in coding of Actions\n\n Involved in Unit Testing.\nEnvironment:\nJSP, JDBC, Oracle 8.1, Servlet, Javascript.\n3. GM AND MORE Online Portal\nDescription:\nThis project is developed for an US based Client, GM and More, Medina. The main scope of the project is to place the orders and view products manufacturing status online. After fifteen days of the ETA, older data are backup for Future reference. This future is automatically done as per the date Calculations.\nThe industries such as Textiles, Automobiles can also use this Project by making modification based on their needs. Future enhancement includes language customization and WAP Technologies.\nResponsibilities:\n\n Server side development for the application which included coding Java Servlets.\n\n Presentation layer development using JSP and HTML.\n\n Involved in Unit testing of the modules.\nEnvironment:\nJava, JSP, JavaScript, Servlets, SQL Server 7.0, Web Logic Server 8.1, Windows XP.\nPersonal Profile :\nFather\n?s Name\n : Mr. V.Jayaraman\nDate of Birth : 03rd Jun 1983\nPermanent Address : Thillainayagapuram,\nM.odaiyur Post,\nK.M.Koil (T.K),\nCuddalore (dist.)-608303\nLanguages Known : English, Tamil\nI hereby declare that the information furnished above is true to the best of my knowledge and belief.\n(J. Sudhakar)','Promise kept business Solutions ',1,NULL,'2007-10-15',NULL,'2007-10-15','2010-06-08 12:13:25','2010-06-08',2,NULL,NULL,NULL,NULL,NULL,'0',NULL),(13,'Vinod Jacob',NULL,NULL,NULL,'vidgn_gdggddgmj@rediffmail.com',NULL,'0474 2562001','0','919886936705','0',NULL,'0','2007-04-30',NULL,NULL,'2010-06-08 12:13:25',3,'0',NULL,'200710/15/ATT8020.html','200710/15/DOC15856.doc','VINOD\nVINOD JACOB\n\nC/o S.Haridas,\nNo.49, 2\nnd\nMain\n, 4th cross, \n4th cross, Balaji Nagar,\n                     \n                                                                    \nvidgn_gdggddgmj@rediffmail.com\n     \nD.R.C Post\n    \n                                                                                                   \nPhNo.919886936705\n    \nBangalore-560 029\n                                                                      \n\nCAREER OBJECTIVE\n\nA Commitment to Professionalism and Excellence. To be Innovative and Progressive in service. To keep the client?s need as core concern. \"Being ahead, at every step\".\n\nEMPLOYEMENT DETAILS\n\nCurrently working as Software Engineer in \nSonata Software Ltd., a SEI CMM Level 5 MNC\n, Bangalore from June 2007 to till date through Inspire consultancy Services.\n\nWorked as Software developer in DynPro India Pvt. Ltd., \nBangalore\n from Oct 2004 to June 2007.\n\nTECHNICAL EXPOSURE - SUMMARY\n\n\n        \n3 years\nof experience in the field of web development using Java, JSP, Adobe Flex 2.0\n\n        \n16 months\nof experience in Web Development using Adobe Flex 2.0 and Action Script.\n\n        \nExperience in Maintenance, Copying, back up and restored databases in SQL SERVER, MS ACCESS, MySQL.\n\n        \nUndergone corporate \ntraining\n in SAP XI.\n\nEDUCATIONAL QUALIFICATIONS\n\n\n2005\n   \nMCA (\nDOEACC B-level)\n\n(DOEACC Society, \nNew Delhi\n\n  \n\n\n` Grade (55%-64%)\n\n\n2002\n    \nAdvanced PG diploma in CS\n\nDOEACC A- level)\n\n              \n\n\n` Grade (55%-64%)\n             \n\n2000\n   \nB.Sc. in zoology\n   \n\nSub: Chemistry and Botany\n\n                       \n70 %\n                                                                                                                                                                                                                \n                \n                                     \nKerala\nUniversity\n                           \n\n1997\n   \nClass\n   \n12\n              \n(Kerala board of public examination)\n      \n63 %\n\n1995\n   \nClass\n   \n10\n              \n(ICSE, \nNew Delhi\n\n                                   \n59 %\n\n\nTECHNICAL SKILLS\n\nProgramming Languages \n   \n\n           \nC, C++, Java\nDatabases\n                              \n\n           \nMS Access, SQL SERVER\nPlatforms\n                                \n\n           \nWindows NT/2000\nWeb Technologies\n                \n\n           \nJSP, JDBC, HTML, Flex 2.0\nScripting Languages\n            \n            \n\n           \nJava Script, Action Script\nWeb Servers\n                           \n\n   \n        \nIIS, Apache Tomcat server\nSAP XI\n                                    \n\n   \n        \nIR, ID, IS, RWB, Adapters\n\n\nWORK EXPERIENCE\n\nProject Name\n                        \n:- CURL Showcase\nPosition\n                      \n:- Developer \nClient\n                          \n:- CURL Corporation, \nUSA\n\nTeam Size\n                 \n:- 5\nTechnology used\n      \n:- Adobe Flex 2.0,Action Script, REST Webservice\nApplication Server\n     \n:- IIS\nBackend\n                     \n:- SQL SERVER\nDuration\n\n                   \n:- June 2007 ? Till date\n\nDescription:\nThis is a research project. The objective of this project is to evaluate three prevalent technologies, CURL, Flex and ASP.NET AJAX (Formerly known as ATLAS framework), to build RIA for Enterprises through actual development and deployment of a typical transactional read/write Order Entry application\n. Order Entry applications are widely deployed as client-server system in numerous enterprises and hence the results of this study will be of relevance to enterprises embarking on RIA initiatives.\n\n                                          \nMy role in this project was designing building the user interface, manual testing and implementation of the flex part.\n\n\n\nProject Name\n                        \n:-\n\nEssential Feed\nPosition\n                      \n:-\n\nProgrammer \nClient\n                          \n:-\n\nDynPro Inc, \nUSA\n\nTeam Size \n                 \n:- 5\nTechnology used\n      \n:-\n\nJava, JSP, Adobe Flex 2.0 \nApplication Server\n     \n:-\n\nApache Tomcat server\nBackend\n                     \n:- MySQL\nDuration \n\n                   \n:- May 2006 ? June 2007\n\nDescription:\nEssential Feed is an online portal where subscribers can shop for multimedia files, including, but not limited to: audio, video, photos, and blogs. The website is created using Adobe Flex 2.0, and is designed to be platform independent. When a user subscribes to a podcast, it is automatically delivered to his computer. The project also connects to an online payment system that is provided by Chase PaymentTech. The main benefit of this application is that, the GUI is developed using Flex 2.0, which is a Rich Internet Application, and thus making the Interface more users friendly and attractive in appearance.\n                              \nMy role in this project was designing and building the user interface in Flex 2.0 using Flexbuilder 2.0 and coding for the user registration and the login module in JSP.\n\n\n\nProject Name\n                        \n:-\n\nDashBoard\nPosition\n                      \n:-\n\nProgrammer \nClient\n                          \n:-\n\nDynPro Inc, \nUSA\n\nTeam Size \n                 \n:- 3\nTechnology used\n      \n:-\n\nSAP Netweaver, Java, JSP \nApplication Server\n     \n:-\n\nSAP Web Application server\nDuration \n\n                   \n:- 4 months\n\nDescription:\nThis is a application for Customer/Vendor collaboration and CEO/Top-Executive Dashboard.\nIn this company\'s Customers/Vendors can browse their Sales Orders/ Purchase Orders and CEO/Top executives can view dashboards with Graphs and data thru web browser.\n\n                       \nWhen a Customer/Vendor log-in to this web-application, he will be given a list of SOs/POs pertaining to him, he can choose a particular SO/PO to see the details and also enter his Quotes which will directly update SAP data. Here Customer/Vendor is not logging-into SAP but only to the web application for authentication. It also facilitates for CEO/Top executives to view dashboards with Graphs and data on Monthly Sales, Bank Balances, Receivables, and Payables.\n           \n             \nMy role in this project was designing and building the user interface in JSP and coding for Customers/Vendors login and display of SOs/Pos using SAP Netweaver Developer studio.\n\n\n\nProject Name\n                        \n:- FirmCover\nPosition\n                      \n:- Programmer \nClient\n                          \n:- \nBenchmark Technologies International, Inc., NJ\nTeam Size\n                 \n:- 6\nTechnology used\n      \n:- Java, JSP\nApplication Server\n     \n:- Apache Tomcat server\nBackend\n                     \n:- MySQL\nDuration \n\n                   \n:- 6 months\n\nDescription:\nThis was maintenance for the existing project. FirmCover is a web-based solution for distributing your procedures documentation to staff and ensuring that documentation can be easily and quickly updated in a secure environment. FirmCover is a dynamic infrastructure for centrally managing all of your group?s or firm?s policies and procedures documentation. Centralization of your documentation eliminates redundancies and simplifies updates. FirmCover allows you to easily link your firm?s policies, regulations and other procedures documentation.\n        \n                  \n                      \nMy role in this project was working on the login modules to provide more security to different level of users. It was basically a maintenance work for a developed product based on the requirements from the clients.\n\nProject Name\n                        \n:- Time Sheet Management System\nPosition\n                      \n:- Programmer \nClient\n                          \n:- DynPro Inc, \nUSA\n\nTeam Size\n                 \n:- 5.\nTechnology used\n      \n:- Java, JSP\nApplication Server\n     \n:- Apache Tomcat server\nBackend\n                     \n:- SQL SERVER\nDuration \n\n                   \n:- 6 months\n\nDescription:\nThe Time Management System is primarily a management tools for the employee working through the recruiting wing of DynPro. It is the mechanism for the collection of all employees and contractors? weekly time records.\n\nThe time record employees enter into the TMS, feeds the payroll system so payroll can be processed in a faster and accurate fashion. It creates supporting documentation for the billing department so the company can be paid in a timely and accurate manner.\n\nThe information you enter through the system and the hard copy of the time sheet is used as back up to invoices sent to the companies clients. It manages the Paid Time Off (PTO) records for company employees who are eligible for holiday and PTO benefits. It allows you to be able to make changes to your personal and work contact information on-line.\n           \nMy role in this project was designing and coding using JSP.\n\n\nPERSONAL SKILLS\n\nExcellent problem solving skills and a self-starter.\nTakes initiative and works independently or as part of a group.\nWell organized and easily meets deadlines.\n             \nPERSONAL DETAILS\n\nDate of Birth\n                           \n\n     \n6 ?1-1979\nPassport No\n                             \n\n     \nF2286262\nSex\n    \n              \n         \n   \n            \n\n     \nMale\nMarital Status\n   \n                       \n\n\n     \nSingle\nNationality\n                    \n            \n\n     \nIndian\nLanguages known \n        \n            \n\n     \nEnglish, Hindi, Malayalam, Tamil\n\nPermanent Address\n                 \n\n     \nMadathevila house,\n                                                      \nAlummoodu Po\n        \n                                              \nMukhathala\n                                                      \nKollam\n                                                      \nKerala ? 691577\n                                                      \nIndia\n       \n                                               \nPhone No. 0474-2562001\nReferences:\n                            \n      \nCan be provided on request.\n\n\nDECLARATION\n\n    \nI do hereby declare that the above information furnished by me is true to the best of\n                                  \n       \nmy knowledge.\n              \n                                                 \n                                                                                      \n\n\n\nVINOD.M.JACOB\n                                                                                 \n                                             ',NULL,1,NULL,'2007-10-15',NULL,'2007-10-15','2010-06-08 12:13:25','2010-06-08',3,NULL,NULL,NULL,NULL,NULL,'0',NULL),(14,'Sudheer B',NULL,NULL,NULL,'csudhsccceer2k1@hotmail.com',NULL,'0000 00000','0',NULL,'0',NULL,'0','2005-04-29',NULL,NULL,'2010-06-08 12:13:25',2,'0',NULL,'200710/15/ATT8018.html','200710/15/DOC15857.doc','Resdex @ naukri.com\nSudheer B\nJP Nagar 6th Phase Bangalore - 81 \ncsudhsccceer2k1@hotmail.com\n\nTelephone: 0000000\n(M)\n 00 0000 00000\n(R)\n\nD.O.B\n - 12 Aug 1979 \nModified on\n - 25 Sep 2007 \nAnnual Salary\n - INR 6 Lac(s) 50 Thousand \nTotal Years of Experience\n - 5 Year(s) 1 Month(s) \nCurrent Location\n - Bangalore \nPreferred Location\n - Bangalore, Hyderabad \nLooking for onsite ,6years solid exp in java/j2ee',NULL,1,NULL,'2007-10-15',NULL,'2007-10-15','2010-06-08 12:13:25','2010-06-08',2,NULL,NULL,NULL,NULL,NULL,'0',NULL),(15,'Jyoti.S',NULL,NULL,NULL,'stylsvsvistsvjyoti@gmail.com','stylistjyoti@gmail.com',NULL,'0','9986986037','0',NULL,'0','2009-10-28',NULL,NULL,'2010-06-08 12:13:25',2,'0',NULL,'200710/15/ATT8037.html','200710/15/DOC15858.doc','Resdex @ naukri.com\nJyoti.S\nBTM BTM Bangalore,Karnataka - 560054 \nstylsvsvistsvjyoti@gmail.com\n\nTelephone: 9986986037\n(M)\n 9986986037\n(R)\n\nD.O.B\n - 06 Jul 1981 \nModified on\n - 25 Sep 2007 \nAnnual Salary\n - INR 4 Lac(s) 10 Thousand \nTotal Years of Experience\n - 3 Year(s) 1 Month(s) \nCurrent Location\n - Bangalore \nPreferred Location\n - Anywhere in India \nB.E in Computer Science&engg and having 3.5years Experience of JAVA/J2EE, EJB, Hibernet, STRUTS, Design patern\n\nTEXT RESUME \n\nJyoti\nSoftware Engineer, at Honeywell, BANGALORE\nE-mail: - stylistjyoti@gmail.com\nstylist_jyoti@rediffmail.com Sun Certified!!(SCJP)\n\n?¨No-\n 9986986037\nObjective: -\nTo be associated with a progressive organization which poses a challenging and innovative career making the best of my knowledge and thus giving me scope to update my knowledge and skills.\nB.E in Computer Science & Engg from B.I.E.T, \nBPUT-\nTech\nUniversity\nWorking as SE Currently at Honeywell. And Having Total 3.1 years EXP in java/j2ee\nWorking as SE in previous at SAICUS from April-04 to Dec-05\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\nSoftware Skill Set\nOperating System Window 2000/XP, Window NT\nLanguage JAVA/J2EE\nDatabase Oracle9i, SQL Server 2005\nEnterprise Solution JAVA/J2EE (Core java, Applet, AWT, Swing,) Beans,\nJDBC-ODBC, Servlets, JSP, CORBA, EJB, RMI,) Java\nMail API, JMS, Java RMI-IIOP and JNDI\nWeb Services SOAP (Header, Body, Fault), UDDI, WSDL, HTTP\nWeb language HTML, XML, XSLT, DHTML\nWeb/Application Server BEA Web logic-8.1, Apache Tomcat- 5.1, Jboss- 3.0 Java\nWeb server\nDesign Patten MVC, Singleton, FaÃ§ade, Abstract Factory,\nMethodology (Design) UML Tools (Rational Rose), SOA, OOAD, DAO\nJ2EE web application Struts (Stack MVC, Struts framework, Tag, Tiles)\nTools Eclipse- 3.1 My Eclipse 4.0, GEL, Wing Editor- 1.02, Jpad\nPro3.1, JPAD â\n??3.0, JBuilder 4.0, Monitor weblogic\nCVS client- Tortoise\nConfiguration Builds â\n??Ant 1.5\nControl -------- Oracles Client, MySQL Client- Toad, MySql Front\nEditor-Text Pad, Edit plus\nWork profile\nProject 1: -\nProject Name â\n??: Alliance Federal Credit Union\nClient: FEDERAL RESERVE BANK of NEW YORK. (US)\nTechnologies JSP, Java Beans, Java Script, ORACLE 9i, BEAWeb Logic 8.1,\nTeam Size 12\nDuration Feb- 07- to till\nRole & Responsibility Developing various modules and coding of various Design of Arctiture. Like -\n1. Admin Login, 2.User Login, 3. Banking Research, 4.Regional Outlets, 5.About the FED, 6.Personal banking, 7.Online Bill Payment, 8.Commercial login link. Etc.\nDescription Online Banking can help you to manage saving and checking account, apply for a loan and pay bill quickly and easily. It is a service provider by many banks, thrifts, and credit union that allow you to conduct banking transaction over the internet using a personal computer, mobile telephone. You may able to Access account round the clock even on weekends 2 see balance on line and find out whether checks or deposits have cleared.3 Transfer fund between accounts 4.Download information directly into personal financial software 5. Receive and pay bill online.\nGeneric Keywords-: Developing the Various types of Coding in JAVA/J2EE, by using BEAWeb Logic 8.1\nAnd developing good Components for Business logic & also interaction with UI & Data layer.\nSpecific Technology Keywords-: HTML, JavaScript, JSP, Java Bean, ORACLE 9i, Web Application\nFunctional component of the project-:\n1. Design With the above constraints in mind, we have designed an interface for the pages that is consisting of three different components, namely:\n2. Header contains information about the bank and like.\n3. Navigation panel has all the options available to the user. At any point of time, any of these options can be selected and used. All these options are hyperlinks and connect to different JSP files used.\n4. Main working panel is the area on the screen that is used by the application to allow user to interact with it. There are some pages where some relative actions must be taken. These actions are denoted as buttons so that it stands-out from the hyperlinks and are easy to use\nStep to start off the project-:\n1. Developing specifications and procedures for data preparation\n2. Steps necessary to put data into a usable form for processing.\n3. Data entry, the activity of putting data into the computer processing.\nObjectives of design\n1. Five objectives of design input focus on\n2. Controlling the amount of input required\n3. Avoid delay\n4. Avoiding errors in data\n5. Avoiding extra steps.\n6. Keeping the process simple\nProject 2: -\nProject Name -Development of a web-based Recruitment Process System for the HR\nGroup for a company.\nClient: VapTech Inc (USA)\nTechnologies STRUTS, ORACLE 8i, GUI, Web Services, singleton pattern,\nTeam Size 12\nDuration July- 06- to- Jan-07\nRole & Responsibility Developing various modules and coding of various Design of Arctiture. Like\n1. Make a database of Departments- Which includes some dummy departments and one â\n??HRDâ?? department. Decide on the various details of the people that would be stored i\nn the database (like employee/number, name, email-id, department, system-login, password in cryptic form, etc)\n2. Assign a mail-admin - who will create mail-ids for the people in the intranet of your lab or in the Internet. These mail-ids will be used for sending automatic notifications and reports. The mail-admin will also take care of assigning the logins to the users of the Recruitment system.\nDescription This project is aimed at developing a web-based and central Recruitment Process System for the HR Group for a company. Some features of this system will be creating vacancies, storing Applicants data, Interview process initiation, Scheduling Interviews, Storing Interview results for the applicant and finally Hiring of the applicant. Reports may be required to be generated for the use of HR group.\nGeneric Technology keywords: Database, JAVA/J2EE Programming by using IDE- Eclipse 3.1, MyEclipse4.1 And using by the Application Server /Server like JBOSS, Apache Tomcat.\nSpecific Technology keywords: Oracle8i, Web Technology (Java, J2EE, STRUTS, Web Based/GUI, UML)\nProject type keywords: Analysis, Design in types of Components and Implementation\nFunctional component of the project-:\nThere are HR group who will create vacancies, create applicants (persons applying for a vacancy), initiate interviews and close vacancy. There are interviewers who will be intimated about the interview schedule and finally enters the result.\nUsing can do the project implementation:\nImplementation of the front-end of the system- Implementation of the main screen giving the login, screen that follows the login giving various options, screens for each of the options\nSteps to start off the project-:\n1. Assign a mail-admin who will create mail-ids for the people in the intranet of your lab or in the Internet. These mail-ids will be used for sending automatic notifications and reports. The mail-admin will also take care of assigning the logins to the users of the Recruitment system.\nThis should display the Applicant Number and Name.\nThis should display the Vacancy Number and Title\nDisplay the date on this the Applicant is attached to the vacancy\nStatus of the Applicant/Vacancy â\n?? Interview Scheduled/Selected/Rejected/Not Required\n2. As soon as all the number of job openings is filled, the vacancy status should change to â\n??Closeâ?? by default.\n3. HR group should not be able to attach an applicant to vacancy if the status of the Vacancy is â\n??Close/Suspendedâ??.\n4. Once closed, a vacancy cannot be reopened or suspended in any case.\n5. If Open, the status of the vacancy can be changed to â\n??Closeâ?? or â??Suspendedâ?? by the HR.\n6. If â\n??Suspendedâ??, the HR can change the status of the vacancy to â??Closeâ?? or â??openâ??.\n7. Once the status of the Applicant-Vacancy becomes â\n??Sele\nctedâ\n??, the status of the Applicant should change by default to â??Hiredâ??.\nProject 3: -\nProject Name-: Development of a Lost Articles and Letters Reconciliation System\nClient: SPHERION (US-Texas-San Antonio)\nTechnologies\nJACOB, EJB, XML, UML, Oracle, OOAD, SOA, FaÃ§ade, Factory,\nTeam Size 9\nDuration Dec-05-June-06\nRole & Responsibility Developing various modules and coding of various JACOB, EJB, XML and Action as per the clientâ\n??s requirement. And also good Expertise in J2EE Application.\nModules 1. User and Group Master, 2.Lost Articles Master Complaint 3.Reconciliation, 4. Printing Module, 5. Numbers are seen, 6.Help\nDescription A Post Office wants to improve its efficiency by delivering the lost letters and lost articles (which are sent in parcels) in a short period of time. Currently it takes about 3 months for a lost letter or a lost article to reach the correct destination. A machine reads addresses on letters. The ones, which could not be read by machine, are sorted by human intervention. Even after this, the address is not readable, it becomes a lost letter. Articles that fall out of the parcel become lost articles. When the sender/receiver calls up or contacts the post office for their letter/article, a manual note is made and then this note is sent to the warehouse where lost articles and lost letters are kept. The reconciliation process of finding the lost letter/article is manual and sometimes-wrong letter/article(s) is sent.\nGeneric Keywords-: Various types of Coding in JAVA/J2EE, by using BEAWeb Logic 8.1\nAnd developing good Components for Business logic & also interaction with UI & Data layer.\nSpecific Technology Keywords-: JACOB, EJB, XML, UML, SQL, OOAD, SOA, Facade\nFunctional component of the project-:\nFollowing is a list of functionality of the system.\nUser will start with the login page in which username and password are entered. This screen should also provide a functionality to change the password. To change the password, it should ask for the old password, new password and confirm new password you can additionally add the functionality of generating letters in the word format from the application. These letters will be sent to the customer and these will describe about their complaint status and approximately when will they receive their lost item. There can be types of letters like Complaint Status Type, Additional Information Required Type, Lost Article Type, etc. The Complainants Address should be filled automatically in the letter from the database. A separate module for printing will be required.\nStep to start off the project-:\n1. Get a firm grasp on the above technology.\n2. Decide on the number of groups, number of articles, number of categories, number of lost letter types, number of customer letter types, business rules.\n3. Decide on the various details of the user and their groups that would be stored in the database (like employee/registration-number, name, grade, location, system-login, password in cryptic form, etc)\n4. Make a super user who will be able to assign users to groups and will be able to assign rights to a group.\nUI should include good images and have a constant look and feel throughout the application\nProject 4: -\nProject Name -Web Host Tracking.\nClient- Mascon Global Ltd (USA)\nTechnologies Core JAVA, Object Access Protocol, Apache Tomcat, Oracle 9i\nTeam Size 12\nDuration April-04 - Dec 05\nDesign issue 1. Data design, 2. Architectural design, 3. Procedural design, 4. Interface design.\nRole & Responsibility Developing various modules and coding of various JSP Form Bean and Action as per requirement.\nDescription\nThe purpose of the project ISP Automation is to automate an interface where in all the details pertaining to Customer-Profiles, IP Addresses, Servers, Url and Emails etc. are to be maintained.\nThe actual concept behind the project is that, whenever a customer comes to the ISP Companies in order to pace his website in the ISP based server for maintenance, the Employees of that company maintain the details pertaining to that particular Customer which includes Customer profile, Customer Details, Server Details where the Customersâ\n?? website has been placed, Url Details and E-mail Details etc',NULL,1,NULL,'2007-10-15',NULL,'2007-10-15','2010-06-08 12:13:25','2010-06-08',2,NULL,NULL,NULL,NULL,NULL,'0',NULL),(16,'Koti Reddy',NULL,NULL,'Pune ','kegogerwggeti2eg4@gmail.com','koti24@gmail.com',NULL,'0','91 9881060622','0',NULL,'0','2006-11-12',7,18,'2010-06-08 12:13:25',2,'0',NULL,'200710/15/ATT8032.html','200710/15/DOC15859.doc','Resdex @ naukri.com\nK. reddy\nkegogerwggeti2eg4@gmail.com\n\nTelephone: 9881060622\n(M)\n\nD.O.B\n - 24 Jan 1978 \nModified on\n - 25 Sep 2007 \nAnnual Salary\n - INR 4 Lac(s) 50 Thousand \nTotal Years of Experience\n - 3 Year(s) 4 Month(s) \nCurrent Location\n - Pune \nPreferred Location\n - Anywhere in \nIndia\nAnalyst Programmer\n\nTEXT RESUME \n\nEmail: koti24@gmail.com \nMobile\n: +91- 9881060622\nKOTI Reddy\nSUMMARY\n\n Having 3+ years of experience in software development with emphasis in development of Web and stand-alone applications.\n\n Project experience on client-server technologies using Java, JDBC, Servlets, JSP, Struts, XML, EJB, J2EE, Oracle, Web Logic, Apache Tomcat and JMS\n\n Hands on JBuilder, Eclipse\n\n Having good knowledge of Design Pattern implementation.\n\n Strongly initiative, creative and able to learn new technologies and systems.\nSKILLS\nOperating Systems\nHP-UX, WINDOWS-95/98,Windows-NT workstation\nLanguages Java, C, C++ and PL/SQL\nJava Technologies J2EE, Servlets, JSP, EJB, JavaBeans, JDBC, JMS, Web Services\nDatabase ORACLE\nFrame work Struts\nVersion Control Systems Visual Source Safe , CVS.\nWeb Technologies HTML, JavaScript, XML.\nApplication & Web Servers Web Logic, Apache Tomcat.\nEditors JBuilder, Eclipse.\nEDUCATION\nMaster of Computer Application (M.C.A) from Periyar University in 2001.\nBachelor of Science (B.Sc.,) in Electronics from \nNagarjuna\nUniversity\n in 1998.\nWork Experience:\n\n Working as a Analyst Programmer in Syntel Ltd, Pune from August 2006 to Till Date.\n\n Worked as a Software Engineer in Infogain India Pvt.Ltd, Noida from Jan 2006 to July 2006.\n\n Worked as a Software Engineer in Techno-Magica, Bangalore from May 2004 to December 2005.\nEXPERIENCE\nTITLE : Thomas Cook, Insurance\nClient : Thomas Cook, UK\nCompany : Syntel Ltd., Pune\nEnvironment : J2SDK 1.5, JSP, Struts, Oracle 9i and Tomcat 5.5\nRole : Team Member\nSummary:\nThe Financial Services website will accept insurance requests from Thomas Cook Stores, Thomas Cook Sales Centres, AXA Call Centre, and thomascook.com. Requests for Insurance premiums will be issued to and received from the Pricing/Discount facility by the website. Further details as necessary will be entered to the website e.g. pre-existing medical condition information, and revised premiums requested from the Pricing/Discount facility. When the customer\n?s requirements have been finalised, the premium and other relevant details will be returned to the originating system, where the booking will be finalised and payment taken. Transactions including quotes and\n policies will be stored in the Transaction database.\nResponsibilities:\n\n Developed Web Pages using Struts Framework.\n\n Implementing Business logic by using EJBs.\n\n Involved in Creating Data Access Objects.\n\n Involved in Database scripts.\nPeriod : January 2006 \n? July 2006\nCompany : Infogain India (P) Ltd. \nNoida\n\nIndia\nClient : Radii, U.K\nRole : Team Member\nSummary:\nCSC is Radii\n?s ?Customer Service Component?, it is used to receive log and track customer complaints. CSC is used in by Manufacture\nrs and retailers in slightly different ways. Manufacturers customers are retailers and they will be contacting a manufacturers service centre with a complaint relating to goods that have been ordered by a shop on behalf of a customer. Complaints are often received by letter/fax or email.\nThe first step is to identify the customers order details and identify the products that are the subject of the complaint. Searches are provided to search by the customers purchase order details, shop details. In the event that the goods where dispatched directly to an end customer (home delivery) is it also possible to enter and search on end customer details.\nResponsibilities:\n\n Developed Jsps, Java Beans and Exception handling Classes.\n\n Implementing Business logic by using EJBs.\n\n Developed Action Event, Diary Event, Sundry Event, Allowance Event.\n\n Developed search criteria like Customer Search, Order Search, and Event Search.\nEnvironment: Java, Struts, Jsp, Servlets, EJB, Java Beans, XML, Eclipse, Oracle, Web logic.\nPeriod : May 05 \n? December 05\nCompany : Techno-Magica, Bangalore\nClient : HP\nRole : Team Member\nSummary:\nFoundation Architecture Initiative (FAI) is designed to faciliate interactions with customers, suppliers, or prospects via one or more touch points. A 360-degree view of customers optimizes these interactions. Creating a 360-degree view of customers involves collecting, managing, and storing volumes of information about customers.\nTo optimize interactions with thousands or millions of different customers, FAI also uses Central Customer Database (CCDB) as an operational data store to capture and deliver customer records in near real time from and to touch point systems.\nResponsibilities:\n\n Involved in Coding and Participate in peer reviews / walkthroughs of program specifications, code Review.\n\n Implement changes in Coding EJB\n?s.\n\n Involved in Bug fixing.\n\n Involved in Unit Testing.\nEnvironment: Java, Servlets, JSP, EJB, Web logic, XML and Oracle\nPeriod : October 04 \n? April 05\nCompany : Techno-Magica, \nBangalore\nClient : Central Bank of \nNigeria\n, Nigeria\nRole : Team Member\nSummary:\nThe Banking Analysis System (BAS) facilities the monitoring of the condition and performance of banks and other financial institutions by CBN &NDIC. It provides a platform for capturing information from financial institutions and the processing of same to generate outputs such as financial indicators, statistics and such other ratios, graphs and pictorial presentations.\nThe primary function of the Research Department is rendering of advisory services on economic and financial policies, especially monetary, banking and balance of payments policies to the management of central Bank. This department is presently organized into divisions are Economic Policy Unit, Financial Analysis Division and Statistical Services Division\nResponsibilities:\n\n Implemented Business logic by using Servlets.\n\n Developed Jsps, Java Beans.\n\n Implemented session beans business logic to connect with CMP.\n\n Knowledge transfer to the other team members\nEnvironment: Java, JSP, Servlets, EJB , XML, Oracle, Web logic\nPeriod : May 04 \n? October 04.\nCompany : Techno-Magica, \nBangalore\nClient : Ace Group of Companies, \nUSA\nRole : Team Member\nSummary:\nThis project is a Web-based application developed to automatic insurance business process involved. Ace group is the one of the biggest insurance company in \nUSA\n. Whose main task is provide loss prevention services to the customers. Customers approach Ace group to insure their company locations. Each company may have many different locations across \nUSA\n. Ace group will underwrite policy for the company and insures the company locations. Policy will shown to the customer and if the customer agrees for the premium that Ace group given, the policy come to Ace group, otherwise policy is lost.\nResponsibilities:\n\n Involved in developing Servlets and Jsps.\n\n Implemented Business logic by using Beans.\n\n Involved as team member in coding and understanding the problems.\n\n Involved in developing DAO to access Database.\nEnvironment: Java, JSP, Servlets, EJB, HTML, Oracle and Tomcat','Syntel Ltd',1,NULL,'2007-10-15',NULL,'2007-10-15','2010-06-08 12:13:25','2010-06-08',2,NULL,NULL,NULL,NULL,NULL,'0',NULL),(17,'Ramdev',NULL,NULL,NULL,'rascscmdev_elcscec@rediffmail.com',NULL,'9441629091','0','9866126824','0',NULL,'0','2008-04-29',NULL,NULL,'2010-06-08 12:13:25',3,'0',NULL,'200710/15/ATT8031.html','200710/15/DOC15860.doc','RAMDEV BUGATA\nRAMDEV \nFlat\n:109\n, 7\nth\n Block, \nPrajaycity\nApartments, \nMiyapur\n\n                            \nEmail: rascscmdev_elcscec@rediffmail.com\nHyderabad\n?500050, AP.\n\n                           \n          \nPhone\n\n9866126824\n\n9441629091\n        \n  \n                        \n\nObjective\n\n\n                       \nTo obtain internship in an organization that provides a challenging and an aggressive team oriented work environment where in my strong analytical, problem solving and programming skills can be fully utilized with a scope for professional growth.\n\nProfessional Summary\n\n\nHaving\n\n\n+years experience in JAVA and J2EE technologies and working as a \nSoftware Engineer\n in \nStringInfotech\n\nHyderabad\n\n\nTechnical Summary\n\n\n\n     \nHands on experience in \nJ2EE, JAVA \nprogramming and development.\n\n       \nInvolved in Implementation, Deployment and Configuration of Client/Server and Web Technologies using \nJAVA, JDBC, \nServlets\n, JSP and Oracle.\n\n       \nHaving Knowledge on\n Struts framework\n\n       \nWorked extensively on servers like Apache Tomcat and Web logic\n\n      \nGood communication and interpersonal skills with the ability to communicate effectively at all levels of development process.\n\nEducational \nQualification\n\n\n\n       \nM.Sc\n\nfrom\n   \nAndhra\nUniversity\n\n\n       \nEmbedded systems \nfrom \nHyderabad\n central university,\n\nSoftware Exposure\n\n\nOperating Systems\n                   \n\n\nWindows95/98, Windows XP\nProgramming\n Languages\n         \n\n\nC, C++, JAVA, J2EE\nWeb Technologies\n      \n   \n            \n\n\nHTML, \nXML ,\n\nServlets\n, and JSP\nRDBMS\n                           \n      \n         \n\n\nOracle 8i \nServers\n                    \n   \n       \n\n\nWeb Logic8.0,\n Tomcat5.0\nTools\n                                  \n\n\nJbuilder\n\nEditplus\n\nProjects Profile\n\n\n\nPROJECT NAME\n        \n\n    \nHot Schools.net\n\n\n1.\n Module Name: \n\nContent Management System (CMS)\nClient\nThink-And-Learn.com\nRole\nSoftware Developer \nDuration\n03/2007 ? till Date.\nSoftware & Tools\nJava, JSP, \nServlets\n, JDBC, Web Logic.\n\n\nDescription\n\n       \nContent Management System (CMS) is a web application to manage documents. It has a built-in WYSIWYG editor allows you to create and edit documents similar to popular office applications. All documents are fully versioned in CMS. The history function of the workplace enables the user to track the changes done, when and by whom. The search function is useful in searching the documents which contains the desired words\n\nRoles and Responsibilities:\nDeveloped Action classes, \nServlets\n, Java Beans.\nBuilding Web Component using Struts tag libraries\nPerformed Code walkthrough\nManual Testing.\n\n2. \nModule Name:\nQuestion Editor\n\nClient\nThink-And-Learn.com\nRole\nSoftware Developer \nDuration\n06/2006 ? 02/2007\nSoftware & Tools\nJava, JSP, \nServlets\n, JDBC, Tomcat.\n\nDescription\n\nHotschools\n Question Editor (HSQE)\n\nis a revolutionary proprietary software technology of \nHotschools\n, Inc. allowing users to create their own quizzes and exams, Edit the questions created, delete the created questions and can view the created questions. Hot Schools Question Editor (HSQE) supports:\nMultiple Choices (Single Answer), Multiple Choice (Multiple Answer), Fill in the Blank, True or False, Matching type, Short Answer type, and Essay types of questions.\n\n\nRoles and Responsibilities:\n\nInvolved in coding the user interfaces with \nJSP?s\n\n\nAnalyzed the bugs and enhancements.\nInvolved in Database Connectivity.\nWriting Java Script Validations.\n\n3. \nModule Name:\nBackup and Restoring Backup\nClient\nThink-And-Learn.com\nRole\nSoftware Developer \nDuration\n11/2005 ? 05/2006\nSoftware & Tools\nJava, JSP, \nServlets\n, JDBC, Apache Tomcat.\nDescription\n\n        \nAdministrator friendly proprietary software technology of Hot Schools.net.\n\nuseful\n for a school administrator, to easily take backup and to restore backup of the school, teachers and courses. \n\nThis module helps the administrator from the data lose. This backup and restoring process do not occupy much space\n\nRoles and Responsibilities:\nFront-end designing with \nJSP?s\n\nInvolved Development of \nServlets\n/beans.\nPerform manual testing.\nWriting documentation for the code.\n\n\nPROJECT NAME\n        \n\n        \nDistributed Channel Management System\n\nRole\nSoftware Developer\nDuration\n03/2005 ? 10/2005\nSoftware & Tools\nJava, JSP, \nServlets\n, JDBC, Apache Tomcat.\n\nProject Description\n\n\n           \n            \nThe Distributed Channel Management System \nis\n a Web Based System which gives information related to the clients and dealers of the company with respect to its pesticides product launches. The specific purpose of the system is to automate the communication between the management, clients and the dealers of the organization. Activities related to the system are listing of various dealers of the company, its branches, its clients and providing expertise suggestions on the usage of the product, update product, providing instruction to the dealers\n\nPersonal Profile:\n    \n\name\n                                  \n\n        \nRamdev\n\nBugata\n     \nFather?s Name\n                     \n\n        \nSimhachalam.B\n     \nDate of Birth\n                        \n\n        \n04-08-1977.\n     \nSex\n                                      \n\n       \nMale\n     \nPresent address\n                   \n\n        \nB. \nRamdev\n                                                \nFlat No\n:109\n, 7\nth\n Block,\n                       \n                            \nPrajay\n city Apartments,\n                                                          \nMiyapur\n, Hyderabad-500050',NULL,1,NULL,'2007-10-15',NULL,'2007-10-15','2010-06-08 12:13:25','2010-06-08',3,NULL,NULL,NULL,NULL,NULL,'0',NULL),(18,'Kaladher R',NULL,NULL,NULL,'kalawvwedsvvher04@gmail.com',NULL,NULL,'0','09908636975','0',NULL,'0','2007-04-30',NULL,NULL,'2010-06-08 12:13:25',3,'0',NULL,'200710/15/ATT8030.html','200710/15/DOC15861.doc','Kaladher Ravula kaladher04@gmail\nKaladher R\n                                                                 \n         \nkalawvwedsvvher04@gmail.com\n                                                                                                           \nMobile\n\n\n09908636975\n                 \n      \n\nProfessional Summary:\n\n\n      \n  \nAround \n\n years of experience in Software Development on \nJava/J2EE \nTechnologies\n\n\n      \n  \nExtensive experience in development of Web Based applications.\n\n      \n  \nExpertise in developing Struts based applications.\n\n      \n  \nGood e\nxperience on servers like Web Sphere, Web logic and Tomcat.\n\n      \n  \nExperience on using IDEs like WSAD and Eclipse.\n\n      \n  \nExcellent Analytical, Communication, Interpersonal skills and ability to work well as a part of a project team.\n\nWork Experience:\n\n\n      \nWorking as \nSoftware Engineer\n with \nCSC India Pvt. Ltd.\n\nSince Feb 2007.\n\n\n      \nWorked as \nSoftware Engineer\n with \nAccenture Services\n\nFrom Sep 2006 to Jan 2007.\n\n\n      \nWorked as \nSoftware Engineer\n with\n Cypher InfoTech \nfrom\n Oct?04 to Sep 2006.\n\nEducational Summary:\n\n\n      \nMCA from \nKakatiya\nUniversity\n with 73% in 2004.\nTechnical Skills:\n\nLanguages\n                  \n\n\nJava, C\nJ2EE Technologies\n    \n\n\nServlets, JSP, EJB.\nServers\n                                   \n\n\nWeb Sphere, Web Logic, Tomcat.\nIDEs\n                            \n\n\nWSAD, Eclipse\nFrame Works\n              \n\n\nStruts\nWeb Technologies\n      \n\n\nHTML, Java Script and XML\nProjects Profile:\n\nProject # 1:\n                                                                                                    \nFeb 2007 to Till Date.\n\nTitle\n                  \n: Risk Intelligence.\nClient\n    \n            \n\nZurich\nNorth America\n\nEnvironment\n      \n: Java, JSP, Struts, Oracle and Windows.\nRole\n                 \n: Team Member.\nTeam Size\n         \n: 10.\nDescription:\n\nRiskIntelligence Release 3 (RIR3) is more than an enhancement to the RiskIntelligence application.\n\nRIR3 integrates the reporting functionality of RiskIntelligence (now referred to as Reports) with our newest feature, Operational Publishing\n\n(referred to as Documents).\n   \nRiskIntelligence allows our customers to run analytical reports relative to their claims data.\n\nOperational Publishing allows our customers, distributors, and internal users to build a repository for sharing account-related ?unstructured? documents such as faxes, MS Word documents, e-mails, MS Excel worksheets, \nZurich\n policy documentation and invoices.\n\n\nResponsibilities:\n\n      \nImplemented and modified Front-End design by using JSP.\n\n      \nModification of servlets and DAOs to access Database.\n\n      \nResponsible for Unit Testing.\n\nProject # 2:\n                                                                     \n                               \nSep 2006 to Jan 2007.\n\nTitle\n                  \n: MORCOM.\nClient\n    \n            \n: JPMorgan.\nEnvironment\n      \n: Java, JSP, EJB, Weblogic, Oracle and Windows.\nRole\n                 \n: Team Member.\nTeam Size\n         \n: 8.\nDescription :\n\nThis MORCOM suite consists of modules like Futures &Options, \nPrime Brokerage customization, Websphere portal migration, \nReconDb Migration and\n BO Migration. \nReconDb Migration\n is Reconciliation Database Migration from Sybase to Oracle. This is for tallying two or more accounts of JPMorgan?s and clients. BO Migration is from Viador to Business Objects. Viador is a reporting tool which is migrating to Business Objects. It consists of creation users, setting rights to users and creation of reports.\n\nResponsibilities:\n\n      \nImplemented and modified Front-End design by using JSP.\n\n      \nModification of DAOs to access Database.\n\n      \nResponsible for Unit Testing.\n\nProject # 3:\n             \n                                                           \n                           \nAug 2005 to Sep 2006.\n\nTitle\n                  \n\nWestpac\n\nClient\n    \n            \n: Westpac \nBank\n\nSingapore\n\nEnvironment\n      \n: Java, JSP, Struts, EJB, Weblogic, Oracle and Windows.\nRole\n                 \n: Team Member.\nTeam Size\n         \n: 12.\nDescription :\nThis suite will provide Westpac?s customers the ability to perform management functions through the internet. This suite will provide the bank customers to make their payments online quickly and securely, and also this suite provides services like transfer balance, view payment history, mail alerts, adding customers to value services etc. This mainly consists of four modules, they are Bank Information Module, finance module, customer module and report module.\nResponsibilities:\n\n      \nImplemented Front-End design by using JSP.\n\n      \nImplemented MVC and developed Action classes.\n\n      \nUsed DAO to access Database.\n\n      \nResponsible for Unit Testing.\nProject # 4\n                                                                                             \n       \nOct 2004 to July 2005.\n\nTitle\n                  \n   \n\nOrder management.\nClient\n    \n            \n   \n\nSaxo Traders.\nEnvironment\n      \n   \n: Java, JSP, Servlets, Tomcat, Oracle, Windows.\nRole\n                 \n   \n: Team Member.\nTeam Size\n            \n: 8\nDescription :\nThis project mainly consists of three modules. They are Registration, Order Manager and Card Validation. In this project the customer has to register first then only he can purchase the goods online by selecting the goods. The value of the selected goods will be calculated then bill amount will be checked from the user account and deducted if sufficient. Finally the goods will be delivered to the customer.\nResponsibilities:\n\n      \nInvolved in design of JSP/HTML pages.\n\n      \nDeveloped Business Logic.',NULL,1,NULL,'2007-10-15',NULL,'2007-10-15','2010-06-08 12:13:25','2010-06-08',3,NULL,NULL,NULL,NULL,NULL,'0',NULL),(19,'Ramakrishna',NULL,NULL,'Hyderabad',NULL,NULL,NULL,'0',NULL,'0',NULL,'0','2008-04-13',NULL,NULL,'2010-06-08 12:13:25',3,'0',NULL,'200710/15/ATT8029.html','200710/15/DOC15862.doc','Objective\n\nObjective\n\nA position as an Internet marketer giving me the opportunity to apply my skills. Ideally, focusing on bottom-line results while formulating and implementing advanced technology and business solutions to meet diversity of needs. \n\n\nCertifications\n\n\n      \nInternet Marketing\n\n          \nAIMA (\nAsian\nInternet\nMarketing\nAcademy\n).\n\n\n      \nEmbedded & Networking Systems\n\n          \nRocsys (Pvt) Limited\n\n\nProfessional Experience\n                                                                                                     \n2 years\n\n\n      \n            \nYbrant Technologies Limited\n\nHyderabad\n, A.P, \nIndia\n\n           \nSenior Search Engine Optimizer \n                       \n\n         \nRefinement and management of the company?s Search Engine Advertising\n\n         \nDevelopment of effective web advertisements for business related websites\n\n         \nEstablish ROI reporting for each area of message media?s online marketing\n\n          \nCo-coordinating and supporting team members and departments for various ongoing operations.\n\n          \nAdvanced Excel, use of pivot tables, macros, stats functions using Excel\n\n          \nWorked on CMS and maintaining web2.0 standards.\n\n          \nWorked on Analytics tools like\n\nGoogle analytics, Stat counter etc\n\n          \nHands on experience on third party CRM tools like Sugar CRM, VTIGER etc.\n\n          \nConducted market study, NICHE research, cpc analysis and competitor analysis.\n\n          \nImplemented social media optimization\n\n          \nDevelopment of innovative strategies and solutions to address complex business issues, business intelligence, reporting and on time delivery of deliverables.\n\n          \nCollecting end user requirements, evaluating solutions, developing business cases, planning, testing and documentation and managing complex application projects for various Ybrant business units.\n\n\n      \n            \nAxaya Cyber Technologies\n\nHyderabad\n, A.P, \nIndia\n\n   \nSEO Engineer\n                       \n\n          \nScripts Installations, worked on CMS and maintaining web2.0 standards.\n\n          \nConducted market study, NICHE research, cpc analysis and competitor analysis.\n\n          \nWorked on various SEO/SEM tools and well versed with all SEO/SEM techniques (White Hat).\n\n          \nMaintained Internal PPC campaigns.\n\n          \nWorked on various SEO/SEM tools and well versed with all SEO/SEM techniques (White Hat).\n\n          \nDevelopment of innovative strategies and solutions to address complex search engine \n\nissues,\n\nreporting and on time delivery of projects..\n\n          \nRefinement of landing pages\n\n\n\n\nCore Competencies\n\n\n         \nDocumentation & Training.\n\n         \nInter and Intra Departmental co-ordination.\n\n         \nSearch Engine Strategies\n\n         \nWeb Analytics\n\n\n         \nIndustry Experience \n(IT) in SEO/SEM.\n\n         \nKeyword and Niche analysis.\n\n         \nSocial Media Optimization\n\n\n\nEducation\n\n\n      \n2001 - 2005\n     \nBE (Electronics & Communications)\nVTU\n ? Visveshwaraiah Technological University, \nBangalore\n\nKarnataka\n\nIndia\n\n\n\n      \n1999 - 2001\n     \nINTERMEDIATE, \nBoard of Intermediate\n\nHyderabad\n, AP, \nIndia\n\n\n\n      \n1998 - 1999\n     \n10th CLASS, ICSE, \nIndian Council of Secondary Education, \nHyderabad\n, AP. India.\n\n\n\nTechnical Proficiencies\n\nPlatforms \n\nLanguages\n\nTools\n\n\nNetworking\n\n\n\n\n\n: Unix , Linux and Windows 95/98/NT/2000/XP\n\n\n: C, Css, Php, Java script, HTML.\n\n\n: Microsoft Office Suite, FrontPage, Adobe Photoshop, Macromedia Dream weaver, SEO tools.\n\n\n\n: Tcp /Ip application development in Linux, and implemented \nHTTP\n client.','Ybrant Technologies Limited',1,NULL,'2007-10-15',NULL,'2007-10-15','2010-06-08 12:13:25','2010-06-08',3,NULL,NULL,NULL,NULL,NULL,'0',NULL),(20,'Kalyan s',NULL,NULL,'Banglore','Kalyghjjan_vefgeegfjdgjtsaifgjngj@rediffmail.com','kjalygjan.s.vgtjetsa@gmail.com',NULL,'0','98660 67796','0',NULL,'0','2007-01-12',7,18,'2010-06-08 12:13:25',3,'0',NULL,'200710/15/ATT8026.html','200710/15/DOC15863.doc','Objective:\nKalyan S\n                                                                                                \n                \n+91 98660 67796(M)\nKalyghjjan_vefgeegfjdgjtsaifgjngj@rediffmail.com\n\n\n\nkjalygjan.s.vgtjetsa@gmail.com\n\n                                                                \n\nSummary: \n\n\n          \nAround 1.5 Years of experience in developing internet and client server applications\n\n\n          \nAround 1.5 Years of experience in Database and Application Administration\n\n\n          \nShort experience in \nManual testing\n\n\n          \nExperience in developing and deploying applications with \nIBM Websphere , Apache\n and\n\nPramati \nWeb Servers\n\n\n          \nExperience in using various \nConfiguration Management tools\n like \nVSS, CVS.\n\n\n          \nExperience in tuning Oracle using \nQuest software?s SQL Navigator.\n\n\n          \nExperience of various shell scripting languages like \nJava script, Unix shell script \netc\n\n\n          \nExperience in developing web applications using \nJava Technologies and PL/SQL.\n\n\n          \nExperience in \nUNIX\n system administration on various flavours like\n SUN SOLARIS, IBM AIX, HP UX\n\n\nCertifications:\n\n\n          \nOracle certified Associate.\n\n\nSoftware Skills:\n\n\nOperating Systems\n                             \n: MS-DOS, Windows 95/98/NT/2000, UNIX, Sun Solaris, IBM AIX, HP-UX\nLanguages\n                                           \n: Java, C, C++, SQL, PL/SQL\nWeb Technologies\n                              \n: HTML, DHTML, PERL, Servlets, JSP, RMI, SQLJ JDBC, Web Services, Flash\nScripting Languages\n                          \n: JavaScript, VB Script, Shell script.\nRDBMS\n                                                  \n: Oracle 9i, 10g MSAccess\nGUI\n                                                         \n: AWT\nApplication Servers\n                             \n: IBM Websphere 6.0, Pramati 4.1\nWeb Servers\n                                         \n: ApacheWebServer (add on Tomcat)\n\n\n\n\n\nWork Experience:\n\n\n\n          \nInfosys Technologies Ltd\n\n                \n\nJuly 2004 ? CURRENT\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\nProfessional Experience:\n\n\n\nCE and Service for Finacle 9.0\nEnvironment\n           \n\n    \nJAVA, JSP, HTML, Oracle, Pramati (web server)\nClients :\n\nInternal\nDescription: \nCE and Service is a tool to maintain the entire configuration data of FINACLE. It takes all the data from the configuration files of various services of Finacle and stores in a separate schema of the Finacle Core Database. Whenever any service requires the configuration information for its starting and stopping it contacts this tool to fetch that data. This tool is also used to maintain the authenticity of data and to log all the changes made to data .The tool is developed in Core Java to suit both UNIX and Windows environments .Front end is developed in JSPs and is built in a war file which is deployed in a Web Server. Back end is a LIMO(Listener-Monitor) architecture based service.\n\nResponsibilities: \n\n\n          \nRequirements gathering and Requirements analysis.\n\n          \nDesigning the Application Architecture and Application Design\n\n          \nDeveloped\n\nof writing build scripts which will compile classes, create Ear?s and deploy it in Websphere/Pramati \n\n          \nDeveloped Shell Scripts\n for the automatic configuration of the project and made if available for autosys jobs.\n\n          \nInvolved in complete support of the application for regular change requests and enhancements.\n\n          \nResponsible for delivering the modules to testing teams and coordinating team.\n\n          \nInvolved in Data Modeling, system data analysis, design and. Optimized system performance by writing stored procedures and calling them using JDBC callable statements.\n\n          \nAddressing calls from Testing team\n\n          \nDeveloped front end GUI in JSPs\n\nto grab the configuration data required for the services\n\n          \nDeveloping Java beans required for connecting JSPs with Oracle database using JDBC architecture. \n\n          \nImplemented menu driven access for the modification of configuration data for various services \n\n          \nInvolved in maintenance and upgradation of application based on the tickets raised by the testing team\n\n\nDatabase and System Administrator for various releases of Finacle (Finacle 9.1 ,Finacle 9.2, Finacle 10.0, Finacle 7.4) \n     \nClients\n                            \n\n      \nASPIS (\nGreece\n), GHB Bank (\nThailand\n), BCP (\nPanama\n), DBS (\nSingapore\n\nEnvironment\n                 \n\n     \nUNIX (Sun Solaris, IBM AIX, HP-UX), Oracle 9i,10g, WebSphere 6.0\n               \n(Application server)\nDescription:\nFINACLE is a banking product by InfosysTechnologies which has clients in many countries like Singapore , Africa ,Europe India etc .This role involves installation and maintenance of various components of Finacle like Finacle CRM, Finacle Core Banking ,Finacle Configuration Editor, Maintenance of multiple instances of Finacle suite of products on various servers, Co-coordinating with ONSITE and development team for the resolution of issues. etc .\nFinacle core has two components backend and front end .All the sources of Finacle Core backend are developed in C language and exes are compiled for various platforms like Sun ,HP ,IBM depending on the requirement of client . All the sources of front end are developed in Java (JSP\n\nand servlets ) which are deployed in a Web Server (Pramati/WAS) .The connection between backend and front end happens through a LIMO architecture based service . \n\nFinacle CRM is a pure WAR file build in J2EE architecture .It is\n\ndeployed in a J2EE application server like Pramati or Web sphere .\n\nResponsibilities: \n\n\n          \nGetting the deliverables from engg team for various releases of Finacle.\n\n          \nCreation of Work space and back up space for various releases of Finacle\n\n          \nDeveloping backup strategy for different versions of Finacle release\n\n          \nInstallation of Third party softwares required for Finacle Suite of products like python, open ssl, mq series, Web Sphere/Pramati etc.\n\n          \nInstallation of Oracle databases required for Testing various releases of Finacle\n\n          \nCreation of table spaces, schemas required by the database\n\n          \nCreation of tables, indexes, stored procedures , indexes and Triggers\n\n          \nCreation of seed data from external template files\n\n          \nImport of data from old database dumps \n\n          \nMaking a backup plan using RMAN and scheduling regular backups\n\n          \nInstallation of Finacle suite of products which include Finacle Core Banking, Finacle CRM , Finacle Configuration Service, Finacle e-banking, Single Sign on etc\n\n          \nApplication of various patches for the tickets raised by testing team\n\n          \nMonitoring various services of Finacle like finlistval, crv which are used for different functional requirements like Listing , inquiry\n\netc.\n\n          \nDeveloping PL/SQL scripts for user creation, account updates and various routine tasks\n\n          \nDeveloping Automation scripts (shell scripts) in unix for automating backup tasks, clearing of logs, monitoring core dumps, monitoring Finacle services, Application of patches etc\n\n          \nMaintenance of \n\nthe Unix servers required by the testing teams which involve space allocation ,memory \n\nand process management , upgrading patches etc\n\n          \nCoordinating with various teams like Engineering, Archie and customization to resolve various client calls and tickets\n\nFinacle Technical Consultant for Finacle Presales team:\nEnvironment\n           \n\n    \nJAVA, JSP, HTML, Oracle, Pramati (web server),\nUNIX Laptop severs (Sun Solaris), Oracle 9i,10g, WebSphere 6.0\n               \nClients :\n\nInternal. Been to \nUK\n and \nChina\n for demos .\nDescription: \nThis role essentially deals with providing technical support for the Pre-Sales team of Finacle. Finacle division has a pre-sales division, which takes care of handling all pre-sales related activities like, giving the demos for prospective clients, creating functional scenarios and presentations to be presented during demos. Finacle division maintains a separate set of Unix servers which are generally SUN Laptop servers, for presales operations. They are setup with the pre-identified Finacle modules and scenarios to be displayed at Client site. They are then carried to client site, to carry on the live presentation of the scenarios as demanded by the client.\n\nResponsibilities: \n\n\n          \nPreparing the\n\npresales server for Demo with necessary Finacle installation and its databases.\n\n          \nPreparing tools for easy stopping and starting of services at client site (usually a shell script)\n\n          \nDeveloping customizations to accommodate any specific requirement to be shown at site. These are of two types. One is web-customization which is done using proprietary Finacle scripting language and ONS-customization which is done using Java beans and JSPs\n\n          \nTaking servers to the client site and making it ready for the demo \n\n          \nTaking up, Finacle technical presentation, illustrating the architecture of Finacle\n\n          \nProviding call based support for all the technical issues raised by Pre-Sales team.\n\n          \nPreparing documents for installation and troubleshooting of various technical modules of Finacle ,for future use by various teams like Support, Implementation and Testing teams.\n\n\nTraining Experience :\n\n\nEnR Training \nEnvironment\n              \n\n        \nJAVA, SERVLETS, JavaScript, HTML, Oracle,\nApache Tomcat 4.1 on Win NT.\n\nDescription:\nThe EnR (Education and Research) training includes rigorous training giving the trainee a feel of the production environment. The execution of mock project strictly adheres to the PCMM Level 5 standards and the Infosys process. This is an \nonline software application that would enable Project Leaders to automate Resource Handling, Task allocation and other basic activities of Project Management.\n\nResponsibilities: \n\n          \nRequirements gathering and Requirements analysis.\n\n          \nDesigning the Application Architecture and Application Design\n\n          \nInvolved in complete support of the application for regular change requests and enhancements.\n\n          \nResponsible for delivering the modules to testing teams and coordinating team.\n\n          \nInvolved in Data Modeling, system data analysis, design and. Optimized system performance by writing stored procedures and calling them using JDBC callable statements.\n\n          \nDeveloped front end GUI in Java AWT, HTML, DHTML\n\n          \nDeveloping Java beans required for connecting JSPs with Oracle database using JDBC architecture. \n\n          \nDeveloping function blocks using OJDBC\n\nand RMI architecture\n\n          \nActed as Configuration Controller for the whole project. Maintained various versions of different modules using VSS\n\n\nEducation:\n\n\n\n          \n82 % in State Boad of Secondary Education (SSC)\n\n          \n90 % in Intermediate Education (Andhra Pradesh Intermediate Board) \n\n          \n73 % in B.Tech Mechanical Engineering from NIT Allahabad (Previously REC)\n\n          \nSummer Intern Project on Understanding Flight Control Mechanism of \nAgni-II\n Missile at \nDefense Research Development Organization (DRDO) \n\n          \nFinal Year Project on Manufacturing low noise high performance silencer for a two stroke engine\n\n\nOther Information:\n\n\nDate of Birth\n                          \n\n\n             \n08/18/1983\nLanguages Known\n             \n\n\n             \nTelugu, Hindi, English, French, German\nHobbies\n                                                \n\n               \nChess, Singing, Tennis\n\n\nReferences:\n\n\n          \nProvided upon request',' Infosys Technologies Ltd                  ',1,NULL,'2007-10-15',NULL,'2007-10-15','2010-06-08 12:13:25','2010-06-08',3,NULL,NULL,NULL,NULL,NULL,'0',NULL),(21,'Kiran Raj',NULL,NULL,NULL,'jaedgedgmithi.kiegegran@gmail.com',NULL,NULL,'0','9986794979','0',NULL,'0','2008-04-29',NULL,NULL,'2010-06-08 12:13:25',3,'0',NULL,'200710/15/ATT8023.html','200710/15/DOC15864.doc','CURRICULUM VITAE\nCURRICULUM VITAE\nKiran Raj .J \n                                                     \nE-mail:\njaedgedgmithi.kiegegran@gmail.com\n\n                                                                               \nphone :\n+91-9986794979\n\n      \n                                                                                          \n    \nSUMMARY\n\n\n      \nGood knowledge of Java Technologies, Application Server. Managed project in \n  \n      \ndevelopment of Client server application using \nJava,JDBC, Servlets,JSP\n\n\n      \nExperience of \n2+ years\n as Software Engineer, involved in the development and implementation stages of various projects\n\n\n      \nExpertise in \nJAVA,J2EE\n Technologies, \nJDBC\n, Servlets, JSP,EJB,XML\n\nStruts\n under Windows XP.\n\n\n      \nProfound Knowledge of \nSDLC\n\nPROFESSIONAL EXPERIENCE\n\n\n      \nWorking as Software Engineer for \nShellSoft Technologies\n\nBangalore\n since May 2005 to Tilldate\n\nEDUCATIONAL PROFILE\n\n\n      \nB.Tech (E.C.E)\n\nfrom R.V.R & J.C College of Engg ,\nGuntur\n\nwith an aggregate of\n\n66% in April 2005.\n\n\n      \nDiploma (E.I.E) from\n\nSMVM.Politechnic,Tanuku\n\nwith an aggregate of 67% in April 2001.\n\nSKILLS SET\nSKILL\n           \nPROFICIENCY\n\nAWARENESS\nOperating Systems\nWindows XP\nUnix/Linux\nLanguages\nJava,J2EE\n\nDatabases\nOracle9i\n\nWeb Technologies\nJDBC,Servlets,JSP,EJB,XML,Struts HTML\n\nHibernate\nWeb/App servers\nTomcat5.0\n\n, Weblogic8.1\n\nWeb sphere\nTools& utilities\nEclipse3.0.1,ANT,Junit3.1\n\n\n\n\n\n\nPROJECT PROFILE\n\nCurrent Project:\n\nProject Title\nLRM(Lease Relationship Management System)\nClient\nBay logics Inc.,\nSan Diego\n\nC.A\n\nU.S.A.\nRole\nSoftware Engineer\n\nOrganization\nShellSoft Technologies\nDuration\nSep2006 to Till Date\nTeam Size\n10\nEnvironment\nLanguages:\nJava,Servlets,JSP,EJB,XML,HTML,Oracle9i,Weblogic8.1\n\n      \nDescription:\n                            \nLRM is comprehensive Corporate Real Estate web based application software for Bay Logics Inc, \nUSA\n\n\nThis application has several modules to completely automate Corporate Real Estate Software and is developed using JAVA and Weblogic Application server and supporting different databases. LRM is an occupancy management application designed to manage all activities related to multiple leased properties, owned properties, ground leases, and easements, subleases, income property and others. Designed to address the specific challenges of retail organization facilitates collaboration and Synchronizing activity between real estate accounting, legal, facilities and construction management.\n\n\nResponsibilities:\n\n\n      \nAutomatic check generations on request.\n\n      \nEasy search of a Property ,lease ,Landlord etc..\n\n      \nSorting.\n\n      \nEasy to use menus and navigation.\n\n#Project1\n\n\nProject Title\nStreamline Insurance Processing System(SIPS)\nClient\nZenith National Insurance, U.S\nRole\nSoftware Engineer\n\nOrganization\nShellSoft Technologies\nDuration\nJan 2005 to Aug2006\nTeam Size\n\nEnvironment\nLanguages:\n Struts\n\n Servlets, JSP, Oracle9i,Weblogic8.1\n\n\n   \nDescription\n   \n\n    \n                         \n\nThe main objective of SIPS is to provide cost effective and secured solutions for Insurance Providers. SIPS is mainly targeted to deal with different types of Insurance sectors. SIPS covers different modules relating to the insurance in different segments to suit people at all levels\n      \nsuch as Life Insurance, Property insurance, Motor vehicle Insurance and Electronic Appliance Insurance. A comfortable premium program is planned for easy payments by the client. Each of the customer information tracks through a series of steps, which include\n\n1. Customer registration\n    \n2. Insurance Tracking\n   \n3. Claims processing. SIPS automatically send mails to all its clients regarding the premium payments and the bonus being added to the policy every year.\n\nResponsibilities:\n\n\n      \nInvolved in writing various Form beans and action classes for Life insurance and Motor vehicle Insurance.\n\n      \nCreated various views using JSPs.\nProject #2:\n\n\n\nProject Title\nEllerines & Stuttafords\nClient\nUCS,\nSouth Africa\nRole\nSoftware Engineer\n\nOrganization\nShellSoft Technologies\nDuration\nMay 2005 to Dec2005\nTeam Size\n\nEnvironment\nLanguages:\nJava,Servlets,JSP,Oracle9i,Weblogic8.1\n\nDescription:\n                    \nEllerines and Stuttafords are based on the retail domain architecture. These are distributed components, which serve the client maintain the product information along with the reporting. The System (Point of Sale) is used to manage all sale transactions in the store environment as well as all cash that flows into and out of the business. All sales/receipt transactions are recorded against the Point of Sale(POS) and not the cashier. However all transactions can be tracked by user. All users will have an option to view info from an INFO option. With this system the User is ensured of complete transparency and better control\n\nResponsibilities:\n\n\n      \nPreparation of design Document.\n\n      \nEasy to use menus and navigation\n\n      \nUnit testing the Code\n\nPERSONAL DETAILS\n\n       \nName\n                      \n\n         \nJ. Kiran Kumar\n       \nDate of Birth\n          \n\n         \n01-07-1983\n       \nFather\'s name\n         \n\n         \nJ. Narasimharao\n       \nSex\n                         \n\n         \nMale\n       \nMarital Status\n         \n\n        \nSingle\n       \nLanguages Known\n\n\n        \nEnglish, Telugu\n       \nNationality\n              \n\n         \nIndian.\n\nDate:\nPlace :Bengalore\n                                                                     \n(J.Kiran Kumar)',NULL,1,NULL,'2007-10-15',NULL,'2007-10-15','2010-06-08 12:13:25','2010-06-08',3,NULL,NULL,NULL,NULL,NULL,'0',NULL),(22,'Krishna P',NULL,NULL,NULL,'krishvndvda.psvadvdvni@gmail.com','krishna.pani@gmail.com','09916099720','0','09916099720','0',NULL,'0','2007-04-30',NULL,NULL,'2010-06-08 12:13:25',3,'0',NULL,'200710/15/ATT8022.html','200710/15/DOC15865.doc','Resdex @ naukri.com\nKrishna P\nSrinivasa Nagar,Bangalore Bengalaru / Bangalore \nkrishvndvda.psvadvdvni@gmail.com\n\nTelephone: 09916099720\n(M)\n\nD.O.B\n - 05 Mar 1980 \nModified on\n - 25 Sep 2007 \nAnnual Salary\n - INR 3 Lac(s) 10 Thousand \nTotal Years of Experience\n - 3 Year(s) 1 Month(s) \nCurrent Location\n - Bangalore \nPreferred Location\n - Anywhere in India \nJava/J2EE Programmer Having 3+ Yrs of Experience\n\nTEXT RESUME \n\nKrishna\n Pani\nPh No.:+91-9916099720\nE-mail id: krishna.pani@gmail.com\nPROFESSIONAL SUMMARY:\nÂ· Possess 3+ years of experience in Application development in Java/J2ee Technologies.\nÂ· Work experience on Bea weblogic server and Tomcat server.\nÂ· Working in different phases of software development life cycle including coding, Testing, Implementation, Deployment.\nÂ· Working experience on Java, J2EE, Servlets, Jsp, Java Script, Html.\nÂ· Knowledge on Ejb.\nACADEMIC PROFILE:\nÂ· MCA from \nSri\nVenkateswara\nUniversity\n, in 2004, Tirupati, A.P\nTECHNICAL SKILLS:\nProgramming Languages : Java, JDBC, J2EE, Servlets, JSP, EJB.\nApplication/web Servers : Web Logic, Sun-One, Java Web Server, Tomcat.\nWeb Technologies : Html, Java Script.\nOperating System : WINDOWS 9x/2000/NT,MS-Dos.\nDatabases&Tools : Oracle, Net Beans IDE, Sun-One Studio, JBuilder, Dreamweaver.',NULL,1,NULL,'2007-10-15',NULL,'2007-10-15','2010-06-08 12:13:25','2010-06-08',3,NULL,NULL,NULL,NULL,NULL,'0',NULL),(23,'S sriram',NULL,NULL,'Chennai','THAwqrNDAwqrqrwrRAISRwrIRAM@YAHOO.COM','thandaraisriram@yahoo.com','04442654353','0','09840003662','0',NULL,'0','2006-07-14',10,34,'2010-06-08 12:13:25',10,'0',NULL,'200710/15/ATT8021.html','200710/15/DOC15866.doc','S.SRIRAM\n      \nB.E [ECE]\nE-mail\n\nTHAwqrNDAwqrqrwrRAISRwrIRAM@YAHOO.COM\nMobile\n: 09840003662\n\nOBJECTIVE:\n          \nIntend to seek a challenging career and to contrive complex task.\nEXPERIENCE:\nExperience - 3+ Years.\n\n1. \nBharti\n Infotel Limited (\nAirtel\n NOC - Switch), \n\nJan\'04 to till date ?\n\nCompany Profile: National / International voice and Data Service.\n\n\nEngineer -NOC Switch & DATA\n\n\n\nJob Description:\n>Call data routing of EWSD and Database Creation & modification for NLD and ILD.\n>Switch Parameter creation and modification, \nCDR \nBackups.\n>Operations and Maintenance of EWSD Switches at International POPs in coordination O&M\n>Monitor Network and Keep track of Switch Capacity, Spares for switches.\n>Operations of wholesale and retail (NRI) international services.\n>Take up escalated technical issues related to Network related faults with NLD POIs and International Carriers\n>Coordinating with TAC NOC for resolution of escalated issues and technical issues\n>Issuing of all ILD Routing changes and implementation.\n>A Centralized Contact for all international Carriers.\n>Manage alternative routing based on detailed congestion analysis and Business inputs\n>Implementation of new services in co-ordination with Product Team, P&E and Business Group\n>Complaint handling, Implementation & Solutions with preferential Routings. Resolution of Quality related problems.\n>Day - to -Day general maintenance of EWSD Siemens Switch.\n>Implementation of charging databases in EWSD switch.\n>Trunk Creation and modification of POI and Backbone.\n>Network performance analysis and taking appropriate actions.\n>Carrier Quota, LCR and wholesale routing for ILD.\n>Operations control such as E1 addition, TGNO Creation, DEST, Route and all the necessary parameters, Co-ordination with SDH Engineers. \n>Co-ordination with Different Switches and Revenue Assurance.\n\n\n\n\n\nICRs\n\nDATA NOC\n\n1. Responsible for handling CISCO routers deployed for Carrying VOIP traffic.\n2. Routing Protocols such as RIP, IGRP, and OSPF are used.\n3. Monitoring ASR and analysis of the same.\n4. Data Network monitoring\n\n& Fault management from Centralized NOC.\n5. Tools such as Watsup Gold, Hpopenview AMS are used.\n6. Headed a team of Engineers of team strength ? 5members in absence of Switch or DATA Lead.\n7. Fully responsible for Network monitoring and network Availability of DATA \n\nNetwork with Manpower allocation for monitoring the network.\n8. Handling Planned Events and Activities Carried out in the DATA network.\n9. HP Open View, Clarity AMS, INETMAN NMS is used for all activities. \n10. Acceptance Testing of new CISCO Routers.\n11. Fully responsible for any network related faults related to DATA.\n12. Alarm monitoring of DATA network and fixed access network \n13. Routing Protocols such as RIP, OSPF, IGRP, BGP.\n14.\n\nMonitoring and managing network resources using HP Open View by implementing policies and creating custom events.\n15· Fault Management -Identification, resolutions, escalation, tech support to field.\n16. Trouble shooting of Network related faults and customer related faults.\n17. Fault clearing within respective SLAs and TTR for DATA and DLC network.\n18. Planned Event Approval and follow-up of the same.\n19. Planned Activity approval for Upgradation or rectification of Faults in DATA Network.\n\n20. TAC level and Vendor level escalation is done.\n\nTECHNICAL SKILLS:\nTechnical Domain: \nOSI/SS7 models, Protocols, Telecom Switching.\nLanguages: \nC++, java,SQL\nAssembly Languages: \nAssembly Language Programming 8085 & PIC MicroContoller.\nTools: AcceSS7\n, K1205, \nOperating Systems: \nWindows 9x, MS-DOS.\nTelecom Domain & Networking: \nSiemens switch Fundamentals, Routing, and O&M of switch and NOC, GSM Fundamentals.\n\nCCNA\n Networking.\n\nACADEMIC PROFILE:\n\nB.E., Electronics and Communication Engineering\n                   \n    \n(2000 - 2004)\n       \nSRM\nValliammai\nEngineering\nCollege\n, Chennai\nUniversity\n of \nMadras\nFirst Class with Distinction - 72.5%.\n\nCCNA Certified\n\n\nAREAS OF INTEREST\n\n     \nTelecommunication \n                         \n\n     \nR & D in Telecom.\n\n     \nElectronics.\n      \n\n     \nMicroprocessor. \nPERSONAL DETAILS:\nName:\n                               \n\nS. Sriram\nFather Name:\n                    \nS.Sadagopan\nDate of Birth:\n                  \n  \n15-07-1983\nSex:\n                                  \nMale\nMarital Status\n\n                 \nSingle\nLanguages Known:\n          \n\nEnglish, Hindi & Tamil\nNationality:\n                    \n\n  \nIndian\nPassport:\n                           \nPermanent Address:\n         \n#1/5, F type, Sidco Nagar,\n                                           \nVillivakkam,Chennai,Pincode ? 600049.\n                                           \nMobile : 09840003662\n           \n                                \nPH : 04442654353\n                                           \nthandaraisriram@yahoo.com','Bharti Infotel Limited',9,NULL,'2007-10-15',NULL,'2007-10-15','2010-06-08 12:13:25','2010-06-08',10,NULL,NULL,NULL,NULL,9,'0',NULL),(24,'Ravindra Jai',NULL,NULL,NULL,'jjehasdvdvednsi@gmail.com',NULL,NULL,'0','9246627246','0',NULL,'0','2008-04-29',NULL,NULL,'2010-06-08 12:13:25',3,'0',NULL,'200710/15/ATT8019.html','200710/15/DOC15867.doc','RamaNarasimha Prasad\n\nRavindra Jai\n\n\nE-mail:\njjehasdvdvednsi@gmail.com\nPh: \n+91-9246627246\n\n             \n        \n\n          \n            \n                                    \n         \n       \nCAREER OBJECTIVE\nTo be a part of dynamic team with a challenging career in the field of software development so as to work for the growth of the organization where I joined and strive to excel in all \nendeavours\n through hard work and dedication.\n\nSUMMARY\n\n         \nHaving 2+ yrs of IT experience in developing JAVA application programming.\n\n\n         \nSound knowledge in JAVA, J2EE Programming especially in web-based applications.\n\n         \nExperience in the usage of Java IDE like IntelliJ IDEA.\n\n         \nStrongly self-motivated and quick learner.\n\nPROFESSIONAL EXPERIENCE\n\n         \nCurrently working as \nSoftware Engineer\n for\nFirst Indian Corp.,\nBangalore\n\n\n         \nPreviously worked as Software Engineer for GWN Communications Pvt. Ltd,\nHyderabad\n\n\nSCHOLASTIC INFO\n\n         \nPursued\n Bachelor of Technology\n\nB.Tech, CSE\n\n\nfrom\n\nJNTUniversity\n, Andhra Pradesh.\n\nPROFESSIONAL SKILL SET\n\n            \nProgramming Languages\n   \n\n\nC, C++, JAVA\n          \nJ2EE Technologies\n               \n\n\nJDBC, Servlets, JSP, Struts\nDatabase\n                               \n\n\nOracle 9i, MySQL\nApplication Server\n               \n\n\nWebLogic8.0\nWeb Server\n                           \n\n Apache Tomcat 5.0\nOperating Systems\n           \n\n\nWindows 98/XP\nScripting Language\n\n\n\nJavaScript\n\nAreas Of Interest\n\n         \nJava,J2EE\n\n         \nDatabase Concepts\n\n\n\nPROJECT EXPERIENCE\n\nProject#1\n                                                                                          \nOct?06\n ? till date\n\nTitle\n                              \n: Realist \nClient \n                         \n     \n: First American Real Estate Solutions \n          \nSoftware\n                      \n\nCore Java, JDBC, Servlets, JSP, Oracle 9i as backend.\nTeam size\n                  \n     \n\n\n\nDescription\n          \n\n\nRealist is a product, which delivers multiple property search capabilities in an easy-to-use Web application. Customer can use Realist to locate properties by street address, owner name or Assessors Parcel Number (APN) for a single subject or can use targeted search attributes to locate multiple properties.\n\nCustomer can find sales comparables using simple or comprehensive search requests, detailed property profiles, auto comps or custom sales comparable analysis, assessor maps, automated valuation, recorded document images, flood maps and street maps.\n\nResponsibilities:\n\n         \nInvolved in Analysis and Design. \n\n         \nResponsible for Development and Unit Testing\n\nProject#2\n                                                                                          \nDec?05\n ? Oct?06\n\nTitle\n                              \n: Online Stock Trading through \nMobile\nSoftware\n                      \n\nCore Java\n\nJDBC, Servlets, JSP, MySQL as backend.\nTeam size\n                  \n     \n\n\n\nDescription\n              \n    \n\nThe project is mainly intended to provide stock trading services to the customer on his/her mobile equipment i.e., getting data related to stocks in (near) real time. This service shall enable a mobile user to:\n\n         \nTrack predefined set of publicly traded shares.\n\n         \nThe authorized customer can Buy/Sell shares through mobile.\n\n         \nReceive alerts based on price levels and/or percentage change in the stock?s value.\n                 \nThus allowing the mobile user to trade shares by touching a button making the things more flexible and simpler with this application.\nResponsibilities:\n\n         \nPlayed an active role in Design, Development and Unit Testing.\n\n         \nResponsible for Coding of Components for GEX (GWN Enterprise Exchange) module.\n\n\n\n\nProject#3 \n     \n                                                                        \nJun?05 ? Nov?05\n     \nTitle\n                              \n\nMobile\n Ticketing\nSoftware\n                      \n\nCore\n\nJava, JDBC, MySQL as backend\nTeam Size\n                     \n\n\nDescription\n                  \n\n\n                                \n      \n\nobile Ticketing, a mobile application, provided for the mobile users to access Bus/Train Reservation services. The user can both enquire about Bus services, and can place an order to reserve tickets.\nResponsibilities:\n\n       \nPlayed an active role in M-Ticketing Design.\n\n       \nResponsible for M-Ticketing coding and Unit testing.\n\n\n\nPERSONAL PROFILE\nName\n\n                             \n      \n\n   \nJ.Ravindra Jhansi\nFather Name\n             \n      \n\n     \nJ.V.V.Satya Narayana\nDate of Birth\n\n                          \n\n\n28\nth\n July, 1983\nGender\n                            \n      \n\n\n\nFemale\nNationality\n                       \n      \n\n\n\nINDIAN\nPresent Educational Status\n    \n\n     \nB.Tech \nLanguages Known\n           \n       \n\n      \nEnglish, Hindi and Telugu\n                                                \nDECLARATION\n\n                      \n\nI here by declare that the information furnished above is true to my best of knowledge.\n\n\n\nPlace \n\nBangalore\nDate\n\n\n            \n                                                              \n                  \n\n\nJ.Ravindra Jhansi )',NULL,1,NULL,'2007-10-15',NULL,'2007-10-15','2010-06-08 12:13:25','2010-06-08',3,NULL,NULL,NULL,NULL,NULL,'0',NULL),(25,'Ram Mohan                   ',NULL,NULL,NULL,'rasvmsvsvkssvhirvsasvgar@rediffmail.com',NULL,NULL,'0','9823941686','0',NULL,'0','2009-10-28',NULL,NULL,'2010-06-08 12:13:25',10,'0',NULL,'200710/15/ATT8017.html','200710/15/DOC15868.doc','RESUME\n\nCURRICULAM VITAE\n\n\nName:\n\nRam Mohan\n                   \nE-mail:\n\nrasvmsvsvkssvhirvsasvgar@rediffmail.com\n\n                                 \n           \nMobile\n No.: \n9823941686.\n   \n\n\nSummary:\n\n\n Having 4.5\n\nyears of experience in software development, implementation, documentation, system \nstudy\n and\n    \n   \nIntegration. \n\nObjective:\n\nTo continue to work in a challenging and fast paced environment, leveraging my current knowledge\n\nand\n\nfostering creativity, with many learning opportunities\n\n\nWork Experience:\n\n\n\nPresently working in \n\nGlobal Technology centre (HSBC)\n, Pune as Software Engineer.\n\nWorked with \nGlobal Infotech, \nNigdi, Pune, as Software Developer.\n\n      \n\nEducational Qualification:\n\n\n1997-2001 B.E. (Computer Science & Engineering) from Government College of engineering From Dr.BAMU, Aurangabd, Second Class (59.97).\n\n1996-1997 H.S.C. From Mahatma Gandhi Mahavidhyalaya, Ahmedpur, Dist:-Latur,\nAurangabad\n Board, Distinction (88.83%).\n   \n\n1994-1995 S.S.C. From Yashvant vidhyalaya, Ahmedpur. Dist:-Latur \nLatur Board, Distinction (86.87%).\n\n\n\nComputer Skills:\n\nLanguages: \nC, C++, JAVA2. \nWeb Technologies:\nServlets, JSP, JDBC, HTML, XML. \nDatabases: \nPL/SQL, Oracle 10g, MS Access2000.\nApp. Servers:\nTomcat 4.0.1, JAVA WEB SERVER2.0, IIS.\nO.S.: \nMS-DOS, Windows 98/NT/2000/XP,\n\nAIX 5.3\nOthers:\nPhotoshop.\nAwareness:\nWeb logic (BEA), Websphere (IBM),\n\nJAVA Struts.\n\n\nPROJECTS\n\n#1. SABB IPO\n\n\nClient Name:\nHSBC(Global Technology)\nModule Name:\nSIMS IPO Management System.\n     \nTeam Size:\n\n       \nDuration:\n\nOct 2005 to Feb2007\nOperating System\n     \nAIX 5.3,Windows 98/XP/2000,\nWeb Technologies\nJ2EE, Hibernate 3.1,Java Script\nDatabase\nOracle 10g\nWeb Server\nWebsphere 5.1,Tomcat 4.0/5.1\n\n\nProject Description\n\n\n         \nSIMS is web based IPO Management System used by SABB\n\nThe system consists of several processes that can be exercised using a web-based user interface. The system requires users to authenticate themselves before using any of the functions. A user credentials determines the role which in turn determine the functions available to the user.\n\nThe system in all has 6 types of user roles.\n    \n\n\nCSR (Customer Service Representatives)\n    \n\n\nSupervisors\n    \n\n\nIPO Manager\n    \n\n\nLocal IPO Manager\n    \n\n\nSecurity Manager\n    \n\n\nVolume Manager\n\n   \n\n\nAdministrator\n\nThe subscribers from the participating banks can subscribe for an IPO in 3 ways, By filling up a pre-printed form which is handed over to the CSR (Customer Service Representative) or by providing the details verbally to the CSR or through pre-load from previous IPO?s. Some participating banks choose to use ?screen scraping? for data-entry.\nIt deals with the receiving of applications from participating banks. The banks receive the application form & payment from the customer for shares/debentures and feed, update the data for the applications during the term of the share issue.During the acceptance of applications for shares user can update, delete, modify the existing information for any application after getting permission from corresponding bank?s IPO manager?s.\n        \nOnce the issue is over which depends on the duration suggested by Tadawul the shares are allocated to the applicants and various final reports are generated for share allocation and refund of amount. These reports are than verified by banks and then sent to the Stock Exchange (TADAWUL).\n        \nReports for daily statistics of applications received from banks are generated and sent to corresponding banks for their verification.\n\nQuinnox is responsible for maintaining and enhancing the application and assisting SABB in smoother execution of IPO.\n\n   \nResponsibilities:\n     \n\n     \nInvolved in interacting with client to understand the requirements.\n     \n\n     \nWorked on Workflow integration and workflow definition for different module.\n     \n\n     \nDevelopment of different modules using server side components. \n     \n\n     \nInvolved in deployment of application using Websphere \n     \n\n     \nPost-implementation and maintenance support to the client during various IPOs.\n\n   \nKey IPO\'s Handled:\n1)\n      \nTitle: EMAAR IPO (It is the biggest IPO till date in \nSaudi Arabia\n\n   \n                \nClient: Saudi Arabia British Bank (HSBC)\n                 \n                                                    \n                          \n                \nTeam Size: 5\n                                     \n                \nRole: Team Member\n      \n    \nIn this IPO 12 banks were participated such as Saudi American Bank, Saudi Fransi Bank, Saudi Holandi Bank,\n    \nNational commercial Bank etc.\n\n2)\n      \nAlhokair IPO, Malath IPO, AL-BABTAIN IPO, AL-MARAI IPO, SICCI IPO, Takaful IPO, Aldrees IPO, \n      \nSABIC SUKUK IPO.\n\n   \nKey Rights Issue Handled:\n\n1)\n      \nTAIBA Right Issue, Albahri Right Issue, SABIC Right Issue.\n\n\n\n#2. SABB MULTI IPO\n\n\nClient Name:\nHSBC (Global Technology)\nModule Name:\n\nMULTI IPO MANAGEMENT SYSTEM\n     \nTeam Size:\n\n       \nDuration:\n\nFeb 2007 to tillDate (Under UAT)\nOperating System\n     \nAIX 5.3,Windows 98/XP/2000,\nWeb Technologies\nJ2EE, Hibernate 3.1,Java Script\nDatabase\nOracle 10g\nWeb Server\nWebsphere 5.1 \n\n\nProject Description\n\n\n         \nMulti IPO Management System is Web based IPO Management System, which is accessible through Internet to the participating banks. This system runs different IPO\'s at a time. Users are allowed to see English and Arabic versions of system. Each IPO has its IPOCODE defined by TADAWUL (Saudi Stock Exchange) which is entry point for users to log in to the system.\n\nA user credentials determines the role which in turn determine the functions available to the user.\n\nThe system in all has 7 types of user roles.\n    \n\n   \nCSR (Customer Service Representatives)\n    \n\n   \nSupervisors\n    \n\n   \nIPO Manager\n    \n\n   \nLocal IPO Manager.\n    \n\n   \nSecurity Manager\n    \n\n   \nVolume Manager\n    \n\n   \nAdministrator\n\n\nDaily Reports, Refund files and final reports are generated separately for each IPO. \n\n\nResponsibilities:\n        \n\n    \nDevelopment and testing of different modules and roles.\n        \n\n   \nInvolved in deployment of application using Websphere.\n        \n\n   \nInvolved in client interaction for requirement of multi IPO system.\n\n       \n\n#3. Known-You-Seed\n\n\nClient Name:\nKnown-You-Seed, Pune.\nModule Name:\nDatabase Software. \n     \nTeam Size:\n\n       \nDuration:\n3 Months\nTechnologies:\nJsp1.2, JDBC, Html, Ms-Access\n\n\nDescription\n: A \nTaiwan\n based Agriculture company. We designed a web project for this company .It involved delivering varieties seeds, varieties of fruits, advancedment in floriculture. This web project maintains database and information of all varieties of seed, their details about it. Along with this we are created payroll system, maintaining employee database etc. \nMy Role\n\n\n\n         \nSoftware Developer\n\n\n\n\nOther Projects\n\n\n#1. Database Software\n\n\nClient Name:\nGlobal InfoTech, Nigdi, Pune.\n     \nTeam Size:\n\n\n       \nDuration:\n3 months \nTechnologies:\nJsp1.2, Servlet2.3, JDBC, Html, Tomcat Webserver4.1, MS Access 2000.\n\n\nDescription\n: This project consists of developing a database software for Global InfoTech and Global Consultancy \nServices. It is mainly consists of detail information about all courses conducted, different facilities it provides.\n               \nLists of ongoing and completed projects, information about the firm, about registration By using Java servlet all information is fetched from server. Tomcat web server is used. This information about courses conducted by Institute. Also registration information is stored in database using the servlet and JDBC.\n              \n\nMy Role\n\n\n\n          \nSoftware Developer.\n\n\n\n\n\n\n\n\n\n#2.Other Softwares\n\n\nClient Name:\n\nAgricultural Development Trust, Baramati, Pune.\n     \nTeam Size:\n\n       \nDuration:\n6 months\nTechnologies:\nJAVA2, VB, Ms-Access,HTML, PHOTOSHOP.\n\n\nSoftware \nDescription:\n\n   \n1.Educational Website :\n\nIt is a Educational website of Agricultural development trust, Shardanagar, Baramati. It gives the \n\n\nOnline Information about colleges, schools, Krushi Vigyan Kendra, and various study streams, agri-firm \n\n\nRun by Agricultural Development trust.\n Animation created on environment pollution, Nature, Nationality, on various \n  \n\n\nsubjects for kids of Sharada school run by Agricultural Development Trust, Baramati, and Pune.\n\n\n2.Online School:\n     \nThis project designed for a school located at Manchar,Pune.\n     \nIt maintains database of all students of school. School, online admission system, e-mail, chat, record of all\n\n     \nemployees and their salaries, all about different facilities provide this project. This project we are designing\n     \nUsing java technology.\n\nMy Role\n\n          \nOffline Development of shardanagari.org. Scanning, uploading, and formatting various images.\n\n\n\n\n\n                        \nPersonal Information:\n\nName:\nRam Manoharrao Kshirsagar.\nD.O.B:\n05 ? Jan ? 1980.\nAddress:\nRahega Woods, Nightingale, Wing ?A?, Flat No: 401,Kalyaninagar, Pune\nNationality:\nIndian.\nMarital Status:\nSingle.\nSex:\nMale.\nLanguages:\nEnglish, Hindi, Marathi.\nHobbies:\nReading\n, Listening Music.\n\n\n\n\nDate:\n\n\n    \n/2007.\nPlace:\n Pune.\n\n\n                                                                                                        \nRam M.Kshirsagar.',NULL,9,NULL,'2007-10-15',NULL,'2007-10-15','2010-06-08 12:13:25','2010-06-08',10,NULL,NULL,NULL,NULL,9,'0',NULL),(26,'S srinivas',NULL,NULL,'Bangalore','spfbeak2fbdbfredfdbfdy@gmail.com',NULL,NULL,'0','919980403869','0',NULL,'0','2006-11-12',7,18,'2010-06-08 12:13:25',10,'0',NULL,'200710/15/ATT8016.html','200710/15/DOC55860.doc','                                            \n     \nS.SRINIVAS \n\n\nE-mail\n\nspfbeak2fbdbfredfdbfdy@gmail.com\n\n              \n                        \nPhone\n\n+919980403869\n_____________________________________________________________\n\n\nCareer Objective\n\nInterested to work in a dynamic environment to develop zero defect software and handle clients effectively using the knowledge acquired to the best of my capabilities, thereby contributing to the progress of organization and hence growing personally.\n\nPersonal Strength\n\n       \nComprehensive problem solving abilities\n       \nExcellent verbal and written communication skills\n       \nWillingness to learn\n       \nTeam facilitator\n       \nAbility to deal with people diplomatically\n\nExperience Summary\n\n\n             \nHave 3+ years of experience in \nJava\n and its related technologies\n\n\n             \nExperience in \nWeb Component development using Servlets and JSP\n\n\n             \nExperience in development of web based GUI?s using \nJSP, HTML\n\n\n             \nKnowledge in developing components using \nEJB\n\n\n             \nGood Implementation Knowledge\n\nin\nStruts Framework\n\n\n             \nExperience in Application server \nWeblogic\n\n\n             \nExcellent communication and inter personnel skills.\n\nPROFESSIONAL EXPERIENCE\n\n\n             \nWorking as a Software Engineer in \nPatni Computers\n., \nBangalore\n from 2006 July-Till date.\n\n             \nWorked as a Software Engineer in Satyam\nComputers\n\nBangalore\n from 2004 May-2006 June.\n\nEDUCATION\n\n             \nB.E\n\nE&CE\n) from \nVTU\n, Karnataka.\n\nTECHNICAL SKILLS\n\nJ2EE Technologies\n                    \n: JDBC,Servlets,JSP,EJB,Struts\nProgramming Languages\n            \n: C, JAVA, PL/SQL\nApplication Servers\n             \n        \n: Weblogic \nWeb Servers\n                     \n         \n\n: Tomcat\nRDBMS\n                              \n         \n: Oracle\nOperating Systems\n           \n\n         \n\n: Windows 2000/NT\nData Repository\n                           \n: Microsoft VSS, WIN CVS.\n\n\n\nPROJECT PROFILE\n\nProject #1\n\nTitle\neCommunication\nOrganization\nPatni Computers,\nEnvironment\nJava, JDBC, Servlets , JSP, Struts, Oracle, Weblogic\n   \nDuration\nFrom\n\nJune-2007 to till date\n\n\nDescription:\n\n                    \neCommunication\n is a web based Campaign Management Solution intended to help the promotion division by sending the promotional details and product information to partners through E-mail. \neComm\n helps achieving optimal results from targeted, permission-based, direct marketing campaigns. The main objective is to broadcast communication, as well as track results.\n                    \neCommunication\n is a solution to provide mass communication and help to establish enduring relationships with customers. It facilitates communicating to large audiences using email.\nThe solution not only helps in promoting products in a very personal way, but also provides customized technical information about services offered. It helps deliver business communication in the electronic form. It has a subscription page on the Partner Portal where a partner can select desired product, program and other areas for emails.\n\nA partner would also be able to subscribe/unsubscribe to individual newsletters, set e-mail preferences. It includes partner ability to select to receive alert in HTML or plain text format. \n\nContribution\n\n\nAs a team member, was responsible for\n\n       \nApplication Enhancements according to the change requests.\n\n       \nDesigning new forms for the change requests and integrating to the existing application.\n\n       \nCoding the Page Controllers (both Business Logic and API).\n\n       \nDeveloped Struts ActionClasses, ActionForm Beans.\n\n       \nResolve issues logged into Test Director by Business Team based on urgency.\n\n       \nUnit testing and Integration Testing of the application, detecting the bugs and fixing them.\n\n\nProject #2\n\nTitle\nAyushman.net\nClient\nImage Fusion Pvt Ltd., Chennai.\nOrganization\nPatni Computers,\nEnvironment\nJava, JDBC, Servlets , JSP, EJB, Oracle, Weblogic\n   \nDuration\nFrom\n\nSept-2006 to May-2007\n\n\nDescription:\n                   \n                    \n  \nAyushman.net\n has exhaustive information on every aspect of human activity. This portal consists of different channels namely Universal, Health, Doctor and Corporate. Universal channel provides various services required for day to day life activities. Calendar keeps the schedule of various occasion and appointments of the user. Chat is provided with public and private. Apart from this, Jobs, Education, Matrimonial and Astrology are dealt in detail with the knowledge of experts. Health channel provides Health records online, Online Consultation, Online Appointments, Forum etc. Health record is a paid service where the user can have their health records online which can be accessed from any part of the world. This helps the user while travelling to various countries without carrying their health records. Online Appointments can be fixed with registered doctors in ayushman.net. User can make use of the online Consultation with registered doctors. Queries will be placed in forum on different topics, which will be answered by the experts. Doctor channel provides various services to doctors, medical students and paramedical students. Corporate channel contains information about the registered doctors and their hospital infrastructure.\n\n\n\nContribution\n\n\nAs a team member, was responsible for\n\n       \nApplication Enhancements according to the change requests.\n\n       \nDesigning new forms for the change requests and integrating to the existing application.\n\n       \nCoding the Page Controllers (both Business Logic and API).\n\n       \nResolve issues logged into Test Director by Business Team based on urgency.\n\n       \nUnit testing and Integration Testing of the application, detecting the bugs and fixing them.\n\n\n\nProject #3\n\nTitle\nwww.forwardptu.org\n\nClient\nPunjab\nTechnical\nUniversity\nOrganization\nSatyam Computers,\nEnvironment\nJava, JDBC, Servlets, JSP, EJB, Oracle, Weblogic\n   \nDuration\nFrom Nov-2005 to June-2006\n\n\nDescription:\n\n   \n                  \nPunjab Technical University\n offers a best interactive and digital distance learning environment. This software deals with PTU details, Course details and Centre details. Virtual Learning provides entire online learning for students by TELE-ED. Virtual Exam conducts the exams in online for students and the result is sent to them after evaluation. Virtual Library designed to maintain and manage the library over web. It has the facility to view the available books. Online book request is done by the user and it is the best index and search for the learning materials.\n\n\nContribution\n\n\n As a team member I was responsible for\n\n       \nAnalysis of Specifications provided by the clients.\n\n       \nDesign and Development of forms using JSP\n\n       \nCoding in JAVA and HTML/DHTML in Page Controllers.\n\n       \nTesting the code and writing test cases for unit testing, Integration testing, System \n                 \n         \n             \nTesting, Role and Navigation Testing.\n\n       \nDefect Fixing.\n\n       \nDelivering the developed code and Fixed Code.\n\n       \nReview of Deliverables.\n\n       \nOverseeing the Quality procedures related to the project\n\n\n\n\nProject #4\n\nTitle\nERIS\nClient\nKanrad Technologies Inc., CA, \nUSA\nOrganization\nSatyam Computers,\nEnvironment\nJava, Servlets, JSP, EJB, JDBC, JavaScript, Oracle, Weblogic.\nDuration\nFrom Aug-2004 to Sept-2005.\n\nDescription:\n\n          \n          \nEnterprise Resource Information System-ERIS\n is a web based tool to recruiting agencies and software consultancies. Especially in fast growing it market technologies are changing very fast, based on technology trend organizations has to recruit the people. This process will make recruitment process very easy and fast. This system is designed by keeping in mind with both parties like job providers and job seekers. The main objective of this project is to make easy the recruitment process of any organization.\n\nContribution\n   \n\n Analysis, Design and Development, Coding, Testing and Review of Deliverables.\n    \nAs a team member, was responsible for\n\n      \nAnalyzing and designing the system.\n\n      \nDeveloping and \nCoding \nWeb Pages\n using HTML pages, JSP \n\n       \nCoding the Page Controllers, Integrating the Web Pages.\n\n      \nUnit Testing, Integration Testing.\n\n      \nTracking Issues, Logging Issues, and Resolve issues logged based on urgency.\n\n      \nDatabase Maintenance\n\n\n\nTRAININGS ATTENDED:\n\n(In Occurrence of past Events)\n\n\nSl#\nTitle\nLocation\nOrganized\n\nby\nDuration\n\nJAVA and Servlet\nHyderabad\nSatyam Computer Services Ltd.\n12 Days\n\nQuality Management Service\nHyderabad\nSatyam Computer Services Ltd.\n2 Days\n\nDefect Prevention\nHyderabad\nSatyam Computer Services Ltd.\n1 Day\n\n\nSQL\nHyderabad\nSatyam Computer Services Ltd.\n2 Days\n\nEJB and Weblogic\nHyderabad\nSatyam Computer Services Ltd.\n4 Days\n\nEmail Communication\nBangalore\nPatni Computers\n4 Days\n\nOOAD/UML\nBangalore\nPatni Computers\n4 Days\n\nOS Concepts, C\nBangalore\nPatni Computers\n7 Days\n\nStruts, XML\nBangalore\nPatni Computers\n7 Days','Patni Computers',9,NULL,'2007-10-15',NULL,'2007-10-15','2010-06-08 12:13:25','2010-06-08',10,NULL,NULL,NULL,NULL,9,'0',NULL),(27,'K.Venkatramana                                                                                     ',NULL,NULL,NULL,'vesdafsfnkatramsafsafanas@gmail.com',NULL,NULL,'0','9440 634139','0',NULL,'0','2008-05-30',NULL,NULL,'2010-06-08 12:13:25',10,'0',NULL,'200710/15/ATT8015.html','200710/15/DOC55861.doc','Ajay Joshi\n\n\n\n\n\nRESUME\n\n\nK.VENKATRAMANA\n\n                                                  \n                                                 \n\nMobile\n No\n:9440-634139\nEmail\n\n\nvesdafsfnkatramsafsafanas@gmail.com\n\n________________________________________________________________________\n     \n\n\nEXPERIENCE SUMMARY\n\n                    \nHas professional experience in debugging, coding & development of internet applications and implementation of business application systems in 3 Tier Client/Server environments and Web application Development. Has keen problem solving ability and\n\nused\n   \nJava\n/J2EE/Struts\n on \nweblogic \nServer. Team player with strong technical, interpersonal and communication skills. Extensive experience in java, Struts, Servlets/JSP, EJB, SQL Plus, strong development and analytical skills\n\n\n\n\nWORK EXPERIENCE\n\nCurrently Working as a Software Engineer for \nOxygen Networks Pvt Ltd, \nsince\n\nNOV\n   \n2005\n\n\n\nWeb Site: \nwww.oxynetworks.com\n\n\nEDUCATIONAL QUALIFICATIONS\n\n\n\n         \nMaster of Computer Applications \n(MCA)\n from \nOsmania\nUniversity\n\n\n         \nBachelor of Electronics \n(B.Sc Electronics)\n from \nOsmania\nUniversity\n\n\n\nTECHNICAL SKILL SET\n\n\nOperating Systems:\n\nWindows 95/98/2000/XP\nCore Java, JDBC, RMI\nJ2EE 1.4\n   \n: EJB 2.0, JSP, Servlets\nApache Technologies\n\n: Struts\nHTML, Java Script ,\nAJAX\n\nin Struts\n                                          \n        \nDatabases:\n    \nOracle 8, and MS-Access\n   \n           \nWeb Servers: Weblogic 8.\n\n\n\n\n\n\nPROJECT DETAILS\n\n\n\n\n\n\nCITI Bank Online Investment Service\nClient\nCiti group\n\nUSA\n\nRole\nSoftware Engineer\nOrganization\nOxygen Networks Pvt. Ltd\n\n\nDuration\nJun\n\n2006 to\n   \nTill Date\nEnvironment\nTechnologies\n\n: Java, EJB ,Web Logic Server ,Struts\nDatabase\n        \n\nOracle\nWeb Based\n         \n\nJSP, XML, HTML, JavaScript\nO/s\n        \n            \n\nWS 2000\nTeam Size\n   \n\n\n\nProject Description in brief:\n\n\nCiti Bank Online Investment Service\n is a B2C Application, exclusively for the \nCITI\n\nGroup\n users holding accounts with Citibank . It provides the electronic banking platform, allows investors to make automated active investments into a wide variety of short-term investments.\n\nIf any investor or company wants to invest money into CITI bank, they must contact Business Entity. Business entity is like a broker between the Client and Trading Desk. Trading desk is a logical entity. CITI group divides some geographical regions as trading desks. CITI bank provides six products, Time deposits, Commercial paper, Certificate of deposits, Repos, Mutual Funds and CRA.CITI bank clients can do trading for any of these products.\n\nEach Trading Desk has Some Branches. Each Branch has some Global Business Units and Each Global Business Unit (GBU) attached one or more than Business Units. Every Business Unit (BU) has Settlement accounts, which are the actual transaction carried on. Broker and Trader longs to Trading Desk, Salesperson belongs to a branch and External Client Belongs to a Global Business Unit. Time deposits are Interest-bearing deposits at a savings institution that has a specific maturity.\n\n\n\nContribution\n\n\n\nStruts\n implementation of the various modules. \n\nInvolved in developing user interfaces by using JSPs/HTML/JavaScript.\n\nCoding using Java, Servlets, JSP,EJB , HTML and JavaScript.\n\n\n\n\n\n\n\n\n\nTax Management (IRS Tax Forms)\nClient\nJpMorgan Bank.\nRole\n\nSoftware Engineer\nOrganization\nOxygen Networks Pvt. Ltd\nDuration\nNov\n\n2005 to Jun, 2006\nEnvironment\nTechnologies\n\n\nJava, EJB ,Web Logic Server \nDatabase\n        \n\nOracle\nWeb Based\n     \n\nJSP, XML, HTML, JavaScript\nO/s\n                 \n\nWS 2000\nTeam Size\n   \n\n\n\nTax Management \n(IRS Reports)\n\n           \nThis project is intended to serve some multi national companies. In this project we are providing a gateway where in a company can register with this gateway and can get a report of all the funds associated to it. In this gateway we collaborate with various banks to access all the details of the participating firm. In this gateway we are providing the participating firm with the a unique login through which it can check all the transactions of all accounts associated to it, bank wise and account wise. As desired by the firm. Initially we show only the summary report which can be expanded and the grouping criteria can also be defined. In this project we also provide the firms with the regional reports and global reports. \n\n\nThere are various types of reports namely cash Flow, Investment, Projections, Balances etc. \nThe other major part of this project is tax Reporting. In this we have tax entry screens as specified by IRS. \n\nSome of them are \n\n1099-INT\n (Interest Income)\n1099-DIV\n (Dividends and Distributions), \n1099-OID\n (Original Issue Discount),\n1042-S\n (Foreign Person\'s U.S.Source Income Subject to Withholding),\n1099-MISC\n (Miscellaneous Income)?etc\n\nContribution\n\n\n\nCoding using\n\nJSP,EJB , HTML, JavaScript\n\nin MVC architecture (\nSTRUTS\n).\nInvolved in developing user interfaces by using JSPs/HTML/JavaScript.',NULL,9,NULL,'2007-10-15',NULL,'2007-10-15','2010-06-08 12:13:25','2010-06-08',10,NULL,NULL,NULL,NULL,9,'0',NULL),(28,'S saha',NULL,NULL,NULL,'sascschascccscsujay@gmail.com','sujaysaha@aol.com',NULL,'0','9342567092','0',NULL,'0','2008-04-29',NULL,NULL,'2010-06-08 12:13:25',10,'0',NULL,'200710/15/ATT8014.html','200710/15/DOC55862.doc','TRUPTI RANJAN MISHRA\nS SAHA\n\n91-9342567092\nsascschascccscsujay@gmail.com\nsujaysaha@aol.com\n\n\nPrelude:\nA Graduate in ?\nBE in Information Technology?.\n Having a total IT experience of 2+ years, in application development with proficiency in database-driven web application development using J2EE technologies. I am having clear and good understanding of Object Oriented Programming concepts and JAVA as a basic skill set. As a quick Learner and a strong understanding capability, is Capable of switching to any domain or functional area and skill set easily within a limited time frame. Basically a Person with very Positive attitude and can give its best Commitment towards its Employer and adheres to all the quality processes and techniques required to deliver optimum quality results for an organization.\n\n\nWork Experience:\n\n          \nPresently working as an S/W Engineer at \nVERNA INFO SOLUTIONS, \nBANGALORE\n\nfrom July, 2005 to till date.\n\ntechnical Background:\nSkill Name\nExpertise\nLanguages\nJava\nOperating System\nWindows 2000\nJava Technologies\nServlets, Jsp, EJB, JDBC.\nServers\nweblogic 8.1\nDatabases\nOracle 9i\nIdes\nJBuilder\nWeb Technologies\nHTML\nFrame work\nStruts 1.1\n\nProject Experience\n                                                            \n                                                          \n       \n                    \n1.Client: \n\nEarthbase Infotech\n, Pune\nProject Name:\nShoppemen (Business-to-business)\nStart Date\nFEB-2007\nEnd Date\nTill date\nTechnologies\n\n          \nWin2000.\n\n          \nJava, JSP, JavaBeans, Servlets, EJB, Struts, JDBC, WebLogic, Oracle 9i.\n\n\n          \nWeb Logic Application Server.\nRole and responsibilities:\n\nProgrammer\nInvolved in development of Controller part using STRUTS technology. \n\n          \nInvolved in creation of business logic implementation model layer using EJB, JTA, JDBC.\nProject Summary\n\n      \nB2B (Business-to-Business) is the term, which informs us about the business. This concept is build keeping in mind that the business related activities. Basically in our business we incur some terms such as Auction, Bidding, On-line Shopping, Advertisement, Tender, Buyer, Seller etc. We are all familiar with all the terms. We have many web portals, which deal with activities such as Buying, Selling, and Bidding etc. Bizz Trax is such a web portal, which deals with such activities sited above. In short we can say that Bizz Trax is a B2B portal.\n\n\n2.Client: -\n- Restored Media Technology\n, Ambarnath East, Maharastra\nProject Name:\nOnline Java/J2EE Portal\nStart Date\nMAY-2006\nEnd Date\nJAN-2007\nTechnologies\n\n          \nWin2000.\n\n          \nJava, JSP, Servlet, EJB, JDBC, Oracle 9i.\n\n\n          \nWeb Logic 8.1 Application Server.\nRole and responsibilities\n: Programmer \nInvolved in developing components for managing efficient data flow using JavaBean.\nInvolved in creation of components for interaction between Controller layer, Model layer and Database tier using EJB, JDBC, and JTA.\nProject Summary\n\n      \nThe primary scope of the proposed application was to design, develop, test and deliver a web based application that would enable end users to get and give project guidance through online. Out side cities of this proprietor office, B.E/B.TECH/M.C.A student can get online Project guidance for their final year project, as well as experienced professionals would earn money providing guidance in their corresponding cities to the service seekers, registered with this site. Except guidance students can also do download free related software, demo-project, e-books etc. But they all should be a registered user. \nThe high level functionality of the application will be : \n\n          \nUser Registration\n\n          \nStudent Details\n\n          \nGuide Details\n\n          \nOnline Payment & validation of user balances\n\n          \nDownloading\n\n3.Client: Expo for Gifts and Souvenirs, \nAsmara\nEritrea\n\nEast Africa\n\nProject Name:\n Multilingual Web Mail Application\nStart Date\nSEPT-2005\nEnd Date\nAPR-2006\nTechnologies\n\n\n          \nOS Platform: Windows 2000, Linux (Fedora Core 4)\n\n          \nApplication Development Tool: Eclipse 3.1, DreamWeaver2004, MySQL query browser. WinVisio2003\n\n          \nDatabase: MySQL 4.0\n\n          \nJava APIs: JAF, JavaMail, Servlet, JSP, JavaBean, JDBC\n\n          \nMiddleware: Hibernate3.0\n\n          \nThird party library: inetfactory.jar, common-upload1.1.jar for socket programming and files uploading. \n\n          \nWeb Dev. Language: HTML, CSS, JavaScript\n\n          \nWeb Server: Tomcat-5.0.25.\n\n          \nMail Server: James-2.2.0 (Java Apache Mail \nEnterprise\n Server), SMTP, POP3\n\n          \nMailScanner: MailScanner, SpamAssissin\n\n          \nAntivirus: clamAV0.88\n\n          \nWeb Security: SSL, Obfuscator\nRole and responsibilities:\n\n\n         \nCode developing.\n\n          \nDebugging and Implementation.\nProject Summary:\nThis project is a cross browser portable application; developed based on \njava Unicode\n to provide the \nmultilingual\n\nfunctionalities\n (Geez, Amharic, Trigna African languages). A user can access the application in these three different languages. The core parts of this project are \n\n.New User creation in the mail server and database. \n\n. Changing password and retrieving forgotten password \n\n. Sending and receiving the mails for the user. \n\n. Sending mail automatically \n\n.Composing the formatted text mail in three different languages based on java unicode.\n\n. Inbox, out box, Draft folder, maintaining the deleted mail in database. \n\n. Address book maintenances, \n\n.Job scheduling. \n\n. User payment maintenance. \n10.\n Blocking particular users and domains.\n\n\neducation:\nExamination\nInstitution and University / Board\nMarks(Per./Grade)\nB.E. in Information\nTechnology(2005)\nPurushottam Institute of Engineering & \nTechnology\n   \nand\n    \nSambalpurUniversity\n68\nClass 12th\nSaktinagar\nHigh School\n and W.B.C.H.S.E\n73.5\nClass 10th\nSaktinagar\nHigh School\n and W.B.B.S.E\n79\n\nPERSONAL PROFILE:\nName\n\nSujay Saha.\nFather?s Name\n\nSubodh Kumar Saha\nMother?s Name\n\nMamata Saha\nDate of Birth\n\n3rd March,1981\nSex\n\nMale\nMarital Status\n\nSingle\nPassport No\n\nG-1325668\nLanguages Known\n\nEnglish, Hindi, Bengali.\n\nDECLERATION:\nI do, hereby declare that the above stated particulars are true to the best of my knowledge and belief. \n                       \nDate\nSUJAY SAHA',NULL,9,NULL,'2007-10-15',NULL,'2007-10-15','2010-06-08 12:13:25','2010-06-08',10,NULL,NULL,NULL,NULL,9,'0',NULL),(29,'L santhosh',NULL,NULL,'Hyderabad','sandvdvthosh2dvsd504@gmail.com',NULL,NULL,'0','9247194401','0',NULL,'0','2007-06-14',7,19,'2010-06-08 12:13:25',10,'0',NULL,'200710/15/ATT8013.html','200710/15/DOC55863.doc','L.Santhosh\n\n+91?9247194401\n        \n                       \n                                                \nsandvdvthosh2dvsd504@gmail.com\n\nProfessional Summary\n\nHaving 2.7 years of experience in software development using java technologies with a full insight of software development lifecycle.\nExperience in object oriented programming and development using Java, Database and J2EE applications.\nTechnical knowledge of J2EE technologies (EJB, Struts, Hibernate).\nWorking knowledge of advanced java technologies and J2EE Technologies including JDBC, Servlets, JSP, Struts.\nParticipated in software building from designing areas till client site deployment and client interaction.\nHave achieved client accolades and appreciations from my team for successful project module delivery in time with perfection and full satisfaction.\n\n\nExperience Summary\n\nWorking as a Software Developer for \n\n-Infosoft\n technologies\n, since \nDecember-2004\n to \ntill date\n\n\n\nTechnical Skills \n\nOperating System\n   \n   \n\n\n   \nWindows 98/2000/XP.\nLanguages \n               \n  \n\n\n     \nJava.\nWeb Technologies\n\n  \n\n\n\n     \nServlets, JSP, JDBC, Hibernate, EJBs.\nDistributed Tools\n       \n\n\n    \nRMI.\nWeb Servers\n             \n  \n\n\n    \nApache Tomcat.\nApplication Servers\n\n\n\n\n    \nBEA-Weblogic.\nFramework\n               \n\n\n\n\n    \nStruts.\nWeb authoring\n         \n  \n\n\n    \nHTML, Java Script, and XML.\nDatabase Systems\n\n  \n\n\n\n\n    \nOracle, MySQL.\nTools\n\n                       \n  \n\n      \nMy Eclipse, Exadel studio.\n\n\nAcademic Profile\n   \n\nB.Tech \nin\n Computer Science Engineering\n from Jawaharlal Nehru Technological University, \nHyderabad\n\n\n\n\n\n\n\n\n\nProject Profile:\n\nProject: 1\n\nTitle\n                   \n\n\n   \nCORPARATE RECRUITMENT SYSTEM (CRS).\nClient\n\n              \n  \n\n   \nBrain ware Systems, \nU.K.\nDuration\n\n         \n  \n\n   \n\nune?06 to\n Till Date.\n\n\nDescription:\n\n           \nCorporate Recruitment System CRS is a web-based tool to reduce communication gap between job providers and job seekers. Especially in fast growing IT market Technologies are changing very fast, based on technology trend organization has to recruit the people. This process will make recruitment process very easy and fast.\nThe main objective of this solution is to make easy the recruitment process of any organization. Because of online test supports by this system-conducting exam will become very easy for job seekers.\n\nResponsibilities:\n\nDeveloped the presentation layer using \nJSP\n\nUsed Struts Framework ?\nModel View Controller\n (MVC)\" architecture.\nInvolved in developing Actions, Validation Framework in \nStruts\n and server side programming.\nInvolved in developing the Jobseeker module.\nPerformed \nUnit Testing\n\n\nEnvironment:\n\nStruts1.1 Frame work\n\nXML\n\nMy Eclipse\n\nJSP\n\nServlets\n\nTomcat\n\nJDBC\n\nOracle.\n\nProject: 2\n\nTitle\n                \n     \n\n   \nHealth Highway\n\nClient \n                 \n\n   \nHealth Highway\nInc.CA\n\nUSA\n\nDuration \n        \n    \n\n\n    \nDecember ?05 to May ?06.\n\nDescription: \n                 \nThis project is mainly intended to help the hospitals, patients and Insurance companies make their daily routine work like appointments, billing and the application is coupled with HIPAA rules.\n\nThe billing is one of the most important modules useful for the electronic processing of all the patient bills. The reports are in such a flexi way to generate the custom reports by the clinic or given pre formatted reports.\n        \nWhen an insurance company logged in he can see the out-standing bills and also the patient associated with him. And when a patient logged-in he can check his status and also his billing procedure.\n\n\n\n\n\n\nResponsibilities:\nInvolved in \nCoding\n and \nUnit Testing\n\nInvolved in the design of the module appointments and Registration and reporting.\nInvolved in the development of \nJDBC\n code.\nDeveloped the \npresentation layer\n using \nJSP\n\n\nEnvironment:\n\nJava\n\nJDBC\n\nJSP\n\nXML\n\nSERVLETS\n\n\nTomcat\n\n\nOracle\n\n\nProject: 3\n\nTitle\n    \n             \n\n\n\n     \nPersonal Information system\n\nClient\n\n              \n\n\n     \nZodiac Consultancies.\nDuration \n        \n  \n\n     \nApril ?05 to October ?05.\n\nDescription: \n            \n                \nPersonal Information System provides information related to employers, in organization As well as about the candidates who are likely to be considered for overseas placements. This will also include resumes of candidates not working with company; Personal Information System has four models.\n       \nMaster Entry Module:\n\nThis module provides the full ?fledged details of a particular Employee or a Person.\n       \nModification Module:\n This module is used to update the records accordingly. The same master screens are used for updating also.\n       \nDeletion Module\n: This module is same as that of modification model. The user is not given access to the fields for updating .Only browsing is allowed before deletion.\n       \nReport Module:\n The module is the most important of all .It gives various reports to the user.\n\nRole and Responsibilities:\n\nInvolved in the coding of \nStruts frame work\n\nInvolved in the coding of \nJSP?s\n and \nJava Servlets\n for Master Entry Module.\nInvolved in the coding of the Deletion module.\n\nEnvironment:\n\nCore\nJava\n\nJSP\n\nMy Eclipse\n\nServlets\n\nJDBC\n\nStruts Framework\n\nXML\n\nTomcat,\n Oracle9i\n\n\n\n                                           \n                                                                   \nT.\nSanthosh\n                                        ','N-Infosoft technologies',9,NULL,'2007-10-15',NULL,'2007-10-15','2010-06-08 12:13:25','2010-06-08',10,NULL,NULL,NULL,NULL,9,'0',NULL),(30,'P.Rajasekhar    ',NULL,NULL,NULL,'sriergvenkataseegkhar@rediffmail.com',NULL,NULL,'0','91 9848532583','0',NULL,'0','2008-04-29',NULL,NULL,'2010-06-08 12:13:25',10,'0',NULL,'200710/15/ATT8012.html','200710/15/DOC55864.doc','P.Rajasekhar\n    \nEmail : \nsriergvenkataseegkhar@rediffmail.com\n                                                                 \n\nMobile:\n\n\n+91-9848532583\n___________________________________________________________________________\n\n\nObjective:\n\n\n           \n\nTo develop and maintain skills, becoming part of a good organization, which offers me professional growth while being resourceful, innovative and challenging.\n\n\nExperience Summary:\n\n\n       \n2+ years \nof experience as a \nSoftware Engineer\n in the development, implementation of the applications built using \njava\n and \nJ2EE\n technologies.\n\n       \nExperience in developing Client/Server & Web based Applications.\n\n       \nExtensive work experience in server side technologies like \nServlets, JSP, Struts, EJB,\n\nand JDBC\n\n\n       \nExperience in implementation of MVC architecture with \nStruts framework\n\n\n       \nWorked on \nthe application server like BEA WebLogic. \n\n       \nGood interpersonal skills, committed, result oriented, hard working with a quest and zeal to learn new technologies\n\n\n       \nAbility to work in-group as well as independently with minimal Supervision.\n\n\nEducation:\n\n\n          \nB.Tech, Electronics & Communication \nfrom\n JNTU\n, A.P. \nin\n\n2001-2005.\n\n\nWork Experience:\n\n\n          \nHave been working\n with \nSynergySoft Solutions, \n\nyderabad\n since May 2005 to till date as Software Engineer.\n\n\n\nTechnical Skills:\n\n\nLanguages\n                         \n\n     \n  \nJava.\nJava Technologies\n        \n      \n\n     \n  \nJDBC, Servlets, JSP, JNDI.\nFrame Work\n               \n        \n\n    \n\n  \nStruts1.2\nDistributed Technologies\n     \n\n    \n\n  \nEJB2.0\nMarkup Languages\n      \n      \n\n     \n  \n\nTML, XML.\nDatabase\n                     \n      \n\n     \n  \nOracle8i.\nWeb Server\n                        \n\n     \n   \nTomcat\nApplication Server\n              \n\n     \n   \nBEA Web logic \nTools & IDEs\n                \n      \n\n     \n   \nJBuilderX, Eclipse 3.0, CVS\nOperating Systems\n      \n      \n\n    \n   \n\nWindows 98/NT/2000.\n\n\n\n\n\n\nProfessional Experience:\n\nThe Client and project details are explained in reverse chronological order.\n\nProject #1\n\nTitle\n                  \n\n           \nSony Business to Business Applications.\nClient \n              \n\n           \nAFBT Services Company, \nSaudi Arabia\nTeam size\n        \n\n           \n\nDuration\n           \n\n          \nFeb 2007-Till date\nEnvironment\n    \n\n          \nJSP, Servlets, Struts, EJB, JDBC, Oracle8i, Weblogic server\n                     \nRole\n                 \n\n           \nTeam member\n                                  \nDescription:\n\nIt is one of the most modern application developed using rich functionalities of j2ee framework. It is designed to give the on time stock, complaints and order status information of Sony and Sony dealers of \nSaudi Arabia\n. Available modules include inventory, sales-orders, forecasting, services, and administration. It has designed to give high support to multi user environment ,good administration and generating and sending mails to clients.\nThis project is designed as per MVC architecture, EJB?S communication with data layer, Servlets acts as a controller and JSP?s used for presentation.\n\nResponsibilities:\n\n\n          \nDeveloped login mechanism using Struts framework.\n\n          \nCoding for connection and retrieval of data using JDBC.\n\n          \nInvolved in developing the business logic using EJB\n\n\n\n          \nDeveloped JSP pages for presentation logic.\n\nProject #2\n\nTitle\n                  \n\n          \nResource Management System\nClient\n               \n\n         \nSympro Technologies\nTeam size\n        \n\n         \n\nDuration\n            \n\n        \nMay 2006 to Dec 2006\nEnvironment\n      \n\n        \nJSP, Servlets, Struts, EJB, JDBC, Oracle8i, Weblogic Server\nRole\n                  \n\n         \nTeam member\nDescription:\n\nThe basic aim of this application is to ease the process of recruitment for the job seekers and the employers. In this application there are four major modules, i.e. Jobseeker module, Employer module, Administrator module, Marketers module. Administrator module maintains database comprising of job applicants, clients, employers and their updates, alerts and provide security to the end user. Employer module is meant for the Companies and the Consultants to select, short list, and schedule interviews for applicants, and lets the employers to choose the best of the applicants. Job seekers module gives wide range of scope for the job seeker to explore the exactly suited vacancies for their profiles. Marketer module lets the marketing section to look after the whole marketing related issues. \n\nResponsibilities:\n\n\n          \nDeveloped login mechanism using struts framework.\n\n          \nCoding for connection and retrieval of data using JDBC.\n\n          \nInvolved in developing the business logic using EJB\n\n\n\n          \nDeveloped JSP pages for presentation logic.\n\n\nProject #3\n\nTitle\n      \n           \n\n           \nEngineering\nVillage\n\nClient \n              \n\n           \nEngineering information Inc, \nHoboken\n\nNJ\n\nTeam size\n        \n\n           \n\nDuration\n           \n\n           \nNov 2005-April 2006\nEnvironment\n    \n\n          \nServlets, JSP, JDBC, Oracle8i, Weblogic Server\n\n                    \nRole\n                 \n\n           \nTeam member\n                                       \n                                 \nDescription:\n\nEngineering Villege2 is a powerful way to search across multiple databases via one interface. In just a few seconds even the first time user reach over 60,000 summaries of journal articles technical reports and conference papers and proceedings dating from 1970 forward as well as more than 1000 websites abstracts and 80 full text searchable hand books patents and standards.\nIt provides two levels of search capabilities.\nQuick Search:\nOffer easy strength forward access to information. \nExpert Search:\nAllow users to construct complex queries using Boolean proximity and stemming operations. \n\nResponsibilities:\n\n          \nDeveloped JSP pages for presentation logic.\n\n          \nCoding for Connection and retrieval of data using JDBC.\n\n          \nInvolved in developing logic for Quick Search using Servlets.\n\nProject #4\n\nTitle\n   \n              \n\n          \nSales Monitoring System\nClient\n              \n\n         \n\nJai Autos, Chennai\nTeam size\n        \n\n           \n   \n\nDuration\n          \n\n      \n    \nMay 2005-Oct 2005\nEnvironment\n    \n\n          \nServlets, JSP, JDBC, Oracle8i, Weblogic Server\n\n                    \nRole\n     \n           \n\n\n          \nTeam member\n\nDescription:\n         \nThis is an Intranet Application Developed using JDK1.1.4 to Meet Sales Monitoring \nSystem.This System is developed to meet purchase and Stock Maintenance \nreports.This System keeps track of outgoing materials to the sub-contractors and \nalso for its own requirements. The Windows NT clients are connected to NT-Server \nrunning Netscape Enterprise Server 3.5.1.The Database part is implemented in JDBC \nOracle driver using Java Servlets API.\n\nResponsibilities:\n\n\n          \nDeveloped this application using Java, Servlets, and Jsp?s.\n\n    \n\n\nThe user interface was developed.\n\n    \n   \nField validation was done for the entire module.\n\nPersonal Details:\n\nDate of Birth\n                            \n\n          \n07-April-1984.\nGender\n                                     \n\n           \nmale\nMarital Status\n                          \n\n           \nSingle.',NULL,9,NULL,'2007-10-15',NULL,'2007-10-15','2010-06-08 12:13:25','2010-06-08',10,NULL,NULL,NULL,NULL,9,'0',NULL),(31,'Sandeep sha',NULL,NULL,'Pune','sandfhdfhghsghs.13@gmail.com',NULL,'9934286040','0','919975806482','0',NULL,'0','2007-12-13',NULL,NULL,'2010-06-08 12:13:25',10,'0',NULL,'200710/15/ATT8011.html','200710/15/DOC55865.doc','Name: Ankit Aggarwal\nSandeep Sha\nAddress: Flat No 7, Block 3, Anchor Appt. wanovari Pune-411040\nContact No - +919975806482, +91-9934286040(\nMobile\n\nEmail: \nsandfhdfhghsghs.13@gmail.com\nsf\nCareer Objective\n\nSeeking a career in a fast paced professional environment that offer great scope for growth leveraged by my untiring attitude to learn.\n\nWork Experience \n            