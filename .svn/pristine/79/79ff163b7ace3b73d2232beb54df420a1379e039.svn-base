/*!40000 ALTER TABLE `tp_applicant_selection_process_traits` ENABLE KEYS */;

--
-- Table structure for table `tp_applicant_skills`
--

DROP TABLE IF EXISTS `tp_applicant_skills`;
CREATE TABLE `tp_applicant_skills` (
  `applicant_id` bigint(20) NOT NULL,
  `skill_id` int(11) NOT NULL,
  KEY `applicant_id` (`applicant_id`),
  KEY `skill_id` (`skill_id`),
  CONSTRAINT `tp_applicant_skills_ibfk_1` FOREIGN KEY (`applicant_id`) REFERENCES `tp_applicants` (`applicant_id`),
  CONSTRAINT `tp_applicant_skills_ibfk_2` FOREIGN KEY (`skill_id`) REFERENCES `tp_skills` (`skill_id`)
) ENGINE=InnoDB DEFAULT CHARSET=latin1;

