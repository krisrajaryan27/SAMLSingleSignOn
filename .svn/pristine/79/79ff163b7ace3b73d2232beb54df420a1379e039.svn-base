--
-- Table structure for table `tp_inbox_emails`
--

DROP TABLE IF EXISTS `tp_inbox_emails`;
CREATE TABLE `tp_inbox_emails` (
  `email_id` bigint(20) NOT NULL auto_increment,
  `email_from` varchar(100) default NULL,
  `email_from_address` varchar(100) default NULL,
  `email_to` text,
  `email_cc` text,
  `email_bcc` text,
  `email_subject` varchar(250) default NULL,
  `email_date_send` datetime default NULL,
  `email_date_received` datetime default NULL,
  `email_textbody` longtext,
  `email_htmlbody` longtext,
  `email_size` bigint(20) NOT NULL,
  `folder_id` int(11) NOT NULL default '1',
  `auto_import_format` tinyint(1) default '0',
  `auto_import_tried` tinyint(1) NOT NULL,
  `auto_import_errors` varchar(250) default NULL,
  `user_id` bigint(20) default NULL,
  `entry_id` varchar(100) default NULL,
  `position_id` bigint(20) default NULL,
  `applicant_id` bigint(20) default NULL,
  `position_step_id` int(11) default NULL,
  PRIMARY KEY  (`email_id`),
  KEY `FK_tp_inbox_emails` (`user_id`),
  KEY `FK_tp_inbox_emails1` (`applicant_id`),
  KEY `FK_tp_inbox_emails2` (`position_step_id`),
  CONSTRAINT `tp_inbox_emails_ibfk_4` FOREIGN KEY (`position_step_id`) REFERENCES `tp_position_steps` (`position_step_id`),
  CONSTRAINT `tp_inbox_emails_ibfk_2` FOREIGN KEY (`user_id`) REFERENCES `tp_users` (`USER_ID`),
  CONSTRAINT `tp_inbox_emails_ibfk_3` FOREIGN KEY (`applicant_id`) REFERENCES `tp_applicants` (`applicant_id`)
) ENGINE=InnoDB DEFAULT CHARSET=latin1;

