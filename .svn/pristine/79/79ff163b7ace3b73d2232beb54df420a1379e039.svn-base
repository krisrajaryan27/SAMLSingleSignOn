/*!40000 ALTER TABLE `tp_applicant_skills` ENABLE KEYS */;

--
-- Table structure for table `tp_applicant_status_messages`
--

DROP TABLE IF EXISTS `tp_applicant_status_messages`;
CREATE TABLE `tp_applicant_status_messages` (
  `status_message_id` bigint(20) NOT NULL auto_increment,
  `applicant_id` bigint(20) NOT NULL,
  `position_step_id` int(11) NOT NULL,
  `status_message` varchar(300) NOT NULL,
  `user_id` bigint(20) NOT NULL,
  `date_created` datetime NOT NULL,
  `system_generated` char(1) NOT NULL default '0',
  `status_message_is_hidden` char(1) NOT NULL default '0',
  PRIMARY KEY  (`status_message_id`),
  KEY `FK_tp_applicant_status_messages` (`applicant_id`),
  KEY `FK_tp_applicant_status_messages_1` (`position_step_id`),
  KEY `FK_tp_applicant_status_messages_2` (`user_id`),
  CONSTRAINT `tp_applicant_status_messages_ibfk_1` FOREIGN KEY (`applicant_id`) REFERENCES `tp_applicants` (`applicant_id`),
  CONSTRAINT `tp_applicant_status_messages_ibfk_2` FOREIGN KEY (`position_step_id`) REFERENCES `tp_position_steps` (`position_step_id`),
  CONSTRAINT `tp_applicant_status_messages_ibfk_3` FOREIGN KEY (`user_id`) REFERENCES `tp_users` (`USER_ID`)
) ENGINE=InnoDB DEFAULT CHARSET=latin1;

--
-- Dumping data for table `tp_applicant_status_messages`
--


/*!40000 ALTER TABLE `tp_applicant_status_messages` DISABLE KEYS */;
LOCK TABLES `tp_applicant_status_messages` WRITE;
