package com.talentPool.parser.regex;

/**
 * Small class to encapsulate degree id and name as found in
 * document.
 */

public class Entity
{
	String entityName;
	int entityId;

	/* Constructors */
	public Entity (int entId)
	{
		entityName = null;
		entityId = entId;
	}

	public Entity (String entNm, int entId)
	{
		entityName = entNm;
		entityId = entId;
	}

	/* Getters */
	public String getEntityName () { return entityName; }
	public int getEntityId () { return entityId; }

	/* Setters */
	public void setEntityName (String ent) { entityName = ent; }
	public void setEntityId (int id) { entityId = id; }
}

