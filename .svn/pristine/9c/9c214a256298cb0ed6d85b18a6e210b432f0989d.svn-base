public class ReadApplicantsFromCSV {

	public void startExcelImport(String mappings, String sessionId, String userId, PermissionSet permissionSet) {
		try {
			CSVUploadManager csvUploadManager = new CSVUploadManager();
			ArrayList<ImportData> excelList = csvUploadManager.getExcelImportData(sessionId, "0");
			ArrayList applicantInfo = new ArrayList();
			for (int i = 0; i < excelList.size(); i++) {
				ImportData iData = excelList.get(i);
				CustomFieldManager customFieldManager = new CustomFieldManager();
				ArrayList<CustomFieldData> customFields = customFieldManager.getCustomFieldDataForEntity(
						sessionId + iData.getRowNumber(), CustomFieldConstants.ENTITY_TYPE_EXCEL_IMPORT);
				iData.setCustomFields(customFields);

				try {
					applicantInfo = importApplicant(iData, mappings, userId, permissionSet);
					csvUploadManager.updateExcelImportTable(sessionId, iData.getRowNumber(), applicantInfo);
				} catch (Exception e) {
					TPLogger.getLogger().error(GlobalConstants.ERROR, e);
				}
			}
		} catch (Exception e) {
			TPLogger.getLogger().error(GlobalConstants.ERROR, e);
		}
	}

	public ArrayList<String> csvFieldName(String relativeFilePath) {
		ArrayList<String> excelFieldName = new ArrayList<String>();
		try {
			String filePath = Utils.concatFilePath(DocumentConstants.documentsPath, relativeFilePath);
			BufferedReader in = new BufferedReader(new FileReader(filePath));
			String line = in.readLine();
			StringTokenizer st = new StringTokenizer(line, ",");
			while (st.hasMoreTokens()) {
				excelFieldName.add(st.nextToken());
			}
		} catch (Exception e) {
			TPLogger.getLogger().error(GlobalConstants.ERROR, e);
		}
		return excelFieldName;
	}

	public void validateExcelImportData(String sessionId, String relativeFilePath, String mappings, String userId)
			throws Exception {
		String filePath = Utils.concatFilePath(DocumentConstants.documentsPath, relativeFilePath);
		CSVUploadManager csvUploadManager = new CSVUploadManager();
		ImportData importData = null;
		try {
			int columnCount = 0;
			String[] mappingStr = mappings.split(",");
			BufferedReader in = new BufferedReader(new FileReader(filePath));
			String line = in.readLine(); // remove header line
			line = in.readLine();
			int rowNumber = 1;

			int startInd, endInd;
			char FieldSeparator = ',';

			while (line != null) {
				Map<String, String> customMap = new HashMap<String, String>();
				if (CSVImportSessionList.sessions.get(sessionId) == null) {
					return;
				}
				columnCount = 0;
				importData = new ImportData();
				line = replaceComaWithChrInBetwnQuotes(line);

				CustomFieldManager customFieldManager = new CustomFieldManager();
				ArrayList<CustomFieldData> customFields = customFieldManager.getCustomFieldsForInputAllowed(
						CustomFieldConstants.ENTITY_TYPE_APPLICANT, CustomFieldConstants.INPUT_ALLOWED, true);
				ArrayList<CustomFieldData> tabularCustomFields = customFieldManager.getCustomFieldsForInputAllowed(
						CustomFieldConstants.ENTITY_TYPE_APPLICANT_TABLE_FIELD, CustomFieldConstants.INPUT_ALLOWED, true);
				customFields.addAll(tabularCustomFields);
				importData.setCustomFields(customFields);

				String errStr = "";
				boolean fldName = false;

				int len = line.length();
				for (startInd = -1, endInd = 0; endInd >= 0;) {
					String dataText = "";
					endInd = line.indexOf(FieldSeparator, startInd + 1);
					if (endInd < 1) {
						dataText = line.substring(startInd + 1, len);
					} else {
						dataText = line.substring(startInd + 1, endInd);
					}
					if (!Utils.isBlankOrNull(dataText)) {
						dataText = dataText.replaceAll(InboxConstants.EXCEL_REPLACE_STR, ",");
					}
					String colName = "0";
					// edited for a header bug replaced "<=" with "<"
					if (columnCount < mappingStr.length) {
						colName = mappingStr[columnCount];
					}
					importData.setError("");
					if (!colName.equals("0")) {
						importData = getDataValueError(importData, dataText, colName, userId,customMap);
						
						if (!Utils.isBlankOrNull(importData.getError())) {
							if (Utils.isBlankOrNull(errStr)) {
								errStr = importData.getError();
							} else {
								errStr += " ," + importData.getError();
							}
						}
					}
					if (colName.equals(InboxConstants.FLD_NAME)) {
						fldName = true;
					}
					columnCount++;

					startInd = endInd;
				}

				if (!fldName) {
					if (Utils.isBlankOrNull(errStr)) {
						errStr = "Applicant name required";
					} else {
						errStr += " ," + "Applicant name required";
					}
				}

				// save data to tp_excel_import
				importData.setError(errStr);
				importData.setRowNumber("" + rowNumber++);
				csvUploadManager.saveRowData(importData, sessionId);
				line = in.readLine();
			}
		} catch (Exception e) {
			TPLogger.getLogger().error(GlobalConstants.ERROR, e);
		}
	}

	public String replaceComaWithChrInBetwnQuotes(String line) {
		String[] lineStr = line.split("\"");
		String newLine = "";
		for (int i = 0; i < lineStr.length; i++) {
			String txt = lineStr[i];
			if (i % 2 == 0) {
				// ignore even numbers
			} else {
				String[] txtStr = txt.split(",");
				String newText = "";
				for (int j = 0; j < txtStr.length; j++) {
					if (newText.equals("")) {
						newText = txtStr[j];
					} else {
						newText += InboxConstants.EXCEL_REPLACE_STR + txtStr[j];
					}
				}
				txt = newText;
			}
			if (newLine.equals("")) {
				newLine = txt;
			} else {
				newLine += txt;
			}
		}
		return newLine;
	}

	private ImportData getDataValueError(ImportData importData, String dataText, String colName, String userId,Map<String, String> customMap) {
		String err = "";
		CSVUploadManager csvUploadManager = new CSVUploadManager();

		if (!Utils.isBlankOrNull(dataText)) {
			if (colName.equals(InboxConstants.FLD_NAME)) {
				importData.setName(dataText);
			}

			if (colName.equals(InboxConstants.FLD_EMAIL_1)) {
				if (dataText.length() > 50) {
					err = "Email1 \"" + dataText + "\" is more than the desired length and hence will be cut short.";
					importData.setError(err);
					dataText = dataText.substring(0, 45);
				}
				importData.setEmail1(dataText);
			}

			if (colName.equals(InboxConstants.FLD_EMAIL_2)) {
				if (dataText.length() > 50) {
					err = "Email2 \"" + dataText + "\" is more than the desired length and hence will be cut short.";
					importData.setError(err);
					dataText = dataText.substring(0, 45);
				}
				importData.setEmail2(dataText);
			}

			if (colName.equals(InboxConstants.FLD_PHONE_1)) {
				if (dataText.length() > 25) {
					err = "Phone1 \"" + dataText + "\" is more than the desired length and hence will be cut short.";
					importData.setError(err);
					dataText = dataText.substring(0, 20);
				}
				importData.setPhone1(dataText);
			}
			if (colName.equals(InboxConstants.FLD_PHONE_2)) {
				if (dataText.length() > 25) {
					err = "Phone2 \"" + dataText + "\" is more than the desired length and hence will be cut short.";
					importData.setError(err);
					dataText = dataText.substring(0, 20);
				}
				importData.setPhone2(dataText);
			}
			if (colName.equals(InboxConstants.FLD_MOBILE)) {
				if (dataText.length() > 25) {
					err = "Mobile \"" + dataText + "\" is more than the desired length and hence will be cut short.";
					importData.setError(err);
					dataText = dataText.substring(0, 20);
				}
				importData.setMobile(dataText);
			}
			
			if (colName.equals(InboxConstants.FLD_DATE_OF_BIRTH)) {
				Date dt = null;
				if (!Utils.isBlankOrNull(dataText)) {
					try {
						dt = Utils.convertToDate(dataText, Utils.regEUDateFormat);
						if (dt == null) {
							err = "Date_Of_Birth \"" + dataText + "\" must be a dd/MM/yyyy format";
							importData.setError(err);
						}
					} catch (Exception e) {
						err = "Date_Of_Birth \"" + dataText + "\" must be a dd/MM/yyyy format";
						importData.setError(err);
					}
					if (dt != null) {
						importData.setDateOfBirth(new java.sql.Date(dt.getTime()).toString());
					}
				}
			}
			
			if (colName.equals(InboxConstants.FLD_EXPERIENCE)) {
				double exp = -1;
				if (!Utils.isBlankOrNull(dataText)) {
					try {
						exp = Double.parseDouble(dataText);
					} catch (Exception e) {
						err = "Experience \"" + dataText + "\" must be a number";
						importData.setError(err);
					}
					if (exp != -1) {
						importData.setExperience("" + exp);
					}
				}
			}

			if (colName.equals(InboxConstants.FLD_SOURCE)) {
				String sourceId = csvUploadManager.getSourceId(dataText);
				if (Utils.isBlankOrNull(sourceId)) {
					err = "Source \"" + dataText + "\" is invalid";
					importData.setError(err);
				} else {
					importData.setSource(dataText);
				}
			}

			if (colName.equals(InboxConstants.FLD_CURRENT_LOCATION)) {
				importData.setCurrentLocation(dataText);
			}

			if (colName.equals(InboxConstants.FLD_SKILLS)) {
				String validSkills = "";
				String[] skillStr = dataText.split(",");
				String invalidSkills = "";
				for (int j = 0; j < skillStr.length; j++) {
					String skillId = csvUploadManager.getSkillId(skillStr[j].trim());
					if (Utils.isBlankOrNull(skillId)) {
						if (Utils.isBlankOrNull(invalidSkills)) {
							invalidSkills = skillStr[j].trim();
						} else {
							invalidSkills += ", " + skillStr[j].trim();
						}
					} else {
						if (Utils.isBlankOrNull(validSkills)) {
							validSkills = skillStr[j].trim();
						} else {
							validSkills += ", " + skillStr[j].trim();
						}

					}
				}
				if (!Utils.isBlankOrNull(invalidSkills)) {
					err = "Skills \"" + invalidSkills + "\" is invalid";
					importData.setError(err);
				}
				importData.setSkills(validSkills);
