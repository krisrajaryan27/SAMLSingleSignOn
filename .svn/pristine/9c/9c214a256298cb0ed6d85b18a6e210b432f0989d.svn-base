			}
			if (colName.equals(InboxConstants.FLD_EMPLOYMENT_DESIGNATION_5)) {
				importData.setEmploymentDesignation5(dataText);
			}
			
			if (CustomFieldManager.isCustomFieldsAvailable(CustomFieldConstants.ENTITY_TYPE_APPLICANT) || 
					CustomFieldManager.isCustomFieldsAvailable(CustomFieldConstants.ENTITY_TYPE_APPLICANT_TABLE_FIELD)) {
				ArrayList<CustomFieldData> customFields = importData.getCustomFields();
				for (int c = 0; c < customFields.size(); c++) {
					CustomFieldData cData = customFields.get(c);
					if (colName.equals(cData.getFieldName())) {
						String value ="";
						if(cData.getFieldEntityType()==CustomFieldConstants.ENTITY_TYPE_APPLICANT_TABLE_FIELD){
							value = getEntityTableString(cData, dataText,customMap);
						} else {
							value = dataText;
						}
						String fldType = cData.getFieldType();
						
						if (fldType.equals(CustomFieldConstants.TYPE_RADIO)
								|| fldType.equals(CustomFieldConstants.TYPE_CHECKBOX)
								|| fldType.equals(CustomFieldConstants.TYPE_LISTBOX)
								|| fldType.equals(CustomFieldConstants.TYPE_DROPDOWN)) {
							// save error
							try {
								ArrayList<CustomFieldOption> options = cData.getOptionsList(cData.getFieldOptions());
								if (options != null) {
									int totalOptions = options.size();
									boolean valueMatch = false;
									if (totalOptions > 0) {
										for (int j = 0; j < totalOptions; j++) {
											String optionValue = options.get(j).getValue().replaceAll("'", "\\\\'");
											if (optionValue.equals(value)) {
												valueMatch = true;
											}
										}
										if (!valueMatch) {
											err = cData.getFieldDisplayName() + " \"" + value + "\" is invalid";
											importData.setError(err);
										}
									}
								}
							} catch (Exception e) {
								TPLogger.getLogger().error(e);
							}
							cData.setFieldValues(value.split(","));

						} else if (fldType.equals(CustomFieldConstants.TYPE_DATE)) {
							Date dt = null;
							try {
								dt = Utils.convertToDate(value, Utils.regEUDateFormat);

							} catch (Exception e) {
								err = cData.getFieldDisplayName() + " \"" + value + "\" must be a dd-MMM-yyyy format";
								importData.setError(err);
							}
							if (dt != null) {
								String dateValue = Utils.getDateConvertedToString(dt,
										cData.getOtherAttribute(CustomFieldConstants.ATTRIBUTE_DATE_FORMAT));
								cData.setFieldValues(dateValue.split(","));
							} else {
								cData.setFieldValues("".split(" "));
							}
						} else {
							cData.setFieldValues(value.split(","));
						}
					}
				}
			}
		}
		return importData;
	}
	
	public String getEntityTableString(CustomFieldData customFieldData,String text,Map<String,String> customMap){
		String key = customFieldData.getFieldName()+""+customFieldData.getTableId();
		if(!customMap.containsKey(key)){
			customMap.put(key, text);
		} else {
			customMap.put(key, customMap.get(key)+","+text);
		}
		return customMap.get(key);
	}

	public ArrayList<String> importApplicant(ImportData iData, String mappings, String userId,
			PermissionSet permissionSet) {
		ArrayList<String> applicantinfo = new ArrayList<String>();
		ApplicantForm appForm = new ApplicantForm();
		ApplicantManager applicantManager = new ApplicantManager();
		String status = InboxConstants.EXCEL_IMPOT_SUCCESS;
		try {
			setBlankEducationInForm(appForm);
			setBlankEmploymentHistoryForm(appForm);
			setValueToAppForm(appForm, iData, userId);

			// Add Applicant
			String applicantId = "";

			if (appForm.getEducationYearOfPassing() == null) {
				appForm.setDefaultEducationRow();
			}

			if (appForm.getEmploymentFromDate() == null) {
				appForm.setDefaultEmploymentHistoryRow();
			}
			// Check Duplicates
			ApplicantDuplicateChecker applicantDuplicateChecker = new ApplicantDuplicateChecker();
			ArrayList<ApplicantDuplicateSearchData> duplicates = applicantDuplicateChecker.getInternalDuplicateChecked(
					appForm.getApplicantId(), appForm.getApplicantName(), appForm.getApplicantEmail1(),
					appForm.getApplicantEmail2(), appForm.getApplicantCellPhone(), null);
			if (duplicates != null && duplicates.size() > 0) {
				// duplicates found
				status = InboxConstants.EXCEL_IMPOT_DUPLICATE;
			} else {
				// Save Applicant
				// Construct ApplicantData

				// Upload Resume
				// upload resume file if the file path is given in csv provided
				// the resume is kept at server

				if (!Utils.isBlankOrNull(iData.getOriginalResumePath())) {
					uploadResumeFile(iData.getOriginalResumePath(), appForm);
				}

				ApplicantData aData = getApplicantDataConstructed(appForm);
				if (iData.getCustomFields() != null) {
					aData.setCustomFields(iData.getCustomFields());
				}
				aData.setUserId(userId);
				applicantId = applicantManager.addApplicant(aData, appForm.getPrimarySkillIds());

				// add Note
				if (!Utils.isBlankOrNull(appForm.getApplicantNote()) && !Utils.isBlankOrNull(applicantId)) {
					applicantManager.addNote(applicantId, userId, appForm.getApplicantNote());
				}
				// Add original doc
				if (!Utils.isBlankOrNull(aData.getApplicantOriginalDocPath())) {
					applicantManager.addOriginalResumeToDocument(applicantId, aData.getApplicantOriginalDocPath(),
							userId);
				}

				if (Utils.isBlankOrNull(applicantId)) {
					status = InboxConstants.EXCEL_IMPOT_FAIL;
				} else {
					TPIndexEventQueue.push(new TPIndexEvent(TPIndexEvent.TYPE_ADD_APPLICANT, applicantId,
							TPIndexEvent.PRIORITY_NORMAL));
				}
			}
			if (Utils.isBlankOrNull(applicantId)) {
				applicantId = "0";
			}

			applicantinfo.add(applicantId);
			applicantinfo.add(iData.getRowNumber());
			applicantinfo.add(status);
		} catch (Exception e) {
			TPLogger.getLogger().error(GlobalConstants.ERROR, e);
		}
		return applicantinfo;
	}

	private void setBlankEducationInForm(ApplicantForm appForm) {
		try {
			String[] eYop = new String[4];
			String[] eDegree = new String[4];
			String[] eBranch = new String[4];
			String[] eInstitute = new String[4];
			String[] eStartDate = new String[4];
			String[] eEndDate = new String[4];
			String[] eTypeOfProgram = new String[4];
			String[] ePercentage = new String[4];
			String[] eUniversity = new String[4];
			for(int i=0; i<4; i++){
				eYop[i] = "";
				eDegree[i] = "";
				eBranch[i] = "";
				eInstitute[i] = ""; 
				eStartDate[i] = ""; 
				eEndDate[i] = ""; 
				eTypeOfProgram[i] = ""; 
				eUniversity[i] = ""; 
				ePercentage[i] = ""; 
			}
			appForm.setEducationYearOfPassing(eYop);
			appForm.setEducationalStartDate(eStartDate);
			appForm.setEducationalEndDate(eEndDate);
			appForm.setEducationDegreeId(eDegree);
			appForm.setEducationMajorId(eBranch);
			appForm.setEducationInstitute(eInstitute);
			appForm.setTypeOfProgram(eTypeOfProgram);
			appForm.setUniversity(eUniversity);
			appForm.setEducationalGrade(ePercentage);
		} catch (Exception e) {
			TPLogger.getLogger().error(e);
		}

	}

	private void setValueToAppForm(ApplicantForm appForm, ImportData iData, String userId) {
		CSVUploadManager csvUploadManager = new CSVUploadManager();
		try {

			if (!Utils.isBlankOrNull(iData.getName())) {
				appForm.setApplicantName(iData.getName());
			}

			if (!Utils.isBlankOrNull(iData.getEmail1())) {
				appForm.setApplicantEmail1(iData.getEmail1());
			}

			if (!Utils.isBlankOrNull(iData.getEmail2())) {
				appForm.setApplicantEmail2(iData.getEmail2());
			}

			if (!Utils.isBlankOrNull(iData.getPhone1())) {
				appForm.setApplicantHomePhone(iData.getPhone1());
			}

			if (!Utils.isBlankOrNull(iData.getPhone2())) {
				appForm.setApplicantHomePhone(iData.getPhone2());
			}

			if (!Utils.isBlankOrNull(iData.getMobile())) {
				appForm.setApplicantCellPhone(iData.getMobile());
			}
			
			if (!Utils.isBlankOrNull(iData.getDateOfBirth())) {
				appForm.setDateOfBirth(iData.getDateOfBirth());
			}

			if (!Utils.isBlankOrNull(iData.getExperience())) {
				appForm.setApplicantWorkingSince(iData.getExperience());
			}

			if (!Utils.isBlankOrNull(iData.getSource())) {
				String sourceId = csvUploadManager.getSourceId(iData.getSource());
				if (!Utils.isBlankOrNull(sourceId)) {
					appForm.setSourceId(sourceId);
				}
			}

			if (!Utils.isBlankOrNull(iData.getCurrentLocation())) {
				appForm.setApplicantCity(iData.getCurrentLocation());
			}

			if (!Utils.isBlankOrNull(iData.getSkills())) {
				String skills = iData.getSkills();
				String[] skillStr = skills.split(",");
				String skillIds = "";
				for (int j = 0; j < skillStr.length; j++) {
					String skillId = csvUploadManager.getSkillId(skillStr[j].trim());
					if (!Utils.isBlankOrNull(skillId)) {
						if (Utils.isBlankOrNull(skillIds)) {
							skillIds = skillId;

						} else {
							skillIds += "," + skillId;
						}
					}
				}
				if (!Utils.isBlankOrNull(skillIds)) {
					appForm.setPrimarySkillIds(skillIds);
				}

			}

			if (!Utils.isBlankOrNull(iData.getYOP1())) {
				appForm.getEducationYearOfPassing()[0] = iData.getYOP1();
