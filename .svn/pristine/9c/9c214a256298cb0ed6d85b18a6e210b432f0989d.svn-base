	private ApplicantData getApplicantDataConstructed(ApplicantForm aForm) {
		ApplicantData aData = new ApplicantData();
		if (!Utils.isBlankOrNull(aForm.getSourceId())) {
			aData.setApplicantSourceId(Integer.parseInt(aForm.getSourceId()));
		}
		aData.setApplicantName(aForm.getApplicantName());
		aData.setApplicantCity(aForm.getApplicantCity());
		aData.setApplicantEmail1(aForm.getApplicantEmail1());
		aData.setApplicantEmail2(aForm.getApplicantEmail2());
		aData.setApplicantWorkPhone(aForm.getApplicantWorkPhone());
		aData.setApplicantHomePhone(aForm.getApplicantHomePhone());
		aData.setApplicantCellPhone(aForm.getApplicantCellPhone());
		aData.setApplicantCurrentEmployer(aForm.getApplicantCurrentEmployer());
		aData.setCurrentCTC(aForm.getCurrentCTC());
		aData.setExpectedCTC(aForm.getExpectedCTC());
		aData.setNoticePeriod(aForm.getNoticePeriod());
		
		Date tmpDob = null;
		if (!Utils.isBlankOrNull(aForm.getDateOfBirth().trim())) {
			tmpDob = Utils.convertToDate(aForm.getDateOfBirth(), Utils.redYYYYMMDDFormat);
			if (tmpDob != null) {
				aData.setDateOfBirth(new java.sql.Date(tmpDob.getTime()));
			}
		}
		
		java.sql.Date dtWorkingFrom = null;
		String fresher = "0";
		if (!Utils.isBlankOrNull(aForm.getApplicantWorkingSince())) {
			try {
				int months = new Double(Double.parseDouble(aForm.getApplicantWorkingSince()) * 12).intValue();
				dtWorkingFrom = Utils.convertDateToSQLDate(Utils.adjustDateBy(new Date(), Calendar.MONTH, -months));
			} catch (Exception e) {
			}
			if (aForm.getApplicantWorkingSince().equals("0")) {
				fresher = "1";
			}
		} else {
			fresher = "0";
		}
		aData.setApplicantIsFresher(fresher);
		aData.setApplicantWorkingSince(dtWorkingFrom);

		String[] eduYop = aForm.getEducationYearOfPassing();
		String[] eduInstitute = aForm.getEducationInstitute();
		String[] eduDegree = aForm.getEducationDegreeId();
		String[] eduMajor = aForm.getEducationMajorId();
		String[] eduStartDate = aForm.getEducationalStartDate();
		String[] eduEndDate = aForm.getEducationalEndDate();
		String[] university = aForm.getUniversity();
		String[] typeOfProgram = aForm.getTypeOfProgram();
		String[] eduGrades = aForm.getEducationalGrade();
		
		ArrayList<EducationalData> educationalDetails = new ArrayList<EducationalData>();

		for (int i = 0; eduYop != null && i < eduYop.length; i++) {
			if (!"null".equals(eduYop[i])) {
				if (!(Utils.isBlankOrNull(eduYop[i]) && Utils.isBlankOrNull(eduStartDate[i]) && Utils.isBlankOrNull(eduEndDate[i]) 
						&& Utils.isBlankOrNull(eduInstitute[i]) && Utils.isBlankOrNull(eduDegree[i]) && Utils.isBlankOrNull(eduMajor[i]) 
						&& Utils.isBlankOrNull(university[i]) && Utils.isBlankOrNull(typeOfProgram[i]) && Utils.isBlankOrNull(eduGrades[i]))) {
					EducationalData eData = new EducationalData();
					Date tmpDt = null;
					if (!Utils.isBlankOrNull(eduYop[i].trim())) {
						tmpDt = Utils.convertToDate(
								"1" + Utils.dateDescSeparator + "1" + Utils.dateDescSeparator + eduYop[i],
								Utils.redDDMMYYYYFormat);
						if (tmpDt != null) {
							eData.setYearOfPassing(new java.sql.Date(tmpDt.getTime()));
						}
					} else {
						eData.setYearOfPassing(null);
					}
					
					Date tmpStrDt = null;
					if (!Utils.isBlankOrNull(eduStartDate[i].trim())) {
						tmpStrDt = Utils.convertToDate(eduStartDate[i], Utils.regEUDateFormat);
						if (tmpStrDt != null) {
							eData.setStartDate(new java.sql.Date(tmpStrDt.getTime()));
						}
					}
					
					Date tmpEndDt = null;
					if (!Utils.isBlankOrNull(eduEndDate[i].trim())) {
						tmpEndDt = Utils.convertToDate(eduEndDate[i], Utils.regEUDateFormat);
						if (tmpEndDt != null) {
							eData.setEndDate(new java.sql.Date(tmpEndDt.getTime()));
						}
					}
					
					if (null != eduInstitute && !Utils.isBlankOrNull(eduInstitute[i])) {
						eData.setInstitute(eduInstitute[i]);
					}
					if (null != eduDegree && !Utils.isBlankOrNull(eduDegree[i]) && !eduDegree[i].equals("-1")) {
						eData.setDegreeId(Integer.parseInt(eduDegree[i]));
					}
					if (null != eduMajor && !Utils.isBlankOrNull(eduMajor[i]) && !eduMajor[i].equals("-1")) {
						eData.setMajorId(Integer.parseInt(eduMajor[i]));
					}
					if (null != university && !Utils.isBlankOrNull(university[i])) {
						eData.setUniversity(university[i]);
					}
					if (null != typeOfProgram && !Utils.isBlankOrNull(typeOfProgram[i])) {
						eData.setTypeOfProgram(typeOfProgram[i]);
					}
					if (null != eduGrades && !Utils.isBlankOrNull(eduGrades[i])) {
						eData.setGrade(eduGrades[i]);
					}
					
					educationalDetails.add(eData);
				}
			}
		}
		aData.setEducationalDetails(educationalDetails);

		String[] employmentFromDate = aForm.getEmploymentFromDate();
		String[] employmentToDate = aForm.getEmploymentToDate();
		String[] employmentEmployerName = aForm.getEmploymentEmployerId();
		String[] employmentDesignationName = aForm.getEmploymentDesignationId();
		String[] employerExperience = aForm.getEmploymentExperience();
		String[] empType = aForm.getEmpType();
		String[] location = aForm.getLocation();
		String[] country = aForm.getCountry();
		ArrayList<EmploymentHistoryData> employmentHistoryDetails = new ArrayList<EmploymentHistoryData>();

		for (int i = 0; employmentFromDate != null && i < employmentFromDate.length; i++) {
			if (!"null".equals(employmentFromDate[i]) && employmentFromDate[i] != null) {
				if (!(Utils.isBlankOrNull(employmentFromDate[i]) && Utils.isBlankOrNull(employmentToDate[i])
						&& Utils.isBlankOrNull(employmentEmployerName[i]) && Utils.isBlankOrNull(employmentDesignationName[i]))) {
					EmploymentHistoryData empHistoryData = new EmploymentHistoryData();
					Date toDt = null;
					Date fromDt = null;
					if (!Utils.isBlankOrNull(employmentFromDate[i].trim())) {
						fromDt = Utils.convertToDate(employmentFromDate[i], Utils.redYYYYMMDDFormat);
						if (fromDt != null) {
							empHistoryData.setEmployerFromDate(new java.sql.Date(fromDt.getTime()));
						}
						toDt = Utils.convertToDate(employmentToDate[i], Utils.redYYYYMMDDFormat);
						if (toDt != null) {
							empHistoryData.setEmployerToDate(new java.sql.Date(toDt.getTime()));
						}
						empHistoryData.setEmployerExperience(Utils.getDateDifferenceInMonths(fromDt, toDt).toString());
					} else {
						empHistoryData.setEmployerFromDate(null);
						empHistoryData.setEmployerToDate(null);
						empHistoryData.setEmployerExperience("0");
					}
					empHistoryData.setEmployerName(employmentEmployerName[i]);
					empHistoryData.setDesignationName(employmentDesignationName[i]);
					empHistoryData.setEmpType(empType[i]);
					empHistoryData.setLocation(location[i]);
					empHistoryData.setCountry(country[i]);
					employmentHistoryDetails.add(empHistoryData);
				}
			}
		}
		if (!employmentHistoryDetails.isEmpty()) {
			try {
				Collections.sort(employmentHistoryDetails, EmploymentHistoryData.REVERSE_CHRONOLOGICAL);
			} catch (Exception e) {
				TPLogger.getLogger().debug(GlobalConstants.ERROR, e);
			}
			aData.setEmploymentHistoryDetails(employmentHistoryDetails);
		}

		aData.setApplicantOriginalDocPath(aForm.getOriginalResumeDocPath());
		// aData.setApplicantOriginalResumePath("");
		aData.setApplicantOriginalResumePath(
				Utils.isBlankOrNull(aForm.getOriginalResumePath()) ? "" : aForm.getOriginalResumePath());

		return aData;
	}

	/*
	 * upload resume file to the document folder if and only if the resumes are
	 * at server.
	 * 
	 * 1. Fetching file path and file name 2. Creating File object from file
	 * path and file name 3. Uploading the file to the application and
	 * converting it to html 4. Setting value in ApplicantForm object
	 * 
	 */

	public void uploadResumeFile(String originalResumePath, ApplicantForm applicantForm)
			throws FileNotFoundException, FileUploadException {

		try {
			String[] filePathName = originalResumePath.split("\\\\");
			String fileName = "";
			String filePath = "";
			for (int i = 0; i < filePathName.length; i++) {
				if (i < filePathName.length - 1) {
					filePath += filePathName[i] + "\\";
				} else {
					fileName = filePathName[i];
				}
			}

			File fileToCreate = new File(filePath, fileName);
			FileInputStream fileInputStream = new FileInputStream(fileToCreate);

			DocumentUploader documentUploader = new DocumentUploader();
			DocumentData documentData = null;
			AttachmentData attachmentData = null;

			documentData = documentUploader.saveFileFromStream(fileInputStream, fileToCreate.getName());
			attachmentData = new AttachmentData();
			attachmentData.setAttachmentFilePath(documentData.getRelativeFilePath());
			attachmentData.setOriginalFileName(fileName);
			attachmentData.setAttachmentSize(fileToCreate.length());
			String srcFilePathDoc = "";
			String srcFilePathHtml = "";
			if (attachmentData != null && !Utils.isBlankOrNull(attachmentData.getAttachmentFilePath())) {
				srcFilePathDoc = Utils.concatFilePath(DocumentConstants.documentsPath,
						attachmentData.getAttachmentFilePath());
				WordToHtmlConverter converter = new WordToHtmlConverter();
				srcFilePathHtml = converter.convertToHtml(srcFilePathDoc);
			}

			if (srcFilePathHtml.length() > DocumentConstants.documentsPath.length()) {
				srcFilePathHtml = srcFilePathHtml.substring(DocumentConstants.documentsPath.length() + 1);
			}
			if (srcFilePathDoc.length() > DocumentConstants.documentsPath.length()) {
				srcFilePathDoc = srcFilePathDoc.substring(DocumentConstants.documentsPath.length() + 1);
			}

			applicantForm.setOriginalResumeDocPath(srcFilePathDoc);
			applicantForm.setOriginalResumePath(srcFilePathHtml);

		} catch (Exception e) {
			throw new FileUploadException("Error saving form file");
		}
	}

