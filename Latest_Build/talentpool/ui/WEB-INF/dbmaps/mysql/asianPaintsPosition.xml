      </dataquery>
      
      <dataquery name="dPositionManagerForAP_UpdatePositionByExternalCodeForAP" dbquery="qPositionManagerForAP_UpdatePositionByExternalCodeForAP"/>
      
      <dataquery name="dPositionManagerForAP_GetAllPositionsFromDBForAP" dbquery="qPositionManagerForAP_GetAllPositionsFromDBForAP"  object="com.talentPool.positions.dataobject.PositionDataForAP">
      <attribute name="positionIdForAP"  column="position_id" type="INT" />
      <attribute name="positionCodeForAP"  column="position_code" type="STRING" />
      <attribute name="positionTitleForAP"  column="position_title" type="STRING" />
      </dataquery>
      
   
      
       <dataquery name="dPositionManagerForAP_GetPositionNameForAP" dbquery="qPositionManagerForAP_GetPositionNameForAP" object="com.talentPool.common.db.SimpleDataObject">
	    	<attribute name= "positionName" column="position_title" type ="STRING" />
	  </dataquery>
	  
      <dataquery name="dPositionManagerForAP_GetPositionDataForAP" dbquery="qPositionManagerForAP_GetPositionDataForAP" object="com.talentPool.positions.dataobject.PositionDataForAP">
	    	<attribute name= "companyName" column="companyName" type ="STRING" />
	    	<attribute name= "businessUnitName" column="businessUnitName" type ="STRING" />
	    	<attribute name= "departmentName" column="departmentName" type ="STRING" />
	    	<attribute name= "jobfunctionName" column="jobfunctionName" type ="STRING" />
	    	<attribute name= "jobName" column="jobName" type ="STRING" />
	    	<attribute name= "payGradeName" column="paygradeName" type ="STRING" />
	    	<attribute name= "divisionName" column="divisionName" type ="STRING" />
	    	<attribute name= "regionName" column="regionName" type ="STRING" />
	    	<attribute name= "locationName" column="locationName" type ="STRING" />
	    	<attribute name= "companyId" column="companyId" type ="STRING" />
	    	<attribute name= "businessUnitId" column="businessUnitId" type ="STRING" />
	    	<attribute name= "departmentId" column="departmentId" type ="STRING" />
	    	<attribute name= "positionTitleForAP" column="positionTitleForAP" type ="STRING" />
	    	<attribute name= "divisionId" column="divisionId" type ="STRING" />
	    	<attribute name= "regionId" column="regionId" type ="STRING" />
	    	<attribute name= "locationId" column="locationId" type ="STRING" />
	    	<attribute name= "jobfunctionId" column="jobfunctionId" type ="STRING" />
	    	<attribute name= "payGradeId" column="payGradeId" type ="STRING" />
	    	<attribute name= "jobId" column="jobId" type ="STRING" />
	    	<attribute name= "jobExternalCode" column="jobExternalCode" type ="STRING" />
	    	<attribute name= "companyExternalCode" column="companyExternalCode" type ="STRING" />
	    	<attribute name= "businessUnitExternalCode" column="businessUnitExternalCode" type ="STRING" />
	    	<attribute name= "departmentExternalCode" column="departmentExternalCode" type ="STRING" />
	    	<attribute name= "jobfunctionExternalCode" column="jobfunctionExternalCode" type ="STRING" />
	    	<attribute name= "divisionExternalCode" column="divisionExternalCode" type ="STRING" />
	    	<attribute name= "regionExternalCode" column="regionExternalCode" type ="STRING" />
	    	<attribute name= "locationExternalCode" column="locationExternalCode" type ="STRING" />
	    	<attribute name= "paygradeExternalCode" column="paygradeExternalCode" type ="STRING" />
	  </dataquery>
	  
	   <dataquery name="dPositionManagerForAP_GetPositionCodeForAP" dbquery="qPositionManagerForAP_GetPositionCodeForAP" object="com.talentPool.common.db.SimpleDataObject">
	    	<attribute name= "positionCodeForAP" column="position_code" type ="STRING" />
	    	<attribute name= "positionTitleForAP" column="position_title" type ="STRING" />
	  </dataquery>
	  
	  <dataquery name="dPositionManagerForAP_GetDeptNameForAP" dbquery="qPositionManagerForAP_GetDeptNameForAP" object="com.talentPool.positions.dataobject.PositionDataForAP">
	    	<attribute name= "departmentName" column="dept_name" type ="STRING" />
	  </dataquery>
	  
	  <dataquery name="dPositionManagerForAP_GetJobFunctionNameForAP" dbquery="qPositionManagerForAP_GetJobFunctionNameForAP" object="com.talentPool.positions.dataobject.PositionDataForAP">
	    	<attribute name= "jobfunctionName" column="jobfunction_name" type ="STRING" />
	  </dataquery>
	  
	   <dataquery name="dPositionManagerForAP_GetJobNameForAP" dbquery="qPositionManagerForAP_GetJobNameForAP" object="com.talentPool.positions.dataobject.PositionDataForAP">
	    	<attribute name= "jobName" column="job_name" type ="STRING" />
	  </dataquery>
	  
	   <dataquery name="dPositionManagerForAP_GetPayGradeNameForAP" dbquery="qPositionManagerForAP_GetPayGradeNameForAP" object="com.talentPool.positions.dataobject.PositionDataForAP">
	    	<attribute name= "paygradeName" column="paygrade_name" type ="STRING" />
	  </dataquery>
	  
	   <dataquery name="dPositionManagerForAP_GetLocationNameForAP" dbquery="qPositionManagerForAP_GetLocationNameForAP" object="com.talentPool.positions.dataobject.PositionDataForAP">
	    	<attribute name= "locationName" column="location_name" type ="STRING" />
	  </dataquery>
	  
	  <dataquery name="dPositionManagerForAP_GetPositionEffectiveStartDateForAP" dbquery="qPositionManagerForAP_GetPositionEffectiveStartDateForAP" object="com.talentPool.common.db.SimpleDataObject">
	    	<attribute name= "effectiveStartDate" column="effectiveStartDate" type ="STRING" />
	  </dataquery>
	  
	   <dataquery name="dPositionManager_GetRegions" dbquery="qPositionManager_GetRegions" object="com.talentPool.masters.dataobject.LocationData">
	       <attribute name="itemId"  column="location_id" type="INT" />
	       <attribute name="itemName"  column="location_name" type="STRING" />
	       <attribute name="itemExternalCode"  column="location_externalCode" type="STRING" />
	    </dataquery>
	     <dataquery name="dPositionManager_GetStates" dbquery="qPositionManager_GetStates" object="com.talentPool.masters.dataobject.LocationData">
	       <attribute name="itemId"  column="id" type="INT" />
	       <attribute name="itemName"  column="name" type="STRING" />
	    </dataquery>
	  
	  <dataquery name="dPositionManager_GetSubLocations" dbquery="qPositionManager_GetSubLocations" object="com.talentPool.masters.dataobject.LocationData">
	       <attribute name="itemId"  column="location_id" type="INT" />
	       <attribute name="itemName"  column="location_name" type="STRING" />
	       <attribute name="itemExternalCode"  column="location_externalCode" type="STRING" />
	    </dataquery>
	    
	    <dataquery name="dPositionManagerForAP_GetLocationById" dbquery="qPositionManagerForAP_GetLocationById" object="com.talentPool.masters.dataobject.LocationData">
	       <attribute name="itemId"  column="location_id" type="INT" />
