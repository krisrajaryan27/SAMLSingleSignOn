	    </dataquery>
	    
	     <dataquery name="dPositionManagerForAP_GetJobFunctionById" dbquery="qPositionManagerForAP_GetJobFunctionById" object="com.talentPool.masters.dataobject.DepartmentData">
	       <attribute name="itemId"  column="dept_id" type="INT" />
	       <attribute name="itemName"  column="dept_name" type="STRING" />
	    </dataquery>
	     <dataquery name="dPositionManagerForAP_GetJobPayGradeById" dbquery="qPositionManagerForAP_GetJobPayGradeById" object="com.talentPool.masters.dataobject.DepartmentData">
	       <attribute name="itemId"  column="dept_id" type="INT" />
	       <attribute name="itemName"  column="dept_name" type="STRING" />
