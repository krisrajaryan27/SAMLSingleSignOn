<?xml version="1.0"?>
<!--
<!DOCTYPE dbmap SYSTEM "dbmap.dtd">
-->
<dbmap> 
   <dbqueries>
        <dbquery name="qPositionManagerForAP_AddPositionToDBForAP">
         INSERT into tp_positions_ap(position_code,position_title,effectiveStartDate) values(?,?,?)
       </dbquery>
      
       <dbquery name="qPositionManagerForAP_GetPositionCodeFromDBForAP">
         SELECT  position_code FROM tp_positions_ap where position_code=?
       </dbquery>
       
       <dbquery name="qPositionManagerForAP_UpdatePositionByExternalCodeForAP">
         UPDATE tp_positions_ap set position_title=?, effectiveStartDate=? where position_code=? 
       </dbquery>
       
       <dbquery name="qPositionManagerForAP_GetAllPositionsFromDBForAP">
         SELECT position_id, position_code, position_title from tp_positions_ap  ORDER BY position_code
       </dbquery>
       
       <dbquery name="qPositionManagerForAP_GetPositionCodeForAP">
			SELECT position_code, position_title from tp_positions_ap where position_code like ?
	   </dbquery> 
	   
	   <dbquery name="qPositionManagerForAP_GetPositionNameForAP">
			SELECT position_title from tp_positions_ap where position_title like ?
	   </dbquery> 
	    
	   <dbquery name="qPositionManagerForAP_GetPositionDataForAP">
			(SELECT (SELECT dept_name  from tp_departments where dept_externalCode= ? AND dept_level=1 ) AS companyName,
			(SELECT dept_name  from tp_departments where dept_externalCode= ?  AND dept_level=2 ) AS businessUnitName,
			(SELECT dept_name  from tp_departments where dept_externalCode= ?  AND dept_level=3) AS departmentName,
			(SELECT jobfunction_name from tp_jobfunction_ap where jobfunction_externalCode= ?) AS jobfunctionName ,
			(SELECT job_name from tp_jobcode_ap where job_externalCode= ?) AS jobName,
			(SELECT paygrade_name from tp_paygrade_ap where paygrade_externalCode= ?) AS paygradeName,
			(SELECT location_name from tp_location_ap where location_externalCode= ? AND location_level=1) AS divisionName,
			(SELECT location_name from tp_location_ap where location_externalCode= ? AND location_level=2) AS regionName ,
			(SELECT location_name from tp_location_ap where location_externalCode= ? AND location_level=3) AS locationName, 
			(SELECT dept_id  from tp_departments where dept_externalCode= ? AND dept_level=1 ) AS companyId,
			(SELECT dept_id  from tp_departments where dept_externalCode= ? AND dept_level=2) AS businessUnitId,
			(SELECT dept_id  from tp_departments where dept_externalCode= ? AND dept_level=3) AS departmentId,
			(SELECT position_title  from tp_positions_ap where position_code= ? ) AS positionTitleForAP,
			(SELECT location_id  from tp_location_ap where location_externalCode= ? AND location_level=1) AS divisionId,
			(SELECT location_id  from tp_location_ap where location_externalCode= ? AND location_level=2) AS regionId,
			(SELECT location_id  from tp_location_ap where location_externalCode= ? AND location_level=3) AS locationId,
			(SELECT jobfunction_id  from tp_jobfunction_ap where jobfunction_externalCode= ? ) AS jobfunctionId,
			(SELECT paygrade_id  from tp_paygrade_ap where paygrade_externalCode= ? ) AS payGradeId,
			(SELECT job_id  from tp_jobcode_ap where job_externalCode= ? ) AS jobId,
			(SELECT job_externalCode  from tp_jobcode_ap where job_externalCode= ? ) AS jobExternalCode,
			(SELECT dept_externalCode  from tp_departments where dept_externalCode= ? AND dept_level = 1) AS companyExternalCode,
			(SELECT dept_externalCode  from tp_departments where dept_externalCode= ? AND dept_level = 2 ) AS businessUnitExternalCode,
			(SELECT dept_externalCode  from tp_departments where dept_externalCode= ? AND dept_level = 3) AS departmentExternalCode,
			(SELECT jobfunction_externalCode  from tp_jobfunction_ap where jobfunction_externalCode= ? ) AS jobfunctionExternalCode,
			(SELECT location_externalCode  from tp_location_ap where location_externalCode= ? AND location_level = 1 ) AS divisionExternalCode,
			(SELECT location_externalCode  from tp_location_ap where location_externalCode= ? AND location_level = 2) AS regionExternalCode,
			(SELECT location_externalCode  from tp_location_ap where location_externalCode= ? AND location_level = 3) AS locationExternalCode,
			(SELECT paygrade_externalCode  from tp_paygrade_ap where paygrade_externalCode= ? ) AS paygradeExternalCode)
	   </dbquery>  
	   
	   <dbquery name="qPositionManagerForAP_GetDeptNameForAP">
			SELECT dept_name from tp_departments where dept_externalCode =?
	   </dbquery> 
	   
	   <dbquery name="qPositionManagerForAP_GetJobFunctionNameForAP">
			SELECT jobfunction_name from tp_jobfunction_ap where jobfunction_externalCode =?
	   </dbquery> 
	   
	   <dbquery name="qPositionManagerForAP_GetJobNameForAP">
			SELECT job_name from tp_jobcode_ap where job_externalCode =?
	   </dbquery> 
	   
	   <dbquery name="qPositionManagerForAP_GetPayGradeNameForAP">
			SELECT paygrade_name from tp_paygrade_ap where paygrade_externalCode =?
	   </dbquery> 
	   
	   <dbquery name="qPositionManagerForAP_GetLocationNameForAP">
			SELECT location_name from tp_location_ap where location_externalCode =?
	   </dbquery> 
	   
	   <dbquery name="qPositionManagerForAP_GetPositionEffectiveStartDateForAP">
			SELECT effectiveStartDate from tp_positions_ap where position_code =?
	   </dbquery> 
	   
	   <dbquery name="qPositionManager_GetRegions">
			SELECT location_id, location_name, location_externalCode FROM tp_location_ap WHERE location_isRegion='1' AND location_parent_id=? ORDER BY location_name
		</dbquery>
		<dbquery name="qPositionManager_GetStates">
			SELECT id ,name FROM states WHERE country_id=? ORDER BY name
		</dbquery>
	   
	   <dbquery name="qPositionManager_GetSubLocations">
			SELECT location_id ,location_name, location_externalCode FROM tp_location_ap WHERE location_isRegion='0' AND location_parent_id=? ORDER BY location_name
		</dbquery>
		<dbquery name="qPositionManagerForAP_GetLocationById">
			SELECT location_id ,location_name, location_externalCode FROM tp_location_ap where location_id=?
		</dbquery>
		<dbquery name="qPositionManagerForAP_GetDepartmentById">
			SELECT dept_id ,dept_name FROM tp_departments where dept_id=?
		</dbquery>
		<dbquery name="qPositionManagerForAP_GetJobFunctionById">
			SELECT jobfunction_id ,jobfunction_name FROM tp_jobfunction_ap where jobfunction_id=?
		</dbquery>
		<dbquery name="qPositionManagerForAP_GetJobPayGradeById">
			SELECT paygrade_id ,paygrade_name FROM tp_paygrade_ap where paygrade_id=?
		</dbquery>
		<dbquery name="qPositionManagerForAP_GetJobCodeById">
			SELECT job_id ,job_name, job_externalCode FROM tp_jobcode_ap where job_id=?
		</dbquery>
       
   </dbqueries>
   
   
   
   <dataqueries>
      <dataquery name="dPositionManagerForAP_AddPositionToDBForAP" dbquery="qPositionManagerForAP_AddPositionToDBForAP"/>
      
      
      <dataquery name="dPositionManagerForAP_GetPositionCodeFromDBForAP" dbquery="qPositionManagerForAP_GetPositionCodeFromDBForAP" object="com.talentPool.positions.dataobject.PositionDataForAP">
