<?xml version="1.0"?>
<!--
<!DOCTYPE dbmap SYSTEM "dbmap.dtd">
-->
<dbmap> 
	<dbqueries>	
		<dbquery name="qPositionDraftManager_CreatePositionDraft">
			INSERT INTO tp_position_draft
			(draft_name, file_path, visibility, user_id, date_created)
			VALUES
			(?, ?, ?, ?, NOW())
		</dbquery>
		<dbquery name="qPositionDraftManager_GetAllPositionDrafts">
			SELECT draft_id,draft_name,file_path,visibility,user_id, date_created
			FROM tp_position_draft WHERE (user_id = ? OR visibility = ?) ORDER BY draft_name 
		</dbquery>
		<dbquery name="qPositionDraftManager_deletePositionDrafts">
			DELETE FROM tp_position_draft WHERE draft_id=?
		</dbquery>
		<dbquery name="qPositionDraftManager_getPositionDraftData">
			SELECT draft_id,draft_name,file_path,visibility,user_id,date_format(date_created,'%d-%b-%y') as date_created
			FROM tp_position_draft WHERE draft_id=?
		</dbquery>
		<dbquery name="qPositionDraftManager_getPositionDraftDataByName">
			SELECT draft_id,draft_name,file_path,visibility,user_id,date_format(date_created,'%d-%b-%y') as date_created
			FROM tp_position_draft WHERE draft_name=?
		</dbquery>
		<dbquery name="qPositionDraftManager_updatePositionDraftStatus">
			UPDATE tp_position_draft SET visibility= ? WHERE draft_id= ?
		</dbquery>
		<dbquery name="qPositionDraftManager_updatePositionDraftTitle">
			UPDATE tp_position_draft SET draft_name= ? WHERE draft_id= ?
		</dbquery>
		<dbquery name="qPositionDraftManager_GetLastUserDraftHavingSystemGeneratedName">
			SELECT draft_id, draft_name
			FROM tp_position_draft
			WHERE user_id = ?
			AND visibility = ?
			AND (draft_name REGEXP concat('^', ?,' [0-9]{1}$') OR draft_name REGEXP concat('^', ?,' [0-9]{2}$'))
			ORDER BY date_created desc, draft_id desc LIMIT 0,1
		</dbquery>
		<dbquery name="qPositionDraftManager_GetUserDraftIdForName">
			SELECT draft_id
			FROM tp_position_draft
			WHERE draft_name=?
			AND user_id=?
			AND visibility = ?
		</dbquery>
		<dbquery name="qPositionDraftManager_GetOldestUserDraft">
			SELECT draft_id, draft_name
			FROM tp_position_draft
			WHERE user_id = ?
			AND visibility = ?
			AND (draft_name REGEXP concat('^', ?,' [0-9]{1}$') OR draft_name REGEXP concat('^', ?,' [0-9]{2}$'))
			ORDER BY date_created, draft_id LIMIT 0,1
		</dbquery>
	</dbqueries>
	<dataqueries>
		<dataquery name="dPositionDraftManager_GetAllPositionDrafts" dbquery="qPositionDraftManager_GetAllPositionDrafts" object="com.talentPool.common.db.SimpleDataObject">
			<attribute name= "draftId" column="draft_id" type ="STRING" />
			<attribute name= "fileName" column="draft_name" type ="STRING" />
			<attribute name= "filePath" column="file_path" type ="STRING" />
			<attribute name= "visibility" column="visibility" type ="STRING" />
			<attribute name= "userId" column="user_id" type ="STRING" />
			<attribute name= "dateCreated" column="date_created" type ="STRING" />
		</dataquery>
		<dataquery name="dPositionDraftManager_deletePositionDrafts" dbquery="qPositionDraftManager_deletePositionDrafts" />
		<dataquery name="dPositionDraftManager_getPositionDraftData" dbquery="qPositionDraftManager_getPositionDraftData" object="com.talentPool.common.db.SimpleDataObject">
			<attribute name= "draftId" column="draft_id" type ="STRING" />
			<attribute name= "fileName" column="draft_name" type ="STRING" />
			<attribute name= "filePath" column="file_path" type ="STRING" />
			<attribute name= "visibility" column="visibility" type ="STRING" />
			<attribute name= "userId" column="user_id" type ="STRING" />
			<attribute name= "dateCreated" column="date_created" type ="STRING" />
		</dataquery>
		<dataquery name="dPositionDraftManager_updatePositionDraftStatus" dbquery="qPositionDraftManager_updatePositionDraftStatus" />
		<dataquery name="dPositionDraftManager_updatePositionDraftTitle" dbquery="qPositionDraftManager_updatePositionDraftTitle" />
		<dataquery name="dPositionDraftManager_CreatePositionDraft" dbquery="qPositionDraftManager_CreatePositionDraft"/>
		<dataquery name="dPositionDraftManager_GetLastUserDraftHavingSystemGeneratedName" dbquery="qPositionDraftManager_GetLastUserDraftHavingSystemGeneratedName" object="com.talentPool.positions.dataobject.DraftData">
			<attribute name= "draftId" column="draft_id" type ="STRING" />
			<attribute name= "originalFileName" column="draft_name" type ="STRING" />
		</dataquery>
		<dataquery name="dPositionDraftManager_GetUserDraftIdForName" dbquery="qPositionDraftManager_GetUserDraftIdForName"/>						
		<dataquery name="dPositionDraftManager_GetOldestUserDraft" dbquery="qPositionDraftManager_GetOldestUserDraft" object="com.talentPool.positions.dataobject.DraftData">
			<attribute name= "draftId" column="draft_id" type ="STRING" />
			<attribute name= "originalFileName" column="draft_name" type ="STRING" />
		</dataquery>
		<dataquery name="dPositionDraftManager_getPositionDraftDataByName" dbquery="qPositionDraftManager_getPositionDraftDataByName" object="com.talentPool.common.db.SimpleDataObject">
			<attribute name= "draftId" column="draft_id" type ="STRING" />
			<attribute name= "fileName" column="draft_name" type ="STRING" />
			<attribute name= "filePath" column="file_path" type ="STRING" />
			<attribute name= "visibility" column="visibility" type ="STRING" />
			<attribute name= "userId" column="user_id" type ="STRING" />
			<attribute name= "dateCreated" column="date_created" type ="STRING" />
		</dataquery>		
	</dataqueries>
</dbmap>