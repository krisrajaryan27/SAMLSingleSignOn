/*
*  merge_date_range_sentences.jape
*
*/




Phase: merge_date_range_sentences
Input: TempExperienceToken CustomSpaceToken
Options: control = appelt

Rule: merge_date_range_sentences
(
 {TempExperienceToken contains CustomSpaceToken}
):sentence
-->
{
	try{
		gate.AnnotationSet senSet = (gate.AnnotationSet)bindings.get("sentence");
		Long start = senSet.firstNode().getOffset();
		Long end = senSet.lastNode().getOffset();
		AnnotationSet tempSet = inputAS.get("CustomSentence").get(start,end);
		inputAS.removeAll(tempSet);
		gate.FeatureMap features = Factory.newFeatureMap();
		features.put("kind", "sentence");
		features.put("rule","merge_date_range_sentences");
		outputAS.add(tempSet.firstNode(),tempSet.lastNode(), "CustomSentence", features);
		
	}
	catch(Exception e){
		e.printStackTrace();
	}
