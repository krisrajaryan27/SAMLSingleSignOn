/*
*  basicinfo_email.jape
*
*/




Phase: sentence_split
Input: Token CustomSpaceToken SectionToken
Options: control = appelt

Rule: sentence_split_section
(
 {SectionToken}
 (({Token})+):sentence
)
-->
:sentence.CustomSentence = {kind = "sentence", rule = "sentence_split_section"}


Rule: sentence_split
(
 {CustomSpaceToken}
 (({Token})+):sentence
)
-->
:sentence.CustomSentence = {kind = "sentence", rule = "sentence_split"}
