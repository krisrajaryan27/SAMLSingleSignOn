/*
*  temp_date.jape
*  Lookups are stored in custom_education_degree.list
*/

Phase: tempDate
Input: Token Lookup Percent Date
Options: control = appelt

Macro: NUMBER_1
(
	{Token.string ==~ "[0-9]", !Percent}
)
Macro: NUMBER_2
(
	{Token.string ==~ "[0-9][0-9]", !Percent}
)
Macro: NUMBER_4
(
	{Token.string ==~ "[0-9][0-9][0-9][0-9]", !Percent}
)
Macro: DAY
(
	(((NUMBER_1)|(NUMBER_2))({Token.string ==~ "[Ss][Tt]"}|{Token.string ==~ "[Nn][Dd]"}|{Token.string ==~ "[Rr][Dd]"}|{Token.string ==~ "[Tt][Hh]"}))|
	{Token.string ==~ "(([0-9][0-9])|([0-9]))(([Ss][Tt])|([Nn][Dd])|([Rr][Dd])|([Tt][Hh]))"}|
	(NUMBER_1)|(NUMBER_2)
)
MACRO: MONTH
(
	(NUMBER_1)|(NUMBER_2)
)
MACRO: YEAR
(
	(NUMBER_2)|(NUMBER_4)
)

Macro: NUMBER
(
	(NUMBER_1)|(NUMBER_2)|(NUMBER_4)
)
Macro: TO_TILL_DASH
(
	{Token.string ==~ "[Tt][Oo]"}|
	{Token.string ==~ "[Tt][Ii][Ll][Ll]"}|
	{Token.kind == punctuation, Token.subkind == dashpunct}
)
Macro: DASH_SLASH
(
	{Token.string == "."}|
	{Token.string == "-"}|
	{Token.string == "/"}
)

Rule: date_dd_MMM_yyyy
(
	(DAY):day({Token.kind == punctuation})?({Lookup.majorType == month}):month({Token.kind == punctuation})?(YEAR):year
):date
--> 
{
   try {
		gate.AnnotationSet daySet = (gate.AnnotationSet)bindings.get("day");
		gate.AnnotationSet monthSet = (gate.AnnotationSet)bindings.get("month");
		gate.AnnotationSet yearSet = (gate.AnnotationSet)bindings.get("year");
		gate.AnnotationSet dateSet = (gate.AnnotationSet)bindings.get("date");

		String dayString = doc.getContent().getContent(daySet.firstNode().getOffset(), daySet.lastNode().getOffset()).toString();
		dayString = dayString.toLowerCase();
		dayString = dayString.replaceAll("st","").replaceAll("nd","").replaceAll("rd","").replaceAll("th","");
		
		String monthString = monthSet.iterator().next().getFeatures().get("minorType").toString();
		//String monthString = doc.getContent().getContent(monthSet.firstNode().getOffset(), monthSet.lastNode().getOffset()).toString();
		String yearString = doc.getContent().getContent(yearSet.firstNode().getOffset(), yearSet.lastNode().getOffset()).toString();
		String dateStr = dayString.trim()+"-"+monthString.trim()+"-"+yearString.trim();
		java.text.SimpleDateFormat sdFormat1 = new java.text.SimpleDateFormat("dd-MM-yy");
		java.text.SimpleDateFormat sdFormat2 = new java.text.SimpleDateFormat("dd-MM-yyyy");		
		Calendar cal = Calendar.getInstance();
		java.util.Date currentDate = cal.getTime();
		java.util.Date parsedDate;
		if(yearString.length() == 2){
			parsedDate = sdFormat1.parse(dateStr);
		}
		else{
			parsedDate = sdFormat2.parse(dateStr);				
		}
		if(parsedDate.compareTo(currentDate) <= 0){			
			gate.FeatureMap features = Factory.newFeatureMap();
  			features.put("kind", "date");
    		features.put("date",sdFormat2.format(parsedDate));
    		features.put("rule", "date_dd_MMM_yyyy");
    		outputAS.add(dateSet.firstNode(),
            dateSet.lastNode(), "TempDateToken", features);
		}
   }
   catch(Exception e) {
     // not possible
     e.printStackTrace();
     //throw new LuckyException("Invalid offset from annotation");
   }
}

Rule: date_MMM_dd_yyyy
(
	({Lookup.majorType == month}):month({Token.kind == punctuation})?(DAY):day({Token.kind == punctuation})?(YEAR):year
):date
--> 
{
  try {

	gate.AnnotationSet daySet = (gate.AnnotationSet)bindings.get("day");
	gate.AnnotationSet monthSet = (gate.AnnotationSet)bindings.get("month");
	gate.AnnotationSet yearSet = (gate.AnnotationSet)bindings.get("year");
	gate.AnnotationSet dateSet = (gate.AnnotationSet)bindings.get("date");

 		String dayString = doc.getContent().getContent(daySet.firstNode().getOffset(), daySet.lastNode().getOffset()).toString();
		dayString = dayString.toLowerCase();
		dayString = dayString.replaceAll("st","").replaceAll("nd","").replaceAll("rd","").replaceAll("th","");
		
		String monthString = monthSet.iterator().next().getFeatures().get("minorType").toString();
		//String monthString = doc.getContent().getContent(monthSet.firstNode().getOffset(), monthSet.lastNode().getOffset()).toString();
		String yearString = doc.getContent().getContent(yearSet.firstNode().getOffset(), yearSet.lastNode().getOffset()).toString();
		String dateStr = dayString.trim()+"-"+monthString.trim()+"-"+yearString.trim();
		java.text.SimpleDateFormat sdFormat1 = new java.text.SimpleDateFormat("dd-MM-yy");
		java.text.SimpleDateFormat sdFormat2 = new java.text.SimpleDateFormat("dd-MM-yyyy");		
		Calendar cal = Calendar.getInstance();
		java.util.Date currentDate = cal.getTime();
		java.util.Date parsedDate;
		if(yearString.length() == 2){
			parsedDate = sdFormat1.parse(dateStr);
		}
		else{
			parsedDate = sdFormat2.parse(dateStr);				
		}
		if(parsedDate.compareTo(currentDate) <= 0){			
			gate.FeatureMap features = Factory.newFeatureMap();
  			features.put("kind", "date");
    		features.put("date",sdFormat2.format(parsedDate));
    		features.put("rule", "date_MMM_dd_yyyy");
    		outputAS.add(dateSet.firstNode(),
            dateSet.lastNode(), "TempDateToken", features);
		}
   }
   catch(Exception e) {
   e.printStackTrace();
     // not possible
     //throw new LuckyException("Invalid offset from annotation");
   }
}

