<?xml version="1.0"?>
<dbmap> 
	<dbqueries>
		<dbquery name="qUserSchedulerManager_UpdateUserSchedulerEndTimeAndStatus">
			UPDATE tp_user_scheduler SET last_run_status = ?, current_status = ? @@
		</dbquery>
		<dbquery name="qUserSchedulerManager_UpdateUserSchedulerStartTime">
			UPDATE tp_user_scheduler SET last_run_starttime = now(), current_status = ?
		</dbquery>
		<dbquery name="qUserSchedulerManager_GetUserSchedulerDetails">
			SELECT scheduler_start_hour, scheduler_frequency, last_run_status, last_run_starttime,
				last_run_endtime, last_success_run, current_status
			FROM tp_user_scheduler	
		</dbquery>
		<dbquery name="qUserSchedulerManager_UpdateUserSchedulerProperties">
			UPDATE tp_user_scheduler SET scheduler_start_hour=?, scheduler_frequency=?
		</dbquery>
	</dbqueries>
	<dataqueries>
	    <dataquery name="dUserSchedulerManager_UpdateUserSchedulerEndTimeAndStatus" dbquery="qUserSchedulerManager_UpdateUserSchedulerEndTimeAndStatus" />
	    <dataquery name="dUserSchedulerManager_UpdateUserSchedulerStartTime" dbquery="qUserSchedulerManager_UpdateUserSchedulerStartTime" />
	    <dataquery name="dUserSchedulerManager_GetUserSchedulerDetails" dbquery="qUserSchedulerManager_GetUserSchedulerDetails" object="com.talentPool.scheduler.dataobject.SchedulerData">
		    <attribute name= "schedulerStartHour" column="scheduler_start_hour" type ="String" />
		    <attribute name= "schedulerFrequency" column="scheduler_frequency" type ="String" />
		    <attribute name= "lastRunStatus" column="last_run_status" type ="String" />
		    <attribute name= "lastRunStarttime" column="last_run_starttime" type ="String" />
		    <attribute name= "lastRunEndtime" column="last_run_endtime" type ="String" />
		    <attribute name= "lastSuccessRun" column="last_success_run" type ="String" />
		    <attribute name= "currentStatus" column="current_status" type ="String" />
    	</dataquery>
	    <dataquery name="dUserSchedulerManager_UpdateUserSchedulerProperties" dbquery="qUserSchedulerManager_UpdateUserSchedulerProperties" />
	</dataqueries>   
</dbmap>