<!DOCTYPE dbmap SYSTEM "dbmap.dtd">
-->
<dbmap> 
	<dbqueries>		
		<dbquery name="qExcelUploadManager_updateExcelImportTable">
			UPDATE tp_excel_import SET applicant_id=?, status=? WHERE session_id=? and row_id=?
		</dbquery>
		<dbquery name="qExcelUploadManager_GetSourceExists">
			SELECT source_id,source_title FROM tp_sources
		</dbquery>
		<dbquery name="qExcelUploadManager_GetDegreeId">			
			SELECT degree_id 
			FROM
			(
			(SELECT degree_id FROM tp_degrees WHERE degree_title = ?)
			UNION
			(SELECT degree_id FROM tp_degree_aliases WHERE alias = ?)
			) AS TBL
			LIMIT 0,1			
		</dbquery>
		<dbquery name="qExcelUploadManager_GetDegreeAliasId">
			SELECT degree_id FROM tp_degree_aliases WHERE alias = ?
		</dbquery>		
		<dbquery name="qExcelUploadManager_GetCSVImportFailData">
			SELECT row_id,applicant_name,applicant_id,status FROM tp_excel_import 
			WHERE session_id=? AND status!=? AND row_id &gt; ?
		</dbquery>		
		<dbquery name="qExcelUploadManager_GetBranchId">
			(
			SELECT branch_id
			FROM tp_branches
			WHERE branch_name = ?
			)
			UNION
			(
			SELECT branch_id
			FROM tp_branch_aliases
			WHERE alias = ?
			)
			LIMIT 0, 1
		</dbquery>
		<dbquery name="qExcelUploadManager_GetSkillId">			
			SELECT skill_id 
			FROM
			(
			(SELECT skill_id FROM tp_skills WHERE skill = ?)
			UNION
			(SELECT skill_id FROM tp_skills_aliases WHERE skill_alias = ?)
			) AS TBL
			LIMIT 0,1
		</dbquery>
		<dbquery name="qExcelUploadManager_GetSkillAliasId">
			SELECT skill_id FROM tp_skills_aliases WHERE skill_alias = ?
		</dbquery>
		<dbquery name="qExcelUploadManager_GetSourceId">
			SELECT source_id FROM tp_sources WHERE source_title = ?
		</dbquery>
		<dbquery name="qExcelUploadManager_InsertExcelData">
			INSERT INTO tp_excel_import (session_id,row_id,applicant_name,email1,email2,phone1,
			phone2,mobile,date_of_birth,experience,source,current_location,skills,yop1,startDate1, endDate1, institute1, degree1, 
			branch1, university1, typeOfProgram1, percentage1, yop2, startDate2, endDate2, institute2, degree2, branch2,
			university2, typeOfProgram2, percentage2, yop3, startDate3, endDate3, institute3, degree3, branch3,
			university3, typeOfProgram3, percentage3, yop4, startDate4, endDate4, institute4, degree4, branch4,
			university4, typeOfProgram4, percentage4, current_employer, current_ctc, expected_ctc,
			notice_period, note, error, date_created, original_resume_path,
			employ_from_date1,employ_to_date1,employer_name1,designation_name1,employ_type1,employ_location1,employ_country1,
			employ_from_date2,employ_to_date2,employer_name2,designation_name2,employ_type2,employ_location2,employ_country2,
			employ_from_date3,employ_to_date3,employer_name3,designation_name3,
			employ_from_date4,employ_to_date4,employer_name4,designation_name4,
			employ_from_date5,employ_to_date5,employer_name5,designation_name5)			
			values (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,now(),?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)	
		</dbquery>
		<dbquery name="qExcelUploadManager_GetExcelImportData">
			SELECT session_id,row_id,applicant_name, email1, email2, phone1,
			phone2, mobile, date_of_birth, experience, source, current_location, skills, yop1, startDate1, endDate1, institute1, degree1, 
			branch1, university1, typeOfProgram1, percentage1, yop2, startDate2, endDate2, institute2, degree2, branch2,
			university2, typeOfProgram2, percentage2, yop3, startDate3, endDate3, institute3, degree3, branch3,
			university3, typeOfProgram3, percentage3, yop4, startDate4, endDate4, institute4, degree4, branch4,
			university4, typeOfProgram4, percentage4, current_employer, current_ctc, expected_ctc,
			notice_period, note, error, original_resume_path,
			employ_from_date1,employ_to_date1,employer_name1,designation_name1,employ_type1,employ_location1,employ_country1,
			employ_from_date2,employ_to_date2,employer_name2,designation_name2,employ_type2,employ_location2,employ_country2,
			employ_from_date3,employ_to_date3,employer_name3,designation_name3,
			employ_from_date4,employ_to_date4,employer_name4,designation_name4,
			employ_from_date5,employ_to_date5,employer_name5,designation_name5
			FROM tp_excel_import WHERE session_id=? AND row_id &gt; ?
		</dbquery>
		<dbquery name="qMastersManager_GetExcelImportData">
			SELECT row_id,applicant_name,applicant_id,status FROM tp_excel_import WHERE session_id=?
		</dbquery>
	</dbqueries>
